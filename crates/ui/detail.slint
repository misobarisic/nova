import { Theme } from "theme.slint";
import { TitleArtwork } from "title-artwork.slint";
import { TrackingPanel } from "tracking.slint";
import { TrackingLinkRow, TrackingCandidateRow, TrackingMappingRow, TrackingSetupRow } from "types.slint";
import { Spinner } from "std-widgets.slint";
import { SearchField } from "searchfield.slint";
import { CategoryRow, EpisodeRow, StreamRow, SeasonCard, SheetItem } from "types.slint";
import { KbMark } from "kbnav.slint";
import { MenuSheet } from "menusheet.slint";
import { IcPlay, IcBookmark, IcAdd, IcMoreHoriz, IcSync, IcCheck, IcChevronLeft, IcChevronRight, IcSchedule, IcSearch, IcClose } from "icons.slint";
import { Anim } from "anim.slint";

// One filter pill in the horizontal addon bar above the stream list.
component StreamFilterPill inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    // The addon is still being queried: show a small spinner on the right.
    in property <bool> loading;
    callback picked();
    // The pointer is dragging over this pill (or the gesture is still too
    // young to tell which way it goes): the bar blocks the page's pan (see
    // StreamFilterBar::panned). Reported from the pill's own moves because
    // they arrive *before* the enclosing Flickables hand their held-back
    // press over, while the page — which registered the press up front —
    // would otherwise claim the gesture on the first 8px of vertical wobble.
    callback pan_hint();
    // The gesture is not the row's to own after all (it is going vertical, so
    // the page does the panning), or it has ended: the bar hands the page's
    // pan back at once.
    callback pan_release();

    // Side padding. The pill keeps this intrinsic width whether or not a
    // query is in flight: while loading the spinner *replaces* the trailing
    // padding (same 12px) instead of adding to it, so the bar no longer
    // reflows as addons answer one by one.
    property <length> pad: 12px;

    height: 30px;
    border-radius: 15px;
    background: selected ? Theme.current.accent : (pill_touch.has-hover ? Theme.current.detail_filter_hover : Theme.current.control);
    clip: true;

    HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.loading ? 0px : root.pad;
        spacing: root.loading ? 0px : 8px;

        Text {
            text: root.label;
            color: root.selected ? Theme.current.text_bright : Theme.current.text_filter;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }

        // Centred in the pill's height (a layout child of a HorizontalLayout
        // is top-aligned, and a squashed ring would look wrong).
        if root.loading: Rectangle {
            width: root.pad;
            height: 100%;

            Spinner {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: root.pad;
                height: root.pad;
            }
        }
    }

    pill_touch := TouchArea {
        mouse-cursor: pointer;
        // Gesture anchor for the axis decision below: the first event of the
        // gesture. A touch reaches this TouchArea as moves before the
        // enclosing Flickables deliver the press they hold back (its finger id
        // is non-zero), so the anchor cannot come from `pressed-x` alone.
        property <length> hint_x: 0px;
        property <length> hint_y: 0px;
        property <bool> hint_live: false;
        // True between `pan_hint` and `pan_release`: the pill owns the
        // gesture for the bar until the finger says otherwise.
        property <bool> hint_held: false;

        function hint_stop() {
            self.hint_live = false;
            if (self.hint_held) {
                self.hint_held = false;
                root.pan_release();
            }
        }

        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                self.hint_x = self.mouse-x;
                self.hint_y = self.mouse-y;
                self.hint_live = true;
            } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                self.hint_stop();
            } else if (ev.kind == PointerEventKind.move) {
                if (!(self.pressed || ev.touch-finger-id != 0)) {
                    // A hover, not a drag: the pills are simply under the
                    // pointer. (`pressed` lags the first moves of a mouse
                    // drag — the enclosing Flickables hold its press back for
                    // 100ms — so a mouse can only own the gesture from there
                    // on.)
                    self.hint_stop();
                    return;
                }
                if (!self.hint_live) {
                    self.hint_x = self.mouse-x;
                    self.hint_y = self.mouse-y;
                    self.hint_live = true;
                }
                let dx = self.mouse-x - self.hint_x;
                let dy = self.mouse-y - self.hint_y;
                if (Math.abs(dy) > 8px && Math.abs(dy) > Math.abs(dx)) {
                    // Going vertical: hand the page's pan back so the drag
                    // scrolls like it would anywhere else.
                    self.hint_stop();
                } else {
                    // Horizontal, or too early to tell — hold the page off
                    // now: the page trips its own 8px vertical threshold
                    // within a frame or two, and a gesture it captured is
                    // never given back.
                    self.hint_held = true;
                    root.pan_hint();
                }
            }
        }

        // A gesture can pass without an up/cancel reaching the grabbing item,
        // but `pressed` always falls — the same safety net the landing cards
        // use.
        changed pressed => {
            if (!self.pressed) {
                self.hint_stop();
            }
        }

        clicked => { root.picked(); }
    }
}

// Chevron button shared by compact stream controls and touch-sized episode paging.
component PageButton inherits Rectangle {
    // 0 = previous (‹), 1 = next (›).
    in property <int> glyph: 0;
    in property <bool> roomy: false;
    in property <bool> minimal: false;
    in property <string> name: "";
    in property <bool> enabled: true;
    callback picked();

    width: root.roomy ? 44px : 28px;
    height: self.width;
    horizontal-stretch: 0;
    border-radius: root.roomy ? 12px : 8px;
    background: root.minimal || !root.enabled ? transparent : (pg_touch.has-hover ? Theme.current.pager_hover : (root.roomy ? Theme.current.pager_roomy : Theme.current.control));
    border-width: root.minimal ? 0px : 1px;
    border-color: root.enabled ? Theme.current.step_border : Theme.current.pager_disabled_border;
    accessible-role: button;
    accessible-label: root.name;

    // The icon stays visually small without shrinking its touch target.
    if root.minimal: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 28px; height: 28px;
        border-radius: 8px;
        background: root.enabled && pg_touch.has-hover ? Theme.current.border_subtle : transparent;
    }

    if root.glyph == 0: IcChevronLeft {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.minimal ? 16px : 18px;
        height: self.width;
        fill: root.enabled ? Theme.current.text_primary : Theme.current.icon_disabled;
    }
    if root.glyph == 1: IcChevronRight {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.minimal ? 16px : 18px;
        height: self.width;
        fill: root.enabled ? Theme.current.text_primary : Theme.current.icon_disabled;
    }

    pg_touch := TouchArea {
        enabled: root.enabled;
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

// Pager buttons for the episode list: rendered both above and under the grid,
// so a 200-episode season can be turned from either end without scrolling back
// to the top.
component EpisodePager inherits Rectangle {
    in property <int> page: 0;
    in property <int> count: 1;
    // Stream/filter hosts keep the compact chevrons. Episodes retain touch
    // targets around small, unboxed arrows and a quiet page counter.
    in property <bool> episode-style: false;
    callback picked(int);

    width: root.episode-style ? 152px : 62px;
    height: root.episode-style ? 44px : 28px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    background: transparent;

    HorizontalLayout {
        spacing: root.episode-style ? 4px : 6px;
        PageButton {
            glyph: 0;
            roomy: root.episode-style;
            minimal: root.episode-style;
            name: @tr("Previous page");
            enabled: root.page > 0;
            picked => { root.picked(root.page - 1); }
        }
        if root.episode-style: page_counter := Text {
            horizontal-stretch: 1;
            min-width: 0px;
            height: 44px;
            text: @tr("{} / {}", root.page + 1, root.count);
            accessible-label: @tr("Page {}/{}", root.page + 1, root.count);
            color: Theme.current.text_detail_metadata;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        PageButton {
            glyph: 1;
            roomy: root.episode-style;
            minimal: root.episode-style;
            name: @tr("Next page");
            enabled: root.page + 1 < root.count;
            picked => { root.picked(root.page + 1); }
        }
    }
}

// Circular, text-free icon button for the detail top bar (back, library,
// categories). The caller drops the icon (and any badge) in as a child; the
// hover background and keyboard focus ring live here.
component TopIconButton inherits Rectangle {
    in property <bool> narrow: false;
    in property <bool> focused: false;
    callback clicked();

    width: narrow ? 44px : 48px;
    height: narrow ? 44px : 48px;
    border-radius: self.width / 2;
    background: touch.has-hover ? Theme.current.hero_control_hover : Theme.current.hero_control;
    border-width: focused ? 2px : 1px;
    border-color: focused ? Theme.current.accent_vivid : Theme.current.border_strong;

    @children

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Addon filter pills above the stream list: All + one per addon, with
// per-pill spinners while queries are in flight. One instance per stream
// list (a movie's Overview tab, a picked series episode), in flow with the
// streams.
component StreamFilterBar inherits HorizontalLayout {
    in property <[string]> addons: [];
    in property <[bool]> loading: [];
    in property <bool> searching: false;
    // Active filter: 0 = All, otherwise 1-based index into `addons`.
    in property <int> addon_filter: 0;
    in property <bool> touch_menus: false;

    callback filter_picked(int);
    // The row owns the pointer gesture (a pill reported a horizontal drag, or
    // the row itself just panned): the host blocks the page's own pan while
    // that lasts. Nested Flickables have no axis lock in Slint, so without
    // this the page would register the vertical axis of the same gesture at
    // the first 8px of wobble — and it never gives a captured gesture back.
    // See DetailPage::page_pan_enabled.
    callback panned();
    // The gesture is going vertical, or has ended: the page may pan again.
    callback pan_released();

    min-width: 0px;
    spacing: 8px;

    // True while the pill row is wider than its viewport. The desktop
    // chevron slots below are always laid out (never `if`-gated), so
    // this flag can't feed back into the geometry (binding loop).
    property <bool> overflowing: pill_row.width > pill_flick.width + 1px;

    // Desktop chevron slots: fixed geometry whether or not the row
    // overflows; the buttons fade in only while useful (an `if` here
    // would resize the viewport and loop with `overflowing` above).
    // A disabled touch passes taps through, so a faded slot is inert.
    if !root.touch_menus: Rectangle {
        width: 28px;
        height: 30px;
        opacity: overflowing && pill_flick.content-x < -0.5px ? 1.0 : 0.0;
        animate opacity { duration: Anim.hover_fast; }

        PageButton {
            glyph: 0;
            name: @tr("Scroll filters left");
            enabled: overflowing && pill_flick.content-x < -0.5px;
            picked => {
                pill_flick.content-x = Math.min(0px, pill_flick.content-x + pill_flick.width);
            }
        }
    }

    pill_flick := Flickable {
        horizontal-stretch: 1;
        min-width: 0px;
        height: 30px;
        interactive: true;
        content-width: pill_row.width;
        content-height: self.height;

        // The row moving is the only "a drag owns this Flickable" signal
        // Slint offers: there is no drag-started callback, and the page's own
        // press state is not observable from here. The chevron steps below
        // and a layout clamp also land here — they just re-arm the host's
        // hold for one interval.
        changed content-x => { root.panned(); }

        // Explicit width = intrinsic pill row width, so the Flickable
        // scrolls it horizontally instead of squeezing it.
        pill_row := HorizontalLayout {
            width: self.preferred-width;
            height: 30px;
            spacing: 8px;
            alignment: start;

            StreamFilterPill {
                label: @tr("All");
                selected: root.addon_filter == 0;
                loading: root.searching;
                picked => { root.filter_picked(0); }
                pan_hint => { root.panned(); }
                pan_release => { root.pan_released(); }
            }

            for a[i] in root.addons: StreamFilterPill {
                label: a;
                selected: root.addon_filter == i + 1;
                loading: i < root.loading.length && root.loading[i];
                picked => { root.filter_picked(i + 1); }
                pan_hint => { root.panned(); }
                pan_release => { root.pan_released(); }
            }
        }
    }

    if !root.touch_menus: Rectangle {
        width: 28px;
        height: 30px;
        opacity: overflowing && pill_flick.content-x > pill_flick.width - pill_flick.content-width + 0.5px ? 1.0 : 0.0;
        animate opacity { duration: Anim.hover_fast; }

        PageButton {
            glyph: 1;
            name: @tr("Scroll filters right");
            enabled: overflowing && pill_flick.content-x > pill_flick.width - pill_flick.content-width + 0.5px;
            picked => {
                pill_flick.content-x = Math.max(pill_flick.width - pill_flick.content-width, pill_flick.content-x - pill_flick.width);
            }
        }
    }
}

// Stream list shared by the Overview tab (movies) and the Episodes tab
// (a picked series episode).
component StreamList {
    in property <[StreamRow]> rows;
    in property <string> hint;
    // Addon labels shown as pills, in installed-addon order (pending addons
    // included). The bar shows an "All" pill plus one per addon.
    in property <[string]> addons: [];
    // Per-pill loading flag, index-aligned with `addons` (spinner while an
    // addon is still being queried).
    in property <[bool]> loading: [];
    // True while any addon is still being queried (All pill spinner).
    in property <bool> searching: false;
    // Active filter: 0 = All, otherwise 1-based index into `addons`.
    in property <int> addon_filter: 0;
    // Keyboard focus index (-1 = none). The parent drives it.
    in property <int> kb_focus: -1;
    in property <int> page: 0;
    in property <int> page_count: 1;
    in property <int> page_start: 0;
    // Keyboard modality (parent-driven): the ring shows only while true.
    in property <bool> kb_active: false;
    in property <bool> touch_menus: false;

    callback picked(int);
    callback page_picked(int);
    callback bottom_page_picked(int, length);
    in property <[SheetItem]> action_items: [];
    callback action_requested(string);
    callback action_selected(string, int);
    callback filter_picked(int);
    // Forwarded from the filter bar's own `panned` / `pan_released` (see
    // DetailPage::page_pan_enabled).
    callback filter_panned();
    callback filter_pan_released();

    VerticalLayout {
        width: 100%;
        // Allow squeezing below the widest unbreakable token: without this
        // the min-width of long stream text propagates up and widens the
        // whole content column (WATCH NOW + filter row stretch with it).
        min-width: 0px;
        spacing: 8px;

        Text {
            text: root.hint;
            font-size: 13px;
            color: Theme.current.text_muted;
            wrap: word-wrap;
            width: 100%;
        }

        // Per-addon filter bar: a horizontally scrollable row of pills so
        // many addons never blow the width out of bounds. `content-width`
        // is set explicitly because Flickable cannot infer it with a `for`.
        //
        // The bar pans by dragging on touch. Desktop also gets step chevrons
        // on both ends (see StreamFilterBar): a mouse drag on the pills pans
        // them like touch does, but the chevrons stay the precise way to
        // reach clipped pills. Each chevron click moves by one viewport,
        // clamped.
        if root.addons.length > 1: StreamFilterBar {
            width: 100%;
            addons: root.addons;
            loading: root.loading;
            searching: root.searching;
            addon_filter: root.addon_filter;
            touch_menus: root.touch_menus;
            filter_picked(i) => { root.filter_picked(i); }
            panned => { root.filter_panned(); }
            pan_released => { root.filter_pan_released(); }
        }

        VerticalLayout {
            width: 100%;
            min-width: 0px;
            spacing: Theme.card_spacing;

            if root.page_count > 1: HorizontalLayout {
                width: 100%;
                height: 28px;
                spacing: 10px;
                alignment: end;
                Text {
                    text: @tr("Page {}/{}", root.page + 1, root.page_count);
                    height: 28px;
                    font-size: 12px;
                    color: Theme.current.text_muted;
                    vertical-alignment: center;
                }
                EpisodePager {
                    page: root.page;
                    count: root.page_count;
                    picked(p) => { root.page_picked(p); }
                }
            }

            for st[i] in root.rows: Rectangle {
                width: 100%;
                min-width: 0px;
                // Follow the text as it actually wraps at the live width;
                // Slint measures wrapped Text at its intrinsic (single-line)
                // width, so the `st.lines` heuristic alone under-counts on
                // narrow screens and clips. Keep it as a floor for the first
                // paint (before `row_measure` has a width).
                min-height: Math.max(
                    48px,
                    max(st.lines * 22px + 24px,
                        row_measure.preferred-height + 20px
                            + ((st.is_download && st.download_action != 4) ? 4px : 0px)),
                );
                background: st.is_download ? Theme.current.stream_download : Theme.current.stream_card;
                border-radius: Theme.card_corner_radius;
                border-width: root.kb_active && root.kb_focus == i + root.page_start ? 2px : 0px;
                border-color: Theme.current.focus_ring;
                clip: true;

                VerticalLayout {
                    width: 100%;
                    min-width: 0px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    padding-left: 16px;
                    padding-right: 16px;
                    // Explicit so the hidden `row_measure` (same spacing)
                    // matches this layout's content height exactly.
                    spacing: 0px;

                    Text {
                        text: st.text;
                        color: Theme.current.text_primary;
                        font-size: 16px;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        width: 100%;
                        min-width: 0px;
                    }

                    if st.details != "": Text {
                        text: st.details;
                        color: Theme.current.text_download;
                        font-size: 12px;
                        wrap: word-wrap;
                        width: 100%;
                        min-width: 0px;
                    }

                    // Progress rail, anchored to the left edge (`x: 0`, like
                    // the other rails in the app) so it fills left → right.
                    // Hidden once the file is complete: the row reads
                    // "Downloaded" and an empty rail there is just noise.
                    if st.is_download && st.download_action != 4: dl_bar := Rectangle {
                        x: 0;
                        width: 100%;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.current.download_track;

                        dl_fill := Rectangle {
                            x: 0;
                            width: parent.width * st.download_progress;
                            height: 100%;
                            border-radius: 2px;
                            background: Theme.current.accent;
                        }
                    }
                }

                // Hidden measurement copy of the text stack at the padded
                // content width (the visible layout pads 16px each side), so
                // the row minimum above tracks real wrapping instead of the
                // intrinsic one-line width.
                mrow := Rectangle {
                    width: 100%;
                    height: 0;
                    clip: true;

                    row_measure := VerticalLayout {
                        width: Math.max(0px, mrow.width - 32px);
                        spacing: 0px;

                        Text {
                            text: st.text;
                            font-size: 16px;
                            wrap: word-wrap;
                            min-width: 0px;
                        }

                        if st.details != "": Text {
                            text: st.details;
                            font-size: 12px;
                            wrap: word-wrap;
                            min-width: 0px;
                        }
                    }
                }

                // Populate the backend-owned actions before explicitly showing
                // the desktop popup; a ContextMenuArea's automatic right-click
                // would otherwise open before this row's actions are prepared.
                stream_ctx := ContextMenuArea {
                    x: 0px; y: 0px;
                    width: 0px; height: 0px;
                    Menu {
                        for action[a] in root.action_items: MenuItem {
                            title: action.label;
                            enabled: action.enabled;
                            activated => { root.action_selected(st.id, a); }
                        }
                    }
                }

                touch_st := TouchArea {
                    property <bool> lp_suppress: false;
                    width: 100%;
                    height: 100%;
                    accessible-role: button;
                    accessible-label: st.text;
                    mouse-cursor: pointer;
                    clicked => {
                        if (touch_st.lp_suppress) {
                            touch_st.lp_suppress = false;
                        } else {
                            root.picked(i + root.page_start);
                        }
                    }
                    pointer-event(ev) => {
                        if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                            row_lp_timer.stop();
                            touch_st.lp_suppress = true;
                            root.action_requested(st.id);
                            if (!root.touch_menus) {
                                stream_ctx.show({ x: self.mouse-x, y: self.mouse-y });
                            }
                        } else if (ev.kind == PointerEventKind.down) {
                            touch_st.lp_suppress = false;
                            if (root.touch_menus) {
                                row_lp_timer.stop();
                                row_lp_timer.start();
                            }
                        } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                            row_lp_timer.stop();
                        }
                    }
                    moved => {
                        if (Math.abs(touch_st.mouse-x - touch_st.pressed-x)
                            + Math.abs(touch_st.mouse-y - touch_st.pressed-y) > 24px) {
                            row_lp_timer.stop();
                        }
                    }
                }

                row_lp_timer := Timer {
                    interval: 600ms;
                    running: false;
                    triggered => {
                        self.stop();
                        touch_st.lp_suppress = true;
                        root.action_requested(st.id);
                    }
                }
            }

            // Repeat the pager after the entries so users don't have to
            // scroll all the way back up to turn a long stream list.
            if root.page_count > 1: HorizontalLayout {
                width: 100%;
                height: 28px;
                spacing: 10px;
                alignment: end;
                Text {
                    text: @tr("Page {}/{}", root.page + 1, root.page_count);
                    height: 28px;
                    font-size: 12px;
                    color: Theme.current.text_muted;
                    vertical-alignment: center;
                }
                EpisodePager {
                    page: root.page;
                    count: root.page_count;
                    picked(p) => { root.bottom_page_picked(p, root.absolute-position.y); }
                }
            }
        }

        Text {
            text: @tr("Click a stream to start playback. Right-click or hold for actions.");
            font-size: 12px;
            color: Theme.current.text_disabled;
            width: 100%;
        }
    }
}

// Both the cinematic detail view and compact Tracking view use the same
// tabs. Numeric IDs stay stable for episode callbacks and saved snapshots.
component DetailTabs inherits Rectangle {
    in property <bool> narrow;
    in property <bool> tracking_visible;
    in property <int> selected;
    in property <bool> kb_active;
    in property <bool> focused;
    in property <int> kb_tab;
    callback picked(int);
    height: 48px;
    vertical-stretch: 0;
    property <int> count: root.tracking_visible ? 3 : 2;
    property <length> gap: root.narrow ? 4px : 24px;
    Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: Theme.current.border_overlay; }
    HorizontalLayout {
        spacing: root.gap;
        alignment: start;
        for tab in root.tracking_visible ? [0, 3, 4] : [0, 3]: Rectangle {
            width: root.narrow ? (root.width - (root.count - 1) * root.gap) / root.count : Math.min(140px, (root.width - (root.count - 1) * root.gap) / root.count);
            height: 48px;
            border-radius: 4px;
            border-width: tab_focus.has-focus || (root.kb_active && root.focused && root.kb_tab == tab) ? 2px : 0px;
            border-color: Theme.current.focus_ring;
            accessible-role: button;
            accessible-label: tab == 0 ? @tr("Overview") : tab == 3 ? @tr("Episodes") : @tr("Tracking");
            forward-focus: tab_focus;
            Rectangle {
                y: parent.height - 4px;
                height: 4px;
                width: 100%;
                border-radius: 2px;
                background: root.selected == tab ? Theme.current.accent_vivid : transparent;
            }
            Text {
                text: tab == 0 ? @tr("Overview") : tab == 3 ? @tr("Episodes") : @tr("Tracking");
                color: root.selected == tab ? Theme.current.text_bright : Theme.current.text_detail_tab;
                font-weight: root.selected == tab ? 600 : 400;
                font-size: root.narrow ? 14px : 18px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                overflow: elide;
            }
            tab_focus := FocusScope {
                key-pressed(e) => {
                    if e.text == Key.Return || e.text == " " { root.picked(tab); accept } else { reject }
                }
            }
            TouchArea { mouse-cursor: pointer; clicked => { root.picked(tab); } }
        }
    }
}

export component DetailPage {
    in property <[TrackingLinkRow]> tracking_links;
    in property <[TrackingCandidateRow]> tracking_candidates;
    in-out property <int> tracking_service;
    in property <[TrackingSetupRow]> tracking_setup;
    in property <string> tracking_setup_revision;
    in property <string> tracking_setup_summary;
    in property <string> tracking_setup_unmapped;
    in property <bool> tracking_setup_active;
    in property <string> tracking_range_first;
    in property <string> tracking_range_last;
    in property <string> tracking_range_start;

    in property <[string]> tracking_source_rows;
    in property <[string]> tracking_preview_rows;
    in property <[TrackingMappingRow]> tracking_mapping_rows;
    in property <string> tracking_notice;
    in property <string> tracking_candidate_title;
    in property <bool> tracking_busy;
    in property <bool> tracking_can_confirm;
    in-out property <bool> tracking_open: false;
    in-out property <int> tracking_return_tab: 0;
    property <int> tracking_focus_request: 0;
    callback tracking_show();
    callback tracking_close();
    callback tracking_search(int,string);
    callback tracking_pick(int);
    callback tracking_preview(string,string,string);
    callback tracking_confirm();
    callback tracking_accept_setup(string,bool);
    callback tracking_adjust_setup(int);
    callback tracking_cancel_adjust();
    callback tracking_assign(int,string);
    callback tracking_edit(string,string,int,string,bool,string,bool,string);
    callback tracking_action(string,int);

    // Custom components placed in a Window are sized by their preferred size;
    // make this page fill the window (its parent).
    preferred-width: 100%;
    preferred-height: 100%;

    in-out property <image> selected_poster;
    in-out property <image> selected_backdrop;
    in property <image> selected_logo;
    in-out property <string> selected_title: "";
    in-out property <string> selected_year: "";
    in-out property <string> selected_description: "";
    property <bool> synopsis_expanded: false;
    property <bool> hero_description_expanded: false;
    property <length> overview_width: root.width - (root.narrow ? 40px : 128px) - root.safe-left - root.safe-right;
    property <length> synopsis_width: root.narrow ? root.overview_width : (root.overview_width - 24px) * 0.56;
    property <length> hero_text_width: root.narrow ? root.overview_width : Math.min(650px, root.overview_width * 0.55);
    property <length> backdrop_height: (root.narrow
        ? (Theme.detail_backdrop_size == 0 ? 420px : Theme.detail_backdrop_size == 2 ? 720px : 560px)
        : (Theme.detail_backdrop_size == 0 ? 560px : Theme.detail_backdrop_size == 2 ? 920px : 740px)) + root.safe-top;
    property <length> hero_top_spacing: root.narrow
        ? (Theme.detail_backdrop_size == 0 ? 140px : Theme.detail_backdrop_size == 2 ? 390px : 250px)
        : (Theme.detail_backdrop_size == 0 ? 20px : Theme.detail_backdrop_size == 2 ? 180px : 50px);
    in-out property <[string]> selected_genre_list: [];
    // Tab bar: 0 = Overview, 3 = Episodes, 4 = Tracking.
    in-out property <int> detail_tab: 0;
    in-out property <string> episode_filter: "";
    in-out property <bool> in_library: false;
    in property <bool> library_watched: false;
    in property <int> library_activity_action: 0;
    private property <bool> hero_library_focused: false;
    in-out property <[CategoryRow]> category_rows: [];
    in-out property <int> selected_category_count: 0;
    in-out property <[StreamRow]> streams: [];
    in-out property <int> stream_page: 0;
    in-out property <int> stream_page_count: 1;
    in-out property <int> stream_page_start: 0;
    in-out property <int> stream_total: 0;
    in-out property <string> streams_hint: "";
    // Addon filter pills above the stream list (installed-addon order).
    in-out property <[string]> stream_addons: [];
    // Per-pill loading flags, index-aligned with `stream_addons`; plus a
    // global "any query in flight" flag for the All pill.
    in-out property <[bool]> stream_loading: [];
    in-out property <bool> streams_searching: false;
    // 0 = All, otherwise 1-based index into `stream_addons`.
    in-out property <int> stream_filter: 0;
    in-out property <bool> stream_action_open: false;
    in-out property <string> stream_action_id: "";
    in-out property <string> stream_action_title: "";
    in-out property <[SheetItem]> stream_action_items: [];
    in-out property <bool> modal_episodes: false;
    in-out property <[string]> season_names: [];
    in-out property <int> season_combo_idx: -1;
    // Art-backed season picker cards, same order as season_names.
    in-out property <[SeasonCard]> season_cards: [];
    in-out property <[EpisodeRow]> episode_rows: [];
    // Episodes tab pagination: Rust slices the season's filtered list into
    // pages of EPISODE_PAGE_SIZE and writes `episode_page_start` (the global
    // index of `episode_rows[0]`), so card picks still resolve against the
    // whole season.
    in-out property <int> episode_page: 0;
    in-out property <int> episode_page_count: 1;
    in-out property <int> episode_page_start: 0;
    in-out property <int> episode_total: 0;
    in-out property <string> episode_context: "";
    in property <string> watch_label: @tr("Start");
    // Set by AppWindow when the streams view was entered directly (Home
    // Continue deep-link) without visiting the episode list — see kb_back.
    in property <bool> deep_stream: false;
    in property <int> system_back_request: 0;
    property <int> last_system_back_request: -1;
    property <bool> filter_focused: false;
    private property <bool> episode_search_open: false;
    // Compact layout for narrow (portrait) windows.
    in property <bool> narrow;
    // Top system-bar inset (Android status bar): Window.safe-area-insets,
    // bound by AppWindow. 0 on desktop/web, so layout there is unchanged.
    in property <length> safe-top: 0px;
    // Side insets: in landscape the display cutout / gesture area moves to
    // the left or right edge, so page content must clear it.
    in property <length> safe-left: 0px;
    in property <length> safe-right: 0px;
    // Bottom system-bar inset (Android gesture/nav bar), for the card
    // bottom sheets. 0 on desktop/web.
    in property <length> safe-bottom: 0px;
    // True on touch-driven platforms (Android): card menus open as
    // bottom sheets on hold. Desktop keeps native right-click popups.
    in property <bool> touch_menus: false;

    // Episode grid columns: 1 in narrow windows, otherwise scaled to the
    // available content width after page padding, capped at 4.
    property <int> ep_cols: root.narrow ? 1 : Math.min(4, Math.max(2, Math.floor((root.episode_content_w + root.card-gap) / (320px + root.card-gap))));
    // Equal-width episode cards: grid columns start at each cell's
    // preferred width (full unwrapped text even when wrapped — see Text
    // docs), so without an explicit cell width columns track content
    // length. Derive one shared width top-down from the page width
    // (content = page − 64px scroll padding each side on wide layouts).
    // Must use root.width here: referencing the content layout's own
    // width feeds back through the ScrollView and binding-loops.
    property <length> episode_content_w: root.width - (root.narrow ? 40px + root.safe-left + root.safe-right : 128px + root.safe-left + root.safe-right);
    property <length> card-gap: Theme.card_spacing;
    property <length> ep_card_w: (root.episode_content_w - (root.ep_cols - 1) * root.card-gap) / root.ep_cols;
    // Phones keep seasons in one horizontal rail with the next card
    // peeking in. On wide windows the grid grows from a 180px minimum card;
    // cards are capped (same centered-cap scheme as the Discover grid), so the
    // wall never turns into a few giant banners on desktop.
    property <length> min-season: 180px;
    property <length> max-season: 240px;
    property <int> season_cols: root.narrow ? 2 : Math.min(5, Math.max(3, Math.floor((root.episode_content_w + root.card-gap) / (root.min-season + root.card-gap))));
    property <length> season_card_w: root.narrow ? Math.min(180px, Math.max(120px, (root.width - 40px - root.safe-left - root.safe-right) / 2.2)) : Math.min(root.max-season, (root.episode_content_w - (root.season_cols - 1) * root.card-gap) / root.season_cols);
    // Columns actually used (partial last row still packs left).
    property <int> season_grid_cols: Math.min(root.season_cols, root.season_cards.length);
    // Series flow when an addon listed seasons; movies have none.
    property <bool> has_episodes: root.season_names.length > 0;
    // True while the assign-categories popup covers this page (wired by
    // AppWindow): used to hand keyboard focus back when it closes.
    in property <bool> popup_open: false;

    // ---- 6-button keyboard nav (arrows + Enter + Backspace) ----
    // Zones: 0 top bar, 1 tabs, 2 hero actions, 3 content. Content kind:
    // 0 none, 1 stream list, 2 episode picker (season/filter/grid).
    // Enter activates; Backspace steps back (episode streams -> list ->
    // modal). The filter field uses edit mode like Discover's search.
    // Bound to AppWindow (survives modal recreation): reopening the same
    // entry restores focus. kb_edit stays local (transient edit mode).
    in-out property <int> kb_zone: 0;
    in-out property <int> kb_top: 0; // 0 back, 1 sync/Tracking, 2 library options
    in-out property <int> kb_tab: 0;
    in-out property <int> kb_ci: 2; // picker control: 0 season, 1 filter, 2 grid
    in-out property <int> kb_ep: 0;
    in-out property <int> kb_s: 0;
    property <bool> kb_edit: false;
    // Keyboard modality (bound to AppWindow, see DiscoverPage).
    in-out property <bool> kb_active;

    function det_content() -> int {
        if (root.detail_tab == 3 && root.modal_episodes) {
            return 2;
        }
        if (root.detail_tab == 3 && !root.modal_episodes) {
            return 1;
        }
        if (root.detail_tab == 0 && !root.has_episodes) {
            return 1;
        }
        return 0;
    }

    function det_top_visible(i: int) -> bool {
        return i == 0 || (root.in_library && (i == 1 || i == 2));
    }

    function det_top_fix() {
        if (!root.det_top_visible(root.kb_top)) { root.kb_top = 0; }
    }

    function det_top_right() {
        if (root.in_library) { root.kb_top = Math.min(2, root.kb_top + 1); }
    }

    function det_top_left() {
        root.kb_top = Math.max(0, root.kb_top - 1);
    }

    function det_zone_down() {
        if (root.kb_zone == 0) {
            root.kb_zone = 1;
        } else if (root.kb_zone == 1) {
            if root.detail_tab == 4 {
                root.kb_zone = 3;
                root.tracking_focus_request += 1;
            } else { root.kb_zone = 2; }
        } else if (root.kb_zone == 2) {
            if (root.det_content() != 0) {
                root.kb_zone = 3;
            }
        } else {
            // Inside content: grid Down moves a row, streams move one row.
            if (root.det_content() == 2 && root.kb_ci == 2) {
                if (root.kb_ep + root.ep_cols < root.episode_rows.length) {
                    root.kb_ep += root.ep_cols;
                    root.kb_nudge(-90px);
                }
            } else if (root.det_content() == 2 && root.kb_ci < 2) {
                root.kb_ci += 1;
                root.kb_nudge(-80px);
            } else if (root.det_content() == 1) {
                if (root.kb_s + 1 < root.stream_total) {
                    root.kb_s += 1;
                    root.kb_nudge(-50px);
                }
            }
        }
    }

    function det_zone_up() {
        if (root.kb_zone == 3) {
            if (root.det_content() == 2 && root.kb_ci == 2) {
                if (root.kb_ep >= root.ep_cols) {
                    root.kb_ep -= root.ep_cols;
                    root.kb_nudge(90px);
                } else {
                    root.kb_ci = 1;
                    root.kb_nudge(80px);
                }
            } else if (root.det_content() == 2 && root.kb_ci == 1) {
                root.kb_ci = 0;
                root.kb_nudge(80px);
            } else if (root.det_content() == 2 && root.kb_ci == 0) {
                root.kb_zone = 2;
            } else {
                root.kb_zone = 2;
            }
        } else if (root.kb_zone == 2) {
            root.kb_zone = 1;
        } else if (root.kb_zone == 1) {
            root.kb_zone = 0;
        }
    }

    function kb_left() {
        if (root.kb_zone == 0) {
            root.det_top_left();
        } else if (root.kb_zone == 2) {
            root.hero_library_focused = false;
        } else if (root.kb_zone == 1) {
            root.kb_tab = root.kb_tab == 0 ? (root.in_library ? 4 : 3) : root.kb_tab == 4 ? 3 : 0;
        } else if (root.kb_zone == 3 && root.det_content() == 2 && root.kb_ci == 0) {
            root.kb_cycle_season(-1);
        } else if (root.kb_zone == 3 && root.det_content() == 2 && root.kb_ci == 1) {
            // Filter / pager row: Left steps one page back.
            if (root.episode_page > 0) {
                root.episode_page_picked(root.episode_page - 1);
            }
        } else if (root.kb_zone == 3 && root.det_content() == 2 && root.kb_ci == 2) {
            if (root.kb_ep > 0) {
                root.kb_ep -= 1;
            }
        }
    }

    function kb_right() {
        if (root.kb_zone == 0) {
            root.det_top_right();
        } else if (root.kb_zone == 2) {
            root.hero_library_focused = true;
        } else if (root.kb_zone == 1) {
            root.kb_tab = root.kb_tab == 0 ? 3 : root.kb_tab == 3 && root.in_library ? 4 : 0;
        } else if (root.kb_zone == 3 && root.det_content() == 2 && root.kb_ci == 0) {
            root.kb_cycle_season(1);
        } else if (root.kb_zone == 3 && root.det_content() == 2 && root.kb_ci == 1) {
            // Right steps one page forward.
            if (root.episode_page + 1 < root.episode_page_count) {
                root.episode_page_picked(root.episode_page + 1);
            }
        } else if (root.kb_zone == 3 && root.det_content() == 2 && root.kb_ci == 2) {
            if (root.kb_ep + 1 < root.episode_rows.length) {
                root.kb_ep += 1;
            }
        }
    }

    function kb_cycle_season(d: int) {
        let n = root.season_names.length;
        if (n == 0) {
            return;
        }
        let v = root.season_combo_idx + d;
        let c = Math.max(0, Math.min(n - 1, v));
        if (c != root.season_combo_idx) {
            root.season_combo_idx = c;
            root.season_picked(c);
        }
    }

    function kb_enter() {
        if (root.kb_zone == 0) {
            if (root.kb_top == 0) {
                if root.tracking_open { root.tracking_back(); } else { root.back(); }
            } else if (root.kb_top == 1 && root.in_library) {
                root.tracking_show();
            } else if (root.kb_top == 2 && root.in_library) {
                root.open_library_menu();
            }
        } else if (root.kb_zone == 1) {
            root.detail_tab_picked(root.kb_tab);
        } else if (root.kb_zone == 2) {
            if (root.hero_library_focused || !root.has_episodes) { root.add_to_library(); }
            else { root.watch_now(); }
        } else {
            if (root.det_content() == 1) {
                if (root.kb_s >= 0 && root.kb_s < root.stream_total) {
                    root.stream_picked(root.kb_s);
                }
            } else if (root.det_content() == 2) {
                if (root.kb_ci == 0) {
                    root.kb_cycle_season(1);
                } else if (root.kb_ci == 1) {
                    root.kb_edit = true;
                } else {
                    if (root.kb_ep >= 0 && root.kb_ep < root.episode_rows.length) {
                        root.episode_picked(root.kb_ep);
                    }
                }
            }
        }
    }

    function kb_back() {
        // A deep-linked streams view (Home Continue / Watch Now) skips the episode list,
        // so back closes the modal instead of revealing a screen never seen.
        if (!root.modal_episodes && root.episode_context != "" && !root.deep_stream) {
            root.episodes_back();
        } else {
            root.back();
        }
    }

    function tracking_back() {
        if root.tracking_candidate_title != "" { root.tracking_cancel_adjust(); }
        else { root.tracking_close(); }
    }

    function system_back() {
        root.kb_active = true;
        // Tracking shares Detail's toolbar, so its library menu still owns
        // the nearest Back layer before alignment or tab navigation.
        if (root.stream_action_open) {
            root.stream_action_open = false;
        } else if (root.menu_kind >= 0) {
            root.close_menu();
        } else if (root.tracking_open) {
            root.tracking_back();
        } else if (root.kb_edit || root.filter_focused) {
            root.kb_edit = false;
            root.filter_focused = false;
            nav_scope.focus();
        } else {
            root.kb_back();
        }
    }

    changed system_back_request => {
        if (root.last_system_back_request >= 0
            && root.system_back_request != root.last_system_back_request) {
            root.last_system_back_request = root.system_back_request;
            root.system_back();
        }
    }

    // ---- Page pan lock (horizontal rails) ----------------------------
    // Nested Flickables have no axis locking in Slint: whichever one crosses
    // the 8px grab threshold first owns the whole gesture, and a Flickable
    // that captured the pointer never gives it back. A finger on the 30px
    // pill strip always wobbles a little vertically, so the page used to
    // grab the drag a few frames in and scroll — mid-swipe, while the pills
    // stopped moving.
    //
    // The pills therefore block the page's pan at the *start* of the
    // gesture, not when their row starts moving (it cannot: the page holds
    // the press back for its 100ms drag-vs-tap window, so the row's own
    // Flickable only wakes up well after the page has had its chance). Two
    // reports keep it off — `StreamFilterBar::panned` for a horizontal pill
    // drag or any row movement (a fling coasts on `content-x` changes), and
    // `pan_released` to hand it back when the gesture is going vertical
    // instead — with the hold lapsing a moment after the reports stop. With
    // `interactive: false` the page also forwards events straight through,
    // so the pills get the rest of the gesture outright.
    //
    // The whole page is instantiated per modal open (see `page` below), so
    // this can never stay stuck across opens.
    // Narrow season cards reuse these pointer hints; automatic season
    // reveal deliberately does not lock the page.
    property <bool> page_pan_enabled: true;

    function filters_panned() {
        root.page_pan_enabled = false;
        // Longer than one 16ms drag/fling frame, so a live gesture keeps
        // re-arming the hold at every move. `restart` only re-arms a timer
        // that was started before (it is created stopped), so the first
        // report of a gesture has to start it.
        pan_release_t.running = true;
        pan_release_t.restart();
    }

    // The pill row is not panning any more (its gesture went vertical, or the
    // finger lifted): the page picks its pan straight back up.
    function filters_pan_released() {
        root.page_pan_enabled = true;
        pan_release_t.stop();
    }

    // Best-effort scroll follow (episode cards and stream rows have
    // variable heights, so nudge instead of computing exact strides).
    function kb_nudge(d: length) {
        let vy = det_scroll.content-y;
        let vh = det_scroll.height;
        let min_y = Math.min(0px, vh - det_scroll.content-height);
        let v = vy + d;
        det_scroll.content-y = Math.max(min_y, Math.min(0px, v));
    }

    function scroll_list_to_top(list_y: length) {
        // The final pager sits after many variable-height rows. Align the
        // start of the episode or stream list in the outer scroller after it is
        // used, so the next page begins at its first entry rather than at an
        // arbitrary offset left over from the bottom controls.
        let relative_y = list_y - det_scroll.absolute-position.y;
        let min_y = Math.min(0px, det_scroll.height - det_scroll.content-height);
        det_scroll.content-y = Math.max(
            min_y,
            Math.min(0px, det_scroll.content-y - relative_y),
        );
    }

    changed kb_zone => {
        if (root.kb_zone == 3) {
            root.kb_nudge(-120px);
        } else {
            root.kb_nudge(120px);
        }
    }
    changed detail_tab => {
        root.kb_s = 0;
        root.kb_ep = 0;
        root.kb_ci = 2;
        root.kb_tab = root.detail_tab;
        if (root.detail_tab != 3) { root.leave_episode_search(); }
    }
    changed episode_rows => {
        if (root.kb_ep >= root.episode_rows.length) {
            root.kb_ep = Math.max(0, root.episode_rows.length - 1);
        }
    }
    changed streams => {
        if (root.kb_s >= root.stream_total) {
            root.kb_s = Math.max(0, root.stream_total - 1);
        }
    }
    changed kb_s => {
        if (root.kb_active && root.kb_s >= 0 && root.kb_s / 25 != root.stream_page) {
            root.stream_page_picked(root.kb_s / 25);
        }
    }
    changed episode_context => { root.det_top_fix(); }
    changed modal_episodes => {
        root.det_top_fix();
        if (!root.modal_episodes) { root.leave_episode_search(); }
    }
    changed in_library => {
        root.det_top_fix();
        if (!root.in_library && root.menu_kind == 2) { root.close_menu(); }
        if (!root.in_library && root.tracking_open) { root.tracking_close(); }
    }
    changed category_rows => { root.det_top_fix(); }
    changed popup_open => {
        if (!root.popup_open) {
            nav_scope.focus();
        }
    }
    changed tracking_open => {
        if (root.tracking_open) {
            if (root.detail_tab != 4) { root.tracking_return_tab = root.detail_tab; }
            root.detail_tab = 4;
        } else {
            if (root.detail_tab == 4) { root.detail_tab = root.tracking_return_tab; }
            // The tab's focused input was removed. Keep Android Back in the
            // visible page capture chain even without a following pointer event.
            nav_scope.focus();
        }
    }

    function leave_episode_search() {
        // Tab/stream navigation removes the focused search input. Clear its
        // edit state and leave focus on a control that survives that change.
        root.kb_edit = false;
        root.filter_focused = false;
        if (!root.tracking_open && !root.popup_open) { nav_scope.focus(); }
    }

    callback back();
    callback episodes_back();
    callback add_to_library();
    callback library_action(int);
    callback open_categories();
    callback season_picked(int);
    callback episode_picked(int);
    // Pager move (absolute target page; the backend clamps it).
    callback episode_page_picked(int);
    callback stream_picked(int);
    callback stream_page_picked(int);
    callback stream_action_requested(string);
    callback stream_action_selected(string, int);
    callback stream_filter_picked(int);
    callback detail_tab_picked(int);
    callback episode_filter_changed(string);
    callback watch_now();
    // Manual watched-state (context menu + quick-toggle overlay).
    // Episode actions: 0 toggle, 1 mark watched, 2 mark unwatched,
    // 3 mark this + all previous watched, 4 clear resume position.
    callback episode_toggle_watched(int);
    callback episode_watch_action(int, int);
    // Season actions: 0 toggle whole season, 1 mark watched, 2 mark unwatched.
    callback season_watch_action(int, int);

    // Card bottom-sheet menu state (single instance per kind; -1 closed,
    // 0 episode, 1 season, 2 library entry). Pure UI state: the actions reuse the
    // callbacks above with the stored index.
    property <int> menu_kind: -1;
    property <int> menu_idx: 0;
    property <bool> menu_flag: false;
    property <float> menu_progress: 0.0;

    function open_ep_menu(idx: int, watched: bool, progress: float) {
        root.menu_kind = 0;
        root.menu_idx = idx;
        root.menu_flag = watched;
        root.menu_progress = progress;
    }

    function open_season_menu(idx: int, watched: bool) {
        root.menu_kind = 1;
        root.menu_idx = idx;
        root.menu_flag = watched;
    }

    property <[SheetItem]> library_menu_items: [
        { label: root.library_watched ? @tr("Mark series as unwatched") : @tr("Mark series as watched"), enabled: true },
        { label: @tr("Mark as On Hold"), enabled: true },
        { label: @tr("Mark as Dropped"), enabled: true },
        { label: @tr("Back to automatic"), enabled: true },
        { label: @tr("Categories"), enabled: root.category_rows.length > 0 },
        { label: @tr("Remove from library"), enabled: true },
        { label: root.library_activity_action == 4 ? @tr("Resume watching") : @tr("Wait for new episodes"), enabled: root.library_activity_action > 0 },
    ];

    function open_library_menu() {
        if (root.touch_menus) { root.menu_kind = 2; }
        else { library_options_ctx.show({ x: 0px, y: 0px }); }
    }

    function library_menu_picked(a: int) {
        root.close_menu();
        if (a == 4) { root.open_categories(); }
        else { root.library_action(a == 6 ? (root.library_activity_action == 4 ? 6 : 5) : a == 5 ? 4 : a); }
    }

    function request_stream_action(id: string) {
        root.stream_action_requested(id);
        // The backend fills the shared model and opens the touch sheet.
        // Desktop consumes the same model in the row's native popup instead.
        if (!root.touch_menus) { root.stream_action_open = false; }
    }

    function close_menu() {
        root.menu_kind = -1;
    }

    page := Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.current.artwork_canvas;

        // Fade both artwork and its black backing to the page canvas. Leaving
        // the backing opaque creates a black band above the coloured scrim.
        property <float> backdrop_fade: Math.min(1, Math.max(0, -det_scroll.content-y / ((root.backdrop_height - root.safe-top) * (root.narrow ? 0.643 : 0.703))));
        Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: root.backdrop_height;
            background: Theme.current.artwork_backdrop;
            opacity: 1 - page.backdrop_fade;
        }

        // Keep the artwork edge-to-edge behind the floating controls. The
        // scrims protect text while preserving the bright upper-right artwork.
        // Square masks with baked palette colours avoid thin-texture sampling
        // and offscreen colorization artifacts on resize or page recreation.
        backdrop_art := Image {
            x: 0px;
            // A small parallax lift, capped so the backdrop cannot slide
            // away while the user browses long episode or stream lists.
            y: Math.max(root.narrow ? -56px : -80px, Math.min(0px, det_scroll.content-y * 0.12));
            source: root.selected_backdrop.width > 0 ? root.selected_backdrop : root.selected_poster;
            image-fit: cover;
            width: 100%;
            height: root.backdrop_height;
            opacity: 1 - page.backdrop_fade;
        }
        Image {
            x: 0px;
            y: 0px;
            width: 100%;
            height: root.backdrop_height + 60px;
            source: Theme.true_black ? @image-url("../../assets/detail-bottom-scrim-black.svg") : @image-url("../../assets/detail-bottom-scrim.svg");
            image-fit: fill;
        }
        if !root.narrow: Image {
            x: 0px;
            y: 0px;
            width: 100%;
            height: root.backdrop_height + 60px;
            source: Theme.true_black ? @image-url("../../assets/detail-side-scrim-black.svg") : @image-url("../../assets/detail-side-scrim.svg");
            image-fit: fill;
        }

        // Fixed above the artwork but below controls, so parallax/scrolling
        // never exposes a bright patch behind the system status icons.
        if root.narrow: Image {
            // Slint centers a shorter image unless its position is explicit.
            x: 0px; y: 0px;
            width: 100%; height: root.safe-top + 64px;
            source: @image-url("../../assets/status-bar-scrim.svg");
            image-fit: fill;
            opacity: Theme.status_bar_gradient / 100;
        }

        // Entrance fade: the page is instantiated fresh per open (`if
        // modal_visible` in AppWindow), so the fade replays every time.
        // The page fill matches the window background, so only the content
        // (top bar, banner, tabs, body) reads as fading in. The flip is
        // deferred one tick: changing the value during creation would be
        // treated as the baseline and not animate.
        property <bool> entered: false;
        opacity: self.entered ? 1.0 : 0.0;
        animate opacity { duration: Anim.transition_fade; }

        enter_t := Timer {
            interval: 40ms;
            running: true;
            triggered => {
                enter_t.running = false;
                page.entered = true;
            }
        }

        // 6-button scope: overlays the page without intercepting the mouse.
        // The categories popup (separate scope) takes focus while open and
        // hands it back via popup_open below.
        nav_scope := FocusScope {
            width: 100%;
            height: 100%;
            init => {
                self.focus();
                root.last_system_back_request = root.system_back_request;
            }
            key-pressed(e) => {
                if (root.tracking_open && (e.text == Key.Escape || e.text == Key.Back || e.text == Key.Backspace)) {
                    if root.tracking_candidate_title != "" { root.tracking_cancel_adjust(); } else { root.tracking_close(); }
                    accept
                } else if (root.stream_action_open) {
                    root.stream_action_open = false;
                    accept
                } else if (root.menu_kind >= 0) {
                    // An open sheet eats Backspace (dismiss only).
                    root.close_menu();
                    accept
                } else if (root.kb_edit) {
                    root.kb_edit = false;
                    self.focus();
                    accept
                } else if (e.text == Key.UpArrow) {
                    root.kb_active = true;
                    root.det_zone_up();
                    accept
                } else if (e.text == Key.DownArrow) {
                    root.kb_active = true;
                    root.det_zone_down();
                    accept
                } else if (e.text == Key.LeftArrow) {
                    root.kb_active = true;
                    root.kb_left();
                    accept
                } else if (e.text == Key.RightArrow) {
                    root.kb_active = true;
                    root.kb_right();
                    accept
                } else if (e.text == Key.Return) {
                    root.kb_active = true;
                    root.kb_enter();
                    accept
                } else if (e.text == Key.Backspace || e.text == Key.Back) {
                    root.kb_active = true;
                    root.kb_back();
                    accept
                } else if (e.text == "w" || e.text == "W") {
                    // Quick watched-toggle for the focused episode card.
                    if (root.kb_zone == 3 && root.det_content() == 2 && root.kb_ci == 2
                        && root.kb_ep >= 0 && root.kb_ep < root.episode_rows.length) {
                        root.kb_active = true;
                        root.episode_toggle_watched(root.kb_ep);
                        accept
                    } else {
                        reject
                    }
                } else {
                    reject
                }
            }
        }

        // One-shot restore nudge: the modal is recreated per open with
        // restored kb props but no `changed` fires for pre-set values.
        restore_t := Timer {
            interval: 150ms;
            running: true;
            triggered => {
                if (root.kb_zone == 3) {
                    root.kb_nudge(-120px);
                }
                self.running = false;
            }
        }

        // Anchor below the saved-entry options button. Keep the menu outside
        // the conditional button so keyboard activation can reach it too.
        library_options_ctx := ContextMenuArea {
            x: root.width - root.safe-right - (root.narrow ? 10px + 44px : 16px + 48px);
            y: root.safe-top + (root.narrow ? 10px + 44px : 16px + 48px);
            width: 0px; height: 0px;
            enabled: root.in_library && !root.touch_menus;
            Menu {
                for action[a] in root.library_menu_items: MenuItem {
                    title: action.label;
                    enabled: action.enabled;
                    activated => { root.library_menu_picked(a); }
                }
            }
        }

        page_body := VerticalLayout {
            width: 100%;
            height: 100%;
            spacing: 0px;

            // Top bar: icon-only controls so the content below dominates.
            // The episode indicator/back affordance lives above the stream
            // list instead (see the Episodes tab).
            HorizontalLayout {
                spacing: root.narrow ? 6px : 12px;
                alignment: space-between;
                padding: root.narrow ? 10px : 16px;
                padding-bottom: 10px;
                padding-top: (root.narrow ? 10px : 16px) + safe-top;
                padding-left: (root.narrow ? 10px : 16px) + safe-left;
                padding-right: (root.narrow ? 10px : 16px) + safe-right;

                HorizontalLayout {
                    alignment: start;

                    TopIconButton {
                        narrow: root.narrow;
                        focused: root.kb_active && root.kb_zone == 0 && root.kb_top == 0;
                        accessible-role: button;
                        accessible-label: root.tracking_open ? (root.tracking_candidate_title != "" ? @tr("Back to review") : @tr("Back to details")) : @tr("Back");
                        clicked => {
                            root.kb_active = false;
                            root.kb_top = 0;
                            if root.tracking_open { root.tracking_back(); } else { root.back(); }
                        }

                        IcChevronLeft {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 24px;
                            height: 24px;
                            fill: Theme.current.text_bright;
                        }
                    }
                    if root.detail_tab == 4 && root.height < 600px: Text {
                        text: root.selected_title;
                        width: Math.max(0px, root.width - root.safe-left - root.safe-right - 224px);
                        height: root.narrow ? 44px : 48px;
                        font-size: 18px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                        color: Theme.current.text_bright;
                    }
                }

                HorizontalLayout {
                    spacing: root.narrow ? 6px : 10px;
                    alignment: end;

                    if root.in_library: tracking_button := TopIconButton {
                        narrow: root.narrow;
                        accessible-role: button;
                        accessible-label: @tr("Tracking");
                        focused: root.kb_active && root.kb_zone == 0 && root.kb_top == 1;
                        clicked => { root.kb_active = false; root.kb_top = 1; root.tracking_show(); }
                        IcSync {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 24px; height: 24px;
                            fill: Theme.current.text_hero_icon;
                        }
                    }
                    if root.in_library: library_options_button := TopIconButton {
                        narrow: root.narrow;
                        accessible-role: button;
                        accessible-label: @tr("Library options");
                        focused: root.kb_active && root.kb_zone == 0 && root.kb_top == 2;
                        clicked => { root.kb_active = false; root.kb_top = 2; root.open_library_menu(); }
                        IcMoreHoriz {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 24px; height: 24px;
                            fill: Theme.current.text_bright;
                        }
                    }
                }
            }

            det_scroll := Flickable {
                width: 100%;
                min-height: 0px;
                vertical-stretch: 1;
                // A raw Flickable, not a ScrollView (which does not expose
                // the inner Flickable's `interactive`): the pill bar's axis
                // lock flips exactly that (see `page_pan_enabled`). Panning
                // is otherwise unchanged — touch drags and mouse drags pan,
                // the wheel scrolls regardless of `interactive`.
                interactive: root.page_pan_enabled;

                VerticalLayout {
                    width: 100%;
                    padding-left: (root.narrow ? 20px : 64px) + safe-left;
                    padding-right: (root.narrow ? 20px : 64px) + safe-right;
                    padding-bottom: 16px;
                    spacing: 12px;
                    // Never distribute leftover viewport height here: with
                    // default stretch alignment and all-zero child stretches,
                    // extra space is shared EQUALLY by every child (see
                    // adjust_items), inflating short pages' grids. Leftover
                    // stays below the content instead.
                    alignment: start;

                    // Hero text stays below the artwork on phones and occupies
                    // the shaded left half on desktop. Height follows wrapped
                    // content so long titles and translations remain readable.
                    VerticalLayout {
                        width: 100%;
                        spacing: root.narrow ? 14px : 18px;
                        padding-top: root.hero_top_spacing;
                        padding-bottom: 16px;
                        alignment: start;

                        HorizontalLayout {
                            VerticalLayout {
                                width: root.hero_text_width;
                                spacing: root.narrow ? 14px : 18px;
                                alignment: start;
                                detail_title := TitleArtwork {
                                    title: root.selected_title; logo: root.selected_logo;
                                    title-alignment: root.narrow ? Theme.hero_title_alignment : 0;
                                    width: 100%; logo-height: root.narrow ? 88px : 136px;
                                    font-size: root.narrow ? 34px : (root.width >= 1200px ? 64px : 44px);
                                    max-lines: 3;
                                }
                                if root.selected_year != "": Text {
                                    text: root.selected_year;
                                    color: Theme.current.text_hero_metadata;
                                    font-size: root.narrow ? 16px : 21px;
                                    min-width: 0px;
                                    overflow: elide;
                                }
                                GridLayout {
                                    min-width: 0px;
                                    spacing: 8px;
                                    for g[i] in root.selected_genre_list: Rectangle {
                                        row: Math.floor(i / 4);
                                        col: Math.mod(i, 4);
                                        height: root.narrow ? 34px : 42px;
                                        min-width: 0px;
                                        border-radius: self.height / 2;
                                        background: Theme.current.hero_metadata_badge;
                                        border-width: 1px;
                                        border-color: Theme.current.border_overlay;
                                        HorizontalLayout {
                                            padding-left: root.narrow ? 10px : 18px;
                                            padding-right: root.narrow ? 10px : 18px;
                                            Text {
                                                text: g;
                                                color: Theme.current.text_hero_badge;
                                                font-size: root.narrow ? 12px : 16px;
                                                vertical-alignment: center;
                                                min-width: 0px;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                                if root.selected_description != "": hero_description := Rectangle {
                                    // Match the Synopsis card's full-text measurement
                                    // and animated viewport, using the hero's own width.
                                    height: root.hero_description_expanded ? hero_description_measure.preferred-height + 1px : Math.min(hero_description_measure.preferred-height + 1px, root.narrow ? 66px : 84px);
                                    animate height {
                                        duration: Anim.transition_slide;
                                        easing: ease-in-out;
                                    }
                                    clip: true;
                                    hero_description_measure := Text {
                                        x: 0px; y: 0px;
                                        width: root.hero_text_width;
                                        text: root.selected_description;
                                        font-size: root.narrow ? 15px : 19px;
                                        wrap: word-wrap;
                                        visible: false;
                                    }
                                    hero_description_text := Text {
                                        x: 0px; y: 0px;
                                        width: root.hero_text_width;
                                        height: 100%;
                                        overflow: elide;
                                        text: hero_description_measure.text;
                                        color: Theme.current.text_description;
                                        font-size: root.narrow ? 15px : 19px;
                                        wrap: word-wrap;
                                        vertical-alignment: top;
                                    }
                                    hero_description_touch := TouchArea {
                                        enabled: hero_description_measure.preferred-height > (root.narrow ? 66px : 84px);
                                        mouse-cursor: pointer;
                                        accessible-role: button;
                                        accessible-label: root.hero_description_expanded ? @tr("Show less") : @tr("Read more");
                                        property <bool> dragged: false;
                                        pointer-event(ev) => {
                                            if (ev.kind == PointerEventKind.down) { self.dragged = false; }
                                        }
                                        moved => {
                                            if (Math.abs(self.mouse-x - self.pressed-x) + Math.abs(self.mouse-y - self.pressed-y) > 12px) {
                                                self.dragged = true;
                                            }
                                        }
                                        clicked => {
                                            if (!self.dragged) {
                                                root.hero_description_expanded = !root.hero_description_expanded;
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    if !root.has_episodes: Rectangle { horizontal-stretch: 1; }
                                    if root.has_episodes: watch_action_button := Rectangle {
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        height: root.narrow ? 56px : 62px;
                                        border-radius: root.narrow ? 22px : 26px;
                                        background: watch_hero.has-hover ? Theme.current.primary_button_hover : Theme.current.primary_button;
                                        border-width: 1px;
                                        border-color: root.kb_active && root.kb_zone == 2 && !root.hero_library_focused ? Theme.current.text_bright : Theme.current.primary_button_border;
                                        accessible-role: button;
                                        accessible-label: root.watch_label;
                                        HorizontalLayout {
                                            padding-left: root.narrow ? 12px : 20px;
                                            padding-right: root.narrow ? 12px : 20px;
                                            spacing: 8px; alignment: center;
                                            Rectangle {
                                                width: 20px; height: 100%; horizontal-stretch: 0;
                                                IcPlay {
                                                    y: (parent.height - self.height) / 2;
                                                    width: 20px; height: 20px;
                                                    fill: Theme.current.on_accent;
                                                }
                                            }
                                            Text {
                                                text: root.watch_label;
                                                color: Theme.current.on_accent;
                                                font-size: root.narrow ? 14px : 18px;
                                                font-weight: 600;
                                                min-width: 0px; horizontal-stretch: 1;
                                                wrap: word-wrap; max-lines: 2; overflow: elide;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        watch_hero := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.kb_active = false; root.watch_now(); }
                                        }
                                    }
                                    library_state_button := Rectangle {
                                        width: root.narrow ? 56px : 62px;
                                        height: self.width;
                                        border-radius: self.width / 2;
                                        background: library_hero.has-hover ? Theme.current.hero_library_hover : Theme.current.hero_library;
                                        border-width: 1px;
                                        border-color: root.kb_active && root.kb_zone == 2 && (root.hero_library_focused || !root.has_episodes) ? Theme.current.accent_vivid : Theme.current.border_overlay;
                                        accessible-role: button;
                                        accessible-label: root.in_library ? @tr("Remove from library") : @tr("Add to library");
                                        if !root.in_library: IcAdd {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            width: 26px; height: 26px;
                                            fill: Theme.current.text_hero_icon;
                                        }
                                        if root.in_library: IcBookmark {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            width: 26px; height: 26px;
                                            fill: Theme.current.accent_vivid;
                                        }
                                        library_hero := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.kb_active = false; root.add_to_library(); }
                                        }
                                    }
                                }
                            }
                            if !root.narrow: Rectangle { horizontal-stretch: 1; }
                        }
                    }

                    DetailTabs {
                        narrow: root.narrow;
                        tracking_visible: root.in_library;
                        selected: root.detail_tab;
                        kb_active: root.kb_active;
                        focused: root.kb_zone == 1;
                        kb_tab: root.kb_tab;
                        picked(tab) => { root.kb_active = false; root.kb_tab = tab; root.detail_tab_picked(tab); }
                    }

                    // ---- Body: full-width content ---------------------
                    HorizontalLayout {
                        width: 100%;

                        // Keep short content packed at the top. min-width 0
                        // prevents long stream labels from widening the page.
                        VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            spacing: 10px;
                            alignment: start;

                            if root.detail_tab == 4: Rectangle {
                                width: 100%;
                                height: tracking_panel.preferred-height;
                tracking_panel := TrackingPanel {
                    open:root.tracking_open;
                    compact:false;
                    width:Math.min(1040px, parent.width);
                    height:self.preferred-height;
                    focus_request:root.tracking_focus_request;
                    back_to_details() => { root.tracking_close(); }
                    safe-bottom:root.safe-bottom;
                    links:root.tracking_links;
                    candidates:root.tracking_candidates;
                    selected_service <=> root.tracking_service;
                    setup:root.tracking_setup;
                    setup_revision:root.tracking_setup_revision;
                    setup_summary:root.tracking_setup_summary;
                    setup_unmapped:root.tracking_setup_unmapped;
                    setup_active:root.tracking_setup_active;
                    range_first:root.tracking_range_first;
                    range_last:root.tracking_range_last;
                    range_start:root.tracking_range_start;

                    preview_rows:root.tracking_preview_rows;
                    mapping_rows:root.tracking_mapping_rows;
                    notice:root.tracking_notice;
                    candidate_title:root.tracking_candidate_title;
                    busy:root.tracking_busy;
                    can_confirm:root.tracking_can_confirm;
                    search(a0,a1) => {root.tracking_search(a0,a1);}
                    pick(a0) => {root.tracking_pick(a0);}
                    preview(a0,a1,a2) => {root.tracking_preview(a0,a1,a2);}
                    confirm() => {root.tracking_confirm();}
                    accept_setup(revision,history) => {root.tracking_accept_setup(revision,history);}
                    adjust_setup(index) => {root.tracking_adjust_setup(index);}
                    cancel_adjust() => {root.tracking_cancel_adjust();}
                    assign(row,value) => {root.tracking_assign(row,value);}
                    edit(a0,a1,a2,a3,a4,a5,a6,a7) => {root.tracking_edit(a0,a1,a2,a3,a4,a5,a6,a7);}
                    action(a0,a1) => {root.tracking_action(a0,a1);}
                }
                            }

                            // ---- Overview tab -------------------------
                            // start-aligned: never share leftover height
                            // between children (see scroll content note).
                            if root.detail_tab == 0: VerticalLayout {
                                spacing: 10px;
                                alignment: start;

                                GridLayout {
                                    spacing: root.narrow ? 16px : 24px;
                                    Rectangle {
                                        row: 0;
                                        col: 0;
                                        width: root.narrow ? root.width - 40px - root.safe-left - root.safe-right : (root.width - 128px - root.safe-left - root.safe-right - 24px) * 0.44;
                                        height: root.narrow ? 120px : 190px;
                                        border-radius: Theme.card_corner_radius;
                                        clip: true;
                                        background: Theme.current.season_card;
                                        Image {
                                            source: root.selected_backdrop.width > 0 ? root.selected_backdrop : root.selected_poster;
                                            image-fit: cover;
                                            width: 100%;
                                            height: 100%;
                                        }
                                        Rectangle {
                                            width: 100%; height: 100%;
                                            background: Theme.current.season_scrim;
                                        }
                                        Text {
                                            x: 20px; y: parent.height - 42px;
                                            text: @tr("Artwork");
                                            color: Theme.current.text_bright;
                                            font-size: 18px;
                                            font-weight: 600;
                                        }
                                    }
                                Rectangle {
                                    row: root.narrow ? 1 : 0;
                                    col: root.narrow ? 0 : 1;
                                    width: root.synopsis_width;
                                    background: Theme.current.season_caption;
                                    border-radius: Theme.card_corner_radius;
                                    border-width: 1px;
                                    border-color: Theme.current.hover_overlay;
                                    VerticalLayout {
                                        padding: root.narrow ? 16px : 24px;
                                        spacing: 12px;
                                        alignment: start;
                                        Text {
                                            text: @tr("Synopsis");
                                            color: Theme.current.text_bright;
                                            font-size: root.narrow ? 20px : 24px;
                                            font-weight: 700;
                                        }
                                        synopsis_view := Rectangle {
                                            // Measure the complete paragraph separately so
                                            // the displayed text can fit the animated viewport
                                            // and elide whole lines instead of clipping glyphs.
                                            height: root.synopsis_expanded ? synopsis_measure.preferred-height + 1px : Math.min(synopsis_measure.preferred-height + 1px, root.narrow ? 80px : 84px);
                                            animate height {
                                                duration: Anim.transition_slide;
                                                easing: ease-in-out;
                                            }
                                            clip: true;
                                            synopsis_measure := Text {
                                                x: 0px;
                                                y: 0px;
                                                width: root.synopsis_width - (root.narrow ? 32px : 48px);
                                                text: root.selected_description != "" ? root.selected_description : @tr("No description provided by the addon.");
                                                font-size: root.narrow ? 15px : 18px;
                                                wrap: word-wrap;
                                                visible: false;
                                            }
                                            synopsis_text := Text {
                                                x: 0px;
                                                y: 0px;
                                                width: root.synopsis_width - (root.narrow ? 32px : 48px);
                                                height: 100%;
                                                text: synopsis_measure.text;
                                                color: Theme.current.text_episode_metadata;
                                                font-size: root.narrow ? 15px : 18px;
                                                wrap: word-wrap;
                                                overflow: elide;
                                                vertical-alignment: top;
                                            }
                                        }
                                        if synopsis_measure.preferred-height > (root.narrow ? 80px : 84px): Rectangle {
                                            height: 28px;
                                            Text {
                                                text: root.synopsis_expanded ? @tr("Show less") : @tr("Read more");
                                                color: Theme.current.accent_vivid;
                                                font-size: 16px;
                                                vertical-alignment: center;
                                            }
                                            TouchArea {
                                                accessible-role: button;
                                                accessible-label: root.synopsis_expanded ? @tr("Show less") : @tr("Read more");
                                                mouse-cursor: pointer;
                                                clicked => { root.synopsis_expanded = !root.synopsis_expanded; }
                                            }
                                        }
                                    }
                                }

                                }

                                // Movies list their streams here (series
                                // streams live in the Episodes tab).
                                if !root.modal_episodes && !root.has_episodes: StreamList {
                                    rows: root.streams;
                                    hint: root.streams_hint;
                                    addons: root.stream_addons;
                                    loading: root.stream_loading;
                                    searching: root.streams_searching;
                                    addon_filter: root.stream_filter;
                                    page: root.stream_page;
                                    page_count: root.stream_page_count;
                                    page_start: root.stream_page_start;
                                    kb_focus: root.kb_zone == 3 ? root.kb_s : -1;
                                    kb_active: root.kb_active;
                                    touch_menus: root.touch_menus;
                                    picked(i) => { root.kb_active = false; root.stream_picked(i); }
                                    page_picked(p) => {
                                        root.kb_active = false;
                                        root.stream_page_picked(p);
                                        root.kb_s = p * 25;
                                    }
                                    bottom_page_picked(p, y) => {
                                        root.kb_active = false;
                                        root.stream_page_picked(p);
                                        root.kb_s = p * 25;
                                        root.scroll_list_to_top(y);
                                    }
                                    action_items: root.stream_action_items;
                                    action_requested(id) => { root.request_stream_action(id); }
                                    action_selected(id, a) => { root.stream_action_selected(id, a); }
                                    filter_picked(i) => {
                                        root.kb_active = false;
                                        root.kb_s = 0;
                                        root.stream_filter_picked(i);
                                    }
                                    filter_panned => { root.filters_panned(); }
                                    filter_pan_released => { root.filters_pan_released(); }
                                }
                            }

                            // ---- Stub tabs (no addon data) ------------
                            if root.detail_tab == 1 || root.detail_tab == 2: Text {
                                text: @tr("Not provided by Stremio addons.");
                                color: Theme.current.text_disabled;
                                font-size: 13px;
                            }

                            // ---- Episodes tab -------------------------
                            // start-aligned: the grid must keep its natural
                            // height (see scroll content note).
                            if root.detail_tab == 3: VerticalLayout {
                                // Percent-sized controls alone have no intrinsic width.
                                // Keep this column anchored when filtering removes the
                                // fixed-width episode cards (including all results).
                                width: root.episode_content_w;
                                spacing: 10px;
                                alignment: start;

                                // `if` keeps big episode grids uninstantiated when
                                // hidden; keyboard edit-mode focuses the
                                // filter via edit_watcher below (page scope
                                // cannot see ids inside `if`).
                                if root.modal_episodes: VerticalLayout {
                                    width: 100%;
                                    spacing: 8px;
                                    alignment: start;

                                    // Enters filter edit mode on demand: the
                                    // page sets kb_edit, this focuses the
                                    // field (accepting the keystrokes); the
                                    // field's accepted handler exits edit.
                                    edit_watcher := Timer {
                                        interval: 80ms;
                                        running: root.kb_edit;
                                        triggered => { root.episode_search_open = true; filter_line.focus(); }
                                    }

                                    // ---- Season picker ----------------------
                                    // Art-backed season wall (tap a card to
                                    // switch seasons). The keyboard zone is
                                    // unchanged (kb_ci == 0, Left/Right
                                    // cycles, Enter steps); the ring on the
                                    // selected card shows focus (same as the
                                    // episode grid, which also has no mark).
                                    // No label row above the wall: its emoji
                                    // measured narrower than it painted on
                                    // Android and let the page wiggle sideways.
                                    season_picker := Rectangle {
                                        width: 100%;
                                        height: root.season_cards.length == 0 ? 0px : (root.narrow ? root.season_card_w * 9 / 16 : Math.ceil(root.season_cards.length / root.season_cols) * (root.season_card_w * 9 / 16 + root.card-gap) - root.card-gap);
                                        property <int> selected_index: root.season_combo_idx;
                                        changed selected_index => { season_flick.reveal_selected(); }

                                        season_flick := Flickable {
                                            x: root.narrow ? 0px : (parent.width - self.width) / 2;
                                            width: root.narrow ? parent.width : season_grid.width;
                                            height: parent.height;
                                            interactive: root.narrow;
                                            content-width: Math.max(self.width, season_grid.width);
                                            content-height: self.height;
                                            // Match Home's Continue row: card hints choose the
                                            // axis early, and row movement maintains the page hold.
                                            // Automatic selected-card reveal must not arm it.
                                            property <length> revealed_x: 0px;
                                            changed content-x => {
                                                if (root.narrow && !root.kb_active && self.content-x != self.revealed_x) {
                                                    root.filters_panned();
                                                }
                                            }
                                            changed width => { self.reveal_selected(); }
                                            init => { self.reveal_selected(); }
                                            function reveal_selected() {
                                                if (!root.narrow) {
                                                    self.revealed_x = 0px;
                                                    self.content-x = 0px;
                                                    return;
                                                }
                                                let left = Math.max(0, root.season_combo_idx) * (root.season_card_w + root.card-gap);
                                                let right = left + root.season_card_w;
                                                let target = left + self.content-x < 0px ? -left :
                                                    right + self.content-x > self.width ? self.width - right : self.content-x;
                                                // Publish the automatic offset before moving the row,
                                                // so its content-x callback cannot hold the page.
                                                self.revealed_x = Math.max(self.width - self.content-width, Math.min(0px, target));
                                                self.content-x = self.revealed_x;
                                                root.filters_pan_released();
                                            }

                                            season_grid := GridLayout {
                                                // The narrow row has its own scrollable width;
                                                // desktop keeps the centered capped grid.
                                                width: Math.max(0px, (root.narrow ? root.season_cards.length : root.season_grid_cols) * (root.season_card_w + root.card-gap) - root.card-gap);
                                                height: season_picker.height;
                                                spacing: root.card-gap;

                                                for s[i] in root.season_cards: Rectangle {
                                                    row: root.narrow ? 0 : Math.floor(i / root.season_cols);
                                                    col: root.narrow ? i : Math.mod(i, root.season_cols);
                                                    // Fixed shared width (see
                                                    // season_card_w): keeps every
                                                    // column equal.
                                                    width: root.season_card_w;
                                                    // Cinematic 16:9 cards.
                                                    height: root.season_card_w * 9 / 16;
                                                    border-radius: Theme.card_corner_radius;
                                                    clip: true;
                                                    background: Theme.current.episode_placeholder;
                                                    border-width: root.season_combo_idx == i ? 2px : 0px;
                                                    border-color: root.kb_active && root.kb_zone == 3 && root.kb_ci == 0 && root.season_combo_idx == i ? Theme.current.text_bright : Theme.current.accent;

                                                    if s.has_thumb: Image {
                                                        source: s.thumb;
                                                        image-fit: cover;
                                                        width: 100%;
                                                        height: 100%;
                                                    }

                                                    if !s.has_thumb: Text {
                                                        text: "🎬";
                                                        font-size: 22px;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }

                                                    // Dim the art so the label
                                                    // stays legible.
                                                    Rectangle {
                                                        width: 100%;
                                                        height: 100%;
                                                        background: Theme.current.scrim_episode;
                                                    }

                                                    Text {
                                                        text: s.name;
                                                        color: Theme.current.text_bright;
                                                        font-size: 17px;
                                                        font-weight: 700;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }

                                                    // Watched check (top-right) for fully-seen seasons:
                                                    // same small white disc + black check as the
                                                    // episode cards.
                                                    if s.watched: Rectangle {
                                                        x: parent.width - 28px;
                                                        y: 4px;
                                                        width: 22px;
                                                        height: 22px;
                                                        border-radius: 11px;
                                                        background: Theme.current.watched_badge;

                                                        IcCheck {
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                            width: 13px;
                                                            height: 13px;
                                                            fill: Theme.current.on_watched_badge;
                                                        }
                                                    }

                                                    // Card menu: desktop right-click opens the
                                                    // native popup at the cursor; touch hold
                                                    // opens the bottom sheet (see below).
                                                    season_ctx := ContextMenuArea {
                                                        width: 100%;
                                                        height: 100%;

                                                        Menu {
                                                            MenuItem {
                                                                title: s.watched ? @tr("Mark season as unwatched") : @tr("Mark season as watched");
                                                                activated => { root.season_watch_action(i, 0); }
                                                            }
                                                            MenuSeparator {}
                                                            MenuItem {
                                                                title: @tr("Select season");
                                                                activated => {
                                                                    root.kb_active = false;
                                                                    root.kb_zone = 3;
                                                                    root.kb_ci = 0;
                                                                    root.season_picked(i);
                                                                }
                                                            }
                                                        }

                                                    touch_season := TouchArea {
                                                        property <bool> lp_suppress: false;
                                                        property <bool> dragged: false;
                                                        property <length> hint_x: 0px;
                                                        property <length> hint_y: 0px;
                                                        property <bool> hint_live: false;
                                                        property <bool> hint_held: false;
                                                        function hint_stop() {
                                                            self.hint_live = false;
                                                            if (self.hint_held) {
                                                                self.hint_held = false;
                                                                root.filters_pan_released();
                                                            }
                                                        }
                                                        changed pressed => { if (!self.pressed) { self.hint_stop(); } }
                                                        accessible-role: button;
                                                        accessible-label: s.name;
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            if (touch_season.lp_suppress || touch_season.dragged) {
                                                                touch_season.lp_suppress = false;
                                                                touch_season.dragged = false;
                                                            } else {
                                                                root.kb_active = false;
                                                                root.kb_zone = 3;
                                                                root.kb_ci = 0;
                                                                root.season_picked(i);
                                                            }
                                                        }
                                                        pointer-event(ev) => {
                                                            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                                                                season_lp_timer.stop();
                                                                if (root.touch_menus) {
                                                                    root.open_season_menu(i, s.watched);
                                                                } else {
                                                                    season_ctx.show({ x: touch_season.mouse-x, y: touch_season.mouse-y });
                                                                }
                                                            } else if (ev.kind == PointerEventKind.down) {
                                                                root.kb_active = false;
                                                                touch_season.lp_suppress = false;
                                                                touch_season.dragged = false;
                                                                self.hint_x = self.mouse-x;
                                                                self.hint_y = self.mouse-y;
                                                                self.hint_live = true;
                                                                if (root.touch_menus) {
                                                                    season_lp_timer.stop();
                                                                    season_lp_timer.start();
                                                                }
                                                            } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                                                season_lp_timer.stop();
                                                                self.hint_stop();
                                                            } else if (ev.kind == PointerEventKind.move && root.narrow) {
                                                                // Decide the axis before the page captures a
                                                                // slightly diagonal horizontal season swipe.
                                                                if (!(self.pressed || ev.touch-finger-id != 0)) {
                                                                    self.hint_stop();
                                                                    return;
                                                                }
                                                                root.kb_active = false;
                                                                if (!self.hint_live) {
                                                                    self.hint_x = self.mouse-x;
                                                                    self.hint_y = self.mouse-y;
                                                                    self.hint_live = true;
                                                                }
                                                                let dx = self.mouse-x - self.hint_x;
                                                                let dy = self.mouse-y - self.hint_y;
                                                                if (Math.abs(dy) > 8px && Math.abs(dy) > Math.abs(dx)) {
                                                                    self.hint_stop();
                                                                } else {
                                                                    self.hint_held = true;
                                                                    root.filters_panned();
                                                                }
                                                            }
                                                        }
                                                        moved => {
                                                            if (Math.abs(touch_season.mouse-x - touch_season.pressed-x) + Math.abs(touch_season.mouse-y - touch_season.pressed-y) > 12px) {
                                                                touch_season.dragged = true;
                                                                season_lp_timer.stop();
                                                            }
                                                        }
                                                    }
                                                    }

                                                    // Hold-to-open timer (pinned off until a
                                                    // press arms it; see ep_lp_timer).
                                                    season_lp_timer := Timer {
                                                        interval: 600ms;
                                                        running: false;
                                                        triggered => {
                                                            self.stop();
                                                            touch_season.lp_suppress = true;
                                                            root.open_season_menu(i, s.watched);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    episode_search_focus := Timer {
                                        interval: 80ms;
                                        running: false;
                                        triggered => {
                                            self.stop();
                                            if (root.episode_search_open) { filter_line.focus(); }
                                        }
                                    }

                                    episode_toolbar := Rectangle {
                                        width: 100%;
                                        height: root.episode_search_open ? 120px : 64px;
                                        animate height { duration: Anim.transition_slide; easing: ease-out; }
                                        border-radius: 16px;
                                        background: Theme.current.episode_toolbar;
                                        border-width: 1px;
                                        border-color: root.filter_focused ? Theme.current.focus_soft : Theme.current.border_medium;
                                        // The field stays instantiated for keyboard focus requests.
                                        // Explicit row positions keep the header stable as it expands.
                                        clip: true;

                                        HorizontalLayout {
                                            x: 10px; y: 10px;
                                            width: parent.width - 20px;
                                            height: 44px;
                                            spacing: 8px;
                                            Rectangle {
                                                width: 44px; height: 44px;
                                                horizontal-stretch: 0;
                                                border-radius: 12px;
                                                background: root.episode_search_open ? Theme.current.search_active_wash : (episode_search_toggle.has-hover ? Theme.current.episode_search_hover : Theme.current.episode_search);
                                                border-width: 1px;
                                                border-color: root.kb_active && root.kb_zone == 3 && root.kb_ci == 1 ? Theme.current.accent_vivid : (root.episode_search_open || root.episode_filter != "" ? Theme.current.focus_soft : Theme.current.border_medium);
                                                if !root.episode_search_open: IcSearch {
                                                    x: 12px; y: 12px;
                                                    width: 20px; height: 20px;
                                                    fill: root.episode_filter != "" ? Theme.current.text_search_match : Theme.current.icon_episode_search;
                                                }
                                                if root.episode_search_open: IcClose {
                                                    x: 12px; y: 12px;
                                                    width: 20px; height: 20px;
                                                    fill: Theme.current.text_search_match;
                                                }
                                                episode_search_toggle := TouchArea {
                                                    accessible-role: button;
                                                    accessible-label: root.episode_search_open ? @tr("Hide episode search") : @tr("Search episodes");
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.kb_active = false;
                                                        root.episode_search_open = !root.episode_search_open;
                                                        if (root.episode_search_open) {
                                                            episode_search_focus.start();
                                                        } else {
                                                            episode_search_focus.stop();
                                                            root.kb_edit = false;
                                                            nav_scope.focus();
                                                        }
                                                    }
                                                }
                                            }
                                            episode_result_count := Text {
                                                text: root.episode_filter != "" ? @tr("Found: {}", root.episode_total) : @tr("{} in this season", root.episode_total);
                                                color: Theme.current.text_episode_counter;
                                                font-size: 12px;
                                                min-width: 0px;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                            if root.episode_page_count > 1: episode_top_pager := EpisodePager {
                                                episode-style: true;
                                                page: root.episode_page;
                                                count: root.episode_page_count;
                                                picked(p) => { root.episode_page_picked(p); }
                                            }
                                        }
                                        filter_line := SearchField {
                                            x: 10px; y: 62px;
                                            width: parent.width - 20px;
                                            height: 48px;
                                            visible: root.episode_search_open;
                                            enabled: root.episode_search_open;
                                            prominent: true;
                                            search-icon: true;
                                            min-width: 0px;
                                            text <=> root.episode_filter;
                                            placeholder-text: @tr("Search episodes…");
                                            background: Theme.current.episode_empty_panel;
                                            focus_changed(focused) => { root.filter_focused = focused; }
                                            edited(t) => { root.episode_filter_changed(t); }
                                            accepted(t) => {
                                                root.episode_filter_changed(t);
                                                root.kb_edit = false;
                                                nav_scope.focus();
                                            }
                                        }
                                    }

                                    if root.episode_rows.length == 0 && root.episode_filter != "": episode_empty := Rectangle {
                                        width: 100%;
                                        height: Math.max(96px, empty_copy.preferred-height);
                                        border-radius: 16px;
                                        background: Theme.current.episode_card;
                                        empty_copy := VerticalLayout {
                                            padding: 16px;
                                            spacing: 6px;
                                            alignment: center;
                                            episode_empty_title := Text {
                                                text: @tr("No matching episodes");
                                                color: Theme.current.text_primary;
                                                font-size: 15px;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                wrap: word-wrap;
                                            }
                                            episode_empty_hint := Text {
                                                text: @tr("Try a different title or episode number.");
                                                color: Theme.current.text_episode_hint;
                                                font-size: 13px;
                                                horizontal-alignment: center;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    GridLayout {
                                        spacing: root.card-gap;

                                        for e[i] in root.episode_rows: ep_card := Rectangle {
                                            row: Math.floor(i / root.ep_cols);
                                            col: Math.mod(i, root.ep_cols);
                                            // Fixed shared width (see ep_card_w):
                                            // keeps every column equal.
                                            width: root.ep_card_w;
                                            // Keep the full canvas even when artwork and
                                            // synopsis metadata are unavailable.
                                            height: Math.max(240px, self.width * 0.43);
                                            // Hard containment: on some renderer
                                            // paths overflowing text is painted
                                            // past its element instead of being
                                            // elided, so the card itself must
                                            // clip (nothing may reach the next
                                            // row's thumbnails).
                                            clip: true;
                                            background: Theme.current.episode_card;
                                            border-radius: Theme.card_corner_radius;
                                            border-width: root.kb_active && root.kb_zone == 3 && root.kb_ci == 2 && root.kb_ep == i ? 2px : 1px;
                                            border-color: root.kb_active && root.kb_zone == 3 && root.kb_ci == 2 && root.kb_ep == i ? Theme.current.focus_ring : Theme.current.border_card;

                                            // Card menu: desktop right-click opens the
                                            // native popup at the cursor; touch hold
                                            // opens the bottom sheet (see below).
                                            // The TouchArea owns all presses (see
                                            // upstream slint#12354), both paths open
                                            // explicitly from its handlers.
                                            ep_ctx := ContextMenuArea {
                                                width: 100%;
                                                height: 100%;

                                                Menu {
                                                    MenuItem {
                                                        title: e.watched ? @tr("Mark episode as unwatched") : @tr("Mark episode as watched");
                                                        activated => { root.episode_watch_action(root.episode_page_start + i, e.watched ? 2 : 1); }
                                                    }
                                                    MenuItem {
                                                        title: @tr("Mark episode and previous as watched");
                                                        enabled: !e.watched;
                                                        activated => { root.episode_watch_action(root.episode_page_start + i, 3); }
                                                    }
                                                    MenuItem {
                                                        title: @tr("Clear resume position");
                                                        enabled: !e.watched && e.progress > 0;
                                                        activated => { root.episode_watch_action(root.episode_page_start + i, 4); }
                                                    }
                                                    MenuSeparator {}
                                                    MenuItem {
                                                        title: @tr("Open episode");
                                                        activated => {
                                                            root.kb_active = false;
                                                            root.episode_picked(root.episode_page_start + i);
                                                        }
                                                    }
                                                }

                                            touch_ep := TouchArea {
                                                property <bool> lp_suppress: false;
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    if (touch_ep.lp_suppress) {
                                                        // Release after a hold: the sheet
                                                        // is already up, don't open.
                                                        touch_ep.lp_suppress = false;
                                                    } else {
                                                        root.kb_active = false;
                                                        root.episode_picked(root.episode_page_start + i);
                                                    }
                                                }
                                                pointer-event(ev) => {
                                                    if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                                                        ep_lp_timer.stop();
                                                        if (root.touch_menus) {
                                                            root.open_ep_menu(root.episode_page_start + i, e.watched, e.progress);
                                                        } else {
                                                            ep_ctx.show({ x: touch_ep.mouse-x, y: touch_ep.mouse-y });
                                                        }
                                                    } else if (ev.kind == PointerEventKind.down) {
                                                        touch_ep.lp_suppress = false;
                                                        // Hold-to-sheet is a touch flow;
                                                        // desktop keeps click-only behavior.
                                                        if (root.touch_menus) {
                                                            ep_lp_timer.stop();
                                                            ep_lp_timer.start();
                                                        }
                                                    } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                                        ep_lp_timer.stop();
                                                    }
                                                }
                                                // Finger jitter must not cancel the hold;
                                                // only a real drag (scroll) does.
                                                moved => {
                                                    if (Math.abs(touch_ep.mouse-x - touch_ep.pressed-x) + Math.abs(touch_ep.mouse-y - touch_ep.pressed-y) > 24px) {
                                                        ep_lp_timer.stop();
                                                    }
                                                }
                                            }
                                            }

                                            // Hold-to-open timer. NOTE: Slint Timers
                                            // run from creation by default
                                            // (`running` defaults true), so it is
                                            // pinned off here and only armed by a
                                            // press. A 600ms stationary hold opens
                                            // the sheet; taps/drags stop it first.
                                            ep_lp_timer := Timer {
                                                interval: 600ms;
                                                running: false;
                                                triggered => {
                                                    self.stop();
                                                    touch_ep.lp_suppress = true;
                                                    root.open_ep_menu(root.episode_page_start + i, e.watched, e.progress);
                                                }
                                            }

                                            // Full-bleed artwork: badges stay at the top while
                                            // text sits over a dark, continuous bottom scrim.
                                            if e.has_thumb: episode_artwork := Image {
                                                x: 0px; y: 0px;
                                                width: 100%; height: 100%;
                                                source: e.thumb;
                                                image-fit: cover;
                                            }
                                            Image {
                                                x: 0px; y: 0px;
                                                width: 100%; height: 100%;
                                                source: @image-url("../../assets/episode-card-scrim.svg");
                                                colorize: Theme.current.scrim_episode_card;
                                                image-fit: fill;
                                            }

                                            if e.ep_no != "": Rectangle {
                                                x: 14px; y: 14px;
                                                width: episode_badge.preferred-width + 24px;
                                                height: 30px;
                                                border-radius: 15px;
                                                background: Theme.current.episode_number_badge;
                                                border-width: 1.5px;
                                                border-color: Theme.current.episode_number_border;
                                                episode_badge := Text {
                                                    x: 12px; y: 0px;
                                                    height: 100%;
                                                    text: e.ep_no;
                                                    color: Theme.current.text_bright;
                                                    font-size: 14px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            if e.watched: episode_watched := Rectangle {
                                                x: parent.width - self.width - 14px;
                                                y: 14px;
                                                width: 30px; height: 30px;
                                                border-radius: 15px;
                                                background: Theme.current.watched_badge;
                                                IcCheck {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    width: 18px; height: 18px;
                                                    fill: Theme.current.episode_card;
                                                }
                                            }

                                            // Measure with the same font as the visible title:
                                            // a guessed line height can elide its second line.
                                            episode_title_measure := Text {
                                                width: episode_title.width;
                                                text: e.text;
                                                font-size: episode_title.font-size;
                                                font-weight: 700;
                                                wrap: word-wrap;
                                                visible: false;
                                            }
                                            episode_title_two_lines := Text {
                                                text: "Ag\nAg";
                                                font-size: episode_title.font-size;
                                                font-weight: 700;
                                                visible: false;
                                            }

                                            episode_content := VerticalLayout {
                                                x: 16px;
                                                y: ep_card.height - self.height - 16px;
                                                width: ep_card.width - 32px;
                                                height: self.preferred-height;
                                                spacing: 7px;
                                                alignment: start;

                                                episode_title := Text {
                                                    width: parent.width * (ep_card.width > 520px ? 0.75 : 1.0);
                                                    text: e.text;
                                                    color: Theme.current.text_bright;
                                                    font-size: Math.max(18px, Math.min(24px, ep_card.width * 0.045));
                                                    font-weight: 700;
                                                    height: Math.min(episode_title_measure.preferred-height, episode_title_two_lines.preferred-height) + 1px;
                                                    vertical-alignment: top;
                                                    wrap: word-wrap;
                                                    overflow: elide;
                                                }

                                                if e.date != "" || e.runtime != "": HorizontalLayout {
                                                    height: 18px;
                                                    spacing: e.date != "" && e.runtime != "" ? 12px : 0px;
                                                    if e.date != "": HorizontalLayout {
                                                        width: Math.min(e.runtime != "" ? (parent.width - 24px) * 0.6 : parent.width, episode_date.preferred-width + 23px);
                                                        horizontal-stretch: 0;
                                                        spacing: 7px;
                                                        Path {
                                                            width: 16px; height: 16px;
                                                            viewbox-width: 24; viewbox-height: 24;
                                                            commands: "M4 5H20V21H4Z M4 10H20 M8 2V7 M16 2V7 M8 13H9 M12 13H13 M16 13H17 M8 17H9 M12 17H13 M16 17H17";
                                                            fill: transparent;
                                                            stroke: Theme.current.text_settings;
                                                            stroke-width: 1.5px;
                                                        }
                                                        episode_date := Text {
                                                            text: e.date;
                                                            color: Theme.current.text_settings;
                                                            font-size: 13px;
                                                            overflow: elide;
                                                            vertical-alignment: center;
                                                            horizontal-stretch: 1;
                                                        }
                                                    }
                                                    if e.runtime != "": HorizontalLayout {
                                                        width: Math.min(e.date != "" ? (parent.width - 24px) * 0.4 : parent.width, episode_runtime.preferred-width + 23px);
                                                        horizontal-stretch: 0;
                                                        spacing: 7px;
                                                        IcSchedule {
                                                            width: 16px; height: 16px;
                                                            fill: Theme.current.text_settings;
                                                        }
                                                        episode_runtime := Text {
                                                            text: e.runtime;
                                                            color: Theme.current.text_settings;
                                                            font-size: 13px;
                                                            overflow: elide;
                                                            vertical-alignment: center;
                                                            horizontal-stretch: 1;
                                                        }
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                }

                                                if e.details != "": episode_synopsis := Text {
                                                    text: e.details;
                                                    color: Theme.current.text_settings;
                                                    font-size: 14px;
                                                    height: 2 * self.font-size * 1.4;
                                                    vertical-alignment: top;
                                                    wrap: word-wrap;
                                                    overflow: elide;
                                                }

                                                // Completed episodes keep the watched disc; only
                                                // unfinished playback needs a resume rail.
                                                if !e.watched && e.progress > 0: episode_progress := HorizontalLayout {
                                                    height: 20px;
                                                    spacing: 10px;
                                                    Rectangle {
                                                        horizontal-stretch: 1;
                                                        episode_progress_track := Rectangle {
                                                            x: 0px;
                                                            y: (parent.height - self.height) / 2;
                                                            width: 100%; height: 7px;
                                                            border-radius: 3.5px;
                                                            background: Theme.current.progress_track_overlay;
                                                            Rectangle {
                                                                x: 0px;
                                                                width: parent.width * Math.max(0, Math.min(1, e.progress));
                                                                height: 100%;
                                                                border-radius: 3.5px;
                                                                background: Theme.current.progress_fill;
                                                            }
                                                        }
                                                    }
                                                    episode_percentage := Text {
                                                        text: @tr("{}%", Math.round(Math.max(0, Math.min(1, e.progress)) * 100));
                                                        color: Theme.current.text_bright;
                                                        font-size: 14px;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // Turning the page at the bottom returns to the search
                                    // bar and first new card, even for a shorter last page.
                                    if root.episode_page_count > 1: HorizontalLayout {
                                        width: 100%;
                                        height: 44px;
                                        alignment: end;
                                        EpisodePager {
                                            episode-style: true;
                                            page: root.episode_page;
                                            count: root.episode_page_count;
                                            picked(p) => {
                                                root.episode_page_picked(p);
                                                root.scroll_list_to_top(episode_toolbar.absolute-position.y);
                                            }
                                        }
                                    }
                                }

                                // Picked episode: an indicator/back bar (the
                                // top bar is icon-only) above its streams.
                                if !root.modal_episodes: VerticalLayout {
                                    width: 100%;
                                    min-width: 0px;
                                    spacing: 10px;
                                    alignment: start;

                                    if root.episode_context != "": Rectangle {
                                        width: 100%;
                                        height: root.narrow ? 40px : 34px;
                                        border-radius: 8px;
                                        background: ep_ctx_touch.has-hover ? Theme.current.control_hover : Theme.current.stream_card;

                                        HorizontalLayout {
                                            padding-left: 4px;
                                            padding-right: 12px;
                                            spacing: 4px;
                                            alignment: start;

                                            Rectangle {
                                                width: root.narrow ? 32px : 28px;
                                                // Full bar height: this box only
                                                // reserves the icon's width, and a
                                                // HorizontalLayout top-aligns a
                                                // plain Rectangle child (no
                                                // `vertical-alignment`), which left
                                                // the chevron sitting high in the bar.
                                                height: 100%;

                                                IcChevronLeft {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    width: 20px;
                                                    height: 20px;
                                                    fill: Theme.current.text_secondary;
                                                }
                                            }

                                            Text {
                                                text: root.episode_context;
                                                color: Theme.current.text_context_menu;
                                                font-size: 13px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                                min-width: 0px;
                                            }
                                        }

                                        ep_ctx_touch := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            mouse-cursor: pointer;
                                            clicked => { root.kb_active = false; root.episodes_back(); }
                                        }
                                    }

                                    StreamList {
                                        rows: root.streams;
                                        hint: root.streams_hint;
                                        addons: root.stream_addons;
                                        loading: root.stream_loading;
                                        searching: root.streams_searching;
                                        addon_filter: root.stream_filter;
                                        page: root.stream_page;
                                        page_count: root.stream_page_count;
                                        page_start: root.stream_page_start;
                                        kb_focus: root.kb_zone == 3 ? root.kb_s : -1;
                                        kb_active: root.kb_active;
                                        touch_menus: root.touch_menus;
                                        picked(i) => { root.kb_active = false; root.stream_picked(i); }
                                        page_picked(p) => {
                                            root.kb_active = false;
                                            root.stream_page_picked(p);
                                            root.kb_s = p * 25;
                                        }
                                        bottom_page_picked(p, y) => {
                                            root.kb_active = false;
                                            root.stream_page_picked(p);
                                            root.kb_s = p * 25;
                                            root.scroll_list_to_top(y);
                                        }
                                        action_items: root.stream_action_items;
                                        action_requested(id) => { root.request_stream_action(id); }
                                        action_selected(id, a) => { root.stream_action_selected(id, a); }
                                        filter_picked(i) => {
                                            root.kb_active = false;
                                            root.kb_s = 0;
                                            root.stream_filter_picked(i);
                                        }
                                        filter_panned => { root.filters_panned(); }
                                        filter_pan_released => { root.filters_pan_released(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

        }

        // Hold behind the pill-bar axis lock (see `filters_panned`): the
        // page's pan stays off while the pill row is moving and comes back
        // once it has been still for one interval.
        pan_release_t := Timer {
            interval: 200ms;
            running: false;
            triggered => {
                self.stop();
                root.page_pan_enabled = true;
            }
        }

        // Card bottom sheets (single instance per kind): the dim
        // backdrop eats outside taps (dismiss only, never forwarded).
        MenuSheet {
            open: root.touch_menus && root.stream_action_open;
            width: 100%;
            height: 100%;
            safe-bottom: root.safe-bottom;
            safe-left: root.safe-left;
            safe-right: root.safe-right;
            max_h: root.height * 0.85;
            sheet_title: root.stream_action_title;
            items: root.stream_action_items;
            picked(a) => {
                root.stream_action_open = false;
                root.stream_action_selected(root.stream_action_id, a);
            }
            closed => { root.stream_action_open = false; }
        }

        MenuSheet {
            open: root.menu_kind == 0;
            width: 100%;
            height: 100%;
            safe-bottom: root.safe-bottom;
            safe-left: root.safe-left;
            safe-right: root.safe-right;
            max_h: root.height * 0.85;
            sheet_title: @tr("Episode options");
            items: [
                    { label: root.menu_flag ? @tr("Mark episode as unwatched") : @tr("Mark episode as watched"), enabled: true },
                    { label: @tr("Mark episode and previous as watched"), enabled: !root.menu_flag },
                { label: @tr("Clear resume position"), enabled: !root.menu_flag && root.menu_progress > 0 },
                { label: @tr("Open episode"), enabled: true },
            ];
            picked(a) => {
                if (a == 0) {
                    root.episode_watch_action(root.menu_idx, root.menu_flag ? 2 : 1);
                } else if (a == 1) {
                    root.episode_watch_action(root.menu_idx, 3);
                } else if (a == 2) {
                    root.episode_watch_action(root.menu_idx, 4);
                } else {
                    root.kb_active = false;
                    root.episode_picked(root.menu_idx);
                }
                root.close_menu();
            }
            closed => { root.close_menu(); }
        }

        MenuSheet {
            open: root.menu_kind == 1;
            width: 100%;
            height: 100%;
            safe-bottom: root.safe-bottom;
            safe-left: root.safe-left;
            safe-right: root.safe-right;
            max_h: root.height * 0.85;
            sheet_title: @tr("Season options");
            items: [
                { label: root.menu_flag ? @tr("Mark season as unwatched") : @tr("Mark season as watched"), enabled: true },
                { label: @tr("Select season"), enabled: true },
            ];
            picked(a) => {
                if (a == 0) {
                    root.season_watch_action(root.menu_idx, 0);
                } else {
                    root.kb_active = false;
                    root.kb_zone = 3;
                    root.kb_ci = 0;
                    root.season_picked(root.menu_idx);
                }
                root.close_menu();
            }
            closed => { root.close_menu(); }
        }
        library_options_sheet := MenuSheet {
            open: root.touch_menus && root.in_library && root.menu_kind == 2;
            safe-bottom: root.safe-bottom;
            safe-left: root.safe-left;
            safe-right: root.safe-right;
            max_h: root.height * 0.85;
            sheet_title: @tr("Library options");
            items: root.library_menu_items;
            picked(a) => { root.library_menu_picked(a); }
            closed => { root.close_menu(); }
        }



    }
}
