import { DetailInfo, InterfaceStyle, Theme, TrackingLinkRow, TrackingCandidateRow, TrackingMappingRow, TrackingSetupRow, CategoryRow, EpisodeRow, StreamRow, SeasonCard, SheetItem, Anim } from "@NovaUiShared";

import { QueueBridge, DetailContent, DetailBridge } from "@NovaUiShared";
import { TitleArtwork } from "title-artwork.slint";
import { DetailExtrasPanel } from "detail-extras.slint";



import { MenuSheet } from "menusheet.slint";
import { TrackingButton } from "tracking-controls.slint";
import { IcPlay, IcBookmark, IcAdd, IcMoreHoriz, IcSync, IcCheck, IcChevronLeft, IcChevronRight, IcSchedule, IcSearch, IcClose } from "icons.slint";


// Circular, text-free icon button for the detail top bar (back, library,
// categories). The caller drops the icon (and any badge) in as a child; the
// hover background and keyboard focus ring live here.
component TopIconButton inherits Rectangle {
    in property <bool> narrow: false;
    in property <bool> focused: false;
    callback clicked();

    width: narrow ? 44px : 48px;
    height: narrow ? 44px : 48px;
    border-radius: self.width / 2;
    background: touch.has-hover ? Theme.current.hero_control_hover : Theme.current.hero_control;
    border-width: focused ? 2px : 1px;
    border-color: focused ? Theme.current.accent_vivid : Theme.current.border_strong;

    @children

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Consume an explicit local-save receipt, rather than animating every saved
// state change (opening a saved title and remote projections must stay quiet).
component LibrarySaveFeedback inherits Rectangle {
    in property <int> request: 0;
    in property <bool> saved: false;
    width: 0px; height: 0px;
    private property <bool> initialized: false;
    private property <int> last_request: 0;
    private property <bool> feedback: false;
    private property <bool> entered: true;
    private property <bool> motion_enabled: Anim.enabled && Anim.hover;
    private property <float> progress: root.entered ? 1.0 : 0.0;
    out property <float> mix: !root.saved ? 0.0 : root.feedback && root.motion_enabled ? root.progress : 1.0;
    out property <float> pulse: root.saved && root.feedback && root.motion_enabled ? 4 * root.progress * (1 - root.progress) : 0.0;
    animate progress { duration: root.entered ? Anim.hover_fast + Anim.hover_lift : 0ms; easing: ease-out; }
    init => { root.last_request = root.request; root.initialized = true; }
    changed request => {
        if (!root.initialized || root.last_request == root.request) { return; }
        root.last_request = root.request;
        go.stop();
        root.feedback = root.saved && root.motion_enabled;
        root.entered = !root.feedback;
        if (root.feedback) { go.start(); }
    }
    changed saved => {
        if (!root.saved) { go.stop(); root.feedback = false; root.entered = true; }
    }
    changed motion_enabled => {
        if (!root.motion_enabled) { go.stop(); root.feedback = false; root.entered = true; }
    }
    go := Timer {
        interval: 16ms; running: false;
        triggered => { self.stop(); root.entered = true; }
    }
}

// Both the cinematic detail view and compact Tracking view use the same
// tabs. Numeric IDs stay stable for episode callbacks and saved snapshots.
component DetailTabs inherits Rectangle {
    in property <bool> narrow;
    in property <bool> episodes_visible: true;
    in property <bool> tracking_visible;
    in property <int> selected;
    in property <bool> kb_active;
    in property <bool> focused;
    in property <int> kb_tab;
    callback picked(int);
    height: 48px;
    vertical-stretch: 0;
    property <int> count: 1 + (root.episodes_visible ? 1 : 0) + (root.tracking_visible ? 1 : 0);
    property <length> gap: root.narrow ? 4px : 24px;
    private property <length> tab-width: root.narrow ? (root.width - (root.count - 1) * root.gap) / root.count : Math.min(140px, (root.width - (root.count - 1) * root.gap) / root.count);
    private property <float> selected-slot: root.selected == 0 ? 0 : root.selected == 3 ? 1 : (root.episodes_visible ? 2 : 1);
    private property <float> underline-slot: root.selected-slot;
    animate underline-slot { duration: Anim.transition_fade; easing: ease-out; }
    Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: Theme.current.border_overlay; }
    HorizontalLayout {
        spacing: root.gap;
        alignment: start;
        for tab in root.episodes_visible ? (root.tracking_visible ? [0, 3, 4] : [0, 3]) : (root.tracking_visible ? [0, 4] : [0]): Rectangle {
            width: root.tab-width;
            height: 48px;
            border-radius: 4px;
            border-width: tab_focus.has-focus || (root.kb_active && root.focused && root.kb_tab == tab) ? 2px : 0px;
            border-color: Theme.current.focus_ring;
            accessible-role: button;
            accessible-label: tab == 0 ? @tr("Overview") : tab == 3 ? @tr("Episodes") : @tr("Tracking");
            forward-focus: tab_focus;
            Text {
                text: tab == 0 ? @tr("Overview") : tab == 3 ? @tr("Episodes") : @tr("Tracking");
                color: root.selected == tab ? Theme.current.text_bright : Theme.current.text_detail_tab;
                font-weight: root.selected == tab ? 600 : 400;
                font-size: InterfaceStyle.tv ? 24px : (root.narrow ? 14px : 18px);
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                overflow: elide;
            }
            tab_focus := FocusScope {
                key-pressed(e) => {
                    if e.text == Key.Return || e.text == " " { root.picked(tab); accept } else { reject }
                }
            }
            TouchArea { mouse-cursor: pointer; clicked => { root.picked(tab); } }
        }
    }
    // Only selection moves. Resizing recalculates geometry immediately and
    // never shifts the tab content or its keyboard focus targets.
    tab_underline := Rectangle {
        x: (Anim.enabled && Anim.transitions ? root.underline-slot : root.selected-slot) * (root.tab-width + root.gap);
        y: parent.height - 4px;
        width: root.tab-width; height: 4px; border-radius: 2px;
        background: Theme.current.accent_vivid;
    }
}

export component DetailPage {
    in property <[TrackingLinkRow]> tracking_links;
    in property <[TrackingCandidateRow]> tracking_candidates;
    in-out property <int> tracking_service;
    in property <[TrackingSetupRow]> tracking_setup;
    in property <string> tracking_setup_revision;
    in property <string> tracking_setup_summary;
    in property <string> tracking_setup_unmapped;
    in property <bool> tracking_setup_active;
    in property <string> tracking_range_first;
    in property <string> tracking_range_last;
    in property <string> tracking_range_start;

    in property <[string]> tracking_source_rows;
    in property <[string]> tracking_preview_rows;
    in property <[TrackingMappingRow]> tracking_mapping_rows;
    in property <string> tracking_notice;
    in property <string> tracking_candidate_title;
    in property <bool> tracking_busy;
    in property <bool> tracking_can_confirm;
    in-out property <bool> tracking_open: false;
    in-out property <int> tracking_return_tab: 0;
    property <int> tracking_focus_request <=> DetailContent.tracking_focus_request;
    property <int> tracking_back_request <=> DetailContent.tracking_back_request;
    callback tracking_show();
    callback tracking_close();
    callback tracking_search(int,string);
    callback tracking_pick(int);
    callback tracking_preview(string,string,string);
    callback tracking_confirm();
    callback tracking_accept_setup(string,bool);
    callback tracking_adjust_setup(int);
    callback tracking_cancel_adjust();
    callback tracking_assign(int,string);
    callback tracking_edit(string,string,int,string,bool,string,bool,string);
    callback tracking_action(string,int);

    // Custom components placed in a Window are sized by their preferred size;
    // make this page fill the window (its parent).
    preferred-width: 100%;
    preferred-height: 100%;

    in-out property <image> selected_poster;
    in-out property <image> selected_backdrop;
    in property <image> selected_logo;
    in-out property <string> selected_title: "";
    in property <bool> is_movie;
    in-out property <bool> stream_selector_open;
    in-out property <string> selected_year: "";
    in property <DetailInfo> selected_details;
    callback detail_extra_picked(int,string);
    in-out property <string> selected_description: "";
    property <bool> synopsis_expanded <=> DetailContent.synopsis_expanded;
    property <bool> hero_description_expanded <=> DetailContent.hero_expanded;
    property <length> overview_width: root.width - (root.narrow ? 40px : 128px) - root.safe-left - root.safe-right;
    property <length> synopsis_width: root.narrow ? root.overview_width : (root.overview_width - 24px) * 0.56;
    property <length> hero_text_width: root.narrow ? root.overview_width : Math.min(650px, root.overview_width * 0.55);
    property <length> backdrop_height: (root.narrow
        ? (Theme.detail_backdrop_size == 0 ? 420px : Theme.detail_backdrop_size == 2 ? 720px : 560px)
        : (Theme.detail_backdrop_size == 0 ? 560px : Theme.detail_backdrop_size == 2 ? 920px : 740px)) + root.safe-top;
    property <length> hero_top_spacing: root.narrow
        ? (Theme.detail_backdrop_size == 0 ? 140px : Theme.detail_backdrop_size == 2 ? 390px : 250px)
        : (Theme.detail_backdrop_size == 0 ? 20px : Theme.detail_backdrop_size == 2 ? 180px : 50px);
    in-out property <[string]> selected_genre_list: [];
    // Content tabs: 0 = Overview, 3 = Episodes. Tracking is a separate page.
    in-out property <int> detail_tab: 0;
    in-out property <string> episode_filter: "";
    in-out property <bool> in_library: false;
    in property <int> library_save_request: 0;
    in property <bool> library_watched: false;
    in property <int> library_activity_action: 0;
    private property <bool> hero_library_focused: false;
    in-out property <[CategoryRow]> category_rows: [];
    in-out property <int> selected_category_count: 0;
    in-out property <[StreamRow]> streams: [];
    in-out property <int> stream_page: 0;
    in-out property <int> stream_page_count: 1;
    in-out property <int> stream_page_start: 0;
    in-out property <int> stream_total: 0;
    in-out property <string> streams_hint: "";
    // Addon filter pills above the stream list (installed-addon order).
    in-out property <[string]> stream_addons: [];
    // Per-pill loading flags, index-aligned with `stream_addons`; plus a
    // global "any query in flight" flag for the All pill.
    in-out property <[bool]> stream_loading: [];
    in-out property <bool> streams_searching: false;
    // 0 = All, otherwise 1-based index into `stream_addons`.
    in-out property <int> stream_filter: 0;
    in-out property <bool> stream_action_open: false;
    in-out property <string> stream_action_id: "";
    in-out property <string> stream_action_title: "";
    in-out property <[SheetItem]> stream_action_items: [];
    in-out property <bool> modal_episodes: false;
    in-out property <[string]> season_names: [];
    in-out property <int> season_combo_idx: -1;
    // Art-backed season picker cards, same order as season_names.
    in-out property <[SeasonCard]> season_cards: [];
    in-out property <[EpisodeRow]> episode_rows: [];
    // Episodes tab pagination: Rust slices the season's filtered list into
    // pages of EPISODE_PAGE_SIZE and writes `episode_page_start` (the global
    // index of `episode_rows[0]`), so card picks still resolve against the
    // whole season.
    in-out property <int> episode_page: 0;
    in-out property <int> episode_page_count: 1;
    in-out property <int> episode_page_start: 0;
    in-out property <int> episode_total: 0;
    in-out property <string> episode_context: "";
    in property <string> stream_episode_number;
    in property <string> stream_episode_title;
    in property <string> watch_label: @tr("Start");
    // Set by AppWindow when the streams view was entered directly (Home
    // Continue deep-link) without visiting the episode list — see kb_back.
    in property <bool> deep_stream: false;
    in property <int> system_back_request: 0;
    in property <int> episode_reveal_request: 0;
    property <int> last_system_back_request: -1;
    property <bool> filter_focused <=> DetailContent.filter_focused;
    private property <bool> episode_search_open <=> DetailContent.episode_search_open;
    // Compact layout for narrow (portrait) windows.
    in property <bool> narrow;
    // Top system-bar inset (Android status bar): Window.safe-area-insets,
    // bound by AppWindow. 0 on desktop/web, so layout there is unchanged.
    in property <length> safe-top: 0px;
    // Side insets: in landscape the display cutout / gesture area moves to
    // the left or right edge, so page content must clear it.
    in property <length> safe-left: 0px;
    in property <length> safe-right: 0px;
    // Bottom system-bar inset (Android gesture/nav bar), for the card
    // bottom sheets. 0 on desktop/web.
    in property <length> safe-bottom: 0px;
    // True on touch-driven platforms (Android): card menus open as
    // bottom sheets on hold. Desktop keeps native right-click popups.
    in property <bool> touch_menus: false;

    // Episode grid columns: 1 in narrow windows, otherwise scaled to the
    // available content width after page padding, capped at 4.
    property <int> ep_cols: root.narrow ? 1 : Math.min(4, Math.max(2, Math.floor((root.episode_content_w + root.card-gap) / ((InterfaceStyle.tv ? 460px : 320px) + root.card-gap))));
    // Equal-width episode cards: grid columns start at each cell's
    // preferred width (full unwrapped text even when wrapped — see Text
    // docs), so without an explicit cell width columns track content
    // length. Derive one shared width top-down from the page width
    // (content = page − 64px scroll padding each side on wide layouts).
    // Must use root.width here: referencing the content layout's own
    // width feeds back through the ScrollView and binding-loops.
    property <length> episode_content_w: root.width - (root.narrow ? 40px + root.safe-left + root.safe-right : 128px + root.safe-left + root.safe-right);
    property <length> card-gap: Theme.card_spacing;
    property <length> ep_card_w: (root.episode_content_w - (root.ep_cols - 1) * root.card-gap) / root.ep_cols;
    // Phones keep seasons in one horizontal rail with the next card
    // peeking in. On wide windows the grid grows from a 180px minimum card;
    // cards are capped (same centered-cap scheme as the Discover grid), so the
    // wall never turns into a few giant banners on desktop.
    property <length> min-season: InterfaceStyle.tv ? 260px : 180px;
    property <length> max-season: InterfaceStyle.tv ? 340px : 240px;
    property <int> season_cols: root.narrow ? 2 : Math.min(5, Math.max(InterfaceStyle.tv ? 2 : 3, Math.floor((root.episode_content_w + root.card-gap) / (root.min-season + root.card-gap))));
    property <length> season_card_w: root.narrow ? Math.min(180px, Math.max(120px, (root.width - 40px - root.safe-left - root.safe-right) / 2.2)) : Math.min(root.max-season, (root.episode_content_w - (root.season_cols - 1) * root.card-gap) / root.season_cols);
    // Columns actually used (partial last row still packs left).
    property <int> season_grid_cols: Math.min(root.season_cols, root.season_cards.length);
    // True while the assign-categories popup covers this page (wired by
    // AppWindow): used to hand keyboard focus back when it closes.
    in property <bool> popup_open: false;

    // ---- 6-button keyboard nav (arrows + Enter + Backspace) ----
    // Zones: 0 top bar, 1 tabs, 2 hero actions, 3 episode content.
    // The fullscreen selector owns stream navigation separately.
    // Enter activates; Backspace steps back. The filter field uses edit
    // mode like Discover's search.
    // Bound to AppWindow for the active visit. New visits reset navigation;
    // changing these indices from backend data must not move the scroller.
    // kb_edit stays local (transient edit mode).
    in-out property <int> kb_zone: 0;
    in-out property <int> kb_top: 0; // 0 back, 1 sync/Tracking, 2 library options
    in-out property <int> kb_tab: 0;
    in-out property <int> kb_ci: 2; // picker control: 0 season, 1 filter, 2 grid
    in-out property <int> kb_ep: 0;
    in-out property <int> kb_s: 0;
    property <bool> kb_edit <=> DetailContent.kb_edit;
    // Keyboard modality (bound to AppWindow, see DiscoverPage).
    in-out property <bool> kb_active;
    function tv_context() -> bool {
        if (root.kb_zone == 3 && root.det_content() == 2) {
            if (root.kb_ci == 2 && root.kb_ep >= 0 && root.kb_ep < root.episode_rows.length) {
                let entry = root.episode_rows[root.kb_ep];
                root.open_ep_menu(root.kb_ep, entry.watched, entry.progress); return true;
            }
            if (root.kb_ci == 0 && root.kb_s >= 0 && root.kb_s < root.season_cards.length) {
                root.open_season_menu(root.kb_s, root.season_cards[root.kb_s].watched); return true;
            }
        }
        if (root.in_library && root.kb_zone <= 2) { root.open_library_menu(); return true; }
        return false;
    }

    // Remotes send repeated Return presses while OK is held. Delay the primary
    // action until release so opening a context menu never also starts playback.
    private property <bool> tv_ok_pending: false;
    private property <bool> tv_ok_held: false;
    tv_ok_hold := Timer {
        interval: 650ms;
        running: false;
        triggered => { self.stop(); root.tv_ok_held = root.tv_context(); }
    }


    function det_content() -> int {
        if (root.detail_tab == 3 && root.modal_episodes) {
            return 2;
        }
        return 0;
    }

    function det_top_visible(i: int) -> bool {
        return i == 0 || (root.in_library && (i == 1 || i == 2));
    }

    function det_top_fix() {
        if (!root.det_top_visible(root.kb_top)) { root.kb_top = 0; }
    }

    function det_top_right() {
        if (root.in_library) { root.kb_top = Math.min(2, root.kb_top + 1); }
    }

    function det_top_left() {
        root.kb_top = Math.max(0, root.kb_top - 1);
    }

    function det_zone_down() {
        let old_zone = root.kb_zone;
        if (root.kb_zone == 0) {
            root.kb_zone = 1;
        } else if (root.kb_zone == 1) {
            root.kb_zone = 2;
        } else if (root.kb_zone == 2) {
            if (root.det_content() != 0) {
                root.kb_zone = 3;
            }
        } else {
            // Inside episode content, Down moves one grid row.
            if (root.det_content() == 2 && root.kb_ci == 2) {
                if (root.kb_ep + root.ep_cols < root.episode_rows.length) {
                    root.kb_ep += root.ep_cols;
                    root.kb_nudge(-90px);
                }
            } else if (root.det_content() == 2 && root.kb_ci < 2) {
                root.kb_ci += 1;
                root.kb_nudge(-80px);
            }
        }
        if root.kb_zone != old_zone { root.kb_nudge(root.kb_zone == 3 ? -120px : 120px); }
    }

    function det_zone_up() {
        let old_zone = root.kb_zone;
        if (root.kb_zone == 3) {
            if (root.det_content() == 2 && root.kb_ci == 2) {
                if (root.kb_ep >= root.ep_cols) {
                    root.kb_ep -= root.ep_cols;
                    root.kb_nudge(90px);
                } else {
                    root.kb_ci = 1;
                    root.kb_nudge(80px);
                }
            } else if (root.det_content() == 2 && root.kb_ci == 1) {
                root.kb_ci = 0;
                root.kb_nudge(80px);
            } else if (root.det_content() == 2 && root.kb_ci == 0) {
                root.kb_zone = 2;
            } else {
                root.kb_zone = 2;
            }
        } else if (root.kb_zone == 2) {
            root.kb_zone = 1;
        } else if (root.kb_zone == 1) {
            root.kb_zone = 0;
        }
        if root.kb_zone != old_zone { root.kb_nudge(120px); }
    }

    function kb_left() {
        if (root.kb_zone == 0) {
            root.det_top_left();
        } else if (root.kb_zone == 2) {
            root.hero_library_focused = false;
        } else if (root.kb_zone == 1) {
            root.kb_tab = root.is_movie ? (root.in_library && root.kb_tab == 0 ? 4 : 0) : (root.kb_tab == 0 ? (root.in_library ? 4 : 3) : root.kb_tab == 4 ? 3 : 0);
        } else if (root.kb_zone == 3 && root.det_content() == 2 && root.kb_ci == 0) {
            root.kb_cycle_season(-1);
        } else if (root.kb_zone == 3 && root.det_content() == 2 && root.kb_ci == 1) {
            // Filter / pager row: Left steps one page back.
            if (root.episode_page > 0) {
                root.episode_page_picked(root.episode_page - 1);
            }
        } else if (root.kb_zone == 3 && root.det_content() == 2 && root.kb_ci == 2) {
            if (root.kb_ep > 0) {
                root.kb_ep -= 1;
            }
        }
    }

    function kb_right() {
        if (root.kb_zone == 0) {
            root.det_top_right();
        } else if (root.kb_zone == 2) {
            root.hero_library_focused = true;
        } else if (root.kb_zone == 1) {
            root.kb_tab = root.is_movie ? (root.in_library && root.kb_tab == 0 ? 4 : 0) : (root.kb_tab == 0 ? 3 : root.kb_tab == 3 && root.in_library ? 4 : 0);
        } else if (root.kb_zone == 3 && root.det_content() == 2 && root.kb_ci == 0) {
            root.kb_cycle_season(1);
        } else if (root.kb_zone == 3 && root.det_content() == 2 && root.kb_ci == 1) {
            // Right steps one page forward.
            if (root.episode_page + 1 < root.episode_page_count) {
                root.episode_page_picked(root.episode_page + 1);
            }
        } else if (root.kb_zone == 3 && root.det_content() == 2 && root.kb_ci == 2) {
            if (root.kb_ep + 1 < root.episode_rows.length) {
                root.kb_ep += 1;
            }
        }
    }

    function kb_cycle_season(d: int) {
        let n = root.season_names.length;
        if (n == 0) {
            return;
        }
        let v = root.season_combo_idx + d;
        let c = Math.max(0, Math.min(n - 1, v));
        if (c != root.season_combo_idx) {
            root.season_combo_idx = c;
            root.season_picked(c);
        }
    }

    function kb_enter() {
        if (root.kb_zone == 0) {
            if (root.kb_top == 0) {
                if root.tracking_open { root.tracking_back(); } else { root.back(); }
            } else if (root.kb_top == 1 && root.in_library) {
                root.tracking_show();
            } else if (root.kb_top == 2 && root.in_library) {
                root.open_library_menu();
            }
        } else if (root.kb_zone == 1) {
            if root.kb_tab == 4 { root.tracking_show(); }
            else { root.detail_tab_picked(root.kb_tab); }
        } else if (root.kb_zone == 2) {
            if (root.hero_library_focused) { root.add_to_library(); }
            else { root.watch_now(); }
        } else {
            if (root.det_content() == 2) {
                if (root.kb_ci == 0) {
                    root.kb_cycle_season(1);
                } else if (root.kb_ci == 1) {
                    root.kb_edit = true;
                } else {
                    if (root.kb_ep >= 0 && root.kb_ep < root.episode_rows.length) {
                        root.episode_picked(root.kb_ep);
                    }
                }
            }
        }
    }

    function kb_back() {
        // A deep-linked streams view (Home Continue / Watch Now) skips the episode list,
        // so back closes the modal instead of revealing a screen never seen.
        if (!root.modal_episodes && root.episode_context != "" && !root.deep_stream) {
            root.episodes_back();
        } else {
            root.back();
        }
    }

    function tracking_back() {
        root.tracking_back_request += 1;
    }

    function system_back() {
        if (!root.touch_menus) { root.kb_active = true; }
        // Dismiss the nearest interactive layer before leaving the title.
        if (DetailBridge.season_download_menu >= 0) {
            DetailBridge.season_download_menu = -1;
        } else if (root.stream_action_open) {
            root.stream_action_open = false;
        } else if (root.stream_selector_open) {
            root.stream_selector_back();
        } else if (root.menu_kind >= 0) {
            root.close_menu();
        } else if (root.tracking_open) {
            root.tracking_back();
        } else if (root.kb_edit || root.filter_focused) {
            root.kb_edit = false;
            root.filter_focused = false;
            nav_scope.focus();
        } else {
            root.kb_back();
        }
    }

    changed system_back_request => {
        if (root.last_system_back_request >= 0
            && root.system_back_request != root.last_system_back_request) {
            root.last_system_back_request = root.system_back_request;
            root.system_back();
        }
    }

    public function content_request_stream_action(id: string) { root.request_stream_action(id); }
    public function content_dispatch_back() { root.system_back(); }
    public function content_focus_shell() { if !root.stream_selector_open && !root.tracking_open && !root.popup_open { nav_scope.focus(); } }
    public function content_filters_panned() { root.filters_panned(); }
    public function content_filters_pan_released() { root.filters_pan_released(); }
    public function content_open_ep_menu(idx: int, watched: bool, progress: float) { root.open_ep_menu(idx, watched, progress); }
    public function content_open_season_menu(idx: int, watched: bool) { root.open_season_menu(idx, watched); }
    public function content_scroll_list_to_top(y: length) { root.scroll_list_to_top(y); }
    public pure function content_scroll_y() -> length { return det_scroll.content-y; }
    public function content_restore_scroll_y(y: length) {
        det_scroll.content-y = Math.max(Math.min(0px, det_scroll.height - det_scroll.content-height), Math.min(0px, y));
    }

    // ---- Page pan lock (horizontal rails) ----------------------------
    // The narrow season rail sits inside the vertical detail scroller.
    // Its pointer hints temporarily stop the page from grabbing a diagonal
    // swipe, and keep it stopped while horizontal momentum continues.
    // The fullscreen stream filters use independent viewports instead.
    property <bool> page_pan_enabled: true;

    function filters_panned() {
        root.page_pan_enabled = false;
        // Longer than one 16ms drag/fling frame, so a live gesture keeps
        // re-arming the hold at every move. `restart` only re-arms a timer
        // that was started before (it is created stopped), so the first
        // report of a gesture has to start it.
        pan_release_t.running = true;
        pan_release_t.restart();
    }

    // The season rail is not panning any more (its gesture went vertical, or the
    // finger lifted): the page picks its pan straight back up.
    function filters_pan_released() {
        root.page_pan_enabled = true;
        pan_release_t.stop();
    }

    // Best-effort scroll follow (episode cards have
    // variable heights, so nudge instead of computing exact strides).
    function kb_nudge(d: length) {
        let vy = det_scroll.content-y;
        let vh = det_scroll.height;
        let min_y = Math.min(0px, vh - det_scroll.content-height);
        let v = vy + d;
        det_scroll.content-y = Math.max(min_y, Math.min(0px, v));
    }

    function scroll_list_to_top(list_y: length) {
        // The final pager sits after many variable-height rows. Align the
        // start of the episode list in the outer scroller after it is
        // used, so the next page begins at its first entry rather than at an
        // arbitrary offset left over from the bottom controls.
        let relative_y = list_y - det_scroll.absolute-position.y;
        let min_y = Math.min(0px, det_scroll.height - det_scroll.content-height);
        det_scroll.content-y = Math.max(
            min_y,
            Math.min(0px, det_scroll.content-y - relative_y),
        );
    }

    changed detail_tab => {
        root.filters_pan_released();
        DetailContent.episodes_generation += 1;
        root.kb_s = 0;
        root.kb_ep = 0;
        root.kb_ci = 2;
        root.kb_tab = root.detail_tab;
        if (root.detail_tab != 3) { root.leave_episode_search(); }
    }
    changed episode_rows => {
        if (root.kb_ep >= root.episode_rows.length) {
            root.kb_ep = Math.max(0, root.episode_rows.length - 1);
        }
    }
    changed streams => {
        if (root.kb_s >= root.stream_total) {
            root.kb_s = Math.max(0, root.stream_total - 1);
        }
    }
    changed episode_context => { root.det_top_fix(); }
    changed modal_episodes => {
        root.filters_pan_released();
        root.det_top_fix();
        if (!root.modal_episodes) { root.leave_episode_search(); }
    }
    changed stream_selector_open => {
        if root.stream_selector_open {
            if root.tracking_open { root.tracking_close(); }
            root.filters_pan_released();
        } else if !root.tracking_open { nav_scope.focus(); }
    }
    changed in_library => {
        root.det_top_fix();
        if (!root.in_library && root.menu_kind == 2) { root.close_menu(); }
        if (!root.in_library && root.tracking_open) { root.tracking_close(); }
    }
    changed category_rows => { root.det_top_fix(); }
    changed popup_open => {
        if (!root.popup_open) {
            nav_scope.focus();
        }
    }
    changed tracking_open => {
        if (!root.tracking_open && !root.stream_selector_open) {
            if root.detail_tab == 3 && root.episode_search_open { DetailContent.restore_episode_focus(); }
            else { nav_scope.focus(); }
        }
    }

    function leave_episode_search() {
        // Tab/stream navigation removes the focused search input. Clear its
        // edit state and leave focus on a control that survives that change.
        root.kb_edit = false;
        root.filter_focused = false;
        if (!root.stream_selector_open && !root.tracking_open && !root.popup_open) { nav_scope.focus(); }
    }

    callback back();
    callback episodes_back();
    callback add_to_library();
    callback library_action(int);
    callback open_categories();
    callback season_picked(int);
    callback episode_picked(int);
    // Pager move (absolute target page; the backend clamps it).
    callback episode_page_picked(int);
    callback stream_picked(int);
    callback stream_page_picked(int);
    callback stream_action_requested(string);
    callback stream_action_selected(string, int);
    callback stream_filter_picked(int);
    callback stream_selector_back();
    callback detail_tab_picked(int);
    callback episode_filter_changed(string);
    callback watch_now();
    // Manual watched-state (context menu + quick-toggle overlay).
    // Episode actions: 0 toggle, 1 mark watched, 2 mark unwatched,
    // 3 mark this + all previous watched, 4 clear resume position.
    callback episode_toggle_watched(int);
    callback episode_watch_action(int, int);
    // Season actions: 0 toggle whole season, 1 mark watched, 2 mark unwatched.
    callback season_watch_action(int, int);

    // Card bottom-sheet menu state (single instance per kind; -1 closed,
    // 0 episode, 1 season, 2 library entry). Pure UI state: the actions reuse the
    // callbacks above with the stored index.
    property <int> menu_kind: -1;
    property <int> menu_idx: 0;
    property <bool> menu_flag: false;
    property <float> menu_progress: 0.0;

    function open_ep_menu(idx: int, watched: bool, progress: float) {
        root.menu_kind = 0;
        root.menu_idx = idx;
        root.menu_flag = watched;
        root.menu_progress = progress;
    }

    function open_season_menu(idx: int, watched: bool) {
        root.menu_kind = 1;
        root.menu_idx = idx;
        root.menu_flag = watched;
    }

    property <[SheetItem]> library_menu_items: [
        { label: root.library_watched ? @tr("Mark unwatched") : @tr("Mark watched"), enabled: true },
        { label: @tr("Mark on hold"), enabled: true },
        { label: @tr("Mark dropped"), enabled: true },
        { label: @tr("Back to automatic"), enabled: true },
        { label: @tr("Categories"), enabled: root.category_rows.length > 0 },
        { label: @tr("Remove from library"), enabled: true },
        { label: root.library_activity_action == 4 ? @tr("Resume watching") : @tr("Wait for new episodes"), enabled: root.library_activity_action > 0 },
    ];

    function open_library_menu() {
        if (root.touch_menus || InterfaceStyle.tv) { root.menu_kind = 2; }
        else { library_options_ctx.show({ x: 0px, y: 0px }); }
    }

    function library_menu_picked(a: int) {
        root.close_menu();
        if (a == 4) { root.open_categories(); }
        else { root.library_action(a == 6 ? (root.library_activity_action == 4 ? 6 : 5) : a == 5 ? 4 : a); }
    }

    function request_stream_action(id: string) {
        root.stream_action_requested(id);
        // The backend fills the shared model and opens the touch sheet.
        // Desktop consumes the same model in the row's native popup instead.
        if (!root.touch_menus && !InterfaceStyle.tv) { root.stream_action_open = false; }
    }

    function close_menu() {
        root.menu_kind = -1;
        if (InterfaceStyle.tv) { nav_scope.focus(); }
    }

    page := Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.current.artwork_canvas;
        visible: !root.tracking_open && !root.stream_selector_open;

        // Fade both artwork and its black backing to the page canvas. Leaving
        // the backing opaque creates a black band above the coloured scrim.
        property <float> backdrop_fade: Math.min(1, Math.max(0, -det_scroll.content-y / ((root.backdrop_height - root.safe-top) * (root.narrow ? 0.643 : 0.703))));
        Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: root.backdrop_height;
            background: Theme.current.artwork_backdrop;
            opacity: 1 - page.backdrop_fade;
        }

        // Keep the artwork edge-to-edge behind the floating controls. The
        // scrims protect text while preserving the bright upper-right artwork.
        // Square masks with baked palette colours avoid thin-texture sampling
        // and offscreen colorization artifacts on resize or page recreation.
        backdrop_art := Image {
            x: 0px;
            // A small parallax lift, capped so the backdrop cannot slide
            // away while the user browses long episode or stream lists.
            y: Math.max(root.narrow ? -56px : -80px, Math.min(0px, det_scroll.content-y * 0.12));
            source: root.selected_backdrop.width > 0 ? root.selected_backdrop : root.selected_poster;
            image-fit: cover;
            width: 100%;
            height: root.backdrop_height;
            opacity: 1 - page.backdrop_fade;
        }
        Image {
            x: 0px;
            y: 0px;
            width: 100%;
            height: root.backdrop_height + 60px;
            source: Theme.detail_bottom_scrim;
            image-fit: fill;
        }
        if !root.narrow: Image {
            x: 0px;
            y: 0px;
            width: 100%;
            height: root.backdrop_height + 60px;
            source: Theme.detail_side_scrim;
            image-fit: fill;
        }

        // Fixed above the artwork but below controls, so parallax/scrolling
        // never exposes a bright patch behind the system status icons.
        if root.narrow: Image {
            // Slint centers a shorter image unless its position is explicit.
            x: 0px; y: 0px;
            width: 100%; height: root.safe-top + 64px;
            source: @image-url("../../assets/status-bar-scrim.svg");
            image-fit: fill;
            opacity: Theme.status_bar_gradient / 100;
        }

        // Entrance fade: the page is instantiated fresh per open (`if
        // modal_visible` in AppWindow), so the fade replays every time.
        // The page fill matches the window background, so only the content
        // (top bar, banner, tabs, body) reads as fading in. The flip is
        // deferred one tick: changing the value during creation would be
        // treated as the baseline and not animate.
        property <bool> entered: false;
        opacity: self.entered ? 1.0 : 0.0;
        animate opacity { duration: Anim.transition_fade; }

        enter_t := Timer {
            interval: 40ms;
            running: true;
            triggered => {
                enter_t.running = false;
                page.entered = true;
            }
        }

        // 6-button scope: overlays the page without intercepting the mouse.
        // The categories popup (separate scope) takes focus while open and
        // hands it back via popup_open below.
        nav_scope := FocusScope {
            width: 100%;
            height: 100%;
            enabled: !root.tracking_open && !root.stream_selector_open;
            init => {
                self.focus();
                root.last_system_back_request = root.system_back_request;
            }
            key-released(e) => {
                if (InterfaceStyle.tv && e.text == Key.Return && root.tv_ok_pending) {
                    tv_ok_hold.stop();
                    root.tv_ok_pending = false;
                    if (!root.tv_ok_held) { root.kb_enter(); }
                    accept
                } else { reject }
            }
            key-pressed(e) => {
                if (InterfaceStyle.tv && e.text == Key.Return) {
                    root.kb_active = true;
                    if (!e.repeat) { root.tv_ok_pending = true; root.tv_ok_held = false; tv_ok_hold.stop(); tv_ok_hold.start(); }
                    accept
                } else if (InterfaceStyle.tv && (e.text == Key.Menu || (e.text == Key.F10 && e.modifiers.shift))) {
                    root.kb_active = true;
                    if (!e.repeat) { root.tv_context(); }
                    accept
                } else if (root.tracking_open && (e.text == Key.Escape || e.text == Key.Back || e.text == Key.Backspace)) {
                    root.system_back();
                    accept
                } else if (root.stream_action_open) {
                    root.stream_action_open = false;
                    accept
                } else if (root.menu_kind >= 0) {
                    // An open sheet eats Backspace (dismiss only).
                    root.close_menu();
                    accept
                } else if (root.kb_edit) {
                    root.kb_edit = false;
                    self.focus();
                    accept
                } else if (e.text == Key.UpArrow) {
                    root.kb_active = true;
                    root.det_zone_up();
                    accept
                } else if (e.text == Key.DownArrow) {
                    root.kb_active = true;
                    root.det_zone_down();
                    accept
                } else if (e.text == Key.LeftArrow) {
                    root.kb_active = true;
                    root.kb_left();
                    accept
                } else if (e.text == Key.RightArrow) {
                    root.kb_active = true;
                    root.kb_right();
                    accept
                } else if (e.text == Key.Return) {
                    root.kb_active = true;
                    root.kb_enter();
                    accept
                } else if (e.text == Key.Backspace || e.text == Key.Back) {
                    root.kb_active = true;
                    root.kb_back();
                    accept
                } else if (e.text == "w" || e.text == "W") {
                    // Quick watched-toggle for the focused episode card.
                    if (root.kb_zone == 3 && root.det_content() == 2 && root.kb_ci == 2
                        && root.kb_ep >= 0 && root.kb_ep < root.episode_rows.length) {
                        root.kb_active = true;
                        root.episode_toggle_watched(root.kb_ep);
                        accept
                    } else {
                        reject
                    }
                } else {
                    reject
                }
            }
        }

        // Anchor below the saved-entry options button. Keep the menu outside
        // the conditional button so keyboard activation can reach it too.
        library_options_ctx := ContextMenuArea {
            x: root.width - root.safe-right - (root.narrow ? 10px + 44px : 16px + 48px);
            y: root.safe-top + (root.narrow ? 10px + 44px : 16px + 48px);
            width: 0px; height: 0px;
            enabled: root.in_library && !root.touch_menus;
            Menu {
                for action[a] in root.library_menu_items: MenuItem {
                    title: action.label;
                    enabled: action.enabled;
                    activated => { root.library_menu_picked(a); }
                }
            }
        }

        page_body := VerticalLayout {
            width: 100%;
            height: 100%;
            spacing: 0px;

            // Top bar: icon-only controls so the content below dominates.
            // The episode indicator/back affordance lives above the stream
            // list instead (see the Episodes tab).
            HorizontalLayout {
                spacing: root.narrow ? 6px : 12px;
                alignment: space-between;
                padding: root.narrow ? 10px : 16px;
                padding-bottom: 10px;
                padding-top: (root.narrow ? 10px : 16px) + safe-top;
                padding-left: (root.narrow ? 10px : 16px) + safe-left;
                padding-right: (root.narrow ? 10px : 16px) + safe-right;

                HorizontalLayout {
                    alignment: start;

                    TopIconButton {
                        narrow: root.narrow;
                        focused: root.kb_active && root.kb_zone == 0 && root.kb_top == 0;
                        accessible-role: button;
                        accessible-label: root.tracking_open ? (root.tracking_candidate_title != "" ? @tr("Back to review") : @tr("Back to details")) : @tr("Back");
                        clicked => {
                            root.kb_active = false;
                            root.kb_top = 0;
                            if root.tracking_open { root.tracking_back(); } else { root.back(); }
                        }

                        IcChevronLeft {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 24px;
                            height: 24px;
                            fill: Theme.current.text_bright;
                        }
                    }

                }

                HorizontalLayout {
                    spacing: root.narrow ? 6px : 10px;
                    alignment: end;

                    if root.in_library: tracking_button := TopIconButton {
                        narrow: root.narrow;
                        accessible-role: button;
                        accessible-label: @tr("Tracking");
                        focused: root.kb_active && root.kb_zone == 0 && root.kb_top == 1;
                        clicked => { root.tracking_show(); }
                        IcSync {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 24px; height: 24px;
                            fill: Theme.current.text_hero_icon;
                        }
                    }
                    if root.in_library: library_options_button := TopIconButton {
                        narrow: root.narrow;
                        accessible-role: button;
                        accessible-label: @tr("Library options");
                        focused: root.kb_active && root.kb_zone == 0 && root.kb_top == 2;
                        clicked => { root.kb_active = false; root.kb_top = 2; root.open_library_menu(); }
                        IcMoreHoriz {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 24px; height: 24px;
                            fill: Theme.current.text_bright;
                        }
                    }
                }
            }

            det_scroll := Flickable {
                property <length> viewport_top: self.absolute-position.y;
                init => { DetailContent.episodes_viewport_top = self.viewport_top; }
                changed viewport_top => { DetailContent.episodes_viewport_top = self.viewport_top; }
                width: 100%;
                min-height: 0px;
                vertical-stretch: 1;
                // A raw Flickable, not a ScrollView (which does not expose
                // the inner Flickable's `interactive`): the season rail's axis
                // lock flips exactly that (see `page_pan_enabled`). Panning
                // is otherwise unchanged — touch drags and mouse drags pan,
                // the wheel scrolls regardless of `interactive`.
                interactive: root.page_pan_enabled && !root.tracking_open && !root.stream_selector_open;

                VerticalLayout {
                    width: 100%;
                    padding-left: (root.narrow ? 20px : 64px) + safe-left;
                    padding-right: (root.narrow ? 20px : 64px) + safe-right;
                    padding-bottom: 16px;
                    spacing: 12px;
                    // Never distribute leftover viewport height here: with
                    // default stretch alignment and all-zero child stretches,
                    // extra space is shared EQUALLY by every child (see
                    // adjust_items), inflating short pages' grids. Leftover
                    // stays below the content instead.
                    alignment: start;

                    // Hero text stays below the artwork on phones and occupies
                    // the shaded left half on desktop. Height follows wrapped
                    // content so long titles and translations remain readable.
                    VerticalLayout {
                        width: 100%;
                        spacing: root.narrow ? 14px : 18px;
                        padding-top: root.hero_top_spacing;
                        padding-bottom: 16px;
                        alignment: start;

                        HorizontalLayout {
                            VerticalLayout {
                                width: root.hero_text_width;
                                spacing: root.narrow ? 14px : 18px;
                                alignment: start;
                                detail_title := TitleArtwork {
                                    title: root.selected_title; logo: root.selected_logo;
                                    reserve-logo-space: true;
                                    title-alignment: root.narrow ? Theme.hero_title_alignment : 0;
                                    width: 100%; logo-height: root.narrow ? 88px : 136px;
                                    font-size: root.narrow ? 34px : (root.width >= 1200px ? 64px : 44px);
                                    max-lines: 3;
                                }
                                if root.selected_year != "": Text {
                                    text: root.selected_year;
                                    color: Theme.current.text_hero_metadata;
                                    font-size: InterfaceStyle.tv ? 26px : (root.narrow ? 16px : 21px);
                                    min-width: 0px;
                                    overflow: elide;
                                }
                                GridLayout {
                                    min-width: 0px;
                                    spacing: 8px;
                                    for g[i] in root.selected_genre_list: Rectangle {
                                        row: Math.floor(i / 4);
                                        col: Math.mod(i, 4);
                                        height: root.narrow ? 34px : 42px;
                                        min-width: 0px;
                                        border-radius: self.height / 2;
                                        background: Theme.current.hero_metadata_badge;
                                        border-width: 1px;
                                        border-color: Theme.current.border_overlay;
                                        HorizontalLayout {
                                            padding-left: root.narrow ? 10px : 18px;
                                            padding-right: root.narrow ? 10px : 18px;
                                            Text {
                                                text: g;
                                                color: Theme.current.text_hero_badge;
                                                font-size: root.narrow ? 12px : 16px;
                                                vertical-alignment: center;
                                                min-width: 0px;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                                if root.selected_description != "": hero_description := Rectangle {
                                    // Match the Synopsis card's full-text measurement
                                    // and animated viewport, using the hero's own width.
                                    height: root.hero_description_expanded ? hero_description_measure.preferred-height + 1px : Math.min(hero_description_measure.preferred-height + 1px, root.narrow ? 66px : 84px);
                                    animate height {
                                        duration: DetailContent.restoring_navigation ? 0ms : Anim.transition_slide;
                                        easing: ease-in-out;
                                    }
                                    clip: true;
                                    hero_description_measure := Text {
                                        x: 0px; y: 0px;
                                        width: root.hero_text_width;
                                        text: root.selected_description;
                                        font-size: InterfaceStyle.tv ? 24px : (root.narrow ? 15px : 19px);
                                        wrap: word-wrap;
                                        visible: false;
                                    }
                                    hero_description_text := Text {
                                        x: 0px; y: 0px;
                                        width: root.hero_text_width;
                                        height: 100%;
                                        overflow: elide;
                                        text: hero_description_measure.text;
                                        color: Theme.current.text_description;
                                        font-size: InterfaceStyle.tv ? 24px : (root.narrow ? 15px : 19px);
                                        wrap: word-wrap;
                                        vertical-alignment: top;
                                    }
                                    hero_description_touch := TouchArea {
                                        enabled: hero_description_measure.preferred-height > (root.narrow ? 66px : 84px);
                                        mouse-cursor: pointer;
                                        accessible-role: button;
                                        accessible-label: root.hero_description_expanded ? @tr("Show less") : @tr("Read more");
                                        property <bool> dragged: false;
                                        pointer-event(ev) => {
                                            if (ev.kind == PointerEventKind.down) { self.dragged = false; }
                                        }
                                        moved => {
                                            if (Math.abs(self.mouse-x - self.pressed-x) + Math.abs(self.mouse-y - self.pressed-y) > 12px) {
                                                self.dragged = true;
                                            }
                                        }
                                        clicked => {
                                            if (!self.dragged) {
                                                root.hero_description_expanded = !root.hero_description_expanded;
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    watch_action_button := Rectangle {
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        height: root.narrow ? 56px : 62px;
                                        border-radius: root.narrow ? 22px : 26px;
                                        background: watch_hero.has-hover ? Theme.current.primary_button_hover : Theme.current.primary_button;
                                        border-width: 1px;
                                        border-color: root.kb_active && root.kb_zone == 2 && !root.hero_library_focused ? Theme.current.text_bright : Theme.current.primary_button_border;
                                        accessible-role: button;
                                        accessible-label: root.watch_label;
                                        HorizontalLayout {
                                            padding-left: root.narrow ? 12px : 20px;
                                            padding-right: root.narrow ? 12px : 20px;
                                            spacing: 8px; alignment: center;
                                            Rectangle {
                                                width: 20px; height: 100%; horizontal-stretch: 0;
                                                IcPlay {
                                                    y: (parent.height - self.height) / 2;
                                                    width: 20px; height: 20px;
                                                    fill: Theme.current.on_accent;
                                                }
                                            }
                                            Text {
                                                text: root.watch_label;
                                                color: Theme.current.on_accent;
                                                font-size: InterfaceStyle.tv ? 24px : (root.narrow ? 14px : 18px);
                                                font-weight: 600;
                                                min-width: 0px; horizontal-stretch: 1;
                                                wrap: word-wrap; max-lines: 2; overflow: elide;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        watch_hero := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.kb_active = false; root.watch_now(); }
                                        }
                                    }
                                    library_state_button := Rectangle {
                                        width: root.narrow ? 56px : 62px;
                                        height: self.width;
                                        border-radius: self.width / 2;
                                        background: library_hero.has-hover ? Theme.current.hero_library_hover : Theme.current.hero_library;
                                        border-width: 1px;
                                        border-color: root.kb_active && root.kb_zone == 2 && root.hero_library_focused ? Theme.current.accent_vivid : Theme.current.border_overlay;
                                        accessible-role: button;
                                        accessible-label: root.in_library ? @tr("Remove from library") : @tr("Add to library");
                                        library_feedback := LibrarySaveFeedback {
                                            request: root.library_save_request;
                                            saved: root.in_library;
                                        }
                                        library_save_glow := Rectangle {
                                            width: 100%; height: 100%;
                                            border-radius: self.width / 2;
                                            background: Theme.current.accent_vivid;
                                            opacity: library_feedback.pulse * 0.22;
                                        }
                                        library_add_icon := IcAdd {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            width: 26px - library_feedback.mix * 6px; height: self.width;
                                            fill: Theme.current.text_hero_icon;
                                            opacity: 1 - library_feedback.mix;
                                        }
                                        library_saved_icon := IcBookmark {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            width: 26px + library_feedback.pulse * 7px - (1 - library_feedback.mix) * 8px;
                                            height: self.width;
                                            fill: Theme.current.accent_vivid;
                                            opacity: library_feedback.mix;
                                        }
                                        library_hero := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.kb_active = false; root.add_to_library(); }
                                        }
                                    }
                                }
                            }
                            if !root.narrow: Rectangle { horizontal-stretch: 1; }
                        }
                    }

                    DetailTabs {
                        narrow: root.narrow;
                        episodes_visible: !root.is_movie;
                        tracking_visible: root.in_library;
                        selected: root.detail_tab;
                        kb_active: root.kb_active;
                        focused: root.kb_zone == 1;
                        kb_tab: root.kb_tab;
                        picked(tab) => { if tab == 4 { root.tracking_show(); } else { root.kb_active = false; root.kb_tab = tab; root.detail_tab_picked(tab); } }
                    }

                    // ---- Body: full-width content ---------------------
                    HorizontalLayout {
                        width: 100%;

                        // Keep short content packed at the top. min-width 0
                        // prevents long stream labels from widening the page.
                        VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            spacing: 10px;
                            alignment: start;



                            // ---- Overview tab -------------------------
                            // start-aligned: never share leftover height
                            // between children (see scroll content note).
                            if root.detail_tab == 0: VerticalLayout {
                                spacing: 10px;
                                alignment: start;
                                if root.is_movie: HorizontalLayout {
                                    TrackingButton {
                                        text: QueueBridge.detail_queued ? @tr("In watch queue") : @tr("Add to watch queue");
                                        selected: QueueBridge.detail_queued;
                                        clicked => { QueueBridge.add_detail(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }


                                GridLayout {
                                    spacing: root.narrow ? 16px : 24px;
                                    Rectangle {
                                        row: 0;
                                        col: 0;
                                        width: root.narrow ? root.width - 40px - root.safe-left - root.safe-right : (root.width - 128px - root.safe-left - root.safe-right - 24px) * 0.44;
                                        height: root.narrow ? 120px : 190px;
                                        border-radius: Theme.card_corner_radius;
                                        clip: true;
                                        background: Theme.current.season_card;
                                        Image {
                                            source: root.selected_backdrop.width > 0 ? root.selected_backdrop : root.selected_poster;
                                            image-fit: cover;
                                            width: 100%;
                                            height: 100%;
                                        }
                                        Rectangle {
                                            width: 100%; height: 100%;
                                            background: Theme.current.season_scrim;
                                        }
                                        Text {
                                            x: 20px; y: parent.height - 42px;
                                            text: @tr("Artwork");
                                            color: Theme.current.text_bright;
                                            font-size: InterfaceStyle.tv ? 23px : 18px;
                                            font-weight: 600;
                                        }
                                    }
                                Rectangle {
                                    row: root.narrow ? 1 : 0;
                                    col: root.narrow ? 0 : 1;
                                    width: root.synopsis_width;
                                    background: Theme.current.season_caption;
                                    border-radius: Theme.card_corner_radius;
                                    border-width: 1px;
                                    border-color: Theme.current.hover_overlay;
                                    VerticalLayout {
                                        padding: root.narrow ? 16px : 24px;
                                        spacing: 12px;
                                        alignment: start;
                                        Text {
                                            text: @tr("Synopsis");
                                            color: Theme.current.text_bright;
                                            font-size: root.narrow ? 20px : 24px;
                                            font-weight: 700;
                                        }
                                        synopsis_view := Rectangle {
                                            // Measure the complete paragraph separately so
                                            // the displayed text can fit the animated viewport
                                            // and elide whole lines instead of clipping glyphs.
                                            height: root.synopsis_expanded ? synopsis_measure.preferred-height + 1px : Math.min(synopsis_measure.preferred-height + 1px, root.narrow ? 80px : 84px);
                                            animate height {
                                                duration: DetailContent.restoring_navigation ? 0ms : Anim.transition_slide;
                                                easing: ease-in-out;
                                            }
                                            clip: true;
                                            synopsis_measure := Text {
                                                x: 0px;
                                                y: 0px;
                                                width: root.synopsis_width - (root.narrow ? 32px : 48px);
                                                text: root.selected_description != "" ? root.selected_description : @tr("No description provided by the addon.");
                                                font-size: root.narrow ? 15px : 18px;
                                                wrap: word-wrap;
                                                visible: false;
                                            }
                                            synopsis_text := Text {
                                                x: 0px;
                                                y: 0px;
                                                width: root.synopsis_width - (root.narrow ? 32px : 48px);
                                                height: 100%;
                                                text: synopsis_measure.text;
                                                color: Theme.current.text_episode_metadata;
                                                font-size: root.narrow ? 15px : 18px;
                                                wrap: word-wrap;
                                                overflow: elide;
                                                vertical-alignment: top;
                                            }
                                        }
                                        if synopsis_measure.preferred-height > (root.narrow ? 80px : 84px): Rectangle {
                                            height: 28px;
                                            Text {
                                                text: root.synopsis_expanded ? @tr("Show less") : @tr("Read more");
                                                color: Theme.current.accent_vivid;
                                                font-size: InterfaceStyle.tv ? 21px : 16px;
                                                vertical-alignment: center;
                                            }
                                            TouchArea {
                                                accessible-role: button;
                                                accessible-label: root.synopsis_expanded ? @tr("Show less") : @tr("Read more");
                                                mouse-cursor: pointer;
                                                clicked => { root.synopsis_expanded = !root.synopsis_expanded; }
                                            }
                                        }
                                    }
                                }

                                }

                            }

                            if root.detail_tab == 0: extras_content := DetailExtrasPanel {
                                info: root.selected_details;
                                narrow: root.narrow;
                                is_movie: root.is_movie;
                                available-width: root.episode_content_w;
                                picked(kind,target) => { root.detail_extra_picked(kind,target); }
                            }

                            // ---- Stub tabs (no addon data) ------------
                            if root.detail_tab == 1 || root.detail_tab == 2: Text {
                                text: @tr("Not provided by Stremio addons.");
                                color: Theme.current.text_disabled;
                                font-size: InterfaceStyle.tv ? 18px : 13px;
                            }

                            // ---- Episodes tab -------------------------
                            // start-aligned: the grid must keep its natural
                            // height (see scroll content note).
                            if root.detail_tab == 3: Rectangle {
                                // Percent-sized factory content has no intrinsic width.
                                // Anchor the body to the shell viewport independently of
                                // the leaf's own layout and reported preferred height.
                                width: Math.max(0px, root.episode_content_w);
                                height: DetailContent.episodes_height;
                                vertical-stretch: 0;
                                init => { DetailContent.episodes_slot_width = self.width; DetailContent.episodes_slot_height = self.height; }
                                changed width => { DetailContent.episodes_slot_width = self.width; }
                                changed height => { DetailContent.episodes_slot_height = self.height; }
                                ComponentContainer {
                                    x: 0px; y: 0px;
                                    width: 100%; height: 100%;
                                    component-factory: DetailContent.episodes_factory;
                                }
                            }
                        }
                    }
                }
            }

        }

        // Hold behind the pill-bar axis lock (see `filters_panned`): the
        // page's pan stays off while the pill row is moving and comes back
        // once it has been still for one interval.
        pan_release_t := Timer {
            interval: 200ms;
            running: false;
            triggered => {
                self.stop();
                root.page_pan_enabled = true;
            }
        }

        // Card bottom sheets (single instance per kind): the dim
        // backdrop eats outside taps (dismiss only, never forwarded).
        MenuSheet {
            open: root.menu_kind == 0;
            width: 100%;
            height: 100%;
            safe-bottom: root.safe-bottom;
            safe-left: root.safe-left;
            safe-right: root.safe-right;
            max_h: root.height * 0.85;
            sheet_title: @tr("Episode options");
            items: [
                    { label: root.menu_flag ? @tr("Mark episode as unwatched") : @tr("Mark episode as watched"), enabled: true },
                    { label: @tr("Mark episode and previous as watched"), enabled: !root.menu_flag },
                { label: @tr("Clear resume position"), enabled: !root.menu_flag && root.menu_progress > 0 },
                { label: @tr("Open episode"), enabled: true },
                { label: @tr("Add to watch queue"), enabled: true },
            ];
            picked(a) => {
                if (a == 0) {
                    root.episode_watch_action(root.menu_idx, root.menu_flag ? 2 : 1);
                } else if (a == 1) {
                    root.episode_watch_action(root.menu_idx, 3);
                } else if (a == 2) {
                    root.episode_watch_action(root.menu_idx, 4);
                } else if (a == 3) {
                    root.kb_active = false;
                    root.episode_picked(root.menu_idx);
                } else {
                    QueueBridge.add_episode(root.menu_idx);
                }
                root.close_menu();
            }
            closed => { root.close_menu(); }
        }

        MenuSheet {
            open: DetailBridge.season_download_menu >= 0; width: 100%; height: 100%;
            safe-bottom: root.safe-bottom; safe-left: root.safe-left; safe-right: root.safe-right;
            sheet_title: @tr("Download season");
            items: [ { label: @tr("All episodes"), enabled: true }, { label: @tr("Unwatched episodes"), enabled: true } ];
            picked(a) => { let idx = DetailBridge.season_download_menu; DetailBridge.season_download_menu = -1; DetailBridge.season_download_start(idx, a == 1); }
            closed => { DetailBridge.season_download_menu = -1; }
        }

        MenuSheet {
            open: root.menu_kind == 1;
            width: 100%;
            height: 100%;
            safe-bottom: root.safe-bottom;
            safe-left: root.safe-left;
            safe-right: root.safe-right;
            max_h: root.height * 0.85;
            sheet_title: @tr("Season options");
            items: [
                { label: root.menu_flag ? @tr("Mark season as unwatched") : @tr("Mark season as watched"), enabled: true },
                { label: @tr("Select season"), enabled: true },
                { label: @tr("Download season"), enabled: true },
            ];
            picked(a) => {
                if (a == 0) {
                    root.season_watch_action(root.menu_idx, 0);
                } else if (a == 2) {
                    DetailBridge.season_download_menu = root.menu_idx;
                } else {
                    root.kb_active = false;
                    root.kb_zone = 3;
                    root.kb_ci = 0;
                    root.season_picked(root.menu_idx);
                }
                root.close_menu();
            }
            closed => { root.close_menu(); }
        }
        library_options_sheet := MenuSheet {
            open: (root.touch_menus || InterfaceStyle.tv) && root.in_library && root.menu_kind == 2;
            safe-bottom: root.safe-bottom;
            safe-left: root.safe-left;
            safe-right: root.safe-right;
            max_h: root.height * 0.85;
            sheet_title: @tr("Library options");
            items: root.library_menu_items;
            picked(a) => { root.library_menu_picked(a); }
            closed => { root.close_menu(); }
        }

    }

    // A stationary canvas keeps the entrance fade opaque to the previous
    // screen; clipping contains the selector's short slide at every size.
    if root.tracking_open && !root.stream_selector_open: Rectangle {
        width: 100%; height: 100%; background: Theme.current.artwork_canvas;
        ComponentContainer { width: 100%; height: 100%; component-factory: DetailContent.tracking_factory; }
    }
    if root.stream_selector_open: Rectangle {
        width: 100%; height: 100%; background: Theme.current.artwork_canvas; clip: true;
        ComponentContainer { width: 100%; height: 100%; component-factory: DetailContent.streams_factory; }
    }
}
