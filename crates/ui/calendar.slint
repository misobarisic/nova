import { Theme, NavMetrics, CalendarDay, CalendarRelease } from "@NovaUiShared";

import { ScrollView } from "scrollview.slint";
import { SearchField } from "searchfield.slint";
import { SideNav } from "sidenav.slint";
import { PageHeader } from "page-header.slint";


component PlannerButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback picked();
    height: 44px;
    min-width: 44px;
    background: root.selected ? Theme.current.accent : Theme.current.control;
    border-radius: Math.min(Theme.button_corner_radius, Math.min(self.width, self.height) / 2);
    border-width: scope.has-focus ? 2px : 1px;
    border-color: scope.has-focus ? Theme.current.text_bright : Theme.current.control_hover;
    accessible-role: button;
    accessible-label: root.label;
    Text { vertical-stretch: 0; min-width: 0; text: root.label; color: root.selected ? Theme.current.on_accent : Theme.current.text_bright; horizontal-alignment: center; vertical-alignment: center; font-size: 13px; }
    scope := FocusScope { width: 100%; height: 100%; key-pressed(e) => { if (e.text == Key.Return || e.text == " ") { if (!e.repeat) { root.picked(); } accept } else { reject } } }
    TouchArea { mouse-cursor: pointer; clicked => { scope.focus(); root.picked(); } }
}
component PlannerDay inherits Rectangle {
    in property <CalendarDay> item;
    in property <bool> compact;
    in property <bool> week;
    callback picked(int);
    background: root.item.cell.selected ? Theme.current.accent : Theme.current.control;
    border-width: root.item.cell.today || scope.has-focus ? 2px : 1px;
    border-color: root.item.cell.today || scope.has-focus ? Theme.current.text_bright : Theme.current.control_hover;
    border-radius: Math.min(Theme.button_corner_radius, Math.min(self.width, self.height) / 2);
    accessible-role: button;
    accessible-label: root.item.weekday + " " + root.item.cell.day;
    VerticalLayout {
        padding: root.compact ? 3px : 8px; spacing: 4px;
        if root.week: Text { vertical-stretch: 0; min-width: 0; text: root.item.weekday; color: Theme.current.text_muted; font-size: 11px; horizontal-alignment: center; }
        HorizontalLayout {
            Text { vertical-stretch: 0; min-width: 0; text: root.item.cell.day; color: root.item.cell.selected ? Theme.current.on_accent : root.item.cell.in_month ? Theme.current.text_bright : Theme.current.text_muted; font-size: root.compact ? 12px : 15px; }
            if root.item.cell.count > 0: Text { vertical-stretch: 0; min-width: 0; text: root.compact ? "•" : root.item.cell.count; color: root.item.cell.selected ? Theme.current.on_accent : Theme.current.accent; horizontal-alignment: right; font-size: 12px; }
        }
        if !root.compact && !root.week: Text { vertical-stretch: 0; min-width: 0; text: root.item.preview; color: root.item.cell.selected ? Theme.current.on_accent : Theme.current.text_muted; font-size: 11px; overflow: elide; wrap: word-wrap; }
        Rectangle { vertical-stretch: 1; }
    }
    scope := FocusScope { width: 100%; height: 100%; key-pressed(e) => { if (e.text == Key.Return || e.text == " ") { if (!e.repeat) { root.picked(root.item.cell.epoch); } accept } else { reject } } }
    TouchArea { mouse-cursor: pointer; clicked => { scope.focus(); root.picked(root.item.cell.epoch); } }
}
component ReleaseCard inherits Rectangle {
    in property <CalendarRelease> release;
    in property <string> artwork-key;
    in property <bool> artwork-active;
    in property <length> viewport-top;
    in property <length> viewport-height;
    callback artwork-visible(string, bool);
    // Retain one viewport above/below the visible cards. Pixel ownership is
    // released by Rust when this delegate leaves that window.
    private property <bool> artwork-retained: root.artwork-active && root.viewport-height > 0px
        && self.absolute-position.y + self.height >= root.viewport-top - root.viewport-height
        && self.absolute-position.y <= root.viewport-top + 2 * root.viewport-height;
    private property <string> artwork-report: root.artwork-key + root.release.artwork_identity + (root.artwork-retained ? "1" : "0");
    Timer { interval: 1500ms; running: root.artwork-retained; triggered => { root.artwork-visible(root.artwork-key, true); } }
    changed artwork-report => { root.artwork-visible(root.artwork-key, root.artwork-retained); }
    init => { root.artwork-visible(root.artwork-key, root.artwork-retained); }
    callback picked(string);
    height: 86px;
    background: Theme.current.control;
    border-radius: Theme.card_corner_radius;
    border-width: scope.has-focus ? 2px : 1px;
    border-color: scope.has-focus ? Theme.current.accent : Theme.current.control_hover;
    accessible-role: button;
    accessible-label: root.release.title + " " + root.release.subtitle;
    HorizontalLayout {
        padding: 8px; spacing: 12px;
        Rectangle { width: 64px; background: Theme.current.control_hover; border-radius: 6px; clip: true; Image { source: root.release.poster; image-fit: cover; } }
        VerticalLayout { spacing: 3px; Text { vertical-stretch: 0; min-width: 0; text: root.release.title; color: Theme.current.text_bright; font-size: 15px; overflow: elide; } Text { vertical-stretch: 0; min-width: 0; text: root.release.subtitle; color: Theme.current.text_muted; font-size: 12px; overflow: elide; } Text { vertical-stretch: 0; min-width: 0; text: root.release.date; color: Theme.current.text_muted; font-size: 12px; overflow: elide; } }
        Text { width: 12px; text: "›"; color: Theme.current.text_muted; vertical-alignment: center; }
    }
    scope := FocusScope { width: 100%; height: 100%; key-pressed(e) => { if (e.text == Key.Return || e.text == " ") { if (!e.repeat) { root.picked(root.release.key); } accept } else { reject } } }
    TouchArea { mouse-cursor: pointer; clicked => { scope.focus(); root.picked(root.release.key); } }
}
component PlannerViews inherits Rectangle {
    in property <int> current;
    callback picked(int);
    height: 44px;
    HorizontalLayout { spacing: 6px;
        for label[i] in [@tr("Month"), @tr("Week"), @tr("Agenda")]: PlannerButton {
            label: label; selected: root.current == i; picked => { root.picked(i); }
        }
    }
}
component PlannerScope inherits Rectangle {
    in property <bool> all;
    callback picked(bool);
    height: 44px;
    HorizontalLayout { spacing: 6px;
        PlannerButton { label: @tr("Next episode"); selected: !root.all; picked => { root.picked(false); } }
        PlannerButton { label: @tr("All releases"); selected: root.all; picked => { root.picked(true); } }
    }
}
component PlannerPeriod inherits Rectangle {
    in property <string> title;
    in property <bool> compact: false;
    callback step(int);
    callback today();
    height: 44px;
    HorizontalLayout { spacing: 8px;
        PlannerButton { width: 44px; label: "‹"; accessible-label: @tr("Previous period"); picked => { root.step(-1); } }
        Text { vertical-stretch: 0; min-width: 0; text: root.title; color: Theme.current.text_bright; vertical-alignment: center; horizontal-alignment: center; font-size: root.compact ? 12px : 15px; wrap: root.compact ? word-wrap : no-wrap; overflow: elide; }
        PlannerButton { width: 44px; label: "›"; accessible-label: @tr("Next period"); picked => { root.step(1); } }
        PlannerButton { width: 65px; label: @tr("Today"); picked => { root.today(); } }
    }
}
export component CalendarPage inherits Rectangle {
    // Called after publication only while AppWindow retains baseline focus.
    public function focus_shell() { if root.active { page_scope.focus(); } }

    in property <bool> external_navigation: false;
    in property <bool> active: true;
    background: Theme.current.artwork_canvas;
    in property <[CalendarDay]> cells;
    in property <[CalendarDay]> week_cells;
    in property <[CalendarRelease]> rows;
    in property <[CalendarRelease]> later;
    in property <string> title;
    in property <string> day_title;
    in property <int> count;
    in-out property <string> search;
    in-out property <int> view;
    in-out property <bool> all;
    in property <length> safe-top;
    in property <length> safe-left;
    in property <length> safe-right;
    in property <length> safe-bottom;
    in property <int> system_back_request;
    in-out property <bool> kb_active;
    in property <length> nav-viewport-width: root.width;
    private property <bool> narrow: root.nav-viewport-width < 700px;
    private property <bool> wide_header: root.nav-viewport-width >= 1000px;
    private property <int> last_back;
    in property <bool> artwork-active: true;
    callback artwork-visible(string, bool);
    callback artwork-active-changed(bool);
    changed artwork-active => { root.artwork-active-changed(root.artwork-active); }
    callback refreshed();
    callback step(int);
    callback today();
    callback day_picked(int);
    callback release_picked(string);
    callback back();
    callback home_picked(); callback discover_picked(); callback library_picked(); callback settings_picked(); callback about_picked(); callback more_picked();
    changed system_back_request => { if root.active && root.last_back != root.system_back_request { root.last_back = root.system_back_request; root.back(); } }
    page_scope := FocusScope {
    enabled: root.active;
    width: 100%; height: 100%;
    init => { root.last_back = root.system_back_request; self.focus(); }
    capture-key-pressed(e) => { if (e.text == Key.Escape || e.text == Key.Back) { if (!e.repeat) { root.back(); } accept } else { reject } }
    VerticalLayout {
        padding-left: 18px + (root.narrow || root.external_navigation ? 0px : NavMetrics.width-for(root.nav-viewport-width)) + root.safe-left;
        padding-right: 18px + root.safe-right; padding-top: 18px + root.safe-top; spacing: 12px;
        // Wide windows keep the planner chrome to two rows, leaving room
        // for all six calendar weeks at ordinary desktop window heights.
        HorizontalLayout {
            vertical-stretch: 0; spacing: 12px;
            calendar_header := PageHeader {
                title: @tr("Calendar"); narrow: root.narrow;
                subtitle: @tr("{n} episode release" | "{n} episode releases" % root.count);
                back => { root.back(); }
            }
            if !root.narrow: SearchField {
                width: root.wide_header ? 240px : 220px;
                text <=> root.search; search-icon: true; roomy: true; placeholder-text: @tr("Search series");
                edited(v) => { root.search = v; root.refreshed(); }
            }
            if root.wide_header: PlannerViews {
                width: 240px; current: root.view; picked(v) => { root.view = v; root.refreshed(); }
            }
        }
        if root.narrow: SearchField {
            text <=> root.search; search-icon: true; roomy: true; placeholder-text: @tr("Search series");
            edited(v) => { root.search = v; root.refreshed(); }
        }
        if !root.wide_header && !root.narrow: HorizontalLayout {
            spacing: 12px;
            PlannerViews { current: root.view; picked(v) => { root.view = v; root.refreshed(); } }
            PlannerScope { all: root.all; picked(v) => { root.all = v; root.refreshed(); } }
        }
        if root.narrow: PlannerViews { current: root.view; picked(v) => { root.view = v; root.refreshed(); } }
        if root.narrow: PlannerScope { all: root.all; picked(v) => { root.all = v; root.refreshed(); } }
        if root.wide_header: HorizontalLayout {
            height: 44px; spacing: 12px;
            PlannerPeriod { title: root.title; step(d) => { root.step(d); } today => { root.today(); } }
            PlannerScope { width: 280px; all: root.all; picked(v) => { root.all = v; root.refreshed(); } }
        }
        if !root.wide_header: PlannerPeriod { compact: root.narrow; title: root.title; step(d) => { root.step(d); } today => { root.today(); } }
        releases-scroll := ScrollView {
            vertical-stretch: 1; content-width: self.visible-width; mouse-drag-pan-enabled: true;
            VerticalLayout {
                alignment: start; spacing: 12px;
                if root.view == 0: HorizontalLayout {
                    height: root.narrow ? 300px : 550px;
                    spacing: 16px;
                    VerticalLayout {
                        spacing: 4px;
                        HorizontalLayout { for label in [@tr("Mon"), @tr("Tue"), @tr("Wed"), @tr("Thu"), @tr("Fri"), @tr("Sat"), @tr("Sun")]: Text { vertical-stretch: 0; min-width: 0; text: label; color: Theme.current.text_muted; font-size: 11px; horizontal-alignment: center; } }
                        for week in 6: HorizontalLayout { spacing: 3px; height: root.narrow ? 43px : 85px; for col in 7: PlannerDay { item: root.cells[week * 7 + col]; compact: root.narrow; picked(day) => { root.day_picked(day); } } }
                    }
                    if !root.narrow: day-scroll := ScrollView {
                        property <length> artwork-viewport-top: Math.max(self.absolute-position.y, releases-scroll.absolute-position.y);
                        property <length> artwork-viewport-height: Math.max(0px, Math.min(self.absolute-position.y + self.visible-height, releases-scroll.absolute-position.y + releases-scroll.visible-height) - self.artwork-viewport-top);
                        width: 310px; height: 550px; content-width: self.visible-width; mouse-drag-pan-enabled: true; VerticalLayout { alignment: start; spacing: 10px; Text { vertical-stretch: 0; min-width: 0; text: root.day_title; color: Theme.current.text_bright; font-size: 16px; font-weight: 600; } if root.rows.length == 0: Text { vertical-stretch: 0; min-width: 0; text: @tr("No releases on this day"); color: Theme.current.text_muted; wrap: word-wrap; } for row in root.rows: ReleaseCard { artwork-key: "r" + row.key; artwork-active: root.artwork-active; viewport-top: day-scroll.artwork-viewport-top; viewport-height: day-scroll.artwork-viewport-height; artwork-visible(key, retained) => { root.artwork-visible(key, retained); } release: row; picked(key) => { root.release_picked(key); } } Text { vertical-stretch: 0; min-width: 0; text: @tr("Next up"); color: Theme.current.text_bright; font-size: 16px; } for row in root.later: ReleaseCard { artwork-key: "l" + row.key; artwork-active: root.artwork-active; viewport-top: day-scroll.artwork-viewport-top; viewport-height: day-scroll.artwork-viewport-height; artwork-visible(key, retained) => { root.artwork-visible(key, retained); } release: row; picked(key) => { root.release_picked(key); } } } }
                }
                if root.view == 1: HorizontalLayout { spacing: 3px; height: 82px; for item in root.week_cells: PlannerDay { item: item; compact: root.narrow; week: true; picked(day) => { root.day_picked(day); } } }
                if root.view != 0 || root.narrow: VerticalLayout { alignment: start; vertical-stretch: 0; spacing: 10px; if root.view == 0: Text { vertical-stretch: 0; min-width: 0; text: root.day_title; color: Theme.current.text_bright; font-size: 16px; } if root.rows.length == 0: Text { vertical-stretch: 0; min-width: 0; text: root.view == 0 ? @tr("No releases on this day") : @tr("No releases in this period"); color: Theme.current.text_muted; wrap: word-wrap; } for row in root.rows: VerticalLayout { alignment: start; vertical-stretch: 0; spacing: 8px; if root.view != 0 && row.group != "": Text { vertical-stretch: 0; min-width: 0; text: row.group; color: Theme.current.text_bright; font-size: 16px; font-weight: 600; } ReleaseCard { artwork-key: "r" + row.key; artwork-active: root.artwork-active; viewport-top: releases-scroll.absolute-position.y; viewport-height: releases-scroll.visible-height; artwork-visible(key, retained) => { root.artwork-visible(key, retained); } release: row; picked(key) => { root.release_picked(key); } } } }
            }
        }
    }
    if !root.narrow && !root.external_navigation: SideNav { active: 4; viewport-width: root.width; safe-top: root.safe-top; safe-left: root.safe-left; safe-bottom: root.safe-bottom; kb_active <=> root.kb_active; home_picked => { root.home_picked(); } discover_picked => { root.discover_picked(); } library_picked => { root.library_picked(); } more_picked => { root.more_picked(); } }
    }
    if !root.active: TouchArea {
        width: 100%; height: 100%;
        clicked => { }
        scroll-event(event) => { accept }
    }
}
