import { Theme } from "@NovaUiShared";
import { IcChevronLeft, IcChevronRight } from "icons.slint";

export component PageButton inherits Rectangle {
    // 0 = previous (‹), 1 = next (›).
    in property <int> glyph: 0;
    in property <bool> roomy: false;
    in property <bool> minimal: false;
    in property <string> name: "";
    in property <bool> enabled: true;
    callback picked();

    width: root.roomy ? 44px : 28px;
    height: self.width;
    horizontal-stretch: 0;
    border-radius: Math.min(Theme.button_corner_radius, Math.min(self.width, self.height) / 2);
    background: root.minimal || !root.enabled ? transparent : (pg_touch.has-hover ? Theme.current.pager_hover : (root.roomy ? Theme.current.pager_roomy : Theme.current.control));
    border-width: root.minimal ? 0px : 1px;
    border-color: root.enabled ? Theme.current.step_border : Theme.current.pager_disabled_border;
    accessible-role: button;
    accessible-label: root.name;

    // The icon stays visually small without shrinking its touch target.
    if root.minimal: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 28px; height: 28px;
        border-radius: 8px;
        background: root.enabled && pg_touch.has-hover ? Theme.current.border_subtle : transparent;
    }

    if root.glyph == 0: IcChevronLeft {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.minimal ? 16px : 18px;
        height: self.width;
        fill: root.enabled ? Theme.current.text_primary : Theme.current.icon_disabled;
    }
    if root.glyph == 1: IcChevronRight {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.minimal ? 16px : 18px;
        height: self.width;
        fill: root.enabled ? Theme.current.text_primary : Theme.current.icon_disabled;
    }

    pg_touch := TouchArea {
        enabled: root.enabled;
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

// Pager buttons for the episode list: rendered both above and under the grid,
// so a 200-episode season can be turned from either end without scrolling back
// to the top.
export component EpisodePager inherits Rectangle {
    in property <int> page: 0;
    in property <int> count: 1;
    // Stream/filter hosts keep the compact chevrons. Episodes retain touch
    // targets around small, unboxed arrows and a quiet page counter.
    in property <bool> episode-style: false;
    callback picked(int);

    width: root.episode-style ? 152px : 62px;
    height: root.episode-style ? 44px : 28px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    background: transparent;

    HorizontalLayout {
        spacing: root.episode-style ? 4px : 6px;
        PageButton {
            glyph: 0;
            roomy: root.episode-style;
            minimal: root.episode-style;
            name: @tr("Previous page");
            enabled: root.page > 0;
            picked => { root.picked(root.page - 1); }
        }
        if root.episode-style: page_counter := Text {
            horizontal-stretch: 1;
            min-width: 0px;
            height: 44px;
            text: @tr("{} / {}", root.page + 1, root.count);
            accessible-label: @tr("Page {}/{}", root.page + 1, root.count);
            color: Theme.current.text_detail_metadata;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        PageButton {
            glyph: 1;
            roomy: root.episode-style;
            minimal: root.episode-style;
            name: @tr("Next page");
            enabled: root.page + 1 < root.count;
            picked => { root.picked(root.page + 1); }
        }
    }
}
