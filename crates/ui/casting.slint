import { CastBridge, CastDeviceRow, Theme, InterfaceStyle, SettingsStyle, Anim } from "@NovaUiShared";
import { PillButton } from "settings-controls.slint";
import { SessionPanel, SessionTransportButton, SessionStatus } from "session-controls.slint";
import { IcCast, IcClose, IcDisplay } from "icons.slint";
import { LineEdit, ScrollView, Slider } from "std-widgets.slint";

export component CastButton inherits PillButton {
    width: 44px; height: 44px; label: "";
    accessible-label: CastBridge.connecting ? @tr("Connecting to receiver") : CastBridge.selected ? @tr("Connected to {}", CastBridge.target_name) : @tr("Cast to a device");
    property <bool> was_origin;
    property <int> focus_return: CastBridge.restore_focus;
    changed focus_return => { if self.was_origin { root.focus_control(); self.was_origin = false; } }
    clicked => { root.was_origin = true; CastBridge.show(); }
    IcCast { x: 10px; y: 10px; width: 24px; height: 24px; property <color> target_fill: CastBridge.selected ? Theme.current.accent : Theme.current.text_primary; property <color> state_fill: self.target_fill; property <bool> state_motion: Anim.enabled; changed target_fill => { self.state_fill = self.target_fill; } changed state_motion => { self.state_fill = self.target_fill; } animate state_fill { duration: Anim.control_state; } fill: Anim.enabled ? self.state_fill : self.target_fill; }
    if CastBridge.connecting || CastBridge.stale: Rectangle { x: 31px; y: 6px; width: 7px; height: 7px; border-radius: 4px; background: Theme.current.accent; }
}

component ReceiverRow inherits Rectangle {
    in property <string> caption;
    in property <string> subtitle;
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <bool> focused;
    callback clicked();
    height: InterfaceStyle.tv ? 76px : 64px;
    background: root.focused || touch.has-hover ? Theme.current.control_hover : transparent;
    border-radius: 10px; border-width: root.focused ? 2px : 0px; border-color: Theme.current.focus_ring;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: button; accessible-label: root.caption + (root.subtitle == "" ? "" : ", " + root.subtitle); accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    IcDisplay { x: 12px; y: (parent.height - 24px) / 2; width: 24px; height: 24px; fill: Theme.current.text_primary; }
    VerticalLayout { x: 48px; y: 9px; width: Math.max(0px, parent.width - 92px); spacing: 2px;
        Text { text: root.caption; color: Theme.current.text_primary; font-size: InterfaceStyle.tv ? 21px : 15px; overflow: elide; vertical-alignment: center; }
        Text { text: root.subtitle; color: Theme.current.text_muted; font-size: InterfaceStyle.tv ? 16px : 12px; overflow: elide; }
    }
    Rectangle { x: parent.width - 32px; y: (parent.height - 20px) / 2; width: 20px; height: 20px; border-radius: 10px; border-width: 2px; property <color> target_border: root.selected ? Theme.current.accent : Theme.current.text_muted; property <color> state_border: self.target_border; property <bool> state_motion: Anim.enabled;
        changed target_border => { self.state_border = self.target_border; }
        changed state_motion => { self.state_border = self.target_border; }
        animate state_border { duration: Anim.control_state; }
        border-color: Anim.enabled ? self.state_border : self.target_border;
        selection_dot := Rectangle { x: 5px; y: 5px; width: 10px; height: 10px; border-radius: 5px; background: Theme.current.accent;
            property <float> target_opacity: root.selected ? 1 : 0; property <float> state_opacity: self.target_opacity; property <bool> state_motion: Anim.enabled;
            changed target_opacity => { self.state_opacity = self.target_opacity; }
            changed state_motion => { self.state_opacity = self.target_opacity; }
            animate state_opacity { duration: Anim.control_state; }
            opacity: Anim.enabled ? self.state_opacity : self.target_opacity;
        }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

export component CastingPanel inherits Rectangle {
    in property <length> safe_bottom;
    in property <bool> touch;
    in property <length> safe_left;
    in property <length> safe_right;
    property <bool> phone: root.touch || root.width < 600px;
    in property <length> safe_top;
    property <string> focus_id: CastBridge.target_id;
    property <int> focus_index: -1;
    property <bool> manual_open;
    property <string> manual_address;
    property <bool> back_held;
    property <bool> replace_focus;
    property <int> back_request: CastBridge.back_request;
    changed back_request => { root.close_layer(); }
    property <bool> keyboard_mode: InterfaceStyle.tv;
    property <int> action_index: CastBridge.active ? 0 : -1;
    in property <bool> active: CastBridge.open;
    callback visual_closed();
    property <bool> revealed;
    property <bool> motion_enabled: Anim.enabled && Anim.transitions;
    property <float> progress: root.revealed ? 1 : 0;
    animate progress { duration: Anim.transition_slide; easing: ease-out; }
    property <float> fade: root.revealed ? 1 : 0;
    animate fade { duration: Anim.transition_fade; easing: ease-out; }
    changed revealed => { root.progress = root.revealed ? 1 : 0; root.fade = root.revealed ? 1 : 0; }
    function update_open() {
        enter_timer.stop(); exit_timer.stop();
        if root.active {
            if root.motion_enabled { enter_timer.start(); } else { root.revealed = true; }
        } else {
            root.revealed = false;
            if root.motion_enabled { exit_timer.start(); } else { root.visual_closed(); }
        }
    }
    init => { root.update_open(); }
    changed active => { root.update_open(); }
    changed motion_enabled => { if !root.motion_enabled { enter_timer.stop(); exit_timer.stop(); root.revealed = root.active; root.progress = root.active ? 1 : 0; root.fade = root.active ? 1 : 0; if !root.active { root.visual_closed(); } } }
    enter_timer := Timer { interval: 1ms; running: false; triggered => { self.stop(); root.revealed = root.active; } }
    exit_timer := Timer { interval: Anim.transition_slide; running: false; triggered => { self.stop(); if !root.active { root.visual_closed(); } } }
    background: transparent;
    scrim := Rectangle { width: 100%; height: 100%; background: Theme.current.scrim_artwork; opacity: root.motion_enabled ? root.fade : (root.revealed ? 1 : 0); }
    TouchArea { clicked => { if root.active { CastBridge.open = false; } } }
    public function close_layer() { if root.manual_open { root.manual_open = false; } else if CastBridge.replacement { CastBridge.replace(false); } else { CastBridge.open = false; } }
    function action_visible(index: int) -> bool {
        if index == 0 { return CastBridge.active && CastBridge.can_pause && !CastBridge.stale; }
        if index == 1 || index == 2 { return CastBridge.active && CastBridge.can_seek && !CastBridge.stale; }
        if index == 3 || index == 4 { return CastBridge.active && !CastBridge.connecting; }
        if index == 5 || index == 6 || index == 7 { return true; }
        if index == 8 { return CastBridge.unverified; }
        if index == 9 { return CastBridge.stale; }
        if index == 10 { return CastBridge.connecting; }
        if index == 11 { return CastBridge.uncertain; }
        if index == 12 { return CastBridge.uncertain || CastBridge.recovery_available; }
        if index == 13 { return CastBridge.active && CastBridge.can_mute && !CastBridge.stale; }
        if index == 14 || index == 15 { return CastBridge.active && CastBridge.can_volume && !CastBridge.stale; }
        if index >= 16 && index < 25 { return CastBridge.active && CastBridge.can_text_tracks && CastBridge.text_tracks.length > 0 && index - 17 < CastBridge.text_tracks.length; }
        return false;
    }
    function candidate(index: int, delta: int) -> int {
        return index < 0 || index >= 25 || root.action_visible(index) ? index : index + delta;
    }
    function reveal_control(top: length, height: length) {
        let visible_top = body_scroll.absolute-position.y + 12px;
        let visible_bottom = body_scroll.absolute-position.y + body_scroll.height - 12px;
        if top < visible_top { body_scroll.content-y = Math.min(0px,body_scroll.content-y + visible_top - top); }
        else if top + height > visible_bottom { body_scroll.content-y -= top + height - visible_bottom; }
    }
    function activate() {
        let index = root.action_index;
        if index >= 0 {
            if !root.action_visible(index) { return; }
            if index == 0 { CastBridge.action("pause",CastBridge.paused ? 0 : 1); }
            else if index == 1 { CastBridge.action("seek",Math.max(0,CastBridge.position - 10)); }
            else if index == 2 { CastBridge.action("seek",CastBridge.position + 10); }
            else if index == 3 { CastBridge.action("here",0); }
            else if index == 4 || index == 11 { CastBridge.action("stop",0); }
            else if index == 5 { if CastBridge.searching { CastBridge.cancel(); } else { CastBridge.refresh(); } }
            else if index == 6 { root.manual_open = !root.manual_open; }
            else if index == 7 { CastBridge.open = false; }
            else if index == 8 { CastBridge.action("unverified",0); }
            else if index == 9 { CastBridge.action("retry",0); }
            else if index == 10 { CastBridge.cancel(); }
            else if index == 12 { CastBridge.action("local_anyway",0); }
            else if index == 13 { CastBridge.action("mute",CastBridge.muted ? 0 : 1); }
            else if index == 14 || index == 15 { CastBridge.action("volume",Math.clamp(CastBridge.volume + (index == 14 ? -0.05 : 0.05),0,1)); }
            else if index == 16 { CastBridge.action("text",0); }
            else { CastBridge.action("text",CastBridge.text_tracks[index - 17].id); }
            return;
        }
        if root.focus_id != "" { CastBridge.select(root.focus_id); } else if !CastBridge.active { CastBridge.select(""); }
    }
    function move_focus(delta: int) {
        if root.action_index >= 0 {
        let candidate0 = root.candidate(root.action_index + delta,delta);
        let candidate1 = root.candidate(candidate0,delta);
        let candidate2 = root.candidate(candidate1,delta);
        let candidate3 = root.candidate(candidate2,delta);
        let candidate4 = root.candidate(candidate3,delta);
        let candidate5 = root.candidate(candidate4,delta);
        let candidate6 = root.candidate(candidate5,delta);
        let candidate7 = root.candidate(candidate6,delta);
        let candidate8 = root.candidate(candidate7,delta);
        let candidate9 = root.candidate(candidate8,delta);
        let candidate10 = root.candidate(candidate9,delta);
        let candidate11 = root.candidate(candidate10,delta);
        let candidate12 = root.candidate(candidate11,delta);
        let candidate13 = root.candidate(candidate12,delta);
        let candidate14 = root.candidate(candidate13,delta);
        let candidate15 = root.candidate(candidate14,delta);
        let candidate16 = root.candidate(candidate15,delta);
        let candidate17 = root.candidate(candidate16,delta);
        let candidate18 = root.candidate(candidate17,delta);
        let candidate19 = root.candidate(candidate18,delta);
        let candidate20 = root.candidate(candidate19,delta);
        let candidate21 = root.candidate(candidate20,delta);
        let candidate22 = root.candidate(candidate21,delta);
        let candidate23 = root.candidate(candidate22,delta);
        let candidate24 = root.candidate(candidate23,delta);
        let candidate25 = root.candidate(candidate24,delta);
            root.action_index = candidate25 < 0 || candidate25 >= 25 ? -1 : candidate25;
            return;
        }
        let next = root.focus_index + delta;
        if next < -1 || next >= CastBridge.devices.length { root.action_index = delta > 0 ? 5 : 7; return; }
        root.focus_index = next;
        root.focus_id = root.focus_index < 0 ? "" : CastBridge.devices[root.focus_index].id;
        list.content-y = Math.min(0px,list.height - (root.focus_index + 2) * (InterfaceStyle.tv ? 76px : 64px));
        root.reveal_control(list.absolute-position.y,list.height);
    }
    focus := FocusScope {
        width: 100%; height: 100%; init => { self.focus(); }
        enabled: root.active;
        capture-key-pressed(e) => {
            root.keyboard_mode = true;
            if e.text == Key.Back || e.text == Key.Escape { if !e.repeat && !root.back_held { root.back_held = true; root.close_layer(); } accept }
            else if CastBridge.replacement && (e.text == Key.LeftArrow || e.text == Key.RightArrow) { root.replace_focus = e.text == Key.RightArrow; accept }
            else if CastBridge.replacement && (e.text == Key.Return || e.text == " ") { if !e.repeat { CastBridge.replace(root.replace_focus); } accept }
            else if !root.manual_open && (e.text == Key.DownArrow || e.text == Key.UpArrow || e.text == Key.LeftArrow || e.text == Key.RightArrow) { root.move_focus((e.text == Key.DownArrow || e.text == Key.RightArrow) ? 1 : -1); accept }
            else if !root.manual_open && (e.text == Key.Return || e.text == " ") { if !e.repeat { root.activate(); } accept } else { reject }
        }
        capture-key-released(e) => { if e.text == Key.Back || e.text == Key.Escape { root.back_held = false; accept } else { reject } }
    }
    sheet := SessionPanel {
        width: Math.max(0px, Math.min(root.width - (root.phone ? 0px : 40px), InterfaceStyle.tv ? 680px : 480px));
        height: Math.max(0px, Math.min(root.height - root.safe_top - 16px, CastBridge.active ? 860px : 560px));
        x: (root.width - self.width) / 2;
        y: (root.phone ? root.height - self.height : (root.height - self.height) / 2) + (1 - (root.motion_enabled ? root.progress : (root.revealed ? 1 : 0))) * 24px;
        opacity: root.motion_enabled ? root.fade : (root.revealed ? 1 : 0);
        TouchArea { }
        body_scope := FocusScope { width: 100%; height: 100%; enabled: root.active;
        body_scroll := ScrollView { width: 100%; height: 100%;
        content := VerticalLayout {
            padding: 16px; padding-left: 16px + root.safe_left; padding-right: 16px + root.safe_right; padding-bottom: 16px + root.safe_bottom; spacing: 12px;
            HorizontalLayout { spacing: 12px;
                Text { text: @tr("Cast to a device"); color: Theme.current.text_primary; font-size: InterfaceStyle.tv ? 26px : 20px; font-weight: 700; vertical-alignment: center; min-width: 0px; overflow: elide; }
                PillButton { width: 44px; label: ""; accessible-label: @tr("Close"); focused: root.keyboard_mode && root.action_index == 7; changed focused => { if self.focused { root.reveal_control(self.absolute-position.y,self.height); } } clicked => { CastBridge.open = false; } IcClose { x: 10px; y: 10px; width: 24px; height: 24px; fill: Theme.current.text_primary; } }
            }
            if CastBridge.selected && CastBridge.target_name != "": Text { text: CastBridge.target_name; color: Theme.current.accent; font-size: InterfaceStyle.tv ? 21px : 15px; horizontal-alignment: center; overflow: elide; }
            if CastBridge.status != "": SessionStatus { label: CastBridge.status; connected: CastBridge.selected && !CastBridge.stale; }
            if CastBridge.recovery_available && !CastBridge.uncertain: PillButton { label: @tr("Play here"); focused: root.keyboard_mode && root.action_index == 12; clicked => { CastBridge.action("local_anyway",0); } }
            if CastBridge.uncertain: VerticalLayout { spacing: 8px;
                Text { text: @tr("The receiver may still be playing. Resume local playback anyway?"); wrap: word-wrap; color: Theme.current.text_primary; }
                PillButton { label: @tr("Retry Stop casting"); focused: root.keyboard_mode && root.action_index == 11; changed focused => { if self.focused { root.reveal_control(self.absolute-position.y,self.height); } } clicked => { CastBridge.action("stop",0); } }
                PillButton { label: @tr("Resume locally anyway"); focused: root.keyboard_mode && root.action_index == 12; changed focused => { if self.focused { root.reveal_control(self.absolute-position.y,self.height); } } clicked => { CastBridge.action("local_anyway",0); } }
            }
            if CastBridge.unverified: PillButton { label: @tr("Try this stream"); focused: root.keyboard_mode && root.action_index == 8; changed focused => { if self.focused { root.reveal_control(self.absolute-position.y,self.height); } } clicked => { CastBridge.action("unverified",0); } }
            if CastBridge.stale: PillButton { label: @tr("Retry connection"); focused: root.keyboard_mode && root.action_index == 9; changed focused => { if self.focused { root.reveal_control(self.absolute-position.y,self.height); } } clicked => { CastBridge.action("retry", 0); } }
            if CastBridge.subtitle_notice != "": Text { text: CastBridge.subtitle_notice; wrap: word-wrap; color: Theme.current.text_muted; }
            if CastBridge.error != "": Text { text: CastBridge.error; wrap: word-wrap; color: Theme.current.text_destructive; font-size: InterfaceStyle.tv ? 18px : 14px; }
            if CastBridge.replacement: VerticalLayout { spacing: 10px;
                Text { text: @tr("This receiver is already in use. Replace its playback?"); wrap: word-wrap; color: Theme.current.text_primary; }
                HorizontalLayout { spacing: 10px; PillButton { label: @tr("Cancel"); focused: !root.replace_focus; clicked => { CastBridge.replace(false); } } PillButton { label: @tr("Replace playback"); destructive: true; focused: root.replace_focus; clicked => { CastBridge.replace(true); } } }
            }
            if CastBridge.active && !CastBridge.replacement: VerticalLayout { spacing: 12px;
                Image { source: CastBridge.artwork; height: 100px; image-fit: contain; }
                Text { text: CastBridge.title; color: Theme.current.text_primary; font-size: InterfaceStyle.tv ? 24px : 18px; horizontal-alignment: center; overflow: elide; }
                HorizontalLayout { alignment: center; spacing: 20px;
                    SessionTransportButton { caption: @tr("Back 10 seconds"); focused: root.keyboard_mode && root.action_index == 1; changed focused => { if self.focused { root.reveal_control(self.absolute-position.y,self.height); } } kind: -1; enabled: CastBridge.can_seek && !CastBridge.stale; clicked => { CastBridge.action("seek", Math.max(0, CastBridge.position - 10)); } }
                    SessionTransportButton { caption: CastBridge.paused ? @tr("Play") : @tr("Pause"); focused: root.keyboard_mode && root.action_index == 0; changed focused => { if self.focused { root.reveal_control(self.absolute-position.y,self.height); } } paused: CastBridge.paused; primary: true; enabled: CastBridge.can_pause && !CastBridge.stale; clicked => { CastBridge.action("pause", CastBridge.paused ? 0 : 1); } }
                    SessionTransportButton { caption: @tr("Forward 10 seconds"); focused: root.keyboard_mode && root.action_index == 2; changed focused => { if self.focused { root.reveal_control(self.absolute-position.y,self.height); } } kind: 1; enabled: CastBridge.can_seek && !CastBridge.stale; clicked => { CastBridge.action("seek", CastBridge.position + 10); } }
                }
                Text { text: CastBridge.time_text; color: Theme.current.text_muted; horizontal-alignment: center; }
                if CastBridge.can_seek: Slider { value: CastBridge.position; minimum: 0; maximum: Math.max(1, CastBridge.duration); enabled: !CastBridge.stale; changed(value) => { CastBridge.action("seek", value); } }
                if CastBridge.can_volume && InterfaceStyle.tv: HorizontalLayout { spacing: 8px;
                    PillButton { label: @tr("Volume down"); focused: root.keyboard_mode && root.action_index == 14; changed focused => { if self.focused { root.reveal_control(self.absolute-position.y,self.height); } } clicked => { CastBridge.action("volume",Math.max(0,CastBridge.volume - 0.05)); } }
                    PillButton { label: @tr("Volume up"); focused: root.keyboard_mode && root.action_index == 15; changed focused => { if self.focused { root.reveal_control(self.absolute-position.y,self.height); } } clicked => { CastBridge.action("volume",Math.min(1,CastBridge.volume + 0.05)); } }
                }
                if CastBridge.can_volume: Slider { value: CastBridge.volume; minimum: 0; maximum: 1; enabled: !CastBridge.stale; changed(value) => { CastBridge.action("volume", value); } }
                if CastBridge.can_mute: PillButton { label: CastBridge.muted ? @tr("Unmute") : @tr("Mute"); focused: root.keyboard_mode && root.action_index == 13; changed focused => { if self.focused { root.reveal_control(self.absolute-position.y,self.height); } } enabled: !CastBridge.stale; clicked => { CastBridge.action("mute",CastBridge.muted ? 0 : 1); } }
                if CastBridge.can_text_tracks && CastBridge.text_tracks.length > 0: VerticalLayout { spacing: 6px;
                    Text { text: @tr("Subtitles"); color: Theme.current.text_primary; }
                    PillButton { label: @tr("Off"); focused: root.keyboard_mode && root.action_index == 16; changed focused => { if self.focused { root.reveal_control(self.absolute-position.y,self.height); } } primary: CastBridge.selected_text_track == 0; clicked => { CastBridge.action("text",0); } }
                    for track[i] in CastBridge.text_tracks: PillButton { label: track.name; focused: root.keyboard_mode && root.action_index == 17 + i; changed focused => { if self.focused { root.reveal_control(self.absolute-position.y,self.height); } } primary: CastBridge.selected_text_track == track.id; clicked => { CastBridge.action("text",track.id); } }
                }
                HorizontalLayout { spacing: 8px;
                    PillButton { label: @tr("Play here"); focused: root.keyboard_mode && root.action_index == 3; changed focused => { if self.focused { root.reveal_control(self.absolute-position.y,self.height); } } enabled: !CastBridge.connecting; clicked => { CastBridge.action("here", 0); } }
                    PillButton { label: @tr("Stop casting"); focused: root.keyboard_mode && root.action_index == 4; changed focused => { if self.focused { root.reveal_control(self.absolute-position.y,self.height); } } destructive: true; enabled: !CastBridge.connecting; clicked => { CastBridge.action("stop", 0); } }
                }
            }
            list := ScrollView {
                visible: !CastBridge.replacement;
                height: Math.min(InterfaceStyle.tv ? 260px : 210px, (CastBridge.devices.length + 1) * (InterfaceStyle.tv ? 76px : 64px));
                VerticalLayout { spacing: 2px;
                    ReceiverRow { caption: @tr("This device"); subtitle: CastBridge.active ? @tr("Use Play here to return playback") : @tr("Play on this device"); selected: !CastBridge.selected; focused: root.keyboard_mode && root.action_index < 0 && root.focus_id == ""; enabled: !CastBridge.active; clicked => { CastBridge.select(""); } }
                    for receiver in CastBridge.devices: ReceiverRow { caption: receiver.name; subtitle: receiver.available ? receiver.protocol : @tr("Audio-only receiver"); selected: receiver.id == CastBridge.target_id; focused: root.keyboard_mode && root.action_index < 0 && root.focus_id == receiver.id; enabled: receiver.available && !CastBridge.connecting; clicked => { root.focus_id = receiver.id; CastBridge.select(receiver.id); } }
                }
            }
            if CastBridge.devices.length == 0 && !CastBridge.searching: Text { text: @tr("No receivers found. Check that both devices are on the same Wi-Fi network."); wrap: word-wrap; color: Theme.current.text_muted; font-size: 13px; }
            if root.manual_open: VerticalLayout { spacing: 8px;
                LineEdit { text <=> root.manual_address; placeholder-text: @tr("Receiver IP address"); accepted => { CastBridge.manual(root.manual_address); } }
                PillButton { label: @tr("Connect"); enabled: root.manual_address != "" && !CastBridge.searching; clicked => { CastBridge.manual(root.manual_address); } }
            }
            HorizontalLayout { spacing: 8px;
                PillButton { label: CastBridge.searching ? @tr("Cancel search") : @tr("Search this network once"); focused: root.keyboard_mode && root.action_index == 5; changed focused => { if self.focused { root.reveal_control(self.absolute-position.y,self.height); } } compact: true; wrap_label: true; clicked => { if CastBridge.searching { CastBridge.cancel(); } else { CastBridge.refresh(); } } }
                PillButton { label: @tr("Enter address"); focused: root.keyboard_mode && root.action_index == 6; changed focused => { if self.focused { root.reveal_control(self.absolute-position.y,self.height); } } compact: true; wrap_label: true; clicked => { root.manual_open = !root.manual_open; } }
            }
            if CastBridge.connecting: PillButton { label: @tr("Cancel connection"); focused: root.keyboard_mode && root.action_index == 10; changed focused => { if self.focused { root.reveal_control(self.absolute-position.y,self.height); } } clicked => { CastBridge.cancel(); } }
        }
        }
        }
    }
    if !root.active: TouchArea { width: 100%; height: 100%; }

}
