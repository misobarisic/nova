import { RemoteTargetMenu } from "remote-controls.slint";
import { InterfaceStyle, PartyBridge, RemoteBridge, StreamFiltersBridge, SettingsSync, Theme, Anim, StreamRow, SheetItem } from "@NovaUiShared";



import { StreamFilterPanel } from "stream-filter-panel.slint";

import { Spinner } from "std-widgets.slint";
import { PillButton } from "settings-controls.slint";
import { MenuSheet } from "menusheet.slint";
import { IcMoreHoriz, IcChevronLeft, IcChevronRight, IcSettingsGear } from "icons.slint";

// One filter pill in the horizontal addon bar above the stream list.
export component StreamFilterPill inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> focused;
    in property <bool> touch_feedback: false;
    // The addon is still being queried: show a small spinner on the right.
    in property <bool> loading;
    callback picked();
    callback reveal_requested(length, length);
    // Side padding. The pill keeps this intrinsic width whether or not a
    // query is in flight: while loading the spinner *replaces* the trailing
    // padding (same 14px) instead of adding to it, so the bar no longer
    // reflows as addons answer one by one.
    property <length> pad: 14px;

    height: InterfaceStyle.tv ? 56px : 40px;
    border-radius: Math.min(Theme.button_corner_radius, Math.min(self.width, self.height) / 2);
    // A released Android touch can retain has-hover without a pointer exit.
    background: root.selected ? Theme.current.primary_button : ((root.touch_feedback ? pill_touch.pressed : pill_touch.has-hover) ? Theme.current.control_hover : Theme.current.hero_control);
    clip: true;
    border-width: root.focused ? 2px : 1px;
    border-color: root.focused ? Theme.current.accent_vivid : (root.selected ? Theme.current.accent : Theme.current.border_strong);
    accessible-role: button;
    accessible-label: root.label;
    changed focused => { if (root.focused) { reveal_t.start(); } }
    reveal_t := Timer {
        interval: 16ms;
        running: root.focused;
        triggered => { self.stop(); root.reveal_requested(root.absolute-position.x, root.width); }
    }

    HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.loading ? 0px : root.pad;
        spacing: root.loading ? 0px : 8px;

        Text {
            text: root.label;
            color: root.selected ? Theme.current.on_accent : Theme.current.text_secondary;
            font-size: InterfaceStyle.tv ? 18px : 13px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
        }

        // Centred in the pill's height (a layout child of a HorizontalLayout
        // is top-aligned, and a squashed ring would look wrong).
        if root.loading: Rectangle {
            width: root.pad;
            height: 100%;

            Spinner {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: root.pad;
                height: root.pad;
            }
        }
    }

    pill_touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

// Chevron button shared by compact stream controls and touch-sized episode paging.
export { PageButton, EpisodePager }
import { PageButton, EpisodePager } from "episode-pager.slint";

// Addon filter pills above the stream list: All + one per addon, with
// per-pill spinners while queries are in flight. The fixed header owns one
// instance independently of the vertical result viewport.
component StreamFilterBar inherits HorizontalLayout {
    in property <[string]> addons: [];
    in property <[bool]> loading: [];
    in property <bool> searching: false;
    // Active filter: 0 = All, otherwise 1-based index into `addons`.
    in property <int> addon_filter: 0;
    in property <bool> touch_menus: false;
    in property <bool> touch_feedback: false;
    in property <bool> kb_active: false;

    callback filter_picked(int);

    function reveal_pill(x: length, width: length) {
        let relative = x - pill_flick.absolute-position.x;
        let min_x = Math.min(0px, pill_flick.width - pill_flick.content-width);
        if (relative < 0px) { pill_flick.content-x = Math.min(0px, pill_flick.content-x - relative); }
        else if (relative + width > pill_flick.width) {
            pill_flick.content-x = Math.max(min_x, pill_flick.content-x - (relative + width - pill_flick.width));
        }
    }

    min-width: 0px;
    spacing: 8px;

    // True while the pill row is wider than its viewport. The desktop
    // chevron slots below are always laid out (never `if`-gated), so
    // this flag can't feed back into the geometry (binding loop).
    property <bool> overflowing: pill_row.width > pill_flick.width + 1px;

    // Desktop chevron slots: fixed geometry whether or not the row
    // overflows; the buttons fade in only while useful (an `if` here
    // would resize the viewport and loop with `overflowing` above).
    // A disabled touch passes taps through, so a faded slot is inert.
    if !root.touch_menus: PageButton {
        glyph: 0;
        name: @tr("Scroll filters left");
        opacity: root.overflowing && pill_flick.content-x < -0.5px ? 1.0 : 0.0;
        animate opacity { duration: Anim.hover_fast; }
        enabled: root.overflowing && pill_flick.content-x < -0.5px;
        picked => {
            pill_flick.content-x = Math.min(0px, pill_flick.content-x + pill_flick.width);
        }
    }

    pill_flick := Flickable {
        horizontal-stretch: 1;
        min-width: 0px;
        height: InterfaceStyle.tv ? 56px : 40px;
        interactive: true;
        content-width: pill_row.width;
        content-height: self.height;

        // Explicit width = intrinsic pill row width, so the Flickable
        // scrolls it horizontally instead of squeezing it.
        pill_row := HorizontalLayout {
            width: self.preferred-width;
            height: InterfaceStyle.tv ? 56px : 40px;
            spacing: 8px;
            alignment: start;

            for i in root.addons.length + 1: StreamFilterPill {
                touch_feedback: root.touch_feedback;
                label: i == 0 ? @tr("All") : root.addons[i - 1];
                selected: root.addon_filter == i;
                focused: root.kb_active && root.addon_filter == i;
                loading: i == 0 ? root.searching : (i - 1 < root.loading.length && root.loading[i - 1]);
                picked => { root.filter_picked(i); }
                reveal_requested(x, w) => { root.reveal_pill(x, w); }
            }
        }
    }

    if !root.touch_menus: PageButton {
        glyph: 1;
        name: @tr("Scroll filters right");
        opacity: root.overflowing && pill_flick.content-x > pill_flick.width - pill_flick.content-width + 0.5px ? 1.0 : 0.0;
        animate opacity { duration: Anim.hover_fast; }
        enabled: root.overflowing && pill_flick.content-x > pill_flick.width - pill_flick.content-width + 0.5px;
        picked => {
            pill_flick.content-x = Math.max(pill_flick.width - pill_flick.content-width, pill_flick.content-x - pill_flick.width);
        }
    }
}

// One row model and action path serve every responsive selector layout.
component StreamList {
    in property <[StreamRow]> rows;
    in property <int> page_start: 0;
    in property <int> kb_focus: -1;
    in property <bool> kb_active;
    in property <bool> touch_menus;
    in property <[SheetItem]> action_items;
    callback picked(int);
    callback action_requested(string);
    callback action_selected(string, int);
    callback focused_row(length, length);
    private property <bool> stagger: Anim.enabled && Anim.transitions;

    VerticalLayout {
        width: 100%;
        min-width: 0px;
        spacing: Theme.card_spacing;
        for st[i] in root.rows: stream_row := Rectangle {
            width: 100%;
            min-width: 0px;
            // Follow the text as it actually wraps at the live width;
            // Slint measures wrapped Text at its intrinsic (single-line)
            // width, so the `st.lines` heuristic alone under-counts on
            // narrow screens and clips. Keep it as a floor for the first
            // paint (before `row_measure` has a width).
            min-height: Math.max(
                (InterfaceStyle.tv ? 112px : 72px),
                max(st.lines * (InterfaceStyle.tv ? 26px : 18px) + 56px,
                    row_measure.preferred-height + 24px),
            );
            property <bool> focused: root.kb_active && root.kb_focus == i + root.page_start;
            changed focused => { if (self.focused) { reveal_t.start(); } }
            changed y => { if (self.focused) { reveal_t.start(); } }
            changed height => { if (self.focused) { reveal_t.start(); } }
            reveal_t := Timer {
                interval: 16ms;
                running: stream_row.focused;
                triggered => {
                    self.stop();
                    if (stream_row.focused) { root.focused_row(stream_row.absolute-position.y, stream_row.height); }
                }
            }
            // Keep each row's layout slot fixed while its contents reveal.
            // In-place progress updates preserve this one-shot state and timer.
            property <bool> item_revealed: false;
            // Latch first visibility when this delegate is constructed. Progress
            // updates mark retained rows false but must not cancel their entrance.
            property <bool> reveal_eligible: st.reveal_new;
            property <bool> reveal_motion: root.stagger && self.reveal_eligible;
            // A moved retained ID may get a new delegate; show it immediately.
            // Rows first shown without motion also stay visible when enabled later.
            init => {
                self.reveal_eligible = st.reveal_new;
                if (!self.reveal_motion) { self.item_revealed = true; }
            }
            changed reveal_motion => { if (!self.reveal_motion) { self.item_revealed = true; } }
            property <duration> item_reveal_delay: Math.min(i, 8) * 24ms;
            item_reveal_t := Timer {
                interval: 16ms;
                running: stream_row.reveal_motion && !stream_row.item_revealed;
                triggered => { stream_row.item_revealed = true; }
            }
            row_reveal := Rectangle {
                width: 100%; height: 100%;
                opacity: !stream_row.reveal_motion || stream_row.item_revealed ? 1.0 : 0.0;
                y: !stream_row.reveal_motion || stream_row.item_revealed ? 0px : 12px;
                animate opacity { duration: stream_row.reveal_motion ? Anim.transition_fade : 0ms; delay: stream_row.reveal_motion ? stream_row.item_reveal_delay : 0ms; easing: ease-out; }
                animate y { duration: stream_row.reveal_motion ? Anim.transition_slide : 0ms; delay: stream_row.reveal_motion ? stream_row.item_reveal_delay : 0ms; easing: ease-out; }
                background: st.is_download || st.last_used || st.recommended ? Theme.current.stream_download : (stream_row.focused ? Theme.current.selection_wash : Theme.current.stream_card);
                border-radius: Theme.card_corner_radius;
                // Black cards need an edge against the black canvas; keyboard
                // focus retains its stronger accent ring in either theme.
                border-width: stream_row.focused ? 2px : (Theme.true_black ? 1px : 0px);
                border-color: stream_row.focused ? Theme.current.focus_ring : Theme.current.border_soft;
                clip: true;

                VerticalLayout {
                    width: 100%;
                    min-width: 0px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    padding-left: 16px;
                    padding-right: 16px;
                    // Explicit so the hidden `row_measure` (same spacing)
                    // matches this layout's content height exactly.
                    spacing: 6px;

                    // Only the addon/quality header reserves the menu's width.
                    // Release titles and details use the full padded card.
                    HorizontalLayout {
                        min-height: InterfaceStyle.tv ? 56px : 40px;
                        spacing: 0px;
                        card_metadata := Text {
                            text: st.metadata;
                            color: Theme.current.text_primary;
                            font-size: InterfaceStyle.tv ? 21px : 16px;
                            font-weight: 700;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            min-width: 0px;
                            horizontal-stretch: 1;
                        }
                        Rectangle { width: 44px; horizontal-stretch: 0; }
                    }

                    if st.last_used || st.recommended: last_used_label := Text {
                        text: st.last_used ? @tr("Last used") : @tr("Recommended");
                        color: Theme.current.accent;
                        font-size: InterfaceStyle.tv ? 18px : 12px;
                        font-weight: 600;
                        wrap: word-wrap;
                        min-width: 0px;
                    }

                    card_title := Text {
                        text: (st.title != "" ? st.title : st.text) + (st.recommended ? " ★" : "");
                        color: Theme.current.text_secondary;
                        font-size: InterfaceStyle.tv ? 18px : 14px;
                        font-weight: 400;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        width: 100%;
                        min-width: 0px;
                    }

                    if st.description != "": card_description := Text {
                        text: st.description;
                        color: Theme.current.text_secondary;
                        font-size: InterfaceStyle.tv ? 18px : 14px;
                        wrap: word-wrap;
                        width: 100%;
                        min-width: 0px;
                    }

                    if st.details != "": Text {
                        text: st.details;
                        color: Theme.current.text_secondary;
                        font-size: InterfaceStyle.tv ? 18px : 12px;
                        wrap: word-wrap;
                        width: 100%;
                        min-width: 0px;
                    }

                    pill_row := HorizontalLayout {
                        visible: !st.external_link;
                        height: st.external_link ? 0px : 26px;
                        spacing: 0px;
                        size_pill := Rectangle {
                            width: Math.min(pill_row.width, size_label.preferred-width + 20px);
                            height: 26px;
                            horizontal-stretch: 0;
                            border-radius: 13px;
                            background: Theme.current.control_hover;
                            border-width: 1px;
                            border-color: Theme.current.border_soft;
                            size_label := Text {
                                x: 10px; y: 0px;
                                width: parent.width - 20px; height: 100%;
                                text: st.size != "" ? @tr("SIZE {}", st.size) : @tr("SIZE UNKNOWN");
                                color: Theme.current.text_secondary;
                                font-size: InterfaceStyle.tv ? 18px : 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    // Progress rail, anchored to the left edge (`x: 0`, like
                    // the other rails in the app) so it fills left → right.
                    // Hidden once the file is complete: the row reads
                    // "Downloaded" and an empty rail there is just noise.
                    if st.is_download && st.download_action != 4: dl_bar := Rectangle {
                        x: 0;
                        width: 100%;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.current.download_track;

                        dl_fill := Rectangle {
                            x: 0;
                            width: parent.width * st.download_progress;
                            height: 100%;
                            border-radius: 2px;
                            background: Theme.current.accent;
                        }
                    }
                }

                // Hidden measurement copy of the text stack at the padded
                // content width (16px on either side), so
                // the row minimum above tracks real wrapping instead of the
                // intrinsic one-line width.
                mrow := Rectangle {
                    width: 100%;
                    height: 0;
                    clip: true;

                    row_measure := VerticalLayout {
                        width: Math.max(0px, mrow.width - 32px);
                        spacing: 6px;

                        HorizontalLayout {
                            min-height: InterfaceStyle.tv ? 56px : 40px;
                            spacing: 0px;
                            Text {
                                text: st.metadata;
                                font-size: InterfaceStyle.tv ? 21px : 16px;
                                font-weight: 700;
                                wrap: word-wrap;
                                min-width: 0px;
                                horizontal-stretch: 1;
                            }
                            Rectangle { width: 44px; horizontal-stretch: 0; }
                        }

                        if st.last_used || st.recommended: Text {
                            text: st.last_used ? @tr("Last used") : @tr("Recommended");
                            font-size: InterfaceStyle.tv ? 18px : 12px;
                            font-weight: 600;
                            wrap: word-wrap;
                            min-width: 0px;
                        }

                        Text {
                            text: (st.title != "" ? st.title : st.text) + (st.recommended ? " ★" : "");
                            font-size: InterfaceStyle.tv ? 18px : 14px;
                            font-weight: 400;
                            wrap: word-wrap;
                            min-width: 0px;
                        }

                        if st.description != "": Text {
                            text: st.description;
                            font-size: InterfaceStyle.tv ? 18px : 14px;
                            wrap: word-wrap;
                            min-width: 0px;
                        }

                        if st.details != "": Text {
                            text: st.details;
                            font-size: InterfaceStyle.tv ? 18px : 12px;
                            wrap: word-wrap;
                            min-width: 0px;
                        }

                        if !st.external_link: Rectangle { height: 26px; }
                        if st.is_download && st.download_action != 4: Rectangle { height: 4px; }
                    }
                }

                // Populate the backend-owned actions before explicitly showing
                // the desktop popup; a ContextMenuArea's automatic right-click
                // would otherwise open before this row's actions are prepared.
                stream_ctx := ContextMenuArea {
                    x: 0px; y: 0px;
                    width: 0px; height: 0px;
                    Menu {
                        for action[a] in root.action_items: MenuItem {
                            title: action.label;
                            enabled: action.enabled;
                            activated => { root.action_selected(st.id, a); }
                        }
                    }
                }

                touch_st := TouchArea {
                    property <bool> lp_suppress: false;
                    width: 100%;
                    height: 100%;
                    accessible-role: button;
                    accessible-label: st.text + (st.recommended ? " — " + @tr("Recommended") : "");
                    mouse-cursor: pointer;
                    clicked => {
                        if (touch_st.lp_suppress) {
                            touch_st.lp_suppress = false;
                        } else {
                            root.picked(i + root.page_start);
                        }
                    }
                    pointer-event(ev) => {
                        if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                            row_lp_timer.stop();
                            touch_st.lp_suppress = true;
                            if (RemoteBridge.target_id == "" || PartyBridge.active) {
                                root.action_requested(st.id);
                                if (!root.touch_menus) { stream_ctx.show({ x: self.mouse-x, y: self.mouse-y }); }
                            }
                        } else if (ev.kind == PointerEventKind.down) {
                            touch_st.lp_suppress = false;
                            if (root.touch_menus && (RemoteBridge.target_id == "" || PartyBridge.active)) {
                                row_lp_timer.stop();
                                row_lp_timer.start();
                            }
                        } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                            row_lp_timer.stop();
                        }
                    }
                    moved => {
                        if (Math.abs(touch_st.mouse-x - touch_st.pressed-x)
                            + Math.abs(touch_st.mouse-y - touch_st.pressed-y) > 24px) {
                            row_lp_timer.stop();
                        }
                    }
                }

                stream_actions := Rectangle {
                    // Receiver offers never invoke the controller's download actions.
                    visible: (RemoteBridge.target_id == "" || PartyBridge.active);
                    x: parent.width - 52px;
                    y: 8px;
                    width: 44px; height: 44px;
                    border-radius: 10px;
                    background: (root.touch_menus ? action_touch.pressed : action_touch.has-hover) ? Theme.current.hover_overlay : transparent;
                    accessible-role: button;
                    accessible-label: @tr("Stream actions");
                    IcMoreHoriz {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 20px; height: 20px;
                        fill: Theme.current.text_secondary;
                    }
                    action_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.action_requested(st.id);
                            if (!root.touch_menus) { stream_ctx.show({ x: stream_actions.x, y: stream_actions.y + stream_actions.height }); }
                        }
                    }
                }

                row_lp_timer := Timer {
                    interval: 600ms;
                    running: false;
                    triggered => {
                        self.stop();
                        touch_st.lp_suppress = true;
                        root.action_requested(st.id);
                    }
                }
            }
        }

    }
}

component SelectorIconButton inherits Rectangle {
    in property <bool> focused;
    callback picked();
    width: 44px; height: 44px;
    border-radius: 22px;
    background: touch.has-hover ? Theme.current.hero_control_hover : Theme.current.hero_control;
    border-width: root.focused ? 2px : 1px;
    border-color: root.focused ? Theme.current.focus_ring : Theme.current.border_strong;
    accessible-role: button;
    accessible-label: @tr("Back");
    IcChevronLeft {
        x: 12px; y: 12px; width: 20px; height: 20px;
        fill: Theme.current.text_primary;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.picked(); } }
}

// The three designs share live data and one focus scope. Resizing only changes
// geometry, so active downloads, addon filters and the current page survive.
export component StreamSelector inherits Rectangle {
    // Factory initialization cannot change the adapter focus. The parent
    // requests this stable target only after the subtree is published.
    public function focus_shell() { selector_scope.focus(); }
    in property <string> title;
    in property <bool> is_movie;
    in property <string> year;
    in property <bool> selection_mode: false;
    callback retry_requested();
    in property <string> episode_context;
    in property <string> episode_number;
    in property <string> episode_title;
    in property <image> poster;
    in property <image> backdrop;
    in property <[StreamRow]> rows;
    in property <string> hint;
    in property <[string]> addons;
    in property <[bool]> loading;
    in property <bool> searching;
    in property <int> addon_filter;
    in property <int> page;
    in property <int> page_count;
    in property <int> page_start;
    in property <int> total;
    in property <bool> touch_menus;
    in property <length> safe-top;
    in property <length> safe-left;
    in property <length> safe-right;
    in property <length> safe-bottom;
    in-out property <int> kb_index;
    in-out property <bool> kb_active;
    function tv_context() -> bool {
        let index = root.kb_index - root.page_start;
        if (root.focus_zone == 2 && index >= 0 && index < root.rows.length) {
            root.action_requested(root.rows[index].id);
            return true;
        }
        return false;
    }
    private property <int> output_open_request: 0;
    function tv_activate() {
        if (root.focus_zone == 0) { root.request_back(); }
        else if root.focus_zone == 5 { StreamFiltersBridge.opened(); }
        else if (root.focus_zone == 4 && root.has_output_choice) { root.output_open_request += 1; }
        else if (root.focus_zone == 2 && root.kb_index >= 0 && root.kb_index < root.total) {
            if (RemoteBridge.target_id != "" && !PartyBridge.active) { RemoteBridge.stream_picked(root.kb_index); }
            else { root.picked(root.kb_index); }
        }
    }

    // Remotes send repeated Return presses while OK is held. Delay the primary
    // action until release so opening a context menu never also starts playback.
    private property <bool> tv_ok_pending: false;
    private property <bool> tv_ok_held: false;
    tv_ok_hold := Timer {
        interval: 650ms;
        running: false;
        triggered => { self.stop(); root.tv_ok_held = root.tv_context(); }
    }

    in-out property <bool> action_open;
    in property <string> action_title;
    in property <string> action_id;
    in property <[SheetItem]> action_items;
    callback back();
    callback picked(int);
    callback page_picked(int);
    callback filter_picked(int);
    callback action_requested(string);
    callback action_selected(string, int);

    width: 100%; height: 100%;
    background: Theme.current.artwork_canvas;
    // The conditional Detail host is shared by Home shortcuts and manual
    // picks. Defer the reveal until a frame has established its start values;
    // data updates and resizing keep this instance, so they never replay it.
    private property <bool> entered: false;
    private property <bool> entrance_motion: Anim.enabled && Anim.transitions;
    init => {
        if (!root.entrance_motion) { root.entered = true; }
        if StreamFiltersBridge.open { root.filters_mounted = true; }
    }
    changed entrance_motion => { if (!root.entrance_motion) { root.entered = true; } }
    x: root.entered || !root.entrance_motion ? 0px : Math.min(48px, root.width * 0.08);
    opacity: root.entered || !root.entrance_motion ? 1.0 : 0.0;
    animate x { duration: Anim.transition_slide; easing: ease-out; }
    animate opacity { duration: Anim.transition_fade; easing: ease-out; }
    entrance_t := Timer {
        interval: 16ms;
        running: !root.entered;
        triggered => { root.entered = true; }
    }
    private property <length> usable_height: root.height - root.safe-top - root.safe-bottom;
    private property <bool> short: !InterfaceStyle.tv && root.usable_height < 600px;
    // Touch landscape needs the whole screen for sources after its context
    // scrolls away. Short desktop windows retain their fixed context layout.
    out property <bool> scrolling_landscape: !InterfaceStyle.tv && root.touch_menus && root.usable_width > root.usable_height && root.short;
    changed scrolling_landscape => { landscape_scroll.content-y = 0px; result_scroll.content-y = 0px; }
    private property <length> usable_width: root.width - root.safe-left - root.safe-right;
    out property <bool> narrow: !InterfaceStyle.tv && root.usable_width < 700px;
    // Short landscape windows need all of their width for wrapped filenames.
    out property <bool> artwork_layout: root.usable_width >= 1200px && !root.short;
    private property <length> margin: root.narrow ? 16px : 32px;
    private property <length> artwork_width: root.artwork_layout ? root.usable_width * 0.34 : 0px;
    private property <length> header_height: root.safe-top + (root.short ? (root.episode_header ? 100px : 80px) : (root.narrow ? (root.episode_header ? 200px : 168px) : (root.episode_header ? 156px : 128px)));
    private property <string> context: root.episode_context != "" ? root.episode_context : (root.is_movie ? (root.year != "" ? @tr("{} · Movie", root.year) : @tr("Movie")) : root.year);
    private property <bool> episode_header: !root.is_movie && root.episode_context != "";
    private property <string> main_title: root.episode_header ? (root.episode_title != "" ? root.episode_title : (root.episode_number != "" ? root.title : root.episode_context)) : root.title;
    // Zones: back, addon filters, stream rows, pager, TV output choice. Stream indexes are
    // absolute across the Rust-provided 25-row slices.
    private property <int> focus_zone: 2;
    private property <bool> has_output_choice: !PartyBridge.active && (RemoteBridge.has_ready_devices || RemoteBridge.target_id != "");

    changed has_output_choice => { if (!root.has_output_choice && root.focus_zone == 4) { root.focus_zone = 2; } }

    function request_back() {
        if SettingsSync.open { SettingsSync.open = false; }
        else if StreamFiltersBridge.open { StreamFiltersBridge.closed(); selector_scope.focus(); }
        else if (root.action_open) { root.action_open = false; }
        else { root.back(); }
    }
    function move_page(delta: int) {
        let next = Math.max(0, Math.min(root.page_count - 1, root.page + delta));
        if (next != root.page) {
            root.kb_index = next * 25;
            root.page_picked(next);
            root.reset_scroll();
        }
    }
    function pick_filter(index: int) {
        root.kb_index = 0;
        root.filter_picked(Math.max(0, Math.min(root.addons.length, index)));
        root.reset_scroll();
    }
    function focus_stream(index: int) {
        root.kb_index = Math.max(0, Math.min(root.total - 1, index));
        let page = Math.floor(root.kb_index / 25);
        if (root.total > 0 && page != root.page) { root.page_picked(page); }
    }
    function reset_scroll() {
        result_scroll.content-y = 0px;
        landscape_scroll.content-y = 0px;
    }
    function reveal_row(y: length, h: length) {
        if root.scrolling_landscape {
            let top = root.safe-top + (root.addons.length > 0 ? 48px : 0px);
            let bottom = root.height - root.safe-bottom;
            let min_y = Math.min(0px, landscape_scroll.height - landscape_scroll.content-height);
            if y < top { landscape_scroll.content-y = Math.min(0px, landscape_scroll.content-y + top - y); }
            else if y + h > bottom {
                let shift = h > bottom - top ? y - top : y + h - bottom;
                landscape_scroll.content-y = Math.max(min_y, landscape_scroll.content-y - shift);
            }
            return;
        }
        let relative = y - result_scroll.absolute-position.y;
        let min_y = Math.min(0px, result_scroll.height - result_scroll.content-height);
        // A very tall row starts at the viewport's top; shorter rows fit in
        // full. This uses actual text geometry rather than a fixed row stride.
        if (relative < 0px) {
            result_scroll.content-y = Math.min(0px, result_scroll.content-y - relative);
        } else if (relative + h > result_scroll.height) {
            let shift = h > result_scroll.height ? relative : relative + h - result_scroll.height;
            result_scroll.content-y = Math.max(min_y, result_scroll.content-y - shift);
        }
    }
    changed page => { root.reset_scroll(); }
    changed total => { root.kb_index = Math.max(0, Math.min(root.kb_index, root.total - 1)); }
    changed action_open => { if (!root.action_open) { selector_scope.focus(); } }

    // Blank/disabled-control taps keep focus in this screen. Otherwise the
    // ancestor system-Back scope takes it, and a floating FocusScope can eat
    // the following press merely to restore focus before the button sees it.
    TouchArea {
        width: 100%; height: 100%;
        clicked => { root.kb_active = false; selector_scope.focus(); }
    }

    // One outer viewport handles touch landscape; the result viewport remains
    // the sole vertical scroller in portrait and on desktop.
    landscape_scroll := Flickable {
        x: 0px; y: 0px; width: 100%; height: 100%;
        interactive: root.scrolling_landscape;
        content-width: self.width;
        content-height: root.scrolling_landscape ? root.header_height + selector_body.preferred-height + root.safe-bottom + 12px : self.height;
        landscape_content := Rectangle {
            x: 0px; y: 0px; width: landscape_scroll.width; height: landscape_scroll.content-height;
            if root.poster.width > 0 || root.backdrop.width > 0: artwork := Rectangle {
                x: root.safe-left;
                // Slint centers the shorter phone/compact layer unless anchored.
                // It must fade from the top header, not appear behind stream rows.
                y: 0px;
                width: root.artwork_layout ? root.artwork_width + 80px : root.usable_width;
                height: root.artwork_layout ? root.height : root.header_height + 80px;
                clip: true;
                Image {
                    x: 0px; y: 0px;
                    width: 100%; height: 100%;
                    source: root.backdrop.width > 0 ? root.backdrop : root.poster;
                    image-fit: cover;
                    opacity: root.artwork_layout ? 0.65 : 0.35;
                }
                Image {
                    x: 0px; y: 0px;
                    width: 100%; height: 100%;
                    source: Theme.true_black ? @image-url("../../assets/detail-bottom-scrim-black.svg") : @image-url("../../assets/detail-bottom-scrim.svg");
                    image-fit: fill;
                }
                if root.artwork_layout: Rectangle {
                    x: parent.width - self.width;
                    width: 180px; height: 100%;
                    background: @linear-gradient(90deg, transparent, Theme.current.artwork_canvas);
                }
            }

            if root.artwork_layout: artwork_context := VerticalLayout {
                x: root.safe-left + root.margin;
                y: root.safe-top + 80px;
                width: root.artwork_width - 2 * root.margin;
                height: root.height - root.safe-top - root.safe-bottom - 112px;
                spacing: 12px;
                Rectangle { vertical-stretch: 1; background: transparent; }
                if root.episode_header && root.episode_number != "": Text {
                    text: root.episode_number;
                    color: Theme.current.text_bright;
                    font-size: InterfaceStyle.tv ? 21px : 16px; font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: root.main_title;
                    color: Theme.current.text_bright;
                    font-size: 34px; font-weight: 700;
                    wrap: word-wrap; max-lines: 3; overflow: elide;
                }
                if root.episode_header && (root.episode_title != "" || root.episode_number == ""): Text {
                    text: root.title;
                    color: Theme.current.text_secondary;
                    font-size: InterfaceStyle.tv ? 23px : 18px;
                    wrap: word-wrap; max-lines: 2; overflow: elide;
                }
                if !root.episode_header: Text {
                    text: root.context;
                    color: Theme.current.text_secondary;
                    font-size: InterfaceStyle.tv ? 21px : 16px;
                    wrap: word-wrap; max-lines: 3; overflow: elide;
                }
                Text {
                    text: @tr("Select a source to start watching.");
                    color: Theme.current.text_muted;
                    font-size: InterfaceStyle.tv ? 18px : 14px;
                    wrap: word-wrap;
                }
            }

            if !root.artwork_layout: compact_context := HorizontalLayout {
                // Short phones share the compact header row so status/error feedback
                // can remain visible without consuming the stream viewport.
                x: root.safe-left + root.margin + (root.narrow && !root.short ? 0px : 60px);
                y: root.short ? back_button.y : root.safe-top + (root.narrow ? 64px : 20px);
                width: root.usable_width - 2 * root.margin - (root.narrow && !root.short ? 0px : 60px);
                height: root.short ? (root.episode_header ? 76px : 48px) : (root.narrow ? (root.episode_header ? 120px : 88px) : (root.episode_header ? 124px : 96px));
                spacing: 16px;
                cross-axis-alignment: center;
                if root.poster.width > 0 && (!root.narrow || !root.short): compact_poster := Rectangle {
                    width: root.short ? 32px : (root.narrow ? 58px : 64px);
                    height: self.width * 3 / 2;
                    horizontal-stretch: 0;
                    vertical-stretch: 0;
                    border-radius: Theme.card_corner_radius;
                    clip: true;
                    Image { width: 100%; height: 100%; source: root.poster; image-fit: cover; }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: root.short ? 3px : 4px;
                    min-width: 0px;
                    if root.episode_header && root.episode_number != "": compact_episode_number := Text {
                        text: root.episode_number;
                        color: Theme.current.text_bright;
                        font-size: root.short ? 12px : 14px;
                        font-weight: 600;
                        overflow: elide; min-width: 0px;
                    }
                    compact_main_title := Text {
                        text: root.main_title;
                        color: Theme.current.text_bright;
                        font-size: InterfaceStyle.tv ? 36px : (root.short ? 22px : (root.narrow ? 24px : 28px));
                        font-weight: 700;
                        wrap: word-wrap; max-lines: root.short ? 1 : 2; overflow: elide;
                        min-width: 0px;
                    }
                    if root.episode_header && (root.episode_title != "" || root.episode_number == ""): compact_series_title := Text {
                        text: root.title;
                        color: Theme.current.text_secondary;
                        font-size: root.short ? 12px : 14px;
                        overflow: elide; min-width: 0px;
                    }
                    if !root.episode_header: Text {
                        text: root.context;
                        color: Theme.current.text_secondary;
                        font-size: InterfaceStyle.tv ? 18px : 13px;
                        wrap: word-wrap; max-lines: root.short ? 1 : 2; overflow: elide;
                        min-width: 0px;
                    }
                }
            }

            back_button := SelectorIconButton {
                x: root.safe-left + root.margin;
                y: root.safe-top + (root.narrow ? 12px : 20px);
                focused: root.kb_active && root.focus_zone == 0;
                picked => { root.kb_active = false; root.request_back(); }
            }

            selector_body := VerticalLayout {
                x: root.safe-left + root.artwork_width + root.margin;
                y: root.artwork_layout ? root.safe-top + 24px : root.header_height;
                width: root.usable_width - root.artwork_width - 2 * root.margin;
                height: root.scrolling_landscape ? self.preferred-height : root.height - self.y - root.safe-bottom - 12px;
                min-width: 0px;
                spacing: root.short ? 8px : (root.narrow ? 12px : 16px);
                stream_heading := HorizontalLayout {
                    height: InterfaceStyle.tv ? 56px : (root.short ? 44px : 40px);
                    spacing: 8px;
                    heading_title := Text {
                        text: @tr("Choose a stream");
                        color: Theme.current.text_bright;
                        font-size: InterfaceStyle.tv ? 32px : (root.narrow ? 20px : 26px); font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide; min-width: 0px; horizontal-stretch: 1;
                    }
                    stream_count := Text {
                        text: @tr("{n} stream" | "{n} streams" % root.total);
                        color: Theme.current.text_muted;
                        font-size: InterfaceStyle.tv ? 18px : 13px; vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                    // Short windows keep their results viewport usable by
                    // sharing the heading lane instead of reserving another row.
                    if root.short && (RemoteBridge.target_id == "" || PartyBridge.active): compact_rules := Rectangle {
                        width: 44px; height: 44px; border-radius: 12px;
                        background: StreamFiltersBridge.enabled ? Theme.current.primary_button
                            : compact_rules_touch.has-hover ? Theme.current.hero_control_hover : Theme.current.hero_control;
                        border-width: root.kb_active && root.focus_zone == 5 ? 2px : 1px;
                        border-color: root.kb_active && root.focus_zone == 5 ? Theme.current.focus_ring
                            : StreamFiltersBridge.enabled ? Theme.current.accent : Theme.current.border_strong;
                        accessible-role: button; accessible-label: @tr("Universal filters");
                        accessible-description: @tr("Universal stream filters");
                        accessible-action-default => { StreamFiltersBridge.opened(); }
                        IcSettingsGear {
                            x: 10px; y: 10px; width: 24px; height: 24px;
                            fill: StreamFiltersBridge.enabled ? Theme.current.on_accent : Theme.current.accent_soft;
                        }
                        compact_rules_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.kb_active = false; StreamFiltersBridge.opened(); }
                        }
                    }
                    if root.has_output_choice: output_picker := RemoteTargetMenu {
                        property <int> open_request: root.output_open_request;
                        changed open_request => { self.open_menu(); }
                        focused: InterfaceStyle.tv && root.kb_active && root.focus_zone == 4;
                        dismissed => { if (InterfaceStyle.tv) { selector_scope.focus(); } }
                        // Fill the fixed heading lane so the smaller button can center in it.
                        height: stream_heading.height;
                        popup-height: root.height - selector_body.y - 44px - root.safe-bottom;
                    }
                    if root.page_count > 1 && !root.narrow && !root.scrolling_landscape: top_pager := EpisodePager {
                        page: root.page; count: root.page_count;
                        picked(p) => { root.kb_active = false; root.move_page(p - root.page); }
                    }
                }
                if !root.short && (RemoteBridge.target_id == "" || PartyBridge.active): HorizontalLayout {
                    spacing: 8px;
                    PillButton {
                        label: @tr("Universal filters"); primary: StreamFiltersBridge.enabled;
                        roomy: true; compact: true; focused: root.kb_active && root.focus_zone == 5;
                        clicked => { StreamFiltersBridge.opened(); }
                    }
                    if StreamFiltersBridge.enabled: PillButton {
                        label: @tr("Clear"); roomy: true; compact: true;
                        clicked => { StreamFiltersBridge.reset(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                // Reserve the same slot while the independent horizontal bar floats
                // above this viewport and becomes sticky in touch landscape.
                filter_slot := Rectangle { visible: root.addons.length > 0; height: root.addons.length > 0 ? (InterfaceStyle.tv ? 56px : 40px) : 0px; vertical-stretch: 0; }
                if root.rows.length > 0 && root.hint != "": Text {
                    text: root.hint;
                    font-size: InterfaceStyle.tv ? 18px : 13px; color: Theme.current.text_muted;
                    wrap: word-wrap; max-lines: root.short && !root.scrolling_landscape ? 1 : 0; overflow: elide; min-width: 0px;
                }
                if root.selection_mode: HorizontalLayout {
                    vertical-stretch: 0; alignment: end;
                    PillButton { label: @tr("Retry streams"); enabled: !root.searching; clicked => { root.retry_requested(); } }
                }
                result_scroll := Flickable {
                    vertical-stretch: root.scrolling_landscape ? 0 : 1;
                    preferred-height: root.scrolling_landscape ? (root.rows.length > 0 ? stream_list.preferred-height : 160px) : 0px;
                    interactive: !root.scrolling_landscape;
                    min-height: 0px;
                    min-width: 0px;
                    content-width: self.width;
                    content-height: root.rows.length > 0 ? stream_list.preferred-height : self.height;
                    stream_list := StreamList {
                        width: result_scroll.width;
                        rows: root.rows; page_start: root.page_start;
                        kb_focus: root.kb_index;
                        kb_active: root.kb_active && root.focus_zone == 2;
                        touch_menus: root.touch_menus;
                        action_items: root.action_items;
                        picked(i) => { root.kb_active = false; root.kb_index = i; if (RemoteBridge.target_id != "" && !PartyBridge.active) { RemoteBridge.stream_picked(i); } else { root.picked(i); } }
                        action_requested(id) => {
                            root.action_requested(id);
                            // Pointer actions on desktop TV retain the native popup.
                            // Remote Menu/held OK call the page callback directly.
                            if (InterfaceStyle.tv && !root.touch_menus) { root.action_open = false; }
                        }
                        action_selected(id, a) => { root.action_selected(id, a); }
                        focused_row(y, h) => { root.reveal_row(y, h); }
                    }
                    if root.rows.length == 0: VerticalLayout {
                        width: result_scroll.width;
                        height: result_scroll.height;
                        alignment: center;
                        spacing: 16px;
                        if root.searching: HorizontalLayout {
                            alignment: center;
                            Spinner { width: 24px; height: 24px; }
                        }
                        Text {
                            text: root.hint != "" ? root.hint : (root.searching ? @tr("Loading streams…") : @tr("No streams found."));
                            color: Theme.current.text_muted;
                            font-size: InterfaceStyle.tv ? 20px : 15px; wrap: word-wrap;
                            horizontal-alignment: center;
                            min-width: 0px;
                        }
                    }
                }
                if root.page_count > 1 || (!root.touch_menus && !root.narrow && !root.short): HorizontalLayout {
                    height: 44px;
                    spacing: 12px;
                    if !root.touch_menus && !root.narrow && !root.short: Text {
                        text: root.selection_mode ? @tr("↑ ↓ Navigate    Enter Select    Esc Cancel") : (root.kb_index >= root.page_start && root.kb_index < root.page_start + root.rows.length && root.rows[root.kb_index - root.page_start].external_link ? @tr("↑ ↓ Navigate    Enter Open    Esc Back") : @tr("↑ ↓ Navigate    Enter Play    Esc Back"));
                        color: Theme.current.text_hint;
                        font-size: InterfaceStyle.tv ? 18px : 12px; vertical-alignment: center;
                        overflow: elide; min-width: 0px;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    if root.page_count > 1: bottom_pager := EpisodePager {
                        episode-style: true;
                        page: root.page; count: root.page_count;
                        picked(p) => { root.kb_active = false; root.move_page(p - root.page); }
                        border-width: root.kb_active && root.focus_zone == 3 ? 2px : 0px;
                        border-color: Theme.current.focus_ring;
                        border-radius: 8px;
                    }
                }
            }

        }
    }
    private property <length> filter_screen_y: filter_slot.absolute-position.y - root.absolute-position.y;
    private property <bool> filters_pinned: root.scrolling_landscape && root.addons.length > 0 && root.filter_screen_y <= root.safe-top;
    // Once pinned, cover the full viewport width and top safe area. Painting
    // only the pill-sized rectangle leaves scrolling artwork/cards exposed
    // above the row and beside the horizontally scrollable filter rail.
    if root.filters_pinned: sticky_backdrop := Rectangle {
        x: 0px; y: 0px; width: 100%; height: root.safe-top + 40px;
        background: Theme.current.artwork_canvas;
        // Hidden stream rows must not receive taps through the opaque cover.
        TouchArea { width: 100%; height: 100%; clicked => { } }
    }
    // Match Discover's short transition where cards slide under the cover.
    if root.filters_pinned: sticky_header_fade := Rectangle {
        x: 0px; y: root.safe-top + 40px; width: 100%; height: 8px;
        background: @linear-gradient(180deg, Theme.current.artwork_canvas, transparent);
    }
    if root.addons.length > 0: sticky_filters := Rectangle {
        x: selector_body.absolute-position.x - root.absolute-position.x;
        y: root.scrolling_landscape ? Math.max(root.safe-top, root.filter_screen_y) : root.filter_screen_y;
        width: selector_body.width; height: InterfaceStyle.tv ? 56px : 40px;
        background: root.scrolling_landscape ? Theme.current.artwork_canvas : transparent;
        StreamFilterBar {
            x: 0px; y: 0px; width: 100%; height: 100%;
            addons: root.addons; loading: root.loading;
            searching: root.searching; addon_filter: root.addon_filter;
            touch_menus: root.touch_menus || root.narrow;
            touch_feedback: root.touch_menus;
            kb_active: root.kb_active && root.focus_zone == 1;
            filter_picked(i) => { root.kb_active = false; root.pick_filter(i); }
        }
    }

    // AppWindow restores the selector scope after factory publication. A local
    // delayed reset could interrupt an action sheet that already owns focus.

    selector_scope := FocusScope {
        width: 100%; height: 100%;
        focus-on-click: false;
        init => { self.focus(); }
        key-released(e) => {
                if (InterfaceStyle.tv && e.text == Key.Return && root.tv_ok_pending) {
                    tv_ok_hold.stop();
                    root.tv_ok_pending = false;
                    if (!root.tv_ok_held) { root.tv_activate(); }
                    accept
                } else { reject }
            }
            key-pressed(e) => {
                if (RemoteBridge.target_id == "" || PartyBridge.active) && (e.text == "f" || e.text == "F") {
                    if !e.repeat { StreamFiltersBridge.opened(); } accept
                } else if (RemoteBridge.target_id == "" || PartyBridge.active) && e.text == Key.Tab {
                    root.kb_active = true; root.focus_zone = root.focus_zone == 5 ? 2 : 5; accept
                } else if (InterfaceStyle.tv && e.text == Key.Return) {
                    root.kb_active = true;
                    if (!e.repeat) { root.tv_ok_pending = true; root.tv_ok_held = false; tv_ok_hold.stop(); tv_ok_hold.start(); }
                    accept
                } else if (InterfaceStyle.tv && (e.text == Key.Menu || (e.text == Key.F10 && e.modifiers.shift))) {
                    root.kb_active = true;
                    if (!e.repeat) { root.tv_context(); }
                    accept
                } else if (e.text == Key.Back && e.repeat) {
                accept
            } else if (e.text == Key.Back || e.text == Key.Escape || e.text == Key.Backspace) {
                root.kb_active = true;
                root.request_back();
                accept
            } else if (root.action_open) {
                reject
            } else if (e.text == Key.DownArrow) {
                root.kb_active = true;
                if (InterfaceStyle.tv && root.focus_zone == 0 && root.has_output_choice) { root.focus_zone = 4; }
                else if (InterfaceStyle.tv && root.focus_zone == 4) { root.focus_zone = root.addons.length > 0 ? 1 : 2; }
                else if (root.focus_zone < 2) { root.focus_zone += root.addons.length == 0 ? 2 : 1; }
                else if (root.focus_zone == 2 && root.kb_index + 1 < root.total) { root.focus_stream(root.kb_index + 1); }
                else if (root.page_count > 1) { root.focus_zone = 3; }
                accept
            } else if (e.text == Key.UpArrow) {
                root.kb_active = true;
                if (InterfaceStyle.tv && root.focus_zone == 4) { root.focus_zone = 0; }
                else if (InterfaceStyle.tv && root.has_output_choice && (root.focus_zone == 1 || (root.focus_zone == 2 && root.kb_index == 0 && root.addons.length == 0))) { root.focus_zone = 4; }
                else if (root.focus_zone == 2 && root.kb_index > 0) { root.focus_stream(root.kb_index - 1); }
                else if (root.focus_zone > 0) { root.focus_zone -= root.focus_zone == 2 && root.addons.length == 0 ? 2 : 1; }
                accept
            } else if (e.text == Key.PageUp || e.text == Key.PageDown) {
                root.kb_active = true;
                root.move_page(e.text == Key.PageUp ? -1 : 1);
                root.focus_zone = 2;
                accept
            } else if (e.text == Key.LeftArrow || e.text == Key.RightArrow) {
                root.kb_active = true;
                let delta = e.text == Key.LeftArrow ? -1 : 1;
                if (root.focus_zone == 0 && e.text == Key.RightArrow && (RemoteBridge.target_id == "" || PartyBridge.active)) { root.focus_zone = 5; }
                else if root.focus_zone == 5 { root.focus_zone = 0; }
                else if (root.focus_zone == 1) { root.pick_filter(root.addon_filter + delta); }
                else if (root.focus_zone > 1 && root.focus_zone != 4) { root.move_page(delta); }
                accept
            } else if (e.text == Key.Return || e.text == " ") {
                root.kb_active = true;
                if root.focus_zone == 5 { StreamFiltersBridge.opened(); }
                else if (root.focus_zone == 0) {
                    root.request_back();
                } else if (root.focus_zone == 2 && root.kb_index >= 0 && root.kb_index < root.total) { if (RemoteBridge.target_id != "" && !PartyBridge.active) { RemoteBridge.stream_picked(root.kb_index); } else { root.picked(root.kb_index); } }
                accept
            } else { reject }
        }
    }

    // The closed preferences form includes an editor and sync comparison
    // dialog. Do not construct/layout that unused tree on selector entry.
    // Once requested, retain it for its exit animation and normal reopen state.
    private property <bool> filters_requested: StreamFiltersBridge.open;
    private property <bool> filters_mounted: false;
    changed filters_requested => { if root.filters_requested { root.filters_mounted = true; } }
    if root.filters_requested || root.filters_mounted: StreamFilterPanel {
        width: 100%; height: 100%;
        safe-top: root.safe-top; safe-bottom: root.safe-bottom;
        safe-left: root.safe-left; safe-right: root.safe-right;
        closed => { selector_scope.focus(); }
    }

    MenuSheet {
        open: (root.touch_menus || InterfaceStyle.tv) && root.action_open;
        width: 100%; height: 100%;
        safe-bottom: root.safe-bottom; safe-left: root.safe-left; safe-right: root.safe-right;
        max_h: root.height * 0.85;
        sheet_title: root.action_title;
        items: root.action_items;
        picked(a) => { root.action_open = false; root.action_selected(root.action_id, a); }
        closed => { root.action_open = false; selector_scope.focus(); }
    }
}
