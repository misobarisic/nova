import { MenuSheet } from "menusheet.slint";
// The manual statuses, then back to automatic, each with an icon in the
// Reader title-menu style. `current_status` shows under the title.
export component StatusMenu inherits MenuSheet {
    in property <string> current_status;
    keyboard_navigation: true;
    sheet_title: @tr("Change status");
    sheet_subtitle: root.current_status;
    items: [
        { label: @tr("Mark as watching"), enabled: true },
        { label: @tr("Mark as Plan to Watch"), enabled: true },
        { label: @tr("Mark as completed"), enabled: true },
        { label: @tr("Mark as new episodes"), enabled: true },
        { label: @tr("Mark on hold"), enabled: true },
        { label: @tr("Mark dropped"), enabled: true },
        { label: @tr("Back to automatic"), enabled: true },
    ];
    item_icons: [
        "M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12zM12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z",
        "M6 3h12v18l-6-4-6 4z",
        "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM8 12l3 3 5-6",
        "M6 16v-5a6 6 0 0 1 12 0v5l2 2H4zM10 21h4",
        "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM10 9v6M14 9v6",
        "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM9 9l6 6M15 9l-6 6",
        "M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7",
    ];
    private property <[int]> codes: [6, 5, 7, 8, 1, 2, 0];
    callback status-picked(int);
    picked(index) => { root.status-picked(root.codes[index]); }
}
