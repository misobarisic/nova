import { CastBridge, SettingsBridge, SettingsContent } from "@NovaUiShared";

export struct SettingsSearchTarget {
    key: string,
    title: string,
    terms: string,
    zone: int,
    row: int,
}

// Only advertise precise destinations that have a mounted reveal anchor and a
// keyboard row. The broader section keywords remain useful fallback results.
// Keep availability in step with the leaf: searching must never change a
// backend, encoder, or another saved preference just to make a control exist.
export global SettingsSearch {
    pure function candidate(key: string, title: string, terms: string, zone: int, row: int) -> SettingsSearchTarget {
        return { key: key, title: title, terms: terms, zone: zone, row: row };
    }
    pure function matches(target: SettingsSearchTarget) -> bool {
        return SettingsBridge.search_matches(SettingsBridge.search_query, target.title + " " + target.terms);
    }

    public pure function target(section: int) -> SettingsSearchTarget {
        if SettingsBridge.search_query != "" && !SettingsBridge.search_matches(SettingsBridge.search_query, "") {
            if section == 5 {
                let player = self.candidate("player_external", @tr("Player"), @tr("Built-in") + " " + @tr("External") + " Player choice Built-in External mpv", 9, 0);
                if self.matches(player) { return player; }
                let episode = self.candidate("episode_start_behavior", @tr("Episode playback"), @tr("Start over") + " " + @tr("Resume") + " " + @tr("Ask") + " Episode playback Start over Resume Ask", 9, 1);
                if self.matches(episode) { return episode; }
                let remux_buffer = self.candidate("casting_remux_buffer", @tr("Casting remux buffer"), "Casting remux buffer RAM memory media segments budget 32 64 128 256 MiB", 9, SettingsContent.kb_player_stream_filters_row() - 1);
                if CastBridge.available && self.matches(remux_buffer) { return remux_buffer; }
                if SettingsBridge.player_backend_index == 0 {
                    let folder = self.candidate("screenshot_show_folder", @tr("Screenshot folder"), @tr("Show folders") + " Screenshot folder Pictures Nova Show folders", 9, SettingsContent.kb_player_speed_row() + 3);
                    if self.matches(folder) { return folder; }
                    let format = self.candidate("screenshot_format", @tr("Screenshot format"), "Screenshot format PNG JPEG WebP lossless lossy capture", 9, SettingsContent.kb_player_speed_row() + 2);
                    if self.matches(format) { return format; }
                    // A lossless format has no quality slider. The breadcrumb
                    // explicitly names the visible prerequisite instead of
                    // silently changing the format to manufacture a match.
                    if SettingsBridge.screenshot_format_index == 1 {
                        let jpeg_visible = self.candidate("screenshot_jpeg_quality", @tr("JPEG quality"), "JPEG quality", 9, SettingsContent.kb_player_speed_row() + 4);
                        if self.matches(jpeg_visible) { return jpeg_visible; }
                    }
                    if SettingsBridge.screenshot_format_index == 3 {
                        let webp_visible = self.candidate("screenshot_webp_quality", @tr("WebP quality"), "WebP quality", 9, SettingsContent.kb_player_speed_row() + 4);
                        if self.matches(webp_visible) { return webp_visible; }
                    }
                    let jpeg = self.candidate("screenshot_format", @tr("JPEG quality") + " › " + @tr("Screenshot format"), "JPEG quality", 9, SettingsContent.kb_player_speed_row() + 2);
                    if self.matches(jpeg) { return jpeg; }
                    let webp = self.candidate("screenshot_format", @tr("WebP quality") + " › " + @tr("Screenshot format"), "WebP quality", 9, SettingsContent.kb_player_speed_row() + 2);
                    if self.matches(webp) { return webp; }
                    let speed = self.candidate("playback_speed", @tr("Default playback speed"), @tr("Playback speed") + " Default playback speed presets 1× 1.25× 1.5× 2× 1x 1.25x 1.5x 2x", 9, SettingsContent.kb_player_speed_row());
                    if self.matches(speed) { return speed; }
                    let audio = self.candidate("default_audio_language", @tr("Preferred audio languages"), "Preferred audio languages Default audio language", 9, SettingsContent.kb_player_audio_language_row());
                    if self.matches(audio) { return audio; }
                    let subtitle = self.candidate("default_subtitle_language", @tr("Preferred subtitle languages"), "Preferred subtitle languages Default subtitle language", 9, SettingsContent.kb_player_subtitle_language_row());
                    if self.matches(subtitle) { return subtitle; }
                    let paused_controls = self.candidate("keep_controls_visible_while_paused", @tr("Keep controls visible while paused"), "Keep controls visible while paused OSD playback controls hide", 9, SettingsContent.kb_player_paused_controls_row());
                    if self.matches(paused_controls) { return paused_controls; }
                    let prefetch = self.candidate("prefetch_next_episode_streams", @tr("Prefetch next episode streams"), "Prefetch next episode streams", 9, SettingsContent.kb_player_speed_row() + 1);
                    if self.matches(prefetch) { return prefetch; }
                    let autoplay = self.candidate("auto_next_episode", @tr("Automatically play next episode"), "Automatically play next episode autoplay", 9, SettingsContent.kb_player_speed_row() + (SettingsBridge.screenshot_format_index == 1 || SettingsBridge.screenshot_format_index == 3 ? 5 : 4) + 9);
                    if self.matches(autoplay) { return autoplay; }
                    if SettingsBridge.is_android || SettingsBridge.desktop_decoder_available {
                        let decoder = self.candidate(SettingsBridge.is_android ? "android_hwdec" : "desktop_hwdec", @tr("Video decoder"), "Video decoder hardware HW+ HW SW", 9, 2);
                        if self.matches(decoder) { return decoder; }
                    }
                } else if !SettingsBridge.is_android {
                    let external = self.candidate("desktop_external_app", @tr("External app"), @tr("System default") + " External app System default VLC mpv", 9, 2);
                    if self.matches(external) { return external; }
                }
            }
            if section == 3 {
                let language = self.candidate("language", @tr("Language"), "Language English Hrvatski", 6, 5);
                if self.matches(language) { return language; }
                let interface = self.candidate("interface_mode", @tr("Interface mode"), @tr("Automatic") + " " + @tr("Standard") + " Interface mode Automatic Standard TV Android TV television remote", 6, 7);
                if self.matches(interface) { return interface; }
                let dates = self.candidate("date_relative", @tr("Relative episode dates"), "Relative episode dates", 6, 0);
                if self.matches(dates) { return dates; }
                let metadata = self.candidate("prefetch_metadata", @tr("Prefetch episode metadata"), "Prefetch episode metadata", 6, 1);
                if self.matches(metadata) { return metadata; }
                let thumbnails = self.candidate("show_unwatched_thumbs", @tr("Show unwatched thumbnails"), "Show unwatched thumbnails", 6, 2);
                if self.matches(thumbnails) { return thumbnails; }
                let discover = self.candidate("discover_min_cols", @tr("Discover grid columns"), "Discover grid columns", 6, 3);
                if self.matches(discover) { return discover; }
                let addon_names = self.candidate("discover_catalog_addon_names", @tr("Show addon names in catalogs"), "Show addon names in catalogs", 6, 6);
                if self.matches(addon_names) { return addon_names; }
                let library = self.candidate("library_min_cols", @tr("Library grid columns"), "Library grid columns", 6, 4);
                if self.matches(library) { return library; }
                let grouping = self.candidate("catalog_grouping_default", @tr("Catalog grouping"), @tr("Original") + " " + @tr("Season") + " " + @tr("Series") + " Catalog grouping Original Season Series", 6, 8);
                if self.matches(grouping) { return grouping; }
                let inference = self.candidate("catalog_grouping_infer_series", @tr("Infer series grouping"), "Infer series grouping", 6, 9);
                if self.matches(inference) { return inference; }
                let overrides = self.candidate("catalog_grouping_overrides", @tr("Catalog overrides"), "Catalog overrides", 6, 10);
                if self.matches(overrides) { return overrides; }
            }
            if section == 6 {
                let animations = self.candidate("animations", @tr("Enable animations"), "Enable animations", 10, 0);
                if self.matches(animations) { return animations; }
                let transitions = self.candidate("anim_transitions", @tr("Page transitions"), "Page transitions", 10, 1);
                if self.matches(transitions) { return transitions; }
                let hover = self.candidate("anim_hover", @tr("Hover effects"), "Hover effects", 10, 2);
                if self.matches(hover) { return hover; }
                let osd = self.candidate("anim_player", @tr("Player OSD"), "Player OSD", 10, 3);
                if self.matches(osd) { return osd; }
                let navigation = self.candidate("anim_nav_slide", @tr("Navigation feedback"), "Navigation feedback", 10, 4);
                if self.matches(navigation) { return navigation; }
            }
            if section == 2 {
                let disk = self.candidate("cache_images", @tr("Disk caching"), "Disk caching Storage", 5, 0);
                if self.matches(disk) { return disk; }
                let compression = self.candidate("enabled", @tr("Compress images"), "Compress images Compression", 5, 1);
                if self.matches(compression) { return compression; }
                let format = self.candidate("format", @tr("Format"), "Format JPEG WebP", 5, 2);
                if self.matches(format) { return format; }
                let quality = self.candidate("quality", @tr("Quality"), "Quality JPEG quality WebP quality", 5, 3);
                if self.matches(quality) { return quality; }
                let posters = self.candidate("detail_poster_max_side", @tr("Detail posters"), "Detail posters", 5, 4);
                if self.matches(posters) { return posters; }
                let backdrops = self.candidate("detail_backdrop_max_side", @tr("Detail backdrops"), "Detail backdrops", 5, 5);
                if self.matches(backdrops) { return backdrops; }
                let thumbnails = self.candidate("episode_thumbnail_max_side", @tr("Episode thumbnails"), "Episode thumbnails", 5, 6);
                if self.matches(thumbnails) { return thumbnails; }
                let player_backdrops = self.candidate("player_episode_backdrop_max_side", @tr("Player episode backdrops"), "Player episode backdrops", 5, 7);
                if self.matches(player_backdrops) { return player_backdrops; }
                let memory = self.candidate("lru_cache_mb", @tr("Decoded-image budget"), "Decoded-image budget Memory", 5, 8);
                if self.matches(memory) { return memory; }
            }
        }
        return { key: "", title: "", terms: "", zone: 0, row: -1 };
    }
}
