import { MoreBridge, ProfileRow, Theme, Anim, InterfaceStyle, SettingsStyle } from "@NovaUiShared";
import { ScrollView } from "scrollview.slint";
import { SettingsCard, SettingsInput, PillButton, ToggleSwitch, SettingsBackButton } from "settings-controls.slint";
import { ControlTouchArea } from "control-input.slint";
import { IcCheck, IcChevronRight, IcAdd, IcSettingsGear } from "icons.slint";

component ProfileAvatar inherits Rectangle {
    in property <ProfileRow> profile;
    width: InterfaceStyle.tv ? 60px : 48px;
    height: self.width;
    border-radius: self.width / 2;
    background: root.profile.avatar_background;
    avatar_letter := Text {
        width: 100%; height: 100%;
        text: root.profile.initial;
        color: root.profile.avatar_foreground;
        font-size: InterfaceStyle.tv ? 30px : 24px;
        font-weight: 600;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

// One accessible tap target per identity; editing lives in the management view.
component ProfileChoiceRow inherits Rectangle {
    in property <ProfileRow> profile;
    in property <int> kind: 0; // Profile, Add, Manage.
    in property <string> title;
    in property <string> subtitle;
    in property <string> label: root.title;
    in property <bool> selected;
    in property <bool> focused;
    in property <bool> interactive: true;
    callback picked();
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.subtitle;
    accessible-enabled: root.interactive;
    height: Math.max(InterfaceStyle.tv ? 104px : root.kind == 2 ? 72px : 84px, 24px + row_measure.preferred-height);
    vertical-stretch: 0;
    border-radius: Theme.card_corner_radius;
    border-width: root.selected || root.focus-visible ? 2px : 1px;
    // Reassigning the animated value on a master-switch change evaluates
    // the current duration: 0ms cancels motion before it can resume later.
    private property <color> target-border: root.focus-visible ? Theme.current.focus_ring : root.selected ? Theme.current.accent : Theme.current.control_border;
    private property <color> state-border: self.target-border;
    private property <bool> motion-enabled: Anim.enabled;
    animate state-border { duration: Anim.control_state; easing: ease-in-out; }
    changed target-border => { self.state-border = self.target-border; }
    changed motion-enabled => { self.state-border = self.target-border; }
    border-color: Anim.enabled ? self.state-border : self.target-border;
    background: touch.feedback-active && root.interactive ? Theme.current.settings_control : Theme.current.card;
    opacity: root.interactive ? 1 : 0.45;
    private property <bool> focus-visible: SettingsStyle.keyboard-mode && (root.focused || row_focus.has-focus);
    Rectangle {
        height: 0px; clip: true;
        row_measure := VerticalLayout {
            width: Math.max(1px, root.width - (InterfaceStyle.tv ? 152px : 132px)); spacing: 4px;
            Text { text: root.title; font-size: InterfaceStyle.tv ? 24px : 18px; font-weight: 600; wrap: word-wrap; min-width: 0px; }
            if root.subtitle != "": Text { text: root.subtitle; font-size: InterfaceStyle.tv ? 18px : 13px; wrap: word-wrap; min-width: 0px; }
        }
    }
    HorizontalLayout {
        padding: 16px; padding-top: 12px; padding-bottom: 12px;
        spacing: 16px; cross-axis-alignment: center;
        if root.kind == 0: ProfileAvatar { profile: root.profile; }
        if root.kind != 0: Rectangle {
            width: InterfaceStyle.tv ? 60px : 48px; height: self.width;
            border-radius: self.width / 2;
            border-width: root.kind == 1 ? 1px : 0px;
            border-color: Theme.current.control_border;
            if root.kind == 1: IcAdd { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 26px; height: 26px; fill: Theme.current.text_secondary; }
            if root.kind == 2: IcSettingsGear { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 26px; height: 26px; fill: Theme.current.text_secondary; }
        }
        VerticalLayout {
            horizontal-stretch: 1; min-width: 0px; spacing: 4px; alignment: center;
            Text { text: root.title; color: Theme.current.text_bright; font-size: InterfaceStyle.tv ? 24px : 18px; font-weight: 600; wrap: word-wrap; min-width: 0px; }
            if root.subtitle != "": Text { text: root.subtitle; color: Theme.current.text_secondary; font-size: InterfaceStyle.tv ? 18px : 13px; wrap: word-wrap; min-width: 0px; }
        }
        Rectangle {
            width: InterfaceStyle.tv ? 32px : 24px; height: self.width;
            // Retain both indicators so selection can crossfade in place.
            selection_check := Rectangle {
                width: 100%; height: 100%; border-radius: self.width / 2; background: Theme.current.accent;
                private property <float> target-opacity: root.selected ? 1 : 0;
                private property <float> state-opacity: self.target-opacity;
                private property <bool> motion-enabled: Anim.enabled;
                animate state-opacity { duration: Anim.control_state; easing: ease-in-out; }
                changed target-opacity => { self.state-opacity = self.target-opacity; }
                changed motion-enabled => { self.state-opacity = self.target-opacity; }
                opacity: Anim.enabled ? self.state-opacity : self.target-opacity;
                IcCheck { x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px; fill: Theme.current.on_accent; }
            }
            IcChevronRight {
                width: 100%; height: 100%; fill: Theme.current.text_muted;
                private property <float> target-opacity: root.selected ? 0 : 1;
                private property <float> state-opacity: self.target-opacity;
                private property <bool> motion-enabled: Anim.enabled;
                animate state-opacity { duration: Anim.control_state; easing: ease-in-out; }
                changed target-opacity => { self.state-opacity = self.target-opacity; }
                changed motion-enabled => { self.state-opacity = self.target-opacity; }
                opacity: Anim.enabled ? self.state-opacity : self.target-opacity;
            }
        }
    }
    forward-focus: row_focus;
    row_focus := FocusScope {
        enabled: root.interactive;
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " {
                SettingsStyle.keyboard-mode = true;
                if !e.repeat { root.picked(); } accept
            } else { reject }
        }
    }
    touch := ControlTouchArea {
        enabled: root.interactive; width: 100%; height: 100%; mouse-cursor: pointer;
        clicked => { SettingsStyle.keyboard-mode = false; row_focus.focus(); root.picked(); }
    }
}

// Profile selection belongs to this device; profile contents belong to sync.
export component ProfilesPage inherits Rectangle {
    in property <bool> active: true;
    in property <length> safe-top;
    in property <length> safe-bottom;
    in property <length> safe-left;
    in property <length> safe-right;
    callback back();
    background: Theme.current.artwork_canvas;
    property <int> editor: 0; // 0 list, 1 create, 2 rename, 3 delete confirmation.
    property <bool> managing: false;
    property <int> return-choice;
    property <string> editing-id;
    property <string> editing-name;
    property <string> draft;
    property <string> name-value;
    property <int> name-focus-request;
    property <int> choice: 0;
    property <bool> keyboard: false;
    private property <[ProfileRow]> profiles: MoreBridge.profiles;
    private property <bool> required: MoreBridge.profiles_require_selection;
    private property <int> action-count: root.editor == 3 ? 2 : root.editor > 0 ? 3 : root.managing ? root.profiles.length * 3 + 2 : root.profiles.length + 3;

    public function focus_shell() { if root.active && !MoreBridge.pin_open && !MoreBridge.policy_open { page_scope.focus(); } }
    public function go_back() {
        if root.editor > 0 { root.cancel_editor(); }
        else if root.managing { MoreBridge.management_closed(); root.managing = false; root.choice = root.profiles.length + 2; page_scope.focus(); }
        else if !root.required { root.back(); }
    }
    function cancel_editor() {
        root.editor = 0;
        root.choice = Math.min(root.return-choice, root.action-count - 1);
        if !root.available(root.choice) { root.choice = Math.max(0, root.choice - 1); }
        profile_scroll.content-y = 0px;
        page_scope.focus();
    }
    function start_editor(kind: int, id: string, name: string) {
        root.return-choice = root.choice;
        root.editing-id = id;
        root.editing-name = name;
        root.draft = kind == 2 ? name : "";
        root.name-value = root.draft;
        root.editor = kind;
        profile_scroll.content-y = 0px;
        root.choice = kind == 3 ? 1 : 0; // Destructive confirmation starts on Cancel.
        editor_focus.start();
    }
    function submit_name(value: string) {
        if value == "" || MoreBridge.profiles_busy { return; }
        if root.editor == 1 { MoreBridge.profile_create(value); }
        else if root.editor == 2 { MoreBridge.profile_rename(root.editing-id, value); }
        if MoreBridge.profiles_error == "" && !MoreBridge.profiles_busy { root.cancel_editor(); }
    }
    pure function available(index: int) -> bool {
        if root.editor > 0 { return true; }
        return !root.managing || index >= root.profiles.length * 3 || Math.mod(index, 3) != 1 || root.profiles.length > 1;
    }
    function move(direction: int) {
        SettingsStyle.keyboard-mode = true;
        root.keyboard = true;
        root.choice = Math.mod(root.choice + root.action-count + direction, root.action-count);
        // Only the last remaining profile's Delete control is unavailable.
        if !root.available(root.choice) { root.choice = Math.mod(root.choice + root.action-count + direction, root.action-count); }
        if root.editor == 0 { page_scope.focus(); }
    }
    function activate() {
        if MoreBridge.profiles_busy { return; }
        if root.editor == 3 {
            if root.choice == 0 { MoreBridge.profile_delete(root.editing-id); if MoreBridge.profiles_error == "" { root.cancel_editor(); } }
            else { root.cancel_editor(); }
        } else if root.editor > 0 {
            if root.choice == 1 { root.submit_name(root.name-value); }
            else if root.choice == 2 { root.cancel_editor(); }
            else { root.name-focus-request += 1; }
        } else if root.managing {
            if root.choice < root.profiles.length * 3 && root.available(root.choice) {
                let profile = root.profiles[Math.floor(root.choice / 3)];
                if Math.mod(root.choice, 3) == 2 { MoreBridge.policy_edit(profile.id); }
                else { root.start_editor(Math.mod(root.choice, 3) == 0 ? 2 : 3, profile.id, profile.name); }
            } else if root.choice == root.profiles.length * 3 { root.start_editor(1, "", ""); }
            else if root.choice == root.profiles.length * 3 + 1 { root.go_back(); }
        } else if root.choice < root.profiles.length { MoreBridge.profile_switch(root.profiles[root.choice].id); }
        else if root.choice == root.profiles.length { root.start_editor(1, "", ""); }
        else if root.choice == root.profiles.length + 1 { MoreBridge.profile_remember_last_changed(!MoreBridge.profiles_remember_last); }
        else {
            root.managing = true; root.choice = 0; page_scope.focus();
        }
    }
    function reveal(y: length, h: length) {
        let top = y - profile_scroll.absolute-position.y;
        if top < 0px { profile_scroll.content-y -= top; }
        else if top + h > profile_scroll.visible-height { profile_scroll.content-y -= top + h - profile_scroll.visible-height; }
    }
    changed profiles => {
        root.choice = Math.min(root.choice, root.action-count - 1);
        if !root.available(root.choice) { root.choice = Math.max(0, root.choice - 1); }
    }
    changed managing => { profile_scroll.content-y = 0px; }
    changed active => {
        if root.active {
            root.editor = 0;
            root.managing = false;
            root.choice = 0;
            entry_focus.start();
        } else { entry_focus.stop(); editor_focus.stop(); }
    }
    entry_focus := Timer { interval: 1ms; running: false; triggered => { self.stop(); root.focus_shell(); } }
    editor_focus := Timer { interval: 1ms; running: false; triggered => { self.stop(); if root.active { if root.editor == 1 || root.editor == 2 { root.name-focus-request += 1; } else { page_scope.focus(); } } } }
    page_scope := FocusScope {
        enabled: root.active;
        width: 100%; height: 100%;
        init => { if root.active { entry_focus.start(); } }
        capture-key-pressed(e) => {
            if e.text == Key.Escape || e.text == Key.Back || (e.text == Key.Backspace && self.has-focus) {
                if !e.repeat { root.go_back(); } accept
            } else if e.text == Key.Tab || e.text == Key.UpArrow || e.text == Key.DownArrow || (root.editor == 0 && (e.text == Key.LeftArrow || e.text == Key.RightArrow)) {
                root.move(e.text == Key.UpArrow || e.text == Key.LeftArrow || (e.text == Key.Tab && e.modifiers.shift) ? -1 : 1); accept
            } else { reject }
        }
        key-pressed(e) => {
            if self.has-focus && (e.text == Key.Return || e.text == " ") {
                root.keyboard = true; SettingsStyle.keyboard-mode = true;
                if !e.repeat { root.activate(); } accept
            } else { reject }
        }
        profile_scroll := ScrollView {
            x: root.safe-left + 18px + (root.required ? Math.max(0px, (root.width - root.safe-left - root.safe-right - 800px) / 2) : 0px);
            y: root.safe-top + 18px;
            width: Math.max(1px, root.required ? Math.min(764px, root.width - root.safe-left - root.safe-right - 36px) : root.width - root.safe-left - root.safe-right - 36px);
            height: Math.max(1px, root.height - root.safe-top - root.safe-bottom - 36px);
            content-width: self.visible-width;
            // Wrapped controls can exceed a layout's estimated height. Include
            // its actual end, keeping body sizing independent of the scroll
            // range so the footer can still sit low on an otherwise short page.
            content-height: Math.max(profile_body.height, profile_end.y + profile_end.height);
            mouse-drag-pan-enabled: true;
            profile_body := VerticalLayout {
                width: 100%; height: Math.max(profile_scroll.visible-height, Math.max(self.min-height, self.preferred-height)); spacing: 12px; alignment: start;
                VerticalLayout {
                    spacing: 8px; vertical-stretch: 0;
                    if root.editor > 0 || root.managing || !root.required: HorizontalLayout {
                        height: InterfaceStyle.tv ? 56px : 44px; spacing: 8px; cross-axis-alignment: center;
                        SettingsBackButton { clicked => { root.go_back(); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Text { text: root.managing ? @tr("Manage profiles") : @tr("Profiles"); color: Theme.current.text_bright; font-size: InterfaceStyle.tv ? 42px : 32px; font-weight: 700; wrap: word-wrap; min-width: 0px; }
                    Text { text: root.managing ? @tr("Separate libraries, history and preferences") : root.required ? @tr("Choose a profile to continue.") : @tr("Who's watching?"); color: Theme.current.text_secondary; font-size: InterfaceStyle.tv ? 20px : 16px; wrap: word-wrap; min-width: 0px; }
                }
                if MoreBridge.profiles_error != "": SettingsCard {
                    VerticalLayout { padding: 16px;
                        Text { text: MoreBridge.profiles_error; color: Theme.current.text_destructive; wrap: word-wrap; min-width: 0px; }
                    }
                }
                if root.editor == 0 && !root.managing: VerticalLayout {
                    width: 100%; spacing: 12px; vertical-stretch: 0;
                    for profile[index] in root.profiles: ProfileChoiceRow {
                        profile: profile; title: profile.name;
                        subtitle: profile.active ? @tr("Current profile") : "";
                        label: @tr("Use profile: {}", profile.name);
                        selected: profile.active; interactive: !MoreBridge.profiles_busy;
                        focused: root.keyboard && root.choice == index;
                        changed focused => { if self.focused { root.reveal(self.absolute-position.y, self.height); } }
                        picked => { root.choice = index; MoreBridge.profile_switch(profile.id); }
                    }
                }
                if root.editor == 0 && root.managing: VerticalLayout {
                    width: 100%; spacing: 12px; vertical-stretch: 0;
                    for profile[index] in root.profiles: SettingsCard {
                        property <bool> actions-focused: root.keyboard && (root.choice >= index * 3 && root.choice <= index * 3 + 2);
                        init => { if self.actions-focused { reveal_actions.start(); } }
                        changed actions-focused => { if self.actions-focused { reveal_actions.start(); } }
                        // A newly opened manager must finish layout before its
                        // focused action is revealed, especially on short TVs.
                        reveal_actions := Timer {
                            interval: 1ms; running: false;
                            triggered => { self.stop(); if root.active && root.editor == 0 && root.managing && root.keyboard && (root.choice >= index * 3 && root.choice <= index * 3 + 2) { if root.choice == index * 3 + 2 {root.reveal(pin_actions.absolute-position.y,pin_actions.height);}else{root.reveal(actions_bar.absolute-position.y, actions_bar.height);} } }
                        }
                        VerticalLayout { padding: 16px; spacing: 10px;
                            HorizontalLayout { spacing: 16px; cross-axis-alignment: center;
                                ProfileAvatar { profile: profile; }
                                VerticalLayout { horizontal-stretch: 1; min-width: 0px; alignment: center; spacing: 4px;
                                    Text { text: profile.name; color: Theme.current.text_bright; font-size: InterfaceStyle.tv ? 24px : 18px; font-weight: 600; wrap: word-wrap; min-width: 0px; }
                                    if profile.active: Text { text: @tr("Current profile"); color: Theme.current.text_secondary; wrap: word-wrap; min-width: 0px; }
                                }
                            }
                            actions_bar := HorizontalLayout { spacing: 8px; alignment: start;
                                PillButton {
                                    // Short actions stay on one line; the shared wrapping pill's
                                    // label inset is wider than its compact sizing allowance.
                                    label: @tr("Rename"); accessible-label: @tr("Rename profile: {}", profile.name); compact: true;
                                    btn_min_width: InterfaceStyle.tv ? 120px : 88px;
                                    enabled: !MoreBridge.profiles_busy;
                                    focused: root.keyboard && root.choice == index * 3;
                                    changed focused => { if self.focused { root.reveal(self.absolute-position.y, self.height); } }
                                    clicked => { root.choice = index * 3; root.start_editor(2, profile.id, profile.name); }
                                }
                                PillButton {
                                    label: @tr("Delete"); accessible-label: @tr("Delete profile: {}", profile.name); compact: true; destructive: true;
                                    btn_min_width: InterfaceStyle.tv ? 120px : 88px;
                                    enabled: !MoreBridge.profiles_busy && root.profiles.length > 1;
                                    focused: root.keyboard && root.choice == index * 3 + 1;
                                    changed focused => { if self.focused { root.reveal(self.absolute-position.y, self.height); } }
                                    clicked => { root.choice = index * 3 + 1; root.start_editor(3, profile.id, profile.name); }
                                }

                            }
                            pin_actions := HorizontalLayout { spacing: 8px; alignment: start;
                                PillButton {
                                    label: @tr("PIN"); accessible-label: @tr("Profile PIN and restrictions"); compact: true;
                                    enabled: !MoreBridge.profiles_busy;
                                    focused: root.keyboard && root.choice == index * 3 + 2;
                                    changed focused => { if self.focused { root.reveal(self.absolute-position.y, self.height); } }
                                    clicked => { root.choice = index * 3 + 2; MoreBridge.policy_edit(profile.id); }
                                }
                            }
                        }
                    }
                    if root.profiles.length == 1: Text { text: @tr("Keep at least one profile."); color: Theme.current.text_muted; wrap: word-wrap; min-width: 0px; }
                    Text { text: @tr("Profiles sync across paired devices. Each device chooses its own active profile."); color: Theme.current.text_muted; wrap: word-wrap; min-width: 0px; }
                }
                if root.editor == 0: ProfileChoiceRow {
                    kind: 1; title: @tr("Add profile"); interactive: !MoreBridge.profiles_busy;
                    focused: root.keyboard && root.choice == (root.managing ? root.profiles.length * 3 : root.profiles.length);
                    changed focused => { if self.focused { root.reveal(self.absolute-position.y, self.height); } }
                    picked => { root.choice = root.managing ? root.profiles.length * 3 : root.profiles.length; root.start_editor(1, "", ""); }
                }
                if root.editor == 0: Rectangle { min-height: 12px; vertical-stretch: root.managing ? 0 : 1; }
                if root.editor == 0 && !root.managing: SettingsCard {
                    height: Math.max(InterfaceStyle.tv ? 88px : 72px, remember_labels.preferred-height + 32px);
                    HorizontalLayout { padding: 16px; spacing: 12px; cross-axis-alignment: center;
                        remember_labels := VerticalLayout { horizontal-stretch: 1; min-width: 0px; spacing: 4px;
                            Text { text: @tr("Open last profile on startup"); color: Theme.current.text_primary; wrap: word-wrap; min-width: 0px; font-size: InterfaceStyle.tv ? 20px : 14px; }
                            Text { text: @tr("This device"); color: Theme.current.text_muted; font-size: InterfaceStyle.tv ? 16px : 12px; }
                        }
                        remember := ToggleSwitch {
                            name: @tr("Open last profile on startup");
                            checked: MoreBridge.profiles_remember_last;
                            enabled: !MoreBridge.profiles_busy;
                            focused: root.keyboard && root.choice == root.profiles.length + 1;
                            changed focused => { if self.focused { root.reveal(self.absolute-position.y, self.height); } }
                            toggled => {
                                root.choice = root.profiles.length + 1;
                                MoreBridge.profile_remember_last_changed(self.checked);
                                // Restore the saved value if the synchronous write failed.
                                self.checked = MoreBridge.profiles_remember_last;
                            }
                        }
                    }
                }
                if root.editor == 0 && !root.managing: ProfileChoiceRow {
                    kind: 2; title: @tr("Manage profiles"); interactive: !MoreBridge.profiles_busy;
                    focused: root.keyboard && root.choice == root.profiles.length + 2;
                    changed focused => { if self.focused { root.reveal(self.absolute-position.y, self.height); } }
                    picked => { root.managing = true; root.choice = 0; page_scope.focus(); }
                }
                if root.editor == 0 && root.managing: PillButton {
                    label: @tr("Done"); wrap_label: true;
                    focused: root.keyboard && root.choice == root.profiles.length * 3 + 1;
                    changed focused => { if self.focused { root.reveal(self.absolute-position.y, self.height); } }
                    clicked => { root.go_back(); }
                }
                if root.editor == 1 || root.editor == 2: SettingsCard {
                    VerticalLayout { padding: 16px; spacing: 12px;
                        Text { text: root.editor == 1 ? @tr("Create profile") : @tr("Rename profile"); color: Theme.current.text_bright; font-size: 20px; font-weight: 600; wrap: word-wrap; min-width: 0px; }
                        name_input := SettingsInput {
                            text <=> root.draft; placeholder-text: @tr("Profile name"); enabled: !MoreBridge.profiles_busy;
                            // The conditional editor owns its native input handle. The page
                            // requests focus through a value instead of retaining that handle.
                            property <int> focus-request: root.name-focus-request;
                            changed focus-request => { if root.active { self.focus_at_end(); } }
                            changed full-text => { root.name-value = self.full-text; }
                            property <bool> selected: root.keyboard && root.choice == 0;
                            changed selected => { if self.selected { self.focus(); root.reveal(self.absolute-position.y, self.height); } }
                            focus_changed(value) => { if value { root.choice = 0; } }
                            accepted(value) => { root.submit_name(value); }
                        }
                        HorizontalLayout { spacing: 8px; alignment: start;
                            PillButton {
                                label: @tr("Save"); primary: true; compact: true;
                                enabled: !MoreBridge.profiles_busy && name_input.full-text != "";
                                focused: root.keyboard && root.choice == 1;
                                changed focused => { if self.focused { self.focus(); root.reveal(self.absolute-position.y, self.height); } }
                                clicked => { root.submit_name(name_input.full-text); }
                            }
                            PillButton {
                                label: @tr("Cancel"); compact: true;
                                focused: root.keyboard && root.choice == 2;
                                changed focused => { if self.focused { self.focus(); root.reveal(self.absolute-position.y, self.height); } }
                                clicked => { root.cancel_editor(); }
                            }
                        }
                    }
                }
                if root.editor == 3: SettingsCard {
                    VerticalLayout { padding: 16px; spacing: 12px;
                        Text { text: @tr("Delete profile?"); color: Theme.current.text_bright; font-size: 20px; font-weight: 600; wrap: word-wrap; min-width: 0px; }
                        Text { text: root.editing-name; color: Theme.current.text_primary; font-weight: 600; wrap: word-wrap; min-width: 0px; }
                        Text { text: @tr("Its library, history, addons and preferences will be deleted from paired devices."); color: Theme.current.text_secondary; wrap: word-wrap; min-width: 0px; }
                        HorizontalLayout { spacing: 8px; alignment: start;
                            PillButton {
                                label: @tr("Delete"); destructive: true; compact: true; enabled: !MoreBridge.profiles_busy;
                                focused: root.keyboard && root.choice == 0;
                                clicked => { MoreBridge.profile_delete(root.editing-id); if MoreBridge.profiles_error == "" { root.cancel_editor(); } }
                            }
                            PillButton {
                                label: @tr("Cancel"); compact: true; focused: root.keyboard && root.choice == 1;
                                clicked => { root.cancel_editor(); }
                            }
                        }
                    }
                }
                profile_end := Rectangle { height: 0px; vertical-stretch: 0; }
            }
        }
    }
}
