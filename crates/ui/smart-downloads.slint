import { Theme, InterfaceStyle, OfflineBridge, Anim } from "@NovaUiShared";
import { ScrollView } from "scrollview.slint";
import { PillButton } from "settings-controls.slint";
import { PageHeader } from "page-header.slint";
component OfflineButton inherits PillButton {
    in property <bool> selected;
    in property <bool> highlighted;
    primary: root.selected;
    focused: root.highlighted;
    wrap_label: true;
    callback picked();
    callback reveal(length,length);
    changed keyboard_focused=>{if self.keyboard_focused {root.reveal(root.absolute-position.y,root.height);}}
    changed highlighted=>{if self.highlighted {root.reveal(root.absolute-position.y,root.height);}}
    clicked=>{root.picked();}
}
export component SmartDownloads inherits Rectangle {
    in property <bool> active: true;
    callback dismissed();
    public function focus_shell() { if root.opened { keys.focus(); } }
    // Downloads shares these animated values so both surfaces push/pop together.
    out property <float> push_progress: root.motion ? root.slide : (root.opened ? 1.0 : 0.0);
    out property <float> fade_progress: root.motion ? root.alpha : (root.opened ? 1.0 : 0.0);
    in property <length> safe_left;
    in property <length> safe_right;
    in property <length> safe_top;
    in property <length> safe_bottom;
    private property <length> supporting_font_size: InterfaceStyle.tv ? 20px : 14px;
    private property <bool> opened: root.active && OfflineBridge.opened;
    private property <bool> retained;
    private property <bool> motion: Anim.enabled && Anim.transitions;
    private property <float> slide: 0.0;
    private property <float> alpha: 0.0;
    animate slide { duration: root.motion ? Anim.transition_slide : 0ms; easing: ease-out; }
    animate alpha { duration: root.motion ? Anim.transition_fade : 0ms; }
    visible: root.opened || root.retained;
    clip: true;
    changed opened => {
        return_timer.stop();
        root.slide = root.opened ? 1.0 : 0.0;
        root.alpha = root.opened ? 1.0 : 0.0;
        if root.opened {
            root.retained = true;
            OfflineBridge.refresh(); keys.focus();
        } else if root.motion && root.active && root.retained {
            return_timer.start();
        } else { root.retained = false; }
    }
    changed motion => {
        if !root.motion {
            root.slide = root.opened ? 1.0 : 0.0;
            root.alpha = root.opened ? 1.0 : 0.0;
            if !root.opened { return_timer.stop(); root.retained = false; }
        }
    }
    changed visible => {
        OfflineBridge.visual_retained = root.visible;
        if !root.visible { root.dismissed(); }
    }
    return_timer := Timer {
        interval: Math.max(Anim.transition_slide, Anim.transition_fade);
        running: false;
        triggered => { self.stop(); root.retained = false; }
    }
    // Cover inert page margins as well as controls and scrolling content.
    TouchArea {width:100%;height:100%;clicked=>{} scroll-event(event)=>{accept}}
    private property <int> selected_row <=> OfflineBridge.focused_index;
    changed selected_row=>{if root.selected_row>=0 && root.selected_row<OfflineBridge.rows.length {OfflineBridge.focused_policy=OfflineBridge.rows[root.selected_row].id;}}
    private property <int> selected_action:0;
    private property <int> row_count:OfflineBridge.rows.length;
    changed row_count=>{root.selected_row=Math.max(-1,Math.min(root.selected_row,root.row_count - 1));}
    function reveal(y:length,h:length) {
        let top=y - scroll.absolute-position.y;
        if top<0px {scroll.content-y=scroll.content-y - top;}
        else if top+h>scroll.visible-height {scroll.content-y=scroll.content-y - (top+h - scroll.visible-height);}
    }
    function activate() {
        if root.selected_row<0 {
            if root.selected_action==0 {OfflineBridge.closed();}
            else if root.selected_action==1 {OfflineBridge.device_toggle();}
            else if root.selected_action==2 {OfflineBridge.budget(-1);}
            else if root.selected_action==3 {OfflineBridge.budget(1);}
            else if root.selected_action==4 {OfflineBridge.charging_toggle();}
            else if root.selected_action - 5<OfflineBridge.profiles.length {OfflineBridge.profile_toggle(OfflineBridge.profiles[root.selected_action - 5].id);}
        } else if root.selected_row<OfflineBridge.rows.length {
            let row=OfflineBridge.rows[root.selected_row];
            if root.selected_action==0 {OfflineBridge.action(row.id,0);}
            else if root.selected_action==1 {OfflineBridge.action(row.id,2);}
            else if root.selected_action==2 {OfflineBridge.action(row.id,1);}
            else if root.selected_action==3 {OfflineBridge.action(row.id,3);}
            else if root.selected_action==4 {OfflineBridge.action(row.id,4);}
            else if root.selected_action==5 {OfflineBridge.action(row.id,6);}
            else if root.selected_action==6 {OfflineBridge.action(row.id,7);}
            else if root.selected_action==7 {OfflineBridge.action(row.id,5);}
            else {OfflineBridge.action(row.id,8);}
        }
    }
    panel := Rectangle {
    x: (1.0 - root.push_progress) * root.width; y: 0px;
    width: root.width; height: root.height;
    opacity: root.motion ? root.alpha : 1.0;
    background: Theme.current.artwork_canvas;
    keys := FocusScope { width:100%;height:100%;enabled:root.opened;
        capture-key-pressed(e)=>{
            if e.text==Key.Escape || e.text==Key.Back {if !e.repeat {OfflineBridge.closed();}accept}
            else if InterfaceStyle.tv && (e.text==Key.DownArrow || e.text==Key.UpArrow) {
                root.selected_row=Math.max(-1,Math.min(OfflineBridge.rows.length - 1,root.selected_row+(e.text==Key.DownArrow ? 1 : -1)));root.selected_action=0;accept
            } else if InterfaceStyle.tv && (e.text==Key.LeftArrow || e.text==Key.RightArrow) {
                root.selected_action=Math.max(0,Math.min(root.selected_row<0 ? 4 + OfflineBridge.profiles.length : 8,root.selected_action+(e.text==Key.RightArrow ? 1 : -1)));accept
            } else if InterfaceStyle.tv && (e.text==Key.Return || e.text==" ") {if !e.repeat {root.activate();}accept}else{reject}
        }
        scroll := ScrollView {x:root.safe_left;y:root.safe_top;width:parent.width - root.safe_left - root.safe_right;height:parent.height - root.safe_top - root.safe_bottom;content-width:self.visible-width;
            // Natural content height leaves spare space below the last row, rather
            // than distributing it among the wrapped supporting text rows.
            VerticalLayout {x:0px;y:0px;width:100%;height:self.preferred-height;alignment:start;padding:18px;spacing:12px;
                header := PageHeader {
                    title:@tr("Smart downloads"); show-back:true;
                    narrow:!InterfaceStyle.tv && root.width<700px;
                    back-focused:InterfaceStyle.tv && root.selected_row<0 && root.selected_action==0;
                    changed back-focused => { if self.back-focused { root.reveal(self.absolute-position.y,self.height); } }
                    back=>{OfflineBridge.closed();}
                }
                introduction := Text {vertical-stretch:0;min-width:0px;font-size:root.supporting_font_size;text:@tr("Rules sync between profiles. Downloads run only for profiles enabled on this device, on unmetered Wi-Fi or Ethernet.");wrap:word-wrap;color:Theme.current.text_muted;}
                storage := Text {vertical-stretch:0;min-width:0px;font-size:root.supporting_font_size;text:OfflineBridge.storage_summary;wrap:word-wrap;color:Theme.current.text_primary;}
                OfflineButton {enabled:root.opened;reveal(y,h)=>{root.reveal(y,h);}label:OfflineBridge.device_enabled ? @tr("Pause this profile on this device") : @tr("Enable this profile on this device");highlighted:InterfaceStyle.tv && root.selected_row<0 && root.selected_action==1;selected:OfflineBridge.device_enabled;picked=>{OfflineBridge.device_toggle();}}
                HorizontalLayout {spacing:8px;
                    OfflineButton {enabled:root.opened;reveal(y,h)=>{root.reveal(y,h);}label:"−";highlighted:InterfaceStyle.tv && root.selected_row<0 && root.selected_action==2;picked=>{OfflineBridge.budget(-1);}}
                    Text {vertical-stretch:0;min-width:0px;font-size:root.supporting_font_size;text:@tr("Automatic allowance: {} GiB",OfflineBridge.budget_gib);vertical-alignment:center;color:Theme.current.text_primary;wrap:word-wrap;}
                    OfflineButton {enabled:root.opened;reveal(y,h)=>{root.reveal(y,h);}label:"+";highlighted:InterfaceStyle.tv && root.selected_row<0 && root.selected_action==3;picked=>{OfflineBridge.budget(1);}}
                }
                OfflineButton {enabled:root.opened;reveal(y,h)=>{root.reveal(y,h);}label:OfflineBridge.charging_only ? @tr("Charging required") : @tr("Charging optional");highlighted:InterfaceStyle.tv && root.selected_row<0 && root.selected_action==4;selected:OfflineBridge.charging_only;picked=>{OfflineBridge.charging_toggle();}}
                profile_heading := Text {vertical-stretch:0;min-width:0px;font-size:root.supporting_font_size;text:@tr("Profiles enabled on this device");color:Theme.current.text_primary;}
                for profile[index] in OfflineBridge.profiles: OfflineButton {enabled:root.opened;reveal(y,h)=>{root.reveal(y,h);}label:profile.name + " · " + (profile.enabled ? @tr("Enabled on this device") : @tr("Disabled on this device"));selected:profile.enabled;highlighted:InterfaceStyle.tv && root.selected_row<0 && root.selected_action==5 + index;picked=>{OfflineBridge.profile_toggle(profile.id);}}
                if OfflineBridge.notice!="": Text {vertical-stretch:0;min-width:0px;font-size:root.supporting_font_size;text:OfflineBridge.notice;wrap:word-wrap;color:Theme.current.text_primary;}
                if OfflineBridge.rows.length==0: empty_notice := Text {vertical-stretch:0;min-width:0px;font-size:root.supporting_font_size;text:@tr("Open a show and choose Keep offline to add a rule.");wrap:word-wrap;color:Theme.current.text_muted;}
                for row[index] in OfflineBridge.rows: rule_card := Rectangle {
                    border-radius:10px;background:Theme.current.control;
                    private property <bool> active_row:InterfaceStyle.tv && root.selected_row==index;
                    changed active_row=>{if self.active_row {root.selected_action=0;}}
                    height: card.preferred-height + 24px;
                    card := VerticalLayout {x:12px;y:12px;width:parent.width - 24px;height:self.preferred-height;spacing:8px;
                        Text {text:row.title;font-size:InterfaceStyle.tv ? 23px : 18px;color:Theme.current.text_primary;wrap:word-wrap;}
                        rule_status := Text {vertical-stretch:0;min-width:0px;font-size:root.supporting_font_size;text:row.status;color:Theme.current.text_muted;wrap:word-wrap;}
                        OfflineButton {enabled:root.opened;reveal(y,h)=>{root.reveal(y,h);}label:row.enabled ? @tr("Pause rule") : @tr("Resume rule");highlighted:root.selected_row==index && root.selected_action==0;selected:row.enabled;picked=>{OfflineBridge.action(row.id,0);}}
                        HorizontalLayout {spacing:8px;
                            OfflineButton {enabled:root.opened;reveal(y,h)=>{root.reveal(y,h);}label:"−";highlighted:root.selected_row==index && root.selected_action==1;picked=>{OfflineBridge.action(row.id,2);}}
                            Text {vertical-stretch:0;min-width:0px;font-size:root.supporting_font_size;text:@tr("Keep next {}",row.keep_count);vertical-alignment:center;color:Theme.current.text_primary;}
                            OfflineButton {enabled:root.opened;reveal(y,h)=>{root.reveal(y,h);}label:"+";highlighted:root.selected_row==index && root.selected_action==2;picked=>{OfflineBridge.action(row.id,1);}}
                        }
                        OfflineButton {enabled:root.opened;reveal(y,h)=>{root.reveal(y,h);}label:row.source_ready ? @tr("Choose another source") : @tr("Choose source");highlighted:root.selected_row==index && root.selected_action==3;picked=>{OfflineBridge.action(row.id,3);}}
                        OfflineButton {enabled:root.opened;reveal(y,h)=>{root.reveal(y,h);}label:@tr("Retry / Restore offline");highlighted:root.selected_row==index && root.selected_action==4;picked=>{OfflineBridge.action(row.id,4);}}
                        OfflineButton {enabled:root.opened;reveal(y,h)=>{root.reveal(y,h);}label:row.include_specials ? @tr("Specials included") : @tr("Specials excluded");highlighted:root.selected_row==index && root.selected_action==5;selected:row.include_specials;picked=>{OfflineBridge.action(row.id,6);}}
                        OfflineButton {enabled:root.opened;reveal(y,h)=>{root.reveal(y,h);}label:row.cleanup ? @tr("Remove unneeded automatic files") : @tr("Keep watched automatic files");highlighted:root.selected_row==index && root.selected_action==6;selected:row.cleanup;picked=>{OfflineBridge.action(row.id,7);}}
                        OfflineButton {enabled:root.opened;reveal(y,h)=>{root.reveal(y,h);}label:@tr("Remove rule, keep files");highlighted:root.selected_row==index && root.selected_action==7;picked=>{OfflineBridge.action(row.id,5);}}
                        OfflineButton {enabled:root.opened;reveal(y,h)=>{root.reveal(y,h);}label:@tr("Remove rule and unneeded files");highlighted:root.selected_row==index && root.selected_action==8;picked=>{OfflineBridge.action(row.id,8);}}
                    }
                }
                Rectangle {height:24px;}
            }
        }
    }
    }
    // The outgoing panel remains painted but cannot edit rules or pass input
    // through to the retained Downloads list before the return completes.
    if !root.opened: TouchArea { width:100%; height:100%; clicked=>{} scroll-event(event)=>{accept} }
}
