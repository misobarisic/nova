import { InterfaceStyle, SubtitleStyle, PartyBridge, Theme, TrackRow, Anim, PlaybackSpeed, SliderGesture } from "@NovaUiShared";

import { ScrollView } from "scrollview.slint";

import { IcPlay, IcPause, IcVolumeUp, IcVolumeOff, IcReplay10, IcForward10, IcCaptions, IcMusic, IcFullscreen, IcFullscreenExit, IcClose, IcChevronRight, IcChevronLeft, IcSettingsGear, IcCamera } from "icons.slint";

import { SubtitleControls } from "subtitle-controls.slint";

import { SpeedControl } from "speedcontrol.slint";


// Rounded player control with the same purple selected surface as menus.
component IconBtn inherits Rectangle {
    in property <bool> active: false;
    in property <bool> enabled: true;
    // 6-button nav highlight.
    in property <bool> focused: false;
    // Base fill shown when idle (not hovered/active). Default transparent:
    // the bottom-bar buttons sit on the dark scrim. The Android center
    // transport passes a dark fill so its glyphs read over bright video.
    in property <color> base: transparent;
    in-out property <bool> hovered: touch.has-hover;
    callback clicked();
    width: InterfaceStyle.tv ? 56px : 40px;
    height: InterfaceStyle.tv ? 56px : 40px;
    border-radius: 10px;
    border-width: focused ? 2px : 0px;
    border-color: Theme.current.focus_ring;
    background: root.active ? Theme.current.selection_fill
        : touch.has-hover ? Theme.current.player_control_hover : root.base;
    opacity: root.enabled ? 1 : 0.4;
    touch := TouchArea {
        enabled: root.enabled;
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    @children
}

import { MenuRow } from "player-menu-row.slint";

component SubtitleAddonStatus inherits Text {
    in property <int> status;
    text: root.status == 1 ? @tr("Searching subtitle addons…")
        : root.status == 2 ? @tr("Loading subtitle…")
        : root.status == 3 ? @tr("No addon subtitles found for this video.")
        : @tr("Could not load addon subtitles. Try again.");
    color: Theme.current.text_player_muted;
    font-size: InterfaceStyle.tv ? 20px : 13px;
    wrap: word-wrap;
    min-width: 0px;
    vertical-stretch: 0;
}

// Dark rounded popup card listing audio/subtitle tracks. Anchored by the
// caller above the button that opens it.
component TrackMenu inherits Rectangle {
    in property <[TrackRow]> tracks;
    in property <int> subtitle_addon_status: 0;
    in property <bool> kb_active: false;
    in property <int> row_icon: 0;   // icon for every track row
    in property <bool> with_off_row: false;
    in property <length> max_w: 340px;
    // 6-button nav: focused row index (off-row is 0 when present).
    in property <int> focused_idx: -1;
    callback pick(int);
    function reveal_row(y: length, h: length) {
        let top = y - menu_scroll.absolute-position.y;
        if top < 0px { menu_scroll.content-y = Math.min(0px, menu_scroll.content-y - top); }
        else if top + h > menu_scroll.height { menu_scroll.content-y = Math.max(Math.min(0px, menu_scroll.height - menu_scroll.content-height), menu_scroll.content-y - (top + h - menu_scroll.height)); }
    }

    width: Math.min(InterfaceStyle.tv ? 500px : 340px, self.max_w);
    height: menu_scroll.height;
    background: Theme.current.player_menu;
    border-radius: 16px;
    border-width: 1px;
    border-color: Theme.current.player_menu_border;
    drop-shadow-blur: 24px;
    drop-shadow-color: Theme.current.scrim_shadow;

    // Swallow clicks on the card itself so they don't reach the video.
    TouchArea { width: 100%; height: 100%; }

    menu_scroll := ScrollView {
        width: 100%;
        height: Math.min(menu_col.preferred-height, InterfaceStyle.tv ? 440px : 320px);
        // Touch devices scroll by dragging (there is no wheel): the
        // fluent-style ScrollView disables drag-pan by default, so opt
        // in explicitly.
        mouse-drag-pan-enabled: true;

        menu_col := VerticalLayout {
            padding: 8px;
            spacing: 4px;

            if root.subtitle_addon_status > 0: SubtitleAddonStatus { status: root.subtitle_addon_status; }

            if with_off_row: MenuRow {
                reveal(y, h) => { root.reveal_row(y, h); }
                label: @tr("Off");
                focused: root.kb_active && root.focused_idx == 0;
                activate => { pick(-1); }
            }

            if tracks.length == 0 && !with_off_row: Rectangle {
                height: 44px;

                Text {
                    text: @tr("No tracks available.");
                    color: Theme.current.text_player_muted;
                    font-size: InterfaceStyle.tv ? 20px : 13px;
                    x: 16px;
                    vertical-alignment: center;
                }
            }

            for track[i] in tracks: MenuRow {
                reveal(y, h) => { root.reveal_row(y, h); }
                icon_kind: row_icon;
                label: track.lang + (track.title != "" ? " — " + track.title : "");
                value: track.codec;
                selected: track.selected;
                focused: root.kb_active && root.focused_idx == i + (root.with_off_row ? 1 : 0);
                activate => { pick(track.index); }
            }
        }
    }
}

// Player settings panel (opened by the gear button in the bottom control
// row): an anchored card on wide screens and a centered card on narrow ones.
// Holds the hardware-decoder picker (Android/Windows/Linux) plus the subtitle and audio
// track pickers. On narrow layouts the track pickers live here to save
// control-row space; on wide layouts they duplicate the quick buttons so
// the panel is available on every platform. Long row lists scroll.
component SettingsMenu inherits Rectangle {
    in property <bool> narrow;
    in property <length> anchor_x;
    in property <length> anchor_y;
    in property <length> safe_top;
    in property <length> safe_left;
    in property <length> safe_right;
    // Very short landscape windows use the centered layout to retain room.
    property <bool> anchored: !root.narrow && root.height >= 320px;
    property <length> top_inset: root.safe_top + 16px;
    property <length> card_limit: Math.max(0px, root.anchored
        ? root.anchor_y - root.top_inset - 24px : root.height - root.top_inset - 16px);
    // Current submenu: 0 = root, 1 = hardware decoding (Android/Windows/Linux), 2 =
    // subtitles, 3 = audio, 4 = playback speed. Two-way bound to PlayerOverlay
    // so the keyboard handler can drive it.
    in-out property <int> page: 0;
    // A submenu can remove a slider before its delayed pointer-up/cancel is
    // delivered. Its gesture lease must not outlive the page that owned it.
    changed page => { SliderGesture.active = false; SliderGesture.hovered = false; }

    // Keyboard focus row on the current page (-1 = none / mouse mode).
    in property <int> focused_idx: -1;
    // Decoder selection (-1 none, 0 HW+, 1 HW, 2 SW) and its short label for
    // the category row, both mirrored from `hwdec-current`.
    in property <int> selected_index: -1;
    in property <string> hwdec_label: "";
    // Track lists and the current-selection summaries on the root rows.
    in property <[TrackRow]> sub_tracks;
    in property <int> subtitle_addon_status: 0;
    in property <[TrackRow]> audio_tracks;
    in property <string> sub_label: "";
    in property <string> audio_label: "";
    in property <bool> audio_preference_saved: false;
    in property <bool> subtitle_preference_saved: false;
    in property <bool> speed_preference_saved: false;
    in property <bool> subtitle_style_preference_saved: false;
    in-out property <[float]> subtitle_style: [0, 55, 19, 100, 3, 0, 0];
    callback subtitle_style_changed(int, float);
    // Effective base rate: title override or the global default.
    in-out property <float> playback_speed: 1.0;
    // Decoder section is available on Android, Windows and Linux.
    in property <bool> decoder_available: false;
    in property <bool> hw_plus_available: true;

    // Picking a track / decoder; the caller closes the modal.
    callback pick_decoder(int);
    callback pick_sub(int);
    callback pick_audio(int);
    callback restore_playback_default(int);
    // Playback rate: a slider value (drags/live) or ± one 0.05 step.
    callback speed_changed(float);
    callback speed_stepped(int);
    callback closed();
    function reveal_row(y: length, h: length) {
        let top = y - settings_scroll.absolute-position.y;
        if top < 0px { settings_scroll.content-y = Math.min(0px, settings_scroll.content-y - top); }
        else if top + h > settings_scroll.height { settings_scroll.content-y = Math.max(Math.min(0px, settings_scroll.height - settings_scroll.content-height), settings_scroll.content-y - (top + h - settings_scroll.height)); }
    }

    width: 100%;
    height: 100%;

    function page_title() -> string {
        if (root.page == 1) {
            return @tr("Hardware decoding");
        }
        if (root.page == 2) {
            return @tr("Subtitles");
        }
        if (root.page == 3) {
            return @tr("Audio");
        }
        if (root.page == 4) {
            return @tr("Playback speed");
        }
        if root.page == 5 { return @tr("Subtitle appearance and timing"); }
        return @tr("Playback settings");
    }

    // Compact layouts dim the video; both layouts dismiss on an outside tap.
    Rectangle { width: 100%; height: 100%; background: root.anchored ? transparent : Theme.current.scrim_player_feedback; }
    backdrop_touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.closed(); }
    }

    card := Rectangle {
        width: Math.max(0px, Math.min(InterfaceStyle.tv ? 560px : (root.anchored ? 400px : 380px),
            root.width - root.safe_left - root.safe_right - 32px));
        height: card_col.preferred-height;
        x: root.anchored
            ? Math.clamp(root.anchor_x - self.width, 16px + root.safe_left,
                Math.max(16px + root.safe_left, root.width - root.safe_right - 16px - self.width))
            : root.safe_left + (root.width - root.safe_left - root.safe_right - self.width) / 2;
        y: root.anchored ? Math.max(root.top_inset, root.anchor_y - 24px - self.height)
            : root.top_inset + Math.max(0px, (root.height - root.top_inset - 16px - self.height) / 2);
        background: Theme.current.player_menu;
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.current.player_menu_border;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.current.scrim_shadow;

        // Swallow taps on the card so they don't reach the backdrop.
        TouchArea { width: 100%; height: 100%; }

        card_col := VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: start;

            // ---- Header: title + back (submenu) / close ----
            settings_header := Rectangle {
                height: Math.max(InterfaceStyle.tv ? 56px : 44px, settings_title.preferred-height);

                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 0px;
                    spacing: 6px;

                    if root.page != 0: Rectangle {
                        width: InterfaceStyle.tv ? 56px : 40px;
                        height: InterfaceStyle.tv ? 56px : 40px;
                        border-radius: 20px;
                        background: back_touch.has-hover ? Theme.current.control_hover : Theme.current.control;

                        back_touch := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.page = 0; }
                        }
                        IcChevronLeft {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 20px;
                            height: 20px;
                            fill: Theme.current.text_bright;
                        }
                    }

                    settings_title := Text {
                        text: root.page_title();
                        color: Theme.current.text_bright;
                        font-size: 18px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        wrap: word-wrap;
                    }

                    // Live decoder value on the right of the submenu title.
                    if root.page == 1: Text {
                        text: root.hwdec_label != "" ? root.hwdec_label : "…";
                        color: Theme.current.text_player_secondary;
                        font-size: InterfaceStyle.tv ? 18px : 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: InterfaceStyle.tv ? 56px : 40px;
                        height: InterfaceStyle.tv ? 56px : 40px;
                        border-radius: 20px;
                        background: close_touch.has-hover ? Theme.current.control_hover : Theme.current.control;

                        close_touch := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.closed(); }
                        }
                        IcClose {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 18px;
                            height: 18px;
                            fill: Theme.current.text_bright;
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.current.border_soft; }

            // ---- Rows for the current page (scrolls when the list is long) ----
            settings_scroll := Flickable {
                width: 100%;
                vertical-stretch: 0;
                height: Math.max(0px, Math.min(pages_col.preferred-height, root.card_limit - settings_header.height - 57px));
                interactive: !SliderGesture.active;
                mouse-drag-pan-enabled: !SliderGesture.hovered;

                pages_col := VerticalLayout {
                    width: 100%;
                    spacing: 4px;

                    // Root categories.
                    if root.page == 0: VerticalLayout {
                        width: 100%;
                        spacing: 4px;
                        MenuRow {
                            reveal(y, h) => { root.reveal_row(y, h); }
                            icon_kind: 2; submenu: true;
                            label: @tr("Subtitles");
                            value: root.sub_label;
                            focused: root.focused_idx == 0;
                            activate => { root.page = 2; }
                        }
                        MenuRow {
                            reveal(y, h) => { root.reveal_row(y, h); }
                            icon_kind: 1; submenu: true;
                            label: @tr("Audio");
                            value: root.audio_label;
                            focused: root.focused_idx == 1;
                            activate => { root.page = 3; }
                        }
                        if root.decoder_available: MenuRow {
                            reveal(y, h) => { root.reveal_row(y, h); }
                            icon_kind: 4; submenu: true;
                            label: @tr("Hardware decoding");
                            value: root.hwdec_label != "" ? root.hwdec_label : "…";
                            focused: root.focused_idx == 2;
                            activate => { root.page = 1; }
                        }
                        // Same value as Settings → Player (per device).
                        MenuRow {
                            reveal(y, h) => { root.reveal_row(y, h); }
                            icon_kind: 3; submenu: true;
                            label: @tr("Playback speed");
                            enabled: !(PartyBridge.active || PartyBridge.busy);
                            value: (PartyBridge.active || PartyBridge.busy) ? @tr("Watch parties use normal speed.") : PlaybackSpeed.label(root.playback_speed);
                            focused: root.focused_idx == (root.decoder_available ? 3 : 2);
                            activate => { root.page = 4; }
                        }
                        MenuRow {
                            reveal(y, h) => { root.reveal_row(y, h); }
                            icon_kind: 2; submenu: true;
                            label: @tr("Subtitle appearance and timing");
                            focused: root.focused_idx == (root.decoder_available ? 4 : 3);
                            activate => { root.page = 5; }
                        }
                    }

                    // Decoder submenu.
                    if root.page == 1: VerticalLayout {
                        width: 100%;
                        spacing: 4px;
                        Text {
                            text: @tr("Applies to this stream only. The next stream uses Settings → Player.");
                            color: Theme.current.text_secondary;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        MenuRow {
                            reveal(y, h) => { root.reveal_row(y, h); }
                            label: "HW+";
                            value: @tr("zero-copy");
                            enabled: root.hw_plus_available;
                            selected: root.selected_index == 0;
                            focused: root.focused_idx == 0;
                            activate => { root.pick_decoder(0); }
                        }
                        MenuRow {
                            reveal(y, h) => { root.reveal_row(y, h); }
                            label: "HW";
                            value: @tr("copy-back");
                            selected: root.selected_index == 1;
                            focused: root.focused_idx == 1;
                            activate => { root.pick_decoder(1); }
                        }
                        MenuRow {
                            reveal(y, h) => { root.reveal_row(y, h); }
                            label: "SW";
                            value: @tr("software");
                            selected: root.selected_index == 2;
                            focused: root.focused_idx == 2;
                            activate => { root.pick_decoder(2); }
                        }
                    }

                    // Subtitles submenu: Off + one row per track.
                    if root.page == 2: VerticalLayout {
                        width: 100%;
                        spacing: 4px;
                        if root.subtitle_addon_status > 0: SubtitleAddonStatus { status: root.subtitle_addon_status; }
                        MenuRow {
                            reveal(y, h) => { root.reveal_row(y, h); }
                            label: @tr("Use global default");
                            value: root.subtitle_preference_saved
                                ? @tr("Saved for this title") : @tr("Using global default");
                            selected: !root.subtitle_preference_saved;
                            focused: root.focused_idx == 0;
                            activate => { root.restore_playback_default(1); }
                        }
                        MenuRow {
                            reveal(y, h) => { root.reveal_row(y, h); }
                            icon_kind: 2;
                            label: @tr("Off");
                            focused: root.focused_idx == 1;
                            activate => { root.pick_sub(-1); }
                        }
                        for t[i] in root.sub_tracks: MenuRow {
                            reveal(y, h) => { root.reveal_row(y, h); }
                            icon_kind: 2;
                            label: t.lang + (t.title != "" ? " — " + t.title : "");
                            value: t.codec;
                            selected: t.selected;
                            focused: root.focused_idx == i + 2;
                            activate => { root.pick_sub(t.index); }
                        }
                    }

                    // Audio submenu: one row per track.
                    if root.page == 3: VerticalLayout {
                        width: 100%;
                        spacing: 4px;
                        MenuRow {
                            reveal(y, h) => { root.reveal_row(y, h); }
                            label: @tr("Use global default");
                            value: root.audio_preference_saved
                                ? @tr("Saved for this title") : @tr("Using global default");
                            selected: !root.audio_preference_saved;
                            focused: root.focused_idx == 0;
                            activate => { root.restore_playback_default(0); }
                        }
                        if root.audio_tracks.length == 0: Rectangle {
                            height: 44px;

                            Text {
                                text: @tr("No tracks available.");
                                color: Theme.current.text_player_muted;
                                font-size: InterfaceStyle.tv ? 20px : 13px;
                                x: 16px;
                                vertical-alignment: center;
                            }
                        }
                        for t[i] in root.audio_tracks: MenuRow {
                            reveal(y, h) => { root.reveal_row(y, h); }
                            icon_kind: 1;
                            label: t.lang + (t.title != "" ? " — " + t.title : "");
                            value: t.codec;
                            selected: t.selected;
                            focused: root.focused_idx == i + 1;
                            activate => { root.pick_audio(t.index); }
                        }
                    }

                    if root.page == 5: VerticalLayout {
                        width: 100%; spacing: 12px;
                        MenuRow {
                            reveal(y, h) => { root.reveal_row(y, h); }
                            label: @tr("Use global defaults");
                            value: root.subtitle_style_preference_saved ? @tr("Saved for this title") : @tr("Using global default");
                            selected: !root.subtitle_style_preference_saved;
                            focused: root.focused_idx == 0;
                            activate => { root.restore_playback_default(3); }
                        }
                        SubtitleControls {
                            values: root.subtitle_style;
                            focused_idx: root.focused_idx - 1;
                            edited(i, v) => { root.subtitle_style_changed(i, v); }
                            reveal(y, h) => {
                                let top = y - settings_scroll.absolute-position.y;
                                if top < 0px { settings_scroll.content-y = Math.min(0px, settings_scroll.content-y - top); }
                                else if top + h > settings_scroll.height { settings_scroll.content-y = Math.max(Math.min(0px, settings_scroll.height - settings_scroll.content-height), settings_scroll.content-y - (top + h - settings_scroll.height)); }
                            }
                        }
                    }

                    // Playback rate: the shared slider + ± 0.05 step buttons
                    // (the same control Settings → Player shows).
                    if root.page == 4 && !(PartyBridge.active || PartyBridge.busy): VerticalLayout {
                        width: 100%; spacing: 16px;
                        padding-top: 8px; padding-bottom: 8px;
                        MenuRow {
                            reveal(y, h) => { root.reveal_row(y, h); }
                            label: @tr("Use global default");
                            value: root.speed_preference_saved
                                ? @tr("Saved for this title") : @tr("Using global default");
                            selected: !root.speed_preference_saved;
                            focused: root.focused_idx == 0;
                            activate => { root.restore_playback_default(2); }
                        }
                        Text {
                            text: PlaybackSpeed.label(root.playback_speed);
                            color: Theme.current.text_bright;
                            font-size: 28px; font-weight: 600;
                            horizontal-alignment: center;
                        }
                        speed_ctl := SpeedControl {
                            speed <=> root.playback_speed;
                            roomy: true;
                            show_readout: false;
                            focused: root.focused_idx == 1;
                            changed(v) => { root.speed_changed(v); }
                            stepped(d) => { root.speed_stepped(d); }
                        }
                    }
                }
            }
        }
    }
}

component NextEpisodeAction inherits Rectangle {
    in property <bool> focused;
    callback activate();
    height: Math.max(44px, action_text.preferred-height + 8px);
    border-radius: 8px;
    background: action_touch.has-hover ? Theme.current.player_control_hover : transparent;
    border-width: root.focused ? 2px : 0px;
    border-color: Theme.current.focus_ring;
    accessible-role: button;
    accessible-label: @tr("Choose streams");
    HorizontalLayout {
        padding-left: 4px; padding-right: 4px; spacing: 4px; alignment: center;
        action_text := Text {
            text: @tr("Choose streams"); color: Theme.current.accent_soft;
            font-size: InterfaceStyle.tv ? 20px : 13px; font-weight: 600; wrap: word-wrap; max-lines: 2; overflow: elide;
            vertical-alignment: center; horizontal-alignment: center;
        }
        // Fixed-height icons are top-aligned by a HorizontalLayout. Let the
        // slot fill the button and center the glyph inside that slot.
        Rectangle {
            width: 18px;
            IcChevronRight {
                width: 18px; height: 18px;
                y: (parent.height - self.height) / 2;
                fill: Theme.current.accent_soft;
            }
        }
    }
    action_touch := TouchArea { mouse-cursor: pointer; clicked => { root.activate(); } }
}

// A text-only corner strip keeps the end of the episode visible. Elide long
// titles instead of growing the card, while retaining full-size touch targets.
component NextEpisodeBanner inherits Rectangle {
    in property <string> title;
    in property <string> context;
    in property <int> focused_action: 0;
    callback choose();
    callback dismiss();
    height: banner_row.preferred-height;
    background: Theme.current.player_control;
    border-radius: 10px;
    border-width: 1px; border-color: Theme.current.player_menu_border;
    // Consume empty-card taps; they must not toggle the video OSD.
    TouchArea { width: 100%; height: 100%; }
    banner_row := HorizontalLayout {
        padding: 10px;
        spacing: 8px;
        VerticalLayout {
            spacing: 4px; horizontal-stretch: 1; alignment: center;
            Text {
                text: @tr("Next episode"); font-size: InterfaceStyle.tv ? 18px : 12px;
                color: Theme.current.accent_soft; overflow: elide;
            }
            Text {
                text: root.context + (root.title != root.context ? " · " + root.title : "");
                font-size: InterfaceStyle.tv ? 20px : 13px; font-weight: 600; color: Theme.current.text_bright;
                wrap: no-wrap; overflow: elide;
            }
        }
        next_streams := NextEpisodeAction {
            width: InterfaceStyle.tv ? 160px : 108px;
            focused: root.focused_action == 1;
            activate => { root.choose(); }
        }
        next_dismiss := IconBtn {
            width: 44px; height: 44px;
            focused: root.focused_action == 2;
            accessible-role: button; accessible-label: @tr("Dismiss next episode");
            clicked => { root.dismiss(); }
            IcClose { width: 18px; height: 18px; x: 13px; y: 13px; fill: Theme.current.text_player_secondary; }
        }
    }
}

export component PlayerOverlay {
    // Called after publication only while AppWindow retains baseline focus.
    public function focus_shell() { key_scope.focus(); }

    in property <bool> next_episode_visible;
    in property <string> next_episode_title;
    in property <string> next_episode_context;
    in property <string> next_episode_token;
    callback next_episode_streams(string);
    callback next_episode_dismiss(string);
    property <bool> next_episode_shown: root.next_episode_visible && root.open_popup == 0;
    preferred-width: 100%;
    preferred-height: 100%;

    in-out property <bool> playback_started: false;
    in-out property <bool> is_paused: true;
    in-out property <float> position: 0.0;
    in-out property <float> duration: 0.0;
    in property <float> buffered_until: 0.0;
    in-out property <string> time_text: "00:00 / 00:00";
    in-out property <string> player_status: "";
    in-out property <string> player_title: "";
    in property <string> player_episode_title;
    in property <string> player_show_title;
    in property <bool> screenshot_busy;
    in property <string> screenshot_notice;
    callback take_screenshot();
    // Android/Windows/Linux decoder label: "HW+" = direct hardware decoding,
    // "HW" = copy-back, "SW" = software. Empty elsewhere. Shown as
    // the current value of the settings modal's decoder submenu.
    in-out property <string> decode_label: "";
    // Android/Windows/Linux decoder selection (-1 none, 0 HW+, 1 HW, 2 SW) for the settings
    // modal's checkmark, mirrored from mpv's `hwdec-current`.
    in-out property <int> decoder_selected: -1;
    // Settings-panel submenu page: 0 = root, 1 = decoder, 2 = subtitles,
    // 3 = audio. Driven by the keyboard handler.
    property <int> settings_page: 0;
    // A native menu-row/preset scope may disappear when a submenu changes.
    // The player scope survives every menu body and owns nearest-layer Back.
    changed settings_page => {
        if root.settings_page == 2 { root.tracks_popup_opened(2); }
        if root.settings_page == 1 { root.kb_menu = root.hw_plus_available ? 0 : 1; }
        key_scope.focus();
    }
    // Current-selection summaries shown on the settings panel's root rows.
    in-out property <string> sub_label: "";
    in-out property <string> audio_label: "";
    in property <bool> audio_preference_saved: false;
    in property <bool> subtitle_preference_saved: false;
    in property <bool> speed_preference_saved: false;
    in property <bool> subtitle_style_preference_saved: false;
    in-out property <[float]> subtitle_style: [0, 55, 19, 100, 3, 0, 0];
    callback subtitle_style_changed(int, float);
    in-out property <float> volume: 100.0;
    in-out property <bool> muted: false;
    // Effective title/default rate, separate from the Settings default.
    in-out property <float> playback_speed: 1.0;
    in-out property <bool> is_fullscreen: false;
    in-out property <[TrackRow]> audio_tracks: [];
    in-out property <[TrackRow]> sub_tracks: [];
    in-out property <int> subtitle_addon_status: 0;
    in-out property <bool> osd_visible: true;
    // Whether faded controls may run their actions. Opacity alone does not
    // remove hit-testing, so handlers check this before acting.
    property <bool> controls_active: (
        root.osd_visible || !root.playback_started || root.open_popup != 0
    );
    // A faded control still receives pointer input, so every control handler
    // calls this first. While hidden it wakes the OSD and suppresses the
    // control; while active it simply permits the control.
    function guard_osd_control() -> bool {
        // Pointer input takes ownership from a held remote seek. A delayed
        // key release must not undo a mouse scrub or another clicked action.
        if InterfaceStyle.tv { root.tv_cancel_seek(); }
        if (root.controls_active) {
            return true;
        }
        root.osd_mouse_moved();
        return false;
    }
    // Episode (or show) poster shown behind the loading status until the
    // first video frame arrives.
    in-out property <image> player_poster;

    callback toggle_pause();
    callback seek(float);
    callback seek_relative(float);
    callback close_player();
    callback set_volume(float);
    callback volume_step(float);
    callback toggle_mute();
    callback pick_audio_track(int);
    callback pick_sub_track(int);
    callback restore_playback_default(int);
    // Android/Windows/Linux runtime decoder pick (0 = HW+, 1 = HW, 2 = SW).
    callback pick_decoder(int);
    // Playback rate: slider value / ± one 0.05 step (quantized in the backend).
    callback playback_speed_changed(float);
    callback playback_speed_stepped(int);
    // Transient rate preview (press-and-hold 2×): pushed straight into the
    // running session, never stored or persisted — the release restores the
    // stored rate through this same callback.
    callback playback_speed_preview(float);
    callback playback_speed_preview_end();
    // Android swipe gestures: brightness notches (±1 per 40px, the backend
    // scales to ±0.05 and mirrors the level into `player_brightness`) and
    // system-volume notches (the system panel is the readout).
    callback android_brightness_step(int);
    callback android_volume_step(int);
    // Session brightness level (0..1) for the swipe readout, mirrored from
    // the backend after every step.
    in-out property <float> player_brightness: 0.5;
    // The settings modal opened; ask the backend for the live decoder
    // state so the submenu is correct immediately.
    callback settings_opened();
    callback toggle_fullscreen();
    callback osd_mouse_moved();
    // Live OSD scrim opacity (0 = fully hidden), for display frame-rate matching.
    callback osd_opacity_changed(float);
    callback subtitle_clearance_changed(float, float);
    callback header_geometry_changed(length);
    callback tracks_popup_opened(int);
    pure callback format_time(float) -> string;
    pure callback format_volume(float) -> string;
    // Keyboard modality (bound to AppWindow).
    in-out property <bool> kb_active;
    in property <int> system_back_request: 0;
    property <int> last_system_back_request: -1;

    changed system_back_request => {
        if (root.last_system_back_request >= 0
            && root.system_back_request != root.last_system_back_request) {
            root.last_system_back_request = root.system_back_request;
            root.system_back();
        }
    }

    // Tab/Shift+Tab visits OSD controls; arrow keys directly seek or change
    // volume unless a popup owns them for its existing menu navigation.
    // 0 exit, 1 pause, 2 volume, 3/4 seek, 5/6 tracks, 7 settings,
    // 8 fullscreen, 9 screenshot, 10/11 next-episode actions.
    property <int> kb_idx: 1;
    property <int> kb_menu: 0;

    // TV has two focus rows: the bottom buttons and the seek timeline (12).
    // A held seek previews locally; one release produces one decoder seek.
    property <bool> tv_timeline_focused: InterfaceStyle.tv && root.kb_active && root.kb_idx == 12;
    private property <bool> tv_mode: InterfaceStyle.tv;
    changed tv_mode => { root.tv_cancel_seek(); root.kb_idx = 1; root.kb_active = root.tv_mode; }
    property <bool> tv_scrubbing: false;
    property <float> tv_seek_position: 0;
    property <int> tv_seek_repeats: 0;
    private property <float> displayed_position: root.tv_scrubbing ? root.tv_seek_position : root.position;

    function tv_can_seek() -> bool {
        return root.timeline_control_allowed && root.playback_started && root.duration > 0;
    }
    function tv_show_controls() {
        root.kb_active = true;
        root.kb_idx = root.timeline_control_allowed ? 1 : 5;
        root.osd_mouse_moved();
    }
    function tv_cancel_seek() { root.tv_scrubbing = false; root.tv_seek_repeats = 0; }
    function tv_preview_seek(direction: int, repeated: bool) {
        if !root.tv_can_seek() { return; }
        if !root.tv_scrubbing {
            root.tv_seek_position = root.position;
            root.tv_seek_repeats = 0;
            root.tv_scrubbing = true;
        }
        root.tv_seek_repeats = repeated ? root.tv_seek_repeats + 1 : 0;
        let step = root.tv_seek_repeats >= 16 ? 60 : root.tv_seek_repeats >= 8 ? 30 : 10;
        root.tv_seek_position = Math.clamp(root.tv_seek_position + direction * step, 0, root.duration);
        if root.controls_active { root.osd_mouse_moved(); }
    }
    function tv_commit_seek() {
        if !root.tv_scrubbing { return; }
        let target = root.tv_seek_position;
        let allowed = root.tv_can_seek();
        root.tv_cancel_seek();
        if allowed { root.seek(Math.clamp(target, 0, root.duration)); }
    }
    // Slint 1.18 has no media-key enum; the Android backend reserves these
    // codes and the window consumes them outside playback (never editor text).
    function media_key(text: string, repeated: bool) -> bool {
        if text == "\u{e100}" || text == "\u{e101}" || text == "\u{e102}" {
            if !repeated && root.timeline_control_allowed && root.playback_started
                && (text == "\u{e100}" || (text == "\u{e101}" && root.is_paused)
                    || (text == "\u{e102}" && !root.is_paused)) { root.toggle_pause(); }
            return true;
        }
        if text == "\u{e103}" { if !repeated { root.close_player(); } return true; }
        if text == "\u{e104}" {
            if !repeated && root.timeline_control_allowed && root.next_episode_visible {
                root.next_episode_streams(root.next_episode_token);
            }
            return true;
        }
        if text == "\u{e105}" { return true; }
        if text == "\u{e106}" || text == "\u{e107}" {
            root.shortcut_seek(text == "\u{e106}" ? -1 : 1); return true;
        }
        return false;
    }
    property <int> tv_last_control: 1;
    function tv_direction(text: string, repeated: bool) {
        root.kb_active = true;
        if !root.controls_active {
            if text == Key.LeftArrow || text == Key.RightArrow {
                root.tv_preview_seek(text == Key.LeftArrow ? -1 : 1, repeated);
            } else if !repeated { root.tv_show_controls(); }
            return;
        }
        root.osd_mouse_moved();
        if text == Key.UpArrow {
            if root.kb_idx == 12 {
                if !repeated { root.tv_commit_seek(); root.osd_visible = false; root.kb_active = false; }
            } else if root.tv_can_seek() { root.tv_last_control = root.kb_idx; root.kb_idx = 12; }
        } else if text == Key.DownArrow {
            if root.kb_idx == 12 {
                root.tv_commit_seek();
                root.kb_idx = root.tv_control_available(root.tv_last_control) ? root.tv_last_control : 7;
            } else if !repeated { root.osd_visible = false; root.kb_active = false; }
        } else if text == Key.LeftArrow || text == Key.RightArrow {
            let direction = text == Key.LeftArrow ? -1 : 1;
            if root.kb_idx == 12 { root.tv_preview_seek(direction, repeated); }
            else { root.tv_step_control(direction); }
        }
    }
    // Only present, enabled bottom-row controls participate in TV traversal.
    function tv_control_available(index: int) -> bool {
        if index == 1 { return root.timeline_control_allowed; }
        if index == 3 || index == 4 { return root.tv_can_seek(); }
        if index == 5 || index == 6 { return !root.narrow; }
        if index == 7 { return true; }
        if index == 9 { return root.playback_started && !root.screenshot_busy; }
        if index == 10 { return root.next_episode_shown && root.timeline_control_allowed; }
        return index == 11 && root.next_episode_shown;
    }
    function tv_step_control(direction: int) {
        // Bound the walk: unavailable track/screenshot/party actions cannot trap focus.
        let first = Math.clamp(root.kb_idx + direction, 1, 11);
        if root.tv_control_available(first) { root.kb_idx = first; return; }
        let second = Math.clamp(first + direction, 1, 11);
        if root.tv_control_available(second) { root.kb_idx = second; return; }
        let third = Math.clamp(second + direction, 1, 11);
        if root.tv_control_available(third) { root.kb_idx = third; return; }
        let fourth = Math.clamp(third + direction, 1, 11);
        if root.tv_control_available(fourth) { root.kb_idx = fourth; return; }
        let fifth = Math.clamp(fourth + direction, 1, 11);
        if root.tv_control_available(fifth) { root.kb_idx = fifth; }
    }
    // An input held beyond the ordinary three-second timeout stays interactive.
    tv_seek_wake := Timer {
        interval: 1s;
        running: InterfaceStyle.tv && root.tv_scrubbing && root.osd_visible;
        triggered => { root.osd_mouse_moved(); }
    }

    function kb_menu_first() -> int {
        return root.open_popup == 4 && root.settings_page == 1 && !root.hw_plus_available ? 1 : 0;
    }

    function kb_menu_n() -> int {
        if (root.open_popup == 2) {
            return root.sub_tracks.length + 1;
        }
        if (root.open_popup == 1) {
            return root.audio_tracks.length;
        }
        if (root.open_popup == 4) {
            if (root.settings_page == 0) {
                // Subtitles, audio, [decoder on Android/Windows/Linux], playback speed.
                return root.decoder_available ? 5 : 4;
            }
            if (root.settings_page == 1) {
                return 3;
            }
            if (root.settings_page == 2) {
                return root.sub_tracks.length + 2;
            }
            if (root.settings_page == 3) {
                return root.audio_tracks.length + 1;
            }
            if root.settings_page == 5 { return 8; }
            if (root.settings_page == 4) {
                // Reset row + playback-rate slider.
                return 2;
            }
        }
        return 0;
    }

    // Back out of the settings panel: one page at a time, then close.
    function settings_back() {
        if (root.settings_page != 0) {
            root.settings_page = 0;
            root.kb_menu = 0;
        } else {
            root.open_popup = 0;
        }
    }

    function system_back() {
        if InterfaceStyle.tv {
            if root.tv_scrubbing { root.tv_cancel_seek(); }
            else if root.open_popup == 4 { root.settings_back(); }
            else if root.open_popup != 0 { root.open_popup = 0; }
            else if root.osd_visible && root.playback_started { root.osd_visible = false; root.kb_active = false; }
            else if root.next_episode_shown { root.next_episode_dismiss(root.next_episode_token); }
            else { root.close_player(); }
            return;
        }
        root.osd_mouse_moved();
        if (!root.is_android) { root.kb_active = true; }
        if (root.open_popup == 4) {
            root.settings_back();
        } else if (root.open_popup != 0) {
            root.open_popup = 0;
        } else if (root.next_episode_shown) {
            root.next_episode_dismiss(root.next_episode_token);
        } else {
            root.close_player();
        }
    }

    // Screenshot keeps index 9 on both platforms; fullscreen (8) is desktop-only.
    function kb_control_max() -> int {
        if (root.next_episode_shown) { return 11; }
        return 9;
    }

    // Neighbour control in the strip, skipping buttons absent on this
    // layout: the volume control (2) is gone on Android (volume pinned to
    // 100%) and the track buttons (5/6) are hidden on narrow windows.
    function kb_prev() -> int {
        let raw = Math.max(0, root.kb_idx - 1);
        if (root.is_android && raw == 8) { return 7; }
        if (root.is_android && raw == 2) {
            return 1;
        }
        if (root.narrow && (raw == 5 || raw == 6)) {
            return 4;
        }
        return raw;
    }

    function kb_next() -> int {
        let raw = Math.min(root.kb_control_max(), root.kb_idx + 1);
        if (root.is_android && raw == 8) { return 9; }
        if (root.is_android && raw == 2) {
            return 3;
        }
        if (root.narrow && (raw == 5 || raw == 6)) {
            return 7;
        }
        return raw;
    }

    private property <bool> timeline_control_allowed: !PartyBridge.busy && (!PartyBridge.active || PartyBridge.is_host);
    changed timeline_control_allowed => {
        if !root.timeline_control_allowed { root.tv_cancel_seek(); }
        if InterfaceStyle.tv { root.kb_clamp_focus(); }
    }
    private property <bool> party_owns_playback: (PartyBridge.active || PartyBridge.busy);
    changed party_owns_playback => {
        if root.party_owns_playback {
            hold_timer.stop();
            if root.hold_active {
                root.hold_active = false;
                root.flash_show = false;
                root.playback_speed_preview_end();
            }
            if root.settings_page == 4 { root.settings_page = 0; root.kb_menu = 0; }
        }
    }
    function shortcut_seek(d: int) {
        // Unknown/live duration cannot provide a valid upper seek bound.
        if (!root.timeline_control_allowed || !root.playback_started || root.duration <= 0) { return; }
        root.seek_relative(d * 10);
    }

    function shortcut_volume(d: int) {
        if (root.is_android) { root.android_volume_step(d); }
        else { root.volume_step(d * 5); }
    }

    function kb_activate() {
        if (root.kb_idx == 10 && root.next_episode_shown) {
            root.next_episode_streams(root.next_episode_token);
        } else if (root.kb_idx == 11 && root.next_episode_shown) {
            root.next_episode_dismiss(root.next_episode_token);
        } else if (root.kb_idx == 9) {
            if (root.playback_started && !root.screenshot_busy) { root.take_screenshot(); }
        } else if (root.kb_idx == 0) {
            root.close_player();
        } else if (root.kb_idx == 1) {
            if root.timeline_control_allowed { root.toggle_pause(); }
        } else if (root.kb_idx == 2 && !root.is_android) {
            root.toggle_mute();
        } else if (root.kb_idx == 3) {
            if root.timeline_control_allowed && (!InterfaceStyle.tv || root.tv_can_seek()) { root.seek_relative(-10); }
        } else if (root.kb_idx == 4) {
            if root.timeline_control_allowed && (!InterfaceStyle.tv || root.tv_can_seek()) { root.seek_relative(10); }
        } else if (root.kb_idx == 5) {
            if (root.open_popup == 2) {
                root.open_popup = 0;
            } else {
                root.open_popup = 2;
                root.tracks_popup_opened(2);
            }
        } else if (root.kb_idx == 6) {
            if (root.open_popup == 1) {
                root.open_popup = 0;
            } else {
                root.open_popup = 1;
                root.tracks_popup_opened(1);
            }
        } else if (root.kb_idx == 7) {
            // Gear: settings panel (subtitles/audio + Android/Windows/Linux decoder).
            root.settings_page = 0;
            root.open_popup = 4;
            root.settings_opened();
            root.tracks_popup_opened(0);
            root.osd_mouse_moved();
        } else if (root.kb_idx == 8 && !root.is_android) {
            root.toggle_fullscreen();
        }
    }

    function kb_menu_pick() {
        if (root.open_popup == 2) {
            if (root.kb_menu == 0) {
                root.pick_sub_track(-1);
            } else if (root.kb_menu - 1 < root.sub_tracks.length) {
                root.pick_sub_track(root.sub_tracks[root.kb_menu - 1].index);
            }
        } else if (root.open_popup == 1) {
            if (root.kb_menu < root.audio_tracks.length) {
                root.pick_audio_track(root.audio_tracks[root.kb_menu].index);
            }
        } else if (root.open_popup == 4) {
            if (root.settings_page == 0) {
                // Open the focused submenu. The rate row is last on both
                // layouts (Android, Windows and Linux have a decoder row before it).
                if (root.kb_menu == 0) {
                    root.settings_page = 2;
                    root.kb_menu = 0;
                } else if (root.kb_menu == 1) {
                    root.settings_page = 3;
                    root.kb_menu = 0;
                } else if (root.decoder_available && root.kb_menu == 2) {
                    root.settings_page = 1;
                    root.kb_menu = root.hw_plus_available ? 0 : 1;
                } else if root.kb_menu == (root.decoder_available ? 4 : 3) {
                    root.settings_page = 5;
                    root.kb_menu = 0;
                } else if !(PartyBridge.active || PartyBridge.busy) {
                    root.settings_page = 4;
                    root.kb_menu = 0;
                }
            } else if (root.settings_page == 1) {
                if (root.kb_menu >= root.kb_menu_first() && root.kb_menu < 3) {
                    root.pick_decoder(root.kb_menu);
                }
                root.open_popup = 0;
            } else if (root.settings_page == 2) {
                if (root.kb_menu == 0) {
                    root.restore_playback_default(1);
                } else if (root.kb_menu == 1) {
                    root.pick_sub_track(-1);
                    root.open_popup = 0;
                } else if (root.kb_menu - 2 < root.sub_tracks.length) {
                    root.pick_sub_track(root.sub_tracks[root.kb_menu - 2].index);
                    root.open_popup = 0;
                }
            } else if (root.settings_page == 3) {
                if (root.kb_menu == 0) {
                    root.restore_playback_default(0);
                } else if (root.kb_menu - 1 < root.audio_tracks.length) {
                    root.pick_audio_track(root.audio_tracks[root.kb_menu - 1].index);
                    root.open_popup = 0;
                }
            } else if root.settings_page == 5 && root.kb_menu == 0 {
                root.restore_playback_default(3);
            } else if root.settings_page == 5 && root.kb_menu == 6 {
                root.subtitle_style_changed(5, Math.mod(root.subtitle_style[5] + 1, 3));
            } else if root.settings_page == 5 && root.kb_menu == 7 {
                root.subtitle_style_changed(6, root.subtitle_style[6] >= 0.5 ? 0 : 1);
            } else if (root.settings_page == 4 && root.kb_menu == 0) {
                root.restore_playback_default(2);
            }
        }
    }

    // Internal: which popup is open (0=none, 1=audio, 2=subs, 4=settings).
    private property <int> open_popup: 0;

    // Android: touch input and the decoder section in the settings panel.
    in property <bool> is_android: false;
    in property <bool> desktop_decoder_available: false;
    in property <bool> hw_plus_available: true;
    property <bool> decoder_available: root.is_android || root.desktop_decoder_available;
    // Compact control bar for narrow (portrait) windows.
    in property <bool> narrow;
    // Top system-bar inset (Android status bar): Window.safe-area-insets,
    // bound by AppWindow. 0 on desktop/web, so layout there is unchanged.
    in property <length> safe-top: 0px;
    // Side insets: in landscape the display cutout / gesture area moves to the
    // left or right edge, so the close button and control row must clear it.
    in property <length> safe-left: 0px;
    in property <length> safe-right: 0px;

    // Keep the keyboard focus on a present control when the layout flips:
    // the subs/audio buttons (5/6) only exist on wide layouts and the
    // fullscreen button (8) is hidden on Android (the system affordance is
    // used there).
    function kb_clamp_focus() {
        if InterfaceStyle.tv {
            if root.kb_idx == 12 && root.tv_can_seek() { return; }
            if !root.tv_control_available(root.kb_idx) { root.kb_idx = 7; }
            return;
        }
        if (!root.next_episode_shown && root.kb_idx > 9) { root.kb_idx = 1; }
        if (root.narrow && (root.kb_idx == 5 || root.kb_idx == 6)) {
            root.kb_idx = 7;
        }
        if (root.is_android && root.kb_idx == 8) {
            root.kb_idx = 7;
        }
        if (root.is_android && root.kb_idx == 2) {
            root.kb_idx = 1;
        }
    }
    changed narrow => { root.kb_clamp_focus(); }
    changed is_android => { root.kb_clamp_focus(); }
    changed next_episode_shown => { root.kb_clamp_focus(); }
    changed playback_started => {
        if !root.playback_started { root.tv_cancel_seek(); }
        if InterfaceStyle.tv { root.kb_clamp_focus(); }
    }
    changed duration => { if root.duration <= 0 { root.tv_cancel_seek(); root.kb_clamp_focus(); } }
    changed screenshot_busy => { if InterfaceStyle.tv { root.kb_clamp_focus(); } }

    // Hover movement over the bar itself re-arms the auto-hide countdown.
    // TouchArea.moved only fires while pressed and the backdrop's mouse-x/y
    // freeze while the pointer is over OSD elements — without this the
    // timer expires while e.g. adjusting the volume slider and the bar
    // vanishes the instant the cursor leaves it.
    //
    // Only wake on an actual position change: the press/release writes set
    // mouse-x/y through a binding whose `changed` can fire even when the value
    // is unchanged (e.g. the release of a tap). Waking on that would re-show an
    // OSD the tap just dismissed.
    in-out property <length> osd_mouse_pos_x: osd_hover.mouse-x;
    in-out property <length> osd_mouse_pos_y: osd_hover.mouse-y;
    private property <length> osd_last_wake_x: 0px;
    private property <length> osd_last_wake_y: 0px;
    function osd_note_pos() {
        if (root.osd_mouse_pos_x != root.osd_last_wake_x
            || root.osd_mouse_pos_y != root.osd_last_wake_y) {
            root.osd_last_wake_x = root.osd_mouse_pos_x;
            root.osd_last_wake_y = root.osd_mouse_pos_y;
            if (!root.hold_active) { root.osd_mouse_moved(); }
        }
    }
    changed osd_mouse_pos_x => { root.osd_note_pos(); }
    changed osd_mouse_pos_y => { root.osd_note_pos(); }

    // Mirror the OSD scrim's animated opacity up to the backend (through
    // AppWindow's `osd_opacity_changed`) so the display frame rate snaps to the
    // content rate only once the OSD has fully faded out, not when the logical
    // `osd_visible` flag flips.
    private property <float> osd_current_opacity: osd.opacity;
    // Initial opacity can already equal its target (for example with motion
    // disabled), so a change notification alone would leave parent overlays
    // using an old value from the previous playback session.
    init => {
        root.osd_opacity_changed(osd_current_opacity);
        root.publish_subtitle_clearance();
        root.header_geometry_changed(root.header_bottom);
    }
    changed osd_current_opacity => {
        root.osd_opacity_changed(osd_current_opacity);
        root.publish_subtitle_clearance();
    }
    // Both controls and the independent episode offer occupy subtitle space.
    // Measure their top edge with a small gap; keep the existing OSD fade when
    // no offer is mounted. Ratios cancel display density and stay below halfway
    // up the viewport even on short landscape screens.
    private property <float> subtitle_clearance_fraction: root.height > 0px
        ? Math.clamp(Math.max(osd.height + 8px,
            root.next_episode_shown ? root.next_episode_clearance : 0px) / root.height, 0, 0.5) : 0;
    // A conditional banner's id is scoped to its own subtree. It publishes
    // its measured top edge here rather than escaping that Slint scope.
    private property <length> next_episode_clearance;
    private property <float> subtitle_clearance_opacity: root.next_episode_shown ? 1 : osd_current_opacity;
    function publish_subtitle_clearance() {
        root.subtitle_clearance_changed(root.subtitle_clearance_fraction, root.subtitle_clearance_opacity);
    }
    changed subtitle_clearance_fraction => {
        root.publish_subtitle_clearance();
    }
    changed subtitle_clearance_opacity => { root.publish_subtitle_clearance(); }
    private property <length> header_bottom: player_header.y + player_header.height;
    changed header_bottom => { root.header_geometry_changed(root.header_bottom); }

    // Re-arm the OSD wake whenever a popup opens or closes: while browsing
    // a popup the pointer sits over the card, which is above the video
    // TouchArea that mirrors mouse movement — so the auto-hide countdown
    // expires in the background and the bar would vanish the instant the
    // popup closes, even though the cursor was moving the whole time.
    // (Also resets the keyboard track-list index.)
    changed open_popup => {
        key_scope.focus();
        // Popup teardown can destroy a pressed/hovered slider without running
        // its release handler. Reopening starts with a fresh scroll gesture.
        SliderGesture.active = false;
        SliderGesture.hovered = false;
        tap_timer.stop();
        root.tap_side = -2;
        root.kb_menu = 0;
        if InterfaceStyle.tv { root.kb_active = true; }
        root.osd_mouse_moved();
    }

    // ---- Backdrop gesture state (see player_backdrop below) ------------
    // Seekable outer-third taps wait for the double-tap window (280 ms),
    // so seeking cannot flash the OSD or toggle desktop playback first.
    // Centre taps act at once. A stationary 500 ms press previews 2×; an
    // Android vertical swipe steps brightness/volume. `tap_side`: the side
    // of the last tap (-1 left, 0 middle, +1 right, -2 none).
    property <int> tap_side: -2;
    property <bool> tap_osd_visible: false;
    property <bool> hold_active: false;
    // Swipe kind: 0 none, 1 brightness (left half), 2 volume (right half).
    property <int> swipe_kind: 0;
    property <length> swipe_py: 0px;
    property <length> swipe_accum: 0px;
    // Transient centre-top readout ("-10 s", "+10 s", "2×", "70%").
    property <string> flash_text: "";
    property <bool> flash_show: false;

    tap_timer := Timer {
        interval: 280ms;
        running: false;
        triggered => {
            self.running = false;
            // Pairing window lapsed: apply the single tap only now.
            root.tap_side = -2;
            root.backdrop_single_tap(root.tap_osd_visible);
        }
    }

    function backdrop_single_tap(was_visible: bool) {
        // Hover can reveal the controls before a click. Playback intent must
        // not depend on whether that hover happened to wake the OSD first.
        if InterfaceStyle.tv {
            if root.timeline_control_allowed && root.playback_started { root.toggle_pause(); }
            root.tv_show_controls();
        } else if (!root.is_android) {
            if root.timeline_control_allowed { root.toggle_pause(); }
            root.osd_mouse_moved();
        } else if (was_visible) {
            root.osd_visible = false;
        } else {
            root.osd_mouse_moved();
        }
    }

    hold_timer := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.stop();
            if (!(PartyBridge.active || PartyBridge.busy) && root.playback_started && root.duration > 0.0 && !root.hold_active) {
                root.hold_active = true;
                tap_timer.stop();
                root.tap_side = -2;
                root.swipe_kind = 0;
                root.playback_speed_preview(2.0);
                // Speed feedback must not reveal the transport controls.
                root.flash_text = "2×";
                root.flash_show = true;
            }
        }
    }

    flash_timer := Timer {
        interval: 800ms;
        running: false;
        triggered => {
            self.running = false;
            if (!root.hold_active) {
                root.flash_show = false;
            }
        }
    }

    function show_flash(text: string) {
        root.flash_text = text;
        root.flash_show = true;
        flash_timer.stop();
        flash_timer.start();
    }

    // Release handling for the backdrop (the press position rides along
    // because functions cannot see the TouchArea's `self`).
    function backdrop_release(up_x: length, w: length) {
        if (root.hold_active) {
            root.hold_active = false;
            root.flash_show = false;
            root.playback_speed_preview_end();
            tap_timer.stop();
            root.tap_side = -2;
            return;
        }
        if (root.swipe_kind != 0) {
            // The brightness readout (if any) fades on its own timer.
            root.swipe_kind = 0;
            return;
        }
        if (player_backdrop.dragged) {
            // Plain drag ended (a swipe that woke the OSD): wake only.
            root.osd_mouse_moved();
            player_backdrop.dragged = false;
            return;
        }
        if (root.open_popup != 0) {
            root.open_popup = 0;
            return;
        }
        // A second tap on the same side consumes the pending single tap.
        // Neither tap may wake controls or change pause state while seeking.
        let can_seek = root.timeline_control_allowed && root.playback_started && root.duration > 0.0;
        let side = up_x < w / 3 ? -1 : (up_x > w * 2 / 3 ? 1 : 0);
        if (can_seek && side != 0 && player_backdrop.double_tap_pending && side == root.tap_side) {
            tap_timer.stop();
            player_backdrop.double_tap_pending = false;
            root.tap_side = -2;
            root.seek_relative(side * 10.0);
            root.show_flash(side < 0 ? "-10 s" : "+10 s");
            return;
        }
        if (tap_timer.running) {
            // Different regions are independent single taps, not a seek.
            tap_timer.stop();
            root.tap_side = -2;
            root.backdrop_single_tap(root.tap_osd_visible);
            player_backdrop.osd_visible_at_press = root.osd_visible;
        }
        let was_visible = player_backdrop.osd_visible_at_press;
        if (can_seek && side != 0) {
            root.tap_osd_visible = was_visible;
            root.tap_side = side;
            tap_timer.start();
        } else {
            root.backdrop_single_tap(was_visible);
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;

        // Arrows seek/adjust volume, Tab navigates controls, and Escape
        // closes the nearest popup/offer, then the stream. The scope takes focus
        // on creation so it keeps receiving keys while the overlay is up.
        // Only control/menu navigation wakes the OSD. Direct playback shortcuts
        // leave a hidden overlay hidden and do not enter focus-marker mode.
        key_scope := FocusScope {
            width: 100%;
            height: 100%;
            changed has-focus => { if !self.has-focus { root.tv_cancel_seek(); } }
            init => {
                self.focus();
                root.last_system_back_request = root.system_back_request;
            }
            key-pressed(e) => {
                if root.media_key(e.text, e.repeat) {
                    accept
                } else if InterfaceStyle.tv && root.open_popup == 0
                    && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta
                    && (e.text == Key.UpArrow || e.text == Key.DownArrow
                        || e.text == Key.LeftArrow || e.text == Key.RightArrow) {
                    root.tv_direction(e.text, e.repeat);
                    accept
                } else if InterfaceStyle.tv && root.open_popup == 0 && e.text == Key.Return
                    && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta {
                    if !e.repeat {
                        if !root.controls_active {
                            root.tv_show_controls();
                            if root.timeline_control_allowed && root.playback_started { root.toggle_pause(); }
                        }
                        else {
                            root.kb_active = true;
                            root.osd_mouse_moved();
                            if root.kb_idx == 12 { root.tv_commit_seek(); }
                            else { root.kb_activate(); }
                        }
                    }
                    accept
                } else {
                if (root.open_popup != 0 || e.text == Key.Tab || e.text == Key.Return) {
                    root.osd_mouse_moved();
                    root.kb_active = true;
                }
                if (e.text == Key.Escape) {
                    if (!e.repeat) {
                        if InterfaceStyle.tv {
                            root.system_back();
                        } else if (root.open_popup == 4) {
                            root.settings_back();
                        } else if (root.open_popup != 0) {
                            root.open_popup = 0;
                        } else if (root.next_episode_shown) {
                            root.next_episode_dismiss(root.next_episode_token);
                        } else {
                            root.close_player();
                        }
                    }
                    accept
                } else if (root.open_popup != 0) {
                    if (root.open_popup == 4) {
                        // Settings panel: Up/Down move the focused row;
                        // Left/Right step playback speed only while its slider
                        // is focused. Right/Enter open submenus, and Left/Back
                        // step back a page then close.
                        if (e.text == Key.UpArrow) {
                            if (root.settings_page == 4) {
                                if (root.kb_menu > 0) {
                                    root.kb_menu -= 1;
                                }
                            } else if (root.kb_menu > root.kb_menu_first()) {
                                root.kb_menu -= 1;
                            }
                            accept
                        } else if (e.text == Key.DownArrow) {
                            if (root.settings_page == 4) {
                                if (root.kb_menu + 1 < root.kb_menu_n()) {
                                    root.kb_menu += 1;
                                }
                            } else if (root.kb_menu + 1 < root.kb_menu_n()) {
                                root.kb_menu += 1;
                            }
                            accept
                        } else if (e.text == Key.RightArrow) {
                            if (root.settings_page == 0) {
                                root.kb_menu_pick();
                            } else if (root.settings_page == 4 && root.kb_menu == 1) {
                                root.playback_speed_stepped(1);
                            } else if root.settings_page == 5 && root.kb_menu > 0 {
                                let i = root.kb_menu - 1;
                                root.subtitle_style_changed(i, root.subtitle_style[i] + SubtitleStyle.step(i));
                            }
                            accept
                        } else if (e.text == Key.Return) {
                            if !e.repeat { root.kb_menu_pick(); }
                            accept
                        } else if (e.text == Key.LeftArrow) {
                            if (root.settings_page == 4 && root.kb_menu == 1) {
                                root.playback_speed_stepped(-1);
                            } else if root.settings_page == 5 && root.kb_menu > 0 {
                                let i = root.kb_menu - 1;
                                root.subtitle_style_changed(i, root.subtitle_style[i] - SubtitleStyle.step(i));
                            } else {
                                root.settings_back();
                            }
                            accept
                        } else if (e.text == Key.Backspace || e.text == Key.Back) {
                            root.settings_back();
                            accept
                        } else {
                            reject
                        }
                    } else if (e.text == Key.UpArrow) {
                        if (root.kb_menu > 0) {
                            root.kb_menu -= 1;
                        }
                        accept
                    } else if (e.text == Key.DownArrow) {
                        if (root.kb_menu + 1 < root.kb_menu_n()) {
                            root.kb_menu += 1;
                        }
                        accept
                    } else if (e.text == Key.Return) {
                        if !e.repeat { root.kb_menu_pick(); }
                        accept
                    } else if (e.text == Key.Backspace || e.text == Key.Back) {
                        root.open_popup = 0;
                        accept
                    } else {
                        reject
                    }
                } else if (e.modifiers.control || e.modifiers.alt || e.modifiers.meta) {
                    reject
                } else if (e.text == " " || e.text == "k" || e.text == "K") {
                    root.kb_active = false;
                    if (!e.repeat && root.timeline_control_allowed) { root.toggle_pause(); }
                    accept
                } else if (e.text == "f" || e.text == "F") {
                    root.kb_active = false;
                    if (!e.repeat && !root.is_android) { root.toggle_fullscreen(); }
                    accept
                } else if (e.text == "s" || e.text == "S") {
                    root.kb_active = false;
                    if (!e.repeat && root.playback_started && !root.screenshot_busy) {
                        root.take_screenshot();
                    }
                    accept
                } else if (e.text == Key.UpArrow) {
                    root.kb_active = false;
                    root.shortcut_volume(1);
                    accept
                } else if (e.text == Key.DownArrow) {
                    root.kb_active = false;
                    root.shortcut_volume(-1);
                    accept
                } else if (e.text == Key.LeftArrow) {
                    root.kb_active = false;
                    root.shortcut_seek(-1);
                    accept
                } else if (e.text == Key.RightArrow) {
                    root.kb_active = false;
                    root.shortcut_seek(1);
                    accept
                } else if (e.text == Key.Tab) {
                    root.kb_idx = e.modifiers.shift ? root.kb_prev() : root.kb_next();
                    accept
                } else if (e.text == Key.Return) {
                    if !e.repeat { root.kb_activate(); }
                    accept
                } else if (e.text == Key.Backspace || e.text == Key.Back) {
                    root.system_back();
                    accept
                } else {
                    reject
                }
                }
            }
            key-released(e) => {
                if InterfaceStyle.tv && (e.text == Key.LeftArrow || e.text == Key.RightArrow) {
                    root.tv_commit_seek(); accept
                } else { reject }
            }
        }

        // Episode (or show) poster while the stream is loading — mpv's
        // surface stays black until the first frame, so this fills the
        // screen. Not interactive: clicks pass through to the backdrop.
        if !root.playback_started && root.player_poster.width > 0: Image {
            width: 100%;
            height: 100%;
            source: root.player_poster;
            image-fit: cover;
        }

        // Video gesture surface. Android singles toggle the OSD; desktop
        // singles toggle playback and show controls. Side taps wait 280 ms:
        // - double-tap the outer thirds to seek ∓10 s (any platform):
        //   seek feedback only, preserving the OSD and pause state;
        // - press-and-hold 500 ms to preview 2× until release (any platform);
        // - on Android, a vertical swipe adjusts brightness (left half) or
        //   the system volume (right half).
        // Taps on actual buttons and the slider never reach this backdrop.
        player_backdrop := TouchArea {
            // A swipe that wakes the OSD must not hide it again on release:
            // `moved` wakes it, so by the time the release runs
            // `osd_visible` is already true and the old logic would hide it
            // immediately (the bar flashed and vanished). Track drags and
            // treat them as wake-only gestures.
            property <bool> dragged: false;
            property <bool> osd_visible_at_press: false;
            property <bool> double_tap_pending: false;
            // Last pointer position that woke the OSD. A tap's release
            // synthesizes a move at the same position; waking on it would
            // re-show an OSD the tap just dismissed.
            property <length> last_wake_x: 0px;
            property <length> last_wake_y: 0px;
            width: 100%;
            height: 100%;
            pointer-event(ev) => {
                if ((ev.kind == PointerEventKind.down || ev.kind == PointerEventKind.up)
                    && ev.button != PointerEventButton.left) { return; }
                if (ev.kind == PointerEventKind.down) {
                    player_backdrop.osd_visible_at_press = root.osd_visible;
                    player_backdrop.dragged = false;
                    player_backdrop.last_wake_x = self.mouse-x;
                    player_backdrop.last_wake_y = self.mouse-y;
                    let side = self.mouse-x < self.width / 3 ? -1
                        : (self.mouse-x > self.width * 2 / 3 ? 1 : 0);
                    player_backdrop.double_tap_pending = root.timeline_control_allowed && root.playback_started
                        && root.duration > 0.0 && root.open_popup == 0
                        && side != 0 && tap_timer.running && side == root.tap_side;
                    if (player_backdrop.double_tap_pending) {
                        // Pair on the second press, so a release just beyond
                        // the deadline cannot fire the pending single first.
                        tap_timer.stop();
                    }
                    // Do not reveal the OSD before we know whether this is
                    // a single tap, double tap, hold, or drag.
                    // Arm press-and-hold 2× (stationary press, active
                    // playback, no popup in the way).
                    if (!(PartyBridge.active || PartyBridge.busy) && root.playback_started && root.duration > 0.0 && root.open_popup == 0) {
                        hold_timer.stop();
                        hold_timer.start();
                    }
                } else if (ev.kind == PointerEventKind.move) {
                    if (self.mouse-x != player_backdrop.last_wake_x
                        || self.mouse-y != player_backdrop.last_wake_y) {
                        player_backdrop.last_wake_x = self.mouse-x;
                        player_backdrop.last_wake_y = self.mouse-y;
                        if (!root.hold_active && (!self.pressed || player_backdrop.dragged)) {
                            root.osd_mouse_moved();
                        }
                    }
                } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                    hold_timer.stop();
                    if (ev.kind == PointerEventKind.cancel) {
                        // Aborted gesture: drop transient state, no tap.
                        if (root.hold_active) {
                            root.hold_active = false;
                            root.flash_show = false;
                            root.playback_speed_preview_end();
                        }
                        root.swipe_kind = 0;
                        tap_timer.stop();
                        root.tap_side = -2;
                        player_backdrop.double_tap_pending = false;
                        player_backdrop.dragged = false;
                    } else {
                        root.backdrop_release(self.mouse-x, self.width);
                    }
                }
            }
            moved => {
                // Once 2× owns the press, finger travel cannot turn it into
                // an OSD wake or a brightness/volume swipe. Up/cancel restores
                // the effective rate through the existing release path.
                if (root.hold_active) { return; }
                if (Math.abs(self.mouse-x - self.pressed-x)
                    + Math.abs(self.mouse-y - self.pressed-y) > 12px) {
                    player_backdrop.dragged = true;
                    // A drag is neither a tap nor a hold.
                    hold_timer.stop();
                    tap_timer.stop();
                    root.tap_side = -2;
                    player_backdrop.double_tap_pending = false;
                    root.osd_mouse_moved();
                }
                // Android brightness/volume swipe: a mostly-vertical drag.
                // Decided here (not on press) so the direction is known, and
                // only while no hold owns the gesture.
                // Android can deliver the start of a notification-shade pull
                // before taking over. Exclude its original top-edge press,
                // even after it travels into the middle of the video.
                if (root.is_android && root.playback_started && root.open_popup == 0
                    && self.pressed-y >= Math.max(48px, root.safe-top + 24px)
                    && !root.hold_active && root.swipe_kind == 0
                    && Math.abs(self.mouse-y - self.pressed-y) > 24px
                    && Math.abs(self.mouse-y - self.pressed-y) > 2 * Math.abs(self.mouse-x - self.pressed-x)) {
                    root.swipe_kind = self.pressed-x < self.width / 2 ? 1 : 2;
                    root.swipe_py = self.mouse-y;
                    // Seed with the full gesture travel so the threshold
                    // pixels count towards the first notch.
                    root.swipe_accum = self.pressed-y - self.mouse-y;
                    hold_timer.stop();
                    tap_timer.stop();
                    root.tap_side = -2;
                }
                if (root.swipe_kind != 0) {
                    root.swipe_accum += root.swipe_py - self.mouse-y;
                    root.swipe_py = self.mouse-y;
                    // One system step per 40px of travel (remainder kept).
                    if (root.swipe_accum >= 40px || root.swipe_accum <= -40px) {
                        let dir = root.swipe_accum > 0px ? 1 : -1;
                        if (root.swipe_kind == 1) {
                            root.android_brightness_step(dir);
                            root.show_flash(Math.round(root.player_brightness * 100) + "%");
                        } else {
                            root.android_volume_step(dir);
                        }
                        root.swipe_accum = root.swipe_accum - dir * 40px;
                    }
                }
            }
        }

        // Transient gesture readout ("-10 s", "+10 s", "2×", "70%"): a
        // top-centre pill that fades on its own timer (2× stays while held).
        // A plain element — taps pass through to the backdrop below.
        // Stay mounted so clearing the flag can animate out; actions and the
        // transient playback rate still change immediately, not after a fade.
        // Dim the entire video or loading artwork behind the controls. Anchor to the viewport,
        // not to the bottom control lane or the title's measured height.
        osd_scrim := Rectangle {
            x: 0px; y: 0px;
            width: 100%; height: 100%;
            background: Theme.current.scrim_player;
            opacity: root.controls_active ? 0.35 : 0;
            animate opacity { duration: Anim.player_fade; }
        }
        // Loading/error text paints above the shared dim layer so it stays
        // as readable as the controls over paused video.
        if !root.playback_started && root.player_status != "": loading_status := VerticalLayout {
            width: 100%; height: 100%; alignment: center;
            HorizontalLayout {
                width: 100%; alignment: center;
                Text {
                    text: root.player_status; color: Theme.current.text_bright;
                    font-size: 18px; horizontal-alignment: center;
                    wrap: word-wrap; width: 80%;
                }
            }
        }
        flash_pill := Rectangle {
            x: root.safe-left + (root.width - root.safe-left - root.safe-right - self.width) / 2;
            y: (root.flash_show ? 16px : 10px) + root.safe-top;
            width: flash_lbl.preferred-width + 28px;
            height: 36px;
            border-radius: 18px;
            background: Theme.current.scrim_player_feedback;
            opacity: root.flash_show ? 1.0 : 0.0;
            animate opacity { duration: Anim.player_fast; easing: ease-out; }
            animate y { duration: Anim.player_slide; easing: ease-out; }

            flash_lbl := Text {
                text: root.flash_text;
                font-size: 15px;
                font-weight: 700;
                color: Theme.current.text_bright;
                x: 0px; y: 0px;
                width: 100%; height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        player_header := VerticalLayout {
            // Gestures briefly own the caption lane; keep the feedback at
            // its stable top position. Keep the header mounted so titles can
            // fade out and back in without changing their measured geometry.
            x: root.safe-left + (InterfaceStyle.tv ? 32px : 68px); y: root.safe-top + (InterfaceStyle.tv ? 24px : 16px);
            width: Math.max(0px, root.width - root.safe-left - root.safe-right - 140px);
            height: episode_heading.height + show_heading.height + 6px;
            spacing: 6px;
            opacity: root.controls_active && !root.flash_show ? 1 : 0;
            animate opacity { duration: Anim.player_fade; }
            episode_heading := Text {
                text: root.player_episode_title;
                height: root.player_episode_title == "" ? 0px : (InterfaceStyle.tv ? 28px : 22px);
                font-size: InterfaceStyle.tv ? 20px : (root.narrow ? 14px : 16px);
                font-weight: 600; color: Theme.current.text_bright;
                overflow: elide; max-lines: 1;
            }
            show_heading := Text {
                text: root.player_show_title;
                width: 100%; height: self.preferred-height;
                font-size: InterfaceStyle.tv ? 32px : (root.narrow ? 20px : 26px);
                font-weight: 800; color: Theme.current.text_bright;
                overflow: elide; max-lines: 1;
            }
        }
        screenshot_button := Rectangle {
            visible: !InterfaceStyle.tv;
            x: root.width - root.safe-right - self.width - 16px;
            y: root.safe-top + 16px;
            width: 40px; height: 40px; border-radius: 20px;
            property <bool> can_capture: root.playback_started && !root.screenshot_busy;
            accessible-role: button; accessible-label: @tr("Take screenshot");
            accessible-enabled: self.can_capture;
            border-width: root.kb_active && root.kb_idx == 9 && root.open_popup == 0 ? 2px : 0px;
            border-color: Theme.current.focus_ring;
            background: screenshot_touch.has-hover ? Theme.current.player_control_hover : Theme.current.player_control;
            opacity: root.controls_active ? 1 : 0;
            animate opacity { duration: Anim.player_fade; }
            IcCamera {
                x: 8px; y: 8px; width: 24px; height: 24px;
                fill: Theme.current.text_bright;
                opacity: screenshot_button.can_capture ? 1 : 0.4;
            }
            screenshot_touch := TouchArea {
                width: 100%; height: 100%; mouse-cursor: pointer;
                clicked => {
                    if (!root.guard_osd_control()) { return; }
                    root.kb_active = false; root.kb_idx = 9;
                    if (screenshot_button.can_capture) { root.take_screenshot(); }
                }
            }
        }
        screenshot_message := Text {
            visible: root.screenshot_notice != "";
            x: Math.max(root.safe-left + 16px, root.width - root.safe-right - self.width - 16px);
            y: root.safe-top + 16px + Math.max(40px, player_header.height) + 8px;
            width: Math.min(240px, Math.max(0px, root.width - root.safe-left - root.safe-right - 32px));
            text: root.screenshot_notice; font-size: InterfaceStyle.tv ? 18px : 12px;
            color: Theme.current.text_player_caption;
            horizontal-alignment: right; wrap: word-wrap; max-lines: 2; overflow: elide;
            // Screenshot confirmation is independent of the controls: S can
            // report its result without revealing the full OSD.
            opacity: root.screenshot_notice != "" ? 1 : 0;
            animate opacity { duration: Anim.player_fade; }
        }

        // ---- Close button (top-left, below the status bar) ---------
        Rectangle {
            x: 16px + safe-left;
            y: 16px + safe-top;
            visible: !InterfaceStyle.tv;
            width: 40px;
            height: 40px;
            border-radius: 20px;
            border-width: root.kb_active && root.kb_idx == 0 && root.open_popup == 0 ? 2px : 0px;
            border-color: Theme.current.focus_ring;
            // A dark base keeps the white X readable over bright video;
            // hover lightens it.
            background: close_touch.has-hover ? Theme.current.player_close_hover : Theme.current.player_control;
            // Touch hover alone must not paint the bar: the backend wake owns
            // visibility, and a press can otherwise flash and release it.
            opacity: (root.osd_visible || !root.playback_started
                || root.open_popup != 0) ? 1.0 : 0.0;
            animate opacity { duration: Anim.player_fade; }

            IcClose {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 24px;
                height: 24px;
                fill: Theme.current.text_bright;
            }

            close_touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => {
                    if (!root.guard_osd_control()) { return; }
                    root.kb_active = false; root.kb_idx = 0; root.close_player();
                }
            }
        }

        // ---- Android center transport (⏪10 ▶/⏸ ⏩10) ----------------
        // Android has no volume control and no bottom-row play/rw/ff: the
        // transport floats in the middle of the video like a mobile player.
        // Hidden while loading (the centered status text shows instead) and
        // whenever the OSD fades, but still hit-tested so a tap wakes it.
        // Declared *before* the OSD so the track popups and the settings
        // modal paint in front of it; the dark base keeps the glyphs
        // readable over bright video. The three buttons keep their logical
        // keyboard indices (play 1, rewind 3, forward 4); on-screen they read
        // 3, 1, 4 left to right.
        if root.is_android && !InterfaceStyle.tv: Rectangle {
            width: 216px;
            height: 72px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            opacity: (root.controls_active && root.playback_started) ? 1.0 : 0.0;
            animate opacity { duration: Anim.player_fade; }

            // Rewind 10s.
            IconBtn {
                x: 0px;
                y: 10px;
                width: 52px;
                height: 52px;
                border-radius: 26px;
                base: Theme.current.player_control;
                enabled: root.timeline_control_allowed;
                focused: root.kb_active && root.kb_idx == 3 && root.open_popup == 0;
                clicked => {
                    if (!root.guard_osd_control()) { return; }
                    root.kb_active = false;
                    root.kb_idx = 3;
                    root.seek_relative(-10);
                    root.osd_mouse_moved();
                }
                IcReplay10 {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 34px;
                    height: 34px;
                    fill: Theme.current.text_bright;
                }
            }

            // Play/pause (larger, circular).
            IconBtn {
                x: 72px;
                y: 0px;
                width: 72px;
                height: 72px;
                border-radius: 36px;
                base: Theme.current.player_control;
                enabled: root.timeline_control_allowed;
                focused: root.kb_active && root.kb_idx == 1 && root.open_popup == 0;
                clicked => {
                    if (!root.guard_osd_control()) { return; }
                    root.kb_active = false; root.kb_idx = 1; root.osd_mouse_moved(); root.toggle_pause();
                }
                if root.is_paused: IcPlay {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 40px;
                    height: 40px;
                    fill: Theme.current.text_bright;
                }
                if !root.is_paused: IcPause {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 40px;
                    height: 40px;
                    fill: Theme.current.text_bright;
                }
            }

            // Forward 10s.
            IconBtn {
                x: 164px;
                y: 10px;
                width: 52px;
                height: 52px;
                border-radius: 26px;
                base: Theme.current.player_control;
                enabled: root.timeline_control_allowed;
                focused: root.kb_active && root.kb_idx == 4 && root.open_popup == 0;
                clicked => {
                    if (!root.guard_osd_control()) { return; }
                    root.kb_active = false;
                    root.kb_idx = 4;
                    root.seek_relative(10);
                    root.osd_mouse_moved();
                }
                IcForward10 {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 34px;
                    height: 34px;
                    fill: Theme.current.text_bright;
                }
            }
        }

        if InterfaceStyle.tv && root.tv_scrubbing && !root.controls_active: Rectangle {
            width: tv_seek_text.preferred-width + 40px; height: 56px;
            x: (root.width - self.width) / 2; y: root.height - self.height - 40px;
            border-radius: 12px; background: Theme.current.player_control;
            tv_seek_text := Text {
                text: root.format_time(root.tv_seek_position); font-size: 24px;
                color: Theme.current.text_bright;
                width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center;
            }
        }

        // ---- Bottom OSD -------------------------------------------------
        // The video dim layer lives above; this element only owns the bottom
        // controls and their hover/touch area.
        osd := Rectangle {
            width: 100%;
            height: InterfaceStyle.tv ? 132px : 96px;
            y: parent.height - self.height;
            // Visible when the wake timer says so, and always while loading or a
            // popup is open — the auto-hide countdown applies whether playing
            // or paused (with a longer grace while paused). Hover alone does
            // not paint the OSD: a touch can otherwise flash and release it.
            opacity: (root.osd_visible || !root.playback_started
                || root.open_popup != 0) ? 1.0 : 0.0;
            animate opacity { duration: Anim.player_fade; }

            // Hover zone covers only the controls and some headroom.
            // The upper part of the video stays click-through
            // so click-to-pause still works there. Tapping an empty part of
            // the bar (not a button or the seekbar) dismisses the OSD, same as
            // tapping the video — primarily a touch convenience.
            osd_hover := TouchArea {
                width: 100%;
                height: InterfaceStyle.tv ? 132px : 96px;
                y: parent.height - self.height;
                // Like the backdrop: a swipe that wakes the OSD must not hide
                // it again on release, and a tap wakes it when it was down.
                property <bool> dragged: false;
                property <bool> osd_visible_at_press: false;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down) {
                        osd_hover.osd_visible_at_press = root.osd_visible;
                        osd_hover.dragged = false;
                        root.osd_mouse_moved();
                    }
                    // Deliberately no wake on move: a tap's release synthesizes
                    // a move at the same position, which would re-show the OSD
                    // this tap just dismissed. Real drags wake via `moved`, and
                    // hover wakes via the `osd_mouse_pos_*` change handlers.
                }
                moved => {
                    root.osd_mouse_moved();
                    if (Math.abs(self.mouse-x - self.pressed-x)
                        + Math.abs(self.mouse-y - self.pressed-y) > 12px) {
                        osd_hover.dragged = true;
                    }
                }
                clicked => {
                    if (osd_hover.dragged) {
                        // Swipe: keep the just-woken OSD up (restart timer).
                        root.osd_mouse_moved();
                    } else if (osd_hover.osd_visible_at_press) {
                        root.osd_visible = false;
                    } else {
                        root.osd_mouse_moved();
                    }
                }
            }

            VerticalLayout {
                // A layout inside a plain element fills the parent, so pin
                // the 68px of controls (seekbar + row) to the bottom edge.
                height: InterfaceStyle.tv ? 104px : 68px;
                y: parent.height - self.height;
                width: 100%;
                spacing: 0px;

                // ---- Seekbar ---------------------------------------------
                // The track spans the control row's content box exactly
                // (same 10px/14px side insets as the row below), so the bar
                // lines up with the buttons underneath it.
                seekbar := Rectangle {
                    width: 100%;
                    height: InterfaceStyle.tv ? 40px : 20px;

                    track_zone := Rectangle {
                        x: 10px;
                        width: parent.width - 24px;
                        height: 100%;

                        // Dim track.
                        unbuffered_track := Rectangle {
                            x: 0;
                            y: InterfaceStyle.tv ? 17px : 8px;
                            height: root.tv_timeline_focused ? 6px : (InterfaceStyle.tv ? 4px : 3px);
                            width: 100%;
                            background: Theme.current.player_secondary;
                            border-radius: 1.5px;
                        }

                        // Estimated forward cache. Keep it within the unplayed
                        // portion, including while the user moves the seek thumb.
                        buffered_track := Rectangle {
                            x: root.duration > 0 ? Math.clamp(root.position / root.duration, 0, 1) * parent.width : 0px;
                            y: InterfaceStyle.tv ? 17px : 8px;
                            height: root.tv_timeline_focused ? 6px : (InterfaceStyle.tv ? 4px : 3px);
                            width: root.playback_started && root.duration > 0
                                ? Math.max(0, Math.clamp(root.buffered_until / root.duration, 0, 1)
                                    - Math.clamp(root.position / root.duration, 0, 1)) * parent.width
                                : 0px;
                            background: Theme.current.player_buffered_fill;
                            border-radius: 1.5px;
                        }

                        // Played portion (anchored to the left edge).
                        played_track := Rectangle {
                            x: 0;
                            y: InterfaceStyle.tv ? 17px : 8px;
                            height: root.tv_timeline_focused ? 6px : (InterfaceStyle.tv ? 4px : 3px);
                            width: root.duration > 0 ? (root.displayed_position / root.duration) * parent.width : 0;
                            background: Theme.current.player_progress_fill;
                            border-radius: 1.5px;
                        }

                        // Thumb dot — only appears while the bar is hovered
                        // (stays visible while scrubbing).
                        Rectangle {
                            x: Math.clamp(
                                root.duration > 0 ? (root.displayed_position / root.duration) * (parent.width - 11px) : 0,
                                0, parent.width - 11px);
                            y: (parent.height - 11px) / 2;
                            width: 11px;
                            height: 11px;
                            background: Theme.current.player_progress_fill;
                            border-radius: 5.5px;
                            opacity: seek_touch.has-hover || root.tv_timeline_focused ? 1.0 : 0.0;
                            animate opacity { duration: Anim.player_fast; }
                        }

                        seek_touch := TouchArea {
                            enabled: root.timeline_control_allowed;
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            moved => {
                                if (!root.guard_osd_control()) { return; }
                                let pct = Math.clamp(self.mouse-x / self.width, 0, 1);
                                // Move the thumb immediately (the backend only
                                // mirrors mpv's position once the seek applies;
                                // without this the scrub guard would freeze it).
                                root.position = pct * root.duration;
                                root.seek(pct * root.duration);
                                root.osd_mouse_moved();
                            }
                            clicked => {
                                if (!root.guard_osd_control()) { return; }
                                let pct = Math.clamp(self.mouse-x / self.width, 0, 1);
                                root.position = pct * root.duration;
                                root.seek(pct * root.duration);
                                root.osd_mouse_moved();
                            }
                        }

                        // Hover preview: the timestamp under the cursor. Purely
                        // hover-driven (no click needed) and independent of the
                        // actual playback position.
                        if root.duration > 0: Rectangle {
                            width: seek_tip.preferred-width + 12px;
                            height: 20px;
                            x: Math.clamp((root.tv_timeline_focused ? (root.displayed_position / root.duration) * parent.width : seek_touch.mouse-x) - self.width / 2, 0px, parent.width - self.width);
                            y: -self.height - 4px;
                            border-radius: 5px;
                            background: Theme.current.player_tooltip;
                            opacity: seek_touch.has-hover || root.tv_timeline_focused ? 1.0 : 0.0;
                            animate opacity { duration: Anim.player_fast; }

                            seek_tip := Text {
                                text: root.format_time(root.tv_timeline_focused ? root.displayed_position : (seek_touch.mouse-x / seek_touch.width) * root.duration);
                                color: Theme.current.text_bright;
                                font-size: InterfaceStyle.tv ? 18px : 11px;
                                width: 100%;
                                height: 100%;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // ---- Control row ----------------------------------------
                // Stretch distribution: left cluster (play/volume/time) hugs
                // the left edge, the track controls hug the right edge, and
                // the title stretches in between (centered within).
                HorizontalLayout {
                    width: 100%;
                    height: InterfaceStyle.tv ? 64px : 48px;
                    // The Android gear adds an eighth button; the portrait rail
                    // is already close to the 360px floor, so tighten the gaps
                    // there (the volume slider still expands over the row).
                    // The side insets keep the outermost buttons clear of a
                    // landscape cutout.
                    padding-left: (root.narrow ? 6px : 10px) + safe-left;
                    padding-right: (root.narrow ? 8px : 14px) + safe-right;
                    spacing: root.narrow ? 2px : 6px;

                    // -- Left cluster --
                    // Android moves play/pause to the centered transport
                    // cluster (see below); the bottom bar keeps the time and
                    // title only.
                    if !root.is_android || InterfaceStyle.tv: IconBtn {
                        enabled: root.timeline_control_allowed;
                        focused: root.kb_active && root.kb_idx == 1 && root.open_popup == 0;
                        // Re-arm the auto-hide wake so the bar lingers after
                        // (un)pausing instead of vanishing mid-press.
                        clicked => {
                            if (!root.guard_osd_control()) { return; }
                            root.kb_active = false; root.kb_idx = 1; root.osd_mouse_moved(); root.toggle_pause();
                        }
                        if root.is_paused: IcPlay {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 26px;
                            height: 26px;
                            fill: Theme.current.text_bright;
                        }
                        if !root.is_paused: IcPause {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 26px;
                            height: 26px;
                            fill: Theme.current.text_bright;
                        }
                    }

                    // Volume: click = mute toggle, hover = inline slider.
                    // The group wraps button + slider; an invisible 6px
                    // catcher covers the layout gap between them so moving
                    // the cursor across never collapses the slider.
                    // Android hides it entirely: volume is pinned to 100%.
                    if !root.is_android && !InterfaceStyle.tv: vol_group := Rectangle {
                        height: 40px;
                        width: 40px + (self.vol_open ? 106px : 0px);
                            animate width { duration: Anim.player_slide; }
                        property <bool> vol_open:
                            vol_btn.hovered || vol_catch.has-hover || vol_slider_touch.has-hover;

                        vol_catch := TouchArea {
                            x: 40px;
                            y: 0;
                            width: 6px;
                            height: 40px;
                            moved => { root.osd_mouse_moved(); }
                        }

                        vol_btn := IconBtn {
                            x: 0;
                            y: 0;
                            focused: root.kb_active && root.kb_idx == 2 && root.open_popup == 0;
                            clicked => {
                                if (!root.guard_osd_control()) { return; }
                                root.kb_active = false; root.kb_idx = 2; root.toggle_mute();
                            }
                            if root.muted || root.volume <= 0: IcVolumeOff {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 26px;
                                height: 26px;
                                fill: Theme.current.text_bright;
                            }
                            if !(root.muted || root.volume <= 0): IcVolumeUp {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 26px;
                                height: 26px;
                                fill: Theme.current.text_bright;
                            }
                        }

                        vol_slider := Rectangle {
                            x: 46px;
                            y: 0;
                            width: vol_group.vol_open ? 100px : 0px;
                            height: 40px;
                            clip: true;
                        animate width { duration: Anim.player_slide; }

                            property <float> vol_pct: Math.clamp((root.muted ? 0 : root.volume) / 100, 0, 1);

                            Rectangle {
                                y: 18px;
                                x: 8px;
                                width: parent.vol_pct * (parent.width - 16px);
                                height: 3px;
                                background: Theme.current.player_progress_fill;
                                border-radius: 1.5px;
                            }
                            Rectangle {
                                y: 18px;
                                x: 8px;
                                width: (1 - parent.vol_pct) * (parent.width - 16px);
                                height: 3px;
                                background: Theme.current.player_secondary;
                                border-radius: 1.5px;
                            }
                            // Thumb — same as the playback slider's, only
                            // shown while the slider is hovered.
                            Rectangle {
                                x: Math.clamp(8px + parent.vol_pct * (parent.width - 16px) - 5.5px, 0px, parent.width - 11px);
                                y: (parent.height - 11px) / 2;
                                width: 11px;
                                height: 11px;
                                background: Theme.current.player_progress_fill;
                                border-radius: 5.5px;
                                opacity: vol_slider_touch.has-hover ? 1.0 : 0.0;
                                animate opacity { duration: Anim.player_fast; }
                            }
                            vol_slider_touch := TouchArea {
                                x: 0;
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                                moved => {
                                    if (!root.guard_osd_control()) { return; }
                                    let pct = Math.clamp(self.mouse-x / self.width, 0, 1);
                                    root.set_volume(pct * 100);
                                    root.osd_mouse_moved();
                                }
                                clicked => {
                                    if (!root.guard_osd_control()) { return; }
                                    let pct = Math.clamp(self.mouse-x / self.width, 0, 1);
                                    root.set_volume(pct * 100);
                                    root.osd_mouse_moved();
                                }
                            }
                        }

                        // Hover preview: the volume percentage under the
                        // cursor. Lives in the group (the slider clips) and
                        // only appears while the slider is hovered.
                        Rectangle {
                            width: vol_tip.preferred-width + 12px;
                            height: 20px;
                            x: 46px + Math.clamp(vol_slider_touch.mouse-x - self.width / 2, 0px, 100px - self.width);
                            y: -self.height - 4px;
                            border-radius: 5px;
                            background: Theme.current.player_tooltip;
                            opacity: vol_slider_touch.has-hover ? 1.0 : 0.0;
                            animate opacity { duration: Anim.player_fast; }

                            vol_tip := Text {
                                // Show what a click would set: the cursor
                                // position as a percentage.
                                text: root.format_volume(
                                    Math.clamp(vol_slider_touch.mouse-x / vol_slider_touch.width, 0, 1) * 100);
                                color: Theme.current.text_bright;
                                font-size: InterfaceStyle.tv ? 18px : 11px;
                                width: 100%;
                                height: 100%;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Time text. Fixed 40px height so the layout places it
                    // exactly like the 40px icon buttons (fixed-height
                    // children top-align in the 48px row), keeping the
                    // text on the same vertical center as the icons. Shown on
                    // narrow too: the Android bottom-left is free once
                    // play/volume moved off the row, so the timestamp sits
                    // there (the title stays hidden).
                    Rectangle {
                        width: time_lbl.preferred-width + 16px;
                        height: InterfaceStyle.tv ? 56px : 40px;

                        time_lbl := Text {
                            text: root.time_text;
                            color: Theme.current.text_bright;
                            font-size: InterfaceStyle.tv ? 20px : 13px;
                            vertical-alignment: center;
                            x: 8px;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 40px;
                    }

                    // -- Right cluster --
                    // Android's ±10s buttons live in the centered transport
                    // cluster, not here.
                    if !root.is_android || InterfaceStyle.tv: rewind_button := IconBtn {
                        enabled: root.timeline_control_allowed && (!InterfaceStyle.tv || root.tv_can_seek());
                        focused: root.kb_active && root.kb_idx == 3 && root.open_popup == 0;
                        clicked => {
                            if (!root.guard_osd_control()) { return; }
                            root.kb_active = false;
                            root.kb_idx = 3;
                            root.seek_relative(-10);
                            root.osd_mouse_moved();
                        }
                        IcReplay10 {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 26px;
                            height: 26px;
                            fill: Theme.current.text_bright;
                        }
                    }

                    if !root.is_android || InterfaceStyle.tv: forward_button := IconBtn {
                        enabled: root.timeline_control_allowed && (!InterfaceStyle.tv || root.tv_can_seek());
                        focused: root.kb_active && root.kb_idx == 4 && root.open_popup == 0;
                        clicked => {
                            if (!root.guard_osd_control()) { return; }
                            root.kb_active = false;
                            root.kb_idx = 4;
                            root.seek_relative(10);
                            root.osd_mouse_moved();
                        }
                        IcForward10 {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 26px;
                            height: 26px;
                            fill: Theme.current.text_bright;
                        }
                    }

                    // Subtitle button + popup anchored above it (right edge
                    // flush with the button, 8px gap). Wide only: on narrow
                    // layouts track selection lives in the settings panel.
                    if !root.narrow: Rectangle {
                        width: InterfaceStyle.tv ? 56px : 40px;
                        height: InterfaceStyle.tv ? 56px : 40px;

                        IconBtn {
                            x: 0;
                            y: 0;
                            active: root.open_popup == 2;
                            focused: root.kb_active && root.kb_idx == 5 && root.open_popup == 0;
                            clicked => {
                                if (!root.guard_osd_control()) { return; }
                                root.kb_active = false;
                                root.kb_idx = 5;
                                if (root.open_popup == 2) {
                                    root.open_popup = 0;
                                } else {
                                    root.open_popup = 2;
                                    // Ask the backend to (re)enumerate tracks.
                                    root.tracks_popup_opened(2);
                                }
                            }
                            IcCaptions {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 26px;
                                height: 26px;
                                fill: Theme.current.text_bright;
                            }
                        }

                        if root.open_popup == 2: TrackMenu {
                            x: parent.width - self.width;
                            y: -self.height - 8px;
                            max_w: root.width - 32px;
                            row_icon: 2;
                            with_off_row: true;
                            tracks: root.sub_tracks;
                            subtitle_addon_status: root.subtitle_addon_status;
                            focused_idx: root.kb_menu;
                            kb_active: root.kb_active;
                            pick(idx) => { root.kb_active = false; root.pick_sub_track(idx); }
                        }
                    }

                    // Audio track button + popup anchored above it. Wide only:
                    // on narrow layouts track selection lives in the settings
                    // panel.
                    if !root.narrow: Rectangle {
                        width: InterfaceStyle.tv ? 56px : 40px;
                        height: InterfaceStyle.tv ? 56px : 40px;

                        IconBtn {
                            x: 0;
                            y: 0;
                            active: root.open_popup == 1;
                            focused: root.kb_active && root.kb_idx == 6 && root.open_popup == 0;
                            clicked => {
                                if (!root.guard_osd_control()) { return; }
                                root.kb_active = false;
                                root.kb_idx = 6;
                                if (root.open_popup == 1) {
                                    root.open_popup = 0;
                                } else {
                                    root.open_popup = 1;
                                    // Ask the backend to (re)enumerate tracks.
                                    root.tracks_popup_opened(1);
                                }
                            }
                            IcMusic {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 24px;
                                height: 24px;
                                fill: Theme.current.text_bright;
                            }
                        }

                        if root.open_popup == 1: TrackMenu {
                            x: parent.width - self.width;
                            y: -self.height - 8px;
                            max_w: root.width - 32px;
                            row_icon: 1;
                            tracks: root.audio_tracks;
                            focused_idx: root.kb_menu;
                            kb_active: root.kb_active;
                            pick(idx) => { root.kb_active = false; root.pick_audio_track(idx); }
                        }
                    }

                    // Player settings (all platforms/widths): a gear that opens
                    // the settings panel (subtitles, audio, the Android
                    // decoder options, and the playback rate). Second to last,
                    // right before fullscreen.
                    settings_gear := IconBtn {
                        active: root.open_popup == 4;
                        focused: root.kb_active && root.kb_idx == 7 && root.open_popup == 0;
                        clicked => {
                            if (!root.guard_osd_control()) { return; }
                            root.kb_active = false;
                            root.kb_idx = 7;
                            if (root.open_popup == 4) {
                                root.open_popup = 0;
                            } else {
                                root.settings_page = 0;
                                root.open_popup = 4;
                                // Refresh the shown decoder state
                                // and the track lists on open.
                                root.settings_opened();
                                root.tracks_popup_opened(0);
                            }
                            root.osd_mouse_moved();
                        }
                        IcSettingsGear {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 24px;
                            height: 24px;
                            fill: Theme.current.text_bright;
                        }
                    }

                    // Fullscreen button. Hidden on Android: the platform has
                    // its own fullscreen affordance (and the bars are already
                    // immersive during playback).
                    if InterfaceStyle.tv: IconBtn {
                        enabled: root.playback_started && !root.screenshot_busy;
                        focused: root.kb_active && root.kb_idx == 9 && root.open_popup == 0;
                        accessible-role: button; accessible-label: @tr("Take screenshot");
                        clicked => {
                            if !root.guard_osd_control() { return; }
                            root.kb_active = true; root.kb_idx = 9;
                            if root.playback_started && !root.screenshot_busy { root.take_screenshot(); }
                        }
                        IcCamera { width: 28px; height: 28px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; fill: Theme.current.text_bright; }
                    }

                    if !root.is_android && !InterfaceStyle.tv: IconBtn {
                        focused: root.kb_active && root.kb_idx == 8 && root.open_popup == 0;
                        clicked => {
                            if (!root.guard_osd_control()) { return; }
                            root.kb_active = false; root.kb_idx = 8; root.toggle_fullscreen();
                        }
                        if root.is_fullscreen: IcFullscreenExit {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 26px;
                            height: 26px;
                            fill: Theme.current.text_bright;
                        }
                        if !root.is_fullscreen: IcFullscreen {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 26px;
                            height: 26px;
                            fill: Theme.current.text_bright;
                        }
                    }
                }
            }
        }

        // Stay visible with the OSD hidden, then clear its 68px control lane
        // when it wakes. Paint above the OSD so its transparent hover zone cannot
        // intercept offer taps, even while the controls are hidden.
        if root.next_episode_shown: next_episode_banner := NextEpisodeBanner {
            property <length> subtitle_clearance: root.height - self.y + 8px;
            init => { root.next_episode_clearance = self.subtitle_clearance; }
            changed subtitle_clearance => { root.next_episode_clearance = self.subtitle_clearance; }
            width: Math.max(0px, Math.min(InterfaceStyle.tv ? 540px : 360px,
                root.width - root.safe-left - root.safe-right - 32px));
            x: root.width - root.safe-right - self.width - 16px;
            y: Math.max(root.safe-top + 16px,
                root.height - self.height - (root.controls_active ? (InterfaceStyle.tv ? osd.height + 12px : 80px) : 16px));
            title: root.next_episode_title;
            context: root.next_episode_context;
            focused_action: root.kb_active ? (root.kb_idx == 10 ? 1 : root.kb_idx == 11 ? 2 : 0) : 0;
            choose => { root.next_episode_streams(root.next_episode_token); }
            dismiss => { root.next_episode_dismiss(root.next_episode_token); }
        }

        // Player settings panel (gear button): subtitle + audio track pickers
        // on every platform, plus the Android/Windows/Linux decoder submenu. On narrow
        // layouts the track pickers live here instead of the control row.
        if root.open_popup == 4: SettingsMenu {
            narrow: root.narrow;
            anchor_x: settings_gear.absolute-position.x - root.absolute-position.x + settings_gear.width;
            anchor_y: settings_gear.absolute-position.y - root.absolute-position.y;
            safe_top: root.safe-top; safe_left: root.safe-left; safe_right: root.safe-right;
            page <=> root.settings_page;
            focused_idx: root.kb_active ? root.kb_menu : -1;
            selected_index: root.decoder_selected;
            hwdec_label: root.decode_label;
            sub_tracks: root.sub_tracks;
            subtitle_addon_status: root.subtitle_addon_status;
            audio_tracks: root.audio_tracks;
            sub_label: root.sub_label;
            audio_label: root.audio_label;
            audio_preference_saved: root.audio_preference_saved;
            subtitle_preference_saved: root.subtitle_preference_saved;
            speed_preference_saved: root.speed_preference_saved;
            playback_speed <=> root.playback_speed;
            subtitle_style <=> root.subtitle_style;
            subtitle_style_preference_saved: root.subtitle_style_preference_saved;
            subtitle_style_changed(i, v) => { root.subtitle_style_changed(i, v); }
            decoder_available: root.decoder_available;
            hw_plus_available: root.hw_plus_available;
            pick_decoder(i) => { root.open_popup = 0; root.pick_decoder(i); }
            // Keep the panel open on a track pick so the checkmark visibly
            // moves to the chosen row (Android's gear is the only picker).
            pick_sub(i) => { root.pick_sub_track(i); }
            pick_audio(i) => { root.pick_audio_track(i); }
            restore_playback_default(kind) => { root.restore_playback_default(kind); }
            // Rate edits stay on the page (the value moves live) and go
            // straight to the backend, which owns the title preference.
            speed_changed(v) => { root.playback_speed_changed(v); }
            speed_stepped(d) => { root.playback_speed_stepped(d); }
            closed => { root.open_popup = 0; }
        }
    }
}
