import { InterfaceStyle, Theme, SettingsStyle, Anim } from "@NovaUiShared";
import { IcMusic, IcCaptions, IcPlay, IcSettingsGear, IcCheck, IcChevronRight } from "icons.slint";

// Shared category/track row: measured title, optional secondary text, and a
// soft selected surface. Only categories get a chevron; tracks are direct picks.
export component MenuRow inherits Rectangle {
    in property <image> icon;
    in property <int> icon_kind: 0; // 0 none, 1 audio, 2 captions, 3 speed, 4 decoder
    in property <string> label;
    in property <string> value;
    in property <bool> selected: false;
    in property <bool> focused: false;
    in property <bool> submenu: false;
    in property <bool> enabled: true;
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    callback activate();
    callback reveal(length, length);
    changed focused => { if root.focused { reveal_timer.start(); } }
    init => { if root.focused { reveal_timer.start(); } }
    reveal_timer := Timer {
        interval: 1ms; running: false;
        triggered => { self.stop(); if root.focused { root.reveal(root.absolute-position.y, root.height); } }
    }
    forward-focus: row_focus;
    row_focus := FocusScope {
        enabled: root.enabled;
        changed has-focus => { if self.has-focus { SettingsStyle.keyboard-mode = true; } }
        key-pressed(e) => { SettingsStyle.keyboard-mode = true; if e.text == Key.Return || e.text == " " { if !e.repeat { root.activate(); } accept } else { reject } }
    }

    opacity: root.enabled ? 1 : 0.45;
    property <length> label_x: root.icon.width == 0 && root.icon_kind == 0 ? 14px : 50px;
    property <length> label_h: Math.min(InterfaceStyle.tv ? 60px : 40px, row_label.preferred-height);
    property <length> text_h: root.label_h + (root.value != "" ? (InterfaceStyle.tv ? 28px : 20px) : 0px);
    height: Math.max(60px, root.text_h + 20px);
    border-radius: 10px;
    border-width: root.focused || (row_focus.has-focus && SettingsStyle.keyboard-mode) ? 2px : 0px;
    border-color: Theme.current.focus_ring;
    background: root.selected ? Theme.current.selection_fill
        : row_t.has-hover ? Theme.current.control_hover : transparent;

    icon_host := Rectangle {
        x: 14px; width: 24px; height: 100%;
        if root.icon.width > 0: Image {
            width: 24px; height: 24px; y: (parent.height - self.height) / 2;
            source: root.icon; image-fit: contain; colorize: Theme.current.accent_soft;
        }
        if root.icon.width == 0 && root.icon_kind == 1: IcMusic {
            width: 22px; height: 22px; y: (parent.height - self.height) / 2;
            fill: Theme.current.accent_soft;
        }
        if root.icon.width == 0 && root.icon_kind == 2: IcCaptions {
            width: 22px; height: 22px; y: (parent.height - self.height) / 2;
            fill: Theme.current.accent_soft;
        }
        if root.icon.width == 0 && root.icon_kind == 3: IcPlay {
            width: 22px; height: 22px; y: (parent.height - self.height) / 2;
            fill: Theme.current.accent_soft;
        }
        if root.icon.width == 0 && root.icon_kind == 4: IcSettingsGear {
            width: 22px; height: 22px; y: (parent.height - self.height) / 2;
            fill: Theme.current.accent_soft;
        }
    }
    row_label := Text {
        x: root.label_x; y: (root.height - root.text_h) / 2;
        width: Math.max(0px, root.width - root.label_x - 40px);
        height: root.label_h;
        text: root.label; color: Theme.current.text_bright;
        font-size: InterfaceStyle.tv ? 20px : 14px; font-weight: 600;
        wrap: word-wrap; overflow: elide;
    }
    if root.value != "": Text {
        x: root.label_x; y: row_label.y + root.label_h + 4px;
        width: row_label.width; height: InterfaceStyle.tv ? 24px : 16px;
        text: root.value; color: Theme.current.text_secondary;
        font-size: InterfaceStyle.tv ? 18px : 12px; overflow: elide;
    }
    // Retain the glyphs so both selection and deselection can fade without
    // moving the label or rebuilding the row's native focus target.
    checkmark := IcCheck {
        x: root.width - 30px; y: (root.height - self.height) / 2;
        width: 18px; height: 18px; fill: Theme.current.accent_soft;
        private property <float> target-opacity: root.selected ? 1 : 0;
        private property <float> state-opacity: self.target-opacity;
        private property <bool> state-motion: Anim.enabled;
        animate state-opacity { duration: Anim.control_state; easing: ease-out; }
        changed target-opacity => { self.state-opacity = self.target-opacity; }
        // Reassign with the current duration so master-off cancels an old
        // animation instead of reviving it when motion is enabled again.
        changed state-motion => { self.state-opacity = self.target-opacity; }
        opacity: Anim.enabled ? self.state-opacity : self.target-opacity;
    }
    if root.submenu: IcChevronRight {
        x: root.width - 28px; y: (root.height - self.height) / 2;
        width: 16px; height: 16px; fill: Theme.current.text_muted;
        private property <float> target-opacity: root.selected ? 0 : 1;
        private property <float> state-opacity: self.target-opacity;
        private property <bool> state-motion: Anim.enabled;
        animate state-opacity { duration: Anim.control_state; easing: ease-out; }
        changed target-opacity => { self.state-opacity = self.target-opacity; }
        // Reassign with the current duration so master-off cancels an old
        // animation instead of reviving it when motion is enabled again.
        changed state-motion => { self.state-opacity = self.target-opacity; }
        opacity: Anim.enabled ? self.state-opacity : self.target-opacity;
    }
    row_t := TouchArea {
        enabled: root.enabled;
        width: 100%; height: 100%; mouse-cursor: pointer;
        clicked => { root.activate(); }
    }
}

