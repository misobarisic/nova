import { Theme, TrackingLinkRow, DetailContent } from "@NovaUiShared";
import { CheckBox } from "std-widgets.slint";
import { SettingsInput } from "settings-controls.slint";
import { Dropdown } from "dropdown.slint";
import { TrackingButton } from "tracking-controls.slint";

export component EntryEditor inherits Rectangle {
    in property <TrackingLinkRow> entry;
    // The panel owns one nested entry layer by stable ID, rather than by
    // repeater index. A row update must never transfer an editor to another ID.
    in-out property <string> active_entry_id;
    in-out property <bool> entry_more;
    in-out property <bool> entry_editing;
    in-out property <bool> entry_history_confirm;
    in-out property <bool> entry_unlink_confirm;
    callback release_focus();
    callback edit(string,string,int,string,bool,string,bool,string);
    callback action(string,int);
    background: Theme.current.episode_toolbar; border-radius: 16px; border-width: 1px; border-color: Theme.current.border_medium; vertical-stretch: 0; min-width: 0;
    property <bool> active: root.active_entry_id == root.entry.id;
    property <bool> editing: root.active && root.entry_editing;
    property <bool> more: root.active && root.entry_more;
    property <bool> history_confirm: root.active && root.entry_history_confirm;
    property <bool> unlink_confirm: root.active && root.entry_unlink_confirm;
    property <string> shown_id: "";
    init => { root.shown_id = root.entry.id; }
    changed entry => {
        if root.active_entry_id != "" && root.active_entry_id != root.entry.id { DetailContent.validate_entry(); }
        root.shown_id = root.entry.id;
    }
    changed editing => { if root.active { DetailContent.focus_tracking(); } }
    changed history_confirm => { if root.active { DetailContent.focus_tracking(); } }
    changed unlink_confirm => { if root.active { DetailContent.focus_tracking(); } }
    function activate() {
        if !root.active {
            root.entry_more = false;
            root.entry_editing = false;
            root.entry_history_confirm = false;
            root.entry_unlink_confirm = false;
            root.active_entry_id = root.entry.id;
        }
    }
    function cancel_edit() { root.entry_editing = false; }
    // Entry edits and confirmations remove their focused controls. Keep a
    // stable focus target inside the card for the next Android Back press.
    VerticalLayout {
        padding: 12px; spacing: 8px;
        Text { text: root.entry.title; color: Theme.current.text_tracking_primary; wrap: word-wrap; min-width: 0px; font-weight: 700; }
        if !root.editing && root.more: VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                TrackingButton { text: @tr("Edit tracker entry"); icon:6; preferred-width:0px; horizontal-stretch:1; clicked => {root.entry_editing=true;} }
                TrackingButton { text:@tr("Open on service"); icon:7; preferred-width:0px; horizontal-stretch:1; clicked => {root.action(root.entry.id,4);} }
            }
            // Recovery labels are long in both catalogs. Give each its own
            // row instead of letting intrinsic text widths squeeze its neighbor.
            TrackingButton { text:@tr("Restore automatic status and dates"); icon:2; clicked => {root.action(root.entry.id,5);} }
            TrackingButton { text: @tr("Refresh / retry"); icon:2; clicked => {root.action(root.entry.id,0);} }
            HorizontalLayout {
                spacing: 8px;
                TrackingButton { text: @tr("Edit alignment"); icon:8; preferred-width:0px; horizontal-stretch:1; clicked => {root.action(root.entry.id,1);} }
                TrackingButton { text: @tr("Apply Nova history"); icon:9; preferred-width:0px; horizontal-stretch:1; clicked => {root.entry_history_confirm=true;root.entry_unlink_confirm=false;} }
            }
            if root.history_confirm: VerticalLayout {
                Text {text:root.entry.history_preview; color:Theme.current.text_secondary; wrap:word-wrap; min-width:0;}
                TrackingButton {text:@tr("Confirm history update"); clicked => {root.action(root.entry.id,2);root.entry_history_confirm=false;}}
                TrackingButton {text:@tr("Cancel"); clicked => {root.entry_history_confirm=false;}}
            }
            TrackingButton { text: @tr("Unlink"); icon:10; destructive:true; clicked => {root.entry_unlink_confirm=true;root.entry_history_confirm=false;} }
            if root.unlink_confirm: VerticalLayout {
                Text {text:@tr("Unlink this release? Unsent updates will be discarded when no other source uses it. An update already sent may finish.");color:Theme.current.text_secondary;wrap:word-wrap;min-width:0;}
                TrackingButton {text:@tr("Confirm unlink");clicked => {root.action(root.entry.id,3);}}
                TrackingButton {text:@tr("Cancel");clicked => {root.entry_unlink_confirm=false;}}
            }
        }
        if root.editing: VerticalLayout {
            spacing: 6px;
            Text { text: @tr("Progress (explicit decreases are allowed)"); color: Theme.current.text_secondary; wrap: word-wrap; min-width: 0; }
            progress := SettingsInput { text:root.entry.progress; accessible-label:@tr("Tracker progress"); }
            status := Dropdown { accessible-role: combobox; model:root.entry.dates_writable ? [@tr("Planning"),@tr("Watching"),@tr("Completed"),@tr("On hold"),@tr("Dropped"),@tr("Repeating")] : [@tr("Planning"),@tr("Watching"),@tr("Completed"),@tr("On hold"),@tr("Dropped")]; current-index:root.entry.status; accessible-label:@tr("Tracker status"); }
            Text { text:root.entry.score_hint; color:Theme.current.text_secondary; wrap:word-wrap; min-width:0; }
            score := SettingsInput { text:root.entry.score; accessible-label:@tr("Tracker score"); }
            started_check := CheckBox { text:@tr("Change start date"); enabled:root.entry.dates_writable; }
            started := SettingsInput { text:root.entry.started; placeholder-text:@tr("YYYY-MM-DD, partial date, or empty to clear"); enabled:root.entry.dates_writable; accessible-label:@tr("Start date"); }
            completed_check := CheckBox { text:@tr("Change finish date"); enabled:root.entry.dates_writable; }
            completed := SettingsInput { text:root.entry.completed; placeholder-text:@tr("YYYY-MM-DD, partial date, or empty to clear"); enabled:root.entry.dates_writable; accessible-label:@tr("Finish date"); }
            if !root.entry.dates_writable: Text { text:@tr("MyAnimeList dates are read-only through its API."); color:Theme.current.text_secondary; wrap:word-wrap; min-width:0; }
            TrackingButton { text:@tr("Save tracker edits"); clicked => {root.edit(root.entry.id,progress.text,status.current-index,score.text,started_check.checked,started.text,completed_check.checked,completed.text);root.cancel_edit();} }
            TrackingButton { text:@tr("Cancel"); clicked => {root.cancel_edit();} }
        }
    }
}
