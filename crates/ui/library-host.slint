import { LibraryBridge } from "@NovaUiShared";

// Backend aliases live in CollectionBindings, outside this conditional host.
export component LibraryHost inherits Rectangle {
    preferred-width: 100%; preferred-height: 100%;
    in-out property <length> nav-viewport-width <=> LibraryBridge.nav-viewport-width;
    in-out property <int> min_cols <=> LibraryBridge.min_cols;
    in-out property <int> system_back_request <=> LibraryBridge.system_back_request;
    in-out property <bool> more_open <=> LibraryBridge.more_open;
    in-out property <bool> narrow <=> LibraryBridge.narrow;
    in-out property <length> safe-top <=> LibraryBridge.safe-top;
    in-out property <length> safe-left <=> LibraryBridge.safe-left;
    in-out property <length> safe-right <=> LibraryBridge.safe-right;
    in-out property <length> safe-bottom <=> LibraryBridge.safe-bottom;
    in-out property <bool> touch_menus <=> LibraryBridge.touch_menus;
    in-out property <length> viewport_width <=> LibraryBridge.viewport_width;
    in-out property <length> viewport_height <=> LibraryBridge.viewport_height;
    ComponentContainer { width: 100%; height: 100%; component-factory: LibraryBridge.factory; }
}
