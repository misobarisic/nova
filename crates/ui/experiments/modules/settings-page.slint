import { SettingsPage } from "../../settings.slint";
import { AddonRow } from "../../types.slint";

// Give the standalone export a finite viewport: SettingsPage normally obtains
// one from AppWindow. Keep a model and state channel across the boundary, too.
export component ProbeSettingsPage inherits Rectangle {
    in-out property <[AddonRow]> addon_rows;
    in property <bool> active: true;
    in property <bool> external_navigation: true;
    in property <length> viewport_width: 1100px;
    in property <length> viewport_height: 750px;
    width: root.viewport_width;
    height: root.viewport_height;
    SettingsPage {
        width: 100%;
        height: 100%;
        addon_rows <=> root.addon_rows;
        active: root.active;
        external_navigation: root.external_navigation;
    }
}
