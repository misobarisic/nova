import { ScrollView } from "scrollview.slint";
import { MediaCard, CategoryRow } from "types.slint";
import { KbMark } from "kbnav.slint";
import { Dropdown } from "dropdown.slint";
import { MenuSheet } from "menusheet.slint";
import { SideNav, NavMetrics } from "sidenav.slint";
import { BottomNav } from "bottomnav.slint";
import { IcMoreHoriz, IcSearch, IcClose } from "icons.slint";
import { Anim } from "anim.slint";
import { Theme } from "theme.slint";
import { SearchField } from "searchfield.slint";

component LibraryFilterChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback picked();
    callback reveal(length, length);
    changed selected => { if (root.selected) { root.reveal(root.x, root.width); } }
    changed x => { if (root.selected) { root.reveal(root.x, root.width); } }
    changed width => { if (root.selected) { root.reveal(root.x, root.width); } }
    height: 40px;
    width: chip_text.preferred-width + 28px;
    border-radius: 20px;
    border-width: 1px;
    border-color: root.selected ? Theme.current.accent : Theme.current.border_strong;
    background: root.selected ? Theme.current.primary_button : (chip_touch.has-hover ? Theme.current.control_hover : Theme.current.hero_control);
    accessible-role: button;
    accessible-label: root.label;
    chip_text := Text {
        text: root.label;
        color: root.selected ? Theme.current.on_accent : Theme.current.text_secondary;
        font-size: 13px;
        font-weight: root.selected ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    chip_touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}


export component LibraryPage {
    // Custom components placed in a Window are sized by their preferred size;
    // make this page fill the window (its parent).
    preferred-width: 100%;
    preferred-height: 100%;

    in-out property <[MediaCard]> library: [];
    in-out property <[CategoryRow]> category_rows: [];
    in-out property <string> library_filter_category: "";
    in-out property <string> library_empty_hint: @tr("Your library is empty — open any movie, series or anime and press \"+ Add to library\".");
    in-out property <[string]> category_names: [];
    // Display text for `category_names` (same order/length): the automatic
    // buckets are shown translated while the picked value stays the stored
    // identifier the backend filters on (`nova_config`-agnostic; pushed from
    // `library.rs`).
    in-out property <[string]> category_labels: [];
    // Index of the active filter (-1 = All), supplied by the backend so
    // keyboard cycling starts at the pill selected with the pointer.
    in-out property <int> category_index: -1;
    in-out property <string> query: "";
    in-out property <int> sort_index: 0;
    in-out property <bool> list_view: false;
    in-out property <bool> search_open: false;
    callback view_changed();
    changed search_open => {
        if (root.search_open) { search_focus_t.start(); }
        else { search_focus_t.stop(); }
    }
    search_focus_t := Timer {
        interval: 80ms;
        running: false;
        triggered => {
            self.stop();
            if (root.search_open) { library_search_line.focus(); }
        }
    }
    in property <int> system_back_request: 0;
    property <int> last_system_back_request: -1;

    property <length> item-gap: Theme.card_spacing;
    // Fluid poster grid: phones keep two columns by default; wide screens
    // add columns. List mode shares the same model, actions and scroll math.
    property <length> min-card: 160px;
    property <length> max-card: 230px;
    // Floor from Settings → Display (phones fit N across at 160px cards).
    in property <int> min_cols: 2;
    // Left inset reserved by the wide-layout navigation rail (0 on narrow).
    // Window width is supplied separately so responsive padding does not
    // feed back into the page’s own intrinsic layout width.
    in property <length> nav-viewport-width;
    property <length> rail_w: root.narrow ? 0px : NavMetrics.width-for(root.nav-viewport-width);
    // Use the measured viewport: page padding, the rail, cutouts and scroll
    // chrome have already taken their space out of it.
    property <length> grid-width: Math.max(1px, lib_scroll.visible-width);
    property <length> grid-top: library_header.height + 8px;
    property <length> header_shift: Math.max(-library_hero.height - 14px, Math.min(0px, root.scroll_y));
    property <length> header_cover: library_header.height + root.header_shift;
    property <int> cols: root.list_view ? 1 : Math.max(root.min_cols, Math.floor((root.grid-width + root.item-gap) / (root.min-card + root.item-gap)));
    property <length> item-width: Math.max(1px, Math.min(root.list_view ? root.grid-width : root.max-card, (root.grid-width - (root.cols - 1) * root.item-gap) / root.cols));

    callback discover_picked();
    callback home_picked();
    callback library_picked();
    callback settings_picked();
    callback library_filter_picked(string);
    callback library_item_picked(int);
    // Library watched-state context menu: 1 mark series watched,
    // 2 mark series unwatched.
    callback library_watch_action(int, int);
    // Library status pin: 0 automatic, 1 On Hold, 2 Dropped.
    callback library_status_action(int, int);
    callback remove_library_item(int);

    // Card bottom-sheet menu state (single instance).
    // Pure UI state: actions reuse the callbacks above.
    property <bool> menu_open: false;
    property <int> menu_idx: 0;
    property <bool> menu_watched: false;
    property <string> menu_id: "";
    // A sync or watched-state refresh can remove/reorder a filtered row while
    // its sheet is open. Never let its old index act on the replacement show.
    property <bool> menu_valid: root.menu_idx >= 0 && root.menu_idx < root.library.length
        && root.library[root.menu_idx].id == root.menu_id;
    changed menu_valid => {
        if (root.menu_open && !root.menu_valid) { root.close_menu(); }
    }

    function open_lib_menu(idx: int, watched: bool) {
        if (idx < 0 || idx >= root.library.length) { return; }
        root.menu_idx = idx;
        root.menu_id = root.library[idx].id;
        root.menu_watched = watched;
        root.menu_open = true;
    }

    function close_menu() {
        root.menu_open = false;
    }
    function system_back() {
        if (root.menu_open) {
            root.close_menu();
        } else if (root.search_open) {
            root.search_open = false;
            root.query = "";
            root.view_changed();
            nav_scope.focus();
        } else {
            root.home_picked();
        }
    }
    changed system_back_request => {
        if (root.last_system_back_request >= 0
            && root.system_back_request != root.last_system_back_request) {
            root.last_system_back_request = root.system_back_request;
            root.system_back();
        }
    }
    // Preload fetch window (visible ±2 rows), see DiscoverPage.
    callback library_visible_range(int, int);

    // Compact layout for narrow (portrait) windows.
    in property <bool> narrow;
    // Top system-bar inset (Android status bar): Window.safe-area-insets,
    // bound by AppWindow. 0 on desktop/web, so layout there is unchanged.
    in property <length> safe-top: 0px;
    // Side insets: in landscape the display cutout / gesture area moves to
    // the left or right edge, so page content must clear it.
    in property <length> safe-left: 0px;
    in property <length> safe-right: 0px;
    // Bottom system-bar inset (Android gesture/nav bar), for the card
    // bottom sheet. 0 on desktop/web.
    in property <length> safe-bottom: 0px;
    // True on touch-driven platforms (Android): card menus open as
    // bottom sheets on hold. Desktop keeps native right-click popups.
    in property <bool> touch_menus: false;

    // ---- 6-button keyboard nav (arrows + Enter + Backspace) ----
    // Zones: 0 page-nav (0 Home, 1 Discover, 2 Library, 3 Settings),
    // 1 category filter, 2 grid. Backspace returns to Home. The filter
    // cycles All + categories (kb_f = -1 is All);
    // kb_f follows category_index so pointer and keyboard picks stay in sync.
    // Bound to AppWindow (survives page recreation): backing out of an
    // entry returns to the same focused card.
    in-out property <int> kb_zone: 0;
    in-out property <int> kb_nav: 2;
    in-out property <int> kb_f: -1;
    in-out property <int> kb_idx: 0;
    // Keyboard modality (bound to AppWindow, see DiscoverPage).
    in-out property <bool> kb_active;
    // Exact scroll offset (bound to AppWindow): the grid viewport syncs
    // here continuously and restores absolutely on return.
    in-out property <length> scroll_y: 0px;

    function kb_clamp_idx() {
        if (root.library.length == 0) {
            root.kb_idx = 0;
        } else if (root.kb_idx >= root.library.length) {
            root.kb_idx = root.library.length - 1;
        } else if (root.kb_idx < 0) {
            root.kb_idx = 0;
        }
    }

    function kb_filter_on() -> bool { return root.category_names.length > 0; }

    function kb_cycle_filter(d: int) {
        let n = root.category_names.length;
        let raw = root.kb_f + d;
        let v = raw < -1 ? n - 1 : (raw >= n ? -1 : raw);
        root.kb_f = v;
        if (v < 0) {
            root.library_filter_picked("");
        } else {
            root.library_filter_picked(root.category_names[v]);
        }
    }

    function kb_up() {
        if (root.kb_zone == 2) {
            if (root.kb_idx >= root.cols) {
                root.kb_idx -= root.cols;
            } else {
                root.kb_zone = root.kb_filter_on() ? 1 : 0;
            }
        } else if (root.kb_zone == 1) {
            root.kb_zone = 0;
        }
    }

    function kb_down() {
        if (root.kb_zone == 0) {
            if (root.kb_filter_on()) {
                root.kb_zone = 1;
            } else if (root.library.length > 0) {
                root.kb_zone = 2;
                root.kb_clamp_idx();
            }
        } else if (root.kb_zone == 1) {
            if (root.library.length > 0) {
                root.kb_zone = 2;
                root.kb_clamp_idx();
            }
        } else {
            if (root.kb_idx + root.cols < root.library.length) {
                root.kb_idx += root.cols;
            }
        }
    }

    function kb_left() {
        if (root.kb_zone == 0) {
            root.kb_nav = Math.mod(root.kb_nav + 3, 4);
        } else if (root.kb_zone == 1) {
            root.kb_cycle_filter(-1);
        } else {
            if (root.kb_idx > 0) {
                root.kb_idx -= 1;
            }
        }
    }

    function kb_right() {
        if (root.kb_zone == 0) {
            root.kb_nav = Math.mod(root.kb_nav + 1, 4);
        } else if (root.kb_zone == 1) {
            root.kb_cycle_filter(1);
        } else {
            if (root.kb_idx + 1 < root.library.length) {
                root.kb_idx += 1;
            }
        }
    }

    function kb_enter() {
        if (root.kb_zone == 0) {
            if (root.kb_nav == 0) {
                root.home_picked();
            } else if (root.kb_nav == 1) {
                root.discover_picked();
            } else if (root.kb_nav == 2) {
                root.library_picked();
            } else {
                root.settings_picked();
            }
        } else if (root.kb_zone == 1) {
            root.kb_cycle_filter(1);
        } else {
            if (root.kb_idx >= 0 && root.kb_idx < root.library.length) {
                root.library_item_picked(root.kb_idx);
            }
        }
    }

    property <length> card-height: root.list_view ? 140px : root.item-width * 3 / 2 + 76px;
    property <length> row_stride: root.card-height + root.item-gap;
    changed list_view => {
        lib_scroll.content-y = 0px;
        root.kb_follow();
    }
    changed scroll_y => {
        if (Math.abs(lib_scroll.content-y - root.scroll_y) > 0.5px) {
            lib_scroll.content-y = root.scroll_y;
        }
    }
    // The grid has actually measured: `cols`/`item-width` are the divisors of
    // every row calculation below, so a scroll adjustment must not run while
    // they are still 0 — it would compute a nonsense row and jump the listing.
    property <bool> grid_ready: lib_scroll.content-height > 0px
        && root.cols > 0 && root.item-width > 0px;
    // Bounded restore retries (a page whose grid never lays out must not leave
    // the timer ticking).
    property <int> restore_tries: 0;
    // Keep the focused card on screen. Skipped before layout
    // (content-height 0) — the one-shot restore timer in the grid
    // container retries.
    function kb_follow() {
        if (root.kb_zone != 2 || root.library.length == 0) {
            return;
        }
        if (!root.grid_ready) {
            return;
        }
        let top = root.grid-top + Math.floor(root.kb_idx / root.cols) * root.row_stride;
        let bot = top + root.row_stride;
        let vy = lib_scroll.content-y;
        let vh = lib_scroll.visible-height;
        let min_y = Math.min(0px, vh - lib_scroll.content-height);
        if (top < root.header_cover - vy) {
            lib_scroll.content-y = root.header_cover - top;
        } else if (bot > vh - vy) {
            lib_scroll.content-y = Math.max(min_y, vh - bot);
        }
    }

    changed kb_idx => { root.kb_follow(); }
    changed kb_zone => { root.kb_follow(); }

    // Clamp the (restored) scroll offset into the valid range once laid
    // out: content may have shrunk while inside the entry.
    function kb_clamp_view() {
        if (lib_scroll.content-height == 0px) {
            return;
        }
        let min_y = Math.min(0px, lib_scroll.visible-height - lib_scroll.content-height);
        lib_scroll.content-y = Math.max(min_y, Math.min(0px, lib_scroll.content-y));
    }
    // Reveal the focused card only when its row is *entirely* outside the
    // viewport. Used when the page is restored (and when the model is
    // re-applied): nudging a partially visible row into view is what used to
    // shift the listing slightly on the way back from an entry. Real keyboard
    // navigation still uses `kb_follow`, which keeps the whole row visible.
    function kb_reveal_if_hidden() {
        if (root.kb_zone != 2 || root.library.length == 0) {
            return;
        }
        if (!root.grid_ready) {
            return;
        }
        let top = root.grid-top + Math.floor(root.kb_idx / root.cols) * root.row_stride;
        let bot = top + root.row_stride;
        let vy = lib_scroll.content-y;
        let vh = lib_scroll.visible-height;
        let min_y = Math.min(0px, vh - lib_scroll.content-height);
        if (bot <= root.header_cover - vy) {
            lib_scroll.content-y = Math.max(min_y, root.header_cover - top);
        } else if (top >= vh - vy) {
            lib_scroll.content-y = Math.max(min_y, vh - bot);
        }
    }

    changed library => {
        root.kb_clamp_idx();
        root.kb_reveal_if_hidden();
    }
    changed category_index => { root.kb_f = root.category_index; }
    property <length> selected_filter_left: 0px;
    property <length> selected_filter_width: 0px;
    function reveal_filter(left: length, w: length) {
        root.selected_filter_left = left;
        root.selected_filter_width = w;
        let min_x = Math.min(0px, filter_rail.width - filter_rail.content-width);
        filter_rail.content-x = Math.max(min_x, Math.min(0px, filter_rail.content-x));
        if (left < -filter_rail.content-x) {
            filter_rail.content-x = -left;
        } else if (left + w > -filter_rail.content-x + filter_rail.width) {
            filter_rail.content-x = Math.max(filter_rail.width - filter_rail.content-width, filter_rail.width - left - w);
        }
    }
    changed library_filter_category => {
        if (root.library_filter_category == "") {
            root.kb_f = -1;
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.current.artwork_canvas;

        // 6-button scope: overlays the page without intercepting the mouse.
        nav_scope := FocusScope {
            width: 100%;
            height: 100%;
            init => {
                self.focus();
                root.last_system_back_request = root.system_back_request;
            }
            key-pressed(e) => {
                if (root.menu_open) {
                    // An open sheet eats Backspace (dismiss only).
                    root.close_menu();
                    accept
                } else if (e.text == Key.UpArrow) {
                    root.kb_active = true;
                    root.kb_up();
                    accept
                } else if (e.text == Key.DownArrow) {
                    root.kb_active = true;
                    root.kb_down();
                    accept
                } else if (e.text == Key.LeftArrow) {
                    root.kb_active = true;
                    root.kb_left();
                    accept
                } else if (e.text == Key.RightArrow) {
                    root.kb_active = true;
                    root.kb_right();
                    accept
                } else if (e.text == Key.Return) {
                    root.kb_active = true;
                    root.kb_enter();
                    accept
                } else if (e.text == Key.Backspace || e.text == Key.Back) {
                    root.kb_active = true;
                    root.system_back();
                    accept
                } else {
                    reject
                }
            }
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding-left: 18px + safe-left + root.rail_w;
            padding-right: 18px + safe-right;
            padding-bottom: root.narrow ? 0px : 18px;
            padding-top: 18px + safe-top;
            spacing: 14px;

            // Grid (always present so the keyboard scope can drive its
            // ScrollView; empty with no cards when the library is empty).
            library_body := Rectangle {
                vertical-stretch: 1;
                clip: true;

                // One-shot restore: the page is recreated on return (bound
                // kb props arrive pre-set, so no `changed` fires) — clamp +
                // scroll to the focused card once layout is ready. The bound
                // scroll offset restores the absolute position; the clamp
                // guards shrunk content and follow is a no-op when visible.
                restore_t := Timer {
                    interval: 120ms;
                    running: true;
                    triggered => {
                        root.restore_tries += 1;
                        if (!root.grid_ready) {
                            if (root.restore_tries < 10) {
                                return; // layout not there yet: keep trying
                            }
                            self.running = false;
                            return;
                        }
                        self.running = false;
                        root.kb_clamp_idx();
                        // Restore the exact offset: clamp for shrunk content,
                        // then reveal only if the focused row is fully hidden
                        // (a no-op in the common case).
                        root.kb_clamp_view();
                        root.kb_reveal_if_hidden();
                    }
                }

                lib_scroll := ScrollView {
                    width: 100%;
                    height: 100%;
                    // Touch devices scroll by dragging (there is no
                    // wheel): the fluent-style ScrollView disables
                    // drag-pan by default, so opt in explicitly.
                    mouse-drag-pan-enabled: true;
                    // One-way mirror, see DiscoverPage: Flickable drops
                    // viewport bindings on press, so mirror explicitly.
                    init => { self.content-y = root.scroll_y; }
                    // Preload + unload reporting (Bridge::visible_range):
                    // same row_stride and ±2-row preload window as
                    // Discover; see DiscoverPage for the scheme.
                    property <int> reported_first: -1000000;
                    changed content-y => {
                        root.scroll_y = self.content-y;
                        if (root.library.length > 0) {
                            let first_row = Math.max(0, Math.floor((root.header_cover - self.content-y - root.grid-top) / root.row_stride));
                            let vis_rows = Math.ceil(self.visible-height / root.row_stride);
                            let first_idx = Math.max(0, (first_row - 2) * root.cols);
                            let last_idx = Math.min(root.library.length - 1, (first_row + vis_rows + 2) * root.cols - 1);
                            if (self.reported_first < -100000) {
                                self.reported_first = first_idx;
                            } else if (Math.abs(first_idx - self.reported_first) > 48) {
                                self.reported_first = first_idx;
                                root.library_visible_range(first_idx, last_idx);
                            }
                        }
                    }

                    // Left align the grid like the reference, including when
                    // only one title is saved; wide screens add more columns.
                    HorizontalLayout {
                        width: 100%;
                        // Keep the first row's pointer hover lift inside the
                        // ScrollView's clip, just like Home's landing rails.
                        padding-top: root.grid-top;
                        alignment: start;

                    library_grid := GridLayout {
                        // Keep the grid at its exact column width, aligned left.
                        width: root.cols * (root.item-width + root.item-gap) - root.item-gap;
                        spacing: root.item-gap;

                        for card[i] in root.library: library_card := Rectangle {
                            row: Math.floor(i / root.cols);
                            col: Math.mod(i, root.cols);

                            width: root.item-width;
                            height: root.card-height;

                            // Card menu: desktop right-click opens the
                            // native popup at the cursor; touch hold opens
                            // the bottom sheet (see below).
                            lib_ctx := ContextMenuArea {
                                width: 100%;
                                height: 100%;

                                Menu {
                                    MenuItem {
                                        title: @tr("Open");
                                        activated => {
                                            root.kb_active = false;
                                            root.kb_zone = 2;
                                            root.kb_idx = i;
                                            root.library_item_picked(i);
                                        }
                                    }
                                    MenuSeparator {}
                                    MenuItem {
                                        title: card.watched ? @tr("Mark series as unwatched") : @tr("Mark series as watched");
                                        activated => { root.library_watch_action(i, card.watched ? 2 : 1); }
                                    }
                                    MenuSeparator {}
                                    MenuItem {
                                        title: @tr("Mark as On Hold");
                                        activated => { root.library_status_action(i, 1); }
                                    }
                                    MenuItem {
                                        title: @tr("Mark as Dropped");
                                        activated => { root.library_status_action(i, 2); }
                                    }
                                    MenuItem {
                                        title: @tr("Back to automatic");
                                        activated => { root.library_status_action(i, 0); }
                                    }
                                    MenuSeparator {}
                                    MenuItem {
                                        title: @tr("Remove from library");
                                        activated => { root.remove_library_item(i); }
                                    }
                                }

                            touch_lib := TouchArea {
                                property <bool> lp_suppress: false;
                                mouse-cursor: pointer;
                                clicked => {
                                    if (touch_lib.lp_suppress) {
                                        touch_lib.lp_suppress = false;
                                    } else {
                                        root.kb_active = false;
                                        root.kb_zone = 2;
                                        root.kb_idx = i;
                                        root.library_item_picked(i);
                                    }
                                }
                                pointer-event(ev) => {
                                    if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                                        lib_lp_timer.stop();
                                        if (root.touch_menus) {
                                            root.open_lib_menu(i, card.watched);
                                        } else {
                                            lib_ctx.show({ x: touch_lib.mouse-x, y: touch_lib.mouse-y });
                                        }
                                    } else if (ev.kind == PointerEventKind.down) {
                                        touch_lib.lp_suppress = false;
                                        if (root.touch_menus) {
                                            lib_lp_timer.stop();
                                            lib_lp_timer.start();
                                        }
                                    } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                        lib_lp_timer.stop();
                                    }
                                }
                                moved => {
                                    if (Math.abs(touch_lib.mouse-x - touch_lib.pressed-x) + Math.abs(touch_lib.mouse-y - touch_lib.pressed-y) > 24px) {
                                        lib_lp_timer.stop();
                                    }
                                }
                            }
                            }

                            // Hold-to-open timer (pinned off until a press
                            // arms it; Slint Timers run from creation by
                            // default).
                            lib_lp_timer := Timer {
                                interval: 600ms;
                                running: false;
                                triggered => {
                                    self.stop();
                                    touch_lib.lp_suppress = true;
                                    root.open_lib_menu(i, card.watched);
                                }
                            }

                            library_lift := Rectangle {
                                width: 100%;
                                height: 100%;
                                background: Theme.current.card;
                                border-radius: Theme.card_corner_radius;
                                border-width: root.kb_active && root.kb_zone == 2 && root.kb_idx == i ? 2px : 1px;
                                border-color: root.kb_active && root.kb_zone == 2 && root.kb_idx == i ? Theme.current.accent : Theme.current.border_card;
                                clip: true;
                                y: touch_lib.has-hover && !touch_lib.pressed && !root.touch_menus ? -6px : 0px;
                                animate y { duration: Anim.hover_lift; easing: ease-in-out; }

                                library_poster := Rectangle {
                                    x: 1px; y: 1px;
                                    width: root.list_view ? 92px : parent.width - 2px;
                                    height: root.list_view ? parent.height - 2px : root.item-width * 3 / 2;
                                    border-radius: Math.max(0px, Theme.card_corner_radius - 1px);
                                    clip: true;
                                    background: Theme.current.home_artwork_placeholder;
                                    if card.is_loaded: Image {
                                        source: card.poster;
                                        image-fit: cover;
                                        width: 100%; height: 100%;
                                    }
                                    if !card.is_loaded: Text {
                                        text: "🎬";
                                        font-size: 34px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    // Artwork fades into the caption, leaving the
                                    // progress rail readable over a dark surface.
                                    if !root.list_view: Rectangle {
                                        y: parent.height - 70px;
                                        height: 70px;
                                        background: @linear-gradient(180deg, transparent, Theme.current.card);
                                    }
                                }

                                if card.status != "" && (root.list_view || root.item-width > 100px): library_status := Rectangle {
                                    x: root.list_view ? 104px : 8px;
                                    y: root.list_view ? 10px : 8px;
                                    width: Math.min(status_text.preferred-width + 18px, root.list_view ? parent.width - 152px : parent.width - 54px);
                                    height: 26px;
                                    border-radius: 13px;
                                    border-width: 1px;
                                    border-color: Theme.current.accent_vivid;
                                    background: Theme.current.episode_number_badge;
                                    status_text := Text {
                                        x: 9px;
                                        width: Math.max(1px, parent.width - 18px);
                                        text: card.status;
                                        color: Theme.current.on_accent;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                library_card_menu := Rectangle {
                                    x: parent.width - self.width - 4px; y: 6px;
                                    width: Math.min(34px, parent.width - 8px); height: 34px;
                                    border-radius: 17px;
                                    background: menu_touch.has-hover ? Theme.current.hero_control_hover : Theme.current.hero_control;
                                    accessible-role: button;
                                    accessible-label: @tr("Library options");
                                    IcMoreHoriz {
                                        x: 7px; y: 7px; width: 20px; height: 20px;
                                        fill: Theme.current.text_bright;
                                    }
                                    menu_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if (root.touch_menus) {
                                                root.open_lib_menu(i, card.watched);
                                            } else {
                                                lib_ctx.show({ x: library_card_menu.x, y: library_card_menu.y + library_card_menu.height });
                                            }
                                        }
                                    }
                                }

                                if card.watched_count > 0 && card.episode_count > 0: library_progress := HorizontalLayout {
                                    x: root.list_view ? 104px : 9px;
                                    y: root.list_view ? parent.height - 26px : root.item-width * 3 / 2 - 25px;
                                    width: parent.width - self.x - 9px;
                                    height: 18px;
                                    spacing: root.item-width > 100px ? 8px : 4px;
                                    library_progress_track := Rectangle {
                                        horizontal-stretch: 1;
                                        min-width: 1px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: Theme.current.progress_track_overlay;
                                        library_progress_fill := Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            width: parent.width * Math.min(1, card.watched_count * 1.0 / card.episode_count);
                                            height: 100%;
                                            border-radius: 3px;
                                            background: Theme.current.progress_fill;
                                        }
                                    }
                                    library_episode_count := Text {
                                        text: card.watched_count + " / " + card.episode_count;
                                        min-width: 0px;
                                        max-width: parent.width * 0.65;
                                        overflow: elide;
                                        color: Theme.current.text_primary;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }

                                library_caption := VerticalLayout {
                                    x: root.list_view ? 104px : 9px;
                                    y: root.list_view ? 42px : root.item-width * 3 / 2 + 6px;
                                    width: parent.width - self.x - 9px;
                                    height: root.list_view ? 62px : 60px;
                                    spacing: 4px;
                                    alignment: start;
                                    library_title := Text {
                                        text: card.title;
                                        color: Theme.current.text_home_title;
                                        font-size: root.list_view ? 15px : 13px;
                                        font-weight: 600;
                                        overflow: elide;
                                        min-width: 0px;
                                    }
                                    library_metadata := Text {
                                        text: card.year + (card.year != "" && card.media_type != "" ? " · " : "") + card.media_type;
                                        color: Theme.current.text_home_metadata;
                                        font-size: 11px;
                                        overflow: elide;
                                        min-width: 0px;
                                    }
                                    if card.badge != "": library_resume := Text {
                                        text: card.badge;
                                        color: Theme.current.text_download;
                                        font-size: 11px;
                                        font-weight: 600;
                                        overflow: elide;
                                        min-width: 0px;
                                    }
                                }
                            }

                        }
                    }
                    }
                }
                // Fixed viewport, like Settings: scroll a placeholder for
                // the header, then paint its live controls above the cards.
                // Moving this overlay never changes the Flickable geometry.
                library_header := Rectangle {
                    y: root.header_shift;
                    width: 100%;
                    height: library_toolbar.preferred-height;
                    background: Theme.current.artwork_canvas;
                    TouchArea {}
                    library_toolbar := VerticalLayout {
                        width: 100%;
                        spacing: 14px;
                        library_hero := VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 14px;
                            library_heading := HorizontalLayout {
                                vertical-stretch: 0;
                                min-height: 44px;
                                spacing: 8px;
                                Text {
                                    text: @tr("My Library");
                                    font-size: root.narrow ? 25px : 32px;
                                    font-weight: 700;
                                    color: Theme.current.text_bright;
                                    min-width: 0px;
                                    max-width: self.preferred-width;
                                    horizontal-stretch: 1;
                                    height: self.preferred-height;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: @tr("({n} item)" | "({n} items)" % root.library.length);
                                    font-size: 13px;
                                    color: Theme.current.text_hint;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; min-width: 0px; }

                            }
                            Text {
                                text: @tr("Your saved anime, continue watching, and downloads.");
                                color: Theme.current.text_home_metadata;
                                font-size: 14px;
                                wrap: word-wrap;
                                min-width: 0px;
                                height: self.preferred-height;
                            }
                        }
                        library_controls := Rectangle {
                            height: library_search_reveal.height + library_filter_and_sort.height;
                            // Keep the field mounted while moving it below its toggle on phones.
                            library_search_reveal := Rectangle {
                                y: root.narrow ? library_filter_and_sort.height : 0px;
                                width: 100%;
                                height: root.search_open ? 58px : 0px;
                                visible: self.height > 0px;
                                opacity: root.search_open ? 1.0 : 0.0;
                                clip: true;
                                animate height { duration: Anim.transition_slide; easing: ease-out; }
                                animate opacity { duration: Anim.transition_fade; easing: ease-out; }
                                library_search_line := SearchField {
                                    width: 100%;
                                    height: 44px;
                                    enabled: root.search_open;
                                    text <=> root.query;
                                    placeholder-text: @tr("Search library");
                                    search-icon: true;
                                    roomy: true;
                                    init => { if (root.search_open) { search_focus_t.start(); } }
                                    edited(_) => { root.view_changed(); }
                                }
                            }

                            library_filter_and_sort := VerticalLayout {
                                y: root.narrow ? 0px : library_search_reveal.height;
                                width: 100%;
                                height: self.preferred-height;
                                spacing: 14px;
                                // All automatic and custom categories remain reachable on a fresh
                                // install. A horizontal rail keeps every pill at its natural size.
                                filter_rail := Flickable {
                                    visible: root.category_names.length > 0;
                                    height: root.category_names.length > 0 ? 44px : 0px;
                                    vertical-stretch: 0;
                                    content-width: filter_chips.preferred-width;
                                    content-height: self.height;
                                    interactive: true;
                                    changed width => {
                                        root.reveal_filter(root.selected_filter_left, root.selected_filter_width);
                                    }
                                    changed content-width => {
                                        root.reveal_filter(root.selected_filter_left, root.selected_filter_width);
                                    }
                                    filter_chips := HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        LibraryFilterChip {
                                            label: @tr("All");
                                            selected: root.library_filter_category == "";
                                            picked => { root.library_filter_picked(""); }
                                            reveal(left, w) => { root.reveal_filter(left, w); }
                                        }
                                        for name[i] in root.category_names: LibraryFilterChip {
                                            label: i < root.category_labels.length ? root.category_labels[i] : name;
                                            selected: root.library_filter_category == name;
                                            picked => { root.library_filter_picked(name); }
                                            reveal(left, w) => { root.reveal_filter(left, w); }
                                        }
                                    }
                                    KbMark { on: root.kb_zone == 1; active: root.kb_active; }
                                }

                                library_sort_controls := HorizontalLayout {
                                    height: 44px;
                                    vertical-stretch: 0;
                                    spacing: 10px;
                                    library_sort := Dropdown {
                                        model: [@tr("Recently Added"), @tr("Title"), @tr("Release year")];
                                        current-index <=> root.sort_index;
                                        roomy: true;
                                        pill: true;
                                        min-width: 0px;
                                        max-width: 190px;
                                        horizontal-stretch: 1;
                                        selected(_) => { root.view_changed(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; min-width: 0px; }
                                    Rectangle {
                                        width: 88px;
                                        height: 44px;
                                        border-radius: 22px;
                                        border-width: 1px;
                                        border-color: Theme.current.border_medium;
                                        background: Theme.current.hero_control;
                                        clip: true;
                                        for mode in [false, true]: library_view_button := Rectangle {
                                            x: mode ? 44px : 0px;
                                            width: 44px;
                                            height: 44px;
                                            background: root.list_view == mode ? Theme.current.selection_wash : transparent;
                                            accessible-role: button;
                                            accessible-label: mode ? @tr("List view") : @tr("Grid view");
                                            if !mode: Path {
                                                x: 12px; y: 12px; width: 20px; height: 20px;
                                                viewbox-width: 24; viewbox-height: 24;
                                                commands: "M3 3h7v7H3zm11 0h7v7h-7zM3 14h7v7H3zm11 0h7v7h-7z";
                                                fill: root.list_view == mode ? Theme.current.accent_vivid : Theme.current.text_hint;
                                            }
                                            if mode: Path {
                                                x: 12px; y: 12px; width: 20px; height: 20px;
                                                viewbox-width: 24; viewbox-height: 24;
                                                commands: "M3 4h3v3H3zm5 0h13v3H8zM3 10h3v3H3zm5 0h13v3H8zM3 16h3v3H3zm5 0h13v3H8z";
                                                fill: root.list_view == mode ? Theme.current.accent_vivid : Theme.current.text_hint;
                                            }
                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.list_view = mode; }
                                            }
                                        }
                                    }
                                    library_search_button := Rectangle {
                                        width: 44px;
                                        height: 44px;
                                        border-radius: 22px;
                                        border-width: 1px;
                                        border-color: Theme.current.border_strong;
                                        background: search_button_touch.has-hover ? Theme.current.control_hover : Theme.current.hero_control;
                                        accessible-role: button;
                                        accessible-label: @tr("Search library");
                                        if !root.search_open: IcSearch {
                                            x: 12px; y: 12px; width: 20px; height: 20px;
                                            fill: Theme.current.text_primary;
                                        }
                                        if root.search_open: IcClose {
                                            x: 12px; y: 12px; width: 20px; height: 20px;
                                            fill: Theme.current.text_primary;
                                        }
                                        search_button_touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.search_open = !root.search_open;
                                                if (!root.search_open) {
                                                    root.query = "";
                                                    root.view_changed();
                                                    nav_scope.focus();
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            // Empty state
            if root.library.length == 0: VerticalLayout {
                y: root.header_cover;
                width: 100%;
                height: Math.max(1px, parent.height - root.header_cover);
                horizontal-stretch: 1;
                vertical-stretch: 1;
                alignment: center;

                Text {
                    text: "📚";
                    font-size: 42px;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.query != "" ? @tr("No matching titles in your library.") : root.library_empty_hint;
                    font-size: 14px;
                    color: #8a8a9a;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    min-width: 0px;
                    max-width: 560px;
                }
            }

            }

            // Bottom tab bar (narrow only): wide layouts use the left rail.
            if root.narrow: bottom := BottomNav {
                active: 2;
                safe-bottom: root.safe-bottom;
                safe-left: root.safe-left;
                safe-right: root.safe-right;
                page-inset-left: 18px + root.safe-left;
                page-inset-right: 18px + root.safe-right;
                kb_zone: root.kb_zone;
                kb_nav: root.kb_nav;
                kb_active <=> root.kb_active;

                home_picked => { root.home_picked(); }
                discover_picked => { root.discover_picked(); }
                library_picked => { root.library_picked(); }
                settings_picked => { root.settings_picked(); }
            }
        }

        // Left navigation rail (wide layouts only; narrow uses the bottom
        // bar). Declared after the page column so it paints over the strip
        // its own footprint reserves — the column widens its left padding by
        // `rail_w`, so no page content lands under it.
        if !root.narrow: rail := SideNav {
            viewport-width: root.nav-viewport-width;
            active: 2;
            safe-top: root.safe-top;
            safe-left: root.safe-left;
            safe-bottom: root.safe-bottom;
            kb_zone: root.kb_zone;
            kb_nav: root.kb_nav;
            kb_active <=> root.kb_active;

            home_picked => { root.home_picked(); }
            discover_picked => { root.discover_picked(); }
            library_picked => { root.library_picked(); }
            settings_picked => { root.settings_picked(); }
        }

        // Card bottom sheet (single instance, page-level overlay): the
        // dim backdrop eats outside taps (dismiss only, never forwarded).
        MenuSheet {
            open: root.menu_open;
            width: 100%;
            height: 100%;
            safe-bottom: root.safe-bottom;
            safe-left: root.safe-left;
            safe-right: root.safe-right;
            max_h: root.height * 0.85;
            sheet_title: @tr("Library options");
            items: [
                { label: @tr("Open"), enabled: true },
                { label: root.menu_watched ? @tr("Mark series as unwatched") : @tr("Mark series as watched"), enabled: true },
                { label: @tr("Mark as On Hold"), enabled: true },
                { label: @tr("Mark as Dropped"), enabled: true },
                { label: @tr("Back to automatic"), enabled: true },
                { label: @tr("Remove from library"), enabled: true },
            ];
            picked(a) => {
                if (!root.menu_valid) {
                    root.close_menu();
                    return;
                }
                if (a == 0) {
                    root.kb_active = false;
                    root.kb_zone = 2;
                    root.kb_idx = root.menu_idx;
                    root.library_item_picked(root.menu_idx);
                } else if (a == 1) {
                    root.library_watch_action(root.menu_idx, root.menu_watched ? 2 : 1);
                } else if (a == 2) {
                    root.library_status_action(root.menu_idx, 1);
                } else if (a == 3) {
                    root.library_status_action(root.menu_idx, 2);
                } else if (a == 4) {
                    root.library_status_action(root.menu_idx, 0);
                } else {
                    root.remove_library_item(root.menu_idx);
                }
                root.close_menu();
            }
            closed => { root.close_menu(); }
        }
    }
}
