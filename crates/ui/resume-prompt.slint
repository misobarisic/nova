import { Theme, Anim, InterfaceStyle } from "@NovaUiShared";

// Keep the painted decision stable until its exit finishes. The logical open
// flag owns all actions; retention only owns pixels, focus and the input shield.
export component ResumePrompt inherits Rectangle {
    in property <bool> opened;
    in property <length> button-font-size: 12px;
    in property <bool> owner-valid: true;
    in property <string> owner-key;
    in property <string> heading;
    in property <string> message;
    in property <bool> source-changed;
    in property <bool> can-resume: true;
    in-out property <int> focus-index: 1;
    out property <bool> visual-retained: root.retained;
    callback choice(bool);
    callback cancelled();
    callback visual-closed();
    public function focus_shell() { if root.opened || root.retained { prompt_focus.focus(); } }
    private property <bool> retained;
    private property <bool> motion: Anim.enabled && Anim.transitions;
    private property <bool> animate-step;
    private property <float> progress: 0;
    private property <float> fade: 0;
    animate progress { duration: root.animate-step && root.motion ? Anim.transition_slide : 0ms; easing: ease-out; }
    animate fade { duration: root.animate-step && root.motion ? Anim.transition_fade : 0ms; easing: ease-out; }
    private property <string> painted-heading;
    private property <string> painted-message;
    private property <bool> painted-source-changed;
    private property <bool> painted-can-resume;
    visible: root.owner-valid && (root.opened || root.retained);
    width: 100%; height: 100%; clip: true;
    function snapshot() {
        if root.opened && root.owner-valid {
            root.painted-heading = root.heading; root.painted-message = root.message;
            root.painted-source-changed = root.source-changed; root.painted-can-resume = root.can-resume;
        }
    }
    function finish_exit(restore-focus: bool) {
        let was-retained = root.retained;
        root.retained = false;
        root.painted-heading = ""; root.painted-message = "";
        if was-retained && restore-focus && !root.opened { root.visual-closed(); }
    }
    function invalidate() {
        enter.stop(); exit.stop(); root.animate-step = false;
        root.progress = 0; root.fade = 0; root.finish_exit(false);
    }
    function update() {
        enter.stop(); exit.stop();
        if !root.owner-valid { root.invalidate(); if root.opened { root.cancelled(); } return; }
        if root.opened {
            if !root.retained { root.animate-step = false; root.progress = 0; root.fade = 0; }
            root.snapshot(); root.retained = true; prompt_focus.focus();
            if root.motion { enter.start(); }
            else { root.animate-step = false; root.progress = 1; root.fade = 1; }
        } else if root.retained {
            root.animate-step = root.motion; root.progress = 0; root.fade = 0;
            prompt_focus.focus();
            if root.motion { exit.start(); } else { root.finish_exit(true); }
        }
    }
    init => { root.update(); }
    changed opened => { root.update(); }
    changed owner-valid => {
        if !root.owner-valid {
            root.invalidate();
            if root.opened { root.cancelled(); }
        }
    }
    changed owner-key => {
        // Display labels can legitimately refresh while the same request is
        // open. Backend request ownership decides whether that prompt survives.
        if root.retained && !root.opened { root.invalidate(); }
    }
    changed heading => { root.snapshot(); }
    changed message => { root.snapshot(); }
    changed source-changed => { root.snapshot(); }
    changed can-resume => { root.snapshot(); }
    changed motion => {
        if !root.motion {
            enter.stop(); exit.stop(); root.animate-step = false;
            root.progress = root.opened ? 1 : 0; root.fade = root.opened ? 1 : 0;
            if !root.opened { root.finish_exit(true); }
        }
    }
    enter := Timer { interval: 1ms; running: false; triggered => { self.stop(); if root.opened && root.owner-valid { root.animate-step = true; root.progress = 1; root.fade = 1; } } }
    exit := Timer { interval: Math.max(Anim.transition_slide, Anim.transition_fade); running: false; triggered => { self.stop(); if !root.opened { root.finish_exit(true); } } }
    scrim := Rectangle { width: 100%; height: 100%; background: Theme.current.scrim_resume; opacity: root.fade; }
    TouchArea { width: 100%; height: 100%; scroll-event => { accept } clicked => { if root.opened { root.cancelled(); } } }
    prompt_focus := FocusScope {
        enabled: root.opened || root.retained;
        key-pressed(e) => {
            if !root.opened { accept }
            else if e.text == Key.Escape || e.text == Key.Back || e.text == Key.Backspace { if !e.repeat { root.cancelled(); } accept }
            else if e.text == Key.LeftArrow || e.text == Key.UpArrow { root.focus-index = 0; accept }
            else if e.text == Key.RightArrow || e.text == Key.DownArrow || e.text == Key.Tab { root.focus-index = root.can-resume ? 1 : 0; accept }
            else if e.text == Key.Return || e.text == " " { if !e.repeat { root.choice(root.focus-index == 1 && root.can-resume); } accept }
            else { accept }
        }
    }
    panel := Rectangle {
        width: Math.min(InterfaceStyle.tv ? 560px : 360px, parent.width - 40px);
        height: root.painted-source-changed ? (InterfaceStyle.tv ? 280px : 224px) : (InterfaceStyle.tv ? 224px : 176px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + 24px * (1 - root.progress);
        opacity: root.fade;
        background: Theme.current.player_menu; border-radius: 14px;
        TouchArea { width: 100%; height: 100%; scroll-event => { accept } }
        VerticalLayout {
            padding: 20px; spacing: 12px;
            Text { text: root.painted-heading; color: Theme.current.text_bright; font-size: InterfaceStyle.tv ? 26px : 18px; font-weight: 600; }
            Text { text: root.painted-message; color: Theme.current.text_resume_hint; font-size: InterfaceStyle.tv ? 20px : 14px; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end; spacing: 8px;
                Rectangle {
                    width: InterfaceStyle.tv ? 160px : 112px; height: InterfaceStyle.tv ? 56px : 40px; border-radius: 8px; background: Theme.current.hover_overlay;
                    accessible-role: button; accessible-label: @tr("Start over"); accessible-enabled: root.opened;
                    border-width: InterfaceStyle.tv && root.focus-index == 0 ? 2px : 0px; border-color: Theme.current.focus_ring;
                    Text { text: @tr("Start over"); color: Theme.current.text_bright; font-size: InterfaceStyle.tv ? 20px : root.button-font-size; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { width: 100%; height: 100%; enabled: root.opened; clicked => { if root.opened { root.focus-index = 0; root.choice(false); } } }
                }
                Rectangle {
                    width: InterfaceStyle.tv ? 144px : 100px; height: InterfaceStyle.tv ? 56px : 40px; border-radius: 8px; background: Theme.current.accent;
                    accessible-role: button; accessible-label: @tr("Resume"); accessible-enabled: root.opened && root.can-resume;
                    opacity: root.painted-can-resume ? 1 : 0.4;
                    // The accent fill and focus_ring share a colour; use its foreground.
                    border-width: InterfaceStyle.tv && root.focus-index == 1 ? 2px : 0px; border-color: Theme.current.on_accent;
                    Text { text: @tr("Resume"); color: Theme.current.text_bright; font-size: InterfaceStyle.tv ? 20px : root.button-font-size; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { width: 100%; height: 100%; enabled: root.opened && root.can-resume; clicked => { if root.opened && root.can-resume { root.focus-index = 1; root.choice(true); } } }
                }
            }
        }
    }
    if root.retained && !root.opened: TouchArea { width: 100%; height: 100%; scroll-event => { accept } }
}
