import { Theme, SubtitleStyle } from "@NovaUiShared";
import { MiniSlider, PillButton } from "settings-controls.slint";

// Both hosts use the same units and bounds. The backend owns normalization and
// persistence; this component only reports an edit to one field.
export component SubtitleControls inherits VerticalLayout {
    in property <[float]> values: [0, 56, 19, 100, 3, 0, 0];
    in property <int> focused_idx: -1;
    callback edited(int, float);
    callback reveal(length, length);
    pure function timing_label(v: float) -> string {
        let tenths = Math.round(Math.abs(v) * 10);
        return (v > 0 ? "+" : v < 0 ? "−" : "") + Math.floor(tenths / 10) + "." + Math.mod(tenths, 10) + " s";
    }
    spacing: 12px;
    alignment: start;
    vertical-stretch: 0;

    for caption[i] in [@tr("Subtitle timing (seconds)"), @tr("Subtitle size (scaled px)"), @tr("Side margins (scaled px)"), @tr("Vertical position (%)"), @tr("Black outline (scaled px)")]: VerticalLayout {
        spacing: 4px; alignment: start; vertical-stretch: 0;
        property <bool> selected: root.focused_idx == i;
        changed selected => { if self.selected { root.reveal(self.absolute-position.y, self.height); } }
        Text { text: caption; font-size: 14px; color: Theme.current.text_bright; wrap: word-wrap; min-width: 0px; vertical-stretch: 0; }
        HorizontalLayout {
            spacing: 6px; vertical-stretch: 0;
            PillButton { label: "−"; compact: true; btn_min_width: 44px;
                accessible-label: @tr("Decrease") + " " + caption;
                clicked => { root.edited(i, root.values[i] - SubtitleStyle.step(i)); } }
            MiniSlider {
                allow-vertical-pan: true;
                horizontal-stretch: 1; min-width: 24px;
                name: caption; focused: root.focused_idx == i;
                value: root.values[i]; minimum: i == 0 ? -60 : i == 1 ? 16 : 0;
                maximum: i == 0 ? 60 : i == 1 ? 100 : i == 2 ? 200 : i == 3 ? 100 : 10;
                step: SubtitleStyle.step(i);
                changed(v) => { root.edited(i, v); }
            }
            Text {
                width: 58px; height: 44px;
                text: i == 0 ? root.timing_label(root.values[i]) : (Math.round(root.values[i] * 100) / 100) + (i == 3 ? "%" : " px");
                color: Theme.current.text_primary; font-size: 13px;
                horizontal-alignment: center; vertical-alignment: center;
            }
            PillButton { label: "+"; compact: true; btn_min_width: 44px;
                accessible-label: @tr("Increase") + " " + caption;
                clicked => { root.edited(i, root.values[i] + SubtitleStyle.step(i)); } }
        }
    }
    Text {
        text: @tr("Positive timing shows subtitles later; negative timing shows them earlier. Size, margins and outline use a 720p canvas and scale with the video. Position: 0% top, 100% bottom.");
        font-size: 12px; color: Theme.current.text_settings; wrap: word-wrap; min-width: 0px;
        vertical-stretch: 0;
    }
    VerticalLayout {
    spacing: 4px; alignment: start; vertical-stretch: 0;
    property <bool> selected: root.focused_idx == 5;
    changed selected => { if self.selected { root.reveal(self.absolute-position.y, self.height); } }
    color_caption := Text { text: @tr("Subtitle text color"); font-size: 14px; color: Theme.current.text_bright; wrap: word-wrap; min-width: 0px; vertical-stretch: 0; }
    // A full-width cycle button keeps translated choices inside small cards.
    color_button := PillButton {
        label: root.values[5] == 1 ? @tr("Yellow") : root.values[5] == 2 ? @tr("Cyan") : @tr("White");
        accessible-label: @tr("Subtitle text color");
        width: 100%; wrap_label: true; focused: root.focused_idx == 5; vertical-stretch: 0;
        clicked => { root.edited(5, Math.mod(root.values[5] + 1, 3)); }
    }
    }
    VerticalLayout {
    spacing: 4px; alignment: start; vertical-stretch: 0;
    property <bool> selected: root.focused_idx == 6;
    changed selected => { if self.selected { root.reveal(self.absolute-position.y, self.height); } }
    embedded_caption := Text { text: @tr("Embedded subtitle styling"); font-size: 14px; color: Theme.current.text_bright; wrap: word-wrap; min-width: 0px; vertical-stretch: 0; }
    embedded_button := PillButton {
        label: root.values[6] >= 0.5 ? @tr("Override embedded styles") : @tr("Preserve embedded styles");
        accessible-label: @tr("Embedded subtitle styling");
        width: 100%; wrap_label: true; focused: root.focused_idx == 6; vertical-stretch: 0;
        clicked => { root.edited(6, root.values[6] >= 0.5 ? 0 : 1); }
    }
    }
    Text {
        text: @tr("Text appearance applies to plain subtitles. Override embedded styles to restyle ASS subtitles; this can change signs and positioning. Image subtitles keep their original appearance.");
        font-size: 12px; color: Theme.current.text_settings; wrap: word-wrap; min-width: 0px;
        vertical-stretch: 0;
    }
}
