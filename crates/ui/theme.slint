// Shared palettes: the standard appearance plus true-black mode.
//
// Tokens name visual roles, not hex values. Similar shades stay distinct where
// they currently serve different roles, so extraction does not restyle the UI.
export struct ThemePalette {
    scope_synced_fill: color, scope_synced_text: color,
    scope_local_fill: color, scope_local_text: color,
    scope_override_fill: color, scope_override_text: color,
    // Core surfaces and content.
    canvas: color,
    artwork_canvas: color,
    card: brush,
    popup: color,
    popup_divider: color,
    category_panel: color,
    control: color,
    control_hover: color,
    input_hover: color,
    control_border: color,
    step_border: color,
    slider_track: color,
    input_disabled_mark: color,
    text_bright: color,
    text_primary: color,
    text_secondary: color,
    text_muted: color,
    text_hint: color,
    text_disabled: color,
    icon_disabled: color,
    text_settings: color,
    text_selected: color,
    accent: color,
    accent_soft: color,
    accent_vivid: color,
    accent_hover: color,
    accent_pressed: color,
    selection_fill: color,
    selection_wash: color,
    input_selection: color,
    search_icon: color,
    search_icon_focused: color,

    // Borders and translucent interaction washes; retain exact alpha bytes.
    border_soft: color,
    border_subtle: color,
    border_card: color,
    border_medium: color,
    border_overlay: color,
    border_strong: color,
    hover_subtle: color,
    hover_overlay: color,
    progress_track_overlay: color,
    focus_soft: color,
    search_active_wash: color,
    settings_selected_wash: color,
    primary_button_border: color,

    // Settings controls and notices.
    settings_control: color,
    settings_control_hover: color,
    destructive_control: color,
    destructive_control_hover: color,
    text_destructive: color,
    toggle_knob_active: color,
    toggle_knob: color,
    settings_icon_muted: color,
    text_error: color,
    pairing_prompt: color,
    removal_prompt: color,
    removal_border: color,
    dialog_border: color,
    text_removal_warning: color,

    // Detail controls and episode cards.
    detail_filter_hover: color,
    text_filter: color,
    pager_hover: color,
    pager_roomy: color,
    pager_disabled_border: color,
    text_detail_metadata: color,
    hero_control_hover: color,
    hero_control: color,
    stream_download: color,
    stream_card: color,
    text_download: color,
    download_track: color,
    text_hero_icon: color,
    text_hero_metadata: color,
    hero_metadata_badge: color,
    text_hero_badge: color,
    text_description: color,
    hero_library_hover: color,
    hero_library: color,
    text_detail_tab: color,
    season_card: color,
    season_caption: color,
    text_episode_metadata: color,
    episode_placeholder: color,
    episode_toolbar: color,
    episode_search_hover: color,
    episode_search: color,
    text_search_match: color,
    icon_episode_search: color,
    text_episode_counter: color,
    episode_empty_panel: color,
    episode_card: color,
    text_episode_hint: color,
    episode_number_badge: color,
    episode_number_border: color,
    text_context_menu: color,

    // Home cards and calendar.
    home_badge: color,
    home_artwork_placeholder: color,
    home_progress_track: color,
    text_home_badge: color,
    text_home_title: color,
    text_home_date: color,
    text_home_metadata: color,
    text_calendar_today: color,
    text_calendar_day: color,
    calendar_border: color,
    calendar_control: color,
    icon_home_pager: color,
    text_home_type: color,
    home_divider: color,

    // Tracking sheet.
    tracking_control_hover: color,
    tracking_control: color,
    text_tracking_primary: color,
    tracking_toggle: color,
    text_tracking_notice: color,
    tracking_mapping: color,
    tracking_panel: color,
    tracking_handle: color,
    tracking_service_control: color,
    text_tracking_warning: color,

    // Navigation.
    nav_bottom: color,
    nav_rail: color,
    nav_shadow: color,
    nav_selected: color,
    nav_selected_border: color,
    nav_selected_glow: color,
    nav_icon_inactive: color,
    nav_label_inactive: color,

    // Player and modal overlays.
    player_menu: color,
    player_menu_border: color,
    player_control_hover: color,
    text_player_muted: color,
    player_secondary: color,
    text_player_secondary: color,
    text_player_caption: color,
    player_control: color,
    player_close_hover: color,
    player_tooltip: color,
    text_resume_hint: color,
    scrim_player: color,
    scrim_shadow: color,
    scrim_category: color,
    scrim_player_feedback: color,
    scrim_episode: color,
    scrim_tracking: color,
    scrim_resume: color,
    scrim_settings: color,

    // Semantic roles that currently share colors.
    focus_ring: color,
    on_accent: color,
    artwork_backdrop: color,
    on_watched_badge: color,
    watched_badge: color,
    player_progress_fill: color,
    scrim_artwork: color,
    scrim_episode_card: color,

    // Gradient brushes.
    primary_button_hover: brush,
    primary_button: brush,
    progress_fill: brush,
    season_scrim: brush,

}

export global Theme {
    // Replace this value on the UI thread; component bindings update live.
    in-out property <bool> true_black: false;
    // Shared media/detail card geometry; zero gives square artwork and containers.
    in-out property <length> card_corner_radius: 10px;
    in-out property <length> card_spacing: 8px;
    out property <brush> black_season_scrim: @linear-gradient(180deg, transparent, #000000c0);
    in-out property <ThemePalette> current: self.standard;
    out property <ThemePalette> standard: {
        scope_synced_fill: #10382b, scope_synced_text: #6fe0a0,
        scope_local_fill: #292044, scope_local_text: #bca0ff,
        scope_override_fill: #48301a, scope_override_text: #efb76f,
        // Core surfaces and content.
        canvas: #0f0f12,
        artwork_canvas: #080f19,
        card: #111827,
        popup: #1c1c22,
        popup_divider: #26262e,
        category_panel: #18181c,
        control: #232330,
        control_hover: #2b2b35,
        input_hover: #23232e,
        control_border: #33333c,
        step_border: #33333d,
        slider_track: #2e2e38,
        input_disabled_mark: #4a4a58,
        text_bright: #ffffff,
        text_primary: #e6e6ea,
        text_secondary: #c9c9d4,
        text_muted: #8a8a9a,
        text_hint: #6c6c7d,
        text_disabled: #5c5c6e,
        icon_disabled: #55555f,
        text_settings: #bac1d3,
        text_selected: #e6e0ff,
        accent: #8b5cf6,
        accent_soft: #a89af5,
        accent_vivid: #a477ff,
        accent_hover: #9165f7,
        accent_pressed: #7c4df0,
        selection_fill: #443e66,
        selection_wash: #8b5cf633,
        input_selection: #8b5cf655,
        search_icon: #8791a6,
        search_icon_focused: #b59aff,

        // Borders and translucent interaction washes; retain exact alpha bytes.
        border_soft: #ffffff14,
        border_subtle: #ffffff0c,
        border_card: #ffffff12,
        border_medium: #ffffff16,
        border_overlay: #ffffff20,
        border_strong: #ffffff28,
        hover_subtle: #ffffff0a,
        hover_overlay: #ffffff18,
        progress_track_overlay: #ffffff24,
        focus_soft: #a477ff60,
        search_active_wash: #8b5cf624,
        settings_selected_wash: #8b5cf622,
        primary_button_border: #b4a1ff70,

        // Settings controls and notices.
        settings_control: #1b2538,
        settings_control_hover: #28334a,
        destructive_control: #30202c,
        destructive_control_hover: #492936,
        text_destructive: #fda4af,
        toggle_knob_active: #14141a,
        toggle_knob: #d9d9e2,
        settings_icon_muted: #6c6c7a,
        text_error: #ffaaaa,
        pairing_prompt: #1d1830,
        removal_prompt: #2a1620,
        removal_border: #b3556e,
        dialog_border: #454552,
        text_removal_warning: #e3b5b5,

        // Detail controls and episode cards.
        detail_filter_hover: #3a3a46,
        text_filter: #c8c8d2,
        pager_hover: #303149,
        pager_roomy: #22283a,
        pager_disabled_border: #2a2a32,
        text_detail_metadata: #9ca6b8,
        hero_control_hover: #303442e0,
        hero_control: #101622b8,
        stream_download: #24203a,
        stream_card: #1f1f27,
        text_download: #b9a7ff,
        download_track: #38324f,
        text_hero_icon: #e2e5ef,
        text_hero_metadata: #c3c7d7,
        hero_metadata_badge: #252b38b0,
        text_hero_badge: #ced1df,
        text_description: #bec3d2,
        hero_library_hover: #343b4d,
        hero_library: #252c3bcc,
        text_detail_tab: #a6adc5,
        season_card: #151d2b,
        season_caption: #151d2bb8,
        text_episode_metadata: #b9c0d2,
        episode_placeholder: #1c1c23,
        episode_toolbar: #111927,
        episode_search_hover: #2b3448,
        episode_search: #1d2638,
        text_search_match: #cbb7ff,
        icon_episode_search: #c2cad9,
        text_episode_counter: #b5a1de,
        episode_empty_panel: #080f1b,
        episode_card: #0b1221,
        text_episode_hint: #929caf,
        episode_number_badge: #5b21b6dc,
        episode_number_border: #a855f7,
        text_context_menu: #cccccc,

        // Home cards and calendar.
        home_badge: #080d17dd,
        home_artwork_placeholder: #1b2231,
        home_progress_track: #252b3a,
        text_home_badge: #c4c9d5,
        text_home_title: #eeeef4,
        text_home_date: #858d9f,
        text_home_metadata: #a7aec0,
        text_calendar_today: #c4b5fd,
        text_calendar_day: #eeeeee,
        calendar_border: #2a2a33,
        calendar_control: #17171d,
        icon_home_pager: #f4f4f5,
        text_home_type: #e2e5ed,
        home_divider: #23232b,

        // Tracking sheet.
        tracking_control_hover: #293346,
        tracking_control: #1b2435,
        text_tracking_primary: #f2f2f4,
        tracking_toggle: #252c3b,
        text_tracking_notice: #d7cfff,
        tracking_mapping: #19191f,
        tracking_panel: #0d1522,
        tracking_handle: #3b4456,
        tracking_service_control: #182131,
        text_tracking_warning: #eab465,

        // Navigation.
        nav_bottom: #080f19,
        nav_rail: #101019,
        nav_shadow: #08081280,
        nav_selected: #6334a7,
        nav_selected_border: #9658eb,
        nav_selected_glow: #853ce080,
        nav_icon_inactive: #93929f,
        nav_label_inactive: #aaa8b6,

        // Player and modal overlays.
        player_menu: #111827,
        player_menu_border: #ffffff14,
        player_control_hover: #2b2b35,
        text_player_muted: #ffffff66,
        player_secondary: #ffffff59,
        text_player_secondary: #ffffff99,
        text_player_caption: #ffffffd9,
        player_control: #111827cc,
        player_close_hover: #2b2b35,
        player_tooltip: #111827f0,
        text_resume_hint: #b8b8be,
        scrim_player: #000000,
        scrim_shadow: #00000080,
        scrim_category: #000000a0,
        scrim_player_feedback: #000000a6,
        scrim_episode: #00000066,
        scrim_tracking: #000b,
        scrim_resume: #000000b8,
        scrim_settings: #000000aa,

        // Semantic roles that currently share colors.
        focus_ring: #8b5cf6,
        on_accent: #ffffff,
        artwork_backdrop: #000000,
        on_watched_badge: #000000,
        watched_badge: #ffffff,
        player_progress_fill: #8b5cf6,
        scrim_artwork: #080f19,
        scrim_episode_card: #0b1221,

        // Gradient brushes.
        primary_button_hover: @linear-gradient(110deg, #b079ff, #5657ef),
        primary_button: @linear-gradient(110deg, #a15bff, #644bff, #443dcc),
        progress_fill: @linear-gradient(90deg, #a855f7, #7c3aed),
        season_scrim: @linear-gradient(180deg, transparent, #080f19c0),

    };
}
