import { Theme } from "theme.slint";
import { TitleArtwork } from "title-artwork.slint";
import { ScrollView } from "scrollview.slint";
import { ContinueRow, UpcomingRow, HomeCatalogSection, HomeCatalogCard, CalCell, SheetItem } from "types.slint";
import { MenuSheet } from "menusheet.slint";
import { SideNav, NavMetrics } from "sidenav.slint";
import { BottomNav } from "bottomnav.slint";
import { Anim } from "anim.slint";
import { IcChevronLeft, IcChevronRight, IcPlay, IcStarBorder, IcSchedule, IcDisplay } from "icons.slint";

// Small "Next up" pill pinned to a Continue card's poster top-right. Shown
// only when the card offers the next episode of a series still being
// watched (a resume already has the progress rail).
component NextUpBadge inherits Rectangle {
    in property <length> available-width;
    width: Math.min(root.available-width, badge_lbl.preferred-width + 16px);
    height: 22px;
    border-radius: 8px;
    background: Theme.current.accent;

    badge_lbl := Text {
        text: @tr("Next up");
        font-size: 11px;
        font-weight: 700;
        color: Theme.current.text_bright;
        width: Math.max(0px, root.width - 16px);
        overflow: elide;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

// Small "New Episode" pill, same slot: shown when everything else dated and
// released is already watched, so the offered episode is new.
component NewEpisodeBadge inherits Rectangle {
    in property <length> available-width;
    width: Math.min(root.available-width, badge_lbl.preferred-width + 16px);
    height: 22px;
    border-radius: 8px;
    background: Theme.current.accent;

    badge_lbl := Text {
        text: @tr("New Episode");
        font-size: 11px;
        font-weight: 700;
        color: Theme.current.text_bright;
        width: Math.max(0px, root.width - 16px);
        overflow: elide;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

// Episode numbering belongs on the artwork, leaving room for a wrapped title.
component HomeEpisodeBadge inherits Rectangle {
    in property <string> label;
    in property <length> available-width;
    width: Math.min(root.available-width, badge_label.preferred-width + 14px);
    height: 20px;
    border-radius: 8px;
    background: Theme.current.home_badge;
    badge_label := Text {
        x: 7px; width: Math.max(0px, parent.width - 14px); height: 100%;
        text: root.label; color: Theme.current.text_bright; font-size: 10px; font-weight: 700;
        vertical-alignment: center; overflow: elide;
    }
}

// One Continue Watching card, shared by the landing carousel and the "see
// all" subpage grid. The `reveal` layer runs the subpage entrance stagger;
// on the landing (`reveal` stays true) only the hover lift animates.
component ContinueCard inherits Rectangle {
    in property <ContinueRow> entry;
    in property <length> card-width;
    in property <bool> focused: false;
    in property <bool> reveal: true;
    in property <duration> reveal-delay: 0ms;
    in property <bool> tappable: true;
    // Landing cards report the early axis of a touch to the page, exactly as
    // the stream-filter pills do; the rail Flickable owns the actual pan.
    in property <bool> rail-gesture: false;
    callback pan_hint();
    callback pan_release();
    // A rail can capture the first move before delivering an axis hint.
    // Clear keyboard modality on the press so a later rebuild keeps its pan.
    callback pointer_pressed();
    // On touch surfaces a stationary hold (or a mouse right-click) opens the
    // page-level sheet, exactly like a My Library card. Desktop opens the
    // native popup below instead.
    //
    // It is also the card's "touch platform" flag: nothing there has a real
    // hover. `TouchArea.has-hover` is true under a finger, and a press that a
    // scroll container delay-forwards can leave it *latched* — the dispatch
    // that set it is discarded while the delayed press is pending, so the
    // matching Exit is never sent and the flag stays on with no touch left on
    // the card. Pointer-only flourishes (the lift below) must therefore be off
    // there, or a card stays lifted after the finger is gone.
    in property <bool> touch_menus: false;
    // Open the card under a stationary tap.
    callback picked();
    // Open the card menu (page-level sheet): a touch hold, or — on touch
    // platforms — a right-click, mirroring the Library cards.
    callback menu_requested();
    // Menu actions. The card has no index of its own: the `for` site binds
    // these to the row index.
    // "Enter series": open the detail page without starting playback.
    callback enter_requested();
    callback remove_requested();

    width: card-width;
    // True 2:3 poster at any width + 76px footer reserves title, episode
    // label and the progress rail so cards never clip.
    height: card-width * 3 / 2 + 76px;

    // Each card owns its native desktop popup (landing rail and subpage).
    // On touch the same press/hold opens the page-level sheet instead.
    cont_ctx := ContextMenuArea {
        width: 100%;
        height: 100%;

        Menu {
            MenuItem {
                title: @tr("Play");
                activated => { root.picked(); }
            }
            MenuItem {
                title: @tr("Enter series");
                activated => { root.enter_requested(); }
            }
            MenuSeparator {}
            MenuItem {
                title: @tr("Remove from Continue Watching");
                activated => { root.remove_requested(); }
            }
        }
    }

    reveal_layer := Rectangle {
        width: 100%;
        height: 100%;
        opacity: reveal ? 1.0 : 0.0;
        y: reveal ? 0px : 12px;
        animate opacity { duration: Anim.transition_fade; delay: reveal-delay; }
        animate y { duration: Anim.transition_slide; delay: reveal-delay; }

        touch := TouchArea {
            // A drag (carousel flick / page scroll) must not also open the
            // item: `clicked` fires for any down+up over the area, so a swipe
            // that the Flickable didn't capture could still navigate. Suppress
            // the pick once the finger travels, and re-arm on the next press.
            enabled: root.tappable;
            property <bool> dragged: false;
            // Release after a hold: the sheet is already open, so the pending
            // tap must not play the item too.
            property <bool> menu_suppress: false;
            property <length> hint_x: 0px;
            property <length> hint_y: 0px;
            property <bool> hint_live: false;
            property <bool> hint_held: false;
            function hint_stop() {
                self.hint_live = false;
                if (self.hint_held) {
                    self.hint_held = false;
                    root.pan_release();
                }
            }
            mouse-cursor: pointer;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) {
                    root.pointer_pressed();
                    touch.hint_x = touch.mouse-x;
                    touch.hint_y = touch.mouse-y;
                    touch.hint_live = true;
                    touch.dragged = false;
                    touch.menu_suppress = false;
                    // Hold-to-open the card menu (subpage grids): the timer
                    // is cancelled as soon as the finger moves or the press
                    // ends (same 600ms convention as the library cards).
                    if (root.touch_menus) {
                        cont_hold_t.stop();
                        cont_hold_t.start();
                    }
                } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                    touch.hint_stop();
                    cont_hold_t.stop();
                    if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                    // Card menu, exactly like a Library card: on touch the
                    // page-level sheet (same menu the hold opens), on desktop
                    // the native popup at the cursor (the ContextMenuArea
                    // alone never sees the press while this TouchArea sits on
                    // top of it).
                        if (root.touch_menus) {
                            root.menu_requested();
                        } else {
                            cont_ctx.show({ x: touch.mouse-x, y: touch.mouse-y });
                        }
                    }
                } else if (ev.kind == PointerEventKind.move && root.rail-gesture) {
                    if (!(touch.pressed || ev.touch-finger-id != 0)) {
                        touch.hint_stop();
                        return;
                    }
                    if (!touch.hint_live) {
                        touch.hint_x = touch.mouse-x;
                        touch.hint_y = touch.mouse-y;
                        touch.hint_live = true;
                    }
                    let dx = touch.mouse-x - touch.hint_x;
                    let dy = touch.mouse-y - touch.hint_y;
                    if (Math.abs(dy) > 8px && Math.abs(dy) > Math.abs(dx)) {
                        touch.hint_stop();
                    } else {
                        touch.hint_held = true;
                        root.pan_hint();
                    }
                }
            }
            changed pressed => {
                if (!self.pressed) { self.hint_stop(); }
            }
            moved => {
                if (Math.abs(touch.mouse-x - touch.pressed-x)
                    + Math.abs(touch.mouse-y - touch.pressed-y) > 12px) {
                    touch.dragged = true;
                    cont_hold_t.stop();
                }
            }
            clicked => {
                cont_hold_t.stop();
                if (!touch.dragged && !touch.menu_suppress) {
                    root.picked();
                }
                touch.dragged = false;
                touch.menu_suppress = false;
            }
        }

        // Hold-to-open timer (pinned off until a press arms it; Slint Timers
        // run from creation by default). A 600ms stationary hold opens the
        // card menu; the host suppresses the trailing pick.
        cont_hold_t := Timer {
            interval: 600ms;
            running: false;
            triggered => {
                self.stop();
                touch.menu_suppress = true;
                root.menu_requested();
            }
        }

        lift := Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.current.card;
            border-radius: Theme.card_corner_radius;
            border-width: root.focused ? 2px : 0px;
            border-color: Theme.current.focus_ring;

            // Lift on real pointer hover only: on touch `has-hover` is true for
            // the whole press, so lifting then would make the card under the
            // finger bob up/down while a carousel/page is dragged — and it can
            // stay latched after the touch is gone (see `touch_menus`).
            y: (touch.has-hover && !touch.pressed && !root.touch_menus) ? -6px : 0px;
            animate y { duration: Anim.hover_lift; easing: ease-in-out; }

            VerticalLayout {
                spacing: 0px;
                continue_artwork := Rectangle {
                    height: root.card-width * 3 / 2;
                    border-radius: Theme.card_corner_radius;
                    clip: true;
                    background: Theme.current.home_artwork_placeholder;
                    if root.entry.is_loaded: Image { source: root.entry.poster; image-fit: cover; width: 100%; height: 100%; }
                    if !root.entry.is_loaded: Text { text: "🎬"; font-size: 34px; horizontal-alignment: center; vertical-alignment: center; }
                    if root.entry.ep_no != "": HomeEpisodeBadge {
                        label: root.entry.ep_no;
                        available-width: Math.max(0px, parent.width - 12px);
                        x: 6px; y: parent.height - self.height - 6px;
                    }
                    if root.entry.badge == 1: NextUpBadge {
                        available-width: Math.max(0px, parent.width - 12px);
                        x: parent.width - self.width - 6px; y: 6px;
                    }
                    if root.entry.badge == 2: NewEpisodeBadge {
                        available-width: Math.max(0px, parent.width - 12px);
                        x: parent.width - self.width - 6px; y: 6px;
                    }
                }
                continue_footer := Rectangle {
                    height: 76px;
                    if root.entry.progress > 0: continue_progress := HorizontalLayout {
                        x: 8px; y: 7px; width: parent.width - 16px; height: 12px; spacing: 6px;
                        Rectangle {
                            horizontal-stretch: 1;
                            Rectangle {
                                y: (parent.height - self.height) / 2; width: 100%; height: 5px;
                                border-radius: 2.5px; background: Theme.current.home_progress_track;
                                Rectangle {
                                    x: 0px; width: parent.width * Math.max(0, Math.min(1, root.entry.progress)); height: 100%;
                                    border-radius: 2.5px; background: Theme.current.progress_fill;
                                }
                            }
                        }
                        Text {
                            text: @tr("{}%", Math.round(Math.max(0, Math.min(1, root.entry.progress)) * 100));
                            color: Theme.current.text_home_badge; font-size: 10px; vertical-alignment: center;
                        }
                    }
                    continue_title := Text {
                        x: 8px; y: root.entry.progress > 0 ? 24px : 8px;
                        width: parent.width - 16px; height: 34px;
                        text: root.entry.title;
                        color: Theme.current.text_home_title; font-size: 12px; font-weight: 600;
                        vertical-alignment: top; wrap: word-wrap; overflow: elide;
                    }
                    continue_status := Text {
                        x: 8px; y: parent.height - 17px; width: parent.width - 16px; height: 14px;
                        // Show the episode beneath the now-prominent series
                        // title, retaining the remaining-time hint.
                        text: root.entry.episode_title != "" ? root.entry.episode_title
                            + (root.entry.remaining != "" ? " · " + root.entry.remaining : "")
                            : root.entry.remaining != "" ? root.entry.remaining : root.entry.subtitle;
                        color: Theme.current.text_home_date; font-size: 10px; vertical-alignment: center; overflow: elide;
                    }
                }
            }
        }
    }
}

// One Upcoming card (same as ContinueCard plus an air-date line).
component UpcomingCard inherits Rectangle {
    in property <UpcomingRow> entry;
    in property <length> card-width;
    in property <bool> focused: false;
    in property <bool> reveal: true;
    in property <duration> reveal-delay: 0ms;
    in property <bool> tappable: true;
    in property <bool> rail-gesture: false;
    callback pan_hint();
    callback pan_release();
    callback pointer_pressed();
    // See ContinueCard: touch platforms have no hover, and `has-hover` can
    // latch under a finger, so pointer-only flourishes (the lift below) are off
    // there.
    in property <bool> touch_menus: false;
    callback picked();
    callback menu_requested();

    width: card-width;
    // True 2:3 poster + 88px footer reserves title, episode label and the
    // air date.
    height: card-width * 3 / 2 + 88px;

    up_ctx := ContextMenuArea {
        width: 100%; height: 100%;
        Menu { MenuItem { title: @tr("Enter series"); activated => { root.picked(); } } }
    }

    reveal_layer := Rectangle {
        width: 100%;
        height: 100%;
        opacity: reveal ? 1.0 : 0.0;
        y: reveal ? 0px : 12px;
        animate opacity { duration: Anim.transition_fade; delay: reveal-delay; }
        animate y { duration: Anim.transition_slide; delay: reveal-delay; }

        touch := TouchArea {
            // A drag (carousel flick / page scroll) must not also open the
            // item: `clicked` fires for any down+up over the area, so a swipe
            // that the Flickable didn't capture could still navigate. Suppress
            // the pick once the finger travels, and re-arm on the next press.
            enabled: root.tappable;
            property <bool> dragged: false;
            property <length> hint_x: 0px;
            property <length> hint_y: 0px;
            property <bool> hint_live: false;
            property <bool> hint_held: false;
            function hint_stop() {
                self.hint_live = false;
                if (self.hint_held) {
                    self.hint_held = false;
                    root.pan_release();
                }
            }
            mouse-cursor: pointer;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) {
                    root.pointer_pressed();
                    touch.hint_x = touch.mouse-x;
                    touch.hint_y = touch.mouse-y;
                    touch.hint_live = true;
                    touch.dragged = false;
                } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                    touch.hint_stop();
                } else if (ev.kind == PointerEventKind.move && root.rail-gesture) {
                    if (!(touch.pressed || ev.touch-finger-id != 0)) {
                        touch.hint_stop();
                        return;
                    }
                    if (!touch.hint_live) {
                        touch.hint_x = touch.mouse-x;
                        touch.hint_y = touch.mouse-y;
                        touch.hint_live = true;
                    }
                    let dx = touch.mouse-x - touch.hint_x;
                    let dy = touch.mouse-y - touch.hint_y;
                    if (Math.abs(dy) > 8px && Math.abs(dy) > Math.abs(dx)) {
                        touch.hint_stop();
                    } else {
                        touch.hint_held = true;
                        root.pan_hint();
                    }
                }
            }
            changed pressed => {
                if (!self.pressed) { self.hint_stop(); }
            }
            moved => {
                if (Math.abs(touch.mouse-x - touch.pressed-x)
                    + Math.abs(touch.mouse-y - touch.pressed-y) > 12px) {
                    touch.dragged = true;
                }
            }
            clicked => {
                if (!touch.dragged) {
                    root.picked();
                }
                touch.dragged = false;
            }
        }

        lift := Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.current.card;
            border-radius: Theme.card_corner_radius;
            border-width: root.focused ? 2px : 0px;
            border-color: Theme.current.focus_ring;

            // See ContinueCard: hover lift must not fire while pressed, and is
            // pointer-only (touch platforms strand the flag).
            y: (touch.has-hover && !touch.pressed && !root.touch_menus) ? -6px : 0px;
            animate y { duration: Anim.hover_lift; easing: ease-in-out; }

            VerticalLayout {
                spacing: 0px;
                upcoming_artwork := Rectangle {
                    height: root.card-width * 3 / 2;
                    border-radius: Theme.card_corner_radius; clip: true; background: Theme.current.home_artwork_placeholder;
                    if root.entry.is_loaded: Image { source: root.entry.poster; image-fit: cover; width: 100%; height: 100%; }
                    if !root.entry.is_loaded: Text { text: "🎬"; font-size: 34px; horizontal-alignment: center; vertical-alignment: center; }
                    if root.entry.ep_no != "": HomeEpisodeBadge {
                        label: root.entry.ep_no;
                        available-width: Math.max(0px, parent.width - 12px);
                        x: 6px; y: parent.height - self.height - 6px;
                    }
                }
                upcoming_footer := Rectangle {
                    height: 88px;
                    upcoming_title := Text {
                        x: 8px; y: 8px; width: parent.width - 16px; height: 34px;
                        text: root.entry.title;
                        color: Theme.current.text_home_title; font-size: 12px; font-weight: 600;
                        vertical-alignment: top; wrap: word-wrap; overflow: elide;
                    }
                    // Keep the episode identifiable beneath the series title.
                    Text {
                        x: 8px; y: 46px; width: parent.width - 16px; height: 14px;
                        text: root.entry.episode_title != "" ? root.entry.episode_title : root.entry.subtitle;
                        color: Theme.current.text_home_metadata; font-size: 10px; overflow: elide;
                    }
                    upcoming_date := Text {
                        x: 8px; y: parent.height - 22px; width: parent.width - 16px; height: 14px;
                        text: root.entry.date; color: Theme.current.text_home_date; font-size: 10px;
                        vertical-alignment: center; overflow: elide;
                    }
                }
            }
        }
    }
}

// Catalog rows below Upcoming use the same landscape-independent poster
// cards as Home's other rails, with a show title and year in the footer.
component HomeCatalogPosterCard inherits Rectangle {
    in property <HomeCatalogCard> entry;
    in property <length> card-width;
    in property <bool> focused: false;
    in property <bool> reveal: true;
    in property <duration> reveal-delay: 0ms;
    in property <bool> tappable: true;
    in property <bool> touch_menus: false;
    callback pointer_pressed();
    callback picked();
    callback pan_hint();
    callback pan_release();

    width: card-width;
    height: card-width * 3 / 2 + 54px;
    reveal_layer := Rectangle {
        width: 100%;
        height: 100%;
        opacity: root.reveal ? 1.0 : 0.0;
        y: root.reveal ? 0px : 12px;
        animate opacity { duration: Anim.transition_fade; delay: root.reveal-delay; }
        animate y { duration: Anim.transition_slide; delay: root.reveal-delay; }

        lift := Rectangle {
            width: 100%;
            height: 100%;
            y: (touch.has-hover && !touch.pressed && !root.touch_menus) ? -6px : 0px;
            animate y { duration: Anim.hover_lift; easing: ease-in-out; }
            border-radius: Theme.card_corner_radius;
            background: Theme.current.card;
            border-width: root.focused ? 2px : 1px;
            border-color: root.focused ? Theme.current.focus_ring : Theme.current.border_soft;
            clip: true;

            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: root.card-width * 3 / 2;
                    background: Theme.current.home_artwork_placeholder;
                    clip: true;
                    if root.entry.is_loaded: Image {
                        source: root.entry.poster;
                        image-fit: cover;
                        width: 100%;
                        height: 100%;
                    }
                    if !root.entry.is_loaded: Text {
                        text: "🎬";
                        font-size: 34px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    height: 54px;
                    background: Theme.current.card;
                    Text {
                        x: 8px;
                        y: 5px;
                        width: parent.width - 16px;
                        height: 30px;
                        text: root.entry.title;
                        color: Theme.current.text_home_title;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: top;
                        wrap: word-wrap;
                        overflow: elide;
                    }
                    Text {
                        x: 8px;
                        y: 35px;
                        width: parent.width - 16px;
                        height: 14px;
                        text: root.entry.year;
                        color: Theme.current.text_home_date;
                        font-size: 10px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }

        touch := TouchArea {
            enabled: root.tappable;
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            property <bool> dragged: false;
            property <bool> hint_live: false;
            property <bool> hint_held: false;
            property <length> hint_x: 0px;
            property <length> hint_y: 0px;
            function hint_stop() {
                touch.hint_live = false;
                if (touch.hint_held) {
                    touch.hint_held = false;
                    root.pan_release();
                }
            }
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) {
                    root.pointer_pressed();
                    touch.hint_x = touch.mouse-x;
                    touch.hint_y = touch.mouse-y;
                    touch.hint_live = true;
                    touch.dragged = false;
                } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                    touch.hint_stop();
                } else if (ev.kind == PointerEventKind.move) {
                    if (!(touch.pressed || ev.touch-finger-id != 0)) {
                        touch.hint_stop();
                        return;
                    }
                    if (!touch.hint_live) {
                        touch.hint_x = touch.mouse-x;
                        touch.hint_y = touch.mouse-y;
                        touch.hint_live = true;
                    }
                    let dx = touch.mouse-x - touch.hint_x;
                    let dy = touch.mouse-y - touch.hint_y;
                    if (Math.abs(dy) > 8px && Math.abs(dy) > Math.abs(dx)) {
                        touch.hint_stop();
                    } else {
                        touch.hint_held = true;
                        root.pan_hint();
                    }
                }
            }
            changed pressed => { if (!self.pressed) { touch.hint_stop(); } }
            moved => {
                if (Math.abs(touch.mouse-x - touch.pressed-x)
                    + Math.abs(touch.mouse-y - touch.pressed-y) > 12px) {
                    touch.dragged = true;
                }
            }
            clicked => {
                if (!touch.dragged) { root.picked(); }
                touch.dragged = false;
            }
        }
    }
}

// Landing section header: title + count, tappable to open the "see all"
// subpage. Hover tints the row and a chevron signals the affordance.
component SectionHeader inherits Rectangle {
    width: 100%;
    in property <string> title;
    in property <int> count;
    callback open_all();

    height: Math.max(36px, header_layout.preferred-height);
    vertical-stretch: 0;
    border-radius: 8px;
    background: header_touch.has-hover ? Theme.current.hover_subtle : transparent;
    animate background { duration: Anim.hover_fast; }

    header_layout := HorizontalLayout {
        width: 100%;
        padding-left: 4px;
        padding-right: 4px;
        spacing: 8px;

        Text {
            text: root.title;
            font-size: 22px;
            font-weight: 700;
            color: Theme.current.text_bright;
            min-width: 0px;
            horizontal-stretch: 1;
            height: self.preferred-height;
            wrap: word-wrap;
        }

        Text {
            text: @tr("See all");
            horizontal-stretch: 0;
            max-width: self.preferred-width;
            font-size: 12px;
            color: Theme.current.text_home_badge;
            vertical-alignment: center;
        }

        Rectangle {
            width: 22px;
            height: 100%;

            IcChevronRight {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                fill: Theme.current.text_muted;
            }
        }
    }

    header_touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.open_all(); }
    }
}

// Upcoming calendar day cell: one of the 42 month-grid squares. Days with
// episodes are tappable (the dot marks them); filler days from the edge
// months and empty days are inert. `picked` carries the day's epoch days.
component CalDayCell inherits Rectangle {
    in property <CalCell> cell;
    // Keyboard focus ring rides the selected day (arrows move it).
    in property <bool> kb_ring: false;
    // Even column width across the grid (passed in: 7 columns, 6 gaps).
    in property <length> cell_width;
    callback picked(int);

    width: root.cell_width;
    height: 44px;
    border-radius: 10px;
    background: root.cell.selected ? Theme.current.accent : (touch.has-hover ? Theme.current.border_soft : transparent);
    animate background { duration: Anim.hover_fast; }
    border-width: root.kb_ring && root.cell.selected ? 2px : 0px;
    border-color: Theme.current.text_bright;
    opacity: root.cell.in_month ? 1.0 : 0.35;

    VerticalLayout {
        alignment: center;
        spacing: 3px;

        Text {
            text: "" + root.cell.day;
            font-size: 14px;
            font-weight: root.cell.selected ? 700 : 400;
            color: root.cell.selected ? Theme.current.on_accent : (root.cell.today ? Theme.current.text_calendar_today : Theme.current.text_calendar_day);
            horizontal-alignment: center;
        }

        if root.cell.count > 0: HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.cell.selected ? Theme.current.on_accent : Theme.current.accent;
            }
        }
    }

    touch := TouchArea {
        // Always eats the tap (even on empty/filler days): without this the
        // press falls through the opaque subpage to a landing rail card.
        width: 100%;
        height: 100%;
        mouse-cursor: root.cell.in_month && root.cell.count > 0 ? pointer : default;
        clicked => {
            if (root.cell.in_month && root.cell.count > 0) {
                root.picked(root.cell.epoch);
            }
        }
    }
}

// Upcoming subpage view switch: the episode grid ⇄ month calendar pill.
// Reads what it opens to.
component CalToggle inherits Rectangle {
    in property <bool> open: false;
    callback toggled();

    width: label.preferred-width + 28px;
    height: 32px;
    y: 2px;
    border-radius: 16px;
    border-width: 1px;
    border-color: Theme.current.calendar_border;
    background: touch.has-hover ? Theme.current.border_soft : Theme.current.calendar_control;
    animate background { duration: Anim.hover_fast; }

    label := Text {
        x: 14px;
        y: (parent.height - self.height) / 2;
        text: root.open ? @tr("List") : @tr("Calendar");
        font-size: 13px;
        font-weight: 600;
        color: Theme.current.text_calendar_today;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

component FeaturedActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> narrow;
    in property <bool> compact;
    out property <length> content_width: action_label.preferred-width + 28px;
    callback picked();

    width: root.content_width + (root.compact ? 24px : 36px);
    height: root.narrow ? 46px : 52px;
    border-radius: root.narrow ? 18px : 22px;
    background: action_touch.has-hover
        ? Theme.current.primary_button_hover
        : Theme.current.primary_button;
    border-width: 1px;
    border-color: Theme.current.primary_button_border;
    animate background { duration: Anim.hover_fast; }

    HorizontalLayout {
        width: 100%; height: 100%;
        padding-left: root.compact ? 12px : 18px;
        padding-right: root.compact ? 12px : 18px;
        spacing: 8px; alignment: center;
        Rectangle {
            width: 20px; height: 100%;
            IcPlay {
                y: (parent.height - self.height) / 2;
                width: 20px; height: 20px; fill: Theme.current.on_accent;
            }
        }
        action_label := Text {
            text: root.label;
            font-size: root.narrow ? (root.compact ? 13px : 14px) : 16px;
            font-weight: 600; color: Theme.current.on_accent; vertical-alignment: center;
            min-width: 0px; overflow: elide;
            wrap: word-wrap; max-lines: 2;
        }
    }
    action_touch := TouchArea {
        accessible-role: button; accessible-label: root.label;
        width: 100%; height: 100%; mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

component FeaturedActions inherits Rectangle {
    in property <string> watch_label;
    in property <bool> narrow;
    in property <bool> compact;
    in property <length> available-width: 100000px;
    callback watch_now();
    width: Math.min(root.available-width, watch_button.content_width + (root.compact ? 24px : 36px));
    height: root.narrow ? 46px : 52px;
    watch_button := FeaturedActionButton {
        x: 0px; y: 0px; width: 100%;
        label: root.watch_label; narrow: root.narrow; compact: root.compact;
        picked => { root.watch_now(); }
    }
}

// Quiet inline metadata leaves the artwork visible, instead of separate pills.
component FeaturedBadge inherits Rectangle {
    in property <string> label;
    // 0 = media type, 1 = rating, 2 = runtime, 3 = release info.
    in property <int> icon;
    in property <bool> narrow;
    preferred-width: badge_label.preferred-width + 23px;
    min-width: 23px;
    max-width: self.preferred-width;
    horizontal-stretch: 1;
    height: root.narrow ? 26px : 30px;

    HorizontalLayout {
        width: 100%; height: 100%; spacing: 5px; alignment: start;
        Rectangle {
            width: 18px; height: 100%;
            if root.icon == 0: IcDisplay {
                y: (parent.height - self.height) / 2;
                width: 18px; height: 18px; fill: Theme.current.text_home_metadata;
            }
            if root.icon == 1: IcStarBorder {
                y: (parent.height - self.height) / 2;
                width: 18px; height: 18px; fill: Theme.current.text_home_metadata;
            }
            if root.icon == 2: IcSchedule {
                y: (parent.height - self.height) / 2;
                width: 18px; height: 18px; fill: Theme.current.text_home_metadata;
            }
            if root.icon == 3: Path {
                y: (parent.height - self.height) / 2;
                width: 18px; height: 18px; fill: Theme.current.text_home_metadata;
                viewbox-width: 24; viewbox-height: 24;
                commands: "M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2zM7 12h4v4H7z";
            }
        }
        badge_label := Text {
            text: root.label; font-size: root.narrow ? 12px : 15px;
            color: Theme.current.text_home_metadata; vertical-alignment: center;
            min-width: 0px; overflow: elide;
        }
    }
}

component FeaturedPagerButton inherits Rectangle {
    in property <bool> next;
    in property <bool> narrow;
    callback stepped();

    width: root.narrow ? 46px : 44px;
    height: self.width;
    border-radius: 9px;
    background: pager_touch.has-hover ? Theme.current.hover_overlay : transparent;
    animate background { duration: Anim.hover_fast; }

    if !root.next: IcChevronLeft {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        fill: Theme.current.icon_home_pager;
    }
    if root.next: IcChevronRight {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        fill: Theme.current.icon_home_pager;
    }
    pager_touch := TouchArea {
        accessible-role: button;
        accessible-label: root.next ? @tr("Next featured title") : @tr("Previous featured title");
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.stepped(); }
    }
}

// A complete visual snapshot, captured at the backend publication boundary.
struct FeaturedSlideData {
    title: string,
    media_type: string,
    rating: string,
    runtime: string,
    release_info: string,
    tagline: string,
    description: string,
    backdrop: image,
    logo: image,
}

// Kept separate from the controls so only title-specific content crossfades.
component FeaturedCaption inherits VerticalLayout {
    in property <FeaturedSlideData> slide;
    in property <bool> narrow;
    in property <length> banner_width;
    height: self.preferred-height;
    spacing: root.narrow ? 10px : 12px;

    function media_label() -> string {
        if (root.slide.media_type == "series") { return @tr("TV"); }
        if (root.slide.media_type == "movie") { return @tr("MOVIE"); }
        if (root.slide.media_type == "anime") { return @tr("ANIME"); }
        return root.slide.media_type;
    }

    caption_title := TitleArtwork {
        title: root.slide.title; logo: root.slide.logo;
        width: 100%;
        logo-height: root.narrow ? 76px : 112px;
        font-size: root.narrow ? (root.banner_width < 400px ? 30px : 36px)
            : Math.min(52px, Math.max(34px, root.banner_width * 0.04));
    }
    if root.slide.tagline != "": caption_tagline := Text {
        text: root.slide.tagline; width: 100%; height: self.preferred-height; max-lines: 2;
        font-size: root.narrow ? 14px : 17px; color: Theme.current.text_home_badge;
        horizontal-alignment: left; wrap: word-wrap; overflow: elide; min-width: 0px;
    }
    caption_metadata := HorizontalLayout {
        width: 100%; height: root.narrow ? 26px : 30px;
        spacing: root.narrow ? 10px : 16px; alignment: start;
        if root.slide.media_type != "": FeaturedBadge { label: root.media_label(); narrow: root.narrow; }
        if root.slide.rating != "": FeaturedBadge { label: root.slide.rating; icon: 1; narrow: root.narrow; }
        if root.slide.release_info != "": FeaturedBadge { label: root.slide.release_info; icon: 3; narrow: root.narrow; }
        if root.slide.runtime != "": FeaturedBadge { label: root.slide.runtime; icon: 2; narrow: root.narrow; }
    }
    if root.slide.description != "": caption_description := Text {
        text: root.slide.description; width: 100%; height: self.preferred-height; max-lines: 3;
        font-size: root.narrow ? 14px : 16px; color: Theme.current.text_description;
        horizontal-alignment: left; wrap: word-wrap; overflow: elide; min-width: 0px;
    }
}

// Catalog artwork with a left-aligned caption and a steady bottom control row.
component FeaturedShowcase inherits Rectangle {
    in property <string> watch_label;
    in property <string> title;
    in property <string> media_type;
    in property <string> rating;
    in property <string> runtime;
    in property <string> release_info;
    in property <string> tagline;
    in property <string> description;
    in property <image> backdrop;
    in property <image> logo;
    in property <int> index;
    in property <int> count;
    // Backend advances this only after the full incoming payload is published.
    in property <int> revision;
    in property <bool> narrow;
    in property <length> safe-top;
    in property <length> safe-left;
    in property <length> safe-right;
    callback picked();
    callback watch_now();
    callback step(int);
    callback pan_hint();
    callback pan_release();

    private property <FeaturedSlideData> displayed_slide;
    private property <FeaturedSlideData> previous_slide;
    private property <bool> initialized: false;
    private property <bool> fading: false;
    private property <bool> advancing: false;
    private property <bool> fade_text: false;
    private property <bool> motion_enabled: Anim.enabled && Anim.transitions;
    private property <float> mix: 1.0;
    animate mix { duration: root.advancing ? Anim.transition_fade : 0ms; easing: ease-in-out; }

    function finish_transition() {
        fade_start.stop();
        fade_end.stop();
        root.advancing = false;
        root.mix = 1.0;
        root.fading = false;
        // Drop the outgoing artwork; keep only the currently displayed image.
        root.previous_slide = root.displayed_slide;
    }

    function sync_slide() {
        let incoming = {
            title: root.title,
            media_type: root.media_type,
            rating: root.rating,
            runtime: root.runtime,
            release_info: root.release_info,
            tagline: root.tagline,
            description: root.description,
            backdrop: root.backdrop,
            logo: root.logo,
        };
        if (!root.initialized || !root.motion_enabled) {
            root.displayed_slide = incoming;
            root.initialized = root.count > 0;
            root.finish_transition();
            return;
        }
        if (!root.fading) {
            root.previous_slide = root.displayed_slide;
            root.advancing = false;
            root.mix = 0.0;
            root.fading = true;
            // Paint the outgoing baseline before animating the incoming frame.
            // These timers stop after each fade; restart() alone does not start
            // an inactive Slint timer, leaving the outgoing slide opaque.
            fade_start.start();
        }
        // Rapid steps retarget the incoming layer without resetting opacity
        // or replacing the outgoing layer in the middle of its fade.
        // Compare before assigning: Slint's Rust generator moves this local
        // struct into the property, so reading its fields afterward fails AOT.
        root.fade_text = root.previous_slide.title != incoming.title
            || root.previous_slide.media_type != incoming.media_type
            || root.previous_slide.rating != incoming.rating
            || root.previous_slide.runtime != incoming.runtime
            || root.previous_slide.release_info != incoming.release_info
            || root.previous_slide.tagline != incoming.tagline
            || root.previous_slide.description != incoming.description;
        root.displayed_slide = incoming;
    }

    init => { root.sync_slide(); }
    changed revision => { root.sync_slide(); }
    changed motion_enabled => {
        if (!root.motion_enabled) { root.finish_transition(); }
    }
    fade_start := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.stop();
            root.advancing = true;
            root.mix = 1.0;
            fade_end.start();
        }
    }
    fade_end := Timer {
        interval: Anim.transition_fade;
        running: false;
        triggered => { root.finish_transition(); }
    }

    width: 100%;
    // Both caption layers reserve their measured height during a fade. Long
    // translations can put the pager below the button instead of overlapping it.
    property <length> left_inset: (root.narrow ? 18px : 32px) + root.safe-left;
    property <length> right_inset: (root.narrow ? 18px : 32px) + root.safe-right;
    property <length> pager_width: root.count > 1 ? (root.narrow ? 134px : 152px) : 0px;
    property <bool> controls_stacked: root.count > 1
        && featured_actions.width + root.pager_width + 12px > root.width - root.left_inset - root.right_inset;
    property <length> controls_height: featured_actions.height + (root.controls_stacked ? 50px : 0px);
    height: Math.max(root.narrow ? Math.min(560px, Math.max(360px, root.width * 1.05)) + root.safe-top
            : Math.min(640px, Math.max(420px, root.width * 0.42)) + root.safe-top,
        Math.max(current_caption.height, root.fading ? previous_caption.height : 0px)
            + root.controls_height + 110px + root.safe-top);
    border-radius: 0px;
    clip: true;
    background: Theme.current.artwork_canvas;

    Image {
        source: root.displayed_slide.backdrop;
        image-fit: cover;
        width: 100%;
        height: 100%;
    }
    // An empty outgoing image still fades from the banner's opaque fallback.
    if root.fading && root.previous_slide.backdrop.width == 0: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.current.artwork_canvas;
        opacity: 1.0 - root.mix;
    }
    Image {
        source: root.previous_slide.backdrop;
        image-fit: cover;
        width: 100%;
        height: 100%;
        opacity: root.fading ? 1.0 - root.mix : 0.0;
    }
    // Baked palette variants avoid an offscreen GPU colorization pass when
    // this page remounts after Detail. Both ramps reach the canvas colour
    // before the artwork edge to keep rows and the navigation rail seamless.
    Image {
        source: Theme.true_black ? @image-url("../../assets/home-bottom-scrim-black.svg") : @image-url("../../assets/home-bottom-scrim.svg");
        image-fit: fill;
        width: 100%;
        height: 100%;
    }
    if !root.narrow: Image {
        source: Theme.true_black ? @image-url("../../assets/home-side-scrim-black.svg") : @image-url("../../assets/home-side-scrim.svg");
        image-fit: fill;
        width: 100%;
        height: 100%;
    }

    // Horizontal swipe changes the active title. During a horizontal gesture
    // the Home page's vertical Flickable temporarily yields, just like it does
    // for the Continue Watching and Upcoming rails.
    swipe_area := TouchArea {
        width: 100%;
        height: 100%;
        property <length> start_x: 0px;
        property <length> start_y: 0px;
        property <bool> swiping: false;
        property <bool> dragged: false;
        property <bool> hint_live: false;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                swipe_area.start_x = swipe_area.mouse-x;
                swipe_area.start_y = swipe_area.mouse-y;
                swipe_area.swiping = false;
                swipe_area.dragged = false;
                swipe_area.hint_live = true;
            } else if (ev.kind == PointerEventKind.move) {
                if (!(swipe_area.pressed || ev.touch-finger-id != 0)) {
                    return;
                }
                if (!swipe_area.hint_live) {
                    swipe_area.start_x = swipe_area.mouse-x;
                    swipe_area.start_y = swipe_area.mouse-y;
                    swipe_area.hint_live = true;
                }
                let dx = swipe_area.mouse-x - swipe_area.start_x;
                let dy = swipe_area.mouse-y - swipe_area.start_y;
                if (Math.abs(dy) > 8px && Math.abs(dy) > Math.abs(dx)) {
                    swipe_area.swiping = false;
                    root.pan_release();
                } else {
                    // Hint before the page's 8px grab threshold, and keep
                    // renewing the hold while a horizontal drag is active.
                    root.pan_hint();
                    if (Math.abs(dx) > 10px && Math.abs(dx) > Math.abs(dy)) {
                        swipe_area.swiping = true;
                    }
                }
            } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                let dx = swipe_area.mouse-x - swipe_area.start_x;
                let dy = swipe_area.mouse-y - swipe_area.start_y;
                if (ev.kind == PointerEventKind.up
                    && swipe_area.swiping
                    && Math.abs(dx) > 44px
                    && Math.abs(dx) > Math.abs(dy)) {
                    root.step(dx < 0px ? 1 : -1);
                }
                swipe_area.swiping = false;
                swipe_area.hint_live = false;
                root.pan_release();
            }
        }
        moved => {
            if ((self.pressed || swipe_area.hint_live)
                && Math.abs(self.mouse-x - self.pressed-x) + Math.abs(self.mouse-y - self.pressed-y) > 12px) {
                swipe_area.dragged = true;
            }
        }
        clicked => { if (!swipe_area.dragged) { root.picked(); } }
        changed pressed => {
            if (!self.pressed && swipe_area.hint_live) {
                swipe_area.swiping = false;
                swipe_area.hint_live = false;
                root.pan_release();
            }
        }
    }

    if root.count > 1: featured_pager := HorizontalLayout {
        x: root.width - self.width - root.right_inset;
        y: root.height - self.height - 24px;
        width: root.pager_width; height: 44px; spacing: 2px;
        FeaturedPagerButton { narrow: root.narrow; stepped => { root.step(-1); } }
        Text {
            text: @tr("{} / {}", root.index + 1, root.count);
            horizontal-stretch: 1; horizontal-alignment: center;
            font-size: root.narrow ? 14px : 16px; font-weight: 600;
            color: Theme.current.text_home_type; vertical-alignment: center;
        }
        FeaturedPagerButton { next: true; narrow: root.narrow; stepped => { root.step(1); } }
    }

    // Text follows the same left edge and stays above the steady controls.
    previous_caption := FeaturedCaption {
        slide: root.previous_slide; narrow: root.narrow; banner_width: root.width;
        x: root.left_inset;
        y: root.height - self.height - root.controls_height - 40px;
        width: root.narrow ? root.width - root.left_inset - root.right_inset : Math.min(Math.max(0px, root.width - root.left_inset - root.right_inset), Math.min(640px, root.width * 0.55));
        opacity: root.fading && root.fade_text ? 1.0 - root.mix : 0.0;
    }
    current_caption := FeaturedCaption {
        slide: root.displayed_slide; narrow: root.narrow; banner_width: root.width;
        x: root.left_inset;
        y: root.height - self.height - root.controls_height - 40px;
        width: root.narrow ? root.width - root.left_inset - root.right_inset : Math.min(Math.max(0px, root.width - root.left_inset - root.right_inset), Math.min(640px, root.width * 0.55));
        opacity: root.fading && root.fade_text ? root.mix : 1.0;
    }
    featured_actions := FeaturedActions {
        watch_label: root.watch_label;
        narrow: root.narrow; compact: root.width < 400px;
        available-width: Math.max(0px, root.width - root.left_inset - root.right_inset);
        x: root.left_inset; y: root.height - root.controls_height - 24px;
        watch_now => { root.watch_now(); }
    }

}

export component HomePage {
    // Custom components placed in a Window are sized by their preferred size;
    // make this page fill the window (its parent).
    preferred-width: 100%;
    preferred-height: 100%;

    in-out property <[ContinueRow]> continue_rows: [];
    in-out property <[UpcomingRow]> upcoming_rows: [];
    in property <[HomeCatalogSection]> catalog_sections: [];
    // Configured order: -1 Continue, -2 Upcoming, otherwise catalog section.
    in property <[int]> catalog_order: [-1, -2];
    // Positions indexed by Continue, Upcoming, then addon section index.
    in property <[int]> catalog_positions: [0, 1];
    in property <[HomeCatalogCard]> catalog_cards: [];
    callback catalog_card_picked(int);
    // Upcoming calendar (month view inside the "see all" subpage, toggled by
    // the Calendar button): the 42 grid cells, the month title, the selected
    // day's episode rows, the selected epoch day (-1 = none) and the
    // list/calendar switch. The backend owns the month arithmetic and the
    // selection; this only renders cells and forwards taps.
    in-out property <[CalCell]> cal_cells: [];
    in-out property <string> cal_title: "";
    in-out property <[UpcomingRow]> cal_day_rows: [];
    in-out property <int> cal_epoch: -1;
    in-out property <bool> cal_open: false;
    in-out property <string> home_empty_hint: @tr("Nothing to continue — start watching a show or movie and it will show up here.");
    in property <bool> continue_enabled: true;
    in property <string> featured_title;
    in property <string> featured_watch_label: @tr("Start watching");
    in property <image> featured_logo;
    in property <string> featured_type;
    in property <string> featured_rating;
    in property <string> featured_runtime;
    in property <string> featured_release_info;
    in property <string> featured_tagline;
    in property <string> featured_description;
    in property <image> featured_backdrop;
    in property <int> featured_index;
    in property <int> featured_count;
    in property <int> featured_revision;
    in property <bool> featured_refresh_pending;
    // 0 = landing, 1 = all Continue, 2 = all Upcoming, 3 + section index = catalog grid.
    in-out property <int> view: 0;
    in property <int> system_back_request: 0;
    property <int> last_system_back_request: -1;

    property <length> item-gap: Theme.card_spacing;
    // Same fluid scheme as Library: column count from a 160px minimum
    // card (always ≥ 2), live card width stretched to fill the row
    // (capped), grid centered when capped. Used by the subpage grids.
    property <length> min-card: 160px;
    property <length> max-card: 200px;
    in property <int> min_cols: 2;
    // Left inset reserved by the wide-layout navigation rail (0 on narrow).
    // Window width is supplied separately so responsive padding does not
    // feed back into the page’s own intrinsic layout width.
    in property <length> nav-viewport-width;
    property <length> rail_w: root.narrow ? 0px : NavMetrics.width-for(root.nav-viewport-width);
    // Use the measured scroll viewport so cutouts and scroll chrome cannot
    // leave the last column wider than the space it actually occupies.
    property <length> grid_width: Math.max(1px, sub_scroll.visible-width);
    property <length> grid_top: 8px;
    property <int> grid_cols: Math.max(root.min_cols, Math.floor((root.grid_width + root.item-gap) / (root.min-card + root.item-gap)));
    property <length> grid_item_width: Math.max(1px, Math.min(root.max-card, (root.grid_width - (root.grid_cols - 1) * root.item-gap) / root.grid_cols));
    // Landing carousel card: ~2.45 cards visible on narrow (Android), the
    // grid card elsewhere.
    property <length> rail_item_width: root.narrow
        ? Math.max(96px, (continue_rail_host.width + root.item-gap) / 2.5 - root.item-gap)
        : root.grid_item_width;
    property <length> rail_h: root.rail_item_width * 3 / 2 + 76px;
    property <length> rail_h_up: root.rail_item_width * 3 / 2 + 88px;
    property <length> catalog_rail_h: root.rail_item_width * 3 / 2 + 54px;
    // Conditional headers report their actual positions; wrapped headings
    // and a taller showcase must not invalidate keyboard scroll estimates.
    property <length> continue_top: 0px;
    property <length> upcoming_top: 0px;
    // Stagger only when transitions are on, so disabling animations makes
    // the cards appear at once (no per-card delay left running).
    property <bool> stagger: Anim.enabled && Anim.transitions;
    // The card's early horizontal gesture hint blocks the landing's vertical
    // Flickable so the inner rail can own the pan (like StreamFilterPill).
    property <bool> page_pan_enabled: true;

    function rail_panned() {
        root.page_pan_enabled = false;
        rail_pan_release_t.running = true;
        rail_pan_release_t.restart();
    }

    function rail_pan_released() {
        root.page_pan_enabled = true;
        rail_pan_release_t.stop();
    }

    function toggle_calendar() {
        if (root.cal_open) { root.upcoming_cal_close(); }
        else { root.upcoming_cal_open(); }
    }

    function restart_showcase_rotation() {
        if (root.view == 0 && (root.featured_count > 1 || root.featured_refresh_pending)) {
            showcase_rotation_t.restart();
        }
    }

    function step_featured(delta: int) {
        root.restart_showcase_rotation();
        root.featured_step(delta);
    }

    // A card may lose its up/cancel when the Flickable captures a swipe.
    // Like the stream pills, allow the axis hint to lapse if movement stops.
    rail_pan_release_t := Timer {
        interval: 200ms;
        running: false;
        triggered => {
            self.stop();
            root.page_pan_enabled = true;
        }
    }

    showcase_rotation_t := Timer {
        interval: 9s;
        // A cached single-slide list also needs a rotation boundary at
        // which the backend can publish a refreshed list without jumping.
        running: root.view == 0 && (root.featured_count > 1 || root.featured_refresh_pending);
        triggered => { root.step_featured(1); }
    }

    changed featured_index => { root.restart_showcase_rotation(); }
    changed system_back_request => {
        if (root.last_system_back_request >= 0
            && root.system_back_request != root.last_system_back_request) {
            root.last_system_back_request = root.system_back_request;
            root.system_back();
        }
    }

    callback home_picked();
    callback discover_picked();
    callback library_picked();
    callback settings_picked();
    callback continue_picked(int);
    // Card menu actions, all resolved against the current library view in the
    // backend: `continue_picked` plays the resume episode (the card tap too),
    // `continue_enter` opens the detail page without starting playback, and
    // `continue_remove` hides the card until the item is resumed again.
    callback continue_remove(int);
    callback continue_enter(int);
    callback upcoming_picked(int);
    // Upcoming calendar: open/close the month view, step the visible month
    // (±1), pick a day (epoch days) and open the selected day's first episode
    // (keyboard Enter).
    callback upcoming_cal_open();
    callback upcoming_cal_close();
    callback upcoming_cal_month(int);
    callback upcoming_cal_pick(int);
    callback upcoming_cal_activate();
    callback featured_picked();
    callback featured_watch_now();
    callback featured_step(int);
    // System back on the root screen: background the app (Android moves
    // the task to the back, keeping process state; desktop never fires it).
    callback exit_to_background();

    // Card menu state. `menu_idx` is the card the open/next menu acts on;
    // `menu_open` only drives the bottom sheet (single instance, -1 closed).
    // Pure UI state: actions reuse the callbacks above.
    property <bool> menu_open: false;
    property <int> menu_idx: 0;
    property <bool> menu_upcoming: false;

    function open_continue_menu(idx: int) {
        if (root.menu_open) {
            root.close_menu();
            return;
        }
        root.menu_upcoming = false;
        root.menu_idx = idx;
        root.menu_open = true;
    }

    function open_upcoming_menu(idx: int) {
        root.menu_upcoming = true;
        root.menu_idx = idx;
        root.menu_open = true;
    }

    function close_menu() {
        root.menu_open = false;
    }

    function system_back() {
        if (root.menu_open) {
            root.close_menu();
        } else if (root.view == 2 && root.cal_open) {
            root.upcoming_cal_close();
        } else if (root.view != 0) {
            root.view = 0;
        } else {
            root.exit_to_background();
        }
    }

    // Exact scroll offsets: landing page, subpage page, and the two
    // carousel x positions (bound to AppWindow so they survive the detail
    // modal destroying/recreating this component).
    in-out property <length> scroll_y: 0px;
    in-out property <length> all_scroll_y: 0px;
    in-out property <length> continue_x: 0px;
    in-out property <length> upcoming_x: 0px;

    // Compact layout for narrow (portrait) windows.
    in property <bool> narrow;
    // Top system-bar inset (Android status bar): Window.safe-area-insets,
    // bound by AppWindow. 0 on desktop/web, so layout there is unchanged.
    in property <length> safe-top: 0px;
    // Side insets: in landscape the display cutout / gesture area moves to
    // the left or right edge, so page content must clear it.
    in property <length> safe-left: 0px;
    in property <length> safe-right: 0px;
    // Bottom system-bar inset (Android gesture/nav bar), for the bottom
    // tab bar. 0 on desktop/web.
    in property <length> safe-bottom: 0px;
    // True on touch-driven platforms (Android): card menus open as
    // bottom sheets on hold. Desktop keeps native right-click popups.
    // Bound from AppWindow (see the HomePage wiring there).
    in property <bool> touch_menus: false;

    // ---- 6-button keyboard nav (arrows + Enter + Backspace) ----
    // Landing zones: 0 page-nav, 1 Continue, 2 Upcoming, 3 catalog rails.
    // Subpage: zone 1 is the grid. Backspace pops the subpage. Bound to
    // AppWindow (survives page recreation).
    in-out property <int> kb_zone: 0;
    in-out property <int> kb_nav: 0;
    in-out property <int> kb_idx: 0;
    in-out property <int> kb_up_idx: 0;
    // Keyboard modality (bound to AppWindow, see DiscoverPage).
    in-out property <bool> kb_active;

    // Number of cards in the list the keyboard cursor is on (Continue on the
    // landing, whichever grid the subpage shows).
    function active_len() -> int {
        if (root.view >= 3) {
            return root.catalog_sections[root.view - 3].card_count;
        }
        if (root.view == 0 && root.kb_zone == 3) {
            return root.catalog_cards.length;
        }
        if (root.view == 2) {
            return root.upcoming_rows.length;
        }
        return root.continue_rows.length;
    }

    function kb_clamp_idx() {
        let n = root.active_len();
        if (n == 0) {
            root.kb_idx = 0;
        } else if (root.kb_idx >= n) {
            root.kb_idx = n - 1;
        } else if (root.kb_idx < 0) {
            root.kb_idx = 0;
        }
        if (root.upcoming_rows.length == 0) {
            root.kb_up_idx = 0;
        } else if (root.kb_up_idx >= root.upcoming_rows.length) {
            root.kb_up_idx = root.upcoming_rows.length - 1;
        } else if (root.kb_up_idx < 0) {
            root.kb_up_idx = 0;
        }
    }

    function kb_up() {
        if (root.view == 2 && root.cal_open) {
            // Calendar: a week back.
            root.upcoming_cal_pick(root.cal_epoch - 7);
        } else if (root.view != 0) {
            if (root.kb_idx >= root.grid_cols) {
                root.kb_idx -= root.grid_cols;
            }
        } else {
            root.kb_move_catalog(-1);
        }
    }

    function kb_down() {
        if (root.view == 2 && root.cal_open) {
            // Calendar: a week forward.
            root.upcoming_cal_pick(root.cal_epoch + 7);
        } else if (root.view != 0) {
            if (root.kb_idx + root.grid_cols < root.active_len()) {
                root.kb_idx += root.grid_cols;
            }
        } else {
            root.kb_move_catalog(1);
        }
    }

    function catalog_has_cards(id: int) -> bool {
        if (id == -1) { return root.continue_rows.length > 0; }
        if (id == -2) { return root.upcoming_rows.length > 0; }
        return id >= 0 && id < root.catalog_sections.length && root.catalog_sections[id].card_count > 0;
    }

    // Rust publishes compact positions, omitting hidden and empty catalogs.
    function catalog_position(id: int) -> int {
        let slot = id == -1 ? 0 : id == -2 ? 1 : id + 2;
        if (id < -2 || slot >= root.catalog_positions.length) { return -1; }
        return root.catalog_positions[slot];
    }

    function focused_catalog() -> int {
        if (root.kb_zone == 1) { return -1; }
        if (root.kb_zone == 2) { return -2; }
        if (root.kb_zone == 3 && root.kb_idx >= 0 && root.kb_idx < root.catalog_cards.length) {
            return root.catalog_cards[root.kb_idx].section_index;
        }
        return -3;
    }

    // Arrow navigation follows the displayed catalog order, including addon
    // rows placed between the two built-ins.
    function kb_move_catalog(direction: int) {
        let target = root.catalog_position(root.focused_catalog()) + direction;
        if (target < 0) { root.kb_zone = 0; return; }
        if (target >= root.catalog_order.length) { return; }
        let candidate = root.catalog_order[target];
        if (candidate == -1) { root.kb_zone = 1; }
        else if (candidate == -2) { root.kb_zone = 2; }
        else { root.kb_zone = 3; root.kb_idx = root.catalog_sections[candidate].first_card; }
        root.kb_clamp_idx();
    }

    function kb_left() {
        if (root.view == 2 && root.cal_open) {
            // Calendar: the previous day.
            root.upcoming_cal_pick(root.cal_epoch - 1);
        } else if (root.view != 0) {
            if (root.kb_idx > 0) {
                root.kb_idx -= 1;
            }
        } else if (root.kb_zone == 0) {
            root.kb_nav = Math.mod(root.kb_nav + 3, 4);
        } else if (root.kb_zone == 1) {
            if (root.kb_idx > 0) {
                root.kb_idx -= 1;
            }
        } else if (root.kb_zone == 3) {
            let section = root.focused_catalog();
            if (section >= 0 && root.kb_idx > root.catalog_sections[section].first_card) {
                root.kb_idx -= 1;
            }
        } else {
            if (root.kb_up_idx > 0) {
                root.kb_up_idx -= 1;
            }
        }
    }

    function kb_right() {
        if (root.view == 2 && root.cal_open) {
            // Calendar: the next day.
            root.upcoming_cal_pick(root.cal_epoch + 1);
        } else if (root.view != 0) {
            if (root.kb_idx + 1 < root.active_len()) {
                root.kb_idx += 1;
            }
        } else if (root.kb_zone == 0) {
            root.kb_nav = Math.mod(root.kb_nav + 1, 4);
        } else if (root.kb_zone == 1) {
            if (root.kb_idx + 1 < root.continue_rows.length) {
                root.kb_idx += 1;
            }
        } else if (root.kb_zone == 3) {
            let section = root.focused_catalog();
            if (section >= 0 && root.kb_idx + 1 < root.catalog_sections[section].first_card + root.catalog_sections[section].card_count) {
                root.kb_idx += 1;
            }
        } else {
            if (root.kb_up_idx + 1 < root.upcoming_rows.length) {
                root.kb_up_idx += 1;
            }
        }
    }

    function kb_enter() {
        if (root.view == 2 && root.cal_open) {
            // Calendar: open the selected day's first episode.
            root.upcoming_cal_activate();
        } else if (root.view != 0) {
            if (root.kb_idx >= 0 && root.kb_idx < root.active_len()) {
                if (root.view >= 3) {
                    root.catalog_card_picked(root.catalog_cards[root.catalog_sections[root.view - 3].first_card + root.kb_idx].flat_index);
                } else if (root.view == 2) {
                    root.upcoming_picked(root.kb_idx);
                } else {
                    root.continue_picked(root.kb_idx);
                }
            }
        } else if (root.kb_zone == 0) {
            if (root.kb_nav == 0) {
                root.home_picked();
            } else if (root.kb_nav == 1) {
                root.discover_picked();
            } else if (root.kb_nav == 2) {
                root.library_picked();
            } else {
                root.settings_picked();
            }
        } else if (root.kb_zone == 1) {
            if (root.kb_idx >= 0 && root.kb_idx < root.continue_rows.length) {
                root.continue_picked(root.kb_idx);
            }
        } else if (root.kb_zone == 3) {
            if (root.kb_idx >= 0 && root.kb_idx < root.catalog_cards.length) {
                root.catalog_card_picked(root.catalog_cards[root.kb_idx].flat_index);
            }
        } else {
            if (root.kb_up_idx >= 0 && root.kb_up_idx < root.upcoming_rows.length) {
                root.upcoming_picked(root.kb_up_idx);
            }
        }
    }

    // Row strides for the subpage grids, plus the carousel scroll helpers.
    property <length> row_stride: root.grid_item_width * 3 / 2 + 76px + root.item-gap;
    property <length> row_stride_up: root.grid_item_width * 3 / 2 + 88px + root.item-gap;

    // Keep the focused card on screen. Skipped before layout
    // (content-height 0) — the one-shot restore timer below retries.
    function kb_follow() {
        // Only the keyboard moves the focus. This same entry point runs for
        // data rebuilds (a sync pass or a progress/library write pushes fresh
        // models) and for a subpage swap, and following the — stale — focus
        // there used to drag a manually flicked rail back to the focused card
        // (card 0, or whatever the user last opened) and scroll the page under
        // it. A carousel drag clears `kb_active`, so a flick ends the
        // modality just like a tap does.
        if (!root.kb_active) {
            return;
        }
        if (root.view == 0) {
            root.kb_follow_landing();
        } else {
            root.kb_follow_grid();
        }
    }

    // Landing: scroll the focused carousel horizontally and bring its section
    // into the vertical viewport. A rail's `content-x` is the *negative*
    // scroll offset (0 = the row's start), so the focused card's left edge
    // sits at `x + content-x` on screen: writing `x` itself (as this used to)
    // is a positive offset, which the rail immediately clamps back to 0 — the
    // row jumped to its start instead of following the focus.
    function kb_follow_landing() {
        if (land_scroll.content-height == 0px) {
            return;
        }
        if (root.kb_zone == 1 && root.continue_rows.length > 0) {
            let cw = root.rail_item_width;
            let x = c_row.padding-left + root.kb_idx * (cw + root.item-gap);
            rail_continue.content-x = root.rail_show(rail_continue.content-x, x, cw, rail_continue.width, rail_continue.content-width);
            root.kb_scroll_to(continue_section.absolute-position.y - landing_rows.absolute-position.y + landing_rows.y,
                continue_rail_host.absolute-position.y - landing_rows.absolute-position.y + landing_rows.y + continue_rail_host.height);
        } else if (root.kb_zone == 2 && root.upcoming_rows.length > 0) {
            let cw = root.rail_item_width;
            let x = u_row.padding-left + root.kb_up_idx * (cw + root.item-gap);
            rail_upcoming.content-x = root.rail_show(rail_upcoming.content-x, x, cw, rail_upcoming.width, rail_upcoming.content-width);
            root.kb_scroll_to(upcoming_section.absolute-position.y - landing_rows.absolute-position.y + landing_rows.y,
                upcoming_rail_host.absolute-position.y - landing_rows.absolute-position.y + landing_rows.y + upcoming_rail_host.height);
        }
    }

    // The offset that brings a card at content-x `x` (width `cw`) into a
    // `vw`-wide viewport currently at `content-x`, clamped to the rail's ends.
    function rail_show(content_x: length, x: length, cw: length, vw: length, content_w: length) -> length {
        let left = x + content_x;
        if (left < 0px) {
            return Math.max(-Math.max(0px, content_w - vw), -x);
        }
        if (left + cw > vw) {
            return Math.max(-Math.max(0px, content_w - vw), vw - (x + cw));
        }
        return content_x;
    }

    function kb_follow_grid() {
        // The calendar replaces the grid: nothing grid-shaped to follow.
        if (root.view == 2 && root.cal_open) {
            return;
        }
        if (sub_scroll.content-height == 0px) {
            return;
        }
        let stride = root.view >= 3 ? root.grid_item_width * 3 / 2 + 54px + root.item-gap
            : root.view == 2 ? root.row_stride_up : root.row_stride;
        let top = root.grid_top + Math.floor(root.kb_idx / root.grid_cols) * stride;
        // The back bar is outside this viewport; only the hover inset belongs
        // to the scroll content before the first row.
        root.kb_scroll_sub(top, top + stride);
    }

    function kb_scroll_to(top: length, bot: length) {
        let vy = land_scroll.content-y;
        let vh = land_scroll.height;
        let min_y = Math.min(0px, vh - land_scroll.content-height);
        if (top < -vy) {
            land_scroll.content-y = -top;
        } else if (bot > vh - vy) {
            land_scroll.content-y = Math.max(min_y, vh - bot);
        }
    }

    function kb_scroll_sub(top: length, bot: length) {
        let vy = sub_scroll.content-y;
        let vh = sub_scroll.visible-height;
        let min_y = Math.min(0px, vh - sub_scroll.content-height);
        if (top < -vy) {
            sub_scroll.content-y = -top;
        } else if (bot > vh - vy) {
            sub_scroll.content-y = Math.max(min_y, vh - bot);
        }
    }

    changed kb_idx => { root.kb_follow(); }
    changed kb_up_idx => { root.kb_follow(); }
    changed kb_zone => { root.kb_follow(); }
    changed continue_rows => {
        root.kb_clamp_idx();
        root.kb_follow();
    }
    changed upcoming_rows => {
        root.kb_clamp_idx();
        root.kb_follow();
    }
    changed catalog_order => { root.kb_follow(); }

    changed catalog_sections => {
        if (root.view >= 3 && root.view - 3 >= root.catalog_sections.length) {
            root.view = 0;
        }
        root.kb_clamp_idx();
        root.kb_follow();
    }
    changed catalog_cards => {
        if (root.kb_zone == 3) {
            root.kb_idx = Math.max(0, Math.min(root.kb_idx, root.catalog_cards.length - 1));
        }
        root.kb_follow();
    }
    changed view => {
        if (root.view != 0) {
            root.kb_zone = 1;
        }
        root.kb_clamp_idx();
        root.kb_follow();
    }

    // Clamp the (restored) landing scroll offset into the valid range once
    // laid out: content may have shrunk while inside the entry.
    function kb_clamp_view() {
        if (land_scroll.content-height == 0px) {
            return;
        }
        let min_y = Math.min(0px, land_scroll.height - land_scroll.content-height);
        land_scroll.content-y = Math.max(min_y, Math.min(0px, land_scroll.content-y));
    }

    // Open a "see all" subpage. Restarts the row stagger (when transitions
    // are on) and resets the subpage scroll so a fresh list starts at the top.
    function open_subpage(kind: int) {
        root.kb_active = false;
        root.kb_zone = 1;
        root.kb_idx = 0;
        root.all_scroll_y = 0px;
        sub_scroll.content-y = 0px;
        // Reset the rail's axis hint when leaving the landing.
        root.rail_pan_released();
        if (root.stagger) {
            root.sub_revealed = false;
            sub_reveal_t.running = true;
        }
        root.view = kind;
    }

    // Subpage row entrance. Deferred one tick (like the detail page fade):
    // flipping during creation would be treated as the baseline and not
    // animate. `sub_revealed` defaults true, so a re-created HomePage
    // (return from detail) shows the preserved subpage with no re-stagger.
    property <bool> sub_revealed: true;
    sub_reveal_t := Timer {
        interval: 40ms;
        running: false;
        triggered => {
            sub_reveal_t.running = false;
            root.sub_revealed = true;
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.current.artwork_canvas;

        // 6-button scope: overlays the page without intercepting the mouse.
        nav_scope := FocusScope {
            width: 100%;
            height: 100%;
            init => {
                self.focus();
                root.last_system_back_request = root.system_back_request;
            }
            key-pressed(e) => {
                if (e.text == Key.UpArrow) {
                    root.kb_active = true;
                    root.kb_up();
                    accept
                } else if (e.text == Key.DownArrow) {
                    root.kb_active = true;
                    root.kb_down();
                    accept
                } else if (e.text == Key.LeftArrow) {
                    root.kb_active = true;
                    root.kb_left();
                    accept
                } else if (e.text == Key.RightArrow) {
                    root.kb_active = true;
                    root.kb_right();
                    accept
                } else if (e.text == Key.Return) {
                    root.kb_active = true;
                    root.kb_enter();
                    accept
                } else if (e.text == Key.Back) {
                    // On a subpage, pop one layer (calendar first, then the
                    // subpage itself); on the root screen there is nothing to
                    // pop — background the app instead.
                    if (root.menu_open) {
                        root.close_menu();
                    } else if (root.view == 2 && root.cal_open) {
                        root.upcoming_cal_close();
                    } else if (root.view != 0) {
                        root.view = 0;
                    } else {
                        root.exit_to_background();
                    }
                    accept
                } else if (e.text == Key.Backspace) {
                    if (root.menu_open) {
                        root.close_menu();
                    } else if (root.view == 2 && root.cal_open) {
                        root.upcoming_cal_close();
                    } else if (root.view != 0) {
                        root.view = 0;
                    }
                    root.kb_active = true;
                    accept
                } else {
                    reject
                }
            }
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            // Artwork fills the landing viewport; safe padding belongs to its
            // captions, rows and subpage controls rather than the whole page.
            padding-left: root.rail_w + (root.narrow ? 0px : root.safe-left);
            padding-right: 0px;
            padding-bottom: root.narrow && root.view == 0 ? 0px : 18px;
            padding-top: 0px;
            spacing: 12px;

            content_host := Rectangle {
                vertical-stretch: 1;
                min-height: 0px;
                clip: true;

                // ---- Landing layer: horizontal carousels -------------
                landing_layer := Rectangle {
                    width: 100%;
                    height: 100%;
                    // Push transition: slides left and dims while a subpage
                    // slides in over it; reverses on back.
                    x: root.view != 0 ? -0.28 * content_host.width : 0px;
                    opacity: root.view != 0 ? 0.0 : 1.0;
                    animate x { duration: Anim.transition_slide; easing: ease-out; }
                    animate opacity { duration: Anim.transition_fade; }

                    restore_t := Timer {
                        interval: 120ms;
                        running: true;
                        triggered => {
                            root.kb_clamp_idx();
                            root.kb_clamp_view();
                            root.kb_follow();
                            self.running = false;
                        }
                    }

                    land_scroll := Flickable {
                        width: 100%;
                        height: 100%;
                        // A raw Flickable (not a ScrollView) so the carousels
                        // can toggle `interactive` for the horizontal axis lock;
                        // the fluent ScrollView does not expose it. Wheel/scroll
                        // events are accepted regardless of `interactive`.
                        interactive: root.page_pan_enabled;
                        // Mouse drag-pan belongs to the inner rail on desktop;
                        // the page still scrolls with the wheel/trackpad.
                        // Touch page scrolling only depends on `interactive`.
                        mouse-drag-pan-enabled: false;
                        // One-way mirror, see DiscoverPage: Flickable drops
                        // viewport bindings on press, so mirror explicitly.
                        init => { self.content-y = root.scroll_y; }
                        changed content-y => {
                            root.scroll_y = self.content-y;
                        }

                        VerticalLayout {
                            width: 100%;
                            spacing: 12px;

                            if root.featured_count > 0: FeaturedShowcase {
                                watch_label: root.featured_watch_label;
                                title: root.featured_title;
                                logo: root.featured_logo;
                                media_type: root.featured_type;
                                rating: root.featured_rating;
                                runtime: root.featured_runtime;
                                release_info: root.featured_release_info;
                                tagline: root.featured_tagline;
                                description: root.featured_description;
                                backdrop: root.featured_backdrop;
                                index: root.featured_index;
                                count: root.featured_count;
                                revision: root.featured_revision;
                                narrow: root.narrow;
                                safe-top: root.safe-top;
                                safe-left: root.narrow ? root.safe-left : 0px;
                                safe-right: root.safe-right;
                                picked => {
                                    root.kb_active = false;
                                    root.featured_picked();
                                }
                                watch_now => {
                                    root.kb_active = false;
                                    root.featured_watch_now();
                                }
                                pan_hint => {
                                    root.kb_active = false;
                                    root.rail_panned();
                                }
                                pan_release => { root.rail_pan_released(); }
                                step(d) => { root.step_featured(d); }
                            }

                            landing_rows := VerticalLayout {
                                width: 100%; spacing: 24px;
                                padding-left: 18px + (root.narrow ? root.safe-left : 0px);
                                padding-right: 18px + root.safe-right;
                                padding-top: root.featured_count == 0 ? 18px + root.safe-top : 0px;
                                if root.continue_rows.length == 0
                                    && root.upcoming_rows.length == 0
                                    && root.catalog_sections.length == 0
                                    && root.featured_count == 0
                                    && root.continue_enabled: VerticalLayout {
                                    alignment: center;
                                    // Take enough height to center in the viewport.
                                    min-height: 300px;
                                    Text {
                                        text: root.home_empty_hint;
                                        font-size: 14px;
                                        color: Theme.current.text_muted;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                        width: 100%;
                                    }
                                }

                                GridLayout {
                                    width: 100%; spacing: 0px;
                                    continue_section := Rectangle {
                                        row: root.catalog_position(-1) >= 0 ? root.catalog_position(-1) : root.catalog_order.length; col: 0;
                                        visible: root.catalog_position(-1) >= 0;
                                        height: self.visible ? continue_content.preferred-height : 0px;
                                        width: 100%;
                                        changed y => { root.continue_top = self.y; }
                                        continue_content := VerticalLayout {
                                            width: 100%; spacing: 4px; padding-bottom: 24px;
                                            // ---- Continue Watching --------------------
                                            if root.continue_rows.length > 0: SectionHeader {
                                                title: @tr("Continue Watching");
                                                count: root.continue_rows.length;
                                                open_all => { root.open_subpage(1); }
                                            }


                                            // Horizontal carousel: the inner Flickable owns
                                            // dragging and native momentum, like the stream
                                            // filter pills. Cards report early axis hints so
                                            // the vertical page does not steal the gesture.
                                            continue_rail_host := Rectangle {
                                                visible: root.continue_rows.length > 0;
                                                width: 100%;
                                                height: root.rail_h + 8px;

                                                rail_continue := Flickable {
                                                    // Bleed the scroll clip to the screen edges while
                                                    // the first card keeps the section's safe inset.
                                                    x: -18px - (root.narrow ? root.safe-left : 0px);
                                                    width: content_host.width;
                                                    height: 100%;
                                                    interactive: root.view == 0;
                                                    mouse-drag-pan-enabled: true;
                                                    content-width: c_row.width;
                                                    content-height: self.height;
                                                    init => { self.content-x = root.continue_x; }
                                                    changed content-x => {
                                                        root.continue_x = self.content-x;
                                                        if (!root.kb_active && root.view == 0) { root.rail_panned(); }
                                                    }

                                                    c_row := HorizontalLayout {
                                                        y: 8px;
                                                        height: root.rail_h;
                                                        width: self.preferred-width;
                                                        padding-left: 18px + (root.narrow ? root.safe-left : 0px);
                                                        padding-right: 18px + root.safe-right;
                                                        spacing: root.item-gap;

                                                        for c[i] in root.continue_rows: ContinueCard {
                                                            entry: c;
                                                            card-width: root.rail_item_width;
                                                            tappable: root.view == 0;
                                                            rail-gesture: root.view == 0;
                                                            touch_menus: root.touch_menus;
                                                            focused: root.kb_active && root.kb_zone == 1 && root.kb_idx == i;
                                                            pointer_pressed => { root.kb_active = false; }
                                                            picked => {
                                                                root.kb_active = false;
                                                                root.kb_zone = 1;
                                                                root.kb_idx = i;
                                                                root.continue_picked(i);
                                                            }
                                                            menu_requested => {
                                                                if (root.touch_menus) { root.open_continue_menu(i); }
                                                            }
                                                            enter_requested => { root.continue_enter(i); }
                                                            remove_requested => { root.continue_remove(i); }
                                                            pan_hint => {
                                                                root.kb_active = false;
                                                                root.rail_panned();
                                                            }
                                                            pan_release => { root.rail_pan_released(); }
                                                        }
                                                    }
                                                }
                                            }

                                        }
                                    }
                                    upcoming_section := Rectangle {
                                        row: root.catalog_position(-2) >= 0 ? root.catalog_position(-2) : root.catalog_order.length + 1; col: 0;
                                        visible: root.catalog_position(-2) >= 0;
                                        height: self.visible ? upcoming_content.preferred-height : 0px;
                                        width: 100%;
                                        changed y => { root.upcoming_top = self.y; }
                                        upcoming_content := VerticalLayout {
                                            width: 100%; spacing: 4px; padding-bottom: 24px;
                                            // ---- Upcoming (caught-up series, unaired) --
                                            if root.upcoming_rows.length > 0: SectionHeader {
                                                title: @tr("Upcoming Episodes");
                                                count: root.upcoming_rows.length;
                                                open_all => { root.open_subpage(2); }
                                            }


                                            upcoming_rail_host := Rectangle {
                                                visible: root.upcoming_rows.length > 0;
                                                width: 100%;
                                                height: root.rail_h_up + 8px;

                                                rail_upcoming := Flickable {
                                                    // Bleed the scroll clip to the screen edges while
                                                    // the first card keeps the section's safe inset.
                                                    x: -18px - (root.narrow ? root.safe-left : 0px);
                                                    width: content_host.width;
                                                    height: 100%;
                                                    interactive: root.view == 0;
                                                    mouse-drag-pan-enabled: true;
                                                    content-width: u_row.width;
                                                    content-height: self.height;
                                                    init => { self.content-x = root.upcoming_x; }
                                                    changed content-x => {
                                                        root.upcoming_x = self.content-x;
                                                        if (!root.kb_active && root.view == 0) { root.rail_panned(); }
                                                    }

                                                    u_row := HorizontalLayout {
                                                        y: 8px;
                                                        height: root.rail_h_up;
                                                        width: self.preferred-width;
                                                        padding-left: 18px + (root.narrow ? root.safe-left : 0px);
                                                        padding-right: 18px + root.safe-right;
                                                        spacing: root.item-gap;

                                                        for u[i] in root.upcoming_rows: UpcomingCard {
                                                            entry: u;
                                                            card-width: root.rail_item_width;
                                                            tappable: root.view == 0;
                                                            rail-gesture: root.view == 0;
                                                            touch_menus: root.touch_menus;
                                                            focused: root.kb_active && root.kb_zone == 2 && root.kb_up_idx == i;
                                                            pointer_pressed => { root.kb_active = false; }
                                                            picked => {
                                                                root.kb_active = false;
                                                                root.kb_zone = 2;
                                                                root.kb_up_idx = i;
                                                                root.upcoming_picked(i);
                                                            }
                                                            menu_requested => { root.open_upcoming_menu(i); }
                                                            pan_hint => {
                                                                root.kb_active = false;
                                                                root.rail_panned();
                                                            }
                                                            pan_release => { root.rail_pan_released(); }
                                                        }
                                                    }
                                                }
                                            }

                                        }
                                    }
                                    // Addon rows share the configured order with built-ins.
                                    for section[s] in root.catalog_sections: catalog_section := Rectangle {
                                        row: root.catalog_position(s) >= 0 ? root.catalog_position(s) : root.catalog_order.length + 2 + s; col: 0;
                                        visible: root.catalog_position(s) >= 0;
                                        height: self.visible ? catalog_content.preferred-height : 0px;
                                        width: 100%;
                                        property <int> focused_card: root.view == 0 && root.kb_active && root.kb_zone == 3
                                            && root.kb_idx >= section.first_card
                                            && root.kb_idx < section.first_card + section.card_count
                                            ? root.kb_idx - section.first_card : -1;
                                        changed focused_card => {
                                            if (self.focused_card >= 0) {
                                                let x = catalog_items.padding-left + self.focused_card * (root.rail_item_width + root.item-gap);
                                                catalog_rail.content-x = root.rail_show(catalog_rail.content-x, x, root.rail_item_width, catalog_rail.width, catalog_rail.content-width);
                                                let top = self.absolute-position.y - landing_rows.absolute-position.y + landing_rows.y;
                                                root.kb_scroll_to(top, top + self.height);
                                            }
                                        }

                                        catalog_content := VerticalLayout {
                                            width: 100%; spacing: 4px; padding-bottom: 24px;
                                            SectionHeader {
                                                title: section.title;
                                                count: section.card_count;
                                                open_all => { root.open_subpage(3 + s); }
                                            }

                                            Rectangle {
                                                width: 100%;
                                                height: root.catalog_rail_h + 8px;
                                                catalog_rail := Flickable {
                                                    x: -18px - (root.narrow ? root.safe-left : 0px);
                                                    width: content_host.width;
                                                    height: 100%;
                                                    interactive: root.view == 0;
                                                    mouse-drag-pan-enabled: true;
                                                    content-width: catalog_items.width;
                                                    content-height: self.height;
                                                    changed content-x => {
                                                        if (!root.kb_active && root.view == 0) { root.rail_panned(); }
                                                    }

                                                    catalog_items := HorizontalLayout {
                                                        y: 8px;
                                                        height: root.catalog_rail_h;
                                                        width: self.preferred-width;
                                                        padding-left: 18px + (root.narrow ? root.safe-left : 0px);
                                                        padding-right: 18px + root.safe-right;
                                                        spacing: root.item-gap;

                                                        // Repeat only this section's contiguous range: invisible
                                                        // cards still reserve space in a HorizontalLayout.
                                                        for i in section.card_count: HomeCatalogPosterCard {
                                                            entry: root.catalog_cards[section.first_card + i];
                                                            tappable: root.view == 0;
                                                            touch_menus: root.touch_menus;
                                                            pointer_pressed => { root.kb_active = false; }
                                                            card-width: root.rail_item_width;
                                                            focused: root.kb_active && root.kb_zone == 3 && root.kb_idx == section.first_card + i;
                                                            picked => {
                                                                root.kb_active = false;
                                                                root.catalog_card_picked(root.catalog_cards[section.first_card + i].flat_index);
                                                            }
                                                            pan_hint => {
                                                                root.kb_active = false;
                                                                root.rail_panned();
                                                            }
                                                            pan_release => { root.rail_pan_released(); }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                            }
                        }
                    }
                }

                // ---- Subpage layer: full vertical grid ---------------
                sub_layer := Rectangle {
                    width: 100%;
                    height: 100%;
                    background: Theme.current.artwork_canvas;
                    x: root.view != 0 ? 0px : content_host.width;
                    opacity: root.view != 0 ? 1.0 : 0.0;
                    animate x { duration: Anim.transition_slide; easing: ease-out; }
                    animate opacity { duration: Anim.transition_fade; }

                    VerticalLayout {
                        width: 100%;
                        height: 100%;
                        padding-left: 18px + (root.narrow ? root.safe-left : 0px);
                        padding-right: 18px + root.safe-right;
                        padding-top: 18px + root.safe-top;
                        spacing: 12px;

                        // Back bar: returns to the landing (Backspace too).
                        sub_heading := HorizontalLayout {
                            vertical-stretch: 0;
                            min-height: 36px;
                            spacing: 10px;
                            alignment: start;

                            Rectangle {
                                width: 36px;
                                height: 36px;
                                border-radius: 8px;
                                background: back_touch.has-hover ? Theme.current.border_soft : transparent;
                                animate background { duration: Anim.hover_fast; }

                                IcChevronLeft {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: 22px;
                                    height: 22px;
                                    fill: Theme.current.text_bright;
                                }

                                back_touch := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        // The calendar closes back to the
                                        // episode grid before leaving the
                                        // subpage (same as Back/Backspace).
                                        if (root.view == 2 && root.cal_open) {
                                            root.upcoming_cal_close();
                                        } else {
                                            root.view = 0;
                                        }
                                    }
                                }
                            }

                            Text {
                                text: root.view >= 3 ? root.catalog_sections[root.view - 3].title
                                    : root.view == 2 ? @tr("Upcoming") : @tr("Continue Watching");
                                font-size: 22px;
                                font-weight: 700;
                                color: Theme.current.text_bright;
                                vertical-alignment: center;
                                min-width: 0px;
                                max-width: self.preferred-width;
                                horizontal-stretch: 1;
                                height: self.preferred-height;
                                wrap: word-wrap;
                            }

                            Text {
                                text: "(" + root.active_len() + ")";
                                font-size: 14px;
                                color: Theme.current.text_hint;
                                vertical-alignment: center;
                            }

                            // Push the view toggle to the row's end.
                            Rectangle { horizontal-stretch: 1; }

                            // Upcoming only: the episode grid ⇄ month calendar
                            // switch. The button reads what it opens to.
                            if root.view == 2 && !root.narrow: CalToggle {
                                open: root.cal_open;
                                toggled => { root.toggle_calendar(); }
                            }
                        }

                        // A separate touch row keeps Calendar/List reachable
                        // even while the translated heading wraps.
                        if root.view == 2 && root.narrow: HorizontalLayout {
                            height: 36px;
                            vertical-stretch: 0;
                            alignment: end;
                            CalToggle {
                                open: root.cal_open;
                                toggled => { root.toggle_calendar(); }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.current.home_divider; }

                        Rectangle {
                            vertical-stretch: 1;
                            min-height: 0px;
                            clip: true;

                            sub_scroll := ScrollView {
                                width: 100%;
                                height: 100%;
                                mouse-drag-pan-enabled: true;
                                init => { self.content-y = root.all_scroll_y; }
                                changed content-y => {
                                    root.all_scroll_y = self.content-y;
                                }

                                // The ScrollView needs a direct *layout*
                                // child for its content-height (a bare
                                // conditional child is ignored, leaving the
                                // viewport unscrollable). This wrapper holds
                                // the view-gated grids.
                                VerticalLayout {
                                    width: 100%;
                                    padding-top: root.grid_top;
                                    spacing: 12px;

                                    // ---- All Continue Watching ------
                                    if root.view == 1: VerticalLayout {
                                        width: 100%;
                                        spacing: 12px;

                                        HorizontalLayout {
                                            width: 100%;
                                            alignment: center;

                                            continue_grid := GridLayout {
                                                // Exact content width so centering above has an effect.
                                                width: root.grid_cols * (root.grid_item_width + root.item-gap) - root.item-gap;
                                                spacing: root.item-gap;

                                                for c[i] in root.continue_rows: ContinueCard {
                                                    row: Math.floor(i / root.grid_cols);
                                                    col: Math.mod(i, root.grid_cols);

                                                    entry: c;
                                                    card-width: root.grid_item_width;
                                                    touch_menus: root.touch_menus;
                                                    focused: root.kb_active && root.kb_zone == 1 && root.kb_idx == i;
                                                    reveal: root.sub_revealed;
                                                    reveal-delay: root.stagger ? i * 30ms : 0ms;
                                                    pointer_pressed => { root.kb_active = false; }
                                                    picked => {
                                                        root.kb_active = false;
                                                        root.kb_zone = 1;
                                                        root.kb_idx = i;
                                                        root.continue_picked(i);
                                                    }
                                                    menu_requested => {
                                                        if (root.touch_menus) {
                                                            root.open_continue_menu(i);
                                                        }
                                                    }
                                                    enter_requested => {
                                                        root.continue_enter(i);
                                                    }
                                                    remove_requested => {
                                                        root.continue_remove(i);
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // ---- All Upcoming ---------------
                                    // The episode grid; the calendar below
                                    // replaces it while `cal_open`.
                                    if root.view == 2 && !root.cal_open: VerticalLayout {
                                        width: 100%;
                                        spacing: 12px;

                                        HorizontalLayout {
                                            width: 100%;
                                            alignment: center;

                                            upcoming_grid := GridLayout {
                                                width: root.grid_cols * (root.grid_item_width + root.item_gap) - root.item-gap;
                                                spacing: root.item-gap;

                                                for u[i] in root.upcoming_rows: UpcomingCard {
                                                    row: Math.floor(i / root.grid_cols);
                                                    col: Math.mod(i, root.grid_cols);

                                                    entry: u;
                                                    card-width: root.grid_item_width;
                                                    touch_menus: root.touch_menus;
                                                    focused: root.kb_active && root.kb_zone == 1 && root.kb_idx == i;
                                                    reveal: root.sub_revealed;
                                                    reveal-delay: root.stagger ? i * 30ms : 0ms;
                                                    pointer_pressed => { root.kb_active = false; }
                                                    menu_requested => { root.open_upcoming_menu(i); }
                                                    picked => {
                                                        root.kb_active = false;
                                                        root.kb_zone = 1;
                                                        root.kb_idx = i;
                                                        root.upcoming_picked(i);
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // ---- All titles in the selected catalog ----
                                    if root.view >= 3: HorizontalLayout {
                                        width: 100%;
                                        alignment: center;

                                        GridLayout {
                                            width: root.grid_cols * (root.grid_item_width + root.item-gap) - root.item-gap;
                                            spacing: root.item-gap;

                                            for i in root.catalog_sections[root.view - 3].card_count: HomeCatalogPosterCard {
                                                row: Math.floor(i / root.grid_cols);
                                                col: Math.mod(i, root.grid_cols);
                                                entry: root.catalog_cards[root.catalog_sections[root.view - 3].first_card + i];
                                                card-width: root.grid_item_width;
                                                touch_menus: root.touch_menus;
                                                focused: root.kb_active && root.kb_zone == 1 && root.kb_idx == i;
                                                reveal: root.sub_revealed;
                                                reveal-delay: root.stagger ? i * 30ms : 0ms;
                                                pointer_pressed => { root.kb_active = false; }
                                                picked => {
                                                    root.kb_active = false;
                                                    root.kb_zone = 1;
                                                    root.kb_idx = i;
                                                    root.catalog_card_picked(root.catalog_cards[root.catalog_sections[root.view - 3].first_card + i].flat_index);
                                                }
                                            }
                                        }
                                    }

                                    // ---- Upcoming calendar ----------
                                    // Month grid (full Monday-first weeks, 42
                                    // cells so the shape never shifts) with
                                    // episode counts, plus the selected day's
                                    // episodes in the same card grid. Taps
                                    // resolve through the rows' full-list
                                    // `index`.
                                    if root.view == 2 && root.cal_open: VerticalLayout {
                                        width: 100%;
                                        spacing: 12px;
                                        // Pack from the top: without this the
                                        // column shares the scroll viewport's
                                        // leftover height equally between the
                                        // month/weekday/grid bands, leaving a
                                        // huge gap above the dates.
                                        alignment: start;

                                        // Month step: ‹ title ›.
                                        HorizontalLayout {
                                            width: 100%;
                                            spacing: 8px;
                                            alignment: start;

                                            Rectangle {
                                                width: 32px;
                                                height: 32px;
                                                border-radius: 8px;
                                                background: cal_prev_touch.has-hover ? Theme.current.border_soft : transparent;
                                                animate background { duration: Anim.hover_fast; }

                                                IcChevronLeft {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    width: 20px;
                                                    height: 20px;
                                                    fill: Theme.current.text_bright;
                                                }

                                                cal_prev_touch := TouchArea {
                                                    width: 100%;
                                                    height: 100%;
                                                    mouse-cursor: pointer;
                                                    clicked => { root.upcoming_cal_month(-1); }
                                                }
                                            }

                                            Text {
                                                text: root.cal_title;
                                                font-size: 16px;
                                                font-weight: 700;
                                                color: Theme.current.text_bright;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                                horizontal-stretch: 1;
                                            }

                                            Rectangle {
                                                width: 32px;
                                                height: 32px;
                                                border-radius: 8px;
                                                background: cal_next_touch.has-hover ? Theme.current.border_soft : transparent;
                                                animate background { duration: Anim.hover_fast; }

                                                IcChevronRight {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    width: 20px;
                                                    height: 20px;
                                                    fill: Theme.current.text_bright;
                                                }

                                                cal_next_touch := TouchArea {
                                                    width: 100%;
                                                    height: 100%;
                                                    mouse-cursor: pointer;
                                                    clicked => { root.upcoming_cal_month(1); }
                                                }
                                            }
                                        }

                                        // Weekday header, Monday-first.
                                        HorizontalLayout {
                                            width: 100%;
                                            spacing: 4px;

                                            for wd in [@tr("Mon"), @tr("Tue"), @tr("Wed"), @tr("Thu"), @tr("Fri"), @tr("Sat"), @tr("Sun")]: Text {
                                                text: wd;
                                                font-size: 11px;
                                                font-weight: 600;
                                                color: Theme.current.text_hint;
                                                horizontal-alignment: center;
                                                horizontal-stretch: 1;
                                            }
                                        }

                                        GridLayout {
                                            width: 100%;
                                            spacing: 4px;

                                            for cell[i] in root.cal_cells: CalDayCell {
                                                row: Math.floor(i / 7);
                                                col: Math.mod(i, 7);

                                                cell: cell;
                                                // Seven even columns across
                                                // the viewport (6 × 4px gaps).
                                                cell_width: (sub_scroll.width - 6 * 4px) / 7;
                                                kb_ring: root.kb_active;
                                                picked(e) => { root.upcoming_cal_pick(e); }
                                            }
                                        }

                                        // Selected day's episodes, same cards
                                        // as the grid (no stagger: the set
                                        // changes on every day pick).
                                        if root.cal_day_rows.length > 0: HorizontalLayout {
                                            width: 100%;
                                            alignment: center;

                                            calendar_day_grid := GridLayout {
                                                width: root.grid_cols * (root.grid_item_width + root.item-gap) - root.item-gap;
                                                spacing: root.item-gap;

                                                for u[i] in root.cal_day_rows: UpcomingCard {
                                                    row: Math.floor(i / root.grid_cols);
                                                    col: Math.mod(i, root.grid_cols);

                                                    entry: u;
                                                    card-width: root.grid_item_width;
                                                    touch_menus: root.touch_menus;
                                                    reveal: root.sub_revealed;
                                                    pointer_pressed => { root.kb_active = false; }
                                                    menu_requested => { root.open_upcoming_menu(u.index); }
                                                    picked => {
                                                        root.kb_active = false;
                                                        root.upcoming_picked(u.index);
                                                    }
                                                }
                                            }
                                        }

                                        if root.cal_day_rows.length == 0: Text {
                                            text: @tr("No episodes on this day.");
                                            font-size: 13px;
                                            color: Theme.current.text_muted;
                                            horizontal-alignment: center;
                                            width: 100%;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Bottom tab bar (narrow only): wide layouts use the left rail.
            // Hidden on a "see all" subpage — the rail stays up there, since
            // on a desktop it is window chrome rather than page chrome.
            if root.narrow && root.view == 0: bottom := BottomNav {
                active: 0;
                safe-bottom: root.safe-bottom;
                safe-left: root.safe-left;
                safe-right: root.safe-right;
                kb_zone: root.kb_zone;
                kb_nav: root.kb_nav;
                kb_active <=> root.kb_active;

                home_picked => { root.home_picked(); }
                discover_picked => { root.discover_picked(); }
                library_picked => { root.library_picked(); }
                settings_picked => { root.settings_picked(); }
            }
        }

        // Fixed outside the layout and scroll view, so bright artwork cannot
        // scroll out from under the status icons. Images do not capture input.
        if root.narrow && root.view == 0: Image {
            width: 100%; height: root.safe-top + 64px;
            source: @image-url("../../assets/status-bar-scrim.svg");
            image-fit: fill;
            opacity: Theme.status_bar_gradient / 100;
        }

        // Left navigation rail (wide layouts only; narrow uses the bottom
        // bar, and only on the landing view). Declared after the page column
        // so it paints over the strip its own footprint reserves — the
        // column widens its left padding by `rail_w`, so no page content
        // lands under it.
        if !root.narrow: rail := SideNav {
            viewport-width: root.nav-viewport-width;
            panel-background: Theme.current.artwork_canvas;
            active: 0;
            safe-top: root.safe-top;
            safe-left: root.safe-left;
            safe-bottom: root.safe-bottom;
            kb_zone: root.kb_zone;
            kb_nav: root.kb_nav;
            kb_active <=> root.kb_active;

            home_picked => { root.home_picked(); }
            discover_picked => { root.discover_picked(); }
            library_picked => { root.library_picked(); }
            settings_picked => { root.settings_picked(); }
        }

        // Card menu (single instance, page-level overlay): the dim
        // backdrop eats outside taps (dismiss only, never forwarded). A
        // sibling of the page layout, not a layout child — inside the
        // VerticalLayout above it would be laid out as a row and squeeze the
        // landing content instead of covering it (very visible on Android).
        // Play / Enter series / Remove from Continue Watching (+ the sheet's
        // own Cancel).
        cont_sheet := MenuSheet {
            open: root.menu_open;
            width: 100%;
            height: 100%;
            safe-bottom: root.safe-bottom;
            safe-left: root.safe-left;
            safe-right: root.safe-right;
            max_h: root.height * 0.85;
            sheet_title: root.menu_upcoming && root.menu_idx >= 0 && root.menu_idx < root.upcoming_rows.length
                ? root.upcoming_rows[root.menu_idx].title
                : root.menu_idx >= 0 && root.menu_idx < root.continue_rows.length
                ? root.continue_rows[root.menu_idx].title
                : @tr("Continue Watching");
            items: root.menu_upcoming ? [ { label: @tr("Enter series"), enabled: true } ] : [
                { label: @tr("Play"), enabled: true },
                { label: @tr("Enter series"), enabled: true },
                { label: @tr("Remove from Continue Watching"), enabled: true },
            ];
            picked(a) => {
                if (root.menu_upcoming) {
                    root.kb_active = false;
                    root.upcoming_picked(root.menu_idx);
                } else if (a == 0) {
                    root.kb_active = false;
                    root.kb_zone = 1;
                    root.kb_idx = root.menu_idx;
                    root.continue_picked(root.menu_idx);
                } else if (a == 1) {
                    root.continue_enter(root.menu_idx);
                } else {
                    root.continue_remove(root.menu_idx);
                }
                root.close_menu();
            }
            closed => { root.close_menu(); }
        }
    }
}
