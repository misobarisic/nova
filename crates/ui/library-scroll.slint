import { ControlInput } from "@NovaUiShared";

// Library gestures keep direct manipulation but bound the release velocity.
// Native Flickable's unbounded fling can cross hundreds of saved titles.
export component LibraryScroll inherits Rectangle {
    clip: true;
    in property <length> content-height;
    in-out property <length> content-y;
    out property <length> visible-width: root.width;
    out property <length> visible-height: root.height;
    private property <length> drag_origin;
    private property <length> previous_y;
    private property <duration> previous_tick;
    private property <length> recent_y;
    private property <duration> recent_tick;
    private property <length> middle_y;
    private property <duration> middle_tick;
    private property <length> older_y;
    private property <duration> older_tick;
    // Logical pixels per second, represented as a length for Slint arithmetic.
    private property <length> velocity;
    private property <duration> coast_tick;
    private property <bool> dragging;
    private property <Point> active_press;

    function bounded(y: length) -> length {
        return Math.clamp(y, Math.min(0px, root.height - root.content-height), 0px);
    }
    public function stop() { coast.stop(); root.velocity = 0px; }
    function reset_samples(y: length, tick: duration) {
        root.recent_y = y; root.middle_y = y; root.older_y = y;
        root.recent_tick = tick; root.middle_tick = tick; root.older_tick = tick;
    }
    function sample_velocity(y: length, now: duration) {
        let elapsed = now - root.previous_tick;
        if elapsed <= 0ms { return; }
        if ControlInput.touch-feedback && elapsed > 80ms {
            root.reset_samples(y, now);
            root.velocity = 0px;
            return;
        }
        let delta = y - root.previous_y;
        // A deliberate reversal starts a new velocity window; a tiny lift-off
        // wobble should not discard the rest of the gesture's movement.
        if ControlInput.touch-feedback && ((delta < 0px && root.velocity > 0px) || (delta > 0px && root.velocity < 0px)) && Math.abs(delta) > 8px {
            root.reset_samples(root.previous_y, root.previous_tick);
        }
        // Keep a short time window rather than the final event alone. Android
        // may deliver several MOVE events in one frame or a tiny last movement.
        let use_older = ControlInput.touch-feedback && now - root.older_tick <= 80ms;
        let use_middle = ControlInput.touch-feedback && now - root.middle_tick <= 80ms;
        let anchor_y = use_older ? root.older_y : use_middle ? root.middle_y : ControlInput.touch-feedback ? root.recent_y : root.previous_y;
        let anchor_tick = use_older ? root.older_tick : use_middle ? root.middle_tick : ControlInput.touch-feedback ? root.recent_tick : root.previous_tick;
        let sample_time = now - anchor_tick;
        if sample_time > 0ms {
            let limit = root.height * 4;
            root.velocity = Math.clamp((y - anchor_y) * 1000ms / sample_time, -limit, limit);
        }
        if ControlInput.touch-feedback && now - root.recent_tick >= 24ms {
            root.older_y = root.middle_y; root.older_tick = root.middle_tick;
            root.middle_y = root.recent_y; root.middle_tick = root.recent_tick;
            root.recent_y = y; root.recent_tick = now;
        }
    }
    changed content-height => {
        root.stop();
        if root.content-height > 0px && root.height > 0px { root.content-y = root.bounded(root.content-y); }
    }
    changed height => {
        root.stop();
        if root.content-height > 0px && root.height > 0px { root.content-y = root.bounded(root.content-y); }
    }
    coast := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            let now = animation-tick();
            let elapsed = Math.clamp(now - root.coast_tick, 1ms, 48ms);
            root.coast_tick = now;
            // Touch needs a gentle low-speed tail rather than the desktop
            // drag brake. Velocity-dependent friction still bounds a fast
            // fling to roughly 2.8 viewports after release.
            let friction = ControlInput.touch-feedback
                ? Math.max(root.height * 0.4, Math.abs(root.velocity) * 1.4)
                : 9000px;
            let speed = Math.max(0px, Math.abs(root.velocity) - friction * elapsed / 1000ms);
            let next_velocity = root.velocity < 0px ? -speed : speed;
            let next = root.bounded(root.content-y + (root.velocity + next_velocity) / 2 * elapsed / 1000ms);
            if speed == 0px || next == root.content-y { self.stop(); }
            root.content-y = next;
            root.velocity = next_velocity;
        }
    }
    // The outer TouchArea handles wheel events only after child controls have
    // had their turn. The gesture recognizer preserves taps and cancels card
    // presses when a drag is recognized, including native touchscreen input.
    TouchArea {
        width: 100%; height: 100%;
        scroll-event(event) => {
            root.stop();
            root.content-y = root.bounded(root.content-y + event.delta-y);
            accept
        }
        swipe := SwipeGestureHandler {
            width: 100%; height: 100%;
            handle-swipe-up: root.content-height > root.height;
            handle-swipe-down: root.content-height > root.height;
            changed pressed-position => {
                // Changed handlers may run after moved/swiped. Do not let a
                // delayed press notification cancel that gesture's new coast.
                if self.pressed-position != root.active_press { root.stop(); }
            }
            moved => {
                if self.swiping {
                    // Initialize synchronously: a deferred `changed swiping`
                    // handler would count the first movement twice.
                    if !root.dragging {
                        root.stop();
                        root.dragging = true;
                        root.active_press = self.pressed-position;
                        root.drag_origin = root.content-y;
                        root.previous_y = self.pressed-position.y;
                        root.previous_tick = animation-tick();
                        root.reset_samples(self.current-position.y, root.previous_tick);
                    }
                    let now = animation-tick();
                    if self.current-position.y != root.previous_y {
                        root.sample_velocity(self.current-position.y, now);
                        // Some touch drivers repeat the final position just
                        // before Up. Preserve the last real velocity sample;
                        // its age still rejects a genuine hold before release.
                        root.previous_y = self.current-position.y;
                        root.previous_tick = now;
                    }
                    root.content-y = root.bounded(root.drag_origin + self.current-position.y - self.pressed-position.y);
                }
            }
            swiped => {
                root.dragging = false;
                if animation-tick() - root.previous_tick <= 80ms && Math.abs(root.velocity) > 40px {
                    root.coast_tick = animation-tick();
                    coast.start();
                }
            }
            cancelled => { root.dragging = false; root.stop(); }
            Rectangle {
                x: 0px; y: root.content-y;
                width: root.width; height: root.content-height;
                @children
            }
        }
    }
}
