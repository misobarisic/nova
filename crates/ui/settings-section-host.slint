import { SettingsContent } from "@NovaUiShared";

// ComponentContainer does not export its child window's intrinsic height.
// The mounted submenu reports its measured layout, at this slot's real width.
export component SettingsSectionHost inherits Rectangle {
    in property <component-factory> factory;
    in-out property <length> slot_width <=> SettingsContent.slot_width;
    in-out property <length> slot_height <=> SettingsContent.slot_height;
    min-height: SettingsContent.content_min_height;
    preferred-height: SettingsContent.content_preferred_height;
    vertical-stretch: 0;
    // The embedded root measures wrapped content at our allocated width.
    // Keep its intrinsic layout out of the host's own negotiation: consulting
    // it there would read slot_width through the parent layout being solved.
    // Explicit positioning makes this a visual child; the published heights
    // above remain the only intrinsic submenu sizing contract.
    ComponentContainer {
        x: 0px; y: 0px;
        width: 100%; height: 100%;
        component-factory: root.factory;
    }
}
