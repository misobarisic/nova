import { BackupBridge, Theme, InterfaceStyle, SettingsStyle } from "@NovaUiShared";
import { PillButton, SettingsCard, SettingsHeader, SettingsRow, SectionHeader, ToggleSwitch } from "settings-controls.slint";
import { ScrollView } from "scrollview.slint";

component BackupChoice inherits SettingsRow {
    in property <bool> checked;
    in property <bool> focused;
    callback picked();
    ToggleSwitch { name: root.row-title; checked: root.checked; focused: root.focused; enabled: !BackupBridge.busy; toggled => { root.picked(); } }
}

export component BackupPanel inherits Rectangle {
    in property <int> focus-request;
    changed focus-request => { scope.focus(); }
    in property <length> safe-top;
    in property <length> safe-bottom;
    in property <length> safe-left;
    in property <length> safe-right;
    background: Theme.current.artwork_canvas;
    // The settings page remains mounted below this management flow. Blank
    // margins consume pointer/wheel events instead of editing that page.
    TouchArea { width:100%; height:100%; clicked=>{} scroll-event(event)=>{accept} }
    property <int> choice: 0;
    property <int> profile_start: 4;
    property <int> mapping_start: root.profile_start + BackupBridge.profiles.length;
    property <int> mode_index: root.mapping_start + BackupBridge.mappings.length;
    property <int> component_start: root.mode_index + (BackupBridge.importing ? 1 : 0);
    property <int> conflict_start: root.component_start + BackupBridge.components.length;
    property <int> action_start: root.conflict_start + BackupBridge.conflicts.length;
    property <int> count: root.action_start + (BackupBridge.importing && BackupBridge.preview_ready ? 6 : 5);
    changed count => { root.choice = Math.min(root.choice,root.count - 1); }
    function activate() {
        if BackupBridge.busy { return; }
        if root.choice == 0 { BackupBridge.closed(); }
        else if root.choice < 4 { BackupBridge.preset(root.choice - 1); }
        else if root.choice < root.mapping_start { BackupBridge.toggle_profile(BackupBridge.profiles[root.choice - root.profile_start].id); }
        else if root.choice < root.mode_index { BackupBridge.cycle_target(BackupBridge.mappings[root.choice - root.mapping_start].id); }
        else if BackupBridge.importing && root.choice == root.mode_index { BackupBridge.mode_changed(!BackupBridge.replace); }
        else if root.choice < root.conflict_start { BackupBridge.toggle_component(BackupBridge.components[root.choice - root.component_start].id); }
        else if root.choice < root.action_start { BackupBridge.toggle_conflict(BackupBridge.conflicts[root.choice - root.conflict_start].id); }
        else {
            let action=root.choice - root.action_start;
            if action==0 {
                if !BackupBridge.importing { BackupBridge.export_file(); }
                else if BackupBridge.preview_ready { BackupBridge.apply_import(); }
                else { BackupBridge.build_preview(); }
            } else if BackupBridge.importing && BackupBridge.preview_ready && action==1 { BackupBridge.build_preview(); }
            else if action==(BackupBridge.importing && BackupBridge.preview_ready ? 2:1) { BackupBridge.import_file(); }
            else if action==(BackupBridge.importing && BackupBridge.preview_ready ? 3:2) { BackupBridge.undo(); }
            else if action==(BackupBridge.importing && BackupBridge.preview_ready ? 4:3) { BackupBridge.delete_recovery(); }
            else { BackupBridge.closed(); }
        }
    }
    function reveal(y:length,h:length) {
        let top=y - scroll.absolute-position.y;
        if top<0px { scroll.content-y -=top; }
        else if top+h>scroll.visible-height {scroll.content-y -=top+h - scroll.visible-height;}
    }
    init => { focus_timer.start(); }
    focus_timer := Timer { interval:1ms; running:false; triggered => {self.stop(); scope.focus();} }
    scope := FocusScope {
        width:100%; height:100%;
        capture-key-pressed(e) => {
            if e.text == Key.Escape || e.text == Key.Back { if !BackupBridge.busy {BackupBridge.closed();} accept }
            else if e.text == Key.Tab || e.text == Key.UpArrow || e.text == Key.DownArrow {
                if !BackupBridge.busy { SettingsStyle.keyboard-mode=true; root.choice=Math.mod(root.choice+root.count+(e.text==Key.UpArrow || e.modifiers.shift ? -1:1),root.count); scope.focus(); } accept
            } else {reject}
        }
        key-pressed(e) => {if e.text==Key.Return || e.text==" " {if !e.repeat {root.activate();} accept} else {reject}}
        scroll := ScrollView {
            x:root.safe-left+Math.max(18px,(parent.width - root.safe-left - root.safe-right - 850px)/2); y:root.safe-top+18px;
            width:Math.min(850px,parent.width - root.safe-left - root.safe-right - 36px); height:parent.height - root.safe-top - root.safe-bottom - 36px;
            content-width:self.visible-width; content-height:body.preferred-height;
            body := VerticalLayout {
                width:100%; spacing:16px;
                SettingsHeader { title:@tr("Backup and import"); introduction:BackupBridge.importing ? @tr("Map profiles, select components and review changes before importing."):@tr("Choose the profiles and personal data to export."); back_focused:root.choice==0; back=>{if !BackupBridge.busy {BackupBridge.closed();}} changed back_focused=>{if self.back_focused {root.reveal(self.absolute-position.y,self.height);}} }
                SectionHeader { label:@tr("Presets"); }
                SettingsCard {
                    SettingsRow {row-title:@tr("Everything personal");row-desc:@tr("All personal components, including credentials and profile PINs.");PillButton {label:@tr("Select");focused:root.choice==1;enabled:!BackupBridge.busy;clicked=>{BackupBridge.preset(0);}changed focused=>{if self.focused {root.reveal(self.absolute-position.y,self.height);}}}}
                    SettingsRow {row-title:@tr("Library and viewing");row-desc:@tr("Library, progress, history, collections, bookmarks and queue.");PillButton {label:@tr("Select");focused:root.choice==2;enabled:!BackupBridge.busy;clicked=>{BackupBridge.preset(1);}changed focused=>{if self.focused {root.reveal(self.absolute-position.y,self.height);}}}}
                    SettingsRow {row-title:@tr("Configuration");row-desc:@tr("Personal settings, addons, integrations and profile policy.");PillButton {label:@tr("Select");focused:root.choice==3;enabled:!BackupBridge.busy;clicked=>{BackupBridge.preset(2);}changed focused=>{if self.focused {root.reveal(self.absolute-position.y,self.height);}}}}
                }
                SectionHeader {label:BackupBridge.importing ? @tr("Target profiles"):@tr("Profiles");}
                SettingsCard {
                    for row[index] in BackupBridge.profiles: BackupChoice {row-title:row.label;checked:row.checked;focused:root.choice==root.profile_start+index;picked=>{root.choice=root.profile_start+index;BackupBridge.toggle_profile(row.id);}changed focused=>{if self.focused {root.reveal(self.absolute-position.y,self.height);}}}
                    for row[index] in BackupBridge.mappings: SettingsRow {row-title:row.label;row-desc:row.target;PillButton {label:@tr("Change");focused:root.choice==root.mapping_start+index;enabled:!BackupBridge.busy;clicked=>{root.choice=root.mapping_start+index;BackupBridge.cycle_target(row.id);}changed focused=>{if self.focused {root.reveal(self.absolute-position.y,self.height);}}}}
                }
                if BackupBridge.importing: SettingsCard {
                    BackupChoice {row-title:@tr("Replace selected components");row-desc:BackupBridge.replace ? @tr("Absent records in selected components will be deleted."):@tr("Merge inserts missing records and preserves local conflicts.");checked:BackupBridge.replace;focused:root.choice==root.mode_index;picked=>{BackupBridge.mode_changed(!BackupBridge.replace);}changed focused=>{if self.focused {root.reveal(self.absolute-position.y,self.height);}}}
                }
                SectionHeader {label:@tr("Components");}
                SettingsCard {
                    for row[index] in BackupBridge.components: BackupChoice {row-title:row.label;checked:row.checked;focused:root.choice==root.component_start+index;picked=>{root.choice=root.component_start+index;BackupBridge.toggle_component(row.id);}changed focused=>{if self.focused {root.reveal(self.absolute-position.y,self.height);}}}
                }
                if BackupBridge.conflicts.length>0: SectionHeader {label:@tr("Use backup for conflicts");}
                if BackupBridge.conflicts.length>0: SettingsCard {
                    for row[index] in BackupBridge.conflicts: BackupChoice {row-title:row.label;checked:row.checked;focused:root.choice==root.conflict_start+index;picked=>{root.choice=root.conflict_start+index;BackupBridge.toggle_conflict(row.id);}changed focused=>{if self.focused {root.reveal(self.absolute-position.y,self.height);}}}
                }
                if BackupBridge.preview_rows.length>0: SectionHeader {label:@tr("Import preview");}
                if BackupBridge.preview_rows.length>0: SettingsCard {for row in BackupBridge.preview_rows: SettingsRow {row-desc:row;full-width-text:true;}}
                Text {text:@tr("Selected configuration includes addon credentials and profile PINs. Imported edits sync to paired devices. Notification delivery and smart downloads stay off on this device.");color:Theme.current.text_settings;font-size:InterfaceStyle.tv ? 20px:14px;wrap:word-wrap;}
                if BackupBridge.status!="": SettingsCard {SettingsRow {row-desc:BackupBridge.status;full-width-text:true;}}
                // Only actions valid for the current stage participate in focus.
                PillButton {label:!BackupBridge.importing ? @tr("Export selected data"):BackupBridge.preview_ready ? @tr("Import reviewed changes"):@tr("Build import preview");wrap_label:true;roomy:true;primary:true;focused:root.choice==root.action_start;enabled:!BackupBridge.busy;clicked=>{root.choice=root.action_start;root.activate();}changed focused=>{if self.focused {root.reveal(self.absolute-position.y,self.height);}}}
                if BackupBridge.importing && BackupBridge.preview_ready: PillButton {label:@tr("Rebuild import preview");wrap_label:true;roomy:true;focused:root.choice==root.action_start+1;enabled:!BackupBridge.busy;clicked=>{BackupBridge.build_preview();}changed focused=>{if self.focused {root.reveal(self.absolute-position.y,self.height);}}}
                PillButton {label:BackupBridge.importing ? @tr("Choose another backup file"):@tr("Choose backup file to import");wrap_label:true;roomy:true;focused:root.choice==root.action_start+(BackupBridge.importing && BackupBridge.preview_ready ? 2:1);enabled:!BackupBridge.busy;clicked=>{BackupBridge.import_file();}changed focused=>{if self.focused {root.reveal(self.absolute-position.y,self.height);}}}
                PillButton {label:@tr("Undo last import");wrap_label:true;roomy:true;focused:root.choice==root.action_start+(BackupBridge.importing && BackupBridge.preview_ready ? 3:2);enabled:!BackupBridge.busy;clicked=>{BackupBridge.undo();}changed focused=>{if self.focused {root.reveal(self.absolute-position.y,self.height);}}}
                PillButton {label:@tr("Delete recovery copies");wrap_label:true;roomy:true;destructive:true;focused:root.choice==root.action_start+(BackupBridge.importing && BackupBridge.preview_ready ? 4:3);enabled:!BackupBridge.busy;clicked=>{BackupBridge.delete_recovery();}changed focused=>{if self.focused {root.reveal(self.absolute-position.y,self.height);}}}
                PillButton {label:@tr("Done");wrap_label:true;roomy:true;focused:root.choice==root.action_start+(BackupBridge.importing && BackupBridge.preview_ready ? 5:4);enabled:!BackupBridge.busy;clicked=>{BackupBridge.closed();}changed focused=>{if self.focused {root.reveal(self.absolute-position.y,self.height);}}}
            }
        }
    }
}
