import { StreamFiltersBridge, Theme, Anim, InterfaceStyle, SettingsStyle, SettingsSync } from "@NovaUiShared";
import { ScrollView } from "scrollview.slint";
import { SearchField } from "searchfield.slint";
import { PillButton } from "settings-controls.slint";
import { SettingSyncBadge } from "settings-sync.slint";
import { SettingSyncModal } from "settings-sync-modal.slint";
import { IcChevronRight, IcCheck } from "icons.slint";

component FilterRule inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> checked;
    in property <bool> toggle;
    in property <bool> focused;
    callback picked();
    callback reveal(length, length);
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.toggle ? (root.checked ? @tr("On") : @tr("Off")) : root.value;
    accessible-checkable: root.toggle;
    accessible-checked: root.checked;
    accessible-action-default => { root.picked(); }
    height: Math.max(60px, rule_label.preferred-height + (root.toggle ? 24px : 44px));
    border-radius: 12px;
    background: touch.has-hover ? Theme.current.control_hover : root.checked && root.toggle ? Theme.current.selection_wash : Theme.current.control;
    border-width: root.focused ? 2px : 1px;
    border-color: root.focused ? Theme.current.focus_ring : Theme.current.border_soft;
    changed focused => { if root.focused { reveal_timer.start(); } }
    reveal_timer := Timer { interval: 1ms; running: false; triggered => { self.stop(); if root.focused { root.reveal(root.absolute-position.y, root.height); } } }
    rule_label := Text {
        x: 14px; y: 10px; width: Math.max(0px, root.width - 62px);
        text: root.label; color: Theme.current.text_bright;
        font-size: InterfaceStyle.tv ? 20px : 14px; font-weight: 600; wrap: word-wrap;
    }
    if !root.toggle: Text {
        x: rule_label.x; y: rule_label.y + rule_label.preferred-height + 4px; width: rule_label.width;
        text: root.value; color: Theme.current.text_secondary; font-size: 12px;
        overflow: elide;
    }
    if root.toggle: Rectangle {
        width: 26px; height: 26px; x: root.width - 40px; y: (root.height - self.height) / 2;
        border-radius: 8px; border-width: 1px;
        border-color: root.checked ? Theme.current.accent : Theme.current.border_strong;
        background: root.checked ? Theme.current.primary_button : transparent;
        if root.checked: IcCheck { x: 4px; y: 4px; width: 18px; height: 18px; fill: Theme.current.on_accent; }
    }
    if !root.toggle: IcChevronRight { x: root.width - 34px; y: (root.height - self.height) / 2; width: 18px; height: 18px; fill: Theme.current.text_secondary; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { SettingsStyle.keyboard-mode = false; root.picked(); } }
}

export component StreamFilterPanel inherits Rectangle {
    in property <length> safe-top;
    in property <length> safe-bottom;
    in property <length> safe-left;
    in property <length> safe-right;
    in property <bool> narrow: root.width < 600px;
    in property <bool> open: StreamFiltersBridge.open;
    private property <bool> retained;
    private property <bool> revealed;
    private property <bool> motion: Anim.enabled && Anim.transitions;
    private property <int> selected;
    private property <int> note_focus_request;
    private property <string> language_draft: StreamFiltersBridge.audio_languages;
    callback closed();
    visible: root.open || root.retained;
    width: 100%; height: 100%;
    // First construction can already be open because the selector mounts
    // this form lazily. Initialize focus/draft exactly as on later openings.
    function begin_open() {
        exit_timer.stop(); root.retained = true; root.revealed = !root.motion;
        root.selected = 0; root.language_draft = StreamFiltersBridge.audio_languages;
        enter_timer.start(); keys.focus();
    }
    init => { if root.open { root.begin_open(); } }
    changed open => {
        if root.open {
            root.begin_open();
        } else {
            root.revealed = false;
            if root.motion { exit_timer.start(); } else { root.retained = false; }
        }
    }
    changed motion => { if !root.motion { root.revealed = root.open; root.retained = root.open; } }
    enter_timer := Timer { interval: 1ms; running: false; triggered => { self.stop(); root.revealed = root.open; } }
    exit_timer := Timer { interval: Anim.transition_slide; running: false; triggered => { self.stop(); root.retained = false; } }
    changed selected => {
        if root.selected == 8 { root.reveal(language.absolute-position.y, language.height); }
        else if root.selected == 9 { root.reveal(apply_languages.absolute-position.y, apply_languages.height); }
    }
    function close() { if SettingsSync.open { SettingsSync.open = false; } else { StreamFiltersBridge.closed(); root.closed(); } }
    function reveal(y: length, h: length) {
        let top = y - body_scroll.absolute-position.y;
        if top < 0px { body_scroll.content-y = Math.min(0px, body_scroll.content-y - top); }
        else if top + h > body_scroll.visible-height { body_scroll.content-y = Math.max(Math.min(0px, body_scroll.visible-height - body_scroll.content-height), body_scroll.content-y - (top + h - body_scroll.visible-height)); }
    }
    function toggle(field: int, checked: bool) { StreamFiltersBridge.edited(field, checked ? "false" : "true"); }
    function activate() {
        if root.selected == 0 { root.toggle(0, StreamFiltersBridge.enabled); }
        else if root.selected == 1 { StreamFiltersBridge.edited(1, "" + Math.mod(StreamFiltersBridge.max_resolution_index + 1, 7)); }
        else if root.selected == 2 { StreamFiltersBridge.edited(2, "" + Math.mod(StreamFiltersBridge.max_size_index + 1, 9)); }
        else if root.selected == 3 { root.toggle(3, StreamFiltersBridge.allow_avc); }
        else if root.selected == 4 { root.toggle(4, StreamFiltersBridge.allow_hevc); }
        else if root.selected == 5 { root.toggle(5, StreamFiltersBridge.allow_av1); }
        else if root.selected == 6 { root.toggle(6, StreamFiltersBridge.allow_vp9); }
        else if root.selected == 7 { root.toggle(10, StreamFiltersBridge.allow_other); }
        else if root.selected == 8 { root.note_focus_request += 1; }
        else if root.selected == 9 { StreamFiltersBridge.edited(7, root.language_draft); }
        else if root.selected == 10 { root.toggle(8, StreamFiltersBridge.require_audio); }
        else if root.selected == 11 { root.toggle(9, StreamFiltersBridge.retain_unknown); }
        else if root.selected == 12 { StreamFiltersBridge.reset(); root.language_draft = ""; }
        else if root.selected == 13 { root.close(); }
        else { SettingsSync.show("stream_filters", @tr("Universal stream filters")); }
    }
    Rectangle {
        width: 100%; height: 100%; background: Theme.current.scrim_settings;
        opacity: root.revealed ? 1 : 0;
        animate opacity { duration: root.motion ? Anim.transition_fade : 0ms; }
        TouchArea { clicked => { root.close(); } }
    }
    keys := FocusScope {
        width: 100%; height: 100%; enabled: root.open;
        key-pressed(e) => {
            if e.text == Key.Escape || e.text == Key.Back || e.text == Key.Backspace { if !e.repeat { root.close(); } accept }
            else if e.text == Key.Tab || e.text == Key.UpArrow || e.text == Key.DownArrow {
                SettingsStyle.keyboard-mode = true;
                root.selected = Math.mod(root.selected + ((e.text == Key.UpArrow || (e.text == Key.Tab && e.modifiers.shift)) ? 14 : 1), 15);
                if !SettingsSync.enabled && root.selected == 14 { root.selected = (e.text == Key.UpArrow || (e.text == Key.Tab && e.modifiers.shift)) ? 13 : 0; }
                keys.focus();
                accept
            } else if e.text == Key.Return || e.text == " " { SettingsStyle.keyboard-mode = true; if !e.repeat { root.activate(); } accept }
            else { reject }
        }
        card := Rectangle {
            x: root.safe-left + (root.width - root.safe-left - root.safe-right - self.width) / 2;
            y: root.safe-top + (root.height - root.safe-top - root.safe-bottom - self.height) / 2 + (root.revealed ? 0px : 24px);
            width: Math.max(0px, Math.min(560px, root.width - root.safe-left - root.safe-right - 24px));
            height: Math.max(0px, Math.min(820px, root.height - root.safe-top - root.safe-bottom - 24px));
            border-radius: Theme.card_corner_radius;
            background: Theme.current.popup; border-width: 1px; border-color: Theme.current.border_medium;
            opacity: root.revealed ? 1 : 0;
            animate y { duration: root.motion ? Anim.transition_slide : 0ms; easing: ease-out; }
            animate opacity { duration: root.motion ? Anim.transition_fade : 0ms; }
            clip: true;
            TouchArea { }
            VerticalLayout {
                padding: root.narrow ? 16px : 24px; spacing: 12px;
                Text { text: @tr("STREAM PREFERENCES"); font-size: 11px; font-weight: 700; letter-spacing: 2px; color: Theme.current.accent_vivid; }
                Text { text: @tr("Universal stream filters"); font-size: root.narrow ? 24px : 28px; font-weight: 700; color: Theme.current.text_bright; wrap: word-wrap; }
                Text { text: @tr("These rules apply to every addon. Defaults sync between your devices."); font-size: 13px; color: Theme.current.text_secondary; wrap: word-wrap; }
                SettingSyncBadge { setting_key: "stream_filters"; setting_title: @tr("Universal stream filters"); max-width: parent.width; border-width: root.selected == 14 ? 2px : 0px; border-color: Theme.current.focus_ring; }
                body_scroll := ScrollView {
                    vertical-stretch: 1; content-width: self.visible-width; mouse-drag-pan-enabled: true;
                    VerticalLayout {
                        width: 100%; spacing: 8px; padding-bottom: 8px; alignment: start;
                        FilterRule { label: @tr("Use stream rules"); toggle: true; checked: StreamFiltersBridge.enabled; focused: root.selected == 0; picked => { root.toggle(0, self.checked); } reveal(y,h) => { root.reveal(y,h); } }
                        FilterRule {
                            label: @tr("Maximum resolution");
                            value: StreamFiltersBridge.max_resolution_label == "" ? @tr("Any resolution") : StreamFiltersBridge.max_resolution_label;
                            focused: root.selected == 1;
                            picked => { StreamFiltersBridge.edited(1, "" + Math.mod(StreamFiltersBridge.max_resolution_index + 1, 7)); }
                            reveal(y,h) => { root.reveal(y,h); }
                        }
                        FilterRule {
                            label: @tr("Maximum size");
                            value: StreamFiltersBridge.max_size_label == "" ? @tr("Any size") : StreamFiltersBridge.max_size_label;
                            focused: root.selected == 2;
                            picked => { StreamFiltersBridge.edited(2, "" + Math.mod(StreamFiltersBridge.max_size_index + 1, 9)); }
                            reveal(y,h) => { root.reveal(y,h); }
                        }
                        Text { text: @tr("Allowed video codecs"); font-size: 15px; font-weight: 700; color: Theme.current.text_bright; }
                        Text { text: @tr("All codecs when none selected"); font-size: 12px; color: Theme.current.text_secondary; wrap: word-wrap; }
                        FilterRule { label: "H.264 / AVC"; toggle: true; checked: StreamFiltersBridge.allow_avc; focused: root.selected == 3; picked => { root.toggle(3, self.checked); } reveal(y,h) => { root.reveal(y,h); } }
                        FilterRule { label: "H.265 / HEVC"; toggle: true; checked: StreamFiltersBridge.allow_hevc; focused: root.selected == 4; picked => { root.toggle(4, self.checked); } reveal(y,h) => { root.reveal(y,h); } }
                        FilterRule { label: "AV1"; toggle: true; checked: StreamFiltersBridge.allow_av1; focused: root.selected == 5; picked => { root.toggle(5, self.checked); } reveal(y,h) => { root.reveal(y,h); } }
                        FilterRule { label: "VP9"; toggle: true; checked: StreamFiltersBridge.allow_vp9; focused: root.selected == 6; picked => { root.toggle(6, self.checked); } reveal(y,h) => { root.reveal(y,h); } }
                        FilterRule { label: @tr("Other video codecs"); toggle: true; checked: StreamFiltersBridge.allow_other; focused: root.selected == 7; picked => { root.toggle(10, self.checked); } reveal(y,h) => { root.reveal(y,h); } }
                        Text { text: @tr("Audio language codes"); font-size: 15px; font-weight: 700; color: Theme.current.text_bright; }
                        Text { text: @tr("Use language codes such as en, ja, hr."); font-size: 12px; color: Theme.current.text_secondary; wrap: word-wrap; }
                        language := SearchField {
                            roomy: true; text <=> root.language_draft; placeholder-text: "en, ja, hr";
                            property <int> focus-request: root.note_focus_request;
                            changed focus-request => { self.focus_at_end(); }
                            border-width: root.selected == 8 ? 2px : 1px;
                            border-color: root.selected == 8 ? Theme.current.focus_ring : Theme.current.control_border;
                            accepted(value) => { StreamFiltersBridge.edited(7, value); root.selected = 9; keys.focus(); }
                        }
                        apply_languages := PillButton { label: @tr("Apply languages"); roomy: true; width: 100%; focused: root.selected == 9; clicked => { StreamFiltersBridge.edited(7, language.full-text); } }
                        FilterRule { label: @tr("Require one of these audio languages"); toggle: true; checked: StreamFiltersBridge.require_audio; focused: root.selected == 10; picked => { root.toggle(8, self.checked); } reveal(y,h) => { root.reveal(y,h); } }
                        Text { text: @tr("Languages are preferred in the order listed. Enable the requirement to hide other advertised audio languages."); font-size: 12px; color: Theme.current.text_secondary; wrap: word-wrap; }
                        FilterRule { label: @tr("Keep streams with unknown details"); toggle: true; checked: StreamFiltersBridge.retain_unknown; focused: root.selected == 11; picked => { root.toggle(9, self.checked); } reveal(y,h) => { root.reveal(y,h); } }
                        if StreamFiltersBridge.notice != "": Text { text: StreamFiltersBridge.notice; font-size: 13px; color: Theme.current.text_destructive; wrap: word-wrap; }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    PillButton { label: @tr("Reset rules"); compact: true; focused: root.selected == 12; clicked => { StreamFiltersBridge.reset(); root.language_draft = ""; } }
                    Rectangle { horizontal-stretch: 1; }
                    PillButton { label: @tr("Done"); primary: true; compact: true; focused: root.selected == 13; clicked => { root.close(); } }
                }
            }
        }
    }
    SettingSyncModal { narrow: root.narrow; safe-top: root.safe-top; safe-bottom: root.safe-bottom; safe-left: root.safe-left; safe-right: root.safe-right; closed => { keys.focus(); } }
    if !root.open: TouchArea { width: 100%; height: 100%; }

}
