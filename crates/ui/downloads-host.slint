import { DownloadsBridge, DownloadEpisode, DownloadGroup } from "@NovaUiShared";

// Backend aliases live in CollectionBindings, outside this conditional host.
export component DownloadsHost inherits Rectangle {
    preferred-width: 100%; preferred-height: 100%;
    in-out property <bool> artwork-active <=> DownloadsBridge.artwork-active;
    in-out property <length> nav-viewport-width <=> DownloadsBridge.nav-viewport-width;
    in-out property <bool> external_navigation <=> DownloadsBridge.external_navigation;
    in-out property <bool> active <=> DownloadsBridge.active;
    in-out property <[DownloadGroup]> groups <=> DownloadsBridge.groups;
    in-out property <[DownloadEpisode]> transfers <=> DownloadsBridge.transfers;
    in-out property <string> summary <=> DownloadsBridge.summary;
    in-out property <[int]> counts <=> DownloadsBridge.counts;
    in-out property <length> safe-top <=> DownloadsBridge.safe-top;
    in-out property <length> safe-left <=> DownloadsBridge.safe-left;
    in-out property <length> safe-right <=> DownloadsBridge.safe-right;
    in-out property <length> safe-bottom <=> DownloadsBridge.safe-bottom;
    in-out property <int> system_back_request <=> DownloadsBridge.system_back_request;
    in-out property <length> viewport_width <=> DownloadsBridge.viewport_width;
    in-out property <length> viewport_height <=> DownloadsBridge.viewport_height;
    ComponentContainer { width: 100%; height: 100%; component-factory: DownloadsBridge.factory; }
}
