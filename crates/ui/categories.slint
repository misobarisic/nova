import { Theme, Anim, CategoryRow } from "@NovaUiShared";

import { ScrollView } from "scrollview.slint";

import { IcCheck } from "icons.slint";

export component CategoryPickerPopup {
    preferred-width: 100%;
    preferred-height: 100%;

    in-out property <string> selected_title: "";
    in-out property <[CategoryRow]> category_rows: [];
    in-out property <[bool]> modal_category_flags: [];

    callback toggle_entry_category(string);
    callback closed();

    // Keyboard modality (bound to AppWindow).
    in-out property <bool> kb_active;

    // ---- 6-button keyboard nav: chips grid + Done ----
    property <int> kb_zone: 0; // 0 chips, 1 done
    property <int> kb_idx: 0;
    // One category per row, as in Reader's title menu (kb nav follows it).
    property <int> chip_cols: 1;
    // Entrance: the panel scales and fades in like the title menu.
    private property <bool> motion: Anim.enabled && Anim.transitions;
    private property <float> shown: 0;
    animate shown { duration: root.motion ? Anim.player_slide : 0ms; easing: ease-out; }
    init => { if root.motion { reveal.start(); } else { root.shown = 1; } }
    reveal := Timer { interval: 1ms; running: false; triggered => { self.stop(); root.shown = 1; } }

    function kb_clamp() {
        if (root.kb_idx >= root.category_rows.length) {
            root.kb_idx = Math.max(0, root.category_rows.length - 1);
        }
        if (root.kb_idx < 0) {
            root.kb_idx = 0;
        }
    }

    changed category_rows => { root.kb_clamp(); }

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.current.scrim_shadow;

        nav_scope := FocusScope {
            width: 100%;
            height: 100%;
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.UpArrow || e.text == Key.DownArrow
                    || e.text == Key.LeftArrow || e.text == Key.RightArrow
                    || e.text == Key.Return || e.text == Key.Backspace) {
                    root.kb_active = true;
                }
                if (e.text == Key.UpArrow) {
                    if (root.kb_zone == 1) {
                        root.kb_zone = 0;
                    } else if (root.kb_idx >= root.chip_cols) {
                        root.kb_idx -= root.chip_cols;
                    }
                    accept
                } else if (e.text == Key.DownArrow) {
                    if (root.kb_zone == 0
                        && root.kb_idx + root.chip_cols >= root.category_rows.length) {
                        root.kb_zone = 1;
                    } else if (root.kb_zone == 0
                        && root.kb_idx + root.chip_cols < root.category_rows.length) {
                        root.kb_idx += root.chip_cols;
                    }
                    accept
                } else if (e.text == Key.LeftArrow) {
                    if (root.kb_zone == 0 && root.kb_idx > 0) {
                        root.kb_idx -= 1;
                    }
                    accept
                } else if (e.text == Key.RightArrow) {
                    if (root.kb_zone == 0
                        && root.kb_idx + 1 < root.category_rows.length) {
                        root.kb_idx += 1;
                    }
                    accept
                } else if (e.text == Key.Return) {
                    if (root.kb_zone == 1) {
                        root.closed();
                    } else if (root.kb_idx >= 0
                        && root.kb_idx < root.category_rows.length) {
                        root.toggle_entry_category(
                            root.category_rows[root.kb_idx].name);
                    }
                    accept
                } else if (e.text == Key.Backspace || e.text == Key.Back) {
                    root.closed();
                    accept
                } else {
                    reject
                }
            }
        }

        backdrop_touch := TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.kb_active = false; root.closed(); }
        }

        panel := Rectangle {
            width: min(340px, parent.width - 32px);
            // Bound the card to a concrete height: the header, the selected
            // title and up to six rows, scrolling beyond that.
            height: min(parent.height - 40px, 6px + 44px + 8px + 18px + 9px + Math.max(52px, Math.min(root.category_rows.length * 44px, 264px)) + 6px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.current.popup;
            border-radius: 14px; border-width: 1px; border-color: Theme.current.border_soft;
            drop-shadow-offset-y: 8px; drop-shadow-blur: 24px; drop-shadow-color: #00000070;
            clip: true;
            opacity: root.shown;
            transform-scale: 0.92 + 0.08 * root.shown;
            // Taps inside the panel never reach the dismissing backdrop.
            TouchArea {}

            VerticalLayout {
                padding: 6px;
                spacing: 0px;

                // Header: title left, Done right; the selected title below.
                HorizontalLayout {
                    height: 44px;
                    padding-left: 10px;
                    spacing: 8px;

                    Text {
                        text: @tr("Assign categories");
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.current.text_bright;
                        horizontal-stretch: 1;
                        overflow: elide;
                        vertical-alignment: center;
                    }

                    done_button := Rectangle {
                        width: done_label.preferred-width + 28px;
                        height: 44px;
                        border-radius: 10px;
                        background: done_touch.has-hover ? Theme.current.control_hover : transparent;
                        border-width: root.kb_active && root.kb_zone == 1 ? 2px : 0px;
                        border-color: Theme.current.focus_ring;
                        accessible-role: button;
                        accessible-label: @tr("Done");
                        accessible-action-default => { root.kb_active = false; root.closed(); }
                        done_label := Text {
                            text: @tr("Done");
                            font-size: 14px; font-weight: 600;
                            color: Theme.current.accent_soft;
                            horizontal-alignment: center; vertical-alignment: center;
                            accessible-role: none;
                        }
                        done_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.kb_active = false; root.closed(); }
                        }
                    }
                }

                // A gap keeps the selected title clear of Done's touch target.
                Rectangle { height: 8px; }
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px;
                    Text {
                        height: 18px;
                        text: root.selected_title;
                        font-size: 12px;
                        color: Theme.current.text_muted;
                        overflow: elide;
                        vertical-alignment: center;
                        accessible-role: text;
                        accessible-label: root.selected_title;
                    }
                }

                Rectangle { height: 9px; Rectangle { y: 4px; height: 1px; background: Theme.current.border_soft; } }

                if root.category_rows.length == 0: Text {
                    height: 52px;
                    text: @tr("No categories yet — add them in Settings → Categories, then come back to tag this item.");
                    color: Theme.current.text_muted;
                    font-size: 13px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }

                if root.category_rows.length > 0: ScrollView {
                    vertical-stretch: 1;
                    width: 100%;
                    // Touch devices scroll by dragging (there is no
                    // wheel): the fluent-style ScrollView disables
                    // drag-pan by default, so opt in explicitly.
                    mouse-drag-pan-enabled: true;

                    VerticalLayout {
                        spacing: 0px;
                        alignment: start;

                        // Reader's category rows: a checkbox, the name, and a
                        // tinted row while ticked.
                        for cat[i] in root.category_rows: Rectangle {
                            height: 44px;
                            border-radius: 10px;
                            // Reassigning the animated value on a master-switch change evaluates
                            // the current duration: 0ms cancels motion before it can resume later.
                            private property <color> target-background: chip_touch.has-hover ? Theme.current.control_hover : (root.modal_category_flags[i] ? Theme.current.selection_wash : transparent);
                            private property <color> state-background: self.target-background;
                            private property <bool> motion-enabled: Anim.enabled;
                            animate state-background { duration: Anim.control_state; easing: ease-in-out; }
                            changed target-background => { self.state-background = self.target-background; }
                            changed motion-enabled => { self.state-background = self.target-background; }
                            background: Anim.enabled ? self.state-background : self.target-background;
                            border-width: root.kb_active && root.kb_zone == 0 && root.kb_idx == i ? 2px : 0px;
                            border-color: Theme.current.focus_ring;
                            accessible-role: checkbox; accessible-label: cat.name;
                            accessible-checkable: true; accessible-checked: root.modal_category_flags[i];
                            accessible-action-default => { root.toggle_entry_category(cat.name); }

                            Rectangle {
                                x: 12px; y: 12px; width: 20px; height: 20px; border-radius: 5px;
                                border-width: 2px;
                                border-color: root.modal_category_flags[i] ? Theme.current.accent : Theme.current.border_strong;
                                background: root.modal_category_flags[i] ? Theme.current.accent : transparent;
                                category_check := IcCheck {
                                    private property <float> target-opacity: root.modal_category_flags[i] ? 1 : 0;
                                    private property <float> state-opacity: self.target-opacity;
                                    private property <bool> motion-enabled: Anim.enabled;
                                    animate state-opacity { duration: Anim.control_state; easing: ease-in-out; }
                                    changed target-opacity => { self.state-opacity = self.target-opacity; }
                                    changed motion-enabled => { self.state-opacity = self.target-opacity; }
                                    opacity: Anim.enabled ? self.state-opacity : self.target-opacity;
                                    x: 3px; y: 3px;
                                    width: 14px;
                                    height: 14px;
                                    fill: Theme.current.on_accent;
                                }
                            }

                            Text {
                                x: 44px; width: parent.width - 56px; height: 100%;
                                text: cat.name;
                                color: Theme.current.text_bright;
                                font-size: 14px;
                                font-weight: root.modal_category_flags[i] ? 600 : 400;
                                vertical-alignment: center;
                                overflow: elide;
                                accessible-role: none;
                            }

                            chip_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.kb_active = false;
                                    root.kb_zone = 0;
                                    root.kb_idx = i;
                                    root.toggle_entry_category(cat.name);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
