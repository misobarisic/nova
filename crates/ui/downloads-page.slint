import { Theme, Anim, ControlInput, NavMetrics, DownloadEpisode, DownloadGroup } from "@NovaUiShared";

import { ScrollView } from "scrollview.slint";
import { SearchField } from "searchfield.slint";
import { SideNav } from "sidenav.slint";
import { LibraryFilterChip } from "filter-chip.slint";
import { IcChevronDown } from "icons.slint";
import { PageHeader } from "page-header.slint";



component DownloadButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> chevron: false;
    in property <bool> expanded: false;
    callback picked();
    width: Math.max(44px, label-text.preferred-width + 20px); height: 44px;
    border-radius: Math.min(Theme.button_corner_radius, Math.min(self.width, self.height) / 2);
    background: root.selected ? Theme.current.accent : (touch.has-hover ? Theme.current.control_hover : Theme.current.control);
    accessible-role: button; accessible-label: root.label;
    label-text := Text { visible: !root.chevron; text: root.label; color: root.selected ? Theme.current.on_accent : Theme.current.text_bright; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
    if root.chevron: IcChevronDown {
        width: 24px; height: 24px;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        fill: Theme.current.text_bright;
        transform-rotation: root.expanded ? 180deg : 0deg;
        animate transform-rotation { duration: Anim.transition_fade; easing: ease-in-out; }
    }
    border-width: key-focus.has-focus ? 2px : 0px; border-color: Theme.current.focus_ring;
    key-focus := FocusScope { key-pressed(e) => { if (e.text == Key.Return || e.text == " ") { if (!e.repeat) { root.picked(); } accept } else { reject } } }
    touch := TouchArea { mouse-cursor: pointer; clicked => { key-focus.focus(); root.picked(); } }
}
component DownloadEpisodeRow inherits Rectangle {
    in property <DownloadEpisode> episode;
    in property <bool> narrow;
    callback action(string, int);
    height: 82px; background: Theme.current.artwork_canvas;
    HorizontalLayout {
        padding: 8px; spacing: 8px;
        Rectangle { width: root.narrow ? 49px : 62px; height: 30px; border-radius: 5px; background: Theme.current.control;
            Text { text: root.episode.badge; color: Theme.current.text_secondary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
        }
        VerticalLayout {
            spacing: 3px;
            Text { text: root.episode.title; color: Theme.current.text_primary; font-size: 13px; font-weight: 600; overflow: elide; }
            Text { text: root.episode.details; color: Theme.current.text_muted; font-size: 11px; overflow: elide; }
            if root.episode.state == 1: Rectangle { height: 4px; background: Theme.current.slider_track; border-radius: 2px;
                Rectangle { x: 0px; width: parent.width * root.episode.progress; height: 100%; background: Theme.current.accent; border-radius: 2px; }
            }
            if root.episode.action_kind == 4 && root.episode.state != 1: Text {
                text: root.episode.state == 2 ? @tr("Watched") : @tr("Unwatched"); color: root.episode.state == 2 ? Theme.current.accent : Theme.current.text_muted; font-size: 11px;
            }
        }
        DownloadButton { width: root.narrow ? 58px : 80px; label: root.episode.action_label; picked => { root.action(root.episode.id, 0); } }
        DownloadButton { width: 44px; label: "×"; accessible-label: @tr("Remove download"); picked => { root.action(root.episode.id, 1); } }
    }
}
component DownloadSeriesCard inherits Rectangle {
    in property <DownloadGroup> group;
    in property <bool> narrow;
    in property <bool> artwork-active;
    in property <length> viewport-top;
    in property <length> viewport-height;
    callback artwork-visible(string, bool);
    private property <bool> artwork-retained: root.artwork-active && root.viewport-height > 0px
        && self.absolute-position.y + 86px >= root.viewport-top - root.viewport-height
        && self.absolute-position.y <= root.viewport-top + 2 * root.viewport-height;
    private property <string> artwork-report: root.group.id + root.group.artwork_identity + (root.artwork-retained ? "1" : "0");
    Timer { interval: 1500ms; running: root.artwork-retained; triggered => { root.artwork-visible(root.group.id, true); } }
    changed artwork-report => { root.artwork-visible(root.group.id, root.artwork-retained); }
    init => { root.artwork-visible(root.group.id, root.artwork-retained); }
    callback toggled(string);
    callback action(string,int);
    border-radius: 10px; border-width: 1px; border-color: Theme.current.border_strong;
    background: Theme.current.artwork_canvas; clip: true;
    // Only the chevron animates; rows and card height switch immediately.
    height: 86px + (root.group.collapsed ? 0px : root.group.episodes.length * 82px);
    // Without an explicit anchor Slint centers this fixed-height child in
    // the expanded card, moving the artwork and clipping the toggle in rows.
    Rectangle { x: 0px; y: 0px; width: 100%; height: 86px; background: Theme.current.control;
        Image { source: root.group.artwork; width: 100%; height: 100%; image-fit: cover; }
        Rectangle { width: 100%; height: 100%; background: #00000090; }
        HorizontalLayout { padding: 14px; spacing: 10px;
            VerticalLayout { spacing: 5px;
                Text { vertical-stretch: 0; text: root.group.title; color: Theme.current.text_bright; font-size: 17px; font-weight: 700; overflow: elide; }
                Text { vertical-stretch: 0; text: root.group.subtitle; color: Theme.current.text_secondary; font-size: 12px; overflow: elide; }
            }
            DownloadButton { width: 44px; chevron: true; expanded: !root.group.collapsed; accessible-label: root.group.collapsed ? @tr("Expand series") : @tr("Collapse series"); picked => { root.toggled(root.group.id); } }
        }
    }
    if !root.group.collapsed: VerticalLayout {
        y: 86px; width: 100%; height: root.group.episodes.length * 82px; spacing: 0px;
        for episode in root.group.episodes: DownloadEpisodeRow { episode: episode; narrow: root.narrow; action(id,kind) => { root.action(id,kind); } }
    }
}
export component DownloadsPage inherits Rectangle {
    // Called after publication only while AppWindow retains baseline focus.
    public function focus_shell() { if root.active { page_scope.focus(); } }

    in property <bool> external_navigation: false;
    in property <bool> active: true;
    background: Theme.current.artwork_canvas;
    in property <[DownloadGroup]> groups;
    in property <[DownloadEpisode]> transfers;
    in property <string> summary;
    in property <[int]> counts;
    in-out property <string> query;
    in-out property <int> filter;
    in-out property <bool> sort_recent;
    in property <length> safe-top; in property <length> safe-left; in property <length> safe-right; in property <length> safe-bottom;
    in property <int> system_back_request;
    in-out property <bool> kb_active;
    in property <length> nav-viewport-width: root.width;
    private property <bool> narrow: root.nav-viewport-width < 700px;
    // Derive layout widths directly from the hosting viewport. Using a
    // repeated row's parent.width here would feed its intrinsic width back
    // into ScrollView's minimum width calculation.
    private property <length> content_x: root.narrow || root.external_navigation ? 0px : NavMetrics.width-for(root.nav-viewport-width);
    private property <length> available-width: root.width - root.content_x - root.safe-left - root.safe-right - 36px;
    private property <bool> scrolling_landscape: ControlInput.touch-feedback
        && root.width - root.safe-left - root.safe-right > root.height - root.safe-top - root.safe-bottom
        && root.height - root.safe-top - root.safe-bottom < 600px;
    changed scrolling_landscape => { groups-scroll.content-y = 0px; }
    private property <bool> two-columns: root.available-width > 850px;
    private property <int> columns: root.two-columns ? 2 : 1;
    private property <int> last-back;
    private property <[string]> filter-labels: [@tr("All"), @tr("Unwatched"), @tr("In progress"), @tr("Watched")];
    private property <length> selected_filter_left;
    private property <length> selected_filter_width;
    function reveal_filter(left: length, w: length) {
        root.selected_filter_left = left; root.selected_filter_width = w;
        let min_x = Math.min(0px, filter_rail.width - filter_rail.content-width);
        filter_rail.content-x = Math.max(min_x, Math.min(0px, filter_rail.content-x));
        if (left < -filter_rail.content-x) { filter_rail.content-x = -left; }
        else if (left + w > -filter_rail.content-x + filter_rail.width) {
            filter_rail.content-x = Math.max(min_x, filter_rail.width - left - w);
        }
    }
    in property <bool> artwork-active: true;
    callback artwork-visible(string, bool);
    callback artwork-active-changed(bool);
    changed artwork-active => { root.artwork-active-changed(root.artwork-active); }
    callback query_changed(string); callback filter_changed(int); callback sort_changed(bool);
    callback group_toggled(string); callback action(string,int); callback back();
    callback home_picked(); callback discover_picked(); callback library_picked(); callback settings_picked(); callback about_picked(); callback more_picked();
    changed system_back_request => { if (root.active && root.last-back != root.system_back_request) { root.last-back = root.system_back_request; root.back(); } }
    page_scope := FocusScope { enabled: root.active; width: 100%; height: 100%; init => { root.last-back = root.system_back_request; self.focus(); }
        capture-key-pressed(e) => { if (e.text == Key.Back || e.text == Key.Escape) { if (!e.repeat) { root.back(); } accept } else { reject } }
    if !root.narrow && !root.external_navigation: SideNav {
        viewport-width: root.nav-viewport-width; active: 5; safe-top: root.safe-top; safe-left: root.safe-left; safe-bottom: root.safe-bottom; kb_active <=> root.kb_active;
        home_picked => { root.home_picked(); } discover_picked => { root.discover_picked(); } library_picked => { root.library_picked(); } more_picked => { root.more_picked(); }
    }
    // Portrait and desktop retain a pinned heading. Touch landscape expands
    // this same viewport so the measured heading slot scrolls with the cards.
    groups-scroll := ScrollView {
        x: root.content_x;
        y: root.scrolling_landscape ? 0px : 18px + root.safe-top + download_header.height;
        width: root.width - self.x; height: root.height - self.y;
        content-width: self.visible-width; mouse-drag-pan-enabled: true;
        groups_body := VerticalLayout {
            width: 100%; alignment: start;
            padding: 18px; padding-left: 18px + root.safe-left;
            padding-right: 18px + root.safe-right;
            padding-bottom: 18px + root.safe-bottom;
            spacing: 14px;
            Rectangle {
                visible: root.scrolling_landscape;
                height: root.scrolling_landscape ? download_header.height + root.safe-top : 0px;
                vertical-stretch: 0;
            }
            Text { vertical-stretch: 0; text: @tr("On this device"); color: Theme.current.text_muted; font-size: 12px; }
            controls_slot := Rectangle { height: download_controls.preferred-height; vertical-stretch: 0; }
            DownloadButton { label: root.sort_recent ? @tr("Newest first") : @tr("Series & episode"); picked => { root.sort_changed(!root.sort_recent); } }
            if root.groups.length == 0: Text { vertical-stretch: 0;
                text: root.counts[0] == 0 ? @tr("Your completed downloads will appear here.") : @tr("No downloads match your search or filter.");
                color: Theme.current.text_muted; wrap: word-wrap; font-size: 15px;
            }
            for row in Math.ceil(root.groups.length / root.columns): HorizontalLayout { spacing: 12px; vertical-stretch: 0;
                DownloadSeriesCard { artwork-active: root.artwork-active; viewport-top: groups-scroll.absolute-position.y; viewport-height: groups-scroll.visible-height; artwork-visible(key, retained) => { root.artwork-visible(key, retained); } width: (root.available-width - (root.columns - 1) * 12px) / root.columns; group: root.groups[row * root.columns]; narrow: root.narrow; toggled(id) => { root.group_toggled(id); } action(id,kind) => { root.action(id,kind); } }
                if root.two-columns && row * 2 + 1 < root.groups.length: DownloadSeriesCard { artwork-active: root.artwork-active; viewport-top: groups-scroll.absolute-position.y; viewport-height: groups-scroll.visible-height; artwork-visible(key, retained) => { root.artwork-visible(key, retained); } width: (root.available-width - (root.columns - 1) * 12px) / root.columns; group: root.groups[row * 2 + 1]; narrow: false; toggled(id) => { root.group_toggled(id); } action(id,kind) => { root.action(id,kind); } }
                if root.two-columns && row * 2 + 1 >= root.groups.length: Rectangle { width: (root.available-width - 12px) / 2; }
            }
            if root.transfers.length > 0: Text { vertical-stretch: 0; text: @tr("Transfers"); color: Theme.current.text_bright; font-size: 20px; font-weight: 600; }
            for transfer in root.transfers: DownloadEpisodeRow { episode: transfer; narrow: root.narrow; action(id,kind) => { root.action(id,kind); } }
        }
    }
    download_header := PageHeader {
        x: root.content_x + 18px + root.safe-left;
        y: 18px + root.safe-top + (root.scrolling_landscape ? groups-scroll.content-y : 0px);
        width: root.available-width;
        title: @tr("Downloads"); subtitle: root.summary; narrow: root.narrow;
        back => { root.back(); }
    }
    // Independent controls preserve native text focus and horizontal chip
    // gestures during rotation. The full-width canvas also shields the safe
    // top and gutters from cards and their actions once the panel sticks.
    controls_clip := Rectangle {
        x: root.content_x; y: groups-scroll.y;
        width: groups-scroll.width; height: groups-scroll.height; clip: true;
        sticky_controls := Rectangle {
            x: 0px;
            y: root.scrolling_landscape
                ? Math.max(0px, controls_slot.absolute-position.y - controls_clip.absolute-position.y - root.safe-top)
                : controls_slot.absolute-position.y - controls_clip.absolute-position.y;
            width: controls_clip.width;
            height: download_controls.preferred-height + (root.scrolling_landscape ? root.safe-top : 0px);
            background: root.scrolling_landscape ? Theme.current.artwork_canvas : transparent;
            if root.scrolling_landscape: TouchArea { width: 100%; height: 100%; }
            download_controls := VerticalLayout {
                x: 18px + root.safe-left; y: root.scrolling_landscape ? root.safe-top : 0px;
                width: root.available-width; height: self.preferred-height; min-width: 0px;
                spacing: 14px;
                download_search := SearchField {
                    height: 44px; vertical-stretch: 0;
                    text <=> root.query; placeholder-text: @tr("Search downloaded episodes");
                    search-icon: true; roomy: true;
                    edited(value) => { root.query_changed(value); }
                }
                filter_rail := Flickable {
                    height: 44px; vertical-stretch: 0; min-width: 0px;
                    content-width: filter_chips.preferred-width;
                    content-height: self.height;
                    changed width => { root.reveal_filter(root.selected_filter_left, root.selected_filter_width); }
                    changed content-width => { root.reveal_filter(root.selected_filter_left, root.selected_filter_width); }
                    filter_chips := HorizontalLayout {
                        x: 0px; y: 0px; width: self.preferred-width;
                        spacing: 8px; alignment: start;
                        for label[index] in root.filter-labels: LibraryFilterChip {
                            label: label + " " + root.counts[index]; selected: root.filter == index;
                            touch_feedback: ControlInput.touch-feedback;
                            keyboard-focusable: true;
                            picked => { root.filter_changed(index); }
                            reveal(left, w) => { root.reveal_filter(left, w); }
                        }
                    }
                }
            }
        }
        controls_fade := Rectangle {
            visible: root.scrolling_landscape && sticky_controls.y <= 0px;
            x: 0px; y: sticky_controls.y + sticky_controls.height;
            width: controls_clip.width; height: 8px;
            background: @linear-gradient(180deg, Theme.current.artwork_canvas, transparent);
        }
    }
    }
    if !root.active: TouchArea {
        width: 100%; height: 100%;
        clicked => { }
        scroll-event(event) => { accept }
    }
}
