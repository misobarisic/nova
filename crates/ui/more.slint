import { BookmarksBridge, JournalBridge, QueueBridge, PartyBridge, RemoteBridge, InterfaceStyle, Theme, Anim, NavMetrics, NavState, SettingsStyle } from "@NovaUiShared";

import { ProfilesPage } from "profiles.slint";
import { ViewingJournalPage } from "viewing-journal.slint";
import { WatchQueuePage } from "watch-queue.slint";
import { BookmarksPage } from "bookmarks.slint";

import { ScrollView } from "scrollview.slint";
import { BottomNav } from "bottomnav.slint";
import { SideNav } from "sidenav.slint";
import { PageHeader } from "page-header.slint";
import { SettingsLink, SettingsCard } from "settings-controls.slint";

// A root page, like Settings landing, rather than a sheet over another page.
export component MorePage inherits Rectangle {
    // Called after publication only while AppWindow retains baseline focus.
    public function focus_shell() { if root.active { if BookmarksBridge.open { bookmarks_page.focus_shell(); } else if JournalBridge.open { journal_page.focus_shell(); } else if QueueBridge.open { queue_page.focus_shell(); } else if root.profiles_open { profiles_page.focus_shell(); } else if root.landing-active { nav_scope.focus(); } } }

    private property <bool> bookmarks_open: BookmarksBridge.open;
    changed bookmarks_open => {
        root.update_bookmarks_transition();
        if root.bookmarks_open { JournalBridge.open = false; QueueBridge.open = false; BookmarksBridge.opened(); }
        entry_focus.start();
    }
    private property <bool> journal_open: JournalBridge.open;
    private property <bool> queue_open: QueueBridge.open;
    changed journal_open => {
        root.update_journal_transition();
        if root.journal_open { BookmarksBridge.open = false; QueueBridge.open = false; JournalBridge.opened(); }
        entry_focus.start();
    }
    changed queue_open => {
        root.update_queue_transition();
        if root.queue_open { BookmarksBridge.open = false; JournalBridge.open = false; QueueBridge.opened(); }
        entry_focus.start();
    }
    in-out property <bool> profiles_open;
    in property <bool> profiles_require_selection;
    background: Theme.current.artwork_canvas;
    clip: true;
    private property <bool> profile-motion: !root.profiles_require_selection && Anim.enabled && Anim.transitions;
    private property <float> profile-slide: 0.0;
    animate profile-slide { duration: root.profile-motion ? Anim.transition_slide : 0ms; easing: ease-out; }
    private property <float> profile-alpha: 0.0;
    animate profile-alpha { duration: root.profile-motion ? Anim.transition_fade : 0ms; }
    // Local More destinations use the same retained push/pop motion as
    // Profiles; their logical open flags only govern input, never exit lifetime.
    private property <float> journal-slide: 0.0;
    animate journal-slide { duration: root.profile-motion ? Anim.transition_slide : 0ms; easing: ease-out; }
    private property <float> journal-alpha: 0.0;
    animate journal-alpha { duration: root.profile-motion ? Anim.transition_fade : 0ms; }
    function update_journal_transition() {
        root.journal-slide = root.journal_open ? 1.0 : 0.0;
        root.journal-alpha = root.journal_open ? 1.0 : 0.0;
    }
    private property <float> queue-slide: 0.0;
    animate queue-slide { duration: root.profile-motion ? Anim.transition_slide : 0ms; easing: ease-out; }
    private property <float> queue-alpha: 0.0;
    animate queue-alpha { duration: root.profile-motion ? Anim.transition_fade : 0ms; }
    function update_queue_transition() {
        root.queue-slide = root.queue_open ? 1.0 : 0.0;
        root.queue-alpha = root.queue_open ? 1.0 : 0.0;
    }
    private property <float> bookmarks-slide: 0.0;
    animate bookmarks-slide { duration: root.profile-motion ? Anim.transition_slide : 0ms; easing: ease-out; }
    private property <float> bookmarks-alpha: 0.0;
    animate bookmarks-alpha { duration: root.profile-motion ? Anim.transition_fade : 0ms; }
    function update_bookmarks_transition() {
        root.bookmarks-slide = root.bookmarks_open ? 1.0 : 0.0;
        root.bookmarks-alpha = root.bookmarks_open ? 1.0 : 0.0;
    }
    private property <bool> local-open: root.profiles_open || root.journal_open || root.queue_open || root.bookmarks_open;
    private property <float> local-slide: Math.max(root.profile-slide, root.journal-slide, root.queue-slide, root.bookmarks-slide);
    private property <float> local-alpha: Math.max(root.profile-alpha, root.journal-alpha, root.queue-alpha, root.bookmarks-alpha);
    private property <bool> landing-active: root.active && !root.profiles_require_selection && !root.local-open
        && (!root.profile-motion || (root.local-slide <= 0.0 && root.local-alpha <= 0.0));
    changed landing-active => { if root.landing-active { entry_focus.start(); } }
    // Write endpoints while their current duration is in force. A hidden,
    // unevaluated binding must not replay old motion when animations turn on.
    function update_profile_transition() {
        root.profile-slide = root.profiles_open ? 1.0 : 0.0;
        root.profile-alpha = root.profiles_open ? 1.0 : 0.0;
    }
    init => {
        root.update_profile_transition(); root.update_journal_transition();
        root.update_queue_transition(); root.update_bookmarks_transition();
    }
    changed profiles_open => { root.update_profile_transition(); }
    changed profile-motion => {
        if !root.profile-motion {
            root.update_profile_transition(); root.update_journal_transition();
            root.update_queue_transition(); root.update_bookmarks_transition();
        }
    }
    in property <length> safe-top;
    in property <length> safe-left;
    in property <length> safe-right;
    in property <length> safe-bottom;
    in property <length> nav-viewport-width;
    in property <bool> narrow: true;
    in property <bool> external_navigation: false;
    in-out property <length> scroll_y: 0px;
    private property <bool> restore_pending: true;
    // The destination can paint during return without taking input or focus.
    in property <bool> active: true;
    in property <int> system_back_request;
    in-out property <bool> kb_active;
    private property <bool> native_keyboard_mode: SettingsStyle.keyboard-mode;
    changed native_keyboard_mode => { if (root.active) { root.kb_active = root.native_keyboard_mode; } }
    changed kb_active => { if (root.active) { SettingsStyle.keyboard-mode = root.kb_active; } }
    private property <int> last_back: 0;
    in-out property <int> kb_zone: 1;
    in-out property <int> kb_nav: 3;
    in-out property <int> choice: 0;
    // Choice IDs stay stable when desktop shortcuts move into the rail.
    private property <int> first_choice: root.narrow ? 0 : 2;
    callback home_picked();
    callback discover_picked();
    callback library_picked();
    callback sync_picked();
    callback settings_picked();
    callback about_picked();
    callback calendar_picked();
    callback downloads_picked();
    changed system_back_request => {
        if (root.active && root.last_back != root.system_back_request) {
            root.last_back = root.system_back_request;
            if BookmarksBridge.open { bookmarks_page.go_back(); } else if JournalBridge.open { JournalBridge.open = false; } else if QueueBridge.open { QueueBridge.open = false; } else if root.profiles_open { profiles_page.go_back(); } else if root.landing-active { root.home_picked(); }
        }
    }
    restore_scroll := Timer { interval: 1ms; running: false; triggered => { self.stop(); more_scroll.content-y = root.scroll_y; root.restore_pending = false; } }
    changed narrow => {
        root.kb_nav = Math.min(root.kb_nav, root.narrow ? 3 : 5);
        root.choice = Math.max(root.first_choice, Math.min(10, root.choice));
        // Removed shortcut cards can own native focus during a resize.
        if (root.active) { entry_focus.start(); }
    }
    function reveal_choice() {
        if !root.kb_active || root.kb_zone != 1 || !root.landing-active { return; }
        if root.choice < 2 { more_scroll.content-y = 0px; return; }
        let top = root.choice == 2 ? profiles_card.y : root.choice == 3 ? sync_card.y : root.choice == 4 ? devices_card.y : root.choice == 5 ? party_card.y : root.choice == 6 ? settings_card.y : root.choice == 7 ? about_card.y : root.choice == 8 ? journal_card.y : root.choice == 9 ? queue_card.y : bookmarks_card.y;
        let h = root.choice == 2 ? profiles_card.height : root.choice == 3 ? sync_card.height : root.choice == 4 ? devices_card.height : root.choice == 5 ? party_card.height : root.choice == 6 ? settings_card.height : root.choice == 7 ? about_card.height : root.choice == 8 ? journal_card.height : root.choice == 9 ? queue_card.height : bookmarks_card.height;
        let vh = more_scroll.visible-height - (root.narrow && Theme.transparent_navbar ? 68px + root.safe-bottom : 0px);
        if top < -more_scroll.content-y { more_scroll.content-y = -top; }
        else if top + h > vh - more_scroll.content-y { more_scroll.content-y = Math.max(Math.min(0px, more_scroll.visible-height - more_scroll.content-height), vh - top - h); }
    }
    // Keep destination IDs stable while Settings and About finish the visual list.
    function move_choice(delta: int) {
        let index = root.choice <= 5 ? root.choice : root.choice == 6 ? 9 : root.choice == 7 ? 10 : root.choice - 2;
        let next = Math.max(root.first_choice, Math.min(10, index + delta));
        root.choice = next <= 5 ? next : next <= 8 ? next + 2 : next == 9 ? 6 : 7;
    }
    changed choice => {
        if (root.choice < root.first_choice || root.choice > 10) {
            root.choice = Math.max(root.first_choice, Math.min(10, root.choice));
        }
        root.reveal_choice();
    }
    entry_focus := Timer { interval: 1ms; running: false; triggered => { self.stop(); if (root.active) { root.focus_shell(); } } }
    changed active => {
        root.last_back = root.system_back_request;
        if (root.active) { entry_focus.start(); } else { entry_focus.stop(); }
    }
    nav_scope := FocusScope {
        enabled: root.landing-active;
        width: 100%; height: 100%;
        init => { root.choice = Math.max(root.first_choice, Math.min(10, root.choice)); root.last_back = root.system_back_request; if (root.active) { self.focus(); entry_focus.start(); } }
        key-pressed(e) => {
            if (e.text == Key.Back || e.text == Key.Backspace || e.text == Key.Escape) {
                if (!e.repeat) { root.home_picked(); }
                accept
            } else if (e.text == Key.UpArrow) {
                root.kb_active = true; SettingsStyle.keyboard-mode = true;
                if (root.kb_zone == 0) { root.kb_zone = 1; root.choice = 7; }
                else { root.move_choice(-1); }
                accept
            } else if (e.text == Key.DownArrow || e.text == Key.Tab) {
                root.kb_active = true; SettingsStyle.keyboard-mode = true;
                if (root.kb_zone == 1 && root.choice != 7) { root.move_choice(1); }
                else { root.kb_zone = 0; }
                accept
            } else if (e.text == Key.LeftArrow || e.text == Key.RightArrow) {
                root.kb_active = true; SettingsStyle.keyboard-mode = true;
                if (root.kb_zone == 0) { root.kb_nav = NavState.step(root.kb_nav, e.text == Key.LeftArrow ? -1 : 1, root.narrow); }
                accept
            } else if (e.text == Key.Return || e.text == " ") {
                root.kb_active = true; SettingsStyle.keyboard-mode = true;
                if (!e.repeat) {
                    if (root.kb_zone == 1) {
                        if (root.choice == 0) { root.calendar_picked(); } else if root.choice == 1 { root.downloads_picked(); } else if root.choice == 2 { root.profiles_open = true; } else if root.choice == 3 { root.sync_picked(); } else if root.choice == 4 { RemoteBridge.devices_open = true; RemoteBridge.device_refresh(); } else if root.choice == 5 { PartyBridge.page_open = true; } else if root.choice == 6 { root.settings_picked(); } else if root.choice == 7 { root.about_picked(); } else if root.choice == 8 { JournalBridge.open = true; } else if root.choice == 9 { QueueBridge.open = true; } else { BookmarksBridge.open = true; }
                    } else if (root.kb_nav == 0) { root.home_picked(); }
                    else if (root.kb_nav == 1) { root.discover_picked(); }
                    else if (root.kb_nav == 2) { root.library_picked(); }
                    else if (!root.narrow && root.kb_nav == 4) { NavState.calendar_picked(); }
                    else if (!root.narrow && root.kb_nav == 5) { NavState.downloads_picked(); }
                }
                accept
            } else { reject }
        }
    }
    // Preserve the landing scroller and its native layout while the local
    // Profiles subpage owns input, just as More's other children retain it.
    landing := Rectangle {
        visible: !root.profiles_require_selection && (!root.local-open || (root.profile-motion && (root.local-slide < 1.0 || root.local-alpha < 1.0)));
        x: root.profile-motion ? -0.28 * root.width * root.local-slide : 0px;
        opacity: root.profile-motion ? 1.0 - root.local-alpha : 1.0;
        width: 100%; height: 100%;
    VerticalLayout {
        padding-left: 18px + root.safe-left + (root.narrow || root.external_navigation ? 0px : NavMetrics.width-for(root.nav-viewport-width));
        padding-right: 18px + root.safe-right;
        padding-top: 18px + root.safe-top;
        padding-bottom: root.external_navigation && root.narrow && !Theme.transparent_navbar ? 68px + root.safe-bottom : 0px;
        spacing: 0px;
        more_scroll := ScrollView {
            init => { restore_scroll.start(); }
            changed content-y => { if (!root.restore_pending) { root.scroll_y = self.content-y; } }
            vertical-stretch: 1;
            mouse-drag-pan-enabled: true;
            content-width: self.visible-width;
            VerticalLayout {
                width: 100%; spacing: 12px;
                padding-bottom: root.narrow && Theme.transparent_navbar ? 68px + root.safe-bottom : 0px;
                PageHeader { title: @tr("More"); narrow: root.narrow; show-back: root.narrow; back => { if (root.landing-active) { root.home_picked(); } } }
                if root.narrow: SettingsCard { SettingsLink { interactive: root.landing-active; destination-id: "more:calendar"; icon: @image-url("../../assets/icons/menus/calendar.svg"); title: @tr("Calendar"); subtitle: @tr("Upcoming episodes from your library"); focused: root.kb_active && root.kb_zone == 1 && root.choice == 0; picked => { if InterfaceStyle.tv { root.choice = 0; root.kb_zone = 1; } root.calendar_picked(); } } }
                if root.narrow: SettingsCard { SettingsLink { interactive: root.landing-active; destination-id: "more:downloads"; icon: @image-url("../../assets/icons/menus/download.svg"); title: @tr("Downloads"); subtitle: @tr("Watch your saved episodes"); focused: root.kb_active && root.kb_zone == 1 && root.choice == 1; picked => { if InterfaceStyle.tv { root.choice = 1; root.kb_zone = 1; } root.downloads_picked(); } } }
                profiles_card := SettingsCard { SettingsLink {
                    interactive: root.landing-active; destination-id: "more:profiles"; icon: @image-url("../../assets/icons/menus/profiles.svg");
                    title: @tr("Profiles"); subtitle: @tr("Separate libraries, history and preferences");
                    focused: root.kb_active && root.kb_zone == 1 && root.choice == 2;
                    picked => { root.choice = 2; root.kb_zone = 1; root.profiles_open = true; }
                } }
                sync_card := SettingsCard { SettingsLink {
                    interactive: root.landing-active; destination-id: "more:sync";
                    icon: @image-url("../../assets/icons/menus/sync.svg");
                    title: @tr("Sync"); subtitle: @tr("Pair devices and sync all profiles");
                    focused: root.kb_active && root.kb_zone == 1 && root.choice == 3;
                    picked => { root.choice = 3; root.kb_zone = 1; root.sync_picked(); }
                } }
                devices_card := SettingsCard { SettingsLink {
                    interactive: root.landing-active; destination-id: "more:devices"; icon: @image-url("../../assets/icons/menus/devices.svg");
                    title: @tr("Devices"); subtitle: @tr("Control playback on your paired devices");
                    focused: root.kb_active && root.kb_zone == 1 && root.choice == 4;
                    picked => { if InterfaceStyle.tv { root.choice = 4; root.kb_zone = 1; } RemoteBridge.devices_open = true; RemoteBridge.device_refresh(); }
                } }
                party_card := SettingsCard { SettingsLink {
                    interactive: root.landing-active; destination-id: "more:party"; icon: @image-url("../../assets/icons/menus/watch-party.svg");
                    title: @tr("Watch party"); subtitle: @tr("Watch together on your own devices");
                    focused: root.kb_active && root.kb_zone == 1 && root.choice == 5;
                    picked => { if InterfaceStyle.tv { root.choice = 5; root.kb_zone = 1; } PartyBridge.page_open = true; }
                } }
                journal_card := SettingsCard { SettingsLink {
                    interactive: root.landing-active; destination-id: "more:journal";
                    icon: @image-url("../../assets/icons/menus/journal.svg");
                    title: @tr("Stats"); subtitle: @tr("Dated sessions, rewatches and your year in stories");
                    focused: root.kb_active && root.kb_zone == 1 && root.choice == 8;
                    picked => { root.choice = 8; root.kb_zone = 1; JournalBridge.open = true; }
                } }
                queue_card := SettingsCard { SettingsLink {
                    interactive: root.landing-active; destination-id: "more:queue";
                    icon: @image-url("../../assets/icons/menus/queue.svg");
                    title: @tr("Watch queue"); subtitle: @tr("Line up tonight's movies and episodes");
                    focused: root.kb_active && root.kb_zone == 1 && root.choice == 9;
                    picked => { root.choice = 9; root.kb_zone = 1; QueueBridge.open = true; }
                } }
                bookmarks_card := SettingsCard { SettingsLink {
                    interactive: root.landing-active; destination-id: "more:bookmarks";
                    icon: @image-url("../../assets/icons/menus/bookmarks.svg");
                    title: @tr("Bookmarks"); subtitle: @tr("Return to saved scenes and notes");
                    focused: root.kb_active && root.kb_zone == 1 && root.choice == 10;
                    picked => { root.choice = 10; root.kb_zone = 1; BookmarksBridge.open = true; }
                } }
                settings_card := SettingsCard { SettingsLink {
                    interactive: root.landing-active; destination-id: "more:settings";
                    icon: @image-url("../../assets/icons/menus/settings.svg");
                    title: @tr("Settings"); subtitle: @tr("Make Nova yours");
                    focused: root.kb_active && root.kb_zone == 1 && root.choice == 6;
                    picked => { if InterfaceStyle.tv { root.choice = 6; root.kb_zone = 1; } root.settings_picked(); }
                } }
                about_card := SettingsCard { SettingsLink {
                    interactive: root.landing-active; destination-id: "more:about";
                    icon: @image-url("../../assets/icons/menus/about.svg");
                    title: @tr("About"); subtitle: @tr("Information about Nova");
                    focused: root.kb_active && root.kb_zone == 1 && root.choice == 7;
                    picked => { if InterfaceStyle.tv { root.choice = 7; root.kb_zone = 1; } root.about_picked(); }
                } }
                Rectangle { vertical-stretch: 1; }
            }
        }
        if root.narrow && !root.external_navigation: BottomNav {
            active: 3;
            safe-bottom: root.safe-bottom; safe-left: root.safe-left; safe-right: root.safe-right;
            page-inset-left: 18px + root.safe-left; page-inset-right: 18px + root.safe-right;
            kb_zone: root.kb_zone; kb_nav: root.kb_nav; kb_active <=> root.kb_active;
            home_picked => { if (root.active) { root.home_picked(); } }
            discover_picked => { if (root.active) { root.discover_picked(); } }
            library_picked => { if (root.active) { root.library_picked(); } }
        }
    }
    }
    profiles_page := ProfilesPage {
        visible: root.profiles_open || (root.profile-motion && (root.profile-slide > 0.0 || root.profile-alpha > 0.0));
        x: root.profile-motion ? root.width * (1.0 - root.profile-slide) : 0px;
        opacity: root.profile-motion ? root.profile-alpha : 1.0;
        active: root.active && root.profiles_open;
        width: 100%; height: 100%;
        safe-top: root.safe-top;
        safe-bottom: root.safe-bottom + (root.external_navigation && root.narrow && !root.profiles_require_selection ? 68px : 0px);
        safe-left: root.safe-left + (!root.narrow && !root.external_navigation ? NavMetrics.width-for(root.nav-viewport-width) : 0px);
        safe-right: root.safe-right;
        back => { if !root.profiles_require_selection { root.profiles_open = false; entry_focus.start(); } }
    }
    journal_page := ViewingJournalPage {
        visible: !root.profiles_require_selection && (JournalBridge.open || (root.profile-motion && (root.journal-slide > 0.0 || root.journal-alpha > 0.0)));
        x: root.profile-motion ? root.width * (1.0 - root.journal-slide) : 0px;
        opacity: root.profile-motion ? root.journal-alpha : 1.0;
        active: root.active && JournalBridge.open && !root.profiles_require_selection;
        width: 100%; height: 100%; narrow: root.narrow;
        safe-top: root.safe-top;
        safe-bottom: root.safe-bottom + (root.external_navigation && root.narrow ? 68px : 0px);
        safe-left: root.safe-left + (!root.narrow && !root.external_navigation ? NavMetrics.width-for(root.nav-viewport-width) : 0px);
        safe-right: root.safe-right;
        back => { JournalBridge.open = false; entry_focus.start(); }
    }
    queue_page := WatchQueuePage {
        visible: !root.profiles_require_selection && (QueueBridge.open || (root.profile-motion && (root.queue-slide > 0.0 || root.queue-alpha > 0.0)));
        x: root.profile-motion ? root.width * (1.0 - root.queue-slide) : 0px;
        opacity: root.profile-motion ? root.queue-alpha : 1.0;
        active: root.active && QueueBridge.open && !root.profiles_require_selection;
        width: 100%; height: 100%; narrow: root.narrow;
        safe-top: root.safe-top;
        safe-bottom: root.safe-bottom + (root.external_navigation && root.narrow ? 68px : 0px);
        safe-left: root.safe-left + (!root.narrow && !root.external_navigation ? NavMetrics.width-for(root.nav-viewport-width) : 0px);
        safe-right: root.safe-right;
        back => { QueueBridge.open = false; entry_focus.start(); }
    }
    bookmarks_page := BookmarksPage {
        visible: !root.profiles_require_selection && (BookmarksBridge.open || (root.profile-motion && (root.bookmarks-slide > 0.0 || root.bookmarks-alpha > 0.0)));
        x: root.profile-motion ? root.width * (1.0 - root.bookmarks-slide) : 0px;
        opacity: root.profile-motion ? root.bookmarks-alpha : 1.0;
        active: root.active && BookmarksBridge.open && !root.profiles_require_selection;
        width: 100%; height: 100%; narrow: root.narrow;
        safe-top: root.safe-top;
        safe-bottom: root.safe-bottom + (root.external_navigation && root.narrow ? 68px : 0px);
        safe-left: root.safe-left + (!root.narrow && !root.external_navigation ? NavMetrics.width-for(root.nav-viewport-width) : 0px);
        safe-right: root.safe-right;
        back => { BookmarksBridge.open = false; entry_focus.start(); }
    }
    if !root.narrow && !root.external_navigation && !root.profiles_require_selection: SideNav {
        viewport-width: root.nav-viewport-width;
        active: 3;
        safe-top: root.safe-top;
        safe-left: root.safe-left;
        safe-bottom: root.safe-bottom;
        kb_zone: root.kb_zone;
        kb_nav: root.kb_nav;
        kb_active <=> root.kb_active;
        home_picked => { if (root.active) { root.home_picked(); } }
        discover_picked => { if (root.active) { root.discover_picked(); } }
        library_picked => { if (root.active) { root.library_picked(); } }
        more_picked => { }
    }
    if !root.active: TouchArea {
        width: 100%; height: 100%;
        clicked => { }
        scroll-event(event) => { accept }
    }
}
