import { MoreBridge } from "@NovaUiShared";

// Backend aliases live in CollectionBindings, outside this conditional host.
export component MoreHost inherits Rectangle {
    preferred-width: 100%; preferred-height: 100%;
    in-out property <bool> external_navigation <=> MoreBridge.external_navigation;
    in-out property <bool> active <=> MoreBridge.active;
    in-out property <bool> narrow <=> MoreBridge.narrow;
    in-out property <length> nav-viewport-width <=> MoreBridge.nav-viewport-width;
    in-out property <length> safe-top <=> MoreBridge.safe-top;
    in-out property <length> safe-bottom <=> MoreBridge.safe-bottom;
    in-out property <length> safe-left <=> MoreBridge.safe-left;
    in-out property <length> safe-right <=> MoreBridge.safe-right;
    in-out property <int> system_back_request <=> MoreBridge.system_back_request;
    in-out property <length> viewport_width <=> MoreBridge.viewport_width;
    in-out property <length> viewport_height <=> MoreBridge.viewport_height;
    ComponentContainer { width: 100%; height: 100%; component-factory: MoreBridge.factory; }
}
