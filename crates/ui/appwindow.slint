// AppWindow owns every property / callback the backend drives (all the
// `set_*`, `get_*`, `on_*` and `invoke_*` calls in src/app/) and
// forwards them into the per-screen components below. The screen switching
// guards live here so each page component stays self-contained.
export component AppWindow inherits Window {
    in-out property <bool> casting_open <=> CastBridge.open;
    property <bool> casting_visual_retained;
    changed casting_open => { if root.casting_open { root.casting_visual_retained = true; } else { root.restart_osd_hide(); } }
    in-out property <bool> completion_prompt_open <=> CompletionBridge.open;
    in-out property <string> completion_prompt_token <=> CompletionBridge.token;
    in-out property <string> completion_prompt_title <=> CompletionBridge.title;
    in-out property <string> completion_prompt_subtitle <=> CompletionBridge.subtitle;
    in-out property <string> completion_prompt_error <=> CompletionBridge.error;
    in-out property <image> completion_prompt_poster <=> CompletionBridge.poster;
    in-out property <[CompletionDestination]> completion_prompt_destinations <=> CompletionBridge.destinations;
    in-out property <bool> completion_prompt_can_save <=> CompletionBridge.can_save;
    // Detail is a normal route despite its historical modal_visible name.
    // Hide the draft behind active tasks and restore it when they finish.
    out property <bool> completion_prompt_visible: root.completion_prompt_open && root.completion_rating_prompts_enabled
        && !root.player_open && !root.stream_selector_open && !root.onboarding_visible
        && !root.party_page_open && !root.remote_controls_open && !root.remote_devices_open
        && root.remote_replacement_token == "" && !root.resume_prompt_visible
        && !root.categories_modal && !root.library_duplicates_open
        && !root.show_settings && !SettingsSync.open
        && !SettingsContent.sync_remove_prompt_visible && !SettingsContent.tracking_reset_confirm
        && !SettingsBridge.sync_pair_prompt_visible && !SettingsBridge.addon_config_open
        && !DetailContent.entry_editing && !DetailContent.entry_history_confirm && !DetailContent.entry_unlink_confirm;
    changed completion_prompt_visible => {
        // The mounted dialog owns entry focus. Recover the persistent scope
        // only after it disappears; deferred page focus would steal its keys.
        if !root.completion_prompt_visible {
            root.preserve_back_focus();
            page_release_timer.start();
        }
    }
    callback completion_score_changed(string, string, string);
    callback completion_save(string);
    callback completion_dismiss(string);
    public function completion_bridge_score_changed(token: string, id: string, score: string) { root.completion_score_changed(token, id, score); }
    public function completion_bridge_save(token: string) { root.completion_save(token); }
    public function completion_bridge_dismiss(token: string) { root.completion_dismiss(token); }
    in-out property <bool> completion_rating_prompts_enabled <=> SettingsBridge.completion_rating_prompts_enabled;

    in-out property <bool> party_page_open <=> PartyBridge.page_open;
    changed party_page_open => {
        if root.party_page_open && root.more_open { root.more_choice = 5; root.route_page(9, true); }
        if !root.party_page_open && root.more_service_route == 9 && !root.more_return_pending {
            root.cancel_more_subpage_back(); root.more_service_route = 0; root.more_parent = false; root.more_open = true;
        }
        if !root.party_page_open && root.player_open && !root.onboarding_visible {
            root.preserve_back_focus();
            page_release_timer.start();
        }
    }
    in-out property <bool> party_active <=> PartyBridge.active;
    in-out property <bool> party_is_host <=> PartyBridge.is_host;
    in-out property <bool> party_can_host <=> PartyBridge.can_host;
    in-out property <bool> party_has_media <=> PartyBridge.has_media;
    in-out property <bool> party_can_return_to_player <=> PartyBridge.can_return_to_player;
    in-out property <bool> party_busy <=> PartyBridge.busy;
    in-out property <bool> party_waiting <=> PartyBridge.waiting;
    in-out property <bool> party_paused <=> PartyBridge.paused;
    in-out property <string> party_title <=> PartyBridge.title;
