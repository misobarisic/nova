            } else if InterfaceStyle.tv && root.resume_prompt_visible {
                if e.text == Key.Escape || e.text == Key.Back || e.text == Key.Backspace {
                    if !e.repeat { root.resume_cancel(); }
                } else if e.text == Key.LeftArrow || e.text == Key.UpArrow { root.resume_focus = 0; }
                else if e.text == Key.RightArrow || e.text == Key.DownArrow { root.resume_focus = 1; }
                else if e.text == Key.Return && !e.repeat { root.resume_choice(root.resume_focus == 1); }
                accept
            } else
            if (!root.player_open && (e.text == "\u{e100}" || e.text == "\u{e101}" || e.text == "\u{e102}" || e.text == "\u{e103}" || e.text == "\u{e104}" || e.text == "\u{e105}" || e.text == "\u{e106}" || e.text == "\u{e107}")) {
                // Transport events must never insert private-use characters in editors.
