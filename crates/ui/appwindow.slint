        if (root.more_return_pending) { return; }
        // Reverse the visible entry frame, including its independent fade.
        // Return bindings are lazy and unused outside the exiting branch.
        // Sample their zero-duration reset while pending is still false: an
        // unobserved completed return must not carry its old 1.0 into this one.
        root.more_return_start = root.more_subpage_motion ? root.more_entry_progress * (1.0 - root.more_return_progress) : 1.0;
        root.more_return_alpha_start = root.more_subpage_motion ? root.more_entry_alpha * (1.0 - root.more_return_alpha) : 1.0;
        more_entry_tick.stop();
        root.more_return_generation = root.more_route_generation;
        root.more_return_pending = true;
        root.more_subpage_exiting = true;
        if (Anim.enabled && Anim.transitions) { more_return_tick.start(); }
        else { root.finish_more_subpage_back(); }
    }
