    property <int> back_focus_request: 0;
    changed back_focus_request => { system_back_scope.focus(); }
    // Factory construction temporarily blocks focus changes. Recover native
    // keyboard navigation after publication only while the persistent scope
    // still owns focus, so a pointer-focused editor is never interrupted.
    public function focus_mounted_page() {
        // The wizard retains the underlying page visually. Its Rust callback
        // excludes inputs already owned by the wizard before recovering focus
        // from that underlying page, rather than relying on baseline ownership.
        if root.onboarding_visible { OnboardingBridge.focus_shell(); return; }
        if !system_back_scope.has-focus { return; }
        if root.player_open { PlayerOsdBridge.focus_shell(); }
        else if root.detail_page_mounted { root.focus_mounted_detail(); }
        else if root.settings_page_mounted && !root.more_return_pending { SettingsBridge.focus_shell(); }
        else if root.about_page_mounted && !root.more_return_pending { AboutBridge.focus_shell(); }
        else if root.calendar_page_mounted && !root.more_return_pending { CalendarBridge.focus_shell(); }
        else if root.downloads_page_mounted && !root.more_return_pending { DownloadsBridge.focus_shell(); }
        else if root.more_open { MoreBridge.focus_shell(); }
        else if root.library_page_mounted { LibraryBridge.focus_shell(); }
        else if root.home_page_mounted { HomeBridge.focus_shell(); }
        else if root.discover_page_mounted { DiscoverBridge.focus_shell(); }
    }
    public function focus_mounted_detail() {
        if system_back_scope.has-focus && root.detail_page_mounted && !root.categories_modal && !root.library_duplicates_open {
            if root.stream_selector_open { DetailContent.focus_streams(); }
            else if root.tracking_open { DetailContent.focus_tracking(); }
            else { DetailContent.focus_shell(); }
        }
    }
    public function preserve_back_focus() {
        // Incoming page init can replace focus before outgoing page teardown.
        // The change handler runs after tree instantiation, keeping release and
        // held-repeat events on a scope that survives the transition.
        system_back_scope.focus();
        root.back_focus_request += 1;
    }
