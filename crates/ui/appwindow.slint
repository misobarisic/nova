    // Android delivers Back as a key event, but focused inputs and page-local
    // scopes can reject or consume it before the active screen handles it.
    // Capture it at the shared window layer; separate PopupWindows (such as
    // Dropdown) install their own capture handler.
    system_back_scope := FocusScope {
        visible: !root.android_pip_active;
        init => { self.focus(); }
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;

        capture-key-pressed(e) => {
            if root.casting_visual_retained && !CastBridge.open { if e.text == Key.Back { root.system_back_held = true; } accept }
            else if CastBridge.open {
                if e.text == Key.Back || e.text == Key.Escape { if !e.repeat && !root.system_back_held { root.system_back_held = true; CastBridge.back_request += 1; } accept } else { reject }
            } else if MoreBridge.pin_open {
                if e.text == Key.Back || e.text == Key.Escape {
                    if !e.repeat { MoreBridge.pin_cancel(); root.preserve_back_focus(); page_release_timer.start(); } accept
                } else { reject }
            } else if MoreBridge.policy_open {
                if e.text == Key.Back || e.text == Key.Escape {
                    if !e.repeat { MoreBridge.management_closed(); root.preserve_back_focus(); page_release_timer.start(); } accept
                } else { reject }
            } else if OfflineBridge.opened && (e.text == Key.Back || e.text == Key.Escape) {
                if !e.repeat {OfflineBridge.closed();root.preserve_back_focus();page_release_timer.start();}accept
            } else if BackupBridge.open && !MoreBridge.pin_open && !MoreBridge.policy_open && (e.text == Key.Back || e.text == Key.Escape || e.text == Key.Backspace) {
                if !e.repeat && !BackupBridge.busy {
                    if BackupBridge.recovery_confirmation { BackupBridge.cancel_delete_recovery(); }
                    else { BackupBridge.closed(); }
                } accept
            }
            else if root.backup_visual_retained && !root.backup_open { accept }
            else if CatalogGroupingBridge.chooser_visual_retained && !CatalogGroupingBridge.chooser_open { if e.text == Key.Back { root.system_back_held = true; } accept }
            else if CatalogGroupingBridge.chooser_open && (e.text == Key.Back || e.text == Key.Escape || e.text == Key.Backspace) {
