    public function navigate_section(index: int) { root.route_section(index, false); }
    function route_section(index: int, from_more: bool) {
        if root.profiles_require_selection { return; }
        if (index == 3) { root.open_more(); }
        else { root.route_page(index, from_more); }
    }
    // Back's direct Home route uses this leaf helper. Keeping More dispatch
    // outside it avoids a static recursion cycle in Slint's binding analysis.
    function route_page(index: int, from_more: bool) {
        if root.profiles_require_selection { return; }
        root.profiles_open = false;
        SmartCollectionsBridge.editor_open = false;
        SettingsSync.open = false;
        JournalBridge.open = false; QueueBridge.open = false; BookmarksBridge.open = false;
        let previous_nav = root.more_open || root.more_return_pending || root.show_settings || root.show_about ? 3 : root.show_calendar ? 4 : root.show_downloads ? 5 : root.show_home ? 0 : root.show_library ? 2 : 1;
        root.preserve_back_focus();
        root.cancel_more_subpage_back();
        root.more_parent = from_more;
        root.more_service_route = from_more && (index == 8 || index == 9) ? index : 0;
        root.sync_page = index == 10;
        root.more_open = false;
        root.more_subpage_entered = !from_more;
        if (from_more) {
            // Establish the entry baseline before the timer enables motion,
            // even when its first painted frame arrives after that timer.
            root.more_return_start = root.more_entry_progress;
            root.more_return_alpha_start = root.more_entry_alpha;
        }
        root.discover_search_focused = false;
        root.family_nav_zone = index == 6 ? (root.narrow_ui ? 8 : 0) : 1;
        root.family_nav_index = index == 4 ? 4 : index == 5 ? 5 : 3;
        root.show_home = index == 0;
        root.show_library = index == 2;
        root.show_settings = index == 6 || index == 10;
        root.show_about = index == 7;
        root.show_calendar = index == 4;
        root.show_downloads = index == 5;
        root.remote_devices_open = index == 8;
        root.party_page_open = index == 9;
        if (index == 0) { root.home_picked(); }
        else if (index == 1) { root.discover_picked(); }
        else if (index == 2) { root.library_picked(); }
        else if (index == 4) { root.calendar_picked(); }
        else if (index == 5) { root.downloads_picked(); }
        else if (index == 6 || index == 10) { root.settings_picked(); }
        else if (index == 7) { root.about_picked(); }
        // Backend callbacks can publish their own previous flags; this route
        // owns the actual visible origin for rebuilt navigation feedback.
        NavState.from = previous_nav;
        if (from_more) { more_entry_tick.start(); }
    }
    function open_more() {
        if root.profiles_require_selection { return; }
        root.profiles_open = false;
        if (root.player_open || root.modal_visible) { return; }
        if (root.more_parent) { root.more_subpage_back(); }
        else {
            root.preserve_back_focus();
            root.cancel_more_subpage_back();
            root.more_parent = false;
            root.discover_search_focused = false;
            root.more_open = true;
        }
    }
    function pick_more(index: int) { root.more_choice = index; root.more_focus_zone = 1; root.route_section(index == 0 ? 4 : index == 1 ? 5 : index == 3 ? 10 : index == 6 ? 6 : 7, true); }
    function finish_more_subpage_back() {
        if root.profiles_require_selection { return; }
        if (!root.more_return_pending || root.more_return_generation != root.more_route_generation || !root.more_parent || root.player_open || root.modal_visible) { return; }
        root.more_return_pending = false;
        root.more_subpage_exiting = false;
        root.show_settings = false;
        root.show_calendar = false;
        root.show_downloads = false;
        root.show_about = false;
        root.show_home = false;
        root.show_library = false;
        root.remote_devices_open = false;
        root.party_page_open = false;
        root.more_parent = false;
        root.more_open = true;
    }
    function cancel_more_subpage_back() {
        more_entry_tick.stop(); more_return_tick.stop();
        root.more_route_generation += 1;
        root.more_return_pending = false;
        root.more_subpage_exiting = false;
    }
    function more_subpage_back() {
        if root.profiles_require_selection { return; }
        root.preserve_back_focus();
        if (!root.more_parent) { root.route_page(0, false); return; }
        if (root.more_return_pending) { return; }
        // Reverse the visible entry frame, including its independent fade.
        // Return bindings are lazy and unused outside the exiting branch.
        // Sample their zero-duration reset while pending is still false: an
        // unobserved completed return must not carry its old 1.0 into this one.
        root.more_return_start = root.more_subpage_motion ? root.more_entry_progress * (1.0 - root.more_return_progress) : 1.0;
        root.more_return_alpha_start = root.more_subpage_motion ? root.more_entry_alpha * (1.0 - root.more_return_alpha) : 1.0;
        more_entry_tick.stop();
        root.more_return_generation = root.more_route_generation;
        root.more_return_pending = true;
        root.more_subpage_exiting = true;
        if (Anim.enabled && Anim.transitions) { more_return_tick.start(); }
        else { root.finish_more_subpage_back(); }
    }
