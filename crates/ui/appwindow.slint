    public function set_card_poster(idx: int, img: image) {
        // Guard against stale indices (an in-flight poster fetch landing
        // after the model shrank): an out-of-range write would panic.
        if (idx < 0 || idx >= root.catalog.length) { return; }
        root.catalog[idx].poster = img;
        root.catalog[idx].is_loaded = true;
    }
    // Unload a card poster outside the visible window (frees CPU pixels +
    // GPU texture); the card shows its placeholder until it scrolls back
    // into view and the poster is re-fetched.
    public function clear_card_poster(idx: int, img: image) {
        if (idx < 0 || idx >= root.catalog.length) { return; }
        root.catalog[idx].poster = img;
        root.catalog[idx].is_loaded = false;
    }
    public function set_search_card_poster(idx: int, img: image) {
        if (idx < 0 || idx >= root.search_results.length) { return; }
        root.search_results[idx].poster = img;
        root.search_results[idx].is_loaded = true;
    }
    public function clear_search_card_poster(idx: int, img: image) {
        if (idx < 0 || idx >= root.search_results.length) { return; }
        root.search_results[idx].poster = img;
        root.search_results[idx].is_loaded = false;
    }
    public function set_library_poster(idx: int, img: image) {
        if (idx < 0 || idx >= root.library.length) { return; }
        root.library[idx].poster = img;
        root.library[idx].is_loaded = true;
    }
    public function clear_library_poster(idx: int, img: image) {
        if (idx < 0 || idx >= root.library.length) { return; }
        root.library[idx].poster = img;
        root.library[idx].is_loaded = false;
    }

