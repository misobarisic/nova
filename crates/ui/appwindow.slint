    private property <bool> remote_controls_motion: Anim.enabled && Anim.transitions;
    private property <float> remote_controls_slide: 0.0;
    animate remote_controls_slide { duration: root.remote_controls_motion ? Anim.transition_slide : 0ms; easing: ease-out; }
    private property <float> remote_controls_alpha: 0.0;
    animate remote_controls_alpha { duration: root.remote_controls_motion ? Anim.transition_fade : 0ms; }
    function finish_remote_controls_exit() {
        remote_controls_done.stop();
        if !root.remote_controls_open && root.remote_controls_visual_retained {
            root.remote_controls_visual_retained = false;
            RemoteBridge.menu_page = "";
            RemoteBridge.track_picker = 0;
            RemoteBridge.controls_visual_closed();
        }
    }
    changed remote_controls_motion => {
        if !root.remote_controls_motion {
            root.remote_controls_slide = root.remote_controls_open ? 1.0 : 0.0;
            root.remote_controls_alpha = root.remote_controls_open ? 1.0 : 0.0;
            root.finish_remote_controls_exit();
        }
    }
    remote_controls_done := Timer {
        interval: Math.max(Anim.transition_slide, Anim.transition_fade); running: false;
        triggered => { root.finish_remote_controls_exit(); }
    }
    changed remote_controls_open => {
        remote_controls_done.stop();
        if root.remote_controls_open {
            root.remote_controls_visual_retained = true;
            root.remote_controls_slide = 1.0; root.remote_controls_alpha = 1.0;
        } else {
            root.remote_controls_slide = 0.0; root.remote_controls_alpha = 0.0;
            if root.remote_controls_visual_retained && root.remote_controls_motion { remote_controls_done.start(); }
            else { root.finish_remote_controls_exit(); }
        }
        if !root.remote_controls_open && RemoteBridge.speed_preview_token != "" {
            let token = RemoteBridge.speed_preview_token;
            RemoteBridge.speed_preview_token = "";
            root.remote_action("speed_preview_end", 0, token);
        }
    }
    callback remote_action(string, float, string);
    callback remote_semantic_action(string, float, string, string, string);
    callback remote_controls_visual_closed();
