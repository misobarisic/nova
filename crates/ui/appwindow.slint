// AppWindow owns every property / callback the backend drives (all the
// `set_*`, `get_*`, `on_*` and `invoke_*` calls in src/app/) and
// forwards them into the per-screen components below. The screen switching
// guards live here so each page component stays self-contained.
export component AppWindow inherits Window {
    public function player_bridge_next_episode_streams(t: string) { root.next_episode_streams(t); }
    public function player_bridge_next_episode_dismiss(t: string) { root.next_episode_dismiss(t); }
    public function player_bridge_restore_playback_default(control: int) { root.restore_playback_default(control); }
    public function player_bridge_osd_opacity_changed(v: float) { root.osd_opacity = v; }
    public function player_bridge_toggle_pause() { root.toggle_pause(); }
