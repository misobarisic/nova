        TouchArea {
            width: 100%; height: 100%;
            clicked => { root.resume_cancel(); }
        }
        Rectangle {
            width: Math.min(360px, parent.width - 40px);
            height: 176px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #262626; border-radius: 14px;
            // Consume clicks inside the card instead of passing them to the
            // outside-click dismiss layer underneath.
            TouchArea { width: 100%; height: 100%; }
            VerticalLayout {
                padding: 20px; spacing: 12px;
                Text { text: @tr("Resume playback?"); color: #ffffff; font-size: 18px; font-weight: 600; }
                Text { text: @tr("This episode has saved playback history."); color: #b8b8be; font-size: 14px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end; spacing: 8px;
                    Rectangle {
                        width: 112px; height: 40px; border-radius: 8px; background: #ffffff18;
                        Text { text: @tr("Start over"); color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { width: 100%; height: 100%; clicked => { root.resume_choice(false); } }
                    }
                    Rectangle {
                        width: 100px; height: 40px; border-radius: 8px; background: #8b5cf6;
                        Text { text: @tr("Resume"); color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { width: 100%; height: 100%; clicked => { root.resume_choice(true); } }
                    }
                }
            }
        }
    }
}
