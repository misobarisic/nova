    property <int> profile_pin_focus_request;
    property <int> profile_policy_focus_request;
    property <int> backup_focus_request;
    // Data is a Settings submenu even though its management flow lives above
    // the compiled shell. Keep the outgoing surface until push/pop completes.
    private property <bool> backup_open: BackupBridge.open;
    private property <bool> backup_visual_retained: false;
    private property <bool> backup_motion: Anim.enabled && Anim.transitions;
    private property <float> backup_slide: 0.0;
    animate backup_slide { duration: root.backup_motion ? Anim.transition_slide : 0ms; easing: ease-out; }
    private property <float> backup_alpha: 0.0;
    animate backup_alpha { duration: root.backup_motion ? Anim.transition_fade : 0ms; }
    function finish_backup_exit() {
        backup_exit_tick.stop();
        if !root.backup_open && root.backup_visual_retained {
            root.backup_visual_retained = false;
            root.preserve_back_focus();
            root.focus_mounted_page();
        }
    }
    changed backup_open => {
        backup_entry_tick.stop(); backup_exit_tick.stop();
        if root.backup_open {
            root.backup_visual_retained = true;
            if root.backup_motion { backup_entry_tick.start(); }
            else { root.backup_slide = 1.0; root.backup_alpha = 1.0; }
        } else {
            root.preserve_back_focus();
            root.backup_slide = 0.0; root.backup_alpha = 0.0;
            if root.backup_visual_retained && root.backup_motion { backup_exit_tick.start(); }
            else { root.finish_backup_exit(); }
        }
    }
    changed backup_motion => {
        if !root.backup_motion {
            backup_entry_tick.stop();
            root.backup_slide = root.backup_open ? 1.0 : 0.0;
            root.backup_alpha = root.backup_open ? 1.0 : 0.0;
            root.finish_backup_exit();
        }
    }
    backup_entry_tick := Timer {
        interval: 1ms; running: false;
        triggered => { self.stop(); if root.backup_open { root.backup_slide = 1.0; root.backup_alpha = 1.0; } }
    }
    backup_exit_tick := Timer {
        interval: Math.max(Anim.transition_slide, Anim.transition_fade); running: false;
        triggered => { root.finish_backup_exit(); }
    }
    property <int> back_focus_request: 0;
    changed back_focus_request => {
        if MoreBridge.pin_open { root.profile_pin_focus_request += 1; }
        else if MoreBridge.policy_open { root.profile_policy_focus_request += 1; }
        else if BackupBridge.open { root.backup_focus_request += 1; }
        else if !root.completion_prompt_visible && !root.playback_end_menu_shown { system_back_scope.focus(); }
    }
    // Factory construction temporarily blocks focus changes. Recover native
    // keyboard navigation after publication only while the persistent scope
    // still owns focus, so a pointer-focused editor is never interrupted.
    public function focus_mounted_page() {
        if MoreBridge.pin_open { root.profile_pin_focus_request += 1; return; }
        if MoreBridge.policy_open { if system_back_scope.has-focus { root.profile_policy_focus_request += 1; } return; }
        if BackupBridge.open { if system_back_scope.has-focus { root.backup_focus_request += 1; } return; }
        if root.backup_visual_retained { return; }
        // The wizard retains the underlying page visually. Its Rust callback
        // excludes inputs already owned by the wizard before recovering focus
        // from that underlying page, rather than relying on baseline ownership.
        if root.completion_prompt_visible { return; }
        if root.playback_end_menu_shown { playback_ended.focus_shell(); return; }
        if root.onboarding_visible { OnboardingBridge.focus_shell(); return; }
        if !system_back_scope.has-focus { return; }
        if root.player_open { PlayerOsdBridge.focus_shell(); }
        else if root.detail_page_mounted { root.focus_mounted_detail(); }
        else if root.settings_page_mounted && !root.more_return_pending { SettingsBridge.focus_shell(); }
        else if root.about_page_mounted && !root.more_return_pending { AboutBridge.focus_shell(); }
        else if root.calendar_page_mounted && !root.more_return_pending { CalendarBridge.focus_shell(); }
        else if root.downloads_page_mounted && !root.more_return_pending { DownloadsBridge.focus_shell(); }
        else if root.more_open { MoreBridge.focus_shell(); }
        else if root.library_page_mounted { LibraryBridge.focus_shell(); }
        else if root.home_page_mounted { HomeBridge.focus_shell(); }
        else if root.discover_page_mounted { DiscoverBridge.focus_shell(); }
    }
    public function focus_mounted_detail() {
        if system_back_scope.has-focus && root.detail_page_mounted && !root.categories_modal && !root.library_duplicates_open {
            if root.stream_selector_open { DetailContent.focus_streams(); }
            else if root.tracking_open { DetailContent.focus_tracking(); }
            else { DetailContent.focus_shell(); }
        }
    }
    public function preserve_back_focus() {
        if MoreBridge.pin_open { root.profile_pin_focus_request += 1; return; }
        if MoreBridge.policy_open { root.profile_policy_focus_request += 1; return; }
        if BackupBridge.open { root.backup_focus_request += 1; return; }
        // A late underlying-page mount must not take the active dialog's keys.
        if root.completion_prompt_visible || root.playback_end_menu_shown { return; }
        // Incoming page init can replace focus before outgoing page teardown.
        // The change handler runs after tree instantiation, keeping release and
        // held-repeat events on a scope that survives the transition.
        system_back_scope.focus();
        root.back_focus_request += 1;
    }
