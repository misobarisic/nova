    // Keep the mount guards in one place. Shared bridge payloads outlive their
    // conditional hosts, so release their cached copies after page teardown.
    callback release_page_payloads();
    private property <bool> home_page_mounted: root.show_home && !root.player_open && !root.modal_visible && !root.show_library && !root.show_settings && !root.show_about && !root.more_open && !root.show_calendar && !root.show_downloads;
    changed home_page_mounted => { if root.home_page_mounted && !root.onboarding_visible { root.preserve_back_focus(); } page_release_timer.start(); }
    private property <bool> discover_page_mounted: !root.player_open && !root.modal_visible && !root.show_library && !root.show_settings && !root.show_home && !root.show_about && !root.more_open && !root.show_calendar && !root.show_downloads;
    changed discover_page_mounted => { if root.discover_page_mounted && !root.onboarding_visible { root.preserve_back_focus(); } page_release_timer.start(); }
    private property <bool> calendar_page_mounted: root.show_calendar && !root.player_open && !root.modal_visible && !root.more_open;
    changed calendar_page_mounted => { if root.calendar_page_mounted && !root.onboarding_visible { root.preserve_back_focus(); } page_release_timer.start(); }
    private property <bool> detail_page_mounted: root.modal_visible && !root.player_open;
    changed detail_page_mounted => { if root.detail_page_mounted && !root.onboarding_visible { root.preserve_back_focus(); } page_release_timer.start(); }
    private property <bool> settings_page_mounted: root.show_settings && !root.more_open && !root.player_open && !root.modal_visible && !root.show_home && !root.show_about;
    changed settings_page_mounted => { if root.settings_page_mounted && !root.onboarding_visible { root.preserve_back_focus(); } page_release_timer.start(); }
    private property <bool> library_page_mounted: root.show_library && !root.player_open && !root.modal_visible && !root.show_settings && !root.show_home && !root.show_about && !root.more_open && !root.show_calendar && !root.show_downloads;
    changed library_page_mounted => { if root.library_page_mounted && !root.onboarding_visible { root.preserve_back_focus(); } page_release_timer.start(); }
    private property <bool> more_page_mounted: (root.more_open || root.more_parent) && !root.player_open && !root.modal_visible;
    changed more_page_mounted => { if root.more_page_mounted && !root.onboarding_visible { root.preserve_back_focus(); } page_release_timer.start(); }
    private property <bool> about_page_mounted: root.show_about && !root.more_open && !root.player_open && !root.modal_visible && !root.show_home && !root.show_library && !root.show_settings;
    changed about_page_mounted => { if root.about_page_mounted && !root.onboarding_visible { root.preserve_back_focus(); } page_release_timer.start(); }
    private property <bool> downloads_page_mounted: root.show_downloads && !root.player_open && !root.modal_visible && !root.more_open;
    changed downloads_page_mounted => { if root.downloads_page_mounted && !root.onboarding_visible { root.preserve_back_focus(); } page_release_timer.start(); }
    changed onboarding_visible => {
        root.preserve_back_focus();
        page_release_timer.start();
    }

    // The Rust handler forces pending tree updates before releasing payloads
    // and rechecks this guard in case navigation changed during child init.
    public pure function page_bridge_is_mounted(page: int) -> bool {
        return page == 0 ? root.home_page_mounted
            : page == 1 ? root.discover_page_mounted
            : page == 2 ? root.calendar_page_mounted
            : page == 3 ? root.detail_page_mounted
            : page == 4 ? root.settings_page_mounted
            : page == 5 ? root.library_page_mounted
            : page == 6 ? root.more_page_mounted
            : page == 7 ? root.about_page_mounted
            : page == 8 ? root.downloads_page_mounted
            : page == 9 ? root.player_open
            : page == 10 ? root.onboarding_visible : true;
    }
    page_release_timer := Timer {
        interval: 1ms;
        // Default Home is already mounted at construction, so its guard has
        // no rising edge. Publish that initial factory and restore focus too.
        running: true;
        triggered => {
            self.stop();
            root.release_page_payloads();
        }
    }
