        subtitle_preference_saved: root.subtitle_preference_saved;
        speed_preference_saved: root.speed_preference_saved;
        subtitle_style_preference_saved: root.subtitle_style_preference_saved;
        system_back_request: root.page_back_request;
        is_android: root.is_android;
        desktop_decoder_available: root.desktop_decoder_available;
        hw_plus_available: root.hw_plus_available;
        narrow: root.narrow_ui;
        safe-top: root.safe-area-insets.top;
        safe-left: root.safe-area-insets.left;
        safe-right: root.safe-area-insets.right;
        safe-bottom: root.safe-area-insets.bottom;
    }

    playback_ended := PlaybackEnded {
        width: 100%; height: 100%;
        open: root.playback_end_menu_shown;
        preview: root.auto_next_preview;
        seconds: root.auto_next_seconds;
        source_title: root.auto_next_preview_source;
        source_metadata: root.auto_next_preview_metadata;
        has_next: root.auto_next_preview || root.playback_end_menu_has_next;
        queued_next: root.playback_end_menu_queue;
        next_title: root.auto_next_preview ? root.auto_next_preview_title : root.playback_end_menu_next_title;
        show_title: root.player_show_title;
        episode_title: root.player_episode_title;
        artwork: root.player_poster;
        safe-top: root.safe-area-insets.top; safe-bottom: root.safe-area-insets.bottom;
        safe-left: root.safe-area-insets.left; safe-right: root.safe-area-insets.right;
        stay => { root.playback_end_stay(); }
        next => { if root.auto_next_preview { root.auto_next_play(); } else { root.playback_end_next(); } }
        details => { root.playback_end_details(); }
    }

    if root.resume_prompt_visible: Rectangle {
        x: 0; y: 0; width: 100%; height: 100%; background: Theme.current.scrim_resume;
        FocusScope { width: 100%; height: 100%; enabled: InterfaceStyle.tv; init => { if InterfaceStyle.tv { self.focus(); } } }
        TouchArea {
            width: 100%; height: 100%;
            clicked => { root.resume_cancel(); }
        }
        Rectangle {
            width: Math.min(InterfaceStyle.tv ? 560px : 360px, parent.width - 40px);
            height: InterfaceStyle.tv ? 224px : 176px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.current.player_menu; border-radius: 14px;
            // Consume clicks inside the card instead of passing them to the
            // outside-click dismiss layer underneath.
            TouchArea { width: 100%; height: 100%; }
            VerticalLayout {
                padding: 20px; spacing: 12px;
                Text { text: @tr("Resume playback?"); color: Theme.current.text_bright; font-size: InterfaceStyle.tv ? 26px : 18px; font-weight: 600; }
                Text { text: @tr("This episode has saved playback history."); color: Theme.current.text_resume_hint; font-size: InterfaceStyle.tv ? 20px : 14px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end; spacing: 8px;
                    Rectangle {
                        width: InterfaceStyle.tv ? 160px : 112px; height: InterfaceStyle.tv ? 56px : 40px; border-radius: 8px; background: Theme.current.hover_overlay;
                        accessible-role: button; accessible-label: @tr("Start over");
                        border-width: InterfaceStyle.tv && root.resume_focus == 0 ? 2px : 0px; border-color: Theme.current.focus_ring;
                        Text { text: @tr("Start over"); color: Theme.current.text_bright; font-size: InterfaceStyle.tv ? 20px : root.default-font-size; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { width: 100%; height: 100%; clicked => { root.resume_focus = 0; root.resume_choice(false); } }
                    }
                    Rectangle {
                        width: InterfaceStyle.tv ? 144px : 100px; height: InterfaceStyle.tv ? 56px : 40px; border-radius: 8px; background: Theme.current.accent;
                        accessible-role: button; accessible-label: @tr("Resume");
                        // The accent fill and focus_ring share a colour; use the
                        // on-accent foreground to keep remote focus visible.
                        border-width: InterfaceStyle.tv && root.resume_focus == 1 ? 2px : 0px; border-color: Theme.current.on_accent;
                        Text { text: @tr("Resume"); color: Theme.current.text_bright; font-size: InterfaceStyle.tv ? 20px : root.default-font-size; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { width: 100%; height: 100%; clicked => { root.resume_focus = 1; root.resume_choice(true); } }
                    }
                }
            }
        }
    }
    // Keep the wizard inside the persistent capture scope so first-mount
    // focus restoration and held-Back protection also cover onboarding.
    if root.onboarding_visible: OnboardingHost {
        width: 100%; height: 100%;
        viewport_width: self.width; viewport_height: self.height;
        busy: root.onboarding_busy;
        addon_ready: root.onboarding_addon_ready;
        error: root.onboarding_error;
        audio_selected_codes: root.audio_language_selected_codes;
        audio_selected_names: root.audio_language_selected_names;
        subtitle_selected_codes: root.subtitle_language_selected_codes;
        subtitle_selected_names: root.subtitle_language_selected_names;
        audio_label: root.audio_language_label;
        subtitle_label: root.subtitle_language_label;
        audio_codes: root.audio_language_codes;
        audio_names: root.audio_language_names;
        subtitle_codes: root.subtitle_language_codes;
        subtitle_names: root.subtitle_language_names;
        safe_top: root.safe-area-insets.top;
        safe_bottom: root.safe-area-insets.bottom;
        safe_left: root.safe-area-insets.left;
        safe_right: root.safe-area-insets.right;
        system_back_request: root.system_back_request;
    }
    if (root.party_active || root.party_busy) && root.player_open && !root.party_page_open: PartyPlayerBadge {
        // Share the actual OSD fade, including loading and open player menus.
        opacity: root.osd_opacity;
        visible: self.opacity > 0;
        x: root.safe-area-insets.left + 18px;
        // The footer captions leave this top lane for watch-party controls.
        y: Math.max(root.safe-area-insets.top + 16px, PlayerOsdBridge.header_bottom + 12px);
        width: Math.min(300px, root.width - root.safe-area-insets.left - root.safe-area-insets.right - 36px);
    }
    if root.party_page_open && root.more_service_route != 9: PartyPage {
        width: 100%; height: 100%; safe-top: root.safe-area-insets.top; safe-bottom: root.safe-area-insets.bottom;
        safe-left: root.safe-area-insets.left; safe-right: root.safe-area-insets.right;
    }
    // Controls and discovery cover the catalog, independently of local playback.
    if root.remote_devices_open && root.more_service_route != 8: RemoteDevicesPage {
        width: 100%; height: 100%; safe-top: root.safe-area-insets.top; safe-bottom: root.safe-area-insets.bottom;
        safe-left: root.safe-area-insets.left; safe-right: root.safe-area-insets.right;
    }
    if root.remote_controls_open || root.remote_controls_visual_retained: remote_controls_host := Rectangle {
        width: 100%; height: 100%; background: transparent;
        // The fixed host blocks the exposed edge during both slide directions.
        TouchArea { width: 100%; height: 100%; scroll-event => { accept } }
        remote_controls_page := RemoteControlsPage {
            x: (1.0 - root.remote_controls_slide) * root.width * 0.10;
            opacity: root.remote_controls_alpha;
            active: root.remote_controls_open;
            width: 100%; height: 100%; safe-top: root.safe-area-insets.top; safe-bottom: root.safe-area-insets.bottom;
            safe-left: root.safe-area-insets.left; safe-right: root.safe-area-insets.right;
        }
    }
    // Always mounted state holder retains its own immutable rendered snapshot.
    CatalogSourceChooser { width: 100%; height: 100%; safe-top: root.safe-area-insets.top; safe-bottom: root.safe-area-insets.bottom; safe-left: root.safe-area-insets.left; safe-right: root.safe-area-insets.right; }
    if root.remote_replacement_token != "": RemoteReplacementDialog {
        width: 100%; height: 100%; safe-top: root.safe-area-insets.top; safe-bottom: root.safe-area-insets.bottom;
        safe-left: root.safe-area-insets.left; safe-right: root.safe-area-insets.right;
    }

    update_notice := UpdateNotice {
        visible: root.update_notice_shown;
        width: Math.max(0px, Math.min(InterfaceStyle.tv ? 600px : 460px,
            root.width - root.safe-area-insets.left - root.safe-area-insets.right - 24px));
        x: root.width - root.safe-area-insets.right - self.width - 12px;
        // Phone root pages have a bottom navigation bar; subpages do not.
        y: Math.max(root.safe-area-insets.top + 12px, root.height - self.height - root.safe-area-insets.bottom
            - (root.narrow_ui && !root.show_settings && !root.show_about && !root.show_calendar && !root.show_downloads ? 80px : 12px));
        installed_version: root.app_version;
        latest_version: root.update_latest_version;
        dismissed => { root.update_notice_visible = false; root.preserve_back_focus(); page_release_timer.start(); }
        view_release => { root.update_release_requested(); root.update_notice_visible = false; root.preserve_back_focus(); page_release_timer.start(); }
    }

    if root.sleep_timer_notice != "" && !root.player_open: Rectangle {
        x: (root.width - self.width) / 2; y: Math.max(root.safe-area-insets.top + 12px, root.height - root.safe-area-insets.bottom - self.height - (root.narrow_ui ? 88px : 24px));
        width: Math.max(0px, Math.min(InterfaceStyle.tv ? 600px : 460px, root.width - root.safe-area-insets.left - root.safe-area-insets.right - 36px));
        height: sleep_notice_label.preferred-height + 24px;
        border-radius: 10px; background: Theme.current.popup;
        sleep_notice_label := Text { x: 12px; y: 12px; width: Math.max(0px, parent.width - 24px); text: root.sleep_timer_notice; wrap: word-wrap; color: Theme.current.text_primary; }
    }

    if root.completion_prompt_visible: CompletionRatingPrompt {
        width: parent.width; height: parent.height;
        phone: !InterfaceStyle.tv && (root.is_android || root.narrow_ui);
        safe-bottom: root.safe-area-insets.bottom;
        safe-top: root.safe-area-insets.top;
        safe-left: root.safe-area-insets.left;
        safe-right: root.safe-area-insets.right;
    }
    if root.backup_open || root.backup_visual_retained: backup_host := Rectangle {
        width: 100%; height: 100%; clip: true;
        // Cover the exposed edge throughout both directions of the push/pop.
        TouchArea { width: 100%; height: 100%; scroll-event => { accept } }
        backup_page := BackupPanel {
            x: (1.0 - root.backup_slide) * root.width;
            opacity: root.backup_alpha;
            active: root.backup_open;
            focus-request: root.backup_focus_request;
            width: 100%; height: 100%;
            safe-top: root.safe-area-insets.top; safe-bottom: root.safe-area-insets.bottom;
            safe-left: root.safe-area-insets.left; safe-right: root.safe-area-insets.right;
        }
    }
    if MoreBridge.policy_browse: Rectangle {
        x: root.safe-area-insets.left + 18px;
        y: root.height - root.safe-area-insets.bottom - self.height - 18px;
        width: Math.max(1px,root.width - root.safe-area-insets.left - root.safe-area-insets.right - 36px);
        height: policy_search_actions.preferred-height + 24px;
        background: Theme.current.popup; border-radius: Theme.button_corner_radius;
        policy_search_actions := HorizontalLayout { x:12px; y:12px; width:parent.width - 24px; spacing:12px;
            if root.modal_visible: PillButton { label:@tr("Allow this title"); wrap_label:true; clicked => { MoreBridge.policy_allow_selected_title(); } }
            PillButton { label:@tr("Done choosing titles"); wrap_label:true; clicked => { MoreBridge.policy_finish_title_search(); } }
        }
    }
    if MoreBridge.policy_open: profile_policy_editor := ProfilePolicyEditor { focus-request: root.profile_policy_focus_request; width: 100%; height: 100%; safe-top: root.safe-area-insets.top; safe-bottom: root.safe-area-insets.bottom; safe-left: root.safe-area-insets.left; safe-right: root.safe-area-insets.right; }
    if MoreBridge.pin_open: profile_pin_gate := ProfilePinGate { focus-request: root.profile_pin_focus_request; width: 100%; height: 100%; safe-top: root.safe-area-insets.top; safe-bottom: root.safe-area-insets.bottom; safe-left: root.safe-area-insets.left; safe-right: root.safe-area-insets.right; }

    }

    if CastBridge.open || root.casting_visual_retained: casting_panel := CastingPanel { width: 100%; height: 100%; safe_bottom: root.safe-area-insets.bottom; safe_top: root.safe-area-insets.top; safe_left: root.safe-area-insets.left; safe_right: root.safe-area-insets.right; touch: root.is_android; visual_closed => { if !CastBridge.open { root.casting_visual_retained = false; root.preserve_back_focus(); root.restart_osd_hide(); CastBridge.restore_focus += 1; } } }

}
