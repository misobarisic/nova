    // Monotonic signal used to route Android system Back through the active
    // page even while a text field owns focus. Per-page handlers remember
    // the last request so a newly mounted page cannot consume the same press.
    in-out property <int> system_back_request: 0;
    private property <int> page_back_request: 0;
    changed system_back_request => {
        if MoreBridge.pin_open { MoreBridge.pin_cancel(); return; }
        if MoreBridge.policy_open { MoreBridge.management_closed(); return; }
        if OfflineBridge.opened {OfflineBridge.closed();return;}
        if BackupBridge.open {
            if !BackupBridge.busy {
                if BackupBridge.recovery_confirmation { BackupBridge.cancel_delete_recovery(); }
                else { BackupBridge.closed(); }
            }
            return;
        }
        if root.backup_visual_retained { return; }
        // Startup selection owns Back even before the first page focus event.
        // The Profiles page may cancel its editor, but cannot leave the picker.
        if root.profiles_require_selection { root.page_back_request += 1; }
        else if root.playback_end_menu_shown { root.playback_end_stay(); }
        else if !root.onboarding_visible { root.page_back_request += 1; }
    }
