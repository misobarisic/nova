        root.profile_home_started = false;
        // Observe each zero-duration reset before a delayed first frame can
        // start the animation, including repeated selections of Current.
        root.profile_home_slide_start = root.profile_home_slide;
        root.profile_home_alpha_start = root.profile_home_alpha;
