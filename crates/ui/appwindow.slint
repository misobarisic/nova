    // Android delivers Back as a key event, but focused inputs and page-local
    // scopes can reject or consume it before the active screen handles it.
    // Capture it at the shared window layer; separate PopupWindows (such as
    // Dropdown) install their own capture handler.
    system_back_scope := FocusScope {
        init => { self.focus(); }
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;

        capture-key-pressed(e) => {
            if (e.text == Key.Back && (e.repeat || root.system_back_held)) {
                // Keep repeat protection ahead of modal dismissal.
                accept
            } else if (e.text != Key.Back) {
                reject
            } else {
                root.system_back_held = true;
                // Android Back is navigation, not keyboard navigation. Clear
                // both shared visual-mode sources before the returned page is
                // built; arrow keys can enable them again on real key input.
                if (root.touch_menus) {
                    root.kb_active = false;
                    SettingsStyle.keyboard-mode = false;
                }
                if (root.onboarding_visible) {
                    // First-launch navigation owns Back before any underlying
                    // page or overlay, including before its first pointer press.
                    root.system_back_request += 1;
                    accept
                } else if (root.resume_prompt_visible) {
                    root.resume_cancel();
                    accept
                } else if (root.library_duplicates_open) {
                    if root.library_duplicate_selection >= 0 { root.library_duplicate_selection = -1; }
                    else { root.library_duplicates_open = false; }
                    accept
                } else if (root.categories_modal) {
                    root.categories_modal = false;
                    accept
                } else if (root.modal_visible && !root.player_open && root.stream_selector_open) {
                    // The fullscreen selector owns Back independently of the hidden
                    // detail navigation, including when returning from playback.
                    root.preserve_back_focus();
                    if (root.stream_action_open) { root.stream_action_open = false; }
                    else { root.stream_selector_back(); }
                    accept
                } else {
                    root.system_back_request += 1;
                    accept
                }
            }
        }

        capture-key-released(e) => {
            if (e.text == Key.Back) {
                root.system_back_held = false;
                root.focus_mounted_page();
                accept
            } else { reject }
        }

        // ---- Discover page --------------------------------------------
    if root.discover_page_mounted: DiscoverHost {
        viewport_width: self.width; viewport_height: self.height;
        nav-viewport-width: root.width;
        catalog_labels: root.catalog_labels;
        search_history: root.discover_search_history;
        search_history_contexts: root.discover_search_history_contexts;
        search_filters_open: root.discover_search_filters_open;
        search_addon_names: root.search_addon_names;
        search_type_names: root.search_type_names;
        search_catalog_names: root.search_catalog_names;
        search_catalog_labels: root.search_catalog_labels;
        search_genre_names: root.search_genre_names;
        system_back_request: root.page_back_request;
        animate_search_results: root.discover_search_animate_results;
        min_cols: root.discover_min_cols;
        narrow: root.narrow_ui;
        touch_menus: root.touch_menus;
        safe-top: root.safe-area-insets.top;
        safe-left: root.safe-area-insets.left;
        safe-right: root.safe-area-insets.right;
        safe-bottom: root.safe-area-insets.bottom;
        more_open: root.more_open;

    }

    // ---- Home page (landing page, Continue Watching) --------------------
    if root.home_page_mounted: HomeHost {
        viewport_width: self.width; viewport_height: self.height;
        nav-viewport-width: root.width;
        catalog_sections: root.home_catalog_sections;
        catalog_order: root.home_catalog_order;
        catalog_positions: root.home_catalog_positions;
        catalog_cards: root.home_catalog_cards;
        featured_watch_label: root.home_featured_watch_label;
        featured_logo: root.home_featured_logo;
        featured_refresh_pending: root.home_featured_refresh_pending;
        min_cols: root.library_min_cols;
        system_back_request: root.page_back_request;
        narrow: root.narrow_ui;
        touch_menus: root.touch_menus;
        continue_enabled: root.home_continue_enabled;
        safe-top: root.safe-area-insets.top;
        safe-left: root.safe-area-insets.left;
        safe-right: root.safe-area-insets.right;
        safe-bottom: root.safe-area-insets.bottom;
        more_open: root.more_open;

    }

    // ---- Detail page ---------------------------------------------------
    if root.detail_page_mounted: DetailHost {
        viewport_width: self.width; viewport_height: self.height;
        tracking_links: root.tracking_links;
        tracking_candidates: root.tracking_candidates;
        tracking_setup:root.tracking_setup;
        tracking_setup_revision:root.tracking_setup_revision;
        tracking_setup_summary:root.tracking_setup_summary;
        tracking_setup_unmapped:root.tracking_setup_unmapped;
        tracking_setup_active:root.tracking_setup_active;
        tracking_range_first:root.tracking_range_first;
        tracking_range_last:root.tracking_range_last;
        tracking_range_start:root.tracking_range_start;
        tracking_source_rows: root.tracking_source_rows;
        tracking_preview_rows: root.tracking_preview_rows;
        tracking_mapping_rows: root.tracking_mapping_rows;
        tracking_notice: root.tracking_notice;
        tracking_candidate_title: root.tracking_candidate_title;
        tracking_busy: root.tracking_busy;
        tracking_can_confirm: root.tracking_can_confirm;
        selected_logo: root.selected_logo;
        is_movie: root.detail_is_movie;
        episode_reveal_request: root.detail_episode_reveal_request;
        stream_episode_number: root.stream_episode_number;
        stream_episode_title: root.stream_episode_title;
        watch_label: root.detail_watch_label;
        deep_stream: root.detail_deep_stream;
        system_back_request: root.page_back_request;
        popup_open: root.categories_modal || root.library_duplicates_open;
        narrow: root.narrow_ui;
        safe-top: root.safe-area-insets.top;
        safe-left: root.safe-area-insets.left;
        safe-right: root.safe-area-insets.right;
        safe-bottom: root.safe-area-insets.bottom;
        touch_menus: root.touch_menus;
        library_watched: root.detail_library_watched;
        library_activity_action: root.detail_library_activity_action;

    }

    // ---- Assign-categories popup ---------------------------------------
    // Overlays the detail page while the user picks categories for the
    // current library item; `closed()` is fired by the backdrop / Done.
    if root.categories_modal && root.modal_visible && !root.player_open: CategoryPickerPopup {
        selected_title <=> root.selected_title;
        category_rows <=> root.category_rows;
        modal_category_flags <=> root.modal_category_flags;
        kb_active <=> root.kb_active;

        toggle_entry_category(name) => { root.toggle_entry_category(name); }
        closed => { root.categories_modal = false; }
    }

    if root.library_duplicates_open && root.modal_visible && !root.player_open: LibraryDuplicates {
        candidates: root.library_duplicates;
        selection: root.library_duplicate_selection;
        matched: root.library_duplicate_matched;
        unmatched: root.library_duplicate_unmatched;
        open_details => { root.library_duplicate_action(-2); }
        move_entry => { root.library_duplicate_action(-3); }
        back_to_candidates => { root.library_duplicate_selection = -1; }
        narrow: root.narrow_ui;
        safe-top: root.safe-area-insets.top;
        safe-bottom: root.safe-area-insets.bottom;
        safe-left: root.safe-area-insets.left;
        safe-right: root.safe-area-insets.right;
        selected(i) => { root.library_duplicate_action(i); }
        add_anyway => { root.library_duplicate_action(-1); }
        closed => {
            if root.library_duplicate_selection >= 0 { root.library_duplicate_selection = -1; }
            else { root.library_duplicates_open = false; }
        }
    }

    // ---- Library page ---------------------------------------------------
    if root.show_library && !root.player_open && !root.modal_visible && !root.show_settings && !root.show_home && !root.show_about && !root.more_open && !root.show_calendar && !root.show_downloads: LibraryHost {
        viewport_width: self.width; viewport_height: self.height;
        nav-viewport-width: root.width;
        min_cols: root.library_min_cols;
        system_back_request: root.page_back_request;
        more_open: root.more_open;
        narrow: root.narrow_ui;
        safe-top: root.safe-area-insets.top;
        safe-left: root.safe-area-insets.left;
        safe-right: root.safe-area-insets.right;
        safe-bottom: root.safe-area-insets.bottom;
        touch_menus: root.touch_menus;
    }

    more_content_host := Rectangle {
        // Its focus-capture scope must not cover unrelated pages or Detail.
        visible: !root.player_open && !root.modal_visible && (root.more_open || root.more_parent || root.show_settings || root.show_about || root.show_calendar || root.show_downloads);
        x: root.more_rail_width; y: 0px;
        width: root.width - root.more_rail_width; height: root.height;
        clip: true;
        // An inactive page can still contain native editors or tab targets.
        // Capture before descendants handle keys; persistent chrome is outside
        // this scope and remains available to interrupt the return.
        content_input_scope := FocusScope {
            width: 100%; height: 100%;
            // Forward Tab from the persistent window scope lands here before
            // any outgoing editor; active pages gain no extra tab stop.
            focus-on-tab-navigation: root.more_return_pending;
            capture-key-pressed(e) => {
                if (root.more_return_pending) { self.focus(); accept } else { reject }
            }
            capture-key-released(e) => {
                if (root.more_return_pending) { accept } else { reject }
            }
    if (root.more_open || root.more_parent) && !root.player_open && !root.modal_visible: MoreHost {
        viewport_width: self.width; viewport_height: self.height;
        width: more_content_host.width; height: more_content_host.height;
        // Keep this layer behind every subpage, including Settings/About.
        x: root.more_open ? 0px : -0.28 * more_content_host.width * (1.0 - root.more_subpage_offset);
        opacity: root.more_open ? 1.0 : 1.0 - root.more_subpage_alpha;
        external_navigation: true;
        active: root.more_open;
        narrow: root.narrow_ui;
        nav-viewport-width: root.width;
        safe-top: root.safe-area-insets.top;
        safe-bottom: root.safe-area-insets.bottom;
        safe-left: root.narrow_ui ? root.safe-area-insets.left : 0px;
        safe-right: root.safe-area-insets.right;
        system_back_request: root.page_back_request;
    }

    // ---- Settings page --------------------------------------------------
    if root.settings_page_mounted: SettingsHost {
        viewport_width: self.width; viewport_height: self.height;
        width: more_content_host.width; height: more_content_host.height;
        x: more_content_host.width * root.more_subpage_offset;
        opacity: root.more_subpage_alpha;
        external_navigation: true;
        active: !root.more_return_pending;
        two_pane: root.settings_two_pane;
        cache_busy: root.cache_busy;
        cache_rewriting: root.cache_rewriting;
        cache_processed: root.cache_processed;
        cache_total: root.cache_total;
        cache_status: root.cache_status;
        nav-viewport-width: root.width;
        tracking_accounts: root.tracking_accounts;
        tracking_notice: root.tracking_notice;
        persistence_failed: root.persistence_failed;
        cinemeta_installed: root.cinemeta_installed;
        system_back_request: root.page_back_request;
        audio_language_label: root.audio_language_label;
        subtitle_language_label: root.subtitle_language_label;
        audio_language_codes: root.audio_language_codes;
        audio_language_names: root.audio_language_names;
        subtitle_language_codes: root.subtitle_language_codes;
        subtitle_language_names: root.subtitle_language_names;
        is_android: root.is_android;
        phone_layout: root.narrow_ui;
        safe-top: root.safe-area-insets.top;
        safe-left: root.narrow_ui ? root.safe-area-insets.left : 0px;
        safe-right: root.safe-area-insets.right;
        safe-bottom: root.safe-area-insets.bottom;

    }

    // ---- About (with nested Licenses) -----------------------------------
    if root.show_about && !root.more_open && !root.player_open && !root.modal_visible && !root.show_home && !root.show_library && !root.show_settings: AboutHost {
        viewport_width: self.width; viewport_height: self.height;
        width: more_content_host.width; height: more_content_host.height;
        x: more_content_host.width * root.more_subpage_offset;
        opacity: root.more_subpage_alpha;
        external_navigation: true;
        active: !root.more_return_pending;
        nav-viewport-width: root.width;
        narrow: root.narrow_ui;
        safe-top: root.safe-area-insets.top;
        safe-left: root.narrow_ui ? root.safe-area-insets.left : 0px;
        safe-right: root.safe-area-insets.right;
        safe-bottom: root.safe-area-insets.bottom;
        system_back_request: root.page_back_request;
        license_catalog: root.license_catalog;
        license_sources: root.license_sources;
    }


    if root.calendar_page_mounted: CalendarHost {
        viewport_width: self.width; viewport_height: self.height;
        artwork-active: root.page_artwork_allowed;
        nav-viewport-width: root.width;
        width: more_content_host.width; height: more_content_host.height;
        x: more_content_host.width * root.more_subpage_offset;
        opacity: root.more_subpage_alpha;
        external_navigation: true;
        active: !root.more_return_pending;
        cells: root.calendar_cells; week_cells: root.calendar_week; rows: root.calendar_rows; later: root.calendar_later;
        title: root.calendar_title; day_title: root.calendar_day_title; count: root.calendar_count;
        safe-top: root.safe-area-insets.top; safe-left: root.narrow_ui ? root.safe-area-insets.left : 0px; safe-right: root.safe-area-insets.right; safe-bottom: root.safe-area-insets.bottom;
        system_back_request: root.page_back_request;

    }
    if root.show_downloads && !root.player_open && !root.modal_visible && !root.more_open: DownloadsHost {
        viewport_width: self.width; viewport_height: self.height;
        artwork-active: root.page_artwork_allowed;
        nav-viewport-width: root.width;
        width: more_content_host.width; height: more_content_host.height;
        x: more_content_host.width * root.more_subpage_offset;
        opacity: root.more_subpage_alpha;
        external_navigation: true;
        active: !root.more_return_pending;
        groups: root.downloads_page_groups; transfers: root.downloads_page_transfers; summary: root.downloads_page_summary; counts: root.downloads_page_counts;
        safe-top: root.safe-area-insets.top; safe-left: root.narrow_ui ? root.safe-area-insets.left : 0px; safe-right: root.safe-area-insets.right; safe-bottom: root.safe-area-insets.bottom;
        system_back_request: root.page_back_request;
    }

        }
    }
    if root.more_family && !root.narrow_ui && !root.player_open && !root.modal_visible: SideNav {
        viewport-width: root.width;
        active: root.more_open || root.more_return_pending || root.show_settings || root.show_about ? 3 : root.show_calendar ? 4 : 5;
        safe-top: root.safe-area-insets.top; safe-left: root.safe-area-insets.left; safe-bottom: root.safe-area-insets.bottom;
        kb_zone: root.more_open ? root.more_focus_zone : root.family_nav_zone;
        kb_nav: root.more_open || root.more_return_pending ? root.more_nav_index : root.family_nav_index; kb_active <=> root.kb_active;
        home_picked => { root.navigate_section(0); } discover_picked => { root.navigate_section(1); }
        library_picked => { root.navigate_section(2); } more_picked => { root.navigate_section(3); }
    }
    if (root.more_open || root.more_return_pending) && root.narrow_ui && !root.player_open && !root.modal_visible: BottomNav {
        y: root.height - self.height; width: root.width;
        active: 3; kb_zone: root.more_focus_zone; kb_nav: root.more_open || root.more_return_pending ? root.more_nav_index : root.family_nav_index; kb_active <=> root.kb_active;
        safe-bottom: root.safe-area-insets.bottom; safe-left: root.narrow_ui ? root.safe-area-insets.left : 0px; safe-right: root.safe-area-insets.right;
        page-inset-left: 0px; page-inset-right: 0px;
        home_picked => { root.navigate_section(0); } discover_picked => { root.navigate_section(1); } library_picked => { root.navigate_section(2); }
    }

    // ---- Player overlay --------------------------------------------------
    if root.player_open: PlayerOsdHost {
        width: 100%; height: 100%;
        viewport_width: self.width; viewport_height: self.height;
        next_episode_visible: root.next_episode_visible;
        next_episode_token: root.next_episode_token;
        next_episode_title: root.next_episode_title;
        next_episode_context: root.next_episode_context;
        audio_preference_saved: root.audio_preference_saved;
        subtitle_preference_saved: root.subtitle_preference_saved;
        speed_preference_saved: root.speed_preference_saved;
        system_back_request: root.page_back_request;
        is_android: root.is_android;
        narrow: root.narrow_ui;
        safe-top: root.safe-area-insets.top;
        safe-left: root.safe-area-insets.left;
        safe-right: root.safe-area-insets.right;
    }

    if root.resume_prompt_visible: Rectangle {
        x: 0; y: 0; width: 100%; height: 100%; background: Theme.current.scrim_resume;
        TouchArea {
            width: 100%; height: 100%;
            clicked => { root.resume_cancel(); }
        }
        Rectangle {
            width: Math.min(360px, parent.width - 40px);
            height: 176px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.current.player_menu; border-radius: 14px;
            // Consume clicks inside the card instead of passing them to the
            // outside-click dismiss layer underneath.
            TouchArea { width: 100%; height: 100%; }
            VerticalLayout {
                padding: 20px; spacing: 12px;
                Text { text: @tr("Resume playback?"); color: Theme.current.text_bright; font-size: 18px; font-weight: 600; }
                Text { text: @tr("This episode has saved playback history."); color: Theme.current.text_resume_hint; font-size: 14px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end; spacing: 8px;
                    Rectangle {
                        width: 112px; height: 40px; border-radius: 8px; background: Theme.current.hover_overlay;
                        Text { text: @tr("Start over"); color: Theme.current.text_bright; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { width: 100%; height: 100%; clicked => { root.resume_choice(false); } }
                    }
                    Rectangle {
                        width: 100px; height: 40px; border-radius: 8px; background: Theme.current.accent;
                        Text { text: @tr("Resume"); color: Theme.current.text_bright; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { width: 100%; height: 100%; clicked => { root.resume_choice(true); } }
                    }
                }
            }
        }
    }
    // Keep the wizard inside the persistent capture scope so first-mount
    // focus restoration and held-Back protection also cover onboarding.
    if root.onboarding_visible: OnboardingHost {
        width: 100%; height: 100%;
        viewport_width: self.width; viewport_height: self.height;
        busy: root.onboarding_busy;
        addon_ready: root.onboarding_addon_ready;
        error: root.onboarding_error;
        audio_label: root.audio_language_label;
        subtitle_label: root.subtitle_language_label;
        audio_codes: root.audio_language_codes;
        audio_names: root.audio_language_names;
        subtitle_codes: root.subtitle_language_codes;
        subtitle_names: root.subtitle_language_names;
        safe_top: root.safe-area-insets.top;
        safe_bottom: root.safe-area-insets.bottom;
        safe_left: root.safe-area-insets.left;
        safe_right: root.safe-area-insets.right;
        system_back_request: root.system_back_request;
    }
    }

}
