    function pick_more(index: int) { root.more_choice = index; root.more_focus_zone = 1; root.route_section(index == 0 ? 4 : index == 1 ? 5 : index == 2 ? 6 : 7, true); }
    function finish_more_subpage_back() {
        if (!root.more_return_pending || root.more_return_generation != root.more_route_generation || !root.more_parent || root.player_open || root.modal_visible) { return; }
        root.more_return_pending = false;
