import { DiscoverPage } from "discover.slint";
import { HomePage } from "home.slint";
import { DetailPage } from "detail.slint";
import { CategoryPickerPopup } from "categories.slint";
import { LibraryPage } from "library.slint";
import { SettingsPage } from "settings.slint";
import { PlayerOverlay } from "player.slint";
// Re-exported so the Rust backend can reach the animation switches (globals
// are only accessible from Rust when exported by the root component's file).
export { Anim } from "anim.slint";
// Same re-export for the navigation bookkeeping the backend writes: which
// section a page switch is leaving, for the incoming nav icon's feedback.
export { NavState } from "sidenav.slint";

// Shared structs used by the property declarations below; they are exported
// from types.slint, so the generated Rust module (`slint::include_modules!`)
// exposes them to the backend.
import { MediaCard, StreamRow, EpisodeRow, AddonRow, CategoryRow, HomeCatalogRow, SyncPeer, SyncInvite, TrackRow, SeasonCard, ContinueRow, UpcomingRow, CalCell, SheetItem, DownloadRow, LicenseSource } from "types.slint";

// AppWindow owns every property / callback the backend drives (all the
// `set_*`, `get_*`, `on_*` and `invoke_*` calls in desktop.rs / web.rs) and
// forwards them into the per-screen components below. The screen switching
// guards live here so each page component stays self-contained.
export component AppWindow inherits Window {
    icon: @image-url("../../assets/logo.png");
    preferred-width: 1100px;
    preferred-height: 750px;
    min-width: 360px;
    // Landscape phones offer ~360px of height; pages scroll internally,
    // so the window is allowed to shrink that far.
    min-height: 360px;
    title: "Nova";
    // Narrow (portrait) layout mode: pages + player switch to compact
    // variants below this window width.
    property <bool> narrow_ui: self.width < 700px;
    // In player mode the video (mpv on desktop, HTML5 <video> on web)
    // renders behind this window, so the window turns transparent while
    // the overlay is up and playback has started.
    //
    // Android is the exception: there the EGL window surface must stay opaque
    // so SurfaceFlinger does not treat the whole window as translucent (which
    // flashes the black compositor layer on every repaint, e.g. while the OSD
    // fades). mpv draws after the clear in `RenderingState::BeforeRendering`,
    // so an opaque background never hides the video — only a frame where the
    // video is missing reads as black instead of transparent.
    background: (root.player_open && root.playback_started)
        ? (root.is_android ? #000000 : transparent)
        : #0f0f12;

    in-out property <[MediaCard]> catalog: [];
    in-out property <[MediaCard]> search_results: [];
    in-out property <[string]> discover_search_history: [];
    in-out property <[string]> addon_names: [];
    in-out property <[string]> type_names: [];
    in-out property <[string]> catalog_names: [];
    in-out property <[string]> catalog_labels: [];
    in-out property <[string]> genre_names: [];
    in-out property <[AddonRow]> addon_rows: [];
    in-out property <[StreamRow]> streams: [];
    in-out property <int> addon_combo_idx: -1;
    in-out property <int> type_combo_idx: -1;
    in-out property <int> catalog_combo_idx: -1;
    in-out property <int> genre_combo_idx: 0;
    in-out property <string> addon_url: "";
    in-out property <string> search_text: "";
    in-out property <bool> discover_search_open: false;
    // Survives page recreation while opening a result's detail view.
    in-out property <bool> discover_search_animate_results: true;
    changed modal_visible => {
        if (root.modal_visible && root.discover_search_open) {
            root.discover_search_animate_results = false;
        }
    }
    in-out property <bool> search_loading: false;
    in-out property <bool> search_loading_more: false;
    in-out property <bool> search_can_load_more: false;
    in-out property <string> search_empty_hint: @tr("No results for this search.");
    // False when no enabled catalog declares search: the global search
    // field is disabled instead of silently changing browse data.
    in-out property <bool> searchable: true;
    // Minimum grid columns (Settings → Display), applied live on autosave.
    in-out property <int> discover_min_cols: 2;
    in-out property <bool> discover_catalog_addon_names: true;
    in-out property <int> library_min_cols: 2;
    in-out property <string> empty_hint: @tr("No addons installed yet — add one in Settings → Addons.");
    in-out property <string> streams_hint: "";
    // Addon filter pills above the stream list (0 = All, else 1-based).
    in-out property <[string]> stream_addons: [];
    in-out property <[bool]> stream_loading: [];
    in-out property <bool> streams_searching: false;
    in-out property <int> stream_filter: 0;
    in-out property <bool> stream_action_open: false;
    in-out property <string> stream_action_id: "";
    in-out property <string> stream_action_title: "";
    in-out property <[SheetItem]> stream_action_items: [];
    in-out property <string> searchable_hint: "";
    // --- Library (own collection, Stremio-style) -----------------------
    in-out property <[MediaCard]> library: [];
    in-out property <bool> show_library: false;
    in-out property <bool> show_home: true;
    in-out property <bool> in_library: false;
    in-out property <string> library_empty_hint: @tr("Your library is empty — open any movie, series or anime and press \"+ Add to library\".");
    // --- Home (landing page, Continue Watching) ------------------------
    in-out property <[ContinueRow]> home_continue: [];
    in-out property <[UpcomingRow]> home_upcoming: [];
    // Independent catalog-driven feature at the top of Home. Rust keeps its
    // selected preview and fetches the active backdrop on demand.
    in-out property <string> home_featured_title: "";
    in-out property <string> home_featured_type: "";
    in-out property <string> home_featured_rating: "";
    in-out property <string> home_featured_runtime: "";
    in-out property <string> home_featured_description: "";
    in-out property <image> home_featured_backdrop;
    in-out property <int> home_featured_index: 0;
    in-out property <int> home_featured_count: 0;
    // Home → Upcoming calendar (the "see all" subpage's month view): the 42
    // grid cells, the month title, the selected day's episode rows, the
    // selected epoch day (-1 = none) and the list/calendar switch. The
    // backend owns the month arithmetic and the selection.
    in-out property <[CalCell]> home_cal_cells: [];
    in-out property <string> home_cal_title: "";
    in-out property <[UpcomingRow]> home_cal_day: [];
    in-out property <int> home_cal_epoch: -1;
    in-out property <bool> home_cal_open: false;
    // Home subpage stack: 0 = landing carousels, 1 = all Continue Watching,
    // 2 = all Upcoming. Owned here so the chosen view (and its scroll)
    // survives the detail modal destroying/recreating HomePage.
    in-out property <int> home_view: 0;
    // Touch-driven platform (Android): card menus open as bottom sheets
    // on hold; desktop keeps native right-click popups. Set once from Rust.
    in-out property <bool> touch_menus: false;
    in-out property <string> home_empty_hint: @tr("Nothing to continue — start watching a show or movie and it will show up here.");

    // --- Settings (image cache) ---------------------------------------
    in-out property <bool> show_settings: false;
    in-out property <string> license_catalog: "";
    in-out property <[LicenseSource]> license_sources: [];
    // Image-cache re-encode settings are desktop-only (the web build relies
    // on the browser HTTP cache and has no app-level image cache).
    in-out property <bool> show_image_cache: true;
    in-out property <bool> cache_images: true;
    in-out property <string> cache_disk_usage: "";
    in-out property <bool> cache_enabled: false;
    in-out property <int> cache_format_index: 0;
    in-out property <float> cache_quality: 85.0;
    in-out property <bool> cache_downscale: true;
    in-out property <bool> cache_date_relative: true;
    in-out property <bool> cache_show_unwatched_thumbs: true;
    in-out property <float> cache_lru_mb: 128.0;
    in-out property <bool> cache_prefetch_metadata: false;
    // Lazily re-encode images on load to the configured format/quality.
    in-out property <bool> cache_lazy_reencode: false;
    in-out property <[string]> cache_format_names: ["JPEG", "WebP"];
    // Player backend (Settings → Player): 0 = built-in mpv, 1 = external
    // app. Desktop external target: 0 = system default, 1 = VLC, 2 = mpv.
    // Android decoder: preferred video decoder (0 = HW+, 1 = HW, 2 = SW);
    // the decoder row is hidden unless `is_android` is true.
    in-out property <int> player_backend_index: 0;
    in-out property <int> desktop_external_app_index: 0;
    in-out property <int> android_hwdec_index: 0;
    in-out property <bool> is_android: false;
    // --- Player: playback rate (per device) ---------------------------
    // One value edited from both Settings → Player and the player's own
    // settings panel: the slider may sit anywhere in 0.5–2.0, the ± buttons
    // step by 0.05 (quantized by the backend). Local-only, never synced.
    in-out property <float> playback_speed: 1.0;
    in-out property <int> episode_start_index: 1;
    in-out property <bool> resume_prompt_visible: false;
    // --- Settings (animations) ----------------------------------------
    // Master + per-category animation switches (Settings → Look and feel).
    in-out property <bool> animations: true;
    in-out property <bool> anim_transitions: true;
    in-out property <bool> anim_hover: true;
    in-out property <bool> anim_player: true;
    // Navigation feedback (Settings → Look and feel → Navigation): the nav
    // selected icon pops when the bar switches pages. Keep the historical
    // property name to preserve settings and sync compatibility.
    in-out property <bool> anim_nav_slide: true;
    // --- Settings (display) -------------------------------------------
    // Language of the interface (Settings → Display): the picker index into
    // the bundled language list. Local-only, applied to Slint's catalogs by
    // the backend (`src/app/i18n.rs`).
    in-out property <int> language_index: 0;
    // Language names shown in the picker, each in its own language
    // (`nova_config::Language::ALL` → `label()`), so they are not translated;
    // pushed by the backend.
    in-out property <[string]> language_names: ["English", "Hrvatski"];
    // --- Settings (torrent streaming) ---------------------------------
    // Hidden on the web build, which has no embedded BitTorrent client.
    in-out property <bool> show_torrents: true;
    in-out property <bool> torrent_enabled: true;
    in-out property <string> torrent_dir: "";
    in-out property <float> torrent_max_mb: 20480.0;
    in-out property <float> torrent_down_limit: 0.0;
    in-out property <bool> torrent_no_cache: false;
    in-out property <string> torrent_disk_usage: "";
    // Settings → Downloads.
    in-out property <bool> download_auto_delete_watched: false;
    // Settings → Downloads → Downloaded episodes (completed episode files).
    in-out property <[DownloadRow]> downloads_rows: [];
    // --- Settings (cross-device sync) ---------------------------------
    in-out property <bool> sync_enabled: false;
    in-out property <string> sync_identity: "";
    in-out property <[SyncPeer]> sync_peers: [];
    in-out property <string> sync_peer_input: "";
    in-out property <string> sync_status: "";
    // Pairing (Settings → Sync).
    in-out property <string> sync_device_name: "";
    in-out property <bool> sync_pair_confirm: false;
    in-out property <bool> sync_local_discovery: true;
    in-out property <int> sync_interval_index: 1;
    in-out property <bool> sync_background: true;
    in-out property <string> sync_invite_ticket: "";
    // QR rendering of the current ticket (empty until one is created).
    in-out property <image> sync_invite_qr;
    in-out property <[SyncInvite]> sync_invites: [];
    in-out property <string> sync_join_input: "";
    // True on Android, where the camera QR scanner is available.
    in-out property <bool> sync_qr_scan_available: false;
    in-out property <string> sync_link_notice: "";
    in-out property <bool> sync_pair_prompt_visible: false;
    in-out property <string> sync_pair_prompt_id: "";
    in-out property <string> sync_pair_prompt_name: "";
    in-out property <string> sync_pair_prompt_code: "";
    // User-defined library categories.
    in-out property <[CategoryRow]> category_rows: [];
    in-out property <string> category_input: "";
    in-out property <[HomeCatalogRow]> home_catalog_rows: [];
    in-out property <bool> home_continue_enabled: true;
    in-out property <bool> home_upcoming_enabled: true;
    in-out property <[string]> home_catalog_candidate_names: [];
    in-out property <int> home_catalog_candidate_index: -1;
    in-out property <[string]> home_catalog_genre_names: [];
    in-out property <int> home_catalog_genre_index: 0;
    in-out property <bool> home_catalog_add_open: false;
    in-out property <string> home_catalog_add_error: "";
    // Library filter: empty string = show all, otherwise filter by category.
    in-out property <string> library_filter_category: "";
    // Category names for the library filter dropdown.
    in-out property <[string]> library_category_names: [];
    // Display text for `library_category_names` (see library.slint): the
    // automatic buckets are localized for the label only.
    in-out property <[string]> library_category_labels: [];
    // Index of the active filter in library_category_names (-1 = All).
    in-out property <int> library_category_index: -1;
    // Categories assigned to the current modal item (for the detail picker).
    in-out property <[bool]> modal_category_flags: [];
    // Assign-categories popup: visible while the user picks categories
    // for the current library item.
    in-out property <bool> categories_modal: false;
    // Number of categories assigned to the current item (badge on the
    // detail-page Categories pill).
    in-out property <int> selected_category_count: 0;

    in-out property <image> selected_poster;
    in-out property <image> selected_backdrop;
    in-out property <string> selected_title: "";
    in-out property <string> selected_year: "";
    in-out property <string> selected_description: "";
    in-out property <[string]> selected_genre_list: [];
    in-out property <bool> modal_visible: false;
    in-out property <int> selected_index: -1;
    // Detail tab bar: 0 = Overview, 3 = Episodes (1/2 are stubs — the
    // addon protocol provides no Characters/Artwork data).
    in-out property <int> detail_tab: 0;
    // Episode filter box text (Rust re-renders `episode_rows` on change).
    in-out property <string> episode_filter: "";
    // Series episode picker (Stremio/Nuvio-style selection flow).
    // `modal_episodes` shows the season/episode list; when false the
    // streams area is shown instead.
    in-out property <bool> modal_episodes: false;
    in-out property <[string]> season_names: [];
    in-out property <int> season_combo_idx: -1;
    // Art-backed season picker cards, same order as season_names.
    in-out property <[SeasonCard]> season_cards: [];
    in-out property <[EpisodeRow]> episode_rows: [];
    // Episodes tab pagination (Rust slices a season into pages of 50 rows).
    in-out property <int> episode_page: 0;
    in-out property <int> episode_page_count: 1;
    in-out property <int> episode_page_start: 0;
    in-out property <int> episode_total: 0;
    // Stream list pagination (Rust supplies only the active 25-row slice).
    in-out property <int> stream_page: 0;
    in-out property <int> stream_page_count: 1;
    in-out property <int> stream_page_start: 0;
    in-out property <int> stream_total: 0;
    in-out property <string> episode_context: "";
    // True while the streams view was entered directly (Home Continue
    // deep-link) without visiting the episode list: system back then closes
    // the modal instead of revealing the skipped list.
    in-out property <bool> detail_deep_stream: false;
    in-out property <bool> can_load_more: false;
    in-out property <bool> loading_more: false;

    // ---- Keyboard nav state (survives page recreation) -----------------
    // Discover/Library/Detail pages are `if`-gated and destroyed on
    // navigation; their keyboard focus lives here so backing out of an
    // entry returns to the same focused card/row. Bound down with `<=>`.
    in-out property <int> discover_kb_zone: 0;
    in-out property <int> discover_kb_nav: 1;
    in-out property <int> discover_kb_ctl: 0;
    in-out property <int> discover_kb_idx: 0;
    in-out property <int> library_kb_zone: 0;
    in-out property <int> library_kb_nav: 2;
    in-out property <int> library_kb_f: -1;
    in-out property <int> library_kb_idx: 0;
    in-out property <int> detail_kb_zone: 0;
    in-out property <int> detail_kb_top: 0;
    in-out property <int> detail_kb_tab: 0;
    in-out property <int> detail_kb_ci: 2;
    in-out property <int> detail_kb_ep: 0;
    in-out property <int> detail_kb_s: 0;
    in-out property <int> home_kb_zone: 0;
    in-out property <int> home_kb_nav: 0;
    in-out property <int> home_kb_idx: 0;
    in-out property <int> home_kb_up_idx: 0;
    // Keyboard modality: true once the user navigates with arrows/Enter
    // (pages set it in their key handlers), false after mouse clicks.
    // Focus rings/markers show only while true, so mouse-only UI carries
    // no keyboard affordance cost.
    in-out property <bool> kb_active: false;
    // Exact grid scroll offsets: bound two-way to the grid ScrollViews so
    // backing out of an entry restores the absolute position (focus
    // follow-up only guarantees visibility, which drifts slightly).
    in-out property <length> discover_scroll_y: 0px;
    in-out property <length> discover_search_scroll_y: 0px;
    in-out property <length> library_scroll_y: 0px;
    in-out property <length> home_scroll_y: 0px;
    // Home subpage scroll + the two carousel offsets (restored across the
    // detail modal, same mirror pattern as the grids).
    in-out property <length> home_all_scroll_y: 0px;
    in-out property <length> home_continue_x: 0px;
    in-out property <length> home_upcoming_x: 0px;
    // Whole-page scroll on Android (Discover filters scroll away with the
    // grid); desktop keeps the filter header pinned. Set once from Rust.
    in-out property <bool> discover_scroll_page: false;
    // Settings content offset (same mirror pattern as the grids).
    in-out property <length> settings_scroll_y: 0px;

    callback addon_added(string);
    callback addon_toggled(int);
    callback addon_remove(int);
    callback addon_move_up(int);
    callback addon_move_down(int);
    callback addon_configure(string);
    callback addon_refresh(int);
    // Copy an addon's install URL (Settings → Addons → "Copy link"); the row
    // itself only prints the addon name.
    callback addon_copy_link(string);
    callback addon_picked(string);
    callback type_picked(string);
    callback catalog_picked(string);
    callback genre_picked(string);
    callback search_edited(string);
    callback search_submitted(string);
    callback search_back_picked();
    callback search_history_cleared();
    callback search_history_item_removed(string);
    callback item_selected(string, int);
    callback stream_picked(int);
    callback stream_page_picked(int);
    callback stream_action_requested(string);
    callback stream_action_selected(string, int);
    callback stream_filter_picked(int);
    callback season_picked(int);
    callback episode_picked(int);
    // Episodes tab pager move (absolute page; the backend clamps it).
    callback episode_page_picked(int);
    callback episode_toggle_watched(int);
    callback episode_watch_action(int, int);
    callback season_watch_action(int, int);
    callback episodes_back();
    callback detail_tab_picked(int);
    callback episode_filter_changed(string);
    callback watch_now();
    callback modal_closed();
    callback load_more();
    // Preload fetch windows (visible ±2 rows) for poster loading/unloading
    // (Discover / Library).
    callback visible_range(int, int);
    callback library_visible_range(int, int);

    // --- In-app player (same window, like the reference prototype) ------
    // When a stream is picked the catalog is hidden and a full-window
    // player overlay takes over: the video is rendered *under* the whole
    // window (mpv underlay on desktop, HTML5 <video> behind the canvas on
    // web) and the Slint scene only draws this overlay on top. The window
    // background flips to transparent once `playback_started`, so the
    // video shows through. `player_open` = overlay up (catalog hidden).
    in-out property <bool> player_open: false;
    in-out property <bool> playback_started: false;
    in-out property <bool> is_paused: true;
    in-out property <float> position: 0.0;
    in-out property <float> duration: 0.0;
    in-out property <string> time_text: "00:00 / 00:00";
    in-out property <string> player_status: "";
    in-out property <string> player_title: "";
    // Android decoder badge ("HW+" / "HW" / "SW"); empty on other targets.
    in-out property <string> decode_label: "";
    // Android decoder-picker selection (-1 none, 0 HW+, 1 HW, 2 SW). Set
    // optimistically the moment the user picks, then corrected by the backend
    // to whichever decoder mpv actually engages.
    in-out property <int> decoder_selected: -1;
    // Current subtitle / audio selection summaries for the player settings
    // panel's root rows (e.g. the selected language, or "Off"/"None").
    in-out property <string> sub_track_label: "";
    in-out property <string> audio_track_label: "";
    in-out property <float> volume: 100.0;
    in-out property <bool> muted: false;
    in-out property <bool> is_fullscreen: false;
    in-out property <[TrackRow]> audio_tracks: [];
    in-out property <[TrackRow]> sub_tracks: [];
    in-out property <bool> osd_visible: true;
    // The OSD scrim's live (animated) opacity, mirrored up from the player
    // overlay via `osd_opacity_changed`. Rust uses it to match the display
    // frame rate only once the OSD has fully faded out; 0 when no overlay is up.
    in-out property <float> osd_opacity: 0.0;
    in-out property <image> scrim_image;
    in-out property <image> player_poster;

    callback toggle_pause();
    callback seek(float);
    callback close_player();
    callback resume_choice(bool);
    callback resume_cancel();
    callback set_volume(float);
    callback toggle_mute();
    callback pick_audio_track(int);
    callback pick_sub_track(int);
    // Android runtime decoder pick (0 = HW+, 1 = HW, 2 = SW).
    callback pick_decoder(int);
    // Playback rate (player settings panel / Settings → Player, same value):
    // a slider value, or ± one step (the backend quantizes it onto the 0.05
    // grid, applies it to the running session and persists it, debounced).
    callback playback_speed_changed(float);
    callback playback_speed_stepped(int);
    // Transient rate preview (press-and-hold 2×): applied to the running
    // session only, never stored or persisted.
    callback playback_speed_preview(float);
    // Android swipe gestures: brightness notches (±1, scaled to ±0.05 by the
    // backend, which mirrors the level for the readout) and system-volume
    // notches (the system panel is the readout).
    callback android_brightness_step(int);
    callback android_volume_step(int);
    // Session brightness level (0..1) for the swipe readout.
    in-out property <float> player_brightness: 0.5;
    // Android: the player settings modal opened (gear); the backend uses this
    // to query the live decoder state immediately.
    callback settings_opened();
    callback toggle_fullscreen();
    callback osd_mouse_moved();
    callback tracks_popup_opened(int);
    pure callback format_time(float) -> string;
    pure callback format_volume(float) -> string;
    callback library_picked();
    callback discover_picked();
    callback home_picked();
    callback continue_picked(int);
    callback continue_remove(int);
    // "Enter series": open the card's detail page without starting playback.
    callback continue_enter(int);
    callback upcoming_picked(int);
    // Home → Upcoming calendar: open/close the month view, step the visible
    // month (±1), pick a day (epoch days) and open the selected day's first
    // episode (keyboard Enter).
    callback upcoming_cal_open();
    callback upcoming_cal_close();
    callback upcoming_cal_month(int);
    callback upcoming_cal_pick(int);
    callback upcoming_cal_activate();
    callback home_featured_picked();
    callback home_featured_step(int);
    callback library_watch_action(int, int);
    callback library_status_action(int, int);
    callback add_to_library();
    callback remove_library_item(int);
    callback library_item_picked(int);
    // System back on the root screen: background the app (Android only;
    // desktop backends never synthesize Key.Back).
    callback exit_to_background();
    callback settings_picked();
    callback save_settings();
    in-out property <bool> persistence_failed: false;
    callback settings_edited(string);
    callback clear_cache();
    callback reencode_cache();
    callback torrents_changed();
    callback torrent_dir_edited(string);
    callback clear_torrent_cache();
    callback download_auto_delete_watched_changed(bool);
    callback download_list_remove(string);
    callback license_source_requested(string);
    // Cross-device sync (Settings → Sync).
    callback sync_changed();
    callback sync_add_peer(string);
    callback sync_remove_peer(string);
    callback sync_now();
    callback sync_copy_identity();
    callback sync_device_name_edited(string);
    callback sync_pair_confirm_changed(bool);
    callback sync_local_discovery_changed(bool);
    callback sync_interval_picked(int);
    callback sync_background_changed(bool);
    callback sync_create_invite();
    callback sync_cancel_invite(string);
    callback sync_copy_ticket(string);
    callback sync_join_invite(string);
    callback sync_scan_qr();
    callback sync_respond_pair(string, bool);
    callback category_added(string);
    callback category_removed(int);
    callback home_catalog_add_requested();
