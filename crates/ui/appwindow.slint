    // The timer lives on the UI thread beside the live settings/state. Keeping
    // a paused OSD visible does not override an explicit Back/tap dismissal.
    private property <bool> osd_hide_allowed: root.player_open && root.playback_started
        && !PlayerOsdBridge.osd_auto_hide_blocked && !CastBridge.open
        && !(root.is_paused && root.keep_controls_visible_while_paused);
    public function restart_osd_hide() {
        if root.osd_visible && root.osd_hide_allowed {
            osd_hide_timer.start();
            // stop()/start() only change a declarative flag. Their changes can
            // coalesce, leaving an already-running timer at its old deadline.
            osd_hide_timer.restart();
        } else { osd_hide_timer.stop(); }
    }
    changed osd_hide_allowed => { root.restart_osd_hide(); }
    changed is_paused => { root.restart_osd_hide(); }
    changed osd_visible => { root.restart_osd_hide(); }
    osd_hide_timer := Timer {
        interval: root.is_paused ? 5s : 3s;
        running: false;
        triggered => {
            self.stop();
            if root.osd_hide_allowed { root.osd_visible = false; }
        }
    }
    in-out property <bool> osd_visible: true;
    // The OSD scrim's live (animated) opacity, mirrored up from the player
    // overlay via `osd_opacity_changed`. Rust uses it to match the display
    // frame rate only once the OSD has fully faded out; 0 when no overlay is up.
    in-out property <float> osd_opacity: 0.0;
