msgstr "Promijenite datum početka"

msgid "Check episode alignment, progress, score, and date values."
msgstr "Provjerite dodjelu epizoda, napredak, ocjenu i datume."

msgid "Choose a service and search or enter an anime ID."
msgstr "Odaberite uslugu pa pretražite ili unesite ID animea."

msgid "Close"
msgstr "Zatvori"

msgid "Completed"
msgstr "Završeno"

msgid "Confirm alignment"
msgstr "Potvrdite dodjelu"

msgid "Confirm exactly which source rows belong to this release. Saved history is excluded until you choose Apply Nova history."
msgstr "Potvrdite koji izvorni redci pripadaju ovom izdanju. Spremljena povijest isključena je dok ne odaberete Primijenite povijest Nove."

