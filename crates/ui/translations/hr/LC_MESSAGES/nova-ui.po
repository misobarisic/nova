msgstr "Najmanji broj stupaca u Mojoj biblioteci. Primjenjuje se automatski."

msgid "Language"
msgstr "Jezik"

msgid "Language of the interface. Applies to this device only."
msgstr "Jezik sučelja. Primjenjuje se samo na ovom uređaju."

msgid "Stream P2P"
msgstr "P2P prijenos"

