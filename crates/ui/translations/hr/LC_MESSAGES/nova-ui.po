msgid "When off, original downloaded images are cached as-is (default)."
msgstr "Kad je isključeno, izvorne preuzete slike predmemoriraju se takve kakve jesu (zadano)."

msgid "Format"
msgstr "Format"

msgid "Image format used when re-encoding."
msgstr "Format slike koji se koristi pri ponovnom kodiranju."

msgid "Quality"
msgstr "Kvaliteta"

msgid "Encoding quality — lower values mean smaller files."
msgstr "Kvaliteta kodiranja — niže vrijednosti znače manje datoteke."

msgid "Downscale images"
msgstr "Smanjite slike"

msgid "Cap the longest side at 1024 px before encoding (smaller cache)."
msgstr "Ograničite najdulju stranicu na 1024 px prije kodiranja (manja predmemorija)."

msgid "Re-encode on load"
msgstr "Ponovno kodirajte pri učitavanju"

msgid "When an image is loaded, re-encode it to the format/quality above and replace the on-disk cache entry."
msgstr "Kad se slika učita, ponovno je kodirajte u gore navedeni format/kvalitetu i zamijenite zapis u predmemoriji na disku."

msgid "Cache memory"
msgstr "Predmemorija u RAM-u"

msgid "Maximum RAM for decoded posters and thumbnails. Lower if memory is tight."
msgstr "Najveća količina RAM-a za dekodirane plakate i sličice. Smanjite ako ponestaje memorije."

msgid "Re-encode existing cache"
msgstr "Ponovno kodirajte postojeću predmemoriju"

msgid "Rewrite images already cached on disk to the format/quality above. Runs immediately."
msgstr "Prepišite slike već predmemorirane na disku u gore navedeni format/kvalitetu. Izvodi se odmah."

msgid "Re-encode now"
msgstr "Ponovno kodirajte sada"

msgid "Changes save automatically and apply to newly cached images. Use “Re-encode on load” to convert existing images as they are accessed, or “Re-encode now” to rewrite all at once."
msgstr "Promjene se spremaju automatski i primjenjuju se na novo predmemorirane slike. Upotrijebite „Ponovno kodirajte pri učitavanju“ za pretvorbu postojećih slika pri njihovu otvaranju ili „Ponovno kodirajte sada“ za prepisivanje svih odjednom."

msgid "Disk usage"
msgstr "Iskorištenost diska"

