# Anime tracking
msgid "Add tracking or align another release"
msgstr "Dodajte praćenje ili uskladite drugo izdanje"

msgid "Adjust individual assignments below. Leave empty to exclude a source episode."
msgstr "Prilagodite pojedinačne dodjele u nastavku. Ostavite prazno za izuzimanje izvorne epizode."

msgid "Alignment exceeds this release’s episode total."
msgstr "Dodjela premašuje broj epizoda ovog izdanja."

msgid "Alignment preview ready. Unmapped source rows will not update this release."
msgstr "Pregled dodjele je spreman. Nedodijeljeni izvorni redci neće ažurirati ovo izdanje."

msgid "Apply Nova history"
msgstr "Primijenite povijest Nove"

msgid "Cancel sign-in"
msgstr "Odustanite od prijave"

msgid "Change finish date"
msgstr "Promijenite datum završetka"

