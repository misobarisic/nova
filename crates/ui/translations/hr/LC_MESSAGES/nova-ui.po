msgstr "Odustalo se"

msgid "Edit alignment"
msgstr "Uredite dodjelu"

msgid "Edit tracker entry"
msgstr "Uredite zapis praćenja"

msgid "Episode alignment needs review. Queued work is paused."
msgstr "Dodjelu epizoda treba pregledati. Ažuriranja u redu su pauzirana."

msgid "Finish date"
msgstr "Datum završetka"

msgid "AniList token"
msgstr "AniList token"

