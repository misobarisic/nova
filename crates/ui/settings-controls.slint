import { SettingsSync, SettingSyncBadge } from "settings-sync.slint";
import { Theme } from "theme.slint";
import { SliderTouchArea } from "slider-touch.slint";
import { SearchField } from "searchfield.slint";
import { IcExtension, IcTag, IcImage, IcDisplay, IcPlay, IcChevronLeft, IcChevronRight, IcSettingsGear, IcSync, IcDelete, IcHome, IcVideoLibrary } from "icons.slint";
import { KbMark } from "kbnav.slint";
import { Anim } from "anim.slint";

// ---- Shared Settings controls ------------------------

// Purple pill button ("Add", "Save", "Show"…). Primary = filled accent.
export component PillButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> destructive: false;
    in property <length> btn_min_width: 0px;
    // 6-button nav highlight.
    in property <bool> enabled: true;
    in property <bool> focused: false;
    // Finger-sized height on narrow screens (44px touch target).
    in property <bool> roomy: false;
    // Narrower side padding (20px instead of 28px): for rows that must fit
    // more pills than a phone's width allows with the default padding
    // (Settings → Addons stacks seven controls on two lines). Height, colour
    // and touch target are unchanged.
    in property <bool> compact: false;
    callback clicked();
    // Expose the label to the accessibility tree (and headless tests, which
    // locate a specific pill by label rather than by traversal index).
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: root.enabled;
    width: Math.max(pill_lbl.preferred-width + (root.compact ? 20px : 28px), self.btn_min_width);
    height: 44px;
    border-radius: 8px;
    property <bool> outlined: Theme.true_black && !root.primary;
    property <bool> keyboard_focused: (root.focused || (key_focus.has-focus && SettingsStyle.keyboard-mode)) && root.enabled;
    border-width: root.keyboard_focused ? 2px : (root.outlined ? 1px : 0px);
    border-color: root.keyboard_focused ? Theme.current.focus_ring : Theme.current.control_border;
    background: root.destructive ? (touch.has-hover ? Theme.current.destructive_control_hover : Theme.current.destructive_control) : touch.has-hover
    ? (primary ? Theme.current.accent_hover : Theme.current.settings_control_hover)
    : (primary ? Theme.current.accent : Theme.current.settings_control);
    animate background { duration: Anim.hover_fast; }

    pill_lbl := Text {
        text: label;
        font-size: 13px;
        color: root.destructive ? Theme.current.text_destructive : (primary ? Theme.current.on_accent : Theme.current.text_settings);
        vertical-alignment: center;
    }

    key_focus := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            SettingsStyle.keyboard-mode = true;
            if e.text == Key.Return || e.text == " " { root.clicked(); accept } else { reject }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { SettingsStyle.keyboard-mode = false; root.clicked(); }
    }
    property <bool> focus_visible: root.enabled && SettingsStyle.keyboard-mode && (root.focused || key_focus.has-focus);
    changed focus_visible => {
        if (self.focus_visible) {
            SettingsStyle.focus-y = root.absolute-position.y;
            SettingsStyle.focus-height = root.height;
            SettingsStyle.navigation-focus = false;
            SettingsStyle.focus-request += 1;
        }
    }
    forward-focus: key_focus;
    opacity: root.enabled ? 1 : 0.45;

}

// Toggle switch with a 44px interaction area, matching the
// buttons so both share the same vertical center in a row.
export component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    // 6-button nav highlight.
    in property <bool> enabled: true;
    in property <bool> focused: false;
    in property <string> name: "";
    accessible-role: checkbox;
    accessible-label: root.name;
    accessible-checkable: true;
    accessible-checked <=> root.checked;
    accessible-enabled: root.enabled;
    callback toggled();
    width: 44px;
    height: 44px;
    border-width: (focused || (key_focus.has-focus && SettingsStyle.keyboard-mode)) && root.enabled ? 2px : 0px;
    border-color: Theme.current.focus_ring;
    border-radius: 6px;

    Rectangle {
        y: (parent.height - self.height) / 2;
        width: 100%;
        height: 24px;
        border-radius: 12px;
        border-width: 1px;
        border-color: checked ? Theme.current.accent_soft : Theme.current.border_overlay;
        background: checked ? Theme.current.accent_soft : Theme.current.settings_control;
        animate background { duration: Anim.hover_fast; }

        knob := Rectangle {
            x: checked ? parent.width - self.width - 3px : 3px;
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: checked ? Theme.current.toggle_knob_active : Theme.current.toggle_knob;
            animate x { duration: Anim.hover_fast; }
        }
    }

    key_focus := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            SettingsStyle.keyboard-mode = true;
            if e.text == Key.Return || e.text == " " { root.checked = !root.checked; root.toggled(); accept } else { reject }
        }
    }
    TouchArea {
        enabled: root.enabled;
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            SettingsStyle.keyboard-mode = false;
            checked = !checked;
            toggled();
        }
    }
    property <bool> focus_visible: root.enabled && SettingsStyle.keyboard-mode && (root.focused || key_focus.has-focus);
    changed focus_visible => {
        if (self.focus_visible) {
            SettingsStyle.focus-y = root.absolute-position.y;
            SettingsStyle.focus-height = root.height;
            SettingsStyle.navigation-focus = false;
            SettingsStyle.focus-request += 1;
        }
    }
    forward-focus: key_focus;
    opacity: root.enabled ? 1 : 0.45;

}

// Square icon button for the narrow addon rows (configure / refresh /
// remove / move): a 22px glyph on the pill fill, same hover and keyboard
// ring language as PillButton. Labels stay on the accessibility tree via
// `name`, so icon-only buttons keep their translated names.
export component AddonIconButton inherits Rectangle {
    in property <string> name: "";
    in property <bool> destructive: false;
    // 6-button nav highlight.
    in property <bool> enabled: true;
    in property <bool> focused: false;
    // Finger-sized target on narrow screens (44px, like roomy pills);
    // 32px elsewhere, exactly matching ToggleSwitch and text pills so a
    // shared row stays aligned.
    in property <bool> roomy: false;
    callback clicked();
    width: 44px;
    height: 44px;
    border-radius: 16px;
    border-width: (focused || (key_focus.has-focus && SettingsStyle.keyboard-mode)) && root.enabled ? 2px : 0px;
    border-color: Theme.current.focus_ring;
    background: root.destructive ? (touch.has-hover ? Theme.current.destructive_control_hover : Theme.current.destructive_control) : (touch.has-hover ? Theme.current.settings_control_hover : Theme.current.settings_control);
    animate background { duration: Anim.hover_fast; }
    accessible-role: button;
    accessible-label: root.name;
    accessible-enabled: root.enabled;
    @children
    key_focus := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            SettingsStyle.keyboard-mode = true;
            if e.text == Key.Return || e.text == " " { root.clicked(); accept } else { reject }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { SettingsStyle.keyboard-mode = false; root.clicked(); }
    }
    property <bool> focus_visible: root.enabled && SettingsStyle.keyboard-mode && (root.focused || key_focus.has-focus);
    changed focus_visible => {
        if (self.focus_visible) {
            SettingsStyle.focus-y = root.absolute-position.y;
            SettingsStyle.focus-height = root.height;
            SettingsStyle.navigation-focus = false;
            SettingsStyle.focus-request += 1;
        }
    }
    forward-focus: key_focus;
    opacity: root.enabled ? 1 : 0.45;

}

// One addon row on narrow screens: the name owns the first line (toggle +
// title + move arrows) and the remaining actions sit on a second line
// underneath (configure cog, Copy link, refresh, remove) — a phone's row
// offers ~260px for controls, so seven text pills either squeeze the title
// to nothing or spill off the row. Keyboard column order matches the wide
// row's: 0 toggle, 1 Configure, 2 Copy link, 3 Refresh, 4 Remove, 5 move
// up, 6 move down.
export component AddonRowCard inherits Rectangle {
    in property <string> title: "";
    in property <bool> tinted: false;
    in property <bool> on: false;
    in property <bool> has_config: false;
    // Keyboard row focus (zone 2, this row) and modality.
    in property <bool> kb_focused_row: false;
    in property <bool> kb_active: false;
    // Keyboard column on this row (same numbering as the wide row).
    in property <int> kb_col: -1;
    callback toggled(bool);
    callback configure();
    callback copy_link();
    callback refresh();
    callback remove();
    callback move_up();
    callback move_down();

    background: Theme.current.card;

    VerticalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;

        // Row 1: identity + order.
        HorizontalLayout {
            spacing: 12px;

            KbMark { on: root.kb_focused_row; active: root.kb_active; }
            // Centered on the 44px arrow line (a layout child would ride 6px
            // high next to the roomy buttons).
            Rectangle {
                width: 44px;
                height: 44px;

                ToggleSwitch {
                    x: 0px;
                    y: (parent.height - self.height) / 2;
                    checked: root.on;
                    focused: root.kb_active && root.kb_focused_row && root.kb_col == 0;
                    toggled => { root.toggled(self.checked); }
                }
            }

            Text {
                text: root.title;
                font-size: 16px;
                font-weight: 600;
                color: Theme.current.text_bright;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                vertical-alignment: center;
                min-width: 0px;
                wrap: word-wrap;
            }

            AddonIconButton {
                roomy: true;
                name: @tr("Move up");
                focused: root.kb_active && root.kb_focused_row && root.kb_col == 5;
                clicked => { root.move_up(); }
                Text {
                    text: "↑";
                    font-size: 18px;
                    color: Theme.current.text_settings;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            AddonIconButton {
                roomy: true;
                name: @tr("Move down");
                focused: root.kb_active && root.kb_focused_row && root.kb_col == 6;
                clicked => { root.move_down(); }
                Text {
                    text: "↓";
                    font-size: 18px;
                    color: Theme.current.text_settings;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Row 2: actions, in keyboard-column order.
        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            if root.has_config: AddonIconButton {
                roomy: true;
                name: @tr("Configure");
                focused: root.kb_active && root.kb_focused_row && root.kb_col == 1;
                clicked => { root.configure(); }
                IcSettingsGear {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 22px;
                    height: 22px;
                    fill: Theme.current.text_settings;
                }
            }

            PillButton {
                label: @tr("Copy link");
                roomy: true;
                compact: true;
                focused: root.kb_active && root.kb_focused_row && root.kb_col == 2;
                clicked => { root.copy_link(); }
            }

            AddonIconButton {
                roomy: true;
                name: @tr("Refresh");
                focused: root.kb_active && root.kb_focused_row && root.kb_col == 3;
                clicked => { root.refresh(); }
                IcSync {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 22px;
                    height: 22px;
                    fill: Theme.current.text_settings;
                }
            }

            AddonIconButton {
                roomy: true;
                name: @tr("Remove"); destructive: true;
                focused: root.kb_active && root.kb_focused_row && root.kb_col == 4;
                clicked => { root.remove(); }
                IcDelete {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 22px;
                    height: 22px;
                    fill: Theme.current.text_settings;
                }
            }
        }
    }
}

// Slider with a 44px interaction area and restrained accent.
export component MiniSlider inherits Rectangle {
    in-out property <float> value: 0.0;
    in property <float> minimum: 0.0;
    in property <float> maximum: 100.0;
    in property <float> step: 1.0;
    // 6-button nav highlight (Left/Right adjusts when focused).
    in property <bool> enabled: true;
    in property <bool> focused: false;
    callback changed(float);
    height: 44px;
    border-width: (focused || (key_focus.has-focus && SettingsStyle.keyboard-mode)) && root.enabled ? 2px : 0px;
    border-color: Theme.current.focus_ring;
    border-radius: 6px;

    property <float> span: Math.max(maximum - minimum, 0.001);
    property <float> pct: Math.clamp((value - minimum) / span, 0, 1);

    Rectangle {
        x: 0;
        width: 100%;
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.current.slider_track;

        Rectangle {
            x: 0;
            width: root.pct * parent.width;
            height: 100%;
            border-radius: 2px;
            background: Theme.current.accent_soft;
        }
    }

    Rectangle {
        x: root.pct * (parent.width - 14px);
        y: (parent.height - 14px) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Theme.current.accent_soft;
    }

    key_focus := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            SettingsStyle.keyboard-mode = true;
            if e.text == Key.LeftArrow || e.text == Key.RightArrow { root.value = Math.clamp(root.value + (e.text == Key.RightArrow ? root.step : -root.step), root.minimum, root.maximum); root.changed(root.value); accept } else { reject }
        }
    }
    slider_touch := SliderTouchArea {
        enabled: root.enabled;
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        moved => {
            if (!self.pressed) { return; }
            SettingsStyle.keyboard-mode = false;
            value = minimum + Math.clamp(self.mouse-x / self.width, 0, 1) * span;
            value = Math.round(value / root.step) * root.step;
            root.changed(value);
        }
        clicked => {
            SettingsStyle.keyboard-mode = false;
            value = minimum + Math.clamp(self.mouse-x / self.width, 0, 1) * span;
            value = Math.round(value / root.step) * root.step;
            root.changed(value);
        }
    }
    property <bool> focus_visible: root.enabled && SettingsStyle.keyboard-mode && (root.focused || key_focus.has-focus);
    changed focus_visible => {
        if (self.focus_visible) {
            SettingsStyle.focus-y = root.absolute-position.y;
            SettingsStyle.focus-height = root.height;
            SettingsStyle.navigation-focus = false;
            SettingsStyle.focus-request += 1;
        }
    }
    forward-focus: key_focus;
    opacity: root.enabled ? 1 : 0.45;

}

// Segmented option picker (e.g. JPEG | WebP).
export component Segmented inherits HorizontalLayout {
    in property <[string]> labels;
    in-out property <int> current_index: 0;
    // 6-button nav highlight (Left/Right cycles when focused).
    in property <bool> enabled: true;
    in property <bool> focused: false;
    callback picked(int);
    spacing: 0px;

    for opt[i] in labels: Rectangle {
        accessible-role: button;
        accessible-label: opt;
        accessible-enabled: root.enabled;
        width: seg_lbl.preferred-width + 28px;
        height: 44px;
        border-radius: 8px;
        border-width: root.enabled && SettingsStyle.keyboard-mode && ((root.focused && root.current_index == i) || segment_focus.has-focus) ? 2px : 0px;
        border-color: Theme.current.focus_ring;
        background: root.current_index == i ? Theme.current.selection_fill : transparent;
        animate background { duration: Anim.hover_fast; }

        seg_lbl := Text {
            text: opt;
            font-size: 13px;
            color: root.current_index == i ? Theme.current.text_selected : Theme.current.text_settings;
            vertical-alignment: center;
        }

        property <bool> focus_visible: root.enabled && SettingsStyle.keyboard-mode && ((root.focused && root.current_index == i) || segment_focus.has-focus);
        changed focus_visible => {
            if (self.focus_visible) {
                SettingsStyle.focus-y = self.absolute-position.y;
                SettingsStyle.focus-height = self.height;
                SettingsStyle.navigation-focus = false;
                SettingsStyle.focus-request += 1;
            }
        }
        forward-focus: segment_focus;
        segment_focus := FocusScope {
            enabled: root.enabled;
            key-pressed(e) => {
                SettingsStyle.keyboard-mode = true;
                if e.text == Key.Return || e.text == " " { root.current_index = i; root.picked(i); accept } else { reject }
            }
        }
        TouchArea {
            enabled: root.enabled;
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => {
                SettingsStyle.keyboard-mode = false;
                root.current_index = i;
                root.picked(i);
            }
        }
    }
}

// Section title: purple icon + uppercase label.
export component SectionHeader inherits HorizontalLayout {
    in property <int> icon-kind: 0;   // 1 addons, 2 categories, 3 cache, 4 display, 5 player, 6 settings, 7 sync
    in property <string> label;
    spacing: 10px;
    alignment: start;

    Rectangle {
        width: 26px;
        height: 26px;

        if icon-kind == 1: IcExtension {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            fill: Theme.current.accent_soft;
        }
        if icon-kind == 2: IcTag {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            fill: Theme.current.accent_soft;
        }
        if icon-kind == 3: IcImage {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            fill: Theme.current.accent_soft;
        }
        if icon-kind == 4: IcDisplay {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            fill: Theme.current.accent_soft;
        }
        if icon-kind == 5: IcPlay {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            fill: Theme.current.accent_soft;
        }
        if icon-kind == 6: IcSettingsGear {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            fill: Theme.current.accent_soft;
        }
        if icon-kind == 7: IcSync {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            fill: Theme.current.accent_soft;
        }
        if icon-kind == 8: IcImage {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            fill: Theme.current.accent_soft;
        }
    }

    Text {
        text: label;
        font-size: 16px;
        font-weight: 600;
        letter-spacing: 0px;
        color: Theme.current.text_settings;
        vertical-alignment: center;
    }
}

// One setting row: title + description on the left, any control(s) after.
// Rows share a solid card surface and separate with inset rules.
export component SettingsRow inherits Rectangle {
    in property <string> setting-key: "";
    in property <string> row-title: "";
    in property <string> row-desc: "";
    in property <bool> tinted: false;
    in property <length> row-min-height: 64px;
    background: Theme.current.card;

    property <length> inner-width: Math.max(0px, self.width - 32px);
    property <length> control-width: controls.preferred-width;
    property <length> control-height: controls.preferred-height;
    // Keep the text column from sprawling across a very wide settings card,
    // while making its narrow-width limit explicit instead of splitting free
    // space with an invisible spacer.
    property <length> side-text-width: Math.min(
    Math.max(0px, root.inner-width - root.control-width - 16px),
    root.inner-width * 0.62
    );
    property <bool> stack-controls: root.side-text-width < (root.setting-key != "" && SettingsSync.rows[SettingsSync.lookup(root.setting-key)].status == 2 ? 200px : 150px);
    property <length> text-width: root.stack-controls
    ? root.inner-width
    : root.side-text-width;
    property <length> text-height: measure_col.preferred-height;

    // Keep at least 150px for a readable text column. Rows whose controls
    // would crowd it instead put the controls on a second line; small controls
    // such as toggles stay beside their text. The wrapped measurement is at
    // that same live text width, so both layouts reserve enough height for
    // titles and descriptions that wrap.
    height: Math.max(
    row-min-height,
    28px + (root.stack-controls
    ? root.text-height + 10px + root.control-height
    : Math.max(root.text-height, root.control-height))
    );

    Rectangle { x: 16px; y: parent.height - 1px; width: Math.max(0px, parent.width - 32px); height: 1px; background: Theme.current.border_subtle; }

    title_col := VerticalLayout {
        x: 16px;
        y: root.stack-controls
        ? 14px
        : (root.height - self.height) / 2;
        width: root.text-width;
        height: root.text-height;
        alignment: center;
        spacing: 3px;

        Text {
            text: row-title;
            font-size: 16px;
            font-weight: 600;
            color: Theme.current.text_bright;
            // min-width: 0 lets the column shrink past a long unbreakable token
            // (an addon URL, a slug) without widening the settings page.
            min-width: 0px;
            wrap: word-wrap;
        }

        if root.setting-key != "": SettingSyncBadge { setting_key: root.setting-key; setting_title: root.row-title; max-width: root.text-width; }

        if row-desc != "": Text {
            text: row-desc;
            font-size: 14px;
            color: Theme.current.text_settings;
            min-width: 0px;
            wrap: word-wrap;
        }
    }

    // A single slot keeps caller-provided controls intact (including grouped
    // controls). It is right-aligned beside the text when there is room, and
    // left-aligned below it when the control group would leave under 150px for
    // the label and description.
    controls := HorizontalLayout {
        x: root.stack-controls
        ? 16px
        : root.width - 16px - root.control-width;
        y: root.stack-controls
        ? 14px + root.text-height + 10px
        : (root.height - self.height) / 2;
        width: root.stack-controls ? root.inner-width : root.control-width;
        height: root.control-height;
        alignment: start;

        @children
    }

    // Hidden measurement copy of the whole text column (same text, fonts,
    // width and spacing as `title_col`; clipped to zero height so it renders
    // nothing) — its natural wrapped height drives the row minimum above.
    Rectangle {
        x: 0px;
        y: 0px;
        height: 0;
        clip: true;

        measure_col := VerticalLayout {
            width: title_col.width;
            spacing: 3px;

            Text {
                text: row-title;
                font-size: 16px;
                font-weight: 600;
                wrap: word-wrap;
                min-width: 0px;
            }

            if root.setting-key != "": Rectangle { height: 26px; }

            if row-desc != "": Text {
                text: row-desc;
                font-size: 14px;
                wrap: word-wrap;
                min-width: 0px;
            }
        }
    }
}

// Bordered value readout shown under sliders.
export component ValueBox inherits Rectangle {
    in property <string> text;
    width: 120px;
    height: 30px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.current.border_overlay;
    background: Theme.current.card;

    Text {
        text: text;
        font-size: 13px;
        color: Theme.current.text_bright;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

// Landing-page entry: icon + title + subtitle + chevron. Tapping opens the
// corresponding settings subpage (see `open_page`).
export component SettingsLink inherits Rectangle {
    in property <int> icon-kind: 0;   // 0 addons, 1 categories, 2 cache, 3 display, 4 torrents, 5 player, 6 look-and-feel, 7 sync
    in property <string> destination-id: "";
    in property <bool> selected: false;
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <bool> enabled: true;
    in property <bool> focused: false;
    // False while a subpage is open: blocks taps that would fall through the
    // subpage layer (Slint hit-tests TouchAreas regardless of z-order).
    in property <bool> interactive: true;
    callback picked();

    accessible-role: button;
    accessible-id: root.destination-id;
    accessible-label: root.title;
    accessible-description: root.subtitle;
    height: Math.max(72px, 28px + link_measure.preferred-height);
    Rectangle {
        height: 0px; clip: true;
        link_measure := VerticalLayout {
            width: Math.max(0px, root.width - 128px); spacing: 2px;
            Text { text: root.title; font-size: 16px; font-weight: 600; wrap: word-wrap; min-width: 0px; }
            if root.subtitle != "": Text { text: root.subtitle; font-size: 14px; wrap: word-wrap; min-width: 0px; }
        }
    }
    border-radius: 8px;
    border-width: SettingsStyle.keyboard-mode && (root.focused || link_focus.has-focus) ? 2px : 0px;
    border-color: Theme.current.focus_ring;
    background: root.selected ? Theme.current.settings_selected_wash : (touch.has-hover && interactive ? Theme.current.settings_control : Theme.current.card);
    animate background { duration: Anim.hover_fast; }

    HorizontalLayout {
        width: 100%; height: 100%;
        cross-axis-alignment: center;
        padding-top: 14px;
        padding-bottom: 14px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;

        Rectangle {
            width: 34px;
            height: 34px;

            if root.icon-kind == 0: IcExtension {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                fill: Theme.current.accent_soft;
            }
            if root.icon-kind == 1: IcTag {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                fill: Theme.current.accent_soft;
            }
            if root.icon-kind == 2: IcImage {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                fill: Theme.current.accent_soft;
            }
            if root.icon-kind == 3: IcDisplay {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                fill: Theme.current.accent_soft;
            }
            if root.icon-kind == 4: IcTag {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                fill: Theme.current.accent_soft;
            }
            if root.icon-kind == 5: IcPlay {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                fill: Theme.current.accent_soft;
            }
            if root.icon-kind == 6 || root.icon-kind == 14: IcSettingsGear {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                fill: Theme.current.accent_soft;
            }
            if root.icon-kind == 13: IcHome { x: 7px; y: 7px; width: 20px; height: 20px; fill: Theme.current.accent_soft; }
            if root.icon-kind == 6 || root.icon-kind == 10: IcSettingsGear { x: 7px; y: 7px; width: 20px; height: 20px; fill: Theme.current.accent_soft; }
            if root.icon-kind == 9: IcVideoLibrary { x: 7px; y: 7px; width: 20px; height: 20px; fill: Theme.current.accent_soft; }
            if root.icon-kind == 11: IcTag { x: 7px; y: 7px; width: 20px; height: 20px; fill: Theme.current.accent_soft; }
            if root.icon-kind == 12: IcSync { x: 7px; y: 7px; width: 20px; height: 20px; fill: Theme.current.accent_soft; }
            if root.icon-kind == 7: IcSync {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                fill: Theme.current.accent_soft;
            }
            if root.icon-kind == 8: IcImage {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                fill: Theme.current.accent_soft;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                font-size: 16px;
                font-weight: 600;
                color: Theme.current.text_bright;
                wrap: word-wrap;
                min-width: 0px;
            }

            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: 14px;
                color: Theme.current.text_settings;
                wrap: word-wrap;
                min-width: 0px;
            }
        }

        Rectangle {
            width: 34px;
            height: 34px;

            IcChevronRight {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                fill: Theme.current.settings_icon_muted;
            }
        }
    }

    forward-focus: link_focus;
    property <bool> focus_visible: root.interactive && SettingsStyle.keyboard-mode && (root.focused || link_focus.has-focus);
    changed focus_visible => {
        if (self.focus_visible) {
            SettingsStyle.focus-y = root.absolute-position.y;
            SettingsStyle.focus-height = root.height;
            SettingsStyle.navigation-focus = true;
            SettingsStyle.focus-request += 1;
        }
    }
    link_focus := FocusScope {
        enabled: root.interactive;
        key-pressed(e) => {
            SettingsStyle.keyboard-mode = true;
            if (e.text == Key.Return || e.text == " ") { root.picked(); accept } else { reject }
        }
    }
    touch := TouchArea {
        enabled: root.interactive;
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { SettingsStyle.keyboard-mode = false; root.picked(); }
    }
}


export global SettingsStyle {
    in-out property <bool> keyboard-mode: false;
    in-out property <length> focus-y;
    in-out property <length> focus-height;
    in-out property <bool> navigation-focus: false;
    in-out property <int> focus-request: 0;
}
export component SettingsCard inherits Rectangle {
    background: Theme.current.card; border-radius: Theme.card_corner_radius; border-width: 1px; border-color: Theme.current.border_soft;
    vertical-stretch: 0; clip: true;
    VerticalLayout { spacing: 0px; @children }
}
export component NumericSetting inherits Rectangle {
    in-out property <float> value;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step: 1;
    in property <string> suffix: "";
    in property <bool> enabled: true;
    in property <bool> focused: false;
    callback changed(float);
    preferred-width: 252px; min-width: 0px; height: 44px;
    HorizontalLayout {
        spacing: 4px;
        PillButton { label: "−"; enabled: root.enabled && root.value > root.minimum; compact: true; btn_min_width: 44px;
            clicked => { root.value = Math.max(root.minimum, root.value - root.step); root.changed(root.value); } }
        MiniSlider { min-width: 36px; horizontal-stretch: 1; enabled: root.enabled; focused: root.focused;
            value <=> root.value; minimum: root.minimum; maximum: root.maximum; step: root.step;
            changed(v) => { root.changed(v); } }
        ValueBox { width: root.suffix == "" ? 36px : 68px; height: 44px; text: Math.round(root.value) + root.suffix; }
        PillButton { label: "+"; enabled: root.enabled && root.value < root.maximum; compact: true; btn_min_width: 44px;
            clicked => { root.value = Math.min(root.maximum, root.value + root.step); root.changed(root.value); } }
    }
}
