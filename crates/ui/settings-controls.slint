// Header captions and controls; SettingsPage owns the edge-to-edge artwork.
export component SettingsHeader inherits Rectangle {
    in property <string> title;
    in property <string> introduction;
    in property <bool> overview: false;
    callback back();
    vertical-stretch: 0;
    height: Math.max(108px, heading_measure.preferred-height + intro_measure.preferred-height + 48px);
    clip: true;
    Rectangle {
        height: 0px; clip: true;
        heading_measure := Text { width: Math.max(0px, root.width - (root.overview ? 32px : 88px)); text: root.title; font-size: root.overview ? 32px : 24px; font-weight: 700; wrap: word-wrap; }
        intro_measure := Text { width: Math.max(0px, root.width - 32px); text: root.introduction; font-size: 14px; wrap: word-wrap; }
    }
    VerticalLayout {
        padding: 16px; spacing: 8px;
        HorizontalLayout {
            spacing: 12px;
            if !root.overview: Rectangle {
                width: 44px; height: 44px; border-radius: 22px;
                background: back_touch.has-hover ? Theme.current.settings_control_hover : Theme.current.settings_control;
                border-width: back_focus.has-focus && SettingsStyle.keyboard-mode ? 2px : 0px;
                border-color: Theme.current.focus_ring;
                accessible-role: button; accessible-label: @tr("Back");
                forward-focus: back_focus;
                IcChevronLeft { width: 20px; height: 20px; x: 12px; y: 12px; fill: Theme.current.text_settings; }
                back_focus := FocusScope {
                    key-pressed(e) => {
                        SettingsStyle.keyboard-mode = true;
                        if e.text == Key.Return || e.text == " " { root.back(); accept } else { reject }
                    }
                }
                back_touch := TouchArea { width: 100%; height: 100%; mouse-cursor: pointer; clicked => { SettingsStyle.keyboard-mode = false; root.back(); } }
            }
            Text { text: root.title; font-size: root.overview ? 32px : 24px; font-weight: 700; color: Theme.current.text_bright; wrap: word-wrap; min-width: 0px; vertical-alignment: center; }
        }
        Text { text: root.introduction; font-size: 14px; color: Theme.current.text_settings; wrap: word-wrap; min-width: 0px; }
    }
}

// Account editors use the same caret/IME handling without a pointer focus ring.
export component SettingsInput inherits SearchField {
    roomy: true;
    show-pointer-focus: false;
    keyboard-mode: SettingsStyle.keyboard-mode;
    background: Theme.current.settings_control;
    property <bool> focus-visible: root.has-focus && SettingsStyle.keyboard-mode;
    changed focus-visible => {
        if (self.focus-visible) {
            SettingsStyle.focus-y = root.absolute-position.y;
            SettingsStyle.focus-height = root.height;
            SettingsStyle.navigation-focus = false;
            SettingsStyle.focus-request += 1;
        }
    }
    accessible-role: text-input;
    accessible-label: root.placeholder-text;
    accessible-value <=> root.text;
    accessible-action-set-value(v) => { root.text = v; root.edited(v); }
}
