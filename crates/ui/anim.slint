// Animation control global (Settings → Look and feel).
//
// Every `animate` in the UI reads one of the duration properties below
// instead of a literal duration. The backend flips the `in-out` switches
// from the persisted settings, so toggling animations takes effect
// immediately (0ms makes the property change instant). `enabled` is the
// master switch; the category switches only matter while it is on.
export global Anim {
    in-out property <bool> enabled: true;
    in-out property <bool> transitions: true;
    in-out property <bool> hover: true;
    in-out property <bool> player: true;
    in-out property <bool> nav_slide: true;

    // Page / subpage slide and entrance fades.
    out property <duration> transition_slide: (enabled && transitions) ? 260ms : 0ms;
    out property <duration> transition_fade: (enabled && transitions) ? 220ms : 0ms;
    // Hover / focus feedback (button fills, card lift, toggle knob, …).
    out property <duration> hover_fast: (enabled && hover) ? 120ms : 0ms;
    out property <duration> hover_lift: (enabled && hover) ? 150ms : 0ms;
    // Player OSD fades and control reveals.
    out property <duration> player_fade: (enabled && player) ? 200ms : 0ms;
    out property <duration> player_slide: (enabled && player) ? 150ms : 0ms;
    out property <duration> player_fast: (enabled && player) ? 120ms : 0ms;
    // Keep the persisted nav_slide switch for compatibility; navigation now
    // uses icon-only feedback, never a travelling highlight.
    out property <duration> nav_feedback: (enabled && nav_slide) ? 220ms : 0ms;
}
