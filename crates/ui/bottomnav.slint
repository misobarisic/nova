import { Theme } from "theme.slint";
import { IcHome, IcExplore, IcVideoLibrary, IcSettingsGear } from "icons.slint";
import { NavFeedback } from "sidenav.slint";

// A flat, labelled phone bar. The selected icon and label turn purple;
// selection snaps immediately and NavFeedback only pops the incoming icon.
// Host pages reserve the bar's height in their layout. Their existing page
// insets are bled out by the panel so its geometry stays identical on each
// page, while the labels and touch targets respect the window's safe area.
export component BottomNav inherits Rectangle {
    // 0 Home, 1 Discover, 2 Library, 3 Settings.
    in property <int> active: 0;
    in property <length> safe-bottom: 0px;
    in property <length> safe-left: 0px;
    in property <length> safe-right: 0px;
    in property <length> page-inset-left: 0px;
    in property <length> page-inset-right: 0px;
    in property <int> kb_zone;
    in property <int> kb_nav;
    in-out property <bool> kb_active;

    callback home_picked();
    callback discover_picked();
    callback library_picked();
    callback settings_picked();

    width: 100%;
    height: 68px + root.safe-bottom;
    vertical-stretch: 0;

    motion := NavFeedback { active: root.active; }

    pill := Rectangle {
        x: -root.page-inset-left;
        y: 0px;
        width: root.width + root.page-inset-left + root.page-inset-right;
        height: root.height;
        background: Theme.current.nav_bottom;
        // Square corners keep the full-width bar flush against screen edges.
        border-radius: 0px;
        border-width: 0px;
        // The panel meets the page without shading the content gutter above it.

        // Gaps and the system-bar safe zone also absorb taps, preventing
        // touches beside a tab from opening content behind the bar.
        eater := TouchArea {
            width: 100%; height: 100%;
            clicked => { }
        }

        // Equal-width slots keep labels and keyboard focus aligned without
        // a selected background or a shadow above the page canvas.
        tabs := HorizontalLayout {
            x: 12px + root.safe-left;
            y: 0px;
            width: pill.width - 24px - root.safe-left - root.safe-right;
            height: 60px;

            Rectangle {
                width: tabs.width / 4;
                height: 100%;

                Rectangle {
                    x: 4px; y: 0px;
                    width: parent.width - 8px; height: 60px;
                    border-radius: 28px;
                    border-width: root.kb_active && root.kb_zone == 0 && root.kb_nav == 0 ? 2px : 0px;
                    border-color: Theme.current.text_bright;
                    background: transparent;
                }

                icon_home := IcHome {
                    x: (parent.width - self.width) / 2;
                    y: 19px - self.height / 2;
                    width: 24px + (root.active == 0 ? motion.pulse * 2px : 0px);
                    height: self.width;
                    fill: root.active == 0 ? Theme.current.accent_soft : Theme.current.nav_icon_inactive;
                }
                label_home := Text {
                    x: 4px; y: 36px;
                    width: parent.width - 8px; height: 17px;
                    text: @tr("Home");
                    font-size: 12px;
                    font-weight: root.active == 0 ? 600 : 400;
                    color: root.active == 0 ? Theme.current.accent_soft : Theme.current.nav_label_inactive;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
                tab_home := TouchArea {
                    width: 100%; height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.kb_active = false; root.home_picked(); }
                }
            }

            Rectangle {
                width: tabs.width / 4;
                height: 100%;

                Rectangle {
                    x: 4px; y: 0px;
                    width: parent.width - 8px; height: 60px;
                    border-radius: 28px;
                    border-width: root.kb_active && root.kb_zone == 0 && root.kb_nav == 1 ? 2px : 0px;
                    border-color: Theme.current.text_bright;
                    background: transparent;
                }

                icon_discover := IcExplore {
                    x: (parent.width - self.width) / 2;
                    y: 19px - self.height / 2;
                    width: 24px + (root.active == 1 ? motion.pulse * 2px : 0px);
                    height: self.width;
                    fill: root.active == 1 ? Theme.current.accent_soft : Theme.current.nav_icon_inactive;
                }
                label_discover := Text {
                    x: 4px; y: 36px;
                    width: parent.width - 8px; height: 17px;
                    text: @tr("Discover");
                    font-size: 12px;
                    font-weight: root.active == 1 ? 600 : 400;
                    color: root.active == 1 ? Theme.current.accent_soft : Theme.current.nav_label_inactive;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
                tab_discover := TouchArea {
                    width: 100%; height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.kb_active = false; root.discover_picked(); }
                }
            }

            Rectangle {
                width: tabs.width / 4;
                height: 100%;

                Rectangle {
                    x: 4px; y: 0px;
                    width: parent.width - 8px; height: 60px;
                    border-radius: 28px;
                    border-width: root.kb_active && root.kb_zone == 0 && root.kb_nav == 2 ? 2px : 0px;
                    border-color: Theme.current.text_bright;
                    background: transparent;
                }

                icon_library := IcVideoLibrary {
                    x: (parent.width - self.width) / 2;
                    y: 19px - self.height / 2;
                    width: 24px + (root.active == 2 ? motion.pulse * 2px : 0px);
                    height: self.width;
                    fill: root.active == 2 ? Theme.current.accent_soft : Theme.current.nav_icon_inactive;
                }
                label_library := Text {
                    x: 4px; y: 36px;
                    width: parent.width - 8px; height: 17px;
                    text: @tr("Library");
                    font-size: 12px;
                    font-weight: root.active == 2 ? 600 : 400;
                    color: root.active == 2 ? Theme.current.accent_soft : Theme.current.nav_label_inactive;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
                tab_library := TouchArea {
                    width: 100%; height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.kb_active = false; root.library_picked(); }
                }
            }

            Rectangle {
                width: tabs.width / 4;
                height: 100%;

                Rectangle {
                    x: 4px; y: 0px;
                    width: parent.width - 8px; height: 60px;
                    border-radius: 28px;
                    border-width: root.kb_active && root.kb_zone == 0 && root.kb_nav == 3 ? 2px : 0px;
                    border-color: Theme.current.text_bright;
                    background: transparent;
                }

                icon_settings := IcSettingsGear {
                    x: (parent.width - self.width) / 2;
                    y: 19px - self.height / 2;
                    width: 24px + (root.active == 3 ? motion.pulse * 2px : 0px);
                    height: self.width;
                    fill: root.active == 3 ? Theme.current.accent_soft : Theme.current.nav_icon_inactive;
                }
                label_settings := Text {
                    x: 4px; y: 36px;
                    width: parent.width - 8px; height: 17px;
                    text: @tr("Settings");
                    font-size: 12px;
                    font-weight: root.active == 3 ? 600 : 400;
                    color: root.active == 3 ? Theme.current.accent_soft : Theme.current.nav_label_inactive;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
                tab_settings := TouchArea {
                    width: 100%; height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.kb_active = false; root.settings_picked(); }
                }
            }
        }
    }
}
