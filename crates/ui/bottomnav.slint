import { KbMark } from "kbnav.slint";
import { IcHome, IcSearch, IcVideoLibrary, IcSettingsGear } from "icons.slint";
import { NavFeedback } from "sidenav.slint";

// Bottom tab bar for narrow (phone) layouts: a compact floating capsule,
// centered with fixed side margins, icons only — the active tab gets an
// accent circle behind its icon (reference-dock style). Thumb-friendly
// targets, lifted above the Android system bar via `safe-bottom`.
// Wide windows use the left rail (sidenav.slint) instead; pages switch
// between the two on `narrow`. Same TouchArea-driven taps as the cards.
//
// The accent circle is a single marker shared by the four tabs (not one
// background per tab), snapping to the picked tab. The shared NavFeedback
// driver only pops the incoming icon; the marker never travels or stretches.
//
// The pill sizes itself (capped width, side margins) so every host page
// renders it identically — host layout padding must not affect it.
// A tap-eating backdrop swallows stray taps in gaps/margins: plain
// Rectangles don't consume taps in Slint, and without it taps beside a
// tab would fall through to cards underneath.
export component BottomNav inherits Rectangle {
    // Active section: 0 Home, 1 Discover, 2 Library, 3 Settings.
    in property <int> active: 0;
    // Bottom system-bar inset (Android gesture/nav bar). 0 on desktop.
    in property <length> safe-bottom: 0px;
    in property <int> kb_zone;
    in property <int> kb_nav;
    in-out property <bool> kb_active;

    callback home_picked();
    callback discover_picked();
    callback library_picked();
    callback settings_picked();

    width: 100%;
    // 64px touch bar + system inset, pinned so content above never shifts.
    height: 64px + root.safe-bottom;

    motion := NavFeedback { active: root.active; }

    // Eats stray taps anywhere in the bar footprint (gaps between tabs,
    // side margins, safe zone) so they never reach content underneath.
    eater := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { }
    }

    // Centered compact capsule: capped width with fixed side margins
    // instead of spanning the window.
    HorizontalLayout {
        width: 100%;
        height: 100%;
        alignment: center;

        pill := Rectangle {
            width: Math.min(280px, parent.width - 96px);
            height: 64px;
            background: #17171d;
            border-radius: 32px;
            border-width: 1px;
            border-color: #2a2a33;
            clip: true;

            // The shared accent marker. The four items stretch equally across
            // the capsule's inner width, so the pitch follows the capsule
            // (8px side padding); the circle is centered in its item's slot.
            // Declared before the item row, which draws the icons over it.
            marker_dot := Rectangle {
                property <length> pitch: (pill.width - 16px) / 4;
                width: 48px;
                height: 48px;
                x: 8px + root.active * pitch + (pitch - self.width) / 2;
                y: (pill.height - self.height) / 2;
                border-radius: 24px;
                background: #8b5cf6;
            }

            HorizontalLayout {
                width: 100%;
                height: 100%;
                padding-left: 8px;
                padding-right: 8px;

                KbMark { on: root.kb_zone == 0 && root.kb_nav == 0; active: root.kb_active; }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 100%;

                    icon_home := IcHome {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 24px + (root.active == 0 ? motion.pulse * 2px : 0px);
                        height: self.width;
                        fill: root.active == 0 ? #ffffff : #8a8a9a;
                    }

                    tab_home := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.kb_active = false; root.home_picked(); }
                    }
                }

                KbMark { on: root.kb_zone == 0 && root.kb_nav == 1; active: root.kb_active; }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 100%;

                    icon_discover := IcSearch {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 24px + (root.active == 1 ? motion.pulse * 2px : 0px);
                        height: self.width;
                        fill: root.active == 1 ? #ffffff : #8a8a9a;
                    }

                    tab_discover := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.kb_active = false; root.discover_picked(); }
                    }
                }

                KbMark { on: root.kb_zone == 0 && root.kb_nav == 2; active: root.kb_active; }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 100%;

                    icon_library := IcVideoLibrary {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 24px + (root.active == 2 ? motion.pulse * 2px : 0px);
                        height: self.width;
                        fill: root.active == 2 ? #ffffff : #8a8a9a;
                    }

                    tab_library := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.kb_active = false; root.library_picked(); }
                    }
                }

                KbMark { on: root.kb_zone == 0 && root.kb_nav == 3; active: root.kb_active; }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 100%;

                    icon_settings := IcSettingsGear {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 24px + (root.active == 3 ? motion.pulse * 2px : 0px);
                        height: self.width;
                        fill: root.active == 3 ? #ffffff : #8a8a9a;
                    }

                    tab_settings := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.kb_active = false; root.settings_picked(); }
                    }
                }
            }
        }
    }
}
