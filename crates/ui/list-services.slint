import { SettingsBridge, Theme } from "@NovaUiShared";
import { PillButton, SettingsInput, SettingsRow, ToggleSwitch } from "settings-controls.slint";
import { TrackingAccountCard } from "tracking-account-card.slint";
import { CheckBox } from "std-widgets.slint";

export component ListServiceSettings inherits TrackingAccountCard {
    in property <int> service;
    property <string> client_value;
    property <string> token_value;
    property <string> client_full;
    property <string> token_full;
    property <bool> client_focused: false;
    property <bool> token_focused: false;
    out property <bool> input_focused: root.client_focused || root.token_focused;
    in property <bool> blur;
    changed blur => { root.release_focus(); }
    function release_focus() { blur_scope.focus(); root.client_focused = false; root.token_focused = false; }
    blur_scope := FocusScope { width: 1px; height: 1px; }
    property <bool> full_library_draft: false;
    title: root.service == 0 ? "Simkl" : "MDBList";
    status: SettingsBridge.list_services_account[root.service] != "" ? SettingsBridge.list_services_account[root.service] : @tr("Not connected");
    brand_color: root.service == 0 ? #176c99 : #315f3d;
    brand_dark: root.service == 0 ? #12344e : #183522;
    VerticalLayout {
        alignment: start; spacing: 12px;
        Text { text: @tr("Choose titles on their Tracking page. Connecting an account does not upload your library."); color: Theme.current.text_settings; wrap: word-wrap; min-width: 0px; }
        Text { text: SettingsBridge.list_services_status[root.service]; color: Theme.current.text_tracking_notice; wrap: word-wrap; min-width: 0px; }
        if !SettingsBridge.list_services_connected[root.service]: Text { text: root.service == 0 ? @tr("Enter your Simkl application client ID and access token. Tokens are verified before use.") : @tr("Create an API key in MDBList preferences and paste it below."); color: Theme.current.text_settings; wrap: word-wrap; min-width: 0px; }
        if root.service == 0 && !SettingsBridge.list_services_connected[root.service]: SettingsInput { placeholder-text: @tr("Simkl client ID"); accessible-label: @tr("Simkl client ID"); text <=> root.client_value; changed full-text => { root.client_full = self.full-text; } changed has-focus => { root.client_focused = self.has-focus; } }
        if !SettingsBridge.list_services_connected[root.service]: SettingsInput { placeholder-text: root.service == 0 ? @tr("Simkl access token") : @tr("MDBList API key"); accessible-label: self.placeholder-text; input-type: password; text <=> root.token_value; changed full-text => { root.token_full = self.full-text; } changed has-focus => { root.token_focused = self.has-focus; } }
        if !SettingsBridge.list_services_connected[root.service]: PillButton { label: @tr("Connect"); primary: true; enabled: !SettingsBridge.list_services_busy[root.service]; clicked => { SettingsBridge.list_services_connect(root.service, root.service == 0 ? root.client_full : "", root.token_full); root.release_focus(); root.token_value = ""; root.token_full = ""; } }
        if !SettingsBridge.list_services_connected[root.service]: PillButton { label: @tr("Open account settings"); clicked => { SettingsBridge.list_services_open_account(root.service); } }
        if SettingsBridge.list_services_connected[root.service]: SettingsRow { row-title: SettingsBridge.list_services_whole_library[root.service] ? @tr("Automatic sync") : @tr("Automatic sync for selected titles"); ToggleSwitch { name: SettingsBridge.list_services_whole_library[root.service] ? @tr("Automatic sync") : @tr("Automatic sync for selected titles"); checked: SettingsBridge.list_services_automatic[root.service]; toggled => { SettingsBridge.list_services_automatic_changed(root.service, self.checked); } } }
        if SettingsBridge.list_services_connected[root.service] && !SettingsBridge.list_services_whole_library[root.service]: CheckBox { text: @tr("Sync the full library"); checked <=> root.full_library_draft; }
        if SettingsBridge.list_services_connected[root.service]: Text { text: @tr("Full-library sync imports and exports all supported saved titles and watched episodes. Custom lists and ratings are preserved."); color: Theme.current.text_settings; wrap: word-wrap; min-width: 0px; }
        if SettingsBridge.list_services_connected[root.service]: PillButton { label: root.full_library_draft && !SettingsBridge.list_services_whole_library[root.service] ? @tr("Start full-library sync") : @tr("Sync now"); primary: true; enabled: !SettingsBridge.list_services_busy[root.service]; clicked => { if root.full_library_draft { SettingsBridge.list_services_scope_changed(root.service, true); } else { SettingsBridge.list_services_sync(root.service); } } }
        if SettingsBridge.list_services_connected[root.service] && SettingsBridge.list_services_whole_library[root.service]: PillButton { label: @tr("Use selected titles only"); clicked => { root.full_library_draft = false; SettingsBridge.list_services_scope_changed(root.service, false); } }
        if SettingsBridge.list_services_connected[root.service] || SettingsBridge.list_services_account[root.service] != "": PillButton { label: @tr("Disconnect"); destructive: true; clicked => { SettingsBridge.list_services_disconnect(root.service); } }
        if SettingsBridge.list_services_busy[root.service]: PillButton { label: @tr("Cancel"); clicked => { SettingsBridge.list_services_cancel(root.service); } }
    }
}
