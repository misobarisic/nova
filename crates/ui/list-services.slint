import { SettingsBridge, Theme } from "@NovaUiShared";
import { PillButton, SettingsInput, SettingsRow, ToggleSwitch } from "settings-controls.slint";
import { TrackingAccountCard } from "tracking-account-card.slint";
import { Dropdown } from "dropdown.slint";

export component ListServiceSettings inherits TrackingAccountCard {
    in property <int> service;
    property <string> client_value;
    property <string> token_value;
    property <string> client_full;
    property <string> token_full;
    property <bool> client_focused: false;
    property <bool> token_focused: false;
    out property <bool> input_focused: root.client_focused || root.token_focused;
    in property <bool> blur;
    changed blur => { root.release_focus(); }
    function release_focus() { blur_scope.focus(); root.client_focused = false; root.token_focused = false; }
    blur_scope := FocusScope { width: 1px; height: 1px; }
    // Choosing full-library mode is only a draft. Account/session changes and
    // asynchronous work must never turn an old selection into new consent.
    property <bool> full_library_draft: false;
    property <bool> connected: SettingsBridge.list_services_connected[root.service];
    property <bool> busy: SettingsBridge.list_services_busy[root.service];
    property <bool> whole_library: SettingsBridge.list_services_whole_library[root.service];
    property <string> account: SettingsBridge.list_services_account[root.service];
    changed service => { root.full_library_draft = false; }
    changed connected => { root.full_library_draft = false; }
    changed busy => { root.full_library_draft = false; }
    changed whole_library => { root.full_library_draft = false; }
    changed account => { root.full_library_draft = false; }
    toggled => { if !root.expanded { root.full_library_draft = false; } }
    title: root.service == 0 ? "Simkl" : root.service == 1 ? "MDBList" : "Trakt";
    logo: root.service == 0 ? @image-url("../../assets/icons/services/simkl.svg") : root.service == 1 ? @image-url("../../assets/icons/services/mdblist.svg") : @image-url("../../assets/icons/services/trakt.svg");
    status: SettingsBridge.list_services_account[root.service] != "" ? SettingsBridge.list_services_account[root.service] : @tr("Not connected");
    brand_color: root.service == 0 ? #176c99 : root.service == 1 ? #315f3d : #9e252b;
    brand_dark: root.service == 0 ? #12344e : root.service == 1 ? #183522 : #48191e;
    VerticalLayout {
        alignment: start; spacing: 12px;
        Text { text: SettingsBridge.list_services_status[root.service]; color: Theme.current.text_tracking_notice; wrap: word-wrap; min-width: 0px; }
        SettingsRow {
            row-title: @tr("Sync mode");
            Dropdown {
                accessible-role: combobox;
                accessible-label: root.title + " · " + @tr("Sync mode");
                accessible-enabled: self.enabled;
                property <int> mode_index: root.whole_library || root.full_library_draft ? 0 : 1;
                current-index: self.mode_index;
                changed mode_index => { self.current-index = self.mode_index; }
                model: [@tr("Full library sync"), @tr("Selected titles")];
                roomy: true;
                enabled: root.connected && !root.busy;
                selected(_) => {
                    let requested = self.current-index;
                    self.current-index = self.mode_index;
                    // A popup opened before a worker update can still finish
                    // its gesture; recheck the live state before changing scope.
                    if root.connected && !root.busy {
                        root.full_library_draft = requested == 0 && !root.whole_library;
                        if requested == 1 && root.whole_library {
                            SettingsBridge.list_services_scope_changed(root.service, false);
                        }
                    }
                }
            }
        }
        Text {
            text: !root.connected ? @tr("Connect this service to choose which titles sync.")
                : root.full_library_draft ? @tr("Full-library sync starts only when you choose Start full-library sync.")
                : root.whole_library ? @tr("Full-library sync imports and exports all supported saved titles and watched episodes. Custom lists and ratings are preserved.")
                : @tr("Sync only titles you explicitly enable from their Tracking page.");
            color: Theme.current.text_settings; wrap: word-wrap; min-width: 0px;
        }
        if root.connected: Text { text: @tr("Your selected titles and exclusions are kept when you change modes."); color: Theme.current.text_settings; wrap: word-wrap; min-width: 0px; }
        if !SettingsBridge.list_services_connected[root.service]: Text { text: root.service == 0 ? @tr("Enter your Simkl application client ID and access token. Tokens are verified before use.") : root.service == 1 ? @tr("Create an API key in MDBList preferences and paste it below.") : @tr("Enter your registered Trakt application client ID. Sign in opens Trakt in your browser; no client secret is needed. Register urn:ietf:wg:oauth:2.0:oob as the redirect URI."); color: Theme.current.text_settings; wrap: word-wrap; min-width: 0px; }
        if root.service != 1 && !SettingsBridge.list_services_connected[root.service]: SettingsInput { placeholder-text: root.service == 0 ? @tr("Simkl client ID") : @tr("Trakt client ID"); accessible-label: self.placeholder-text; text <=> root.client_value; changed full-text => { root.client_full = self.full-text; } changed has-focus => { root.client_focused = self.has-focus; } }
        if root.service != 2 && !SettingsBridge.list_services_connected[root.service]: SettingsInput { placeholder-text: root.service == 0 ? @tr("Simkl access token") : @tr("MDBList API key"); accessible-label: self.placeholder-text; input-type: password; text <=> root.token_value; changed full-text => { root.token_full = self.full-text; } changed has-focus => { root.token_focused = self.has-focus; } }
        if !SettingsBridge.list_services_connected[root.service]: PillButton { label: root.service == 2 ? @tr("Sign in") : @tr("Connect"); primary: true; enabled: !SettingsBridge.list_services_busy[root.service]; clicked => { root.full_library_draft = false; SettingsBridge.list_services_connect(root.service, root.service != 1 ? root.client_full : "", root.service == 2 ? "" : root.token_full); root.release_focus(); root.token_value = ""; root.token_full = ""; } }
        if !SettingsBridge.list_services_connected[root.service]: PillButton { label: @tr("Open account settings"); clicked => { SettingsBridge.list_services_open_account(root.service); } }
        if SettingsBridge.list_services_connected[root.service]: SettingsRow { row-title: SettingsBridge.list_services_whole_library[root.service] ? @tr("Automatic sync") : @tr("Automatic sync for selected titles"); ToggleSwitch { name: SettingsBridge.list_services_whole_library[root.service] ? @tr("Automatic sync") : @tr("Automatic sync for selected titles"); checked: SettingsBridge.list_services_automatic[root.service]; toggled => { SettingsBridge.list_services_automatic_changed(root.service, self.checked); } } }
        if root.connected && root.full_library_draft: Text { text: @tr("Full-library sync imports and exports all supported saved titles and watched episodes. Custom lists and ratings are preserved."); color: Theme.current.text_settings; wrap: word-wrap; min-width: 0px; }
        if root.connected: PillButton {
            label: root.full_library_draft && !root.whole_library ? @tr("Start full-library sync") : @tr("Sync now");
            primary: true;
            enabled: !root.busy;
            wrap_label: true;
            clicked => {
                if root.connected && !root.busy {
                    if root.full_library_draft && !root.whole_library {
                        root.full_library_draft = false;
                        SettingsBridge.list_services_scope_changed(root.service, true);
                    } else {
                        SettingsBridge.list_services_sync(root.service);
                    }
                }
            }
        }
        if root.connected || root.account != "": PillButton { label: @tr("Disconnect"); destructive: true; clicked => { root.full_library_draft = false; SettingsBridge.list_services_disconnect(root.service); } }
        if root.busy: PillButton { label: @tr("Cancel"); clicked => { root.full_library_draft = false; SettingsBridge.list_services_cancel(root.service); } }
    }
}
