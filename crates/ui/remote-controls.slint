import { RemoteBridge, Theme, SettingsStyle, InterfaceStyle } from "@NovaUiShared";
import { PillButton, MiniSlider } from "settings-controls.slint";
import { PageHeader } from "page-header.slint";
import { ScrollView } from "scrollview.slint";
import { MenuRow } from "player-menu-row.slint";
import { SessionPanel, SessionTransportButton, SessionStatus } from "session-controls.slint";
import { IcDisplay } from "icons.slint";

// A preview belongs to the session at press time. Every release path uses that
// captured identity, so reconnecting or replacing playback cannot reset a new session.
component RemoteSpeedHold inherits Rectangle {
    in property <bool> enabled;
    height: InterfaceStyle.tv ? 56px : 44px;
    border-radius: Theme.button_corner_radius;
    background: RemoteBridge.speed_preview_token != "" ? Theme.current.accent : Theme.current.settings_control;
    accessible-role: button;
    accessible-label: @tr("Hold for 2× speed");
    accessible-enabled: root.enabled;
    function begin() {
        if root.enabled && RemoteBridge.speed_preview_token == "" {
            RemoteBridge.speed_preview_token = RemoteBridge.session;
            RemoteBridge.action("speed_preview", 2, RemoteBridge.speed_preview_token);
        }
    }
    function release() {
        if RemoteBridge.speed_preview_token != "" {
            let token = RemoteBridge.speed_preview_token;
            RemoteBridge.speed_preview_token = "";
            RemoteBridge.action("speed_preview_end", 0, token);
        }
    }
    changed enabled => { if !root.enabled { root.release(); } }
    private property <string> session: RemoteBridge.session;
    changed session => { root.release(); }
    Text { width: 100%; height: 100%; text: @tr("Hold for 2× speed"); color: Theme.current.text_primary; horizontal-alignment: center; vertical-alignment: center; }
    hold_focus := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => { if e.text == " " || e.text == Key.Return { if !e.repeat { root.begin(); } accept } else { reject } }
        key-released(e) => { if e.text == " " || e.text == Key.Return { root.release(); accept } else { reject } }
        changed has-focus => { if !self.has-focus { root.release(); } }
    }
    touch := TouchArea {
        enabled: root.enabled; width: 100%; height: 100%;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.begin(); }
            else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel { root.release(); }
        }
        changed pressed => { if !self.pressed { root.release(); } }
    }
    forward-focus: hold_focus;
    opacity: root.enabled ? 1 : 0.45;
}

// This surface receives metadata and controls only. It has no player overlay,
// video image, decoder, URL or local playback state.
export component RemoteControlsPage inherits Rectangle {
    in property <length> safe-top;
    in property <length> safe-bottom;
    in property <length> safe-left;
    in property <length> safe-right;
    private property <bool> wide: !InterfaceStyle.tv && root.width - root.safe-left - root.safe-right >= 900px;
    property <bool> speed_expanded: false;
    property <bool> more_expanded: false;
    private property <bool> ready: RemoteBridge.connected && RemoteBridge.session != "" && !RemoteBridge.loading && RemoteBridge.error == "" && RemoteBridge.replacement_token == "";
    changed ready => { if InterfaceStyle.tv { root.tv-index = -1; focus.focus(); } }
    background: Theme.current.artwork_canvas;
    function action(name: string, value: float) { if root.ready { RemoteBridge.action(name, value, RemoteBridge.session); } }
    property <int> tv-track: 0;
    private property <int> track_picker: RemoteBridge.track_picker;
    changed track_picker => { if root.track_picker == 0 { focus.focus(); } }
    private property <string> current_session: RemoteBridge.session;
    changed current_session => { RemoteBridge.track_picker = 0; }
    function open_tracks(kind: int) {
        if root.ready && RemoteBridge.can_tracks {
            root.tv-track = 0;
            RemoteBridge.track_picker_session = RemoteBridge.session;
            RemoteBridge.track_picker = kind;
        }
    }
    function pick_track(index: int) {
        if root.ready && RemoteBridge.can_tracks && RemoteBridge.track_picker_session == RemoteBridge.session {
            RemoteBridge.action(index == -2 ? (RemoteBridge.track_picker == 1 ? "reset_audio" : "reset_subtitle") : (RemoteBridge.track_picker == 1 ? "audio" : "subtitle"), index == -2 ? 0 : index, RemoteBridge.track_picker_session);
        }
        RemoteBridge.track_picker = 0;
    }
    function tv_reveal(y: length, h: length) {
        let top = y - controls_scroll.absolute-position.y;
        if top < 0px { controls_scroll.content-y -= top; }
        else if top + h > controls_scroll.visible-height { controls_scroll.content-y -= top + h - controls_scroll.visible-height; }
    }
    // Keep a page-local order while native editors and sliders handle their
    // own keys first. Mounted controls claim focus from tv-index, so rebuilding
    // a conditional section never leaves references to a destroyed element.
    function tv_move(direction: int) {
        SettingsStyle.keyboard-mode = true;
        if direction > 0 {
            if root.tv-index >= 16 && root.tv-index < 16 + RemoteBridge.offers.length { root.tv-index += 1; focus.focus(); return; }
            if root.tv-index < 0 && (root.ready && RemoteBridge.can_stop) { root.tv-index = 0; return; }
            if root.tv-index < 1 && (root.ready && RemoteBridge.can_seek && RemoteBridge.duration > 0) { root.tv-index = 1; return; }
            if root.tv-index < 2 && (root.ready && RemoteBridge.can_seek) { root.tv-index = 2; return; }
            if root.tv-index < 3 && (root.ready && RemoteBridge.can_pause) { root.tv-index = 3; return; }
            if root.tv-index < 4 && (root.ready && RemoteBridge.can_seek) { root.tv-index = 4; return; }
            if root.tv-index < 5 && (root.ready && RemoteBridge.can_volume) { root.tv-index = 5; return; }
            if root.tv-index < 6 && (root.ready && RemoteBridge.can_mute) { root.tv-index = 6; return; }
            if root.tv-index < 7 && (root.ready && RemoteBridge.can_speed) { root.tv-index = 7; return; }
            if root.tv-index < 8 && (root.ready && RemoteBridge.can_speed) { root.tv-index = 8; return; }
            if root.tv-index < 9 && (root.ready && RemoteBridge.can_speed) { root.tv-index = 9; return; }
            if root.tv-index < 10 && (RemoteBridge.can_tracks && (root.ready)) { root.tv-index = 10; return; }
            if root.tv-index < 11 && (RemoteBridge.can_tracks && (root.ready)) { root.tv-index = 11; return; }
            if root.tv-index < 12 && (root.ready && RemoteBridge.can_fullscreen) { root.tv-index = 12; return; }
            if root.tv-index < 13 && (root.ready && RemoteBridge.can_screenshot) { root.tv-index = 13; return; }
            if root.tv-index < 14 && RemoteBridge.prompt != "" && root.ready { root.tv-index = 14; return; }
            if root.tv-index < 15 && RemoteBridge.prompt != "" && RemoteBridge.resume_prompt && root.ready { root.tv-index = 15; return; }
            if root.tv-index < 16 && RemoteBridge.prompt != "" && root.ready { root.tv-index = 16; return; }
            if root.tv-index < 17 && RemoteBridge.offers.length > 0 { root.tv-index = 17; focus.focus(); return; }
        }
        if direction < 0 {
            if root.tv-index > 17 { root.tv-index -= 1; focus.focus(); return; }
            if root.tv-index > 16 && RemoteBridge.prompt != "" && root.ready { root.tv-index = 16; return; }
            if root.tv-index > 15 && RemoteBridge.prompt != "" && RemoteBridge.resume_prompt && root.ready { root.tv-index = 15; return; }
            if root.tv-index > 14 && RemoteBridge.prompt != "" && root.ready { root.tv-index = 14; return; }
            if root.tv-index > 13 && (root.ready && RemoteBridge.can_screenshot) { root.tv-index = 13; return; }
            if root.tv-index > 12 && (root.ready && RemoteBridge.can_fullscreen) { root.tv-index = 12; return; }
            if root.tv-index > 11 && (RemoteBridge.can_tracks && (root.ready)) { root.tv-index = 11; return; }
            if root.tv-index > 10 && (RemoteBridge.can_tracks && (root.ready)) { root.tv-index = 10; return; }
            if root.tv-index > 9 && (root.ready && RemoteBridge.can_speed) { root.tv-index = 9; return; }
            if root.tv-index > 8 && (root.ready && RemoteBridge.can_speed) { root.tv-index = 8; return; }
            if root.tv-index > 7 && (root.ready && RemoteBridge.can_speed) { root.tv-index = 7; return; }
            if root.tv-index > 6 && (root.ready && RemoteBridge.can_mute) { root.tv-index = 6; return; }
            if root.tv-index > 5 && (root.ready && RemoteBridge.can_volume) { root.tv-index = 5; return; }
            if root.tv-index > 4 && (root.ready && RemoteBridge.can_seek) { root.tv-index = 4; return; }
            if root.tv-index > 3 && (root.ready && RemoteBridge.can_pause) { root.tv-index = 3; return; }
            if root.tv-index > 2 && (root.ready && RemoteBridge.can_seek) { root.tv-index = 2; return; }
            if root.tv-index > 1 && (root.ready && RemoteBridge.can_seek && RemoteBridge.duration > 0) { root.tv-index = 1; return; }
            if root.tv-index > 0 && (root.ready && RemoteBridge.can_stop) { root.tv-index = 0; return; }
        }
    }
    property <int> tv-index: -1;
    focus := FocusScope {
        enabled: RemoteBridge.replacement_token == "" && RemoteBridge.track_picker == 0; width: 100%; height: 100%; init => { self.focus(); }
        key-pressed(e) => {
            if !InterfaceStyle.tv && !self.has-focus { reject }
            else if e.text == Key.Escape || e.text == Key.Backspace || e.text == Key.Back { if !e.repeat { RemoteBridge.device_close(); } accept }
            else if InterfaceStyle.tv && root.tv-index >= 17 && (e.text == Key.Return || e.text == " ") {
                if !e.repeat && root.tv-index - 17 < RemoteBridge.offers.length { RemoteBridge.stream_picked(root.tv-index - 17); } accept
            }
            else if InterfaceStyle.tv && (e.text == Key.UpArrow || e.text == Key.DownArrow || e.text == Key.LeftArrow || e.text == Key.RightArrow) { root.tv_move(e.text == Key.UpArrow || e.text == Key.LeftArrow ? -1 : 1); accept }
            else if root.ready && RemoteBridge.can_pause && (e.text == " " || e.text == "k") { if !e.repeat { root.action("pause", 0); } accept }
            else if root.ready && RemoteBridge.can_seek && e.text == Key.LeftArrow { root.action("seek_relative", -10); accept }
            else if root.ready && RemoteBridge.can_seek && e.text == Key.RightArrow { root.action("seek_relative", 10); accept }
            else if root.ready && RemoteBridge.can_volume && e.text == Key.UpArrow { root.action("volume_relative", 5); accept }
            else if root.ready && RemoteBridge.can_volume && e.text == Key.DownArrow { root.action("volume_relative", -5); accept }
            else if root.ready && RemoteBridge.can_fullscreen && e.text == "f" { if !e.repeat { root.action("fullscreen", 0); } accept }
            else if root.ready && RemoteBridge.can_screenshot && e.text == "s" { if !e.repeat { root.action("screenshot", 0); } accept }
            else { reject }
        }
        controls_scroll := ScrollView {
            x: root.safe-left + 18px; y: root.safe-top + 18px;
            width: Math.max(0px, root.width - root.safe-left - root.safe-right - 36px);
            height: Math.max(0px, root.height - root.safe-top - root.safe-bottom - 36px);
            content-width: self.visible-width;
            VerticalLayout {
                width: 100%; spacing: 12px; alignment: start;
                controls_header := PageHeader {
                    min-width: 0px; title: @tr("Controls"); subtitle: RemoteBridge.target_name;
                    narrow: root.width < 700px; show-back: true;
                    back => { RemoteBridge.device_close(); }
                }
                controls_body := GridLayout {
                    spacing: 16px;
                    transport_panel := SessionPanel {
                        row: 0; col: 0; horizontal-stretch: 1; vertical-stretch: 0;
                        VerticalLayout {
                            padding: root.wide ? 32px : 16px; spacing: root.wide ? 16px : 10px; alignment: start;
                            Text { horizontal-alignment: center; text: RemoteBridge.title; color: Theme.current.text_bright; font-size: root.wide ? 28px : 22px; font-weight: 700; wrap: word-wrap; min-width: 0px; }
                            if RemoteBridge.episode != "": Text { horizontal-alignment: center; text: RemoteBridge.episode; color: Theme.current.text_primary; wrap: word-wrap; min-width: 0px; }
                            if RemoteBridge.error != "": Text { text: RemoteBridge.error; color: Theme.current.text_destructive; wrap: word-wrap; min-width: 0px; horizontal-alignment: center; }
                            if RemoteBridge.error == "": SessionStatus { label: RemoteBridge.loading ? @tr("Connecting…") : !RemoteBridge.connected ? @tr("Disconnected") : RemoteBridge.phase; connected: root.ready; }
                            transport_buttons := Rectangle {
                                height: 80px;
                                seek_back := SessionTransportButton {
                                    kind: -1; x: parent.width / 2 - 104px; y: 14px;
                                    property <bool> tv-current: InterfaceStyle.tv && root.tv-index == 2;
                                    changed tv-current => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } }
                                    init => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } } caption: @tr("−10 s"); compact: true; enabled: root.ready && RemoteBridge.can_seek; clicked => { if InterfaceStyle.tv { root.tv-index = 2; } root.action("seek_relative", -10); } }
                                pause_button := SessionTransportButton {
                                    kind: 0; x: (parent.width - self.width) / 2; y: 0px;
                                    property <bool> tv-current: InterfaceStyle.tv && root.tv-index == 3;
                                    changed tv-current => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } }
                                    init => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } } paused: RemoteBridge.paused; caption: RemoteBridge.paused ? @tr("Play") : @tr("Pause"); primary: true; compact: true; enabled: root.ready && RemoteBridge.can_pause; clicked => { if InterfaceStyle.tv { root.tv-index = 3; } root.action("pause", 0); } }
                                seek_forward := SessionTransportButton {
                                    kind: 1; x: parent.width / 2 + 52px; y: 14px;
                                    property <bool> tv-current: InterfaceStyle.tv && root.tv-index == 4;
                                    changed tv-current => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } }
                                    init => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } } caption: @tr("+10 s"); compact: true; enabled: root.ready && RemoteBridge.can_seek; clicked => { if InterfaceStyle.tv { root.tv-index = 4; } root.action("seek_relative", 10); } }
                            }
                            timeline := MiniSlider {
                                property <bool> tv-current: InterfaceStyle.tv && root.tv-index == 1;
                                changed tv-current => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } }
                                init => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } } name: @tr("Playback position"); enabled: root.ready && RemoteBridge.can_seek && RemoteBridge.duration > 0; minimum: 0; maximum: Math.max(1, RemoteBridge.duration); value: RemoteBridge.position; changed(v) => { if InterfaceStyle.tv { root.tv-index = 1; } root.action("seek", v); } }
                            Text { text: RemoteBridge.time_text; color: Theme.current.text_secondary; horizontal-alignment: center; font-size: 13px; }
                        }
                    }
                    playback_panel := VerticalLayout {
                        row: root.wide ? 0 : 1; col: root.wide ? 1 : 0;
                        min-width: root.wide ? 300px : 0px; max-width: root.wide ? 340px : 100000px;
                        horizontal-stretch: root.wide ? 0 : 1; vertical-stretch: 0; spacing: 10px;
                        SessionPanel {
                            VerticalLayout { padding: 12px; spacing: 6px;
                                HorizontalLayout {
                                    volume_label := Text { text: @tr("Volume"); color: Theme.current.text_primary; font-weight: 600; horizontal-stretch: 1; }
                                    Text { text: Math.round(RemoteBridge.volume) + "%"; color: Theme.current.text_muted; }
                                }
                                HorizontalLayout { spacing: 10px;
                                    volume_slider := MiniSlider {
                                        property <bool> tv-current: InterfaceStyle.tv && root.tv-index == 5;
                                        changed tv-current => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } }
                                        init => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } } horizontal-stretch: 1; name: @tr("Volume"); enabled: root.ready && RemoteBridge.can_volume; minimum: 0; maximum: 100; value: RemoteBridge.volume; changed(v) => { if InterfaceStyle.tv { root.tv-index = 5; } root.action("volume", v); } }
                                    mute_button := PillButton {
                                        property <bool> tv-current: InterfaceStyle.tv && root.tv-index == 6;
                                        changed tv-current => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } }
                                        init => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } } horizontal-stretch: 0; compact: true; label: RemoteBridge.muted ? @tr("Unmute") : @tr("Mute"); enabled: root.ready && RemoteBridge.can_mute; clicked => { if InterfaceStyle.tv { root.tv-index = 6; } root.action("mute", 0); } }
                                }
                            }
                        }
                        if RemoteBridge.can_tracks: SessionPanel {
                            VerticalLayout { padding: 4px; spacing: 0px;
                                audio_picker := MenuRow {
                                    property <bool> tv-current: InterfaceStyle.tv && root.tv-index == 10;
                                    changed tv-current => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } }
                                    init => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } } label: @tr("Audio tracks"); icon_kind: 1; submenu: true; enabled: root.ready; activate => { if InterfaceStyle.tv { root.tv-index = 10; } root.open_tracks(1); } }
                                subtitle_picker := MenuRow {
                                    property <bool> tv-current: InterfaceStyle.tv && root.tv-index == 11;
                                    changed tv-current => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } }
                                    init => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } } label: @tr("Subtitles"); icon_kind: 2; submenu: true; enabled: root.ready; activate => { if InterfaceStyle.tv { root.tv-index = 11; } root.open_tracks(2); } }
                            }
                        }
                        SessionPanel {
                            VerticalLayout { padding: root.wide || InterfaceStyle.tv || root.speed_expanded ? 12px : 4px; spacing: 8px;
                                if !root.wide && !InterfaceStyle.tv: speed_toggle := MenuRow {
                                    label: @tr("Playback speed"); value: "" + RemoteBridge.speed + "×";
                                    icon_kind: 3; submenu: !root.speed_expanded;
                                    activate => { root.speed_expanded = !root.speed_expanded; }
                                }
                                if root.wide || InterfaceStyle.tv: HorizontalLayout {
                                    Text { text: @tr("Playback speed"); color: Theme.current.text_primary; font-weight: 600; horizontal-stretch: 1; }
                                    Text { text: "" + RemoteBridge.speed + "×"; color: Theme.current.text_muted; }
                                }
                                if root.wide || InterfaceStyle.tv || root.speed_expanded: VerticalLayout { spacing: 8px;
                                    speed_slider := MiniSlider {
                                        property <bool> tv-current: InterfaceStyle.tv && root.tv-index == 7;
                                        changed tv-current => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } }
                                        init => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } } name: @tr("Playback speed"); enabled: root.ready && RemoteBridge.can_speed; minimum: 0.5; maximum: 2; step: 0.05; value: RemoteBridge.speed; changed(v) => { if InterfaceStyle.tv { root.tv-index = 7; } root.action("speed", v); } }
                                    reset_speed := PillButton {
                                        property <bool> tv-current: InterfaceStyle.tv && root.tv-index == 8;
                                        changed tv-current => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } }
                                        init => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } } label: @tr("Use global default"); enabled: root.ready && RemoteBridge.can_speed; clicked => { if InterfaceStyle.tv { root.tv-index = 8; } root.action("reset_speed", 0); } }
                                }
                            }
                        }
                        SessionPanel {
                            VerticalLayout { padding: 4px; spacing: 8px;
                                if !root.wide && !InterfaceStyle.tv: more_toggle := MenuRow {
                                    label: @tr("More"); submenu: !root.more_expanded;
                                    activate => { root.more_expanded = !root.more_expanded; }
                                }
                                if root.wide || InterfaceStyle.tv || root.more_expanded: VerticalLayout { padding: 8px; spacing: 8px;
                                    fullscreen_button := PillButton {
                                        property <bool> tv-current: InterfaceStyle.tv && root.tv-index == 12;
                                        changed tv-current => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } }
                                        init => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } } label: RemoteBridge.fullscreen ? @tr("Exit fullscreen on device") : @tr("Fullscreen on device"); wrap_label: true; enabled: root.ready && RemoteBridge.can_fullscreen; clicked => { if InterfaceStyle.tv { root.tv-index = 12; } root.action("fullscreen", 0); } }
                                    screenshot_button := PillButton {
                                        property <bool> tv-current: InterfaceStyle.tv && root.tv-index == 13;
                                        changed tv-current => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } }
                                        init => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } } label: @tr("Screenshot on device"); wrap_label: true; enabled: root.ready && RemoteBridge.can_screenshot; clicked => { if InterfaceStyle.tv { root.tv-index = 13; } root.action("screenshot", 0); } }
                                }
                            }
                        }
                    }
                }
                HorizontalLayout { alignment: center;
                    speed_hold := RemoteSpeedHold {
                        property <bool> tv-current: InterfaceStyle.tv && root.tv-index == 9;
                        changed tv-current => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } }
                        init => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } } width: Math.min(240px, controls_scroll.visible-width); enabled: root.ready && RemoteBridge.can_speed; }
                }
                // Keep Stop apart from ordinary transport and volume actions.
                HorizontalLayout { alignment: center;
                    stop_button := PillButton {
                        property <bool> tv-current: InterfaceStyle.tv && root.tv-index == 0;
                        changed tv-current => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } }
                        init => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } }
                        label: @tr("Stop"); compact: true; destructive: true;
                        horizontal-stretch: 0; vertical-stretch: 0;
                        enabled: root.ready && RemoteBridge.can_stop;
                        clicked => { if InterfaceStyle.tv { root.tv-index = 0; } root.action("stop", 0); }
                    }
                }
                if RemoteBridge.prompt != "": VerticalLayout { spacing: 8px;
                    Text { text: RemoteBridge.prompt; wrap: word-wrap; color: Theme.current.text_primary; }
                    prompt_accept := PillButton {
                        property <bool> tv-current: InterfaceStyle.tv && root.tv-index == 14;
                        changed tv-current => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } }
                        init => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } } label: RemoteBridge.resume_prompt ? @tr("Resume") : @tr("Continue"); enabled: root.ready; clicked => { if InterfaceStyle.tv { root.tv-index = 14; } RemoteBridge.action("prompt_accept", 0, RemoteBridge.prompt_token); } }
                    if RemoteBridge.resume_prompt: prompt_restart := PillButton {
                        property <bool> tv-current: InterfaceStyle.tv && root.tv-index == 15;
                        changed tv-current => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } }
                        init => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } } label: @tr("Start over"); enabled: root.ready; clicked => { if InterfaceStyle.tv { root.tv-index = 15; } RemoteBridge.action("prompt_reject", 0, RemoteBridge.prompt_token); } }
                    prompt_cancel := PillButton {
                        property <bool> tv-current: InterfaceStyle.tv && root.tv-index == 16;
                        changed tv-current => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } }
                        init => { if self.tv-current { self.focus(); root.tv_reveal(self.absolute-position.y, self.height); } } label: @tr("Cancel"); enabled: root.ready; clicked => { if InterfaceStyle.tv { root.tv-index = 16; } RemoteBridge.action(RemoteBridge.resume_prompt ? "prompt_cancel" : "prompt_reject", 0, RemoteBridge.prompt_token); } }
                }
                if RemoteBridge.offers.length > 0: Text { text: @tr("Choose a stream"); color: Theme.current.text_bright; font-size: 20px; font-weight: 700; }
                for offer[index] in RemoteBridge.offers: VerticalLayout { spacing: 4px;
                    PillButton { focused: InterfaceStyle.tv && root.tv-index == 17 + index; label: offer.title; wrap_label: true; enabled: root.ready; clicked => { if InterfaceStyle.tv { root.tv-index = 17 + index; } RemoteBridge.stream_picked(index); } }
                    if offer.description != "": Text { text: offer.description; color: Theme.current.text_muted; wrap: word-wrap; }
                }
                Text { text: @tr("Back disconnects the controls. Playback continues on your device."); color: Theme.current.text_muted; wrap: word-wrap; }
            }
        }
    }
    if RemoteBridge.track_picker != 0: Rectangle {
        width: 100%; height: 100%; background: Theme.current.scrim_shadow;
        TouchArea { clicked => { RemoteBridge.track_picker = 0; } }
        picker_focus := FocusScope {
            width: 100%; height: 100%; init => { self.focus(); }
            key-pressed(e) => {
                if e.text == Key.Escape || e.text == Key.Back || e.text == Key.Backspace {
                    if !e.repeat { RemoteBridge.track_picker = 0; } accept
                } else if InterfaceStyle.tv && (e.text == Key.UpArrow || e.text == Key.DownArrow) {
                    root.tv-track = Math.clamp(root.tv-track + (e.text == Key.UpArrow ? -1 : 1), 0, (RemoteBridge.track_picker == 1 ? RemoteBridge.audio_tracks.length + 1 : RemoteBridge.sub_tracks.length + 2));
                    track_scroll.content-y = -Math.max(0px, (root.tv-track + 1) * 60px - track_scroll.visible-height);
                    accept
                } else if InterfaceStyle.tv && (e.text == Key.Return || e.text == " ") {
                    if !e.repeat {
                        let offset = RemoteBridge.track_picker == 1 ? 1 : 2;
                        let tracks = RemoteBridge.track_picker == 1 ? RemoteBridge.audio_tracks : RemoteBridge.sub_tracks;
                        if root.tv-track == 0 { root.pick_track(-2); }
                        else if RemoteBridge.track_picker == 2 && root.tv-track == 1 { root.pick_track(-1); }
                        else if root.tv-track - offset < tracks.length { root.pick_track(tracks[root.tv-track - offset].index); }
                        else { RemoteBridge.track_picker = 0; }
                    }
                    accept
                } else { reject }
            }
        }
        picker_card := Rectangle {
            x: root.safe-left + (root.width - root.safe-left - root.safe-right - self.width) / 2;
            y: root.height - root.safe-bottom - self.height - 12px;
            width: Math.max(0px, Math.min(440px, root.width - root.safe-left - root.safe-right - 24px));
            height: Math.min(picker_col.preferred-height, Math.max(0px, root.height - root.safe-top - root.safe-bottom - 24px));
            background: Theme.current.player_menu; border-radius: Theme.card_corner_radius;
            border-width: 1px; border-color: Theme.current.player_menu_border;
            TouchArea { }
            track_scroll := ScrollView {
                width: 100%; height: 100%; content-width: self.visible-width; mouse-drag-pan-enabled: true;
                picker_col := VerticalLayout { width: 100%; padding: 10px; spacing: 4px; alignment: start;
                    Text { text: RemoteBridge.track_picker == 1 ? @tr("Audio tracks") : @tr("Subtitles"); color: Theme.current.text_bright; font-size: 18px; font-weight: 700; }
                    MenuRow { focused: InterfaceStyle.tv && root.tv-track == 0; label: @tr("Use global default"); enabled: root.ready && RemoteBridge.can_tracks; activate => { root.pick_track(-2); } }
                    if RemoteBridge.track_picker == 2: MenuRow { focused: InterfaceStyle.tv && root.tv-track == 1; label: @tr("Off"); enabled: root.ready && RemoteBridge.can_tracks; activate => { root.pick_track(-1); } }
                    for track[index] in (RemoteBridge.track_picker == 1 ? RemoteBridge.audio_tracks : RemoteBridge.sub_tracks): MenuRow {
                        focused: InterfaceStyle.tv && root.tv-track == index + (RemoteBridge.track_picker == 1 ? 1 : 2);
                        label: track.title + (track.lang != "" ? " · " + track.lang : ""); value: track.codec;
                        enabled: root.ready && RemoteBridge.can_tracks;
                        icon_kind: RemoteBridge.track_picker == 1 ? 1 : 2; selected: track.selected;
                        activate => { root.pick_track(track.index); }
                    }
                    PillButton { focused: InterfaceStyle.tv && root.tv-track == (RemoteBridge.track_picker == 1 ? RemoteBridge.audio_tracks.length + 1 : RemoteBridge.sub_tracks.length + 2); label: @tr("Cancel"); clicked => { RemoteBridge.track_picker = 0; } }
                }
            }
        }
    }

}

export component RemoteDevicesPage inherits Rectangle {
    in property <bool> active: true;
    callback back();
    back => { RemoteBridge.devices_open = false; }
    in property <length> safe-top; in property <length> safe-bottom;
    in property <length> safe-left; in property <length> safe-right;
    background: Theme.current.artwork_canvas;
    property <int> tv-index: -1;
    private property <bool> wide: !InterfaceStyle.tv && root.width - root.safe-left - root.safe-right >= 900px;
    property <string> selected_device_id;
    private property <int> device-count: RemoteBridge.devices.length;
    // Polling may reorder rows; retain selection by identity. Membership changes
    // return to the first peer, including when the selected peer was removed.
    changed device-count => { root.tv-index = Math.min(root.tv-index, root.device-count - 1); root.selected_device_id = ""; }
    FocusScope { enabled: root.active; width: 100%; height: 100%; init => { self.focus(); }
        key-pressed(e) => {
            if InterfaceStyle.tv && (e.text == Key.UpArrow || e.text == Key.DownArrow) {
                root.tv-index = Math.clamp(root.tv-index + (e.text == Key.UpArrow ? -1 : 1), -1, RemoteBridge.devices.length - 1);
                SettingsStyle.keyboard-mode = true; accept
            } else if InterfaceStyle.tv && (e.text == Key.Return || e.text == " ") {
                if !e.repeat {
                    if root.tv-index < 0 { RemoteBridge.device_refresh(); }
                    else if RemoteBridge.devices[root.tv-index].has_session && RemoteBridge.devices[root.tv-index].ready { RemoteBridge.device_open(RemoteBridge.devices[root.tv-index].id); }
                }
                accept
            } else if e.text == Key.Escape || e.text == Key.Backspace || e.text == Key.Back { if !e.repeat { root.back(); } accept } else { reject } }
    }
    devices_scroll := ScrollView {
        x: root.safe-left + 18px; y: root.safe-top + 18px;
        width: Math.max(0px, root.width - root.safe-left - root.safe-right - 36px);
        height: Math.max(0px, root.height - root.safe-top - root.safe-bottom - 36px);
        content-width: self.visible-width;
        VerticalLayout {
            width: 100%; spacing: 16px; alignment: start;
            HorizontalLayout {
                spacing: 8px; vertical-stretch: 0;
                PageHeader {
                    min-width: 0px; horizontal-stretch: 1;
                    title: @tr("Devices"); narrow: root.width < 700px; show-back: true;
                    back => { root.back(); }
                }
                PillButton {
                    label: @tr("Refresh"); compact: true; focused: InterfaceStyle.tv && root.tv-index == -1;
                    horizontal-stretch: 0; vertical-stretch: 0;
                    clicked => { if InterfaceStyle.tv { root.tv-index = -1; } RemoteBridge.device_refresh(); }
                }
            }
            if RemoteBridge.devices.length == 0: Text {
                text: @tr("Pair a device in More → Sync to control its playback.");
                color: Theme.current.text_muted; wrap: word-wrap;
                min-width: 0px; vertical-stretch: 0;
            }
            devices_body := GridLayout { spacing: 16px;
                devices_list := VerticalLayout { row: 0; col: 0; min-width: 0px; horizontal-stretch: 1; vertical-stretch: 0; spacing: 10px;
                    for device[index] in RemoteBridge.devices: device_card := Rectangle {
                        min-width: 0px; vertical-stretch: 0;
                        // Explicit content height prevents spare viewport height stretching each row.
                        height: card_content.preferred-height;
                        background: device.ready && device.has_session ? Theme.current.settings_control : Theme.current.card;
                        border-radius: Theme.card_corner_radius;
                        border-width: device_focus.has-focus && SettingsStyle.keyboard-mode ? 2px : 1px;
                        border-color: device_focus.has-focus && SettingsStyle.keyboard-mode ? Theme.current.focus_ring : root.wide && (root.selected_device_id == device.id || (root.selected_device_id == "" && index == 0)) ? Theme.current.accent : Theme.current.border_soft;
                        accessible-role: button; accessible-label: device.name; accessible-enabled: root.active;
                        forward-focus: device_focus;
                        device_focus := FocusScope {
                            enabled: root.active && !InterfaceStyle.tv;
                            key-pressed(e) => {
                                SettingsStyle.keyboard-mode = true;
                                if e.text == Key.Return || e.text == " " { if !e.repeat { root.selected_device_id = device.id; } accept } else { reject }
                            }
                        }
                        TouchArea { enabled: root.active; width: 100%; height: 100%; mouse-cursor: pointer; clicked => { root.selected_device_id = device.id; } }
                        card_content := HorizontalLayout { padding: 16px; spacing: 12px;
                            Rectangle { width: 36px; IcDisplay { width: 30px; height: 30px; y: (parent.height - self.height) / 2; fill: device.ready ? Theme.current.accent_soft : Theme.current.text_muted; } }
                            device_caption := VerticalLayout {
                                spacing: 5px; min-width: 0px; horizontal-stretch: 1; alignment: center;
                                device_name := Text {
                                    text: device.name; color: Theme.current.text_bright;
                                    font-weight: 700; wrap: word-wrap; min-width: 0px;
                                }
                                device_status := Text {
                                    text: device.status; color: Theme.current.text_muted;
                                    wrap: word-wrap; min-width: 0px;
                                }
                                if device.has_session && device.playing_title != "": Text {
                                    text: device.playing_title; color: Theme.current.text_primary;
                                    wrap: word-wrap; min-width: 0px;
                                }
                            }
                            HorizontalLayout {
                                alignment: start;
                                device_controls := PillButton {
                                    label: @tr("Controls"); compact: true; focused: InterfaceStyle.tv && root.tv-index == index;
                                    changed focused => { if self.focused { let top = self.absolute-position.y - devices_scroll.absolute-position.y; if top < 0px { devices_scroll.content-y -= top; } else if top + self.height > devices_scroll.visible-height { devices_scroll.content-y -= top + self.height - devices_scroll.visible-height; } } }
                                    horizontal-stretch: 0; vertical-stretch: 0;
                                    enabled: root.active && device.has_session && device.ready;
                                    clicked => { root.selected_device_id = device.id; if InterfaceStyle.tv { root.tv-index = index; } RemoteBridge.device_open(device.id); }
                                }
                            }
                        }
                    }
                }
                if root.wide: selected_device_panel := VerticalLayout {
                    row: 0; col: 1; min-width: 260px; max-width: 420px; horizontal-stretch: 1; vertical-stretch: 0;
                    for device[index] in RemoteBridge.devices: VerticalLayout {
                        spacing: 0px;
                        if root.selected_device_id == device.id || (root.selected_device_id == "" && index == 0): SessionPanel {
                            VerticalLayout { padding: 24px; spacing: 18px; alignment: start;
                                Rectangle { height: 72px; IcDisplay { width: 64px; height: 64px; x: (parent.width - self.width) / 2; fill: Theme.current.accent_soft; } }
                                selected_device_name := Text { text: device.name; color: Theme.current.text_bright; font-size: 24px; font-weight: 700; wrap: word-wrap; min-width: 0px; horizontal-alignment: center; }
                                SessionStatus { label: device.status; connected: device.ready; }
                                if device.playing_title != "": Text { text: device.playing_title; font-size: 18px; color: Theme.current.text_primary; wrap: word-wrap; min-width: 0px; }
                                PillButton { label: @tr("Controls"); primary: true; enabled: device.has_session && device.ready && root.active; clicked => { RemoteBridge.device_open(device.id); } }
                            }
                        }
                    }
                }
            }
        }
    }
    // The outgoing page remains painted during More's return transition.
    if !root.active: TouchArea { width: 100%; height: 100%; scroll-event => { accept } }

}

export component RemotePlayingSection inherits VerticalLayout {
    min-width: 0px;
    spacing: 8px;
    // Keep the rail's intrinsic width out of the Home page's layout minimum.
    Text { text: @tr("Playing on your devices"); min-width: 0px; overflow: elide; color: Theme.current.text_bright; font-size: 20px; font-weight: 700; }
    device_rail := Flickable {
        min-width: 0px;
        height: InterfaceStyle.tv ? 56px : 44px;
        vertical-stretch: 0;
        interactive: true;
        content-height: InterfaceStyle.tv ? 56px : 44px;
        content-width: device_choices.preferred-width;
        device_choices := HorizontalLayout {
            spacing: 0px;
            PillButton {
                label: @tr("Devices");
                changed keyboard_focused => { if self.keyboard_focused { device_rail.content-x = 0px; } }
                clicked => { RemoteBridge.devices_open = true; RemoteBridge.device_refresh(); }
            }
            // Only real receiver sessions appear here, independently of controller state.
            for device in RemoteBridge.devices: HorizontalLayout {
                spacing: 0px;
                padding-left: device.has_session ? 8px : 0px;
                if device.has_session: PillButton {
                    label: device.name + " · " + device.playing_title;
                    changed keyboard_focused => {
                        if self.keyboard_focused {
                            let left = self.absolute-position.x - device_rail.absolute-position.x;
                            if left < 0px { device_rail.content-x -= left; }
                            else if left + self.width > device_rail.width {
                                device_rail.content-x -= Math.min(left, left + self.width - device_rail.width);
                            }
                        }
                    }
                    clicked => { RemoteBridge.device_open(device.id); }
                }
            }
        }
    }
}

// Output choice shares the stream heading; its popup never consumes result height.
export component RemoteTargetMenu inherits Rectangle {
    public function focus_launcher() { output_button.focus(); }
    in property <bool> focused: false;
    callback dismissed();
    public function open_menu() { root.tv-target = -1; RemoteBridge.device_refresh(); target_popup.show(); }
    property <int> tv-target: -1;
    in property <length> popup-height: 180px;
    height: InterfaceStyle.tv ? 56px : 32px;
    width: output_button.width; horizontal-stretch: 0;
    output_button := PillButton {
        x: 0px; y: (root.height - self.height) / 2;
        btn_min_width: 80px; height: InterfaceStyle.tv ? 56px : 32px;
        focused: root.focused;
        compact: true; label: @tr("Play on"); primary: RemoteBridge.target_id != "";
        clicked => { root.open_menu(); }
    }
    target_popup := PopupWindow {
        width: InterfaceStyle.tv ? 380px : 240px; height: Math.max(60px, Math.min(root.popup-height, 220px));
        x: root.width - self.width; y: output_button.y + output_button.height;
        close-policy: close-on-click-outside;
        forward-focus: popup_focus;
        popup_focus := FocusScope {
            width: 100%; height: 100%; init => { self.focus(); }
            capture-key-pressed(e) => {
                if e.text == Key.Back || e.text == Key.Escape { if !e.repeat { target_popup.close(); if InterfaceStyle.tv { output_button.focus(); } root.dismissed(); } accept }
                else if InterfaceStyle.tv && (e.text == Key.UpArrow || e.text == Key.DownArrow) {
                    root.tv-target = Math.clamp(root.tv-target + (e.text == Key.UpArrow ? -1 : 1), -1, RemoteBridge.devices.length - 1);
                    target_scroll.content-y = -Math.max(0px, (root.tv-target + 2) * 64px - target_scroll.visible-height);
                    accept
                } else if InterfaceStyle.tv && (e.text == Key.Return || e.text == " ") {
                    if !e.repeat {
                        if root.tv-target == -1 { target_popup.close(); output_button.focus(); root.dismissed(); RemoteBridge.device_selected(""); }
                        else if RemoteBridge.devices[root.tv-target].ready { let id = RemoteBridge.devices[root.tv-target].id; target_popup.close(); output_button.focus(); root.dismissed(); RemoteBridge.device_selected(id); }
                    }
                    accept
                } else { reject }
            }
            capture-key-released(e) => { if e.text == Key.Back || e.text == Key.Escape { accept } else { reject } }
            Rectangle {
                width: 100%; height: 100%; background: Theme.current.popup;
                border-radius: 8px; border-width: 1px; border-color: Theme.current.control_border;
                target_scroll := ScrollView { width: 100%; height: 100%; content-width: self.visible-width; mouse-drag-pan-enabled: true;
                    VerticalLayout { width: 100%; padding: 8px; spacing: 0px; alignment: start;
                        PillButton { focused: InterfaceStyle.tv && root.tv-target == -1; label: @tr("This device"); primary: RemoteBridge.target_id == ""; clicked => { target_popup.close(); root.dismissed(); RemoteBridge.device_selected(""); } }
                        for device[index] in RemoteBridge.devices: VerticalLayout {
                            spacing: 0px; vertical-stretch: 0;
                            // Offline wrappers reserve no inter-item gap.
                            padding-top: device.ready ? 8px : 0px;
                            if device.ready: PillButton {
                                focused: InterfaceStyle.tv && root.tv-target == index; label: device.name; wrap_label: true; primary: RemoteBridge.target_id == device.id;
                                clicked => { let id = device.id; target_popup.close(); root.dismissed(); RemoteBridge.device_selected(id); }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component RemoteReplacementDialog inherits Rectangle {
    in property <length> safe-top; in property <length> safe-bottom;
    in property <length> safe-left; in property <length> safe-right;
    private property <bool> cancel_selected: false;
    background: Theme.current.artwork_canvas;
    TouchArea { width: 100%; height: 100%; }
    dialog_focus := FocusScope {
        width: 100%; height: 100%; init => { self.focus(); }
        // Keep keyboard navigation inside this confirmation even when a pill
        // owns native focus; underlying stream selection must remain covered.
        capture-key-pressed(e) => {
            if e.text == Key.Tab || (InterfaceStyle.tv && (e.text == Key.LeftArrow || e.text == Key.RightArrow || e.text == Key.UpArrow || e.text == Key.DownArrow)) { root.cancel_selected = !root.cancel_selected; SettingsStyle.keyboard-mode = true; self.focus(); accept }
            else { reject }
        }
        key-pressed(e) => {
            if e.text == Key.Escape || e.text == Key.Back || e.text == Key.Backspace {
                if !e.repeat { RemoteBridge.replacement_confirmed(RemoteBridge.replacement_token, false); } accept
            } else if e.text == Key.Return || e.text == " " {
                if !e.repeat { RemoteBridge.replacement_confirmed(RemoteBridge.replacement_token, !root.cancel_selected); } accept
            } else { reject }
        }
        VerticalLayout {
            x: 18px + root.safe-left;
            y: Math.max(18px + root.safe-top, (root.height - self.preferred-height - root.safe-bottom + root.safe-top) / 2);
            width: Math.max(0px, root.width - root.safe-left - root.safe-right - 36px); spacing: 16px;
            Text { text: @tr("Replace playback on device?"); font-size: 24px; font-weight: 700; color: Theme.current.text_bright; wrap: word-wrap; }
            Text { text: RemoteBridge.replacement_title; color: Theme.current.text_primary; wrap: word-wrap; }
            PillButton { label: @tr("Replace playback"); primary: true; focused: SettingsStyle.keyboard-mode && !root.cancel_selected; clicked => { RemoteBridge.replacement_confirmed(RemoteBridge.replacement_token, true); } }
            PillButton { label: @tr("Cancel"); focused: SettingsStyle.keyboard-mode && root.cancel_selected; clicked => { RemoteBridge.replacement_confirmed(RemoteBridge.replacement_token, false); } }
        }
    }
}
