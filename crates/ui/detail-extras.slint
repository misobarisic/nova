import { DetailInfo, DetailActionRow, DetailContent, Theme, InterfaceStyle, Anim } from "@NovaUiShared";
import { PillButton } from "settings-controls.slint";
import { IcPlay, IcChevronRight } from "icons.slint";

component DetailActionTile inherits Rectangle {
    in property <DetailActionRow> entry;
    in property <bool> trailer: false;
    in property <bool> compact: false;
    in property <bool> active: true;
    callback picked();
    height: Math.max(root.compact ? 48px : 76px, copy.preferred-height + (root.compact ? 20px : 28px));
    min-width: 0px;
    border-radius: Theme.card_corner_radius;
    border-width: 1px;
    border-color: focus.has-focus || touch.has-hover ? Theme.current.accent_vivid : Theme.current.border_soft;
    background: touch.has-hover ? Theme.current.control_hover : Theme.current.season_caption;
    HorizontalLayout {
        padding: root.compact ? 10px : 16px; spacing: 14px;
        if root.trailer: Rectangle {
            width: 40px; height: 40px; border-radius: 20px;
            background: Theme.current.control;
            IcPlay { width: 20px; height: 20px; x: 11px; y: 10px; fill: Theme.current.accent_vivid; }
        }
        copy := VerticalLayout {
            alignment: center; spacing: 5px;
            Text { text: root.entry.title; color: Theme.current.text_bright; font-size: InterfaceStyle.tv ? 21px : 16px; font-weight: 600; wrap: word-wrap; min-width: 0px; }
            if root.entry.subtitle != "": Text { text: root.entry.subtitle; color: Theme.current.text_episode_metadata; font-size: InterfaceStyle.tv ? 17px : 13px; wrap: word-wrap; min-width: 0px; }
        }
        if !root.compact: IcChevronRight { width: 18px; height: 18px; fill: Theme.current.text_episode_metadata; }
    }
    focus := FocusScope {
        enabled: root.active;
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " { root.picked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.active;
        accessible-role: button; accessible-label: root.entry.title;
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.picked(); }
    }
}

component DetailPeople inherits Rectangle {
    in property <string> heading;
    in property <[string]> names;
    in property <bool> narrow;
    callback picked(string);
    property <bool> expanded: false;
    property <int> visible_count: root.expanded ? root.names.length : Math.min(6, root.names.length);
    changed names => { root.expanded = false; }
    height: body.preferred-height;
    vertical-stretch: 0;
    body := VerticalLayout {
        width: 100%; spacing: 12px; alignment: start;
        Text { text: root.heading; color: Theme.current.text_bright; font-weight: 700; font-size: root.narrow ? 20px : 24px; }
        GridLayout {
            spacing: 10px;
            for i in root.visible_count: DetailActionTile {
                row: Math.floor(i / (root.narrow ? 2 : 3)); col: Math.mod(i, root.narrow ? 2 : 3);
                horizontal-stretch: 1; min-width: 0px;
                compact: true;
                entry: { title: root.names[i], subtitle: "", target: root.names[i] };
                picked => { root.picked(root.names[i]); }
            }
        }
        if root.names.length > 6: HorizontalLayout {
            alignment: start;
            PillButton { label: root.expanded ? @tr("Show less") : @tr("Show all"); clicked => { root.expanded = !root.expanded; } }
        }
    }
}

component DetailRelatedPoster inherits Rectangle {
    in property <DetailActionRow> entry;
    callback picked();
    height: self.width * 1.5 + (InterfaceStyle.tv ? 88px : 64px);
    min-width: 0px;
    border-radius: Theme.card_corner_radius;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus || touch.has-hover ? Theme.current.accent_vivid : Theme.current.border_soft;
    background: Theme.current.card;
    clip: true;
    art := Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.width * 1.5;
        background: Theme.current.home_artwork_placeholder;
        if root.entry.is_loaded: Image { source: root.entry.poster; width: 100%; height: 100%; image-fit: cover; }
        if !root.entry.is_loaded: IcPlay { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 30px; height: 30px; fill: Theme.current.text_disabled; }
    }
    title := Text {
        x: 10px; y: art.height + 8px; width: parent.width - 20px;
        height: InterfaceStyle.tv ? 48px : 32px;
        text: root.entry.title; wrap: word-wrap; overflow: elide;
        color: Theme.current.text_bright; font-size: InterfaceStyle.tv ? 18px : 13px; font-weight: 600;
    }
    Text {
        x: 10px; y: title.y + title.height + 3px; width: parent.width - 20px;
        height: InterfaceStyle.tv ? 24px : 16px;
        text: root.entry.subtitle; overflow: elide;
        color: Theme.current.text_episode_metadata; font-size: InterfaceStyle.tv ? 16px : 11px;
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " { root.picked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        accessible-role: button; accessible-label: root.entry.title;
        property <bool> dragged: false;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { touch.dragged = false; }
            if event.kind == PointerEventKind.cancel { touch.dragged = true; }
        }
        // A page scroll can release over the same card without the Flickable
        // claiming it. Travel must suppress that pending click too.
        moved => {
            if Math.abs(touch.mouse-x - touch.pressed-x)
                + Math.abs(touch.mouse-y - touch.pressed-y) > 12px {
                touch.dragged = true;
            }
        }
        clicked => {
            if !touch.dragged { focus.focus(); root.picked(); }
        }
    }
}

export component DetailExtrasPanel inherits Rectangle {
    in property <DetailInfo> info;
    in property <bool> narrow;
    in property <bool> is_movie;
    in property <length> available-width;
    property <int> related_columns: root.narrow ? 2 : (InterfaceStyle.tv ? 4 : 5);
    callback picked(int,string);
    property <bool> trailers_expanded <=> DetailContent.trailers_expanded;
    property <float> trailer_reveal: root.trailers_expanded ? 1.0 : 0.0;
    animate trailer_reveal { duration: DetailContent.restoring_navigation ? 0ms : Anim.transition_slide; easing: ease-in-out; }
    // Resolve immediately if motion is disabled during a reveal.
    property <float> trailer_progress: Anim.enabled && Anim.transitions ? root.trailer_reveal : (root.trailers_expanded ? 1.0 : 0.0);
    height: body.preferred-height;
    vertical-stretch: 0;
    body := VerticalLayout {
        width: 100%; alignment: start; spacing: 28px;
        if root.info.facts.length > 0: Rectangle {
            background: Theme.current.season_caption;
            border-radius: Theme.card_corner_radius;
            border-width: 1px; border-color: Theme.current.border_soft;
            height: facts.preferred-height;
            facts := GridLayout {
                width: 100%; padding: root.narrow ? 16px : 24px; spacing: 20px;
                for fact[i] in root.info.facts: VerticalLayout {
                    row: Math.floor(i / (root.narrow ? 2 : 3)); col: Math.mod(i, root.narrow ? 2 : 3);
                    spacing: 5px; min-width: 0px; alignment: start;
                    Text { text: fact.title; color: Theme.current.text_episode_metadata; font-size: 13px; wrap: word-wrap; min-width: 0px; }
                    Text { text: fact.subtitle; color: Theme.current.text_bright; font-size: root.narrow ? 16px : 18px; font-weight: 600; wrap: word-wrap; min-width: 0px; }
                }
            }
        }
        if root.info.trailers.length > 0: VerticalLayout {
            spacing: 12px; alignment: start;
            Text { text: @tr("Trailers"); color: Theme.current.text_bright; font-size: root.narrow ? 20px : 24px; font-weight: 700; }
            trailer_viewport := Rectangle {
                clip: true;
                height: first_trailer.height + root.trailer_progress * (trailer_list.preferred-height - first_trailer.height);
                trailer_list := VerticalLayout {
                    x: 0px; y: 0px; width: 100%; height: self.preferred-height;
                    spacing: 12px; alignment: start;
                    first_trailer := DetailActionTile {
                        entry: root.info.trailers[0]; trailer: true;
                        picked => { root.picked(1, root.info.trailers[0].target); }
                    }
                    for i in root.info.trailers.length - 1: DetailActionTile {
                        entry: root.info.trailers[i + 1]; trailer: true;
                        active: root.trailers_expanded;
                        opacity: root.trailer_progress;
                        picked => { root.picked(1, root.info.trailers[i + 1].target); }
                    }
                }
            }
            if root.info.trailers.length > 1: HorizontalLayout {
                alignment: start;
                PillButton { label: root.trailers_expanded ? @tr("Show less") : @tr("More trailers"); clicked => { root.trailers_expanded = !root.trailers_expanded; } }
            }
        }
        if root.info.cast.length > 0: DetailPeople { heading: @tr("Cast"); names: root.info.cast; narrow: root.narrow; picked(name) => { root.picked(0, name); } }
        if root.info.directors.length > 0: DetailPeople { heading: @tr("Directors"); names: root.info.directors; narrow: root.narrow; picked(name) => { root.picked(0, name); } }
        if root.info.writers.length > 0: DetailPeople { heading: @tr("Writers"); names: root.info.writers; narrow: root.narrow; picked(name) => { root.picked(0, name); } }
        if root.info.related.length > 0: VerticalLayout {
            spacing: 12px; alignment: start;
            Text { text: root.is_movie ? @tr("Similar movies") : @tr("Similar shows"); color: Theme.current.text_bright; font-size: root.narrow ? 20px : 24px; font-weight: 700; }
            GridLayout {
                spacing: 12px;
                for title[i] in root.info.related: DetailRelatedPoster {
                    row: Math.floor(i / root.related_columns);
                    col: Math.mod(i, root.related_columns);
                    min-width: Math.max(0px, (root.available-width - 12px * (root.related_columns - 1)) / root.related_columns);
                    max-width: Math.max(0px, (root.available-width - 12px * (root.related_columns - 1)) / root.related_columns);
                    horizontal-stretch: 0;
                    entry: title;
                    picked => { root.picked(2, title.target); }
                }
            }
        }
    }
}
