import { ScrollView, Button } from "std-widgets.slint";
import { Dropdown } from "dropdown.slint";
import { SearchField } from "searchfield.slint";
import { AddonRow, CategoryRow, HomeCatalogRow, SyncPeer, SyncInvite, DownloadRow, LicenseSource } from "types.slint";
import { IcExtension, IcTag, IcImage, IcDisplay, IcPlay, IcChevronLeft, IcChevronRight, IcSettingsGear, IcSync, IcDelete } from "icons.slint";
import { KbMark } from "kbnav.slint";
import { SideNav, NavMetrics } from "sidenav.slint";
import { BottomNav } from "bottomnav.slint";
import { Anim } from "anim.slint";
import { SpeedControl } from "speedcontrol.slint";

// ---- Reusable building blocks (Miru-style settings) ------------------------

// Purple pill button ("Add", "Save", "Show"…). Primary = filled accent.
component PillButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <length> btn_min_width: 0px;
    // 6-button nav highlight.
    in property <bool> focused: false;
    // Finger-sized height on narrow screens (44px touch target).
    in property <bool> roomy: false;
    // Narrower side padding (20px instead of 28px): for rows that must fit
    // more pills than a phone's width allows with the default padding
    // (Settings → Addons stacks seven controls on two lines). Height, colour
    // and touch target are unchanged.
    in property <bool> compact: false;
    callback clicked();
    // Expose the label to the accessibility tree (and headless tests, which
    // locate a specific pill by label rather than by traversal index).
    accessible-role: button;
    accessible-label: label;
    width: Math.max(pill_lbl.preferred-width + (root.compact ? 20px : 28px), self.btn_min_width);
    height: roomy ? 44px : 32px;
    border-radius: 8px;
    border-width: focused ? 2px : 0px;
    border-color: #8b5cf6;
    background: touch.has-hover
        ? (primary ? #5a5090 : #2f2f3a)
        : (primary ? #463f6e : #26262e);
    animate background { duration: Anim.hover_fast; }

    pill_lbl := Text {
        text: label;
        font-size: 13px;
        color: primary ? #dcd6ff : #c9c9d4;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// iOS-style toggle switch used instead of checkboxes. 32px tall like the
// buttons so both share the same vertical center in a row.
component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    // 6-button nav highlight.
    in property <bool> focused: false;
    callback toggled();
    width: 44px;
    height: 32px;
    border-width: focused ? 2px : 0px;
    border-color: #8b5cf6;
    border-radius: 6px;

    Rectangle {
        y: (parent.height - self.height) / 2;
        width: 100%;
        height: 24px;
        border-radius: 12px;
        border-width: 1px;
        border-color: checked ? #a89af5 : #33333c;
        background: checked ? #a89af5 : #26262e;
        animate background { duration: Anim.hover_fast; }

        knob := Rectangle {
            x: checked ? parent.width - self.width - 3px : 3px;
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: checked ? #14141a : #d9d9e2;
            animate x { duration: Anim.hover_fast; }
        }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            checked = !checked;
            toggled();
        }
    }
}

// Square icon button for the narrow addon rows (configure / refresh /
// remove / move): a 22px glyph on the pill fill, same hover and keyboard
// ring language as PillButton. Labels stay on the accessibility tree via
// `name`, so icon-only buttons keep their translated names.
component AddonIconButton inherits Rectangle {
    in property <string> name: "";
    // 6-button nav highlight.
    in property <bool> focused: false;
    // Finger-sized target on narrow screens (44px, like roomy pills);
    // 32px elsewhere, exactly matching ToggleSwitch and text pills so a
    // shared row stays aligned.
    in property <bool> roomy: false;
    callback clicked();
    width: roomy ? 44px : 32px;
    height: roomy ? 44px : 32px;
    border-radius: 10px;
    border-width: focused ? 2px : 0px;
    border-color: #8b5cf6;
    background: touch.has-hover ? #ffffff14 : #26262e;
    animate background { duration: Anim.hover_fast; }
    accessible-role: button;
    accessible-label: root.name;
    @children
    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One addon row on narrow screens: the name owns the first line (toggle +
// title + move arrows) and the remaining actions sit on a second line
// underneath (configure cog, Copy link, refresh, remove) — a phone's row
// offers ~260px for controls, so seven text pills either squeeze the title
// to nothing or spill off the row. Keyboard column order matches the wide
// row's: 0 toggle, 1 Configure, 2 Copy link, 3 Refresh, 4 Remove, 5 move
// up, 6 move down.
component AddonRowCard inherits Rectangle {
    in property <string> title: "";
    in property <bool> tinted: false;
    in property <bool> on: false;
    in property <bool> has_config: false;
    // Keyboard row focus (zone 2, this row) and modality.
    in property <bool> kb_focused_row: false;
    in property <bool> kb_active: false;
    // Keyboard column on this row (same numbering as the wide row).
    in property <int> kb_col: -1;
    callback toggled(bool);
    callback configure();
    callback copy_link();
    callback refresh();
    callback remove();
    callback move_up();
    callback move_down();

    background: tinted ? #17171a : #121214;

    VerticalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;

        // Row 1: identity + order.
        HorizontalLayout {
            spacing: 12px;

            KbMark { on: root.kb_focused_row; active: root.kb_active; }
            // Centered on the 44px arrow line (a layout child would ride 6px
            // high next to the roomy buttons).
            Rectangle {
                width: 44px;
                height: 44px;

                ToggleSwitch {
                    x: 0px;
                    y: (parent.height - self.height) / 2;
                    checked: root.on;
                    focused: root.kb_active && root.kb_focused_row && root.kb_col == 0;
                    toggled => { root.toggled(self.checked); }
                }
            }

            Text {
                text: root.title;
                font-size: 14px;
                font-weight: 600;
                color: #f2f2f4;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                vertical-alignment: center;
                min-width: 0px;
                wrap: word-wrap;
            }

            AddonIconButton {
                roomy: true;
                name: @tr("Move up");
                focused: root.kb_active && root.kb_focused_row && root.kb_col == 5;
                clicked => { root.move_up(); }
                Text {
                    text: "↑";
                    font-size: 18px;
                    color: #c9c9d4;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            AddonIconButton {
                roomy: true;
                name: @tr("Move down");
                focused: root.kb_active && root.kb_focused_row && root.kb_col == 6;
                clicked => { root.move_down(); }
                Text {
                    text: "↓";
                    font-size: 18px;
                    color: #c9c9d4;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Row 2: actions, in keyboard-column order.
        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            if root.has_config: AddonIconButton {
                roomy: true;
                name: @tr("Configure");
                focused: root.kb_active && root.kb_focused_row && root.kb_col == 1;
                clicked => { root.configure(); }
                IcSettingsGear {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 22px;
                    height: 22px;
                    fill: #c9c9d4;
                }
            }

            PillButton {
                label: @tr("Copy link");
                roomy: true;
                compact: true;
                focused: root.kb_active && root.kb_focused_row && root.kb_col == 2;
                clicked => { root.copy_link(); }
            }

            AddonIconButton {
                roomy: true;
                name: @tr("Refresh");
                focused: root.kb_active && root.kb_focused_row && root.kb_col == 3;
                clicked => { root.refresh(); }
                IcSync {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 22px;
                    height: 22px;
                    fill: #c9c9d4;
                }
            }

            AddonIconButton {
                roomy: true;
                name: @tr("Remove");
                focused: root.kb_active && root.kb_focused_row && root.kb_col == 4;
                clicked => { root.remove(); }
                IcDelete {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 22px;
                    height: 22px;
                    fill: #c9c9d4;
                }
            }
        }
    }
}

// Thin custom slider with a lavender fill and round thumb.
component MiniSlider inherits Rectangle {
    in-out property <float> value: 0.0;
    in property <float> minimum: 0.0;
    in property <float> maximum: 100.0;
    // 6-button nav highlight (Left/Right adjusts when focused).
    in property <bool> focused: false;
    callback changed(float);
    height: 22px;
    border-width: focused ? 2px : 0px;
    border-color: #8b5cf6;
    border-radius: 6px;

    property <float> span: Math.max(maximum - minimum, 0.001);
    property <float> pct: Math.clamp((value - minimum) / span, 0, 1);

    Rectangle {
        x: 0;
        width: 100%;
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: #2e2e38;

        Rectangle {
            x: 0;
            width: root.pct * parent.width;
            height: 100%;
            border-radius: 2px;
            background: #a89af5;
        }
    }

    Rectangle {
        x: root.pct * (parent.width - 14px);
        y: (parent.height - 14px) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: #a89af5;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        moved => {
            value = minimum + Math.clamp(self.mouse-x / self.width, 0, 1) * span;
            root.changed(value);
        }
        clicked => {
            value = minimum + Math.clamp(self.mouse-x / self.width, 0, 1) * span;
            root.changed(value);
        }
    }
}

// Segmented option picker (e.g. JPEG | WebP).
component Segmented inherits HorizontalLayout {
    in property <[string]> labels;
    in-out property <int> current_index: 0;
    // 6-button nav highlight (Left/Right cycles when focused).
    in property <bool> focused: false;
    callback picked(int);
    spacing: 0px;

    for opt[i] in labels: Rectangle {
        width: seg_lbl.preferred-width + 28px;
        height: 32px;
        border-radius: 8px;
        border-width: focused && root.current_index == i ? 2px : 0px;
        border-color: #8b5cf6;
        background: root.current_index == i ? #443e66 : transparent;
        animate background { duration: Anim.hover_fast; }

        seg_lbl := Text {
            text: opt;
            font-size: 13px;
            color: root.current_index == i ? #e6e0ff : #8a8a92;
            vertical-alignment: center;
        }

        TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => {
                root.current_index = i;
                root.picked(i);
            }
        }
    }
}

// Section title: purple icon + uppercase label.
component SectionHeader inherits HorizontalLayout {
    in property <int> icon-kind: 0;   // 1 addons, 2 categories, 3 cache, 4 display, 5 player, 6 settings, 7 sync
    in property <string> label;
    spacing: 10px;
    alignment: start;

    Rectangle {
        width: 26px;
        height: 26px;

        if icon-kind == 1: IcExtension {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            fill: #a89af5;
        }
        if icon-kind == 2: IcTag {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            fill: #a89af5;
        }
        if icon-kind == 3: IcImage {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            fill: #a89af5;
        }
        if icon-kind == 4: IcDisplay {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            fill: #a89af5;
        }
        if icon-kind == 5: IcPlay {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            fill: #a89af5;
        }
        if icon-kind == 6: IcSettingsGear {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            fill: #a89af5;
        }
        if icon-kind == 7: IcSync {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            fill: #a89af5;
        }
        if icon-kind == 8: IcImage {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            fill: #a89af5;
        }
    }

    Text {
        text: label;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 2px;
        color: #9a9aa4;
        vertical-alignment: center;
    }
}

// One setting row: title + description on the left, any control(s) after.
// Rows are placed edge to edge inside a card; alternate rows get a tinted
// background (zebra striping, like the reference).
component SettingsRow inherits Rectangle {
    in property <string> row-title: "";
    in property <string> row-desc: "";
    in property <bool> tinted: false;
    in property <length> row-min-height: 64px;
    background: tinted ? #17171a : #121214;

    property <length> inner-width: Math.max(0px, self.width - 32px);
    property <length> control-width: controls.preferred-width;
    property <length> control-height: controls.preferred-height;
    // Keep the text column from sprawling across a very wide settings card,
    // while making its narrow-width limit explicit instead of splitting free
    // space with an invisible spacer.
    property <length> side-text-width: Math.min(
        Math.max(0px, root.inner-width - root.control-width - 16px),
        root.inner-width * 0.62
    );
    property <bool> stack-controls: root.side-text-width < 150px;
    property <length> text-width: root.stack-controls
        ? root.inner-width
        : root.side-text-width;
    property <length> text-height: measure_col.preferred-height;

    // Keep at least 150px for a readable text column. Rows whose controls
    // would crowd it instead put the controls on a second line; small controls
    // such as toggles stay beside their text. The wrapped measurement is at
    // that same live text width, so both layouts reserve enough height for
    // titles and descriptions that wrap.
    height: Math.max(
        row-min-height,
        28px + (root.stack-controls
            ? root.text-height + 10px + root.control-height
            : Math.max(root.text-height, root.control-height))
    );

    title_col := VerticalLayout {
        x: 16px;
        y: root.stack-controls
            ? 14px
            : (root.height - self.height) / 2;
        width: root.text-width;
        height: root.text-height;
        alignment: center;
        spacing: 3px;

        Text {
            text: row-title;
            font-size: 14px;
            font-weight: 600;
            color: #f2f2f4;
            // min-width: 0 lets the column shrink past a long unbreakable token
            // (an addon URL, a slug) without widening the settings page.
            min-width: 0px;
            wrap: word-wrap;
        }

        if row-desc != "": Text {
            text: row-desc;
            font-size: 12px;
            color: #8a8a92;
            min-width: 0px;
            wrap: word-wrap;
        }
    }

    // A single slot keeps caller-provided controls intact (including grouped
    // controls). It is right-aligned beside the text when there is room, and
    // left-aligned below it when the control group would leave under 150px for
    // the label and description.
    controls := HorizontalLayout {
        x: root.stack-controls
            ? 16px
            : root.width - 16px - root.control-width;
        y: root.stack-controls
            ? 14px + root.text-height + 10px
            : (root.height - self.height) / 2;
        width: root.stack-controls ? root.inner-width : root.control-width;
        height: root.control-height;
        alignment: start;

        @children
    }

    // Hidden measurement copy of the whole text column (same text, fonts,
    // width and spacing as `title_col`; clipped to zero height so it renders
    // nothing) — its natural wrapped height drives the row minimum above.
    Rectangle {
        x: 0px;
        y: 0px;
        height: 0;
        clip: true;

        measure_col := VerticalLayout {
            width: title_col.width;
            spacing: 3px;

            Text {
                text: row-title;
                font-size: 14px;
                font-weight: 600;
                wrap: word-wrap;
                min-width: 0px;
            }

            if row-desc != "": Text {
                text: row-desc;
                font-size: 12px;
                wrap: word-wrap;
                min-width: 0px;
            }
        }
    }
}

// Bordered value readout shown under sliders.
component ValueBox inherits Rectangle {
    in property <string> text;
    width: 120px;
    height: 30px;
    border-radius: 8px;
    border-width: 1px;
    border-color: #33333c;
    background: #17171a;

    Text {
        text: text;
        font-size: 13px;
        color: #ffffff;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

// Landing-page entry: icon + title + subtitle + chevron. Tapping opens the
// corresponding settings subpage (see `open_page`).
component SettingsLink inherits Rectangle {
    in property <int> icon-kind: 0;   // 0 addons, 1 categories, 2 cache, 3 display, 4 torrents, 5 player, 6 look-and-feel, 7 sync
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <bool> focused: false;
    // False while a subpage is open: blocks taps that would fall through the
    // subpage layer (Slint hit-tests TouchAreas regardless of z-order).
    in property <bool> interactive: true;
    callback picked();

    min-height: 62px;
    border-radius: 8px;
    border-width: focused ? 2px : 0px;
    border-color: #8b5cf6;
    background: touch.has-hover && interactive ? #1c1c22 : #121214;
    animate background { duration: Anim.hover_fast; }

    HorizontalLayout {
        width: 100%;
        padding-top: 14px;
        padding-bottom: 14px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;

        Rectangle {
            width: 34px;
            height: 34px;

            if root.icon-kind == 0: IcExtension {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                fill: #a89af5;
            }
            if root.icon-kind == 1: IcTag {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                fill: #a89af5;
            }
            if root.icon-kind == 2: IcImage {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                fill: #a89af5;
            }
            if root.icon-kind == 3: IcDisplay {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                fill: #a89af5;
            }
            if root.icon-kind == 4: IcTag {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                fill: #a89af5;
            }
            if root.icon-kind == 5: IcPlay {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                fill: #a89af5;
            }
            if root.icon-kind == 6: IcSettingsGear {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                fill: #a89af5;
            }
        if root.icon-kind == 7: IcSync {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            fill: #a89af5;
        }
        if root.icon-kind == 8: IcImage {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            fill: #a89af5;
        }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                font-size: 14px;
                font-weight: 600;
                color: #f2f2f4;
                overflow: elide;
            }

            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: 12px;
                color: #8a8a92;
                overflow: elide;
            }
        }

        Rectangle {
            width: 34px;
            height: 34px;

            IcChevronRight {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                fill: #6c6c7a;
            }
        }
    }

    touch := TouchArea {
        enabled: root.interactive;
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

export component SettingsPage {
    // Custom components placed in a Window are sized by their preferred size;
    // make this page fill the window (its parent).
    preferred-width: 100%;
    preferred-height: 100%;

    in-out property <[AddonRow]> addon_rows: [];
    in-out property <string> addon_url: "";
    in-out property <string> license_catalog: "";
    in-out property <[LicenseSource]> license_sources: [];
    in-out property <[CategoryRow]> category_rows: [];
    in-out property <[HomeCatalogRow]> home_catalog_rows: [];
    in-out property <[string]> home_catalog_candidate_names: [];
    in-out property <int> home_catalog_candidate_index: -1;
    in-out property <[string]> home_catalog_genre_names: [];
    in-out property <int> home_catalog_genre_index: 0;
    in-out property <bool> home_catalog_add_open: false;
    in-out property <string> home_catalog_add_error: "";
    in-out property <string> category_input: "";
    in-out property <bool> cache_images: true;
    in-out property <string> cache_disk_usage: "";
    in-out property <bool> cache_enabled: false;
    in-out property <int> cache_format_index: 0;
    in-out property <float> cache_quality: 85.0;
    in-out property <bool> cache_downscale: true;
    in-out property <bool> cache_date_relative: true;
    in-out property <bool> cache_show_unwatched_thumbs: true;
    in-out property <float> cache_lru_mb: 128.0;
    in-out property <bool> cache_prefetch_metadata: false;
    in-out property <bool> discover_catalog_addon_names: true;
    in-out property <bool> cache_lazy_reencode: false;
    // Minimum grid columns (Settings → Display below); autosaved.
    in-out property <int> discover_min_cols: 2;
    in-out property <int> library_min_cols: 2;
    // Language of the interface (Settings → Display). Index into the
    // backend's language list (`nova_config::Language::ALL`), pushed in
    // `language_names`; autosaved, and applied to the bundled Slint catalogs
    // by the backend once it lands.
    in-out property <int> language_index: 0;
    // Names are shown in their own language and are never translated, so this
    // list is the same in every language (the backend pushes it from
    // `nova_config::Language::ALL`; this default keeps the page previewable).
    in-out property <[string]> language_names: ["English", "Hrvatski"];
    in-out property <[string]> cache_format_names: ["JPEG", "WebP"];
    // Player section: player backend (0 = built-in mpv, 1 = external) on
    // every platform, plus the desktop external-app picker (0 = system
    // default, 1 = VLC, 2 = mpv) and the Android video decoder (0 = HW+,
    // 1 = HW, 2 = SW). The decoder row stays Android-only.
    in property <bool> is_android: false;
    in-out property <int> android_hwdec_index: 0;
    in-out property <int> player_backend_index: 0;
    in-out property <int> desktop_external_app_index: 0;
    // Playback rate (Settings → Player → Playback speed). The same per-device
    // value the player's own settings panel edits; the ± buttons ask the
    // backend for a quantized step.
    in-out property <float> playback_speed: 1.0;
    in-out property <int> episode_start_index: 1;
    // Look and feel (Settings → Look and feel): master + per-category switches.
    in-out property <bool> animations: true;
    in-out property <bool> anim_transitions: true;
    in-out property <bool> anim_hover: true;
    in-out property <bool> anim_player: true;
    in-out property <bool> anim_nav_slide: true;
    // Hide the desktop-only image-cache re-encode card on the web build.
    in-out property <bool> show_image_cache: true;
    // Torrent streaming (Settings → Torrents). Hidden entirely on the web
    // build, which has no embedded BitTorrent client.
    in-out property <bool> show_torrents: true;
    in-out property <bool> torrent_enabled: true;
    in-out property <string> torrent_dir: "";
    in-out property <float> torrent_max_mb: 20480.0;
    in-out property <float> torrent_down_limit: 0.0;
    in-out property <bool> torrent_no_cache: false;
    in-out property <string> torrent_disk_usage: "";
    in-out property <bool> download_auto_delete_watched: false;
    // Settings → Downloads → Downloaded episodes: completed episode files.
    in-out property <[DownloadRow]> downloads_rows: [];
    // Cross-device sync (Settings → Sync). Opt-in; off by default.
    in-out property <bool> sync_enabled: false;
    // This device's endpoint id (share it so a peer can add this device).
    in-out property <string> sync_identity: "";
    in-out property <[SyncPeer]> sync_peers: [];
    in-out property <string> sync_peer_input: "";
    // Human-readable engine state ("Idle", "Syncing…", an error, …).
    in-out property <string> sync_status: "";
    // Pairing (Settings → Sync): name, confirmation toggle, invites, join.
    in-out property <string> sync_device_name: "";
    in-out property <bool> sync_pair_confirm: false;
    // Local network discovery (UPnP probing, LAN discovery). Off for
    // faulty Wi-Fi that chokes on multicast traffic.
    in-out property <bool> sync_local_discovery: true;
    // Auto-sync interval preset index (0 = 30 s, 1 = 1 min, 2 = 5 min,
    // 3 = 15 min); mapped to seconds in Rust. Governs the app-running loop
    // only; closed-app cadence is the fixed Android background job.
    in-out property <int> sync_interval_index: 1;
    // Periodic best-effort sync while the app is closed (Android job).
    in-out property <bool> sync_background: true;
    in-out property <string> sync_invite_ticket: "";
    in-out property <image> sync_invite_qr;
    in-out property <[SyncInvite]> sync_invites: [];
    in-out property <string> sync_join_input: "";
    in-out property <string> sync_link_notice: "";
    // True on Android, where the camera QR scanner is available.
    in-out property <bool> sync_qr_scan_available: false;
    in-out property <bool> sync_pair_prompt_visible: false;
    in-out property <string> sync_pair_prompt_id: "";
    in-out property <string> sync_pair_prompt_name: "";
    in-out property <string> sync_pair_prompt_code: "";
    // Peer-removal confirmation (UI-local; removal tombstones mesh-wide).
    property <bool> sync_remove_prompt_visible: false;
    property <string> sync_remove_prompt_id: "";
    property <string> sync_remove_prompt_name: "";
    // Formatted readouts for the torrent sliders (Slint has no int→string).
    property <string> torrent_size_label: Math.round(root.torrent_max_mb) + " MB";
    property <string> torrent_rate_label: root.torrent_down_limit <= 0 ? @tr("Unlimited") : Math.round(root.torrent_down_limit) + " KB/s";

    callback discover_picked();
    callback home_picked();
    callback library_picked();
    callback settings_picked();
    callback addon_added(string);
    callback addon_toggled(int);
    callback addon_remove(int);
    callback addon_move_up(int);
    callback addon_move_down(int);
    callback addon_configure(string);
    callback addon_refresh(int);
    // Copy the install URL of the addon at this row (the row shows only its
    // name — the URL lives behind this action).
    callback addon_copy_link(string);
    callback category_added(string);
    callback category_removed(int);
    callback home_catalog_add_requested();
    callback home_catalog_candidate_picked(int);
    callback home_catalog_added(int, int);
    callback home_catalog_removed(int);
    // Playback rate ± one 0.05 step (Settings → Player). The backend
    // quantizes it and writes the property back.
    callback playback_speed_stepped(int);
    // Capture edits immediately; the application owns persistence debouncing.
    callback save_settings();
    in property <bool> persistence_failed: false;
    callback settings_edited(string);
    callback clear_cache();
    // Immediate one-shot: persist current config, then re-encode the
    // existing on-disk cache to it.
    callback reencode_cache();
    // Torrent settings (Settings → Torrents), autosaved like the rest.
    callback torrents_changed();
    callback torrent_dir_edited(string);
    callback clear_torrent_cache();
    callback download_auto_delete_watched_changed(bool);
    // Remove one completed downloaded episode (file + manifest entry).
    callback download_list_remove(string);
    callback license_source_requested(string);
    // Cross-device sync (Settings → Sync).
    callback sync_changed();
    callback sync_add_peer(string);
    callback sync_remove_peer(string);
    callback sync_now();
    callback sync_copy_identity();
    callback sync_device_name_edited(string);
    callback sync_pair_confirm_changed(bool);
    callback sync_local_discovery_changed(bool);
    callback sync_interval_picked(int);
    callback sync_background_changed(bool);
    callback sync_create_invite();
    callback sync_cancel_invite(string);
    callback sync_copy_ticket(string);
    callback sync_join_invite(string);
    callback sync_scan_qr();
    callback sync_respond_pair(string, bool);

    function schedule_save() {
        if (root.kb_zone == 5 && root.kb_hr < 7) {
            root.settings_edited(["cache_images", "enabled", "format", "quality", "downscale", "lazy_reencode", "lru_cache_mb"][root.kb_hr]);
        } else if (root.kb_zone == 6 && root.kb_dr != 5) {
            root.settings_edited(["date_relative", "prefetch_metadata", "show_unwatched_thumbs", "discover_min_cols", "library_min_cols", "language", "discover_catalog_addon_names"][root.kb_dr]);
        } else if (root.kb_zone == 10) {
            root.settings_edited(["animations", "anim_transitions", "anim_hover", "anim_player", "anim_nav_slide"][root.kb_anr]);
        } else {
            root.save_settings();
        }
    }
    function schedule_setting(field: string) { root.settings_edited(field); }

    // Nested "Downloaded episodes" list (Settings → Downloads) entrance. A
    // subpage swap inside the already-open subpage layer would otherwise pop
    // in with no transition, so the list slides/fades in on open (same
    // language as the page-level subpage slide). Deferred one tick so the
    // first value is the animated-from value, not the baseline.
    property <bool> dl_revealed: true;
    dl_reveal_t := Timer {
        interval: 40ms;
        running: false;
        triggered => {
            dl_reveal_t.running = false;
            root.dl_revealed = true;
        }
    }

    // Subpage transitions: `open` drives the slide; `sel` (which section's
    // content is built) is cleared only after the slide-out finishes so the
    // outgoing page stays visible during the animation.
    close_timer := Timer {
        interval: 280ms;
        running: !root.sub_open && root.sel >= 0;
        triggered => { root.sel = -1; }
    }

    // One-shot: after a subpage is built, snap its ScrollView back to the top
    // (the field is fresh but the viewport may carry the previous offset).
    reset_timer := Timer {
        interval: 1ms;
        running: root.reset_pending;
        triggered => {
            set_scroll.content-y = 0px;
            // Also clear any horizontal offset: if content ever overflows,
            // Flickable's drag-pan can leave the page shifted right, and that
            // offset would otherwise persist across subpage opens.
            set_scroll.content-x = 0px;
            root.reset_pending = false;
        }
    }

    // Compact layout for narrow (portrait) windows.
    in property <bool> narrow;
    // Mirrors the content scroll offset (bound by AppWindow; same pattern
    // as the Discover/Library grids).
    in-out property <length> scroll_y: 0px;
    // Top system-bar inset (Android status bar): Window.safe-area-insets,
    // bound by AppWindow. 0 on desktop/web, so layout there is unchanged.
    in property <length> safe-top: 0px;
    // Side insets: in landscape the display cutout / gesture area moves to
    // the left or right edge, so page content must clear it.
    in property <length> safe-left: 0px;
    in property <length> safe-right: 0px;
    // Bottom system-bar inset (Android gesture/nav bar), for the bottom
    // tab bar. 0 on desktop/web.
    in property <length> safe-bottom: 0px;
    // Left inset reserved by the wide-layout navigation rail (0 on narrow).
    property <length> rail_w: root.narrow ? 0px : NavMetrics.rail-width;
    // Keyboard modality (bound to AppWindow, see DiscoverPage).
    in-out property <bool> kb_active;

    // ---- 6-button keyboard nav (arrows + Enter + Backspace) ----
    // The page is now split into a landing menu + one subpage per section.
    // Zones: 0 page-nav, 8 landing menu (selection), then per subpage:
    // 1 addon install [field, add], 2 addon rows, 3 category install
    // [field, add], 4 category rows, 5 image-cache rows, 6 display rows,
    // 7 torrent rows, 9 player rows, 10 look-and-feel rows, 11 sync rows,
    // 12 downloads rows, 14 license source links, 15 About → Licenses button,
    // 16 Home catalog rows.
    // Left/Right moves between rows/zones; Enter activates; Backspace returns to the
    // landing (or Home at the landing). Text fields use edit mode (0 none, 1
    // addon url, 2 category, 3 torrent dir): Enter focuses the field, Enter
    // again submits and exits.
    property <int> kb_zone: 0;
    property <int> kb_nav: 3;
    property <int> kb_actl: 0;
    property <int> kb_ar: 0;
    property <int> kb_ac: 0; // 0 toggle, 1 configure, 2 copy link, 3 refresh, 4 remove, 5 up, 6 down
    property <int> kb_cctl: 0;
    property <int> kb_cr: 0;
    property <int> kb_ccol: 0; // 0 rename, 1 remove
    property <int> kb_hr: 0; // cache rows 0..7 (only 0 when disk cache or re-encode is off)
    property <int> kb_dr: 0;
    property <int> kb_tr: 0; // torrent rows 0..5 (only 0 when streaming is off)
    property <int> kb_pr: 0; // player rows (see kb_player_n)
    property <int> kb_anr: 0; // look-and-feel rows 0..4
    property <int> kb_dl: 0; // downloads rows 0 delete-after-watched, 1 episodes
    property <int> kb_dlr: 0; // downloaded-episodes list row
    property <int> kb_about_idx: 0; // source row on Settings → About → Licenses
    property <int> kb_edit: 0;
    // Landing selection (section ids: 0–8 for Addons through Downloads, 13
    // Home, 10 About; ids 9 and 11 are nested Downloads and Licenses pages).
    property <int> kb_land: 0;
    property <int> kb_home: 0;

    // ---- Landing / subpage navigation state ----
    // `sel` = section id whose content is built (-1 = landing). `sub_open`
    // is the transition target; it flips a frame before `sel` is cleared on
    // close so both pages animate.
    property <int> sel: -1;
    property <bool> sub_open: false;
    property <bool> reset_pending: false;
    // Landing scroll offset (the subpage uses the external `scroll_y`).
    property <length> land_scroll_y: 0px;

    // Which sections are offered on the landing menu, in order.
    // The Player section is always offered: the backend picker (built-in
    // vs external) exists on every platform; only the decoder row inside
    // stays Android-only.
    function land_avail(id: int) -> bool {
        if (id == 2) { return root.show_image_cache; }
        if (id == 4) { return root.show_torrents; }
        if (id == 5) { return true; }
        if (id == 7) { return true; }
        if (id == 8 || id == 10 || id == 13) { return true; }
        return (id >= 0 && id <= 3) || id == 6;
    }

    function land_first() -> int {
        if (root.land_avail(0)) { return 0; }
        if (root.land_avail(1)) { return 1; }
        if (root.land_avail(2)) { return 2; }
        if (root.land_avail(3)) { return 3; }
        if (root.land_avail(4)) { return 4; }
        if (root.land_avail(5)) { return 5; }
        if (root.land_avail(6)) { return 6; }
        if (root.land_avail(7)) { return 7; }
        if (root.land_avail(8)) { return 8; }
        if (root.land_avail(13)) { return 13; }
        if (root.land_avail(10)) { return 10; }
        return 10;
    }

    // Next/previous available section id, clamped at the ends.
    function land_next(id: int) -> int {
        if (id == 13 && root.land_avail(10)) { return 10; }
        if (id < 1 && root.land_avail(1)) { return 1; }
        if (id < 2 && root.land_avail(2)) { return 2; }
        if (id < 3 && root.land_avail(3)) { return 3; }
        if (id < 4 && root.land_avail(4)) { return 4; }
        if (id < 5 && root.land_avail(5)) { return 5; }
        if (id < 6 && root.land_avail(6)) { return 6; }
        if (id < 7 && root.land_avail(7)) { return 7; }
        if (id < 8 && root.land_avail(8)) { return 8; }
        if (id < 13 && root.land_avail(13)) { return 13; }
        if (id < 10 && root.land_avail(10)) { return 10; }
        return id;
    }

    function land_prev(id: int) -> int {
        if (id == 10 && root.land_avail(13)) { return 13; }
        if (id > 8 && root.land_avail(8)) { return 8; }
        if (id > 7 && root.land_avail(7)) { return 7; }
        if (id > 6 && root.land_avail(6)) { return 6; }
        if (id > 5 && root.land_avail(5)) { return 5; }
        if (id > 4 && root.land_avail(4)) { return 4; }
        if (id > 3 && root.land_avail(3)) { return 3; }
        if (id > 2 && root.land_avail(2)) { return 2; }
        if (id > 1 && root.land_avail(1)) { return 1; }
        return 0;
    }

    function land_title(id: int) -> string {
        if (id == 0) { return @tr("Addons"); }
        if (id == 1) { return @tr("Categories"); }
        if (id == 2) { return @tr("Image cache"); }
        if (id == 3) { return @tr("Display"); }
        if (id == 4) { return @tr("P2P"); }
        if (id == 5) { return @tr("Player"); }
        if (id == 6) { return @tr("Look and feel"); }
        if (id == 7) { return @tr("Sync"); }
        if (id == 13) { return @tr("Home"); }
        if (id == 9) { return @tr("Downloaded episodes"); }
        if (id == 10) { return @tr("About"); }
        if (id == 11) { return @tr("Licenses"); }
        return @tr("Downloads");
    }

    function land_desc(id: int) -> string {
        if (id == 0) { return @tr("Installed addons and catalog sources"); }
        if (id == 1) { return @tr("Tags for organising My Library"); }
        if (id == 2) { return @tr("Poster and thumbnail caching"); }
        if (id == 3) { return @tr("Dates, metadata, grid layout and language"); }
        if (id == 4) { return @tr("Stream P2P with the built-in client"); }
        if (id == 5) { return @tr("Built-in or external player"); }
        if (id == 6) { return @tr("Motion, transitions and hover effects"); }
        if (id == 7) { return @tr("Sync library and watch history between devices"); }
        if (id == 13) { return @tr("Featured titles and catalog sources"); }
        if (id == 9) { return @tr("Episode files stored on this device"); }
        if (id == 10) { return @tr("Information about Nova"); }
        return @tr("Offline media and cleanup policy");
    }

    // First keyboard zone of the currently open subpage.
    function page_first_zone() -> int {
        if (root.sel == 0) { return 1; }
        if (root.sel == 1) { return 3; }
        if (root.sel == 2) { return 5; }
        if (root.sel == 3) { return 6; }
        if (root.sel == 4) { return 7; }
        if (root.sel == 5) { return 9; }
        if (root.sel == 6) { return 10; }
        if (root.sel == 7) { return 11; }
        if (root.sel == 8) { return 12; }
        if (root.sel == 13) { return 16; }
        if (root.sel == 9) { return 13; }
        if (root.sel == 10) { return 15; }
        if (root.sel == 11) { return 14; }
        return 0;
    }

    function open_page(id: int) {
        root.kb_active = false;
        root.kb_land = id;
        // The nested downloaded-episodes list gets an entrance transition:
        // arm the from-state before `sel` builds the block, then reveal on the
        // next tick. Skipped when transitions are off (snaps straight in).
        if (id == 9 && Anim.transitions) {
            root.dl_revealed = false;
            dl_reveal_t.running = true;
        } else {
            root.dl_revealed = true;
        }
        // Set the transition target before `sel`: the close timer watches
        // `!sub_open && sel >= 0`, so this avoids a transient restart.
        root.sub_open = true;
        root.sel = id;
        root.reset_pending = true;
        root.kb_clamp_all();
        root.kb_zone = root.page_first_zone();
    }

    function close_page() {
        root.kb_active = false;
        // Nested pages return to their parent rather than the landing menu.
        if (root.sel == 9) {
            root.open_page(8);
            return;
        }
        if (root.sel == 11) {
            root.open_page(10);
            return;
        }
        root.sub_open = false;
        root.kb_zone = 8;
        // Returning to the landing menu: drop any horizontal pan it may have
        // picked up so it is never left shifted to the right.
        land_scroll.content-x = 0px;
    }


    function kb_has_addons() -> bool { return root.addon_rows.length > 0; }
    function kb_has_cats() -> bool { return root.category_rows.length > 0; }
    // Cache rows: 0 images, 1 enable, 2 format, 3 quality, 4 downscale,
    // 5 lazy, 6 memory, 7 re-encode button, 8 clear. Only row 0 when disk
    // caching or re-encoding is off. Rows 7/8 activate on Enter
    // (Left/Right no-op).
    function kb_cache_n() -> int { return root.cache_images && root.cache_enabled ? 9 : 1; }

    // Torrent rows: 0 enable, 1 folder field, 2 size cap, 3 rate limit,
    // 4 no-cache, 5 clear. Only row 0 when streaming is off. Row 5 activates
    // on Enter (Left/Right no-op); row 1 opens text edit mode.
    function kb_torrent_n() -> int { return root.torrent_enabled ? 6 : 1; }

    // One remove action per configured entry plus the final Add catalog row.
    function kb_home_n() -> int { return root.home_catalog_rows.length + 1; }

    function kb_home_activate() {
        if (root.kb_home < root.home_catalog_rows.length) {
            root.home_catalog_removed(root.kb_home);
        } else {
            root.home_catalog_add_requested();
        }
    }

    function kb_ac_has_config() -> bool {
        if (root.kb_ar < 0 || root.kb_ar >= root.addon_rows.length) {
            return false;
        }
        return root.addon_rows[root.kb_ar].config_url != "";
    }

    function kb_clamp_all() {
        if (root.kb_ar >= root.addon_rows.length) {
            root.kb_ar = Math.max(0, root.addon_rows.length - 1);
        }
        if (root.kb_cr >= root.category_rows.length) {
            root.kb_cr = Math.max(0, root.category_rows.length - 1);
        }
        if (root.kb_hr >= root.kb_cache_n()) {
            root.kb_hr = root.kb_cache_n() - 1;
        }
        // Downloads subpage: 2 rows (delete-after-watched, episodes).
        if (root.kb_dl > 1) {
            root.kb_dl = 1;
        }
        if (root.kb_dlr >= root.downloads_rows.length) {
            root.kb_dlr = Math.max(0, root.downloads_rows.length - 1);
        }
        if (root.kb_home >= root.kb_home_n()) {
            root.kb_home = Math.max(0, root.kb_home_n() - 1);
        }
        if (root.kb_about_idx >= root.license_sources.length) {
            root.kb_about_idx = Math.max(0, root.license_sources.length - 1);
        }
        root.kb_player_clamp();
    }

    function kb_nudge(d: length) {
        if (root.kb_zone == 8) {
            let vy = land_scroll.content-y;
            let vh = land_scroll.visible-height;
            let min_y = Math.min(0px, vh - land_scroll.content-height);
            let v = vy + d;
            land_scroll.content-y = Math.max(min_y, Math.min(0px, v));
        } else {
            let vy = set_scroll.content-y;
            let vh = set_scroll.visible-height;
            let min_y = Math.min(0px, vh - set_scroll.content-height);
            let v = vy + d;
            set_scroll.content-y = Math.max(min_y, Math.min(0px, v));
        }
    }

    function kb_up() {
        if (root.kb_zone == 16) {
            if (root.kb_home > 0) {
                root.kb_home -= 1;
                root.kb_nudge(50px);
            } else {
                root.kb_zone = 0;
                root.kb_nudge(150px);
            }
        } else if (root.kb_zone == 15) {
            root.kb_zone = 0;
            root.kb_nudge(150px);
        } else if (root.kb_zone == 14) {
            if (root.kb_about_idx > 0) {
                root.kb_about_idx -= 1;
                root.kb_nudge(50px);
            } else {
                root.kb_zone = 0;
                root.kb_nudge(150px);
            }
        } else if (root.kb_zone == 8) {
            root.kb_zone = 0;
        } else if (root.kb_zone == 12) {
            if (root.kb_dl > 0) {
                root.kb_dl -= 1;
                root.kb_nudge(50px);
            } else {
                root.kb_zone = 0;
                root.kb_nudge(150px);
            }
        } else if (root.kb_zone == 13) {
            if (root.kb_dlr > 0) {
                root.kb_dlr -= 1;
                root.kb_nudge(50px);
            } else {
                root.kb_zone = 0;
                root.kb_nudge(150px);
            }
        } else if (root.kb_zone == 10) {
            if (root.kb_anr > 0) {
                root.kb_anr -= 1;
                root.kb_nudge(50px);
            } else {
                root.kb_zone = 0;
                root.kb_nudge(150px);
            }
        } else if (root.kb_zone == 9) {
            if (root.kb_pr > 0) {
                root.kb_pr -= 1;
                root.kb_nudge(50px);
            } else {
                root.kb_zone = 0;
                root.kb_nudge(150px);
            }
        } else if (root.kb_zone == 7) {
            if (root.kb_tr > 0) {
                root.kb_tr -= 1;
                root.kb_nudge(50px);
            } else {
                root.kb_zone = 0;
                root.kb_nudge(150px);
            }
        } else if (root.kb_zone == 6) {
            if (root.kb_dr > 0) {
                root.kb_dr -= 1;
                root.kb_nudge(50px);
            } else {
                root.kb_zone = 0;
                root.kb_nudge(150px);
            }
        } else if (root.kb_zone == 5) {
            if (root.kb_hr > 0) {
                root.kb_hr -= 1;
                root.kb_nudge(50px);
            } else {
                root.kb_zone = 0;
                root.kb_nudge(150px);
            }
        } else if (root.kb_zone == 4) {
            if (root.kb_cr > 0) {
                root.kb_cr -= 1;
                root.kb_nudge(50px);
            } else {
                root.kb_zone = 3;
                root.kb_nudge(150px);
            }
        } else if (root.kb_zone == 3) {
            root.kb_zone = 0;
            root.kb_nudge(150px);
        } else if (root.kb_zone == 2) {
            if (root.kb_ar > 0) {
                root.kb_ar -= 1;
                root.kb_nudge(50px);
            } else {
                root.kb_zone = 1;
                root.kb_nudge(150px);
            }
        } else if (root.kb_zone == 1) {
            root.kb_zone = 0;
            root.kb_nudge(150px);
        }
    }

    function kb_down() {
        if (root.kb_zone == 15) {
            root.kb_nudge(-150px);
        } else if (root.kb_zone == 16) {
            if (root.kb_home + 1 < root.kb_home_n()) {
                root.kb_home += 1;
                root.kb_nudge(-50px);
            }
        } else if (root.kb_zone == 14) {
            if (root.kb_about_idx + 1 < root.license_sources.length) {
                root.kb_about_idx += 1;
                root.kb_nudge(-50px);
            } else {
                root.kb_nudge(-150px);
            }
        } else if (root.kb_zone == 0) {
            if (root.sel >= 0) {
                root.kb_zone = root.page_first_zone();
                root.kb_nudge(-150px);
            } else {
                root.kb_zone = 8;
                root.kb_land = root.land_first();
                root.kb_nudge(-150px);
            }
        } else if (root.kb_zone == 8) {
            root.kb_land = root.land_next(root.kb_land);
            root.kb_nudge(-50px);
        } else if (root.kb_zone == 1) {
            if (root.kb_has_addons()) {
                root.kb_zone = 2;
                root.kb_ar = 0;
            }
            root.kb_nudge(-150px);
        } else if (root.kb_zone == 2) {
            if (root.kb_ar + 1 < root.addon_rows.length) {
                root.kb_ar += 1;
                root.kb_nudge(-50px);
            }
        } else if (root.kb_zone == 3) {
            if (root.kb_has_cats()) {
                root.kb_zone = 4;
                root.kb_cr = 0;
                root.kb_nudge(-150px);
            }
        } else if (root.kb_zone == 4) {
            if (root.kb_cr + 1 < root.category_rows.length) {
                root.kb_cr += 1;
                root.kb_nudge(-50px);
            }
        } else if (root.kb_zone == 5) {
            if (root.kb_hr + 1 < root.kb_cache_n()) {
                root.kb_hr += 1;
                root.kb_nudge(-50px);
            }
        } else if (root.kb_zone == 6) {
            // Rows 0-5: three toggles, Discover columns, Library columns,
            // Language.
            if (root.kb_dr < 6) {
                root.kb_dr += 1;
                root.kb_nudge(-50px);
            }
        } else if (root.kb_zone == 7) {
            if (root.kb_tr + 1 < root.kb_torrent_n()) {
                root.kb_tr += 1;
                root.kb_nudge(-50px);
            }
        } else if (root.kb_zone == 12) {
            if (root.kb_dl < 1) {
                root.kb_dl += 1;
            }
            root.kb_nudge(-50px);
        } else if (root.kb_zone == 13) {
            if (root.kb_dlr + 1 < root.downloads_rows.length) {
                root.kb_dlr += 1;
                root.kb_nudge(-50px);
            }
        } else if (root.kb_zone == 9) {
            if (root.kb_pr + 1 < root.kb_player_n()) {
                root.kb_pr += 1;
                root.kb_nudge(-50px);
            }
        } else if (root.kb_zone == 10) {
            if (root.kb_anr < 4) {
                root.kb_anr += 1;
                root.kb_nudge(-50px);
            }
        }
    }

    // Addon-row columns, skipping Configure when the addon has none.
    // 4 = move up, 5 = move down, 6 = copy link.
    function kb_ac_right() {
        if (root.kb_ac == 0) {
            root.kb_ac = root.kb_ac_has_config() ? 1 : 2;
        } else if (root.kb_ac == 1) {
            root.kb_ac = 2;
        } else if (root.kb_ac == 2) {
            root.kb_ac = 3;
        } else if (root.kb_ac == 3) {
            root.kb_ac = 4;
        } else if (root.kb_ac == 4) {
            root.kb_ac = 5;
        } else if (root.kb_ac == 5) {
            root.kb_ac = 6;
        }
    }

    function kb_ac_left() {
        if (root.kb_ac == 6) {
            root.kb_ac = 5;
        } else if (root.kb_ac == 5) {
            root.kb_ac = 4;
        } else if (root.kb_ac == 4) {
            root.kb_ac = 3;
        } else if (root.kb_ac == 3) {
            root.kb_ac = 2;
        } else if (root.kb_ac == 2) {
            root.kb_ac = root.kb_ac_has_config() ? 1 : 0;
        } else if (root.kb_ac == 1) {
            root.kb_ac = 0;
        }
    }

    function kb_toggle_addon(i: int) {
        if (i >= 0 && i < root.addon_rows.length) {
            root.addon_rows[i].enabled = !root.addon_rows[i].enabled;
            root.addon_toggled(i);
        }
    }

    function kb_fire_addon_col() {
        if (root.kb_ac == 0) {
            root.kb_toggle_addon(root.kb_ar);
        } else if (root.kb_ac == 1) {
            if (root.kb_ar >= 0 && root.kb_ar < root.addon_rows.length) {
                root.addon_configure(root.addon_rows[root.kb_ar].config_url);
            }
        } else if (root.kb_ac == 2) {
            if (root.kb_ar >= 0 && root.kb_ar < root.addon_rows.length) {
                root.addon_copy_link(root.addon_rows[root.kb_ar].url);
            }
        } else if (root.kb_ac == 3) {
            root.addon_refresh(root.kb_ar);
        } else if (root.kb_ac == 4) {
            root.addon_remove(root.kb_ar);
        } else if (root.kb_ac == 5) {
            root.addon_move_up(root.kb_ar);
            root.kb_ar = Math.max(0, root.kb_ar - 1);
        } else {
            root.addon_move_down(root.kb_ar);
            root.kb_ar = Math.min(root.addon_rows.length - 1, root.kb_ar + 1);
        }
    }

    // Cache-row adjusters (Left/Right and Enter-for-toggles). Row 7 is
    // the Re-encode button and row 8 is Clear: both are Enter-only.
    function kb_cache_flip(r: int) {
        if (r == 0) {
            root.cache_images = !root.cache_images;
            root.schedule_save();
        } else if (r == 1) {
            root.cache_enabled = !root.cache_enabled;
            root.schedule_save();
        } else if (r == 4) {
            root.cache_downscale = !root.cache_downscale;
            root.schedule_save();
        } else if (r == 5) {
            root.cache_lazy_reencode = !root.cache_lazy_reencode;
            root.schedule_save();
        }
    }

    function kb_cache_step(r: int, d: int) {
        if (r == 0 || r == 1 || r == 4 || r == 5) {
            root.kb_cache_flip(r);
        } else if (r == 2) {
            let n = root.cache_format_names.length;
            if (n > 0) {
                root.cache_format_index = Math.max(0, Math.min(n - 1, root.cache_format_index + d));
                root.schedule_save();
            }
        } else if (r == 3) {
            root.cache_quality = Math.max(1, Math.min(100, root.cache_quality + d * 5));
            root.schedule_save();
        } else if (r == 6) {
            root.cache_lru_mb = Math.max(32, Math.min(512, root.cache_lru_mb + d * 16));
            root.schedule_save();
        }
    }

    // Torrent-row adjusters (Left/Right and Enter-for-toggles).
    function kb_torrent_flip(r: int) {
        if (r == 0) {
            root.torrent_enabled = !root.torrent_enabled;
            root.schedule_save();
        } else if (r == 4) {
            root.torrent_no_cache = !root.torrent_no_cache;
            root.schedule_save();
        }
    }

    function kb_torrent_step(r: int, d: int) {
        if (r == 0 || r == 4) {
            root.kb_torrent_flip(r);
        } else if (r == 2) {
            root.torrent_max_mb = Math.max(512, Math.min(32768, root.torrent_max_mb + d * 512));
            root.schedule_save();
        } else if (r == 3) {
            root.torrent_down_limit = Math.max(0, Math.min(102400, root.torrent_down_limit + d * 64));
            root.schedule_save();
        }
    }

    // Player rows: row 0 is always the backend picker (built-in vs
    // external). The second row is the Android decoder (only when built-in
    // is selected), or the desktop external-app picker when the backend is
    // external (hidden when built-in is selected on desktop). The playback
    // rate follows the built-in player on both platforms: last on Android
    // (after the decoder), first-and-only control row on desktop.
    function kb_player_speed_row() -> int {
        if (root.is_android) {
            return root.player_backend_index == 0 ? 3 : -1;
        }
        return root.player_backend_index == 0 ? 2 : -1;
    }

    function kb_player_n() -> int {
        if (root.is_android) { return root.player_backend_index == 0 ? 4 : 2; }
        return 3;
    }

    function kb_player_clamp() {
        if (root.kb_pr >= root.kb_player_n()) {
            root.kb_pr = root.kb_player_n() - 1;
        }
    }

    function kb_player_step(d: int) {
        if (root.kb_pr == 0) {
            root.player_backend_index = Math.max(0, Math.min(1, root.player_backend_index + d));
            root.kb_player_clamp();
            root.schedule_save();
        } else if (root.kb_pr == 1) {
            root.episode_start_index = Math.max(0, Math.min(2, root.episode_start_index + d));
            root.schedule_save();
        } else if (root.kb_pr == root.kb_player_speed_row()) {
            // The backend applies ± a step and re-quantizes; the property
            // comes back with the snapped value.
            root.playback_speed_stepped(d);
            root.schedule_save();
        } else if (root.is_android) {
            root.android_hwdec_index = Math.max(0, Math.min(2, root.android_hwdec_index + d));
            root.schedule_save();
        } else {
            root.desktop_external_app_index = Math.max(0, Math.min(2, root.desktop_external_app_index + d));
            root.schedule_save();
        }
    }

    // Look-and-feel-row toggles (all rows are switches).
    function kb_anim_flip(r: int) {
        if (r == 0) {
            root.animations = !root.animations;
        } else if (r == 1) {
            root.anim_transitions = !root.anim_transitions;
        } else if (r == 2) {
            root.anim_hover = !root.anim_hover;
        } else if (r == 3) {
            root.anim_player = !root.anim_player;
        } else {
            root.anim_nav_slide = !root.anim_nav_slide;
        }
        root.schedule_save();
    }

    function kb_left() {
        if (root.kb_zone == 0) {
            root.kb_nav = Math.mod(root.kb_nav + 3, 4);
        } else if (root.kb_zone == 1) {
            if (root.kb_actl > 0) {
                root.kb_actl -= 1;
            }
        } else if (root.kb_zone == 2) {
            root.kb_ac_left();
        } else if (root.kb_zone == 3) {
            if (root.kb_cctl > 0) {
                root.kb_cctl -= 1;
            }
        } else if (root.kb_zone == 4) {
            if (root.kb_ccol > 0) {
                root.kb_ccol -= 1;
            }
        } else if (root.kb_zone == 5) {
            root.kb_cache_step(root.kb_hr, -1);
        } else if (root.kb_zone == 6) {
            if (root.kb_dr == 0) {
                root.cache_date_relative = !root.cache_date_relative;
                root.schedule_save();
            } else if (root.kb_dr == 1) {
                root.cache_prefetch_metadata = !root.cache_prefetch_metadata;
                root.schedule_save();
            } else if (root.kb_dr == 2) {
                root.cache_show_unwatched_thumbs = !root.cache_show_unwatched_thumbs;
                root.schedule_save();
            } else if (root.kb_dr == 3) {
                root.discover_min_cols = Math.max(2, root.discover_min_cols - 1);
                root.schedule_save();
            } else if (root.kb_dr == 4) {
                root.library_min_cols = Math.max(2, root.library_min_cols - 1);
                root.schedule_save();
            } else if (root.kb_dr == 6) {
                root.discover_catalog_addon_names = !root.discover_catalog_addon_names;
                root.schedule_save();
            } else if (root.language_index > 0) {
                root.language_index -= 1;
                root.schedule_save();
            }
        } else if (root.kb_zone == 7) {
            root.kb_torrent_step(root.kb_tr, -1);
        } else if (root.kb_zone == 9) {
            root.kb_player_step(-1);
        } else if (root.kb_zone == 12) {
            if (root.kb_dl == 0) {
                root.download_auto_delete_watched = !root.download_auto_delete_watched;
                root.download_auto_delete_watched_changed(root.download_auto_delete_watched);
            }
        } else if (root.kb_zone == 10) {
            root.kb_anim_flip(root.kb_anr);
        } else if (root.kb_zone == 16) {
            root.kb_home_activate();
        }
    }

    function kb_right() {
        if (root.kb_zone == 0) {
            root.kb_nav = Math.mod(root.kb_nav + 1, 4);
        } else if (root.kb_zone == 1) {
            if (root.kb_actl < 1) {
                root.kb_actl += 1;
            }
        } else if (root.kb_zone == 2) {
            root.kb_ac_right();
        } else if (root.kb_zone == 3) {
            if (root.kb_cctl < 1) {
                root.kb_cctl += 1;
            }
        } else if (root.kb_zone == 4) {
            if (root.kb_ccol < 1) {
                root.kb_ccol += 1;
            }
        } else if (root.kb_zone == 5) {
            root.kb_cache_step(root.kb_hr, 1);
        } else if (root.kb_zone == 6) {
            if (root.kb_dr == 0) {
                root.cache_date_relative = !root.cache_date_relative;
                root.schedule_save();
            } else if (root.kb_dr == 1) {
                root.cache_prefetch_metadata = !root.cache_prefetch_metadata;
                root.schedule_save();
            } else if (root.kb_dr == 2) {
                root.cache_show_unwatched_thumbs = !root.cache_show_unwatched_thumbs;
                root.schedule_save();
            } else if (root.kb_dr == 3) {
                root.discover_min_cols = Math.min(6, root.discover_min_cols + 1);
                root.schedule_save();
            } else if (root.kb_dr == 4) {
                root.library_min_cols = Math.min(6, root.library_min_cols + 1);
                root.schedule_save();
            } else if (root.kb_dr == 6) {
                root.discover_catalog_addon_names = !root.discover_catalog_addon_names;
                root.schedule_save();
            } else if (root.language_index < root.language_names.length - 1) {
                root.language_index += 1;
                root.schedule_save();
            }
        } else if (root.kb_zone == 7) {
            root.kb_torrent_step(root.kb_tr, 1);
        } else if (root.kb_zone == 9) {
            root.kb_player_step(1);
        } else if (root.kb_zone == 12) {
            if (root.kb_dl == 0) {
                root.download_auto_delete_watched = !root.download_auto_delete_watched;
                root.download_auto_delete_watched_changed(root.download_auto_delete_watched);
            }
        } else if (root.kb_zone == 10) {
            root.kb_anim_flip(root.kb_anr);
        } else if (root.kb_zone == 16) {
            root.kb_home_activate();
        }
    }

    function kb_enter() {
        if (root.kb_zone == 14) {
            if (root.sel == 11 && root.kb_about_idx >= 0
                && root.kb_about_idx < root.license_sources.length) {
                root.license_source_requested(root.license_sources[root.kb_about_idx].url);
            }
        } else if (root.kb_zone == 15 && root.sel == 10) {
            root.open_page(11);
        } else if (root.kb_zone == 8) {
            root.open_page(root.kb_land);
        } else if (root.kb_zone == 0) {
            if (root.kb_nav == 0) {
                root.home_picked();
            } else if (root.kb_nav == 1) {
                root.discover_picked();
            } else if (root.kb_nav == 2) {
                root.library_picked();
            } else {
                root.settings_picked();
            }
        } else if (root.kb_zone == 1) {
            if (root.kb_actl == 0) {
                root.kb_edit = 1;
            } else {
                root.addon_added(root.addon_url);
            }
        } else if (root.kb_zone == 2) {
            root.kb_fire_addon_col();
        } else if (root.kb_zone == 3) {
            if (root.kb_cctl == 0) {
                root.kb_edit = 2;
            } else {
                root.category_added(root.category_input);
                root.category_input = "";
            }
        } else if (root.kb_zone == 4) {
            root.category_removed(root.kb_cr);
        } else if (root.kb_zone == 5) {
            if (root.kb_hr == 7) {
                root.reencode_cache();
            } else if (root.kb_hr == 8) {
                root.clear_cache();
            } else {
                root.kb_cache_flip(root.kb_hr);
            }
        } else if (root.kb_zone == 6) {
            if (root.kb_dr == 0) {
                root.cache_date_relative = !root.cache_date_relative;
                root.schedule_save();
            } else if (root.kb_dr == 1) {
                root.cache_prefetch_metadata = !root.cache_prefetch_metadata;
                root.schedule_save();
            } else if (root.kb_dr == 2) {
                root.cache_show_unwatched_thumbs = !root.cache_show_unwatched_thumbs;
                root.schedule_save();
            }
            // Segmented grid-column rows need no Enter action (same as the
            // format picker in the cache section).
            if (root.kb_dr == 6) {
                root.discover_catalog_addon_names = !root.discover_catalog_addon_names;
                root.schedule_save();
            }
        } else if (root.kb_zone == 7) {
            if (root.kb_tr == 1) {
                root.kb_edit = 3;
            } else if (root.kb_tr == 5) {
                root.clear_torrent_cache();
            } else {
                root.kb_torrent_flip(root.kb_tr);
            }
        } else if (root.kb_zone == 12) {
            if (root.kb_dl == 0) {
                root.download_auto_delete_watched = !root.download_auto_delete_watched;
                root.download_auto_delete_watched_changed(root.download_auto_delete_watched);
            } else {
                root.open_page(9);
            }
        } else if (root.kb_zone == 13) {
            if (root.kb_dlr >= 0 && root.kb_dlr < root.downloads_rows.length) {
                root.download_list_remove(root.downloads_rows[root.kb_dlr].id);
            }
        } else if (root.kb_zone == 10) {
            root.kb_anim_flip(root.kb_anr);
        } else if (root.kb_zone == 16) {
            root.kb_home_activate();
        }
    }

    changed addon_rows => { root.kb_clamp_all(); }
    changed downloads_rows => { root.kb_clamp_all(); }
    changed category_rows => { root.kb_clamp_all(); }
    changed home_catalog_rows => { root.kb_clamp_all(); }
    changed cache_enabled => {
        if (root.kb_hr >= root.kb_cache_n()) {
            root.kb_hr = root.kb_cache_n() - 1;
        }
    }
    changed cache_images => {
        if (root.kb_hr >= root.kb_cache_n()) {
            root.kb_hr = root.kb_cache_n() - 1;
        }
    }
    changed torrent_enabled => {
        if (root.kb_tr >= root.kb_torrent_n()) {
            root.kb_tr = root.kb_torrent_n() - 1;
        }
    }
    changed player_backend_index => { root.kb_player_clamp(); }
    changed show_torrents => {
        if (!root.show_torrents && root.sel == 4) {
            root.close_page();
        }
        if (!root.land_avail(root.kb_land)) {
            root.kb_land = root.land_first();
        }
    }
    changed show_image_cache => {
        if (!root.show_image_cache && root.sel == 2) {
            root.close_page();
        }
        if (!root.land_avail(root.kb_land)) {
            root.kb_land = root.land_first();
        }
    }
    changed is_android => {
        root.kb_player_clamp();
        if (!root.land_avail(root.kb_land)) {
            root.kb_land = root.land_first();
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: #0b0b0e;

        // 6-button scope: overlays the page without intercepting the mouse.
        nav_scope := FocusScope {
            width: 100%;
            height: 100%;
            init => { self.focus(); }
            key-pressed(e) => {
                // Edit mode belongs to the text fields (native there);
                // swallow one stray keypress to recover a lost focus.
                if (root.home_catalog_add_open
                    && (e.text == Key.Backspace || e.text == Key.Back || e.text == Key.Escape)) {
                    root.home_catalog_add_open = false;
                    accept
                } else if (root.home_catalog_add_open && e.text == Key.Return) {
                    if (root.home_catalog_candidate_names.length > 0) {
                        root.home_catalog_added(
                            root.home_catalog_candidate_index,
                            root.home_catalog_genre_index
                        );
                    }
                    accept
                } else if (root.home_catalog_add_open) {
                    reject
                } else if (root.kb_edit != 0) {
                    root.kb_edit = 0;
                    self.focus();
                    accept
                } else if (e.text == Key.UpArrow) {
                    root.kb_active = true;
                    root.kb_up();
                    accept
                } else if (e.text == Key.DownArrow) {
                    root.kb_active = true;
                    root.kb_down();
                    accept
                } else if (e.text == Key.LeftArrow) {
                    root.kb_active = true;
                    root.kb_left();
                    accept
                } else if (e.text == Key.RightArrow) {
                    root.kb_active = true;
                    root.kb_right();
                    accept
                } else if (e.text == Key.Return) {
                    root.kb_active = true;
                    root.kb_enter();
                    accept
                } else if (e.text == Key.Backspace || e.text == Key.Back) {
                    root.kb_active = true;
                    if (root.sel >= 0) {
                        root.close_page();
                    } else {
                        root.home_picked();
                    }
                    accept
                } else {
                    reject
                }
            }
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding-left: 18px + safe-left + root.rail_w;
            padding-right: 18px + safe-right;
            padding-bottom: 18px;
            padding-top: 18px + safe-top;
            spacing: 12px;

            // Pinned: an unpinned 1px row still absorbs free vertical space
            // (see DiscoverPage), stretching the page instead of leaving the
            // slack blank at the bottom.
            Rectangle { vertical-stretch: 0; height: 1px; background: #23232b; }
            if root.persistence_failed: Text {
                text: @tr("Changes could not be saved. Check storage and retry.");
                color: #ffaaaa;
                font-size: 13px;
                min-width: 0;
                wrap: word-wrap;
                vertical-stretch: 0;
            }

            // Settings content host: the landing menu and the open subpage
            // are stacked here and slide/fade between each other. Edits
            // autosave — no Save button.
            content_host := Rectangle {
                vertical-stretch: 1;
                clip: true;

                // ---- Landing menu (section list) ---------------------
                landing_layer := Rectangle {
                    width: 100%;
                    height: 100%;
                    // Push transition: slides left and dims while a subpage
                    // slides in over it; reverses on back.
                    x: root.sub_open ? -0.28 * content_host.width : 0px;
                    opacity: root.sub_open ? 0.0 : 1.0;
                    animate x { duration: Anim.transition_slide; easing: ease-out; }
                    animate opacity { duration: Anim.transition_fade; }

                    VerticalLayout {
                        width: 100%;
                        height: 100%;
                        spacing: 12px;

                        HorizontalLayout {
                            vertical-stretch: 0;
                            height: root.narrow ? 44px : 32px;
                            spacing: 10px;

                            VerticalLayout {
                                width: 22px;
                                height: 100%;
                                alignment: center;

                                Rectangle {
                                    width: 22px;
                                    height: 22px;

                                    IcSettingsGear {
                                        x: 0;
                                        y: 0;
                                        width: 100%;
                                        height: 100%;
                                        fill: #a89af5;
                                    }
                                }
                            }

                            Text {
                                text: @tr("Settings");
                                font-size: 18px;
                                font-weight: 700;
                                color: #f2f2f4;
                                vertical-alignment: center;
                            }
                        }

                        land_scroll := ScrollView {
                            width: 100%;
                            vertical-stretch: 1;
                            // Touch devices scroll by dragging.
                            mouse-drag-pan-enabled: true;
                            init => { self.content-y = root.land_scroll_y; }
                            changed content-y => { root.land_scroll_y = self.content-y; }

                            VerticalLayout {
                                width: 100%;
                                spacing: 8px;

                                Rectangle {
                                    vertical-stretch: 0;
                                    background: #232329;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: #232329;
                                    clip: true;

                                    VerticalLayout {
                                        spacing: 1px;

                                        if root.land_avail(0): SettingsLink {
                                            icon-kind: 0;
                                            title: root.land_title(0);
                                            subtitle: root.land_desc(0);
                                            focused: root.kb_zone == 8 && root.kb_land == 0 && root.kb_active;
                                            interactive: !root.sub_open;
                                            picked => { root.open_page(0); }
                                        }
                                        if root.land_avail(1): SettingsLink {
                                            icon-kind: 1;
                                            title: root.land_title(1);
                                            subtitle: root.land_desc(1);
                                            focused: root.kb_zone == 8 && root.kb_land == 1 && root.kb_active;
                                            interactive: !root.sub_open;
                                            picked => { root.open_page(1); }
                                        }
                                        if root.land_avail(2): SettingsLink {
                                            icon-kind: 2;
                                            title: root.land_title(2);
                                            subtitle: root.land_desc(2);
                                            focused: root.kb_zone == 8 && root.kb_land == 2 && root.kb_active;
                                            interactive: !root.sub_open;
                                            picked => { root.open_page(2); }
                                        }
                                        if root.land_avail(3): SettingsLink {
                                            icon-kind: 3;
                                            title: root.land_title(3);
                                            subtitle: root.land_desc(3);
                                            focused: root.kb_zone == 8 && root.kb_land == 3 && root.kb_active;
                                            interactive: !root.sub_open;
                                            picked => { root.open_page(3); }
                                        }
                                        if root.land_avail(4): SettingsLink {
                                            icon-kind: 4;
                                            title: root.land_title(4);
                                            subtitle: root.land_desc(4);
                                            focused: root.kb_zone == 8 && root.kb_land == 4 && root.kb_active;
                                            interactive: !root.sub_open;
                                            picked => { root.open_page(4); }
                                        }
                                        if root.land_avail(5): SettingsLink {
                                            icon-kind: 5;
                                            title: root.land_title(5);
                                            subtitle: root.land_desc(5);
                                            focused: root.kb_zone == 8 && root.kb_land == 5 && root.kb_active;
                                            interactive: !root.sub_open;
                                            picked => { root.open_page(5); }
                                        }
                                        if root.land_avail(6): SettingsLink {
                                            icon-kind: 6;
                                            title: root.land_title(6);
                                            subtitle: root.land_desc(6);
                                            focused: root.kb_zone == 8 && root.kb_land == 6 && root.kb_active;
                                            interactive: !root.sub_open;
                                            picked => { root.open_page(6); }
                                        }
                                         if root.land_avail(7): SettingsLink {
                                             icon-kind: 7;
                                             title: root.land_title(7);
                                             subtitle: root.land_desc(7);
                                             focused: root.kb_zone == 8 && root.kb_land == 7 && root.kb_active;
                                             interactive: !root.sub_open;
                                             picked => { root.open_page(7); }
                                         }
                                         if root.land_avail(8): SettingsLink {
                                              icon-kind: 8;
                                              title: root.land_title(8);
                                              subtitle: root.land_desc(8);
                                              focused: root.kb_zone == 8 && root.kb_land == 8 && root.kb_active;
                                              interactive: !root.sub_open;
                                              picked => { root.open_page(8); }
                                          }
                                        if root.land_avail(13): SettingsLink {
                                            icon-kind: 4;
                                            title: root.land_title(13);
                                            subtitle: root.land_desc(13);
                                            focused: root.kb_zone == 8 && root.kb_land == 13 && root.kb_active;
                                            interactive: !root.sub_open;
                                            picked => { root.open_page(13); }
                                        }
                                        if root.land_avail(10): SettingsLink {
                                            icon-kind: 6;
                                            title: root.land_title(10);
                                            subtitle: root.land_desc(10);
                                            focused: root.kb_zone == 8 && root.kb_land == 10 && root.kb_active;
                                            interactive: !root.sub_open;
                                            picked => { root.open_page(10); }
                                        }
                                    }
                                }

                                // Absorbs the ScrollView's slack so a short
                                // landing menu stays top-aligned.
                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                    }
                }

                // ---- Subpage (one section) ---------------------------
                sub_layer := Rectangle {
                    width: 100%;
                    height: 100%;
                    background: #0b0b0e;
                    x: root.sub_open ? 0px : content_host.width;
                    opacity: root.sub_open ? 1.0 : 0.0;
                    animate x { duration: Anim.transition_slide; easing: ease-out; }
                    animate opacity { duration: Anim.transition_fade; }

                    VerticalLayout {
                        width: 100%;
                        height: 100%;
                        spacing: 10px;

                        // Back bar: returns to the landing menu (keyboard
                        // users press Backspace).
                        HorizontalLayout {
                            vertical-stretch: 0;
                            height: root.narrow ? 44px : 32px;
                            spacing: 12px;

                            Rectangle {
                                width: root.narrow ? 44px : 32px;
                                height: root.narrow ? 44px : 32px;
                                border-radius: 8px;
                                background: back_touch.has-hover ? #2f2f3a : #26262e;
                                animate background { duration: Anim.hover_fast; }

                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;

                                    IcChevronLeft {
                                        x: 0;
                                        y: 0;
                                        width: 100%;
                                        height: 100%;
                                        fill: #c9c9d4;
                                    }
                                }

                                back_touch := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: pointer;
                                    clicked => { root.close_page(); }
                                }
                            }

                            Text {
                                text: root.land_title(root.sel);
                                font-size: 16px;
                                font-weight: 700;
                                color: #f2f2f4;
                                vertical-alignment: center;
                            }
                        }

                        // Subpage content scrolls when the window is short.
                        // Explicit fill: a plain Rectangle does not size its
                        // children, so without width/height the view would
                        // take its content's full preferred height, overflow
                        // (clipped) and never scroll — fatal on short phones.
                        set_scroll := ScrollView {
                            width: 100%;
                            vertical-stretch: 1;
                            // Touch devices scroll by dragging (there is no
                            // wheel): the fluent-style ScrollView disables
                            // drag-pan by default, so opt in explicitly.
                            mouse-drag-pan-enabled: true;
                            // One-way mirror, see DiscoverPage: Flickable
                            // drops viewport bindings on press, so mirror
                            // explicitly.
                            init => { self.content-y = root.scroll_y; }
                            changed content-y => { root.scroll_y = self.content-y; }
                            VerticalLayout {
                                // The Flickable sizes its content to at least
                                // the viewport (`content-height = max(height,
                                // min)`), so short pages would otherwise spread
                                // the slack across their cards/headers. The
                                // trailing spacer below absorbs it instead,
                                // keeping content top-aligned; long content
                                // still scrolls.
                                spacing: 18px;
                                // Bound to the viewport width: without this
                                // the content sizes to its preferred width
                                // (wide control rows) and the view pans
                                // horizontally on narrow phone screens.
                                width: 100%;

                        if root.sel == 0: VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 18px;

                        // ---- Addons ------------------------------------
                        SectionHeader {
                            icon-kind: 1;
                            label: @tr("ADDONS");
                        }

                        Rectangle {
                            background: #131316;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #232329;
                            clip: true;

                            VerticalLayout {
                                spacing: 0px;

                                // Install row. The 360px text column wraps
                                // the description to 2 lines; the input is
                                // capped so it doesn't span the whole card.
                                // Narrow windows stack the input below the text.
                                install_box := Rectangle {
                                    background: #121214;
                                    // Dynamic narrow height (same wrapped-text
                                    // measuring quirk as SettingsRow above):
                                    // the stacked description wraps to 2+
                                    // lines but Slint sizes wrapped text at
                                    // one line, so without the hidden copy
                                    // below the box clips the input row.
                                    min-height: root.narrow ? Math.max(88px, 105px + install_desc_measure.height) : 88px;

                                    if !root.narrow: HorizontalLayout {
                                        width: 100%;
                                        padding-top: 14px;
                                        padding-bottom: 14px;
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 16px;

                                        VerticalLayout {
                                            width: 360px;
                                            alignment: center;
                                            spacing: 3px;

                                            Text {
                                                text: @tr("Install addon");
                                                font-size: 14px;
                                                font-weight: 600;
                                                color: #f2f2f4;
                                            }

                                            Text {
                                                text: @tr("Paste an addon install URL and add it to the catalog sources.");
                                                font-size: 12px;
                                                color: #8a8a92;
                                                wrap: word-wrap;
                                                width: 360px;
                                                height: 32px;
                                            }
                                        }

                                        // Centered so the input keeps its
                                        // natural height in the tall row.
                                        // Stretched so the input fills the
                                        // space left by the fixed text
                                        // column (same as Discover filters).
                                        VerticalLayout {
                                            height: 100%;
                                            horizontal-stretch: 1;
                                            alignment: center;

                                            HorizontalLayout {
                                                width: 100%;
                                                // Pinned like Discover wide
                                                // filter rows: 32px tall so
                                                // the input stretches to the
                                                // full button height instead
                                                // of collapsing to its
                                                // preferred height.
                                                height: 32px;
                                                spacing: 16px;

                                                KbMark { on: root.kb_zone == 1 && root.kb_actl == 0; active: root.kb_active; }
                                                addon_url_wide := SearchField {
                                                    roomy: root.narrow;
                                                    text <=> root.addon_url;
                                                    placeholder-text: @tr("Addon install URL — e.g. https://v3-cinemeta.strem.io");
                                                    // Redundant with the two-way binding on
                                                    // desktop, but keeps the model in sync on
                                                    // Android IME commit paths.
                                                    edited(t) => { root.addon_url = t; }
                                                    accepted(t) => {
                                                        root.addon_url = t;
                                                        root.kb_edit = 0;
                                                        nav_scope.focus();
                                                        root.addon_added(t);
                                                    }
                                                    horizontal-stretch: 1;
                                                    min-width: 0px;
                                                    max-width: 560px;
                                                }

                                                // Focuses the field on demand: page scope
                                                // cannot see ids inside `if`, but this
                                                // timer (inside the branch) can.
                                                edit_t1 := Timer {
                                                    interval: 80ms;
                                                    running: root.kb_edit == 1 && !root.narrow;
                                                    triggered => { addon_url_wide.focus(); }
                                                }

                                                PillButton {
                                                    label: @tr("Add");
                                                    primary: true;
                                                    roomy: root.narrow;
                                                    btn_min_width: 92px;
                                                    focused: root.kb_zone == 1 && root.kb_actl == 1;
                                                    clicked => { root.kb_active = false; root.kb_zone = 1; root.kb_actl = 1; root.addon_added(addon_url_wide.full-text); }
                                                }
                                            }
                                        }
                                    }

                                    if root.narrow: VerticalLayout {
                                        width: 100%;
                                        padding-top: 14px;
                                        padding-bottom: 14px;
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 10px;

                                        VerticalLayout {
                                            spacing: 3px;

                                            Text {
                                                text: @tr("Install addon");
                                                font-size: 14px;
                                                font-weight: 600;
                                                color: #f2f2f4;
                                            }

                                            Text {
                                                text: @tr("Paste an addon install URL and add it to the catalog sources.");
                                                font-size: 12px;
                                                color: #8a8a92;
                                                wrap: word-wrap;
                                            }
                                        }

                                        // Constrained to the card width: without
                                        // width: 100% the LineEdit sizes to
                                        // its preferred width and pushes the
                                        // Add button off-screen on portrait
                                        // phones (the card clips it).
                                        HorizontalLayout {
                                            width: 100%;
                                            // Pinned like Discover narrow
                                            // search row: 44px touch targets.
                                            height: 44px;
                                            spacing: 12px;

                                            KbMark { on: root.kb_zone == 1 && root.kb_actl == 0; active: root.kb_active; }
                                            addon_url_narrow := SearchField {
                                                roomy: true;
                                                text <=> root.addon_url;
                                                placeholder-text: @tr("Addon install URL — e.g. https://v3-cinemeta.strem.io");
                                                edited(t) => { root.addon_url = t; }
                                                accepted(t) => {
                                                    root.addon_url = t;
                                                    root.kb_edit = 0;
                                                    nav_scope.focus();
                                                    root.addon_added(t);
                                                }
                                                horizontal-stretch: 1;
                                                min-width: 0px;
                                            }

                                            edit_t1n := Timer {
                                                interval: 80ms;
                                                running: root.kb_edit == 1 && root.narrow;
                                                triggered => { addon_url_narrow.focus(); }
                                            }

                                            PillButton {
                                                label: @tr("Add");
                                                primary: true;
                                                roomy: true;
                                                btn_min_width: 92px;
                                                focused: root.kb_zone == 1 && root.kb_actl == 1;
                                                clicked => { root.kb_active = false; root.kb_zone = 1; root.kb_actl = 1; root.addon_added(addon_url_narrow.full-text); }
                                            }
                                        }
                                    }

                                    // Hidden measurement copy of the narrow
                                    // description (see SettingsRow): its real
                                    // wrapped height drives the box minimum
                                    // above so the input row is never clipped.
                                    Rectangle {
                                        height: 0;
                                        clip: true;

                                        install_desc_measure := Text {
                                            width: install_box.width - 32px;
                                            text: @tr("Paste an addon install URL and add it to the catalog sources.");
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                if root.addon_rows.length == 0: Rectangle {
                                    background: #17171a;
                                    min-height: 68px;

                                    Text {
                                        x: 16px;
                                        width: parent.width - 32px;
                                        y: (parent.height - self.height) / 2;
                                        text: @tr("No addons installed yet. Paste an addon install URL above and click Add.");
                                        color: #8a8a92;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }

                                if !root.narrow: VerticalLayout {
                                    spacing: 0px;
                                    for row[i] in root.addon_rows: SettingsRow {
                                        tinted: Math.mod(i, 2) == 1;
                                        row-title: row.label;
                                        // No description: an install URL wrapped over
                                        // several lines and dominated the row. It is
                                        // reachable through the "Copy link" pill.
                                        row-desc: "";

                                        // Wide: text pill + icon actions on one
                                        // line, in keyboard-column order
                                        // (0 toggle, 1 Configure, 2 Copy link,
                                        // 3 Refresh, 4 Remove, 5 move up,
                                        // 6 move down — same sequence as the
                                        // narrow card below). Every control is
                                        // 32px tall so the row stays aligned.
                                        if !root.narrow: HorizontalLayout {
                                            spacing: 12px;

                                            KbMark { on: root.kb_zone == 2 && root.kb_ar == i; active: root.kb_active; }
                                            // Mirror the click back into the model so the
                                            // switch reflects it before the backend refresh
                                            // (which is the source of truth).
                                            ToggleSwitch {
                                                checked: row.enabled;
                                                focused: root.kb_zone == 2 && root.kb_ar == i && root.kb_ac == 0;
                                                toggled => {
                                                    root.addon_rows[i].enabled = self.checked;
                                                    root.kb_active = false;
                                                    root.kb_zone = 2;
                                                    root.kb_ar = i;
                                                    root.kb_ac = 0;
                                                    root.addon_toggled(i);
                                                }
                                            }

                                            // Opens the addon's web config page
                                            // (<addon base>/configure) in a browser.
                                            if row.config_url != "": AddonIconButton {
                                                name: @tr("Configure");
                                                focused: root.kb_zone == 2 && root.kb_ar == i && root.kb_ac == 1;
                                                clicked => { root.kb_active = false; root.kb_zone = 2; root.kb_ar = i; root.kb_ac = 1; root.addon_configure(row.config_url); }
                                                IcSettingsGear {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    width: 22px;
                                                    height: 22px;
                                                    fill: #c9c9d4;
                                                }
                                            }

                                            // The install URL, kept out of the row
                                            // text (see `row-desc` above).
                                            PillButton {
                                                label: @tr("Copy link");
                                                roomy: root.narrow;
                                                compact: true;
                                                focused: root.kb_zone == 2 && root.kb_ar == i && root.kb_ac == 2;
                                                clicked => { root.kb_active = false; root.kb_zone = 2; root.kb_ar = i; root.kb_ac = 2; root.addon_copy_link(row.url); }
                                            }

                                            // Re-fetches manifest.json and refreshes
                                            // all stored metadata for this addon.
                                            AddonIconButton {
                                                name: @tr("Refresh");
                                                focused: root.kb_zone == 2 && root.kb_ar == i && root.kb_ac == 3;
                                                clicked => { root.kb_active = false; root.kb_zone = 2; root.kb_ar = i; root.kb_ac = 3; root.addon_refresh(i); }
                                                IcSync {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    width: 22px;
                                                    height: 22px;
                                                    fill: #c9c9d4;
                                                }
                                            }

                                            AddonIconButton {
                                                name: @tr("Remove");
                                                focused: root.kb_zone == 2 && root.kb_ar == i && root.kb_ac == 4;
                                                clicked => { root.kb_active = false; root.kb_zone = 2; root.kb_ar = i; root.kb_ac = 4; root.addon_remove(i); }
                                                IcDelete {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    width: 22px;
                                                    height: 22px;
                                                    fill: #c9c9d4;
                                                }
                                            }

                                            AddonIconButton {
                                                name: @tr("Move up");
                                                focused: root.kb_zone == 2 && root.kb_ar == i && root.kb_ac == 5;
                                                clicked => { root.kb_active = false; root.kb_zone = 2; root.kb_ac = 5; root.addon_move_up(i); root.kb_ar = Math.max(0, i - 1); }
                                                Text {
                                                    text: "↑";
                                                    font-size: 18px;
                                                    color: #c9c9d4;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            AddonIconButton {
                                                name: @tr("Move down");
                                                focused: root.kb_zone == 2 && root.kb_ar == i && root.kb_ac == 6;
                                                clicked => { root.kb_active = false; root.kb_zone = 2; root.kb_ac = 6; root.addon_move_down(i); root.kb_ar = Math.min(root.addon_rows.length - 1, i + 1); }
                                                Text {
                                                    text: "↓";
                                                    font-size: 18px;
                                                    color: #c9c9d4;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                    }
                                    }

                                // Narrow: the name owns the first line (toggle
                                // + title + move arrows), the remaining actions
                                // the second line underneath — see AddonRowCard
                                // (same keyboard-column order as the wide row).
                                if root.narrow: VerticalLayout {
                                    spacing: 0px;
                                    for row[i] in root.addon_rows: AddonRowCard {
                                        tinted: Math.mod(i, 2) == 1;
                                        title: row.label;
                                        on: row.enabled;
                                        has_config: row.config_url != "";
                                        kb_focused_row: root.kb_zone == 2 && root.kb_ar == i;
                                        kb_active: root.kb_active;
                                        kb_col: root.kb_ac;
                                        toggled(on) => {
                                            root.addon_rows[i].enabled = on;
                                            root.kb_active = false;
                                            root.kb_zone = 2;
                                            root.kb_ar = i;
                                            root.kb_ac = 0;
                                            root.addon_toggled(i);
                                        }
                                        configure => { root.kb_active = false; root.kb_zone = 2; root.kb_ar = i; root.kb_ac = 1; root.addon_configure(row.config_url); }
                                        copy_link => { root.kb_active = false; root.kb_zone = 2; root.kb_ar = i; root.kb_ac = 2; root.addon_copy_link(row.url); }
                                        refresh => { root.kb_active = false; root.kb_zone = 2; root.kb_ar = i; root.kb_ac = 3; root.addon_refresh(i); }
                                        remove => { root.kb_active = false; root.kb_zone = 2; root.kb_ar = i; root.kb_ac = 4; root.addon_remove(i); }
                                        move_up => { root.kb_active = false; root.kb_zone = 2; root.kb_ac = 5; root.addon_move_up(i); root.kb_ar = Math.max(0, i - 1); }
                                        move_down => { root.kb_active = false; root.kb_zone = 2; root.kb_ac = 6; root.addon_move_down(i); root.kb_ar = Math.min(root.addon_rows.length - 1, i + 1); }
                                    }
                                    }
                            }
                        }

                        }

                        if root.sel == 1: VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 18px;

                        // ---- Categories -------------------------------
                        SectionHeader {
                            icon-kind: 2;
                            label: @tr("CATEGORIES");
                        }

                        cat_card := Rectangle {
                            background: #131316;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #232329;
                            clip: true;

                            VerticalLayout {
                                spacing: 0px;

                                // Same proportions as the addons install row.
                                // Narrow windows stack the input below the text.
                                cat_box := Rectangle {
                                    background: #121214;
                                    // Same wrapped-text measuring fix as the
                                    // install row above: grow with the real
                                    // stacked-description height on narrow.
                                    min-height: root.narrow ? Math.max(88px, 105px + cat_desc_measure.height) : 88px;

                                    if !root.narrow: HorizontalLayout {
                                        width: 100%;
                                        padding-top: 14px;
                                        padding-bottom: 14px;
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 16px;

                                        VerticalLayout {
                                            width: 360px;
                                            alignment: center;
                                            spacing: 3px;

                                            Text {
                                                text: @tr("Add category");
                                                font-size: 14px;
                                                font-weight: 600;
                                                color: #f2f2f4;
                                            }

                                            Text {
                                                text: @tr("Create a tag you can assign to items from the detail page and filter the library with.");
                                                font-size: 12px;
                                                color: #8a8a92;
                                                wrap: word-wrap;
                                                width: 360px;
                                                height: 32px;
                                            }
                                        }

                                        VerticalLayout {
                                            height: 100%;
                                            horizontal-stretch: 1;
                                            alignment: center;

                                            HorizontalLayout {
                                                width: 100%;
                                                // Same 32px pin as the addon
                                                // install row above.
                                                height: 32px;
                                                spacing: 16px;

                                                KbMark { on: root.kb_zone == 3 && root.kb_cctl == 0; active: root.kb_active; }
                                                cat_input_wide := SearchField {
                                                    roomy: root.narrow;
                                                    text <=> root.category_input;
                                                    placeholder-text: @tr("New category name");
                                                    edited(t) => { root.category_input = t; }
                                                    accepted(t) => {
                                                        root.category_input = t;
                                                        root.kb_edit = 0;
                                                        nav_scope.focus();
                                                        root.category_added(t);
                                                    }
                                                    horizontal-stretch: 1;
                                                    min-width: 0px;
                                                    max-width: 560px;
                                                }

                                                edit_t2 := Timer {
                                                    interval: 80ms;
                                                    running: root.kb_edit == 2 && !root.narrow;
                                                    triggered => { cat_input_wide.focus(); }
                                                }

                                                PillButton {
                                                    label: @tr("Add");
                                                    primary: true;
                                                    roomy: root.narrow;
                                                    btn_min_width: 92px;
                                            focused: root.kb_zone == 3 && root.kb_cctl == 1;
                                            clicked => { root.kb_active = false; root.kb_zone = 3; root.kb_cctl = 1; root.category_added(cat_input_wide.full-text); root.category_input = ""; }
                                                }
                                            }
                                        }
                                    }

                                    if root.narrow: VerticalLayout {
                                        width: 100%;
                                        padding-top: 14px;
                                        padding-bottom: 14px;
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 10px;

                                        VerticalLayout {
                                            spacing: 3px;

                                            Text {
                                                text: @tr("Add category");
                                                font-size: 14px;
                                                font-weight: 600;
                                                color: #f2f2f4;
                                            }

                                            Text {
                                                text: @tr("Create a tag you can assign to items from the detail page and filter the library with.");
                                                font-size: 12px;
                                                color: #8a8a92;
                                                wrap: word-wrap;
                                            }
                                        }

                                        HorizontalLayout {
                                            width: 100%;
                                            height: 44px;
                                            spacing: 12px;

                                            KbMark { on: root.kb_zone == 3 && root.kb_cctl == 0; active: root.kb_active; }
                                            cat_input_narrow := SearchField {
                                                roomy: true;
                                                text <=> root.category_input;
                                                placeholder-text: @tr("New category name");
                                                edited(t) => { root.category_input = t; }
                                                accepted(t) => {
                                                    root.category_input = t;
                                                    root.kb_edit = 0;
                                                    nav_scope.focus();
                                                    root.category_added(t);
                                                }
                                                horizontal-stretch: 1;
                                                min-width: 0px;
                                            }

                                            edit_t2n := Timer {
                                                interval: 80ms;
                                                running: root.kb_edit == 2 && root.narrow;
                                                triggered => { cat_input_narrow.focus(); }
                                            }

                                            PillButton {
                                                label: @tr("Add");
                                                primary: true;
                                                roomy: true;
                                                btn_min_width: 92px;
                                                focused: root.kb_zone == 3 && root.kb_cctl == 1;
                                                clicked => { root.kb_active = false; root.kb_zone = 3; root.kb_cctl = 1; root.category_added(cat_input_narrow.full-text); root.category_input = ""; }
                                            }
                                        }
                                    }

                                    // Hidden measurement copy of the narrow
                                    // description (see SettingsRow): its real
                                    // wrapped height drives the box minimum
                                    // above so the input row is never clipped.
                                    Rectangle {
                                        height: 0;
                                        clip: true;

                                        cat_desc_measure := Text {
                                            width: cat_box.width - 32px;
                                            text: @tr("Create a tag you can assign to items from the detail page and filter the library with.");
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                if root.category_rows.length == 0: Rectangle {
                                    background: #17171a;
                                    min-height: 68px;

                                    Text {
                                        x: 16px;
                                        width: parent.width - 32px;
                                        y: (parent.height - self.height) / 2;
                                        text: @tr("No categories yet. Add one above, then assign items to categories from the detail page.");
                                        color: #8a8a92;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }

                                for row[i] in root.category_rows: SettingsRow {
                                    tinted: Math.mod(i, 2) == 1;
                                    row-title: row.name;

                                    HorizontalLayout {
                                        spacing: 12px;

                                        KbMark { on: root.kb_zone == 4 && root.kb_cr == i; active: root.kb_active; }
                                        Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: 8px;
                                            background: touch_cat_rename.has-hover ? #2f2f3a : #26262e;
                                            border-width: root.kb_zone == 4 && root.kb_cr == i && root.kb_ccol == 0 ? 2px : 0px;
                                            border-color: #8b5cf6;

                                            Text {
                                                text: "✎";
                                                color: #c9c9d4;
                                                font-size: 14px;
                                            }

                                            touch_cat_rename := TouchArea {
                                                width: 100%;
                                                height: 100%;
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    // For now: prompt is not available in Slint, so we
                                                    // reuse the input field — user types the new name in
                                                    // the input above and clicks the rename indicator.
                                                    // Simplified: just remove + re-add. The backend
                                                    // rename callback is wired for future inline editing.
                                                    root.kb_active = false;
                                                    root.kb_zone = 4;
                                                    root.kb_cr = i;
                                                    root.kb_ccol = 0;
                                                    root.category_removed(i);
                                                }
                                            }
                                        }

                                        PillButton {
                                            label: @tr("Remove");
                                            btn_min_width: 92px;
                                            roomy: root.narrow;
                                            focused: root.kb_zone == 4 && root.kb_cr == i && root.kb_ccol == 1;
                                            clicked => { root.kb_active = false; root.kb_zone = 4; root.kb_cr = i; root.kb_ccol = 1; root.category_removed(i); }
                                        }
                                    }
                                }
                            }
                        }
                        }

                        if root.show_image_cache && root.sel == 2:
                        // ---- Image cache ------------------------------
                        VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 18px;

                            SectionHeader {
                                icon-kind: 3;
                                label: @tr("IMAGE CACHE");
                            }

                            Rectangle {
                                background: #131316;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #232329;
                                clip: true;

                                VerticalLayout {
                                    spacing: 0px;

                                    SettingsRow {
                                        row-title: @tr("Cache images on disk");
                                        row-desc: @tr("Store downloaded posters and thumbnails so they load instantly on later runs. When off, images download fresh every launch.");

                                        ToggleSwitch {
                                            checked <=> root.cache_images;
                                            focused: root.kb_zone == 5 && root.kb_hr == 0;
                                            toggled => { root.kb_active = false; root.kb_zone = 5; root.kb_hr = 0; root.schedule_save(); }
                                        }
                                    }

                                    SettingsRow {
                                        tinted: true;
                                        row-title: @tr("Re-encode cached images");
                                        row-desc: @tr("When off, original downloaded images are cached as-is (default).");

                                        ToggleSwitch {
                                            checked <=> root.cache_enabled;
                                            focused: root.kb_zone == 5 && root.kb_hr == 1;
                                            toggled => { root.kb_active = false; root.kb_zone = 5; root.kb_hr = 1; root.schedule_save(); }
                                        }
                                    }

                                    if root.cache_enabled && root.cache_images: VerticalLayout {
                                        spacing: 0px;

                                        SettingsRow {
                                            row-title: @tr("Format");
                                            row-desc: @tr("Image format used when re-encoding.");

                                            Segmented {
                                                labels: root.cache_format_names;
                                                current_index <=> root.cache_format_index;
                                                focused: root.kb_zone == 5 && root.kb_hr == 2;
                                                picked(i) => { root.kb_active = false; root.kb_zone = 5; root.kb_hr = 2; root.schedule_save(); }
                                            }
                                        }

                                        if !root.narrow: SettingsRow {
                                            tinted: true;
                                            row-min-height: 88px;
                                            row-title: @tr("Quality");
                                            row-desc: @tr("Encoding quality — lower values mean smaller files.");

                                            VerticalLayout {
                                                width: 240px;
                                                // Explicit: a stretchy column would
                                                // otherwise be clipped by the
                                                // text-sized row height.
                                                height: 60px;
                                                spacing: 8px;
                                                alignment: center;

                                                MiniSlider {
                                                    width: 100%;
                                                    minimum: 1;
                                                    maximum: 100;
                                                    value: root.cache_quality;
                                                    focused: root.kb_zone == 5 && root.kb_hr == 3;
                                                    changed(v) => {
                                                        root.cache_quality = v;
                                                        root.kb_active = false;
                                                        root.kb_zone = 5;
                                                        root.kb_hr = 3;
                                                        root.schedule_save();
                                                    }
                                                }

                                                HorizontalLayout {
                                                    alignment: center;

                                                    ValueBox {
                                                        width: 150px;
                                                        text: Math.round(root.cache_quality);
                                                    }
                                                }

                                            }
                                        }

                                        // Narrow: stacked below the text so the
                                        // fixed-width slider column can't push
                                        // the page sideways (see content width
                                        // note above); full-width slider.
                                        if root.narrow: Rectangle {
                                            background: #17171a;

                                            VerticalLayout {
                                                width: 100%;
                                                padding-top: 14px;
                                                padding-bottom: 14px;
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                spacing: 10px;

                                                VerticalLayout {
                                                    spacing: 3px;

                                                    Text {
                                                        text: @tr("Quality");
                                                        font-size: 14px;
                                                        font-weight: 600;
                                                        color: #f2f2f4;
                                                        wrap: word-wrap;
                                                    }

                                                    Text {
                                                        text: @tr("Encoding quality — lower values mean smaller files.");
                                                        font-size: 12px;
                                                        color: #8a8a92;
                                                        wrap: word-wrap;
                                                    }
                                                }

                                                MiniSlider {
                                                    width: 100%;
                                                    minimum: 1;
                                                    maximum: 100;
                                                    value: root.cache_quality;
                                                    focused: root.kb_zone == 5 && root.kb_hr == 3;
                                                    changed(v) => {
                                                        root.cache_quality = v;
                                                        root.kb_active = false;
                                                        root.kb_zone = 5;
                                                        root.kb_hr = 3;
                                                        root.schedule_save();
                                                    }
                                                }

                                                HorizontalLayout {
                                                    alignment: center;

                                                    ValueBox {
                                                        width: 150px;
                                                        text: Math.round(root.cache_quality);
                                                    }
                                                }

                                            }
                                        }

                                        SettingsRow {
                                            row-title: @tr("Downscale images");
                                            row-desc: @tr("Cap the longest side at 1024 px before encoding (smaller cache).");

                                            ToggleSwitch {
                                                checked <=> root.cache_downscale;
                                                focused: root.kb_zone == 5 && root.kb_hr == 4;
                                                toggled => { root.kb_active = false; root.kb_zone = 5; root.kb_hr = 4; root.schedule_save(); }
                                            }
                                        }

                                        SettingsRow {
                                            tinted: true;
                                            row-title: @tr("Re-encode on load");
                                            row-desc: @tr("When an image is loaded, re-encode it to the format/quality above and replace the on-disk cache entry.");

                                            ToggleSwitch {
                                                checked <=> root.cache_lazy_reencode;
                                                focused: root.kb_zone == 5 && root.kb_hr == 5;
                                                toggled => { root.kb_active = false; root.kb_zone = 5; root.kb_hr = 5; root.schedule_save(); }
                                            }
                                        }

                                        if !root.narrow: SettingsRow {
                                            row-min-height: 88px;
                                            row-title: @tr("Cache memory");
                                            row-desc: @tr("Maximum RAM for decoded posters and thumbnails. Lower if memory is tight.");

                                            VerticalLayout {
                                                width: 240px;
                                                // Explicit: a stretchy column would
                                                // otherwise be clipped by the
                                                // text-sized row height.
                                                height: 60px;
                                                spacing: 8px;
                                                alignment: center;

                                                MiniSlider {
                                                    width: 100%;
                                                    minimum: 32;
                                                    maximum: 512;
                                                    value: root.cache_lru_mb;
                                                    focused: root.kb_zone == 5 && root.kb_hr == 6;
                                                    changed(v) => {
                                                        root.cache_lru_mb = v;
                                                        root.kb_active = false;
                                                        root.kb_zone = 5;
                                                        root.kb_hr = 6;
                                                        root.schedule_save();
                                                    }
                                                }

                                                HorizontalLayout {
                                                    alignment: center;

                                                    ValueBox {
                                                        width: 150px;
                                                        text: Math.round(root.cache_lru_mb) + " MB";
                                                    }
                                                }
                                            }
                                        }

                                        // Narrow: stacked, same as Quality above.
                                        if root.narrow: Rectangle {
                                            background: #121214;

                                            VerticalLayout {
                                                width: 100%;
                                                padding-top: 14px;
                                                padding-bottom: 14px;
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                spacing: 10px;

                                                VerticalLayout {
                                                    spacing: 3px;

                                                    Text {
                                                        text: @tr("Cache memory");
                                                        font-size: 14px;
                                                        font-weight: 600;
                                                        color: #f2f2f4;
                                                        wrap: word-wrap;
                                                    }

                                                    Text {
                                                        text: @tr("Maximum RAM for decoded posters and thumbnails. Lower if memory is tight.");
                                                        font-size: 12px;
                                                        color: #8a8a92;
                                                        wrap: word-wrap;
                                                    }
                                                }

                                                MiniSlider {
                                                    width: 100%;
                                                    minimum: 32;
                                                    maximum: 512;
                                                    value: root.cache_lru_mb;
                                                    focused: root.kb_zone == 5 && root.kb_hr == 6;
                                                    changed(v) => {
                                                        root.cache_lru_mb = v;
                                                        root.kb_active = false;
                                                        root.kb_zone = 5;
                                                        root.kb_hr = 6;
                                                        root.schedule_save();
                                                    }
                                                }

                                                HorizontalLayout {
                                                    alignment: center;

                                                    ValueBox {
                                                        width: 150px;
                                                        text: Math.round(root.cache_lru_mb) + " MB";
                                                    }
                                                }
                                            }
                                        }

                                        SettingsRow {
                                            tinted: true;
                                            row-title: @tr("Re-encode existing cache");
                                            row-desc: @tr("Rewrite images already cached on disk to the format/quality above. Runs immediately.");

                                            PillButton {
                                                label: @tr("Re-encode now");
                                                btn_min_width: 140px;
                                                focused: root.kb_zone == 5 && root.kb_hr == 7;
                                                clicked => { root.kb_active = false; root.kb_zone = 5; root.kb_hr = 7; root.reencode_cache(); }
                                            }
                                        }

                                        // Reserve 2 lines for narrow windows.
                                        Rectangle {
                                            background: #121214;
                                            min-height: 68px;

                                            Text {
                                                x: 16px;
                                                width: parent.width - 32px;
                                                y: (parent.height - self.height) / 2;
                                                text: @tr("Changes save automatically and apply to newly cached images. Use \u{201c}Re-encode on load\u{201d} to convert existing images as they are accessed, or \u{201c}Re-encode now\u{201d} to rewrite all at once.");
                                                color: #6c6c7a;
                                                font-size: 12px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    // Readout of the full on-disk image cache
                                    // size (desktop only — the whole card is
                                    // hidden on web) with a Clear button.
                                    // The button is keyboard row 8;
                                    // display-only otherwise (skipped by nav).
                                    if !root.narrow: SettingsRow {
                                        row-title: @tr("Disk usage");
                                        row-desc: @tr("Total size of all cached images on disk.");

                                        HorizontalLayout {
                                            spacing: 12px;

                                            ValueBox {
                                                width: 180px;
                                                text: root.cache_disk_usage;
                                            }

                                            PillButton {
                                                label: @tr("Clear");
                                                btn_min_width: 92px;
                                                focused: root.kb_zone == 5 && root.kb_hr == 8;
                                                clicked => { root.kb_active = false; root.kb_zone = 5; root.kb_hr = 8; root.clear_cache(); }
                                            }
                                        }
                                    }

                                    // Narrow: stacked so the 180px readout +
                                    // button can't push the page sideways.
                                    if root.narrow: Rectangle {
                                        background: #121214;

                                        VerticalLayout {
                                            width: 100%;
                                            padding-top: 14px;
                                            padding-bottom: 14px;
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            spacing: 10px;

                                            VerticalLayout {
                                                spacing: 3px;

                                                Text {
                                                    text: @tr("Disk usage");
                                                    font-size: 14px;
                                                    font-weight: 600;
                                                    color: #f2f2f4;
                                                    wrap: word-wrap;
                                                }

                                                Text {
                                                    text: @tr("Total size of all cached images on disk.");
                                                    font-size: 12px;
                                                    color: #8a8a92;
                                                    wrap: word-wrap;
                                                }
                                            }

                                            HorizontalLayout {
                                                width: 100%;
                                                spacing: 12px;

                                                ValueBox {
                                                    horizontal-stretch: 1;
                                                    text: root.cache_disk_usage;
                                                }

                                                PillButton {
                                                    label: @tr("Clear");
                                                    btn_min_width: 92px;
                                                    focused: root.kb_zone == 5 && root.kb_hr == 8;
                                                    clicked => { root.kb_active = false; root.kb_zone = 5; root.kb_hr = 8; root.clear_cache(); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if root.sel == 3: VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 18px;

                        // ---- Display -----------------------------------
                        SectionHeader {
                            icon-kind: 4;
                            label: @tr("DISPLAY");
                        }

                        Rectangle {
                            background: #131316;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #232329;
                            clip: true;

                            VerticalLayout {
                                spacing: 0px;

                                SettingsRow {
                                    row-title: @tr("Relative episode dates");
                                    row-desc: @tr("Show release dates as \"3 days ago\" instead of \"Mar 15, 2024\".");

                                    ToggleSwitch {
                                        checked <=> root.cache_date_relative;
                                        focused: root.kb_zone == 6 && root.kb_dr == 0;
                                        toggled => { root.kb_active = false; root.kb_zone = 6; root.kb_dr = 0; root.schedule_setting("date_relative"); }
                                    }
                                }

                                SettingsRow {
                                    tinted: true;
                                    row-title: @tr("Prefetch episode metadata");
                                    row-desc: @tr("Download season/episode info in the background for items in Discover. My Library is always prefetched.");

                                    ToggleSwitch {
                                        checked <=> root.cache_prefetch_metadata;
                                        focused: root.kb_zone == 6 && root.kb_dr == 1;
                                        toggled => { root.kb_active = false; root.kb_zone = 6; root.kb_dr = 1; root.schedule_setting("prefetch_metadata"); }
                                    }
                                }

                                SettingsRow {
                                    tinted: false;
                                    row-title: @tr("Show unwatched thumbnails");
                                    row-desc: @tr("Show artwork for episodes you haven't started. When off, unwatched episodes show a placeholder instead.");

                                    ToggleSwitch {
                                        checked <=> root.cache_show_unwatched_thumbs;
                                        focused: root.kb_zone == 6 && root.kb_dr == 2;
                                        toggled => { root.kb_active = false; root.kb_zone = 6; root.kb_dr = 2; root.schedule_setting("show_unwatched_thumbs"); }
                                    }
                                }

                                SettingsRow {
                                    tinted: true;
                                    row-title: @tr("Discover grid columns");
                                    row-desc: @tr("Minimum columns in the Discover grid. More columns show smaller cards — e.g. 3 across on a phone.");

                                    Segmented {
                                        labels: ["2", "3", "4", "5", "6"];
                                        current-index: Math.max(0, Math.min(4, root.discover_min_cols - 2));
                                        focused: root.kb_zone == 6 && root.kb_dr == 3;
                                        picked(i) => { root.kb_active = false; root.kb_zone = 6; root.kb_dr = 3; root.discover_min_cols = i + 2; root.schedule_setting("discover_min_cols"); }
                                    }
                                }

                                SettingsRow {
                                    tinted: false;
                                    row-title: @tr("Library grid columns");
                                    row-desc: @tr("Minimum columns in My Library. Applies automatically.");

                                    Segmented {
                                        labels: ["2", "3", "4", "5", "6"];
                                        current-index: Math.max(0, Math.min(4, root.library_min_cols - 2));
                                        focused: root.kb_zone == 6 && root.kb_dr == 4;
                                        picked(i) => { root.kb_active = false; root.kb_zone = 6; root.kb_dr = 4; root.library_min_cols = i + 2; root.schedule_setting("library_min_cols"); }
                                    }
                                }

                                // Language of the interface (autosaved like the
                                // rest of Display). The labels are the backend's
                                // language list — each shown in its own language,
                                // so they are the one thing here that is not
                                // translated (`nova_config::Language::label`).
                                SettingsRow {
                                    tinted: true;
                                    row-title: @tr("Language");
                                    row-desc: @tr("Language of the interface. Applies to this device only.");

                                    Segmented {
                                        labels: root.language_names;
                                        current-index: root.language_index;
                                        focused: root.kb_zone == 6 && root.kb_dr == 5;
                                        picked(i) => { root.kb_active = false; root.kb_zone = 6; root.kb_dr = 5; root.language_index = i; root.schedule_save(); }
                                    }
                                }
                                SettingsRow {
                                    row-title: @tr("Show addon names in catalogs");
                                    row-desc: @tr("Prefix catalog names with their addon in Discover's All addons view.");
                                    ToggleSwitch {
                                        checked <=> root.discover_catalog_addon_names;
                                        focused: root.kb_zone == 6 && root.kb_dr == 6;
                                        toggled => { root.kb_active = false; root.kb_zone = 6; root.kb_dr = 6; root.schedule_setting("discover_catalog_addon_names"); }
                                    }
                                }
                            }
                        }
                        }

                        if root.show_torrents && root.sel == 4: VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 18px;

                        // ---- Torrents (native only) ---------------------
                        // The embedded BitTorrent client is not compiled into
                        // the web build, so the whole section is hidden there.
                        SectionHeader {
                            icon-kind: 2;
                            label: @tr("P2P");
                        }

                        Rectangle {
                            background: #131316;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #232329;
                            clip: true;

                            VerticalLayout {
                                spacing: 0px;

                                SettingsRow {
                                    row-title: @tr("Stream P2P");
                                    row-desc: @tr("Play P2P stream rows (Torrentio and friends) in the in-app player using a built-in P2P client. Files are kept for instant replay unless \"No caching\" is on.");

                                    ToggleSwitch {
                                        checked <=> root.torrent_enabled;
                                        focused: root.kb_zone == 7 && root.kb_tr == 0;
                                        toggled => { root.kb_active = false; root.kb_zone = 7; root.kb_tr = 0; root.schedule_save(); }
                                    }
                                }

                                if root.torrent_enabled: VerticalLayout {
                                    spacing: 0px;

                                    // Download folder: custom row (like the
                                    // addon install box) so the field can
                                    // stretch; stacked when narrow. The hidden
                                    // measurement copy drives the narrow height
                                    // (wrapped text measures at one line).
                                    torrent_dir_box := Rectangle {
                                        background: #17171a;
                                        min-height: root.narrow ? Math.max(96px, 105px + torrent_dir_measure.height) : 88px;

                                        if !root.narrow: HorizontalLayout {
                                            width: 100%;
                                            padding-top: 14px;
                                            padding-bottom: 14px;
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            spacing: 16px;

                                            VerticalLayout {
                                                width: 360px;
                                                alignment: center;
                                                spacing: 3px;

                                                Text {
                                                    text: @tr("Download folder");
                                                    font-size: 14px;
                                                    font-weight: 600;
                                                    color: #f2f2f4;
                                                }

                                                Text {
                                                    text: @tr("Where P2P data is stored. Leave empty to use the default app cache folder.");
                                                    font-size: 12px;
                                                    color: #8a8a92;
                                                    wrap: word-wrap;
                                                    width: 360px;
                                                    height: 32px;
                                                }
                                            }

                                            VerticalLayout {
                                                height: 100%;
                                                horizontal-stretch: 1;
                                                alignment: center;

                                                HorizontalLayout {
                                                    width: 100%;
                                                    height: 32px;
                                                    spacing: 12px;

                                                    KbMark { on: root.kb_zone == 7 && root.kb_tr == 1; active: root.kb_active; }
                                                    torrent_dir_wide := SearchField {
                                                        text <=> root.torrent_dir;
                                                        placeholder-text: @tr("Default (app cache folder)");
                                                        edited(t) => { root.torrent_dir = t; root.schedule_save(); }
                                                        accepted(t) => {
                                                            root.torrent_dir = t;
                                                            root.kb_edit = 0;
                                                            nav_scope.focus();
                                                            root.torrent_dir_edited(t);
                                                        }
                                                        horizontal-stretch: 1;
                                                        min-width: 0px;
                                                        max-width: 560px;
                                                    }

                                                    edit_t7 := Timer {
                                                        interval: 80ms;
                                                        running: root.kb_edit == 3 && !root.narrow;
                                                        triggered => { torrent_dir_wide.focus(); }
                                                    }
                                                }
                                            }
                                        }

                                        if root.narrow: VerticalLayout {
                                            width: 100%;
                                            padding-top: 14px;
                                            padding-bottom: 14px;
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            spacing: 10px;

                                            VerticalLayout {
                                                spacing: 3px;

                                                Text {
                                                    text: @tr("Download folder");
                                                    font-size: 14px;
                                                    font-weight: 600;
                                                    color: #f2f2f4;
                                                    wrap: word-wrap;
                                                }

                                                Text {
                                                    text: @tr("Where P2P data is stored. Leave empty to use the default app cache folder.");
                                                    font-size: 12px;
                                                    color: #8a8a92;
                                                    wrap: word-wrap;
                                                }
                                            }

                                            HorizontalLayout {
                                                width: 100%;
                                                height: 44px;
                                                spacing: 12px;

                                                KbMark { on: root.kb_zone == 7 && root.kb_tr == 1; active: root.kb_active; }
                                                torrent_dir_narrow := SearchField {
                                                    roomy: true;
                                                    text <=> root.torrent_dir;
                                                    placeholder-text: @tr("Default (app cache folder)");
                                                    edited(t) => { root.torrent_dir = t; root.schedule_save(); }
                                                    accepted(t) => {
                                                        root.torrent_dir = t;
                                                        root.kb_edit = 0;
                                                        nav_scope.focus();
                                                        root.torrent_dir_edited(t);
                                                    }
                                                    horizontal-stretch: 1;
                                                    min-width: 0px;
                                                }

                                                edit_t7n := Timer {
                                                    interval: 80ms;
                                                    running: root.kb_edit == 3 && root.narrow;
                                                    triggered => { torrent_dir_narrow.focus(); }
                                                }
                                            }
                                        }

                                        // Hidden measurement copy (see above).
                                        Rectangle {
                                            height: 0;
                                            clip: true;

                                            torrent_dir_measure := Text {
                                                width: torrent_dir_box.width - 32px;
                                                text: @tr("Where P2P data is stored. Leave empty to use the default app cache folder.");
                                                font-size: 12px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    // Size cap (wide).
                                    if !root.narrow: SettingsRow {
                                        tinted: true;
                                        row-min-height: 88px;
                                        row-title: @tr("Cache size limit");
                                        row-desc: @tr("Maximum disk space for downloaded P2P data. Least-recently-used items are removed first once exceeded.");

                                        VerticalLayout {
                                            width: 240px;
                                            height: 60px;
                                            spacing: 8px;
                                            alignment: center;

                                            MiniSlider {
                                                width: 100%;
                                                minimum: 512;
                                                maximum: 32768;
                                                value: root.torrent_max_mb;
                                                focused: root.kb_zone == 7 && root.kb_tr == 2;
                                                changed(v) => {
                                                    root.torrent_max_mb = v;
                                                    root.kb_active = false;
                                                    root.kb_zone = 7;
                                                    root.kb_tr = 2;
                                                    root.schedule_save();
                                                }
                                            }

                                            HorizontalLayout {
                                                alignment: center;

                                                ValueBox {
                                                    width: 150px;
                                                    text: root.torrent_size_label;
                                                }
                                            }
                                        }
                                    }

                                    // Size cap (narrow): stacked full-width.
                                    if root.narrow: Rectangle {
                                        background: #121214;

                                        VerticalLayout {
                                            width: 100%;
                                            padding-top: 14px;
                                            padding-bottom: 14px;
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            spacing: 10px;

                                            VerticalLayout {
                                                spacing: 3px;

                                                Text {
                                                    text: @tr("Cache size limit");
                                                    font-size: 14px;
                                                    font-weight: 600;
                                                    color: #f2f2f4;
                                                    wrap: word-wrap;
                                                }

                                                Text {
                                                    text: @tr("Maximum disk space for downloaded P2P data. Least-recently-used items are removed first once exceeded.");
                                                    font-size: 12px;
                                                    color: #8a8a92;
                                                    wrap: word-wrap;
                                                }
                                            }

                                            MiniSlider {
                                                width: 100%;
                                                minimum: 512;
                                                maximum: 32768;
                                                value: root.torrent_max_mb;
                                                focused: root.kb_zone == 7 && root.kb_tr == 2;
                                                changed(v) => {
                                                    root.torrent_max_mb = v;
                                                    root.kb_active = false;
                                                    root.kb_zone = 7;
                                                    root.kb_tr = 2;
                                                    root.schedule_save();
                                                }
                                            }

                                            HorizontalLayout {
                                                alignment: center;

                                                ValueBox {
                                                    width: 150px;
                                                    text: root.torrent_size_label;
                                                }
                                            }
                                        }
                                    }

                                    // Download rate limit (wide).
                                    if !root.narrow: SettingsRow {
                                        row-min-height: 88px;
                                        row-title: @tr("Download rate limit");
                                        row-desc: @tr("Cap the download speed. 0 means unlimited.");

                                        VerticalLayout {
                                            width: 240px;
                                            height: 60px;
                                            spacing: 8px;
                                            alignment: center;

                                            MiniSlider {
                                                width: 100%;
                                                minimum: 0;
                                                maximum: 102400;
                                                value: root.torrent_down_limit;
                                                focused: root.kb_zone == 7 && root.kb_tr == 3;
                                                changed(v) => {
                                                    root.torrent_down_limit = v;
                                                    root.kb_active = false;
                                                    root.kb_zone = 7;
                                                    root.kb_tr = 3;
                                                    root.schedule_save();
                                                }
                                            }

                                            HorizontalLayout {
                                                alignment: center;

                                                ValueBox {
                                                    width: 150px;
                                                    text: root.torrent_rate_label;
                                                }
                                            }
                                        }
                                    }

                                    // Download rate limit (narrow): stacked.
                                    if root.narrow: Rectangle {
                                        background: #17171a;

                                        VerticalLayout {
                                            width: 100%;
                                            padding-top: 14px;
                                            padding-bottom: 14px;
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            spacing: 10px;

                                            VerticalLayout {
                                                spacing: 3px;

                                                Text {
                                                    text: @tr("Download rate limit");
                                                    font-size: 14px;
                                                    font-weight: 600;
                                                    color: #f2f2f4;
                                                    wrap: word-wrap;
                                                }

                                                Text {
                                                    text: @tr("Cap the download speed. 0 means unlimited.");
                                                    font-size: 12px;
                                                    color: #8a8a92;
                                                    wrap: word-wrap;
                                                }
                                            }

                                            MiniSlider {
                                                width: 100%;
                                                minimum: 0;
                                                maximum: 102400;
                                                value: root.torrent_down_limit;
                                                focused: root.kb_zone == 7 && root.kb_tr == 3;
                                                changed(v) => {
                                                    root.torrent_down_limit = v;
                                                    root.kb_active = false;
                                                    root.kb_zone = 7;
                                                    root.kb_tr = 3;
                                                    root.schedule_save();
                                                }
                                            }

                                            HorizontalLayout {
                                                alignment: center;

                                                ValueBox {
                                                    width: 150px;
                                                    text: root.torrent_rate_label;
                                                }
                                            }
                                        }
                                    }

                                    SettingsRow {
                                        tinted: true;
                                        row-title: @tr("No caching");
                                        row-desc: @tr("Delete a stream's downloaded data as soon as its playback stops. Overrides keep-for-replay.");

                                        ToggleSwitch {
                                            checked <=> root.torrent_no_cache;
                                            focused: root.kb_zone == 7 && root.kb_tr == 4;
                                            toggled => { root.kb_active = false; root.kb_zone = 7; root.kb_tr = 4; root.schedule_save(); }
                                        }
                                    }

                                    // Disk usage + clear (wide).
                                    if !root.narrow: SettingsRow {
                                        row-title: @tr("Disk usage");
                                        row-desc: @tr("Total size of downloaded P2P data on disk.");

                                        HorizontalLayout {
                                            spacing: 12px;

                                            ValueBox {
                                                width: 180px;
                                                text: root.torrent_disk_usage;
                                            }

                                            PillButton {
                                                label: @tr("Clear");
                                                btn_min_width: 92px;
                                                focused: root.kb_zone == 7 && root.kb_tr == 5;
                                                clicked => { root.kb_active = false; root.kb_zone = 7; root.kb_tr = 5; root.clear_torrent_cache(); }
                                            }
                                        }
                                    }

                                    // Disk usage + clear (narrow): stacked.
                                    if root.narrow: Rectangle {
                                        background: #121214;

                                        VerticalLayout {
                                            width: 100%;
                                            padding-top: 14px;
                                            padding-bottom: 14px;
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            spacing: 10px;

                                            VerticalLayout {
                                                spacing: 3px;

                                                Text {
                                                    text: @tr("Disk usage");
                                                    font-size: 14px;
                                                    font-weight: 600;
                                                    color: #f2f2f4;
                                                    wrap: word-wrap;
                                                }

                                                Text {
                                                    text: @tr("Total size of downloaded P2P data on disk.");
                                                    font-size: 12px;
                                                    color: #8a8a92;
                                                    wrap: word-wrap;
                                                }
                                            }

                                            HorizontalLayout {
                                                width: 100%;
                                                spacing: 12px;

                                                ValueBox {
                                                    horizontal-stretch: 1;
                                                    text: root.torrent_disk_usage;
                                                }

                                                PillButton {
                                                    label: @tr("Clear");
                                                    btn_min_width: 92px;
                                                    focused: root.kb_zone == 7 && root.kb_tr == 5;
                                                    clicked => { root.kb_active = false; root.kb_zone = 7; root.kb_tr = 5; root.clear_torrent_cache(); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        }

                        if root.sel == 5: VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 18px;

                        // ---- Player --------------------------------
                        // The backend picker (built-in mpv vs external app)
                        // exists on every platform. The external-app picker
                        // is desktop-only; the video decoder is Android-only
                        // and applies to built-in playback, so it hides when
                        // the external backend is selected.
                        SectionHeader {
                            icon-kind: 5;
                            label: @tr("PLAYER");
                        }

                        Rectangle {
                            background: #131316;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #232329;
                            clip: true;

                            VerticalLayout {
                                spacing: 0px;

                                SettingsRow {
                                    row-title: @tr("Player");
                                    row-desc: @tr("Built-in plays streams inside the app. External hands them to another video app.");

                                    Segmented {
                                        labels: [@tr("Built-in"), @tr("External")];
                                        current_index <=> root.player_backend_index;
                                        focused: root.kb_zone == 9 && root.kb_pr == 0;
                                        picked(i) => { root.kb_active = false; root.kb_zone = 9; root.kb_pr = 0; root.player_backend_index = i; root.schedule_save(); }
                                    }
                                }

                                SettingsRow {
                                    tinted: true;
                                    row-title: @tr("Episode playback");
                                    row-desc: @tr("Choose how episodes with saved playback history start.");

                                    Segmented {
                                        labels: [@tr("Start over"), @tr("Resume"), @tr("Ask")];
                                        current_index <=> root.episode_start_index;
                                        focused: root.kb_zone == 9 && root.kb_pr == 1;
                                        picked(i) => { root.kb_active = false; root.kb_zone = 9; root.kb_pr = 1; root.episode_start_index = i; root.schedule_save(); }
                                    }
                                }

                                if !root.is_android && root.player_backend_index == 1: SettingsRow {
                                    tinted: true;
                                    row-title: @tr("External app");
                                    row-desc: @tr("Which app opens the stream. System default uses whatever handles video URLs.");

                                    Segmented {
                                        labels: [@tr("System default"), "VLC", "mpv"];
                                        current_index <=> root.desktop_external_app_index;
                                        focused: root.kb_zone == 9 && root.kb_pr == 1;
                                        picked(i) => { root.kb_active = false; root.kb_zone = 9; root.kb_pr = 1; root.desktop_external_app_index = i; root.schedule_save(); }
                                    }
                                }

                                if root.is_android && root.player_backend_index == 0: SettingsRow {
                                    tinted: true;
                                    row-title: @tr("Video decoder");
                                    row-desc: @tr("HW+ keeps decoded frames on the GPU and is fastest; it falls back to HW, then SW. HW falls back to SW.");

                                    Segmented {
                                        labels: ["HW+", "HW", "SW"];
                                        current_index <=> root.android_hwdec_index;
                                        focused: root.kb_zone == 9 && root.kb_pr == 1;
                                        picked(i) => { root.kb_active = false; root.kb_zone = 9; root.kb_pr = 1; root.android_hwdec_index = i; root.schedule_save(); }
                                    }
                                }

                                // Playback rate: only the built-in player uses
                                // it (an external app has its own controls).
                                // The same value the player's own settings
                                // panel edits; ± steps by 0.05, quantized by
                                // the backend.
                                if !root.narrow && root.player_backend_index == 0: SettingsRow {
                                    // Alternate with the row above: the
                                    // Android decoder row (built-in) is
                                    // already tinted.
                                    tinted: !root.is_android;
                                    row-title: @tr("Playback speed");
                                    row-desc: @tr("Rate the built-in player starts at. The slider covers 0.5×–2.0×; ± moves in 0.05× steps.");

                                    VerticalLayout {
                                        width: 240px;
                                        // Slider row + preset row.
                                        height: 68px;
                                        alignment: center;

                                        speed_control := SpeedControl {
                                            speed <=> root.playback_speed;
                                            focused: root.kb_zone == 9 && root.kb_pr == root.kb_player_speed_row();
                                            changed(v) => {
                                                root.playback_speed = v;
                                                root.kb_active = false;
                                                root.kb_zone = 9;
                                                root.kb_pr = root.kb_player_speed_row();
                                                root.schedule_save();
                                            }
                                            stepped(d) => {
                                                root.playback_speed_stepped(d);
                                                root.schedule_save();
                                            }
                                        }
                                    }
                                }

                                // Narrow: the slider column would push the page
                                // sideways, so the control stacks under the
                                // text (same split as the cache sliders).
                                if root.narrow && root.player_backend_index == 0: Rectangle {
                                    background: #17171a;

                                    VerticalLayout {
                                        width: 100%;
                                        padding-top: 14px;
                                        padding-bottom: 14px;
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 10px;

                                        VerticalLayout {
                                            spacing: 3px;

                                            Text {
                                                text: @tr("Playback speed");
                                                font-size: 14px;
                                                font-weight: 600;
                                                color: #f2f2f4;
                                                wrap: word-wrap;
                                            }

                                            Text {
                                                text: @tr("Rate the built-in player starts at. The slider covers 0.5×–2.0×; ± moves in 0.05× steps.");
                                                font-size: 12px;
                                                color: #8a8a92;
                                                wrap: word-wrap;
                                            }
                                        }

                                        speed_control_n := SpeedControl {
                                            speed <=> root.playback_speed;
                                            focused: root.kb_zone == 9 && root.kb_pr == root.kb_player_speed_row();
                                            changed(v) => {
                                                root.playback_speed = v;
                                                root.kb_active = false;
                                                root.kb_zone = 9;
                                                root.kb_pr = root.kb_player_speed_row();
                                                root.schedule_save();
                                            }
                                            stepped(d) => {
                                                root.playback_speed_stepped(d);
                                                root.schedule_save();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                        if root.sel == 6: VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 18px;

                        // ---- Look and feel --------------------------------
                        SectionHeader {
                            icon-kind: 4;
                            label: @tr("LOOK AND FEEL");
                        }

                        Rectangle {
                            background: #131316;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #232329;
                            clip: true;

                            VerticalLayout {
                                spacing: 0px;

                                SettingsRow {
                                    row-title: @tr("Enable animations");
                                    row-desc: @tr("Master switch. Turn off to make every transition and hover effect instant.");

                                    ToggleSwitch {
                                        checked <=> root.animations;
                                        focused: root.kb_zone == 10 && root.kb_anr == 0;
                                        toggled => { root.kb_active = false; root.kb_zone = 10; root.kb_anr = 0; root.schedule_save(); }
                                    }
                                }

                                SettingsRow {
                                    tinted: true;
                                    row-title: @tr("Page transitions");
                                    row-desc: @tr("Slide and fade when opening settings subpages and detail pages.");

                                    ToggleSwitch {
                                        opacity: root.animations ? 1.0 : 0.45;
                                        checked <=> root.anim_transitions;
                                        focused: root.kb_zone == 10 && root.kb_anr == 1;
                                        toggled => { root.kb_active = false; root.kb_zone = 10; root.kb_anr = 1; root.schedule_save(); }
                                    }
                                }

                                SettingsRow {
                                    tinted: false;
                                    row-title: @tr("Hover effects");
                                    row-desc: @tr("Card lift and the highlight on buttons, toggles and rows.");

                                    ToggleSwitch {
                                        opacity: root.animations ? 1.0 : 0.45;
                                        checked <=> root.anim_hover;
                                        focused: root.kb_zone == 10 && root.kb_anr == 2;
                                        toggled => { root.kb_active = false; root.kb_zone = 10; root.kb_anr = 2; root.schedule_save(); }
                                    }
                                }

                                SettingsRow {
                                    tinted: true;
                                    row-title: @tr("Player OSD");
                                    row-desc: @tr("Fade and slide of the player controls, close button and volume slider.");

                                    ToggleSwitch {
                                        opacity: root.animations ? 1.0 : 0.45;
                                        checked <=> root.anim_player;
                                        focused: root.kb_zone == 10 && root.kb_anr == 3;
                                        toggled => { root.kb_active = false; root.kb_zone = 10; root.kb_anr = 3; root.schedule_save(); }
                                    }
                                }

                                SettingsRow {
                                    tinted: false;
                                    row-title: @tr("Navigation feedback");
                                    row-desc: @tr("Gently pop the selected navigation icon when switching pages.");

                                    ToggleSwitch {
                                        opacity: root.animations ? 1.0 : 0.45;
                                        checked <=> root.anim_nav_slide;
                                        focused: root.kb_zone == 10 && root.kb_anr == 4;
                                        toggled => { root.kb_active = false; root.kb_zone = 10; root.kb_anr = 4; root.schedule_save(); }
                                    }
                                }
                            }
                        }
                        }

                        if root.sel == 7: VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 18px;

                        // Incoming pairing request (confirmation mode).
                        if root.sync_pair_prompt_visible: Rectangle {
                            background: #1d1830;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #8b5cf6;
                            clip: true;

                            VerticalLayout {
                                spacing: 10px;
                                padding-top: 16px;
                                padding-bottom: 16px;
                                padding-left: 16px;
                                padding-right: 16px;

                                Text {
                                    text: @tr("Pairing request");
                                    // A heading may wrap: without this it reports its full
                                    // single-line width as the card minimum.
                                    wrap: word-wrap;
                                    min-width: 0px;
                                    font-size: 14px;
                                    font-weight: 700;
                                    color: #f2f2f4;
                                }

                                Text {
                                    text: @tr("{} wants to sync with this device.", root.sync_pair_prompt_name);
                                    font-size: 13px;
                                    color: #c9c9d4;
                                    wrap: word-wrap;
                                    // A device name can be one long token; without
                                    // min-width: 0 it would set the page's minimum
                                    // width and let the subpage pan sideways.
                                    min-width: 0px;
                                }

                                Text {
                                    text: @tr("Match code: {}", root.sync_pair_prompt_code);
                                    font-size: 20px;
                                    font-weight: 700;
                                    color: #a89af5;
                                    letter-spacing: 4px;
                                }

                                HorizontalLayout {
                                    spacing: 12px;

                                    PillButton {
                                        label: @tr("Accept");
                                        primary: true;
                                        clicked => { root.sync_respond_pair(root.sync_pair_prompt_id, true); }
                                    }

                                    PillButton {
                                        label: @tr("Deny");
                                        clicked => { root.sync_respond_pair(root.sync_pair_prompt_id, false); }
                                    }
                                }
                            }
                        }

                        // Confirm a peer removal: it tombstones the peer across
                        // the whole mesh, so a stray tap must not do it.
                        if root.sync_remove_prompt_visible: Rectangle {
                            background: #2a1620;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #b3556e;
                            clip: true;

                            VerticalLayout {
                                spacing: 10px;
                                padding-top: 16px;
                                padding-bottom: 16px;
                                padding-left: 16px;
                                padding-right: 16px;

                                Text {
                                    text: @tr("Remove device?");
                                    font-size: 14px;
                                    font-weight: 700;
                                    color: #f2f2f4;
                                }

                                Text {
                                    text: @tr("{} will be removed from sync on every paired device.", root.sync_remove_prompt_name);
                                    font-size: 13px;
                                    color: #c9c9d4;
                                    wrap: word-wrap;
                                    min-width: 0px;
                                }

                                HorizontalLayout {
                                    spacing: 12px;

                                    PillButton {
                                        label: @tr("Cancel");
                                        clicked => { root.sync_remove_prompt_visible = false; }
                                    }

                                    PillButton {
                                        label: @tr("Remove");
                                        primary: true;
                                        clicked => {
                                            root.sync_remove_peer(root.sync_remove_prompt_id);
                                            root.sync_remove_prompt_visible = false;
                                        }
                                    }
                                }
                            }
                        }

                        // ---- Sync --------------------------------------
                        // Cross-device sync (opt-in). Peers are added by
                        // endpoint id; there is no account or server.
                        SectionHeader {
                            icon-kind: 6;
                            label: @tr("SYNC");
                        }

                        Rectangle {
                            background: #131316;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #232329;
                            clip: true;

                            VerticalLayout {
                                spacing: 0px;

                            SettingsRow {
                                    row-title: @tr("Enable cross-device sync");
                                    row-desc: @tr("Keep your library, watch history, addons and settings in step across your devices. Direct, end-to-end encrypted connections — no account or server.");

                                    ToggleSwitch {
                                        checked <=> root.sync_enabled;
                                        toggled => { root.sync_changed(); }
                                    }
                                }

                            }

                        }

                        if root.sync_enabled: VerticalLayout {
                            spacing: 18px;

                            SectionHeader {
                                icon-kind: 7;
                                label: @tr("THIS DEVICE");
                            }

                            Rectangle {
                                background: #131316;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #232329;
                                clip: true;

                                VerticalLayout {
                                    spacing: 12px;
                                    padding-top: 16px;
                                    padding-bottom: 16px;
                                    padding-left: 16px;
                                    padding-right: 16px;

                                    Text {
                                        text: @tr("Device name");
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: #f2f2f4;
                                    }

                                    SearchField {
                                        roomy: root.narrow;
                                        text <=> root.sync_device_name;
                                        placeholder-text: @tr("Device name");
                                        edited(t) => { root.sync_device_name_edited(t); }
                                        accepted(t) => { root.sync_device_name_edited(t); }
                                        min-width: 0px;
                                    }

                                    Text {
                                        text: @tr("Endpoint ID");
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: #f2f2f4;
                                    }

                                    Text {
                                        text: root.sync_identity;
                                        font-size: 12px;
                                        color: #a89af5;
                                        overflow: elide;
                                        min-width: 0px;
                                    }

                                    Text {
                                        text: @tr("Share this with a peer so it can add this device.");
                                        font-size: 12px;
                                        color: #8a8a92;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;

                                        PillButton {
                                            label: @tr("Copy");
                                            clicked => { root.sync_copy_identity(); }
                                        }

                                        PillButton {
                                            label: @tr("Sync now");
                                            primary: true;
                                            clicked => { root.sync_now(); }
                                        }
                                    }

                                    if root.sync_status != "": Text {
                                        text: root.sync_status;
                                        font-size: 12px;
                                        color: #8a8a92;
                                        wrap: word-wrap;
                                        // Status text embeds peer endpoint ids and
                                        // errors; keep a long token from widening
                                        // the page.
                                        min-width: 0px;
                                    }
                                }
                            }

                            SectionHeader {
                                icon-kind: 7;
                                label: @tr("AUTO-SYNC");
                            }

                            Rectangle {
                                background: #131316;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #232329;
                                clip: true;

                                VerticalLayout {
                                    spacing: 0px;

                                    SettingsRow {
                                        row-title: @tr("Auto-sync while the app is running");
                                        row-desc: @tr("How often to check for changes while the app is open or a download is active.");

                                        Segmented {
                                            labels: [@tr("30s"), @tr("1m"), @tr("5m"), @tr("15m")];
                                            current_index <=> root.sync_interval_index;
                                            picked(i) => { root.sync_interval_picked(i); }
                                        }
                                    }

                                    SettingsRow {
                                        row-title: @tr("Background sync");
                                        row-desc: @tr("Best-effort sync while the app is closed. Android schedules it and may delay it — often every 15–60 min, longer in deep Doze.");

                                        ToggleSwitch {
                                            checked <=> root.sync_background;
                                            toggled => { root.sync_background_changed(root.sync_background); }
                                        }
                                    }

                                    SettingsRow {
                                        row-title: @tr("Local network discovery");
                                        row-desc: @tr("Probe the local network for direct connections (UPnP, LAN discovery). Turn off on faulty Wi-Fi that chokes on multicast traffic.");

                                        ToggleSwitch {
                                            checked <=> root.sync_local_discovery;
                                            toggled => { root.sync_local_discovery_changed(root.sync_local_discovery); }
                                        }
                                    }
                                }
                            }

                            SectionHeader {
                                icon-kind: 7;
                                label: @tr("PAIRING");
                            }

                            Rectangle {
                                background: #131316;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #232329;
                                clip: true;

                                VerticalLayout {
                                    spacing: 0px;

                                    SettingsRow {
                                        row-title: @tr("Ask before accepting devices");
                                        row-desc: @tr("Show a confirmation prompt with a match code instead of trusting an invite automatically.");

                                        ToggleSwitch {
                                            checked <=> root.sync_pair_confirm;
                                            toggled => { root.sync_pair_confirm_changed(root.sync_pair_confirm); }
                                        }
                                    }

                                    Rectangle {
                                        background: #121214;

                                        VerticalLayout {
                                            spacing: 10px;
                                            padding-top: 16px;
                                            padding-bottom: 16px;
                                            padding-left: 16px;
                                            padding-right: 16px;

                                            Text {
                                                text: @tr("Create an invite to add another device");
                                                // A heading may wrap: without this it reports its full
                                                // single-line width as the card minimum.
                                                wrap: word-wrap;
                                                min-width: 0px;
                                                font-size: 13px;
                                                color: #c9c9d4;
                                            }

                                            HorizontalLayout {
                                                spacing: 12px;

                                                PillButton {
                                                    label: @tr("Create invite");
                                                    primary: true;
                                                    clicked => { root.sync_create_invite(); }
                                                }

                                                if root.sync_invite_ticket != "": PillButton {
                                                    label: @tr("Copy code");
                                                    clicked => { root.sync_copy_ticket(root.sync_invite_ticket); }
                                                }
                                            }

                                            if root.sync_invite_ticket != "": HorizontalLayout {
                                                // QR of the ticket: a phone
                                                // camera (the Android scanner)
                                                // reads it as if pasted. White
                                                // backdrop + pixelated scaling
                                                // keep the modules crisp.
                                                alignment: center;
                                                Rectangle {
                                                    background: #ffffff;
                                                    border-radius: 8px;
                                                    width: 220px;
                                                    height: 220px;
                                                    Image {
                                                        source: root.sync_invite_qr;
                                                        width: 100%;
                                                        height: 100%;
                                                        image-fit: contain;
                                                        image-rendering: pixelated;
                                                    }
                                                }
                                            }

                                            if root.sync_invite_ticket != "": Text {
                                                text: root.sync_invite_ticket;
                                                font-size: 12px;
                                                color: #a89af5;
                                                wrap: word-wrap;
                                                // The ticket is an "NV1" base32 token
                                                // with no break opportunities; elide it
                                                // (there is a Copy button) so it can
                                                // never widen the page.
                                                overflow: elide;
                                                min-width: 0px;
                                            }
                                        }
                                    }

                                    for invite[i] in root.sync_invites: SettingsRow {
                                        tinted: Math.mod(i, 2) == 0;
                                        row-title: @tr("Invite {}", invite.id);
                                        row-desc: "";

                                        PillButton {
                                            label: @tr("Cancel");
                                            clicked => { root.sync_cancel_invite(invite.id); }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                background: #131316;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #232329;
                                clip: true;

                                VerticalLayout {
                                    spacing: 10px;
                                    padding-top: 16px;
                                    padding-bottom: 16px;
                                    padding-left: 16px;
                                    padding-right: 16px;

                                    Text {
                                        text: @tr("Join with an invite code");
                                        // A heading may wrap: without this it reports its full
                                        // single-line width as the card minimum.
                                        wrap: word-wrap;
                                        min-width: 0px;
                                        font-size: 13px;
                                        color: #c9c9d4;
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;

                                        SearchField {
                                            roomy: root.narrow;
                                            text <=> root.sync_join_input;
                                            placeholder-text: @tr("paste invite code");
                                            horizontal-stretch: 1;
                                            min-width: 0px;
                                            accepted(t) => { root.sync_join_invite(t); }
                                        }

                                        PillButton {
                                            label: @tr("Join");
                                            roomy: root.narrow;
                                            primary: true;
                                            clicked => { root.sync_join_invite(root.sync_join_input); }
                                        }
                                    }

                                    // Android only: aim the camera at the
                                    // other device's invite QR. Decoding
                                    // joins automatically.
                                    if root.sync_qr_scan_available: PillButton {
                                        label: @tr("Scan QR code");
                                        clicked => { root.sync_scan_qr(); }
                                    }

                                    if root.sync_link_notice != "": Text {
                                        text: root.sync_link_notice;
                                        font-size: 12px;
                                        color: #8a8a92;
                                        wrap: word-wrap;
                                        min-width: 0px;
                                    }
                                }
                            }

                            SectionHeader {
                                icon-kind: 7;
                                label: @tr("PEERS");
                            }

                            Rectangle {
                                background: #131316;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #232329;
                                clip: true;

                                VerticalLayout {
                                    spacing: 0px;

                                    Rectangle {
                                        background: #121214;

                                        VerticalLayout {
                                            spacing: 10px;
                                            padding-top: 16px;
                                            padding-bottom: 16px;
                                            padding-left: 16px;
                                            padding-right: 16px;

                                            Text {
                                                text: @tr("Add a device by its endpoint ID");
                                                // A heading may wrap: without this it reports its full
                                                // single-line width as the card minimum.
                                                wrap: word-wrap;
                                                min-width: 0px;
                                                font-size: 13px;
                                                color: #c9c9d4;
                                            }

                                            HorizontalLayout {
                                                spacing: 12px;

                                                sync_peer_field := SearchField {
                                                    roomy: root.narrow;
                                                    text <=> root.sync_peer_input;
                                                    placeholder-text: @tr("peer endpoint id");
                                                    horizontal-stretch: 1;
                                                    min-width: 0px;
                                                    accepted(t) => { root.sync_add_peer(t); }
                                                }

                                                PillButton {
                                                    label: @tr("Add");
                                                    roomy: root.narrow;
                                                    primary: true;
                                                    clicked => { root.sync_add_peer(root.sync_peer_input); }
                                                }
                                            }
                                        }
                                    }

                                    for peer[i] in root.sync_peers: SettingsRow {
                                        tinted: Math.mod(i, 2) == 0;
                                        row-title: peer.name == "" ? peer.id : peer.name;
                                        row-desc: (peer.name == "" ? "" : peer.id + "\n") + peer.last_seen;

                                        PillButton {
                                            label: @tr("Remove");
                                            clicked => {
                                                root.sync_remove_prompt_id = peer.id;
                                                root.sync_remove_prompt_name = peer.name == "" ? peer.id : peer.name;
                                                root.sync_remove_prompt_visible = true;
                                            }
                                        }
                                    }

                                    if root.sync_peers.length == 0: Rectangle {
                                        background: #121214;
                                        min-height: 56px;

                                        Text {
                                            x: 16px;
                                            y: (parent.height - self.height) / 2;
                                            width: parent.width - 32px;
                                            text: @tr("No peers yet. Add another device to start syncing.");
                                            font-size: 12px;
                                            color: #8a8a92;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                        }
                        if root.sel == 13: VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 18px;

                            SectionHeader {
                                icon-kind: 4;
                                label: @tr("FEATURED SHOWCASE");
                            }

                            Text {
                                width: 100%;
                                text: @tr("Add catalogs with an optional genre filter. Each selection contributes up to five titles.");
                                font-size: 12px;
                                color: #b9b9c4;
                                wrap: word-wrap;
                            }

                            Rectangle {
                                background: #131316;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #232329;
                                clip: true;

                                VerticalLayout {
                                    spacing: 0px;

                                    if root.home_catalog_rows.length == 0: Rectangle {
                                        background: #121214;
                                        min-height: 64px;

                                        Text {
                                            x: 16px;
                                            y: (parent.height - self.height) / 2;
                                            width: parent.width - 32px;
                                            text: @tr("No featured catalogs selected. Add one to choose its genre.");
                                            font-size: 12px;
                                            color: #8a8a92;
                                            wrap: word-wrap;
                                        }
                                    }

                                    for home[i] in root.home_catalog_rows: SettingsRow {
                                        tinted: Math.mod(i, 2) == 0;
                                        row-title: home.title;
                                        row-desc: home.addon + " · " + home.media_type
                                            + " · " + (home.genre == "" ? @tr("All genres") : home.genre)
                                            + (home.available ? (home.enabled ? "" : " · " + @tr("Addon disabled")) : " · " + @tr("Unavailable addon"));

                                        home_catalog_remove := PillButton {
                                            label: @tr("Remove");
                                            roomy: root.narrow;
                                            focused: root.kb_zone == 16 && root.kb_home == i && root.kb_active;
                                            clicked => {
                                                root.kb_active = false;
                                                root.kb_zone = 16;
                                                root.kb_home = i;
                                                root.home_catalog_removed(i);
                                            }
                                        }
                                    }
                                }
                            }

                            home_catalog_add := PillButton {
                                label: @tr("Add catalog");
                                primary: true;
                                roomy: root.narrow;
                                focused: root.kb_zone == 16 && root.kb_home == root.home_catalog_rows.length && root.kb_active;
                                clicked => {
                                    root.kb_active = false;
                                    root.kb_zone = 16;
                                    root.kb_home = root.home_catalog_rows.length;
                                    root.home_catalog_add_requested();
                                }
                            }
                        }

                        if root.sel == 8: VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 18px;

                            SectionHeader {
                                icon-kind: 8;
                                label: @tr("DOWNLOADS");
                            }

                            Rectangle {
                                background: #131316;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #232329;
                                clip: true;

                                VerticalLayout {
                                    spacing: 0px;

                                    SettingsRow {
                                        row-title: @tr("Auto-delete watched episodes");
                                        row-desc: @tr("Delete a downloaded episode once you mark it watched. Movie downloads are never removed by this setting.");

                                        ToggleSwitch {
                                            checked <=> root.download_auto_delete_watched;
                                            focused: root.kb_zone == 12 && root.kb_dl == 0;
                                            toggled => {
                                                root.kb_active = false;
                                                root.kb_zone = 12;
                                                root.kb_dl = 0;
                                                root.download_auto_delete_watched_changed(root.download_auto_delete_watched);
                                            }
                                        }
                                    }

                                    SettingsRow {
                                        tinted: true;
                                        row-title: @tr("Downloaded episodes");
                                        row-desc: @tr("Stored on this device: {n} episode" | "Stored on this device: {n} episodes" % root.downloads_rows.length);

                                        PillButton {
                                            label: @tr("View");
                                            focused: root.kb_zone == 12 && root.kb_dl == 1;
                                            clicked => {
                                                root.kb_active = false;
                                                root.kb_zone = 12;
                                                root.kb_dl = 1;
                                                root.open_page(9);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if root.sel == 9: Rectangle {
                            vertical-stretch: 0;
                            height: dl_inner.preferred-height;

                            // Entrance slide/fade for the nested list. The
                            // subpage layer is already open when this swaps in,
                            // so this is the only open transition it gets.
                            dl_inner := VerticalLayout {
                                width: 100%;
                                spacing: 18px;
                                x: root.dl_revealed ? 0px : 0.28 * root.width;
                                opacity: root.dl_revealed ? 1.0 : 0.0;
                                animate x { duration: Anim.transition_slide; easing: ease-out; }
                                animate opacity { duration: Anim.transition_fade; }

                                SectionHeader {
                                    icon-kind: 8;
                                    label: @tr("DOWNLOADED EPISODES");
                                }

                                if root.downloads_rows.length == 0: Rectangle {
                                    background: #121214;
                                    border-radius: 10px;
                                    min-height: 56px;

                                    Text {
                                        x: 16px;
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width - 32px;
                                        text: @tr("No downloaded episodes. Download an episode from its stream list to see it here.");
                                        font-size: 12px;
                                        color: #8a8a92;
                                        wrap: word-wrap;
                                    }
                                }

                                Rectangle {
                                    visible: root.downloads_rows.length > 0;
                                    background: #131316;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: #232329;
                                    clip: true;

                                    VerticalLayout {
                                        spacing: 0px;

                                        for dl[i] in root.downloads_rows: SettingsRow {
                                            tinted: Math.mod(i, 2) == 0;
                                            row-title: dl.title;
                                            row-desc: dl.subtitle + (dl.details == "" ? "" : "\n" + dl.details);

                                            PillButton {
                                                label: @tr("Delete");
                                                focused: root.kb_zone == 13 && root.kb_dlr == i;
                                                clicked => {
                                                    root.kb_active = false;
                                                    root.kb_zone = 13;
                                                    root.kb_dlr = i;
                                                    root.download_list_remove(dl.id);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if root.sel == 10: VerticalLayout {
                            width: 100%;
                            vertical-stretch: 0;
                            spacing: 16px;

                            SectionHeader {
                                icon-kind: 6;
                                label: @tr("ABOUT NOVA");
                            }

                            Text {
                                width: 100%;
                                text: @tr("Nova is a media catalog and player application.");
                                font-size: 12px;
                                color: #b9b9c4;
                                wrap: word-wrap;
                            }

                            about_licenses_button := PillButton {
                                label: @tr("Licenses");
                                roomy: root.narrow;
                                focused: root.kb_zone == 15 && root.kb_active;
                                clicked => {
                                    root.kb_active = false;
                                    root.kb_zone = 15;
                                    root.open_page(11);
                                }
                            }
                        }

                        if root.sel == 11: VerticalLayout {
                            width: 100%;
                            vertical-stretch: 0;
                            spacing: 16px;

                            SectionHeader {
                                icon-kind: 6;
                                label: @tr("OPEN-SOURCE LICENSES");
                            }

                            Text {
                                width: 100%;
                                min-width: 0px;
                                text: @tr("Nova is licensed under GPL-3.0-or-later. This page lists the Rust crates used by this build, Nova's workspace crates, bundled native media components, and their license texts.");
                                font-size: 12px;
                                color: #b9b9c4;
                                wrap: word-wrap;
                            }

                            SectionHeader {
                                icon-kind: 6;
                                label: @tr("SOURCE CODE");
                            }

                            for source[i] in root.license_sources: source_card := Rectangle {
                                width: 100%;
                                background: Math.mod(i, 2) == 0 ? #17171a : #121214;
                                height: root.narrow ? 60px : 48px;
                                border-radius: 8px;

                                HorizontalLayout {
                                    width: 100%;
                                    height: 100%;
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 10px;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: source.label;
                                            font-size: 12px;
                                            color: #f2f2f4;
                                            overflow: elide;
                                            min-width: 0px;
                                        }

                                        Text {
                                            text: source.license;
                                            font-size: 10px;
                                            color: #8a8a92;
                                            overflow: elide;
                                            min-width: 0px;
                                        }
                                    }

                                    // A HorizontalLayout top-aligns fixed-height
                                    // children. Fill the row vertically and use
                                    // the inner layout to center the source action.
                                    VerticalLayout {
                                        height: 100%;
                                        alignment: center;

                                        source_view_button := PillButton {
                                            label: @tr("Open source");
                                            roomy: root.narrow;
                                            compact: root.narrow;
                                            focused: root.kb_zone == 14 && root.kb_about_idx == i && root.kb_active;
                                            clicked => {
                                                root.kb_active = false;
                                                root.kb_zone = 14;
                                                root.kb_about_idx = i;
                                                root.license_source_requested(source.url);
                                            }
                                        }
                                    }
                                }
                            }

                            SectionHeader {
                                icon-kind: 6;
                                label: @tr("LICENSE TEXTS");
                            }

                            Text {
                                width: 100%;
                                min-width: 0px;
                                text: root.license_catalog;
                                font-size: 10px;
                                color: #b9b9c4;
                                // Legal text may contain long unbroken tokens;
                                // word-wrap preserves their intrinsic width and
                                // can make the whole page pan on a narrow screen.
                                wrap: char-wrap;
                                vertical-alignment: top;
                            }
                        }

                        // Absorbs the Flickable's slack so a short subpage stays
                        // top-aligned instead of stretching its content.
                        Rectangle { vertical-stretch: 1; }
                }
            }
                    }
                }
            }

            // Bottom tab bar (narrow only): wide layouts use the left rail.
            // Hidden while a settings subpage is open so the detail view
            // gets the full height and the bar does not overlap it.
            if root.narrow && !root.sub_open: bottom := BottomNav {
                active: 3;
                safe-bottom: root.safe-bottom;
                kb_zone: root.kb_zone;
                kb_nav: root.kb_nav;
                kb_active <=> root.kb_active;

                home_picked => { root.home_picked(); }
                discover_picked => { root.discover_picked(); }
                library_picked => { root.library_picked(); }
                settings_picked => { root.settings_picked(); }
            }
        }

        // Left navigation rail (wide layouts only; narrow uses the bottom
        // bar — hidden there on a subpage). Declared after the page column
        // so it paints over the strip its own footprint reserves — the
        // column widens its left padding by `rail_w`, so no page content
        // lands under it.
        if !root.narrow: rail := SideNav {
            active: 3;
            safe-top: root.safe-top;
            safe-left: root.safe-left;
            safe-bottom: root.safe-bottom;
            kb_zone: root.kb_zone;
            kb_nav: root.kb_nav;
            kb_active <=> root.kb_active;

            home_picked => { root.home_picked(); }
            discover_picked => { root.discover_picked(); }
            library_picked => { root.library_picked(); }
            settings_picked => { root.settings_picked(); }
        }

        if root.home_catalog_add_open: Rectangle {
            width: 100%;
            height: 100%;
            background: #000000aa;

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.home_catalog_add_open = false; }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: Math.min(parent.width - 32px, 520px);
                height: Math.min(parent.height - 32px, 420px);
                background: #17171d;
                border-width: 1px;
                border-color: #454552;
                border-radius: 12px;
                clip: true;

                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    padding: 18px;
                    spacing: 10px;

                    Text {
                        text: @tr("Add featured catalog");
                        font-size: 17px;
                        font-weight: 700;
                        color: #f2f2f4;
                    }

                    Text {
                        width: 100%;
                        text: @tr("Choose a catalog and optional genre to feature on Home.");
                        font-size: 12px;
                        color: #b9b9c4;
                        wrap: word-wrap;
                    }

                    Text {
                        text: @tr("Catalog");
                        font-size: 12px;
                        color: #c9c9d4;
                    }

                    Dropdown {
                        width: 100%;
                        model: root.home_catalog_candidate_names;
                        current-index <=> root.home_catalog_candidate_index;
                        placeholder-text: @tr("Select catalog");
                        enabled: root.home_catalog_candidate_names.length > 0;
                        roomy: root.narrow;
                        selected(_) => {
                            root.home_catalog_add_error = "";
                            root.home_catalog_candidate_picked(root.home_catalog_candidate_index);
                        }
                    }

                    Text {
                        text: @tr("Genre");
                        font-size: 12px;
                        color: #c9c9d4;
                    }

                    Dropdown {
                        width: 100%;
                        model: root.home_catalog_genre_names;
                        current-index <=> root.home_catalog_genre_index;
                        placeholder-text: @tr("All genres");
                        enabled: root.home_catalog_candidate_names.length > 0;
                        roomy: root.narrow;
                        selected(_) => { root.home_catalog_add_error = ""; }
                    }

                    if root.home_catalog_candidate_names.length == 0: Text {
                        width: 100%;
                        text: @tr("No enabled addon catalogs are available. Enable an addon with catalogs first.");
                        font-size: 12px;
                        color: #e3b5b5;
                        wrap: word-wrap;
                    }

                    if root.home_catalog_add_error != "": Text {
                        width: 100%;
                        text: root.home_catalog_add_error;
                        font-size: 12px;
                        color: #e3b5b5;
                        wrap: word-wrap;
                    }

                    Rectangle { vertical-stretch: 1; }

                    HorizontalLayout {
                        width: 100%;
                        spacing: 10px;
                        alignment: end;

                        PillButton {
                            label: @tr("Cancel");
                            roomy: root.narrow;
                            clicked => { root.home_catalog_add_open = false; }
                        }

                        if root.home_catalog_candidate_names.length > 0: home_catalog_modal_add := PillButton {
                            label: @tr("Add");
                            primary: true;
                            roomy: root.narrow;
                            clicked => {
                                root.home_catalog_added(
                                    root.home_catalog_candidate_index,
                                    root.home_catalog_genre_index
                                );
                            }
                        }
                    }
                }
            }
        }
    }
}
