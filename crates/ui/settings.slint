import { SettingsSectionHost } from "settings-section-host.slint";
import { SettingsContent, SettingsSync, Theme, PluginSettingRow, TrackingAccountRow, AddonRow, CategoryRow, HomeCatalogRow, SyncPeer, SyncInvite, DownloadRow, NavMetrics, NavState, Anim, SliderGesture, SettingsStyle, SettingsDestinations } from "@NovaUiShared";
import { SettingSyncModal } from "settings-sync-modal.slint";

import { ScrollView } from "scrollview.slint";
import { Dropdown } from "dropdown.slint";
import { IcSettingsGear, IcExtension, IcDownload, IcChevronRight, IcChevronDown, IcCheck, IcClose, IcChevronLeft, IcTag, IcSync } from "icons.slint";
import { SearchField } from "searchfield.slint";

import { SideNav } from "sidenav.slint";

import { PillButton, ToggleSwitch, SettingsRow, SettingsLink, SettingsCard, SettingsHeader, SettingsBackButton } from "settings-controls.slint";

export component SettingsPage {
    // Keep submenu layout inputs current without relaying backend values.
    private property <length> content_shell_width: root.width;
    changed content_shell_width => { SettingsContent.shell_width = root.content_shell_width; }
    changed detail_width => { SettingsContent.detail_width = root.detail_width; }
    public function prepare_submenu() {
        SettingsContent.shell_width = root.width;
        SettingsContent.detail_width = root.detail_width;
    }
    public function focus_shell() { nav_scope.focus(); }

    in property <bool> external_navigation: false;
    in property <bool> active: true;
    in property <[TrackingAccountRow]> tracking_accounts;
    in property <string> tracking_notice;
    callback tracking_connect(int,string,string);
    callback tracking_complete(int,string);
    callback tracking_disconnect(int);
    callback tracking_cancel(int);
    callback tracking_reset();
    callback tracking_automatic(int,bool);

    // Custom components placed in a Window are sized by their preferred size;
    // make this page fill the window (its parent).
    preferred-width: 100%;
    preferred-height: 100%;

    in-out property <[AddonRow]> addon_rows: [];
    in-out property <string> addon_search_text: "";
    in-out property <int> addon_capability_filter: 0;
    callback addon_filter_changed();
    in property <bool> cinemeta_installed: false;
    in-out property <string> addon_url: "";
    in-out property <bool> addon_zip_import_busy: false;
    in-out property <string> addon_zip_import_status: "";
    in-out property <[CategoryRow]> category_rows: [];
    in-out property <[HomeCatalogRow]> home_catalog_rows: [];
    in-out property <[HomeCatalogRow]> home_row_catalog_rows: [];
    in-out property <bool> home_continue_enabled: true;
    in-out property <bool> home_upcoming_enabled: true;
    in-out property <bool> home_episode_artwork: false;
    in-out property <bool> home_devices_enabled: true;
    in-out property <bool> remote_control_enabled: true;
    in-out property <[string]> home_catalog_candidate_names: [];
    in-out property <int> home_catalog_candidate_index: -1;
    in-out property <[string]> home_catalog_genre_names: [];
    in-out property <int> home_catalog_genre_index: 0;
    in-out property <bool> home_catalog_add_open: false;
    in-out property <int> home_catalog_add_target: 0;
    in property <int> system_back_request: 0;
    property <int> last_system_back_request: -1;
    property <bool> input_focused <=> SettingsContent.input_focused;
    property <bool> tracking_input_focused <=> SettingsContent.tracking_input_focused;
    property <bool> tracking_blur <=> SettingsContent.tracking_blur;
    property <bool> tracking_reset_confirm <=> SettingsContent.tracking_reset_confirm;
    in-out property <string> home_catalog_add_error: "";
    in-out property <string> category_input: "";
    in-out property <bool> cache_images: true;
    in-out property <string> cache_disk_usage: "";
    in-out property <bool> cache_enabled: false;
    in-out property <int> cache_format_index: 0;
    in-out property <float> cache_quality: 85.0;
    in-out property <int> detail_poster_resolution_index: 3;
    in-out property <int> detail_backdrop_resolution_index: 5;
    in-out property <int> episode_thumbnail_resolution_index: 2;
    in-out property <int> player_episode_backdrop_resolution_index: 0;
    in-out property <bool> cache_date_relative: true;
    in-out property <bool> cache_show_unwatched_thumbs: true;
    in-out property <float> cache_lru_mb: 128.0;
    in-out property <int> cache_disk_limit_index: 3;
    in-out property <[string]> cache_disk_limit_names: [@tr("Unlimited"), "256 MiB", "512 MiB", "1 GiB", "2 GiB", "4 GiB", "8 GiB"];
    in-out property <bool> cache_prefetch_metadata: false;
    in-out property <bool> discover_catalog_addon_names: true;
    in-out property <[string]> image_resolution_names: [@tr("Original"), "240 px", "360 px", "480 px", "720 px", "960 px", "1024 px", "1280 px", "1920 px", "2560 px"];
    // Minimum grid columns (Settings → Display below); autosaved.
    in-out property <int> discover_min_cols: 2;
    in-out property <int> library_min_cols: 2;
    // Language of the interface (Settings → Display). Index into the
    // backend's language list (`nova_config::Language::ALL`), pushed in
    // `language_names`; autosaved, and applied to the bundled Slint catalogs
    // by the backend once it lands.
    in-out property <int> language_index: 0;
    // Names are shown in their own language and are never translated, so this
    // list is the same in every language (the backend pushes it from
    // `nova_config::Language::ALL`; this default keeps the page previewable).
    in-out property <[string]> language_names: ["English", "Hrvatski"];
    in-out property <[string]> cache_format_names: ["JPEG", "WebP"];
    // Player section: player backend (0 = built-in mpv, 1 = external) on
    // every platform, plus the desktop external-app picker (0 = system
    // default, 1 = VLC, 2 = mpv) and the Android video decoder (0 = HW+,
    // 1 = HW, 2 = SW). The decoder row stays Android-only.
    in property <bool> is_android: false;
    in-out property <int> android_hwdec_index: 0;
    in-out property <int> player_backend_index: 0;
    in-out property <int> desktop_external_app_index: 0;
    // Built-in playback language defaults. The backend supplies search
    // results and the current selected labels; codes remain semantic values.
    in-out property <string> default_audio_language: "";
    in-out property <string> default_subtitle_language: "";
    in property <string> audio_language_label: "";
    in property <string> subtitle_language_label: "";
    in property <[string]> audio_language_codes: [];
    in property <[string]> audio_language_names: [];
    in property <[string]> subtitle_language_codes: [];
    in property <[string]> subtitle_language_names: [];
    in property <[string]> audio_language_selected_codes: [];
    in property <[string]> audio_language_selected_names: [];
    in property <[string]> subtitle_language_selected_codes: [];
    in property <[string]> subtitle_language_selected_names: [];
    in-out property <int> audio_language_choice_index: -1;
    in-out property <int> subtitle_language_choice_index: -1;
    // Global default playback rate (Settings → Player). The player's OSD
    // title override is separate; ± steps ask the backend for a quantized
    // change to this default.
    in-out property <float> playback_speed: 1.0;
    in-out property <bool> android_auto_continue: false;
    in-out property <bool> prefetch_next_episode_streams: true;
    in-out property <int> screenshot_format_index: 0;
    in-out property <float> screenshot_jpeg_quality: 85;
    in-out property <float> screenshot_webp_quality: 85;
    in-out property <bool> screenshot_show_folder: false;
    in-out property <int> episode_start_index: 1;
    // Look and feel (Settings → Look and feel): master + per-category switches.
    in-out property <bool> true_black: false;
    in-out property <int> accent_color: 0;
    in-out property <float> card_corner_radius: 10;
    property <int> radius_preset_index: root.card_corner_radius == 0 ? 0 : root.card_corner_radius == 4 ? 1 : root.card_corner_radius == 10 ? 2 : root.card_corner_radius == 16 ? 3 : root.card_corner_radius == 24 ? 4 : -1;
    in-out property <float> button_corner_radius: 8;
    property <int> button_radius_preset_index: root.button_corner_radius == 0 ? 0 : root.button_corner_radius == 4 ? 1 : root.button_corner_radius == 8 ? 2 : root.button_corner_radius == 12 ? 3 : root.button_corner_radius == 24 ? 4 : -1;
    in-out property <float> card_spacing: 8;
    property <int> spacing_preset_index: root.card_spacing == 0 ? 0 : root.card_spacing == 4 ? 1 : root.card_spacing == 8 ? 2 : root.card_spacing == 16 ? 3 : root.card_spacing == 32 ? 4 : -1;
    in-out property <float> status_bar_gradient: 80;
    in-out property <int> home_backdrop_size: 1;
    in-out property <int> detail_backdrop_size: 1;
    in-out property <int> hero_title_alignment: 1;
    in-out property <bool> animations: true;
    in-out property <bool> anim_transitions: true;
    in-out property <bool> anim_hover: true;
    in-out property <bool> anim_player: true;
    in-out property <bool> anim_nav_slide: true;
    // Hide the desktop-only image-cache re-encode card on the web build.
    in-out property <bool> show_image_cache: true;
    // Torrent streaming (Settings → Torrents). Hidden entirely on the web
    // build, which has no embedded BitTorrent client.
    in-out property <bool> show_torrents: true;
    in-out property <bool> torrent_enabled: true;
    in-out property <string> torrent_dir: "";
    in-out property <float> torrent_max_mb: 20480.0;
    in-out property <float> torrent_down_limit: 0.0;
    in-out property <bool> torrent_no_cache: false;
    in-out property <string> torrent_disk_usage: "";
    in-out property <bool> download_auto_delete_watched: false;
    // Settings → Downloads → Downloaded episodes: completed episode files.
    in-out property <[DownloadRow]> downloads_rows: [];
    // Cross-device sync (Settings → Sync). Opt-in; off by default.
    in-out property <bool> sync_enabled: false;
    // This device's endpoint id (share it so a peer can add this device).
    in-out property <string> sync_identity: "";
    in-out property <[SyncPeer]> sync_peers: [];
    in-out property <string> sync_peer_input: "";
    // Human-readable engine state ("Idle", "Syncing…", an error, …).
    in-out property <string> sync_status: "";
    // Pairing (Settings → Sync): name, confirmation toggle, invites, join.
    in-out property <string> sync_device_name: "";
    in-out property <bool> sync_pair_confirm: false;
    // Local network discovery (UPnP probing, LAN discovery). Off for
    // faulty Wi-Fi that chokes on multicast traffic.
    in-out property <bool> sync_local_discovery: true;
    // Auto-sync interval preset index (0 = 30 s, 1 = 1 min, 2 = 5 min,
    // 3 = 15 min); mapped to seconds in Rust. Governs the app-running loop
    // only; closed-app cadence is the fixed Android background job.
    in-out property <int> sync_interval_index: 1;
    // Periodic best-effort sync while the app is closed (Android job).
    in-out property <bool> sync_background: true;
    in-out property <string> sync_invite_ticket: "";
    in-out property <image> sync_invite_qr;
    in-out property <[SyncInvite]> sync_invites: [];
    in-out property <string> sync_join_input: "";
    in-out property <string> sync_link_notice: "";
    // True on Android, where the camera QR scanner is available.
    in-out property <bool> sync_qr_scan_available: false;
    in-out property <bool> sync_pair_prompt_visible: false;
    in-out property <string> sync_pair_prompt_id: "";
    in-out property <string> sync_pair_prompt_name: "";
    in-out property <string> sync_pair_prompt_code: "";
    // Peer-removal confirmation (UI-local; removal tombstones mesh-wide).
    property <bool> sync_remove_prompt_visible <=> SettingsContent.sync_remove_prompt_visible;
    property <string> sync_remove_prompt_id <=> SettingsContent.sync_remove_prompt_id;
    property <string> sync_remove_prompt_name <=> SettingsContent.sync_remove_prompt_name;
    // Formatted readouts for the torrent sliders (Slint has no int→string).
    property <string> torrent_size_label: Math.round(root.torrent_max_mb) + " MB";
    property <string> torrent_rate_label: root.torrent_down_limit <= 0 ? @tr("Unlimited") : Math.round(root.torrent_down_limit) + " KB/s";

    callback discover_picked();
    callback home_picked();
    callback back_picked();
    callback library_picked();
    callback settings_picked();
    callback about_picked();
    callback more_picked();
    callback addon_added(string);
    callback addon_zip_import_requested();
    callback addon_toggled(int);
    callback addon_remove(int);
    callback addon_move_up(int);
    callback addon_move_down(int);
    property <bool> plugin_clear_confirm: false;
    in-out property <[PluginSettingRow]> plugin_setting_rows;
    in-out property <string> plugin_settings_notice;
    callback plugin_setting_changed(string,string,string);
    callback plugin_settings_clear(string);
    callback plugin_cache_clear(string);
    in-out property <bool> addon_config_open: false;
    private property <string> addon_preference_editor: "";
    private property <string> addon_collection_editor: "";
    private property <int> addon_text_editor: -1;
    in-out property <string> addon_config_url;
    in-out property <string> addon_config_label;
    in-out property <bool> addon_config_capabilities: true;
    in-out property <bool> addon_config_streams: true;
    in-out property <bool> addon_config_metadata: true;
    callback addon_capabilities_changed(string, bool, bool);
    callback addon_configure(string);
    callback addon_refresh(int);
    // Copy the install URL of the addon at this row (the row shows only its
    // name — the URL lives behind this action).
    callback addon_copy_link(string);
    callback category_added(string);
    callback category_removed(int);
    callback home_catalog_add_requested();
    callback home_row_catalog_add_requested();
    callback home_catalog_candidate_picked(int);
    callback home_catalog_added(int, int);
    callback home_catalog_removed(int);
    callback home_row_catalog_removed(int);
    callback home_row_catalog_action(int, int);
    // Playback rate ± one 0.05 step (Settings → Player). The backend
    // quantizes it and writes the property back.
    callback playback_speed_stepped(int);
    callback playback_language_search(string, bool);
    callback playback_language_picked(string, bool);
    callback playback_language_edited(string, int, bool);
    // Capture edits immediately; the application owns persistence debouncing.
    callback save_settings();
    in property <bool> persistence_failed: false;
    callback settings_edited(string);
    callback clear_cache();
    // Immediate one-shot: persist current config, then re-encode the
    // existing on-disk cache to it.
    callback reencode_cache();
    // Torrent settings (Settings → Torrents), autosaved like the rest.
    callback torrents_changed();
    callback torrent_dir_edited(string);
    callback clear_torrent_cache();
    callback download_auto_delete_watched_changed(bool);
    // Remove one completed downloaded episode (file + manifest entry).
    callback download_list_remove(string);
    // Cross-device sync (Settings → Sync).
    callback sync_changed();
    callback sync_add_peer(string);
    callback sync_remove_peer(string);
    callback sync_now();
    callback sync_copy_identity();
    callback sync_device_name_edited(string);
    callback sync_pair_confirm_changed(bool);
    callback sync_local_discovery_changed(bool);
    callback sync_interval_picked(int);
    callback sync_background_changed(bool);
    callback sync_create_invite();
    callback sync_cancel_invite(string);
    callback sync_copy_ticket(string);
    callback sync_join_invite(string);
    callback sync_scan_qr();
    callback sync_respond_pair(string, bool);

    public function schedule_save() {
        if (root.kb_zone == 5 && root.kb_hr < 9) {
            root.settings_edited(["cache_images", "enabled", "format", "quality", "detail_poster_max_side", "detail_backdrop_max_side", "episode_thumbnail_max_side", "player_episode_backdrop_max_side", "lru_cache_mb"][root.kb_hr]);
        } else if (root.kb_zone == 6) {
            root.settings_edited(["date_relative", "prefetch_metadata", "show_unwatched_thumbs", "discover_min_cols", "library_min_cols", "language", "discover_catalog_addon_names"][root.kb_dr]);
        } else if (root.kb_zone == 10) {
            root.settings_edited(["animations", "anim_transitions", "anim_hover", "anim_player", "anim_nav_slide"][root.kb_anr]);
        } else {
            root.save_settings();
        }
    }
    public function schedule_setting(field: string) { root.settings_edited(field); }

    public function pick_card_radius(index: int) {
        root.card_corner_radius = [0, 4, 10, 16, 24][index];
        root.kb_active = SettingsStyle.keyboard-mode;
        root.kb_zone = 17;
        root.kb_theme = 2;
        root.schedule_setting("card_corner_radius");
    }

    public function pick_button_radius(index: int) {
        root.button_corner_radius = [0, 4, 8, 12, 24][index];
        root.kb_active = SettingsStyle.keyboard-mode;
        root.kb_zone = 17;
        root.kb_theme = 3;
        root.schedule_setting("button_corner_radius");
    }

    public function pick_card_spacing(index: int) {
        root.card_spacing = [0, 4, 8, 16, 32][index];
        root.kb_active = SettingsStyle.keyboard-mode;
        root.kb_zone = 17;
        root.kb_theme = 4;
        root.schedule_setting("card_spacing");
    }

    public function restore_theme_defaults() {
        // Apply all controls before autosaving so each sync choice sees the
        // complete reset, including when a field has a device-local override.
        root.true_black = false;
        root.accent_color = 0;
        root.card_corner_radius = 10;
        root.button_corner_radius = 8;
        root.card_spacing = 8;
        root.status_bar_gradient = 80;
        root.home_backdrop_size = 1;
        root.detail_backdrop_size = 1;
        root.hero_title_alignment = 1;
        root.schedule_setting("true_black");
        root.schedule_setting("card_corner_radius");
        root.schedule_setting("button_corner_radius");
        root.schedule_setting("card_spacing");
        root.schedule_setting("status_bar_gradient");
        root.schedule_setting("home_backdrop_size");
        root.schedule_setting("detail_backdrop_size");
        root.schedule_setting("hero_title_alignment");
        root.schedule_setting("accent_color");
    }
    function kb_theme_step(direction: int) {
        if (root.kb_theme == 1) {
            root.true_black = !root.true_black;
            root.schedule_setting("true_black");
        } else if (root.kb_theme == 2) {
            // Step to the adjacent preset, including from older custom values.
            root.card_corner_radius = direction < 0
                ? (root.card_corner_radius > 16 ? 16 : root.card_corner_radius > 10 ? 10 : root.card_corner_radius > 4 ? 4 : 0)
                : (root.card_corner_radius < 4 ? 4 : root.card_corner_radius < 10 ? 10 : root.card_corner_radius < 16 ? 16 : 24);
            root.schedule_setting("card_corner_radius");
        } else if (root.kb_theme == 3) {
            root.button_corner_radius = direction < 0
                ? (root.button_corner_radius > 12 ? 12 : root.button_corner_radius > 8 ? 8 : root.button_corner_radius > 4 ? 4 : 0)
                : (root.button_corner_radius < 4 ? 4 : root.button_corner_radius < 8 ? 8 : root.button_corner_radius < 12 ? 12 : 24);
            root.schedule_setting("button_corner_radius");
        } else if (root.kb_theme == 4) {
            root.card_spacing = direction < 0
                ? (root.card_spacing > 16 ? 16 : root.card_spacing > 8 ? 8 : root.card_spacing > 4 ? 4 : 0)
                : (root.card_spacing < 4 ? 4 : root.card_spacing < 8 ? 8 : root.card_spacing < 16 ? 16 : 32);
            root.schedule_setting("card_spacing");
        } else if (root.kb_theme == 5) {
            root.status_bar_gradient = Math.max(0, Math.min(100, root.status_bar_gradient + direction));
            root.schedule_setting("status_bar_gradient");
        } else if (root.kb_theme == 6) {
            root.home_backdrop_size = Math.max(0, Math.min(2, root.home_backdrop_size + direction));
            root.schedule_setting("home_backdrop_size");
        } else if (root.kb_theme == 7) {
            root.detail_backdrop_size = Math.max(0, Math.min(2, root.detail_backdrop_size + direction));
            root.schedule_setting("detail_backdrop_size");
        } else if (root.kb_theme == 8) {
            root.hero_title_alignment = Math.max(0, Math.min(2, root.hero_title_alignment + direction));
            root.schedule_setting("hero_title_alignment");
        } else if (root.kb_theme == 0) {
            root.accent_color = Math.max(0, Math.min(7, root.accent_color + direction));
            root.schedule_setting("accent_color");
        }
    }

    // Nested "Downloaded episodes" list (Settings → Downloads) entrance. A
    // subpage swap inside the already-open subpage layer would otherwise pop
    // in with no transition, so the list slides/fades in on open (same
    // language as the page-level subpage slide). Deferred one tick so the
    // first value is the animated-from value, not the baseline.
    property <bool> dl_revealed <=> SettingsContent.dl_revealed;
    dl_reveal_t := Timer {
        interval: 40ms;
        running: false;
        triggered => {
            dl_reveal_t.running = false;
            root.dl_revealed = true;
        }
    }

    // `sub_open` drives the slide. Keep the selected body mounted while the
    // narrow detail pane slides out and remains hidden behind the overview.
    // One-shot: after a subpage is built, restore its Flickable scroll offset
    // (the field is fresh but the viewport may carry the previous offset).
    reset_timer := Timer {
        interval: 1ms;
        running: root.reset_pending;
        triggered => {
            set_scroll.content-y = root.page_scrolls[root.sel];
            // Also clear any horizontal offset: if content ever overflows,
            // Flickable's drag-pan can leave the page shifted right, and that
            // offset would otherwise persist across subpage opens.
            set_scroll.content-x = 0px;
            root.reset_pending = false;
        }
    }

    // Compact layout for narrow (portrait) windows.
    in property <bool> phone_layout;
    property <bool> narrow: root.detail_width < 680px;
    in property <bool> two_pane;
    property <length> usable_width: (root.external_navigation ? root.width : root.nav-viewport-width) - root.rail_w - root.safe-left - root.safe-right - 36px;
    property <length> combined_width: Math.max(0px, root.usable_width);
    property <length> detail_width: root.two_pane ? root.combined_width - 364px : root.combined_width;
    changed phone_layout => { root.kb_nav = Math.min(root.kb_nav, 5); if (root.phone_layout && root.kb_zone == 0) { root.kb_zone = root.sub_open ? root.page_first_zone() : 8; } }
    changed two_pane => {
        SliderGesture.active = false; SliderGesture.hovered = false;
        if (root.two_pane) { root.sub_open = true; }
    }
    changed sel => { SliderGesture.active = false; SliderGesture.hovered = false; SettingsContent.detail_pinned_controls_height = 0px; }
    changed sub_open => { SliderGesture.active = false; SliderGesture.hovered = false; }
    property <int> focus_request: SettingsStyle.focus-request;
    property <bool> native_keyboard_mode: SettingsStyle.keyboard-mode;
    changed native_keyboard_mode => { root.kb_active = self.native_keyboard_mode; }
    changed focus_request => {
        if (SettingsStyle.keyboard-mode) {
            if (SettingsStyle.navigation-focus) {
                let top = SettingsStyle.focus-y - land_scroll.absolute-position.y;
                if (top < 0px) { land_scroll.content-y -= top; }
                else if (top + SettingsStyle.focus-height > land_scroll.visible-height) { land_scroll.content-y -= top + SettingsStyle.focus-height - land_scroll.visible-height; }
            } else {
                root.reveal_detail_control(SettingsStyle.focus-y, SettingsStyle.focus-height);
            }
        }
    }
    changed kb_active => { SettingsStyle.keyboard-mode = root.kb_active; }
    changed narrow => {
        SliderGesture.active = false; SliderGesture.hovered = false;
        // These editors swap instances between stacked and wide layouts.
        // Keep a surviving focus target when a touch-focused input is removed;
        // keyboard edit timers can still focus the replacement field.
        if (root.sel == 0 || root.sel == 1 || root.sel == 4) {
            root.input_focused = false;
            nav_scope.focus();
        }
    }
    // Mirrors the content scroll offset (bound by AppWindow; same pattern
    // as the Discover/Library grids).
    in-out property <length> scroll_y: 0px;
    changed scroll_y => { if (Math.abs(set_scroll.content-y - root.scroll_y) > 0.5px) { set_scroll.content-y = root.scroll_y; } }
    // Top system-bar inset (Android status bar): Window.safe-area-insets,
    // bound by AppWindow. 0 on desktop/web, so layout there is unchanged.
    in property <length> safe-top: 0px;
    // Side insets: in landscape the display cutout / gesture area moves to
    // the left or right edge, so page content must clear it.
    in property <length> safe-left: 0px;
    in property <length> safe-right: 0px;
    // Bottom system-bar inset (Android gesture/nav bar), for the bottom
    // tab bar. 0 on desktop/web.
    in property <length> safe-bottom: 0px;
    // Left inset reserved by the wide-layout navigation rail (0 on narrow).
    // Window width is supplied separately so responsive padding does not
    // feed back into the page’s own intrinsic layout width.
    in property <length> nav-viewport-width;
    property <length> rail_w: root.phone_layout || root.external_navigation ? 0px : NavMetrics.width-for(root.nav-viewport-width);
    // Keyboard modality (bound to AppWindow, see DiscoverPage).
    in-out property <bool> kb_active;

    // ---- 6-button keyboard nav (arrows + Enter + Backspace) ----
    // The page is now split into a landing menu + one subpage per section.
    // Zones: 0 wide page-nav / narrow header Back, 8 landing menu (selection), then per subpage:
    // 1 addon install [field, add], 2 addon rows, 3 category install
    // [field, add], 4 category rows, 5 image-cache rows, 6 display rows,
    // 7 torrent rows, 9 player rows, 10 look-and-feel rows, 11 sync rows,
    // 12 downloads rows, 13 downloaded-episode rows,
    // 16 Home catalog rows, 17 Theme rows.
    // Left/Right moves between rows/zones; Enter activates; Backspace returns to the
    // landing (or Home at the landing). Text fields use edit mode (0 none, 1
    // addon url, 2 category, 3 torrent dir): Enter focuses the field, Enter
    // again submits and exits.
    in-out property <int> kb_zone: 0;
    in-out property <int> kb_nav: 3;
    property <int> kb_actl <=> SettingsContent.kb_actl;
    property <int> kb_ar <=> SettingsContent.kb_ar;
    property <int> kb_ac <=> SettingsContent.kb_ac; // 0 toggle, 1 configure, 2 copy link, 3 refresh, 4 remove, 5 up, 6 down
    property <int> kb_cctl <=> SettingsContent.kb_cctl;
    property <int> kb_cr <=> SettingsContent.kb_cr;
    property <int> kb_ccol <=> SettingsContent.kb_ccol; // one Remove action
    property <int> kb_hr <=> SettingsContent.kb_hr; // cache rows 0..7 (only 0 when disk cache or re-encode is off)
    property <int> kb_dr <=> SettingsContent.kb_dr;
    property <int> kb_tr <=> SettingsContent.kb_tr; // torrent rows 0..5 (only 0 when streaming is off)
    property <int> kb_pr <=> SettingsContent.kb_pr; // player rows (see kb_player_n)
    property <bool> player_language_input_focused <=> SettingsContent.player_language_input_focused;
    property <int> kb_anr <=> SettingsContent.kb_anr; // look-and-feel rows 0..4
    property <int> kb_theme <=> SettingsContent.kb_theme; // accent, true black, card/button radius, spacing, status fade, Home/Detail size, title alignment, reset
    property <int> kb_dl <=> SettingsContent.kb_dl; // downloads rows 0 delete-after-watched, 1 episodes
    property <int> kb_dlr <=> SettingsContent.kb_dlr; // downloaded-episodes list row
    property <int> kb_edit <=> SettingsContent.kb_edit;
    // Landing selection (section ids: 0–8 for Addons through Downloads, 13
    // Home, 14 Theme; id 9 is the nested downloaded-episodes page).
    in-out property <int> kb_land: 13;
    property <int> kb_home <=> SettingsContent.kb_home;

    // ---- Landing / subpage navigation state ----
    // `sel` = section id whose content is built (-1 = landing). `sub_open`
    // is the transition target; it flips a frame before `sel` is cleared on
    // close so both pages animate.
    in-out property <int> sel: 13;
    in-out property <bool> sub_open: false;
    property <bool> reset_pending: false;
    in-out property <string> search_query: "";
    property <bool> search_active: root.search_query != "" && !root.search_matches(root.search_query, "");
    property <int> reveal_request: 0;
    in-out property <[length]> page_scrolls: [0px,0px,0px,0px,0px,0px,0px,0px,0px,0px,0px,0px,0px,0px,0px];
    pure callback search_matches(string, string) -> bool;
    in property <bool> cache_busy: false;
    in property <bool> cache_rewriting: false;
    in property <int> cache_processed: 0;
    in property <int> cache_total: 0;
    in property <string> cache_status: "";
    callback cancel_reencode();
    // Landing scroll offset (the subpage uses the external `scroll_y`).
    in-out property <length> land_scroll_y: 0px;
    // Collapse the landing hero visually while keeping its layout slots
    // fixed. Resizing the hero from the Flickable offset also resizes its
    // viewport, which feeds back into touch scrolling and causes jitter.
    property <length> landing_header_shift: Math.max(-108px, Math.min(0px, root.land_scroll_y));
    property <float> landing_compact_progress: Math.clamp((-root.land_scroll_y - 68px) / 40px, 0, 1);
    property <length> landing_pinned_offset: root.landing_compact_progress
        * Math.max(0px, root.absolute-position.y + root.safe-top + 68px - content_host.absolute-position.y);

    // Which sections are offered on the landing menu, in order.
    // The Player section is always offered: the backend picker (built-in
    // vs external) exists on every platform; only the decoder row inside
    // stays Android-only.
    function land_platform_avail(id: int) -> bool {
        if (id == 2) { return root.show_image_cache; }
        if (id == 4) { return root.show_torrents; }
        if (id == 5) { return true; }
        if (id == 7) { return true; }
        if (id == 8 || id == 9 || id == 12 || id == 13 || id == 14) { return true; }
        return (id >= 0 && id <= 3) || id == 6;
    }

    function destination_index(id: int) -> int {
        if (id == 13) { return 0; }
        if (id == 3) { return 1; }
        if (id == 14) { return 2; }
        if (id == 6) { return 3; }
        if (id == 5) { return 4; }
        if (id == 0) { return 5; }
        if (id == 1) { return 6; }
        if (id == 7) { return 7; }
        if (id == 12) { return 8; }
        if (id == 2) { return 9; }
        if (id == 8) { return 10; }
        if (id == 9) { return 11; }
        if (id == 4) { return 12; }
        return 0;
    }
    function land_title(id: int) -> string { return SettingsDestinations.entries[root.destination_index(id)].title; }
    function land_desc(id: int) -> string { return SettingsDestinations.entries[root.destination_index(id)].description; }
    function land_avail(id: int) -> bool {
        let entry = SettingsDestinations.entries[root.destination_index(id)];
        return root.land_platform_avail(id) && (!root.search_active ? entry.parent < 0 : root.search_matches(root.search_query, entry.title + " " + entry.description + " " + entry.terms + " " + entry.aliases));
    }
    function group_available(group: int) -> bool {
        if (group == 0) { return root.land_avail(13) || root.land_avail(3) || root.land_avail(14) || root.land_avail(6) || root.land_avail(5); }
        if (group == 1) { return root.land_avail(0) || root.land_avail(1) || root.land_avail(7) || root.land_avail(12); }
        if (group == 2) { return root.land_avail(2) || root.land_avail(8) || root.land_avail(9) || root.land_avail(4); }
        return false;
    }
    function land_first() -> int {
        if (root.land_avail(13)) { return 13; }
        if (root.land_avail(3)) { return 3; }
        if (root.land_avail(14)) { return 14; }
        if (root.land_avail(6)) { return 6; }
        if (root.land_avail(5)) { return 5; }
        if (root.land_avail(0)) { return 0; }
        if (root.land_avail(1)) { return 1; }
        if (root.land_avail(7)) { return 7; }
        if (root.land_avail(12)) { return 12; }
        if (root.land_avail(2)) { return 2; }
        if (root.land_avail(8)) { return 8; }
        if (root.land_avail(9)) { return 9; }
        if (root.land_avail(4)) { return 4; }
        return 13;
    }
    function land_next(id: int) -> int {
        if (root.destination_index(id) < root.destination_index(13) && root.land_avail(13)) { return 13; }
        if (root.destination_index(id) < root.destination_index(3) && root.land_avail(3)) { return 3; }
        if (root.destination_index(id) < root.destination_index(14) && root.land_avail(14)) { return 14; }
        if (root.destination_index(id) < root.destination_index(6) && root.land_avail(6)) { return 6; }
        if (root.destination_index(id) < root.destination_index(5) && root.land_avail(5)) { return 5; }
        if (root.destination_index(id) < root.destination_index(0) && root.land_avail(0)) { return 0; }
        if (root.destination_index(id) < root.destination_index(1) && root.land_avail(1)) { return 1; }
        if (root.destination_index(id) < root.destination_index(7) && root.land_avail(7)) { return 7; }
        if (root.destination_index(id) < root.destination_index(12) && root.land_avail(12)) { return 12; }
        if (root.destination_index(id) < root.destination_index(2) && root.land_avail(2)) { return 2; }
        if (root.destination_index(id) < root.destination_index(8) && root.land_avail(8)) { return 8; }
        if (root.destination_index(id) < root.destination_index(9) && root.land_avail(9)) { return 9; }
        if (root.destination_index(id) < root.destination_index(4) && root.land_avail(4)) { return 4; }
        return id;
    }
    function land_prev(id: int) -> int {
        if (root.destination_index(id) > root.destination_index(4) && root.land_avail(4)) { return 4; }
        if (root.destination_index(id) > root.destination_index(9) && root.land_avail(9)) { return 9; }
        if (root.destination_index(id) > root.destination_index(8) && root.land_avail(8)) { return 8; }
        if (root.destination_index(id) > root.destination_index(2) && root.land_avail(2)) { return 2; }
        if (root.destination_index(id) > root.destination_index(12) && root.land_avail(12)) { return 12; }
        if (root.destination_index(id) > root.destination_index(7) && root.land_avail(7)) { return 7; }
        if (root.destination_index(id) > root.destination_index(1) && root.land_avail(1)) { return 1; }
        if (root.destination_index(id) > root.destination_index(0) && root.land_avail(0)) { return 0; }
        if (root.destination_index(id) > root.destination_index(5) && root.land_avail(5)) { return 5; }
        if (root.destination_index(id) > root.destination_index(6) && root.land_avail(6)) { return 6; }
        if (root.destination_index(id) > root.destination_index(14) && root.land_avail(14)) { return 14; }
        if (root.destination_index(id) > root.destination_index(3) && root.land_avail(3)) { return 3; }
        if (root.destination_index(id) > root.destination_index(13) && root.land_avail(13)) { return 13; }
        return id;
    }
    changed search_query => { root.kb_land = root.land_first(); land_scroll.content-y = 0px; }

    // First keyboard zone of the currently open subpage.
    function page_first_zone() -> int {
        if (root.sel == 0) { return 1; }
        if (root.sel == 1) { return 3; }
        if (root.sel == 2) { return 5; }
        if (root.sel == 3) { return 6; }
        if (root.sel == 4) { return 7; }
        if (root.sel == 5) { return 9; }
        if (root.sel == 6) { return 10; }
        if (root.sel == 7) { return 11; }
        if (root.sel == 8) { return 12; }
        if (root.sel == 13) { return 16; }
        if (root.sel == 14) { return 17; }
        if (root.sel == 9) { return 13; }
        return 0;
    }

    public function open_page(id: int) {
        if (root.sel >= 0) { root.page_scrolls[root.sel] = root.scroll_y; }
        // The nested downloaded-episodes list gets an entrance transition:
        // arm the from-state before `sel` builds the block, then reveal on the
        // next tick. Skipped when transitions are off (snaps straight in).
        if (id == 9 && Anim.transitions) {
            root.dl_revealed = false;
            dl_reveal_t.running = true;
        } else {
            root.dl_revealed = true;
        }
        // Set the transition target before replacing the selected content.
        root.sub_open = true;
        root.sel = id;
        root.reset_pending = true;
        root.kb_clamp_all();
        root.kb_zone = root.page_first_zone();
    }

    function close_page() {
        // The outgoing subpage can own a focused editor or tracking's blur
        // scope. Keep Back routed after the close animation removes it.
        nav_scope.focus();
        // Nested pages return to their parent rather than the landing menu.
        if (root.sel == 9) {
            root.open_page(8);
            return;
        }
        root.page_scrolls[root.sel] = root.scroll_y;
        root.sub_open = root.two_pane;
        root.kb_zone = 8;
        // Returning to the landing menu: drop any horizontal pan it may have
        // picked up so it is never left shifted to the right.
        land_scroll.content-x = 0px;
    }

    function close_addon_config() {
        root.plugin_clear_confirm = false;
        root.addon_preference_editor = "";
        root.addon_collection_editor = "";
        root.addon_text_editor = -1;
        root.addon_config_open = false;
        nav_scope.focus();
    }
    function save_addon_config() {
        root.addon_capabilities_changed(root.addon_config_url, root.addon_config_streams, root.addon_config_metadata);
    }
    function submenu_back() {
        // A pointer Back belongs to the visible submenu even when keyboard
        // focus last rested on the desktop overview alongside it.
        if root.two_pane && root.kb_zone == 8 { root.kb_zone = root.page_first_zone(); }
        root.system_back();
    }
    function system_back() {
        if root.addon_config_open {
            if root.plugin_clear_confirm { root.plugin_clear_confirm = false; }
            else if root.addon_text_editor >= 0 { root.addon_text_editor = -1; }
            else if root.addon_collection_editor != "" { root.addon_collection_editor = ""; }
            else if root.addon_preference_editor != "" { root.addon_preference_editor = ""; }
            else { root.close_addon_config(); }
            return;
        }
        if SettingsSync.open { SettingsSync.open = false; nav_scope.focus(); return; }
        if (root.home_catalog_add_open) {
            root.home_catalog_add_open = false;
        } else if (root.sync_remove_prompt_visible) {
            root.sync_remove_prompt_visible = false;
        } else if (root.sel == 12 && root.tracking_reset_confirm) {
            root.tracking_reset_confirm = false;
        } else if (root.sync_pair_prompt_visible) {
            root.sync_respond_pair(root.sync_pair_prompt_id, false);
        } else if (root.sel==12 && root.tracking_input_focused){
            root.tracking_blur=!root.tracking_blur;
        } else if (root.input_focused || root.player_language_input_focused || root.kb_edit != 0) {
            root.kb_edit = 0;
            root.input_focused = false;
            root.player_language_input_focused = false;
            if (root.is_android) {
                root.kb_active = false;
                SettingsStyle.keyboard-mode = false;
            }
            nav_scope.focus();
        } else if (root.two_pane && root.kb_zone == 8) {
            root.back_picked();
        } else if (root.sub_open) {
            root.close_page();
        } else {
            root.back_picked();
        }
    }

    changed system_back_request => {
        if (root.active && root.last_system_back_request >= 0
        && root.system_back_request != root.last_system_back_request) {
            root.last_system_back_request = root.system_back_request;
            root.system_back();
        }
    }

    function kb_has_addons() -> bool { return root.addon_rows.length > 0; }
    function kb_has_cats() -> bool { return root.category_rows.length > 0; }
    // Cache rows: 0 images, 1 enable, 2 format, 3 quality, 4-7 image sizes,
    // 8 memory, 9 re-encode button, 10 clear. Sizes and memory remain available when disk
    // caching or re-encoding is off. Rows 9/10 activate on Enter
    // (Left/Right no-op). Row 11 is the disk limit, visually after row 0.
    function kb_cache_n() -> int { return 12; }
    function kb_cache_available(r: int) -> bool {
        if (r == 8) { return true; }
        if (r == 11) { return root.cache_images && !root.cache_busy; }
        if (r == 9 && root.cache_rewriting) { return true; }
        if (root.cache_busy) { return false; }
        if (r == 0 || r == 10) { return true; }
        if (r == 9) { return root.cache_images; }
        if (r == 1) { return root.cache_images; }
        if (r >= 4 && r <= 7) { return true; }
        return root.cache_images && root.cache_enabled;
    }
    function kb_cache_previous(r: int) -> int {
        if (root.cache_busy) {
            if (r == 8) { return 0; }
            if (r == 9 || r == 10) { return 8; }
            return 0;
        }
        if (r == 11) { return 0; }
        if (r == 1 && root.cache_images) { return 11; }
        if (r == 10) { return root.cache_images ? 9 : 8; }
        if (r == 9) { return 8; }
        if (r == 8) { return 7; }
        if (r == 4) { return root.cache_images ? (root.cache_enabled ? 3 : 1) : 0; }
        if ((r == 2 || r == 3) && !root.cache_enabled) { return 1; }
        return Math.max(0, r - 1);
    }
    function kb_cache_next(r: int) -> int {
        if (root.cache_busy) {
            if (r == 0) { return 8; }
            if (r == 8) { return root.cache_images ? 9 : 10; }
            return 10;
        }
        if (r == 0) { return root.cache_images ? 11 : 4; }
        if (r == 11) { return root.cache_images ? 1 : 4; }
        if (r == 10) { return 10; }
        if (r == 1) { return root.cache_enabled ? 2 : 4; }
        if (r == 8) { return root.cache_images ? 9 : 10; }
        if (r == 9) { return 10; }
        return Math.min(root.kb_cache_n() - 1, r + 1);
    }

    // Torrent rows: 0 enable, 1 folder field, 2 size cap, 3 rate limit,
    // 4 no-cache, 5 clear. Only row 0 when streaming is off. Row 5 activates
    // on Enter (Left/Right no-op); row 1 opens text edit mode.
    function kb_torrent_n() -> int { return root.torrent_enabled ? 6 : 1; }

    // Four actions per Home catalog, followed by add, artwork, devices, and featured.
    function kb_home_n() -> int { return root.home_row_catalog_rows.length * 4 + root.home_catalog_rows.length + 4; }

    function kb_home_activate() {
        let rows_end = root.home_row_catalog_rows.length * 4;
        if (root.kb_home < rows_end) {
            let index = Math.floor(root.kb_home / 4);
            let action = Math.mod(root.kb_home, 4);
            if (action == 1 && index > 0) { root.kb_home -= 4; }
            if (action == 2 && index + 1 < root.home_row_catalog_rows.length) { root.kb_home += 4; }
            root.home_row_catalog_action(index, action);
        } else if (root.kb_home == rows_end) {
            root.home_row_catalog_add_requested();
        } else if (root.kb_home == rows_end + 1) {
            root.home_episode_artwork = !root.home_episode_artwork;
            root.schedule_setting("home_episode_artwork");
        } else if (root.kb_home == rows_end + 2) {
            root.home_devices_enabled = !root.home_devices_enabled;
            root.schedule_setting("home_devices_enabled");
        } else if (root.kb_home < rows_end + root.home_catalog_rows.length + 3) {
            root.home_catalog_removed(root.kb_home - rows_end - 3);
        } else {
            root.home_catalog_add_requested();
        }
    }

    function kb_ac_has_config() -> bool {
        if (root.kb_ar < 0 || root.kb_ar >= root.addon_rows.length) {
            return false;
        }
        return root.addon_rows[root.kb_ar].config_url != "";
    }

    function kb_clamp_all() {
        if (root.kb_ar >= root.addon_rows.length) {
            root.kb_ar = Math.max(0, root.addon_rows.length - 1);
        }
        if (root.kb_cr >= root.category_rows.length) {
            root.kb_cr = Math.max(0, root.category_rows.length - 1);
        }
        if (!root.animations && root.kb_anr > 0) { root.kb_anr = 0; }
        if (root.kb_hr >= root.kb_cache_n()) {
            root.kb_hr = root.kb_cache_n() - 1;
        }
        // Downloads subpage: 2 rows (delete-after-watched, episodes).
        if (root.kb_dl > 1) {
            root.kb_dl = 1;
        }
        if (root.kb_dlr >= root.downloads_rows.length) {
            root.kb_dlr = Math.max(0, root.downloads_rows.length - 1);
        }
        if (root.kb_home >= root.kb_home_n()) {
            root.kb_home = Math.max(0, root.kb_home_n() - 1);
        }
        root.kb_player_clamp();
    }

    public function reveal_detail_control(y: length, h: length) {
        let covered_bottom = SettingsContent.detail_sticky_top + SettingsContent.detail_header_height + SettingsContent.detail_pinned_controls_height;
        // Pinned controls suppress their own reveal requests. Ordinary rows
        // still reveal clear of the cover even when currently hidden under it.
        let top = y - set_scroll.absolute-position.y;
        let cover = Math.max(0px, covered_bottom - set_scroll.absolute-position.y);
        if (top < cover) { set_scroll.content-y -= top - cover; }
        else if (top + h > set_scroll.height) { set_scroll.content-y -= top + h - set_scroll.height; }
    }
    function navigation_top_inset() -> length {
        // Once the hero has collapsed, the search field and shortcut row stay
        // pinned above the list and cover this part of the scroll viewport.
        return root.land_scroll_y <= -108px ? 124px + root.landing_pinned_offset : 0px;
    }
    function reveal_navigation(y: length, h: length) {
        let top = root.navigation_top_inset();
        if (y + land_scroll.content-y < top) { land_scroll.content-y = top - y; }
        else if (y + h + land_scroll.content-y > land_scroll.visible-height) { land_scroll.content-y = land_scroll.visible-height - y - h; }
    }
    function jump_section(group: int) {
        if (group == 0) {
            if (root.land_avail(13)) { root.kb_land = 13; }
            else if (root.land_avail(3)) { root.kb_land = 3; }
            else if (root.land_avail(6)) { root.kb_land = 6; }
            else if (root.land_avail(5)) { root.kb_land = 5; }
        }
        if (group == 1) {
            if (root.land_avail(0)) { root.kb_land = 0; }
            else if (root.land_avail(1)) { root.kb_land = 1; }
            else if (root.land_avail(7)) { root.kb_land = 7; }
            else if (root.land_avail(12)) { root.kb_land = 12; }
        }
        if (group == 2) {
            if (root.land_avail(2)) { root.kb_land = 2; }
            else if (root.land_avail(8)) { root.kb_land = 8; }
            else if (root.land_avail(9)) { root.kb_land = 9; }
            else if (root.land_avail(4)) { root.kb_land = 4; }
        }
        root.kb_zone = 8; root.kb_active = true; root.reveal_request += 1; nav_scope.focus();
    }
    function display_previous(r: int) -> int {
        if (r == 5) { return 5; }
        if (r == 0) { return 5; }
        if (r == 1) { return 0; }
        if (r == 2) { return 1; }
        if (r == 3) { return 2; }
        if (r == 6) { return 3; }
        if (r == 4) { return 6; }
        return 5;
    }
    function display_next(r: int) -> int {
        if (r == 5) { return 0; }
        if (r == 0) { return 1; }
        if (r == 1) { return 2; }
        if (r == 2) { return 3; }
        if (r == 3) { return 6; }
        if (r == 6) { return 4; }
        if (r == 4) { return 4; }
        return 5;
    }
    function kb_nudge(d: length) {
        if (root.kb_zone == 8) { root.reveal_request += 1; }
    }

    function kb_up() {
        if (root.kb_zone == 17) {
            if (root.kb_theme > 0) { root.kb_theme -= 1; }
            else { root.kb_zone = 0; }
            return;
        }
        if (root.kb_zone == 16) {
            if (root.kb_home > 0) {
                root.kb_home -= 1;
                root.kb_nudge(50px);
            } else {
                root.kb_zone = 0;
                root.kb_nudge(150px);
            }
        } else if (root.kb_zone == 8) {
            let previous = root.land_prev(root.kb_land);
            if (previous == root.kb_land) { root.kb_zone = 0; } else { root.kb_land = previous; }
        } else if (root.kb_zone == 12) {
            if (root.kb_dl > 0) {
                root.kb_dl -= 1;
                root.kb_nudge(50px);
            } else {
                root.kb_zone = 0;
                root.kb_nudge(150px);
            }
        } else if (root.kb_zone == 13) {
            if (root.kb_dlr > 0) {
                root.kb_dlr -= 1;
                root.kb_nudge(50px);
            } else {
                root.kb_zone = 0;
                root.kb_nudge(150px);
            }
        } else if (root.kb_zone == 10) {
            if (root.kb_anr > 0) {
                root.kb_anr -= 1;
                root.kb_nudge(50px);
            } else {
                root.kb_zone = 0;
                root.kb_nudge(150px);
            }
        } else if (root.kb_zone == 9) {
            if (root.kb_pr > 0) {
                root.kb_pr -= 1;
                root.kb_nudge(50px);
            } else {
                root.kb_zone = 0;
                root.kb_nudge(150px);
            }
        } else if (root.kb_zone == 7) {
            if (root.kb_tr > 0) {
                root.kb_tr -= 1;
                root.kb_nudge(50px);
            } else {
                root.kb_zone = 0;
                root.kb_nudge(150px);
            }
        } else if (root.kb_zone == 6) {
            if (root.kb_dr != 5) {
                root.kb_dr = root.display_previous(root.kb_dr);
                root.kb_nudge(50px);
            } else {
                root.kb_zone = 0;
                root.kb_nudge(150px);
            }
        } else if (root.kb_zone == 5) {
            if (root.kb_hr > 0) {
                root.kb_hr = root.kb_cache_previous(root.kb_hr);
                root.kb_nudge(50px);
            } else {
                root.kb_zone = 0;
                root.kb_nudge(150px);
            }
        } else if (root.kb_zone == 4) {
            if (root.kb_cr > 0) {
                root.kb_cr -= 1;
                root.kb_nudge(50px);
            } else {
                root.kb_zone = 3;
                root.kb_nudge(150px);
            }
        } else if (root.kb_zone == 3) {
            root.kb_zone = 0;
            root.kb_nudge(150px);
        } else if (root.kb_zone == 2) {
            if (root.kb_ar > 0) {
                root.kb_ar -= 1;
                root.kb_nudge(50px);
            } else {
                root.kb_zone = 1;
                root.kb_nudge(150px);
            }
        } else if (root.kb_zone == 1) {
            root.kb_zone = 0;
            root.kb_nudge(150px);
        }
    }

    function kb_down() {
        if (root.kb_zone == 17) {
            root.kb_theme = Math.min(9, root.kb_theme + 1);
        } else if (root.kb_zone == 16) {
            if (root.kb_home + 1 < root.kb_home_n()) {
                root.kb_home += 1;
                root.kb_nudge(-50px);
            }
        } else if (root.kb_zone == 0) {
            if (root.sub_open && !root.two_pane) {
                root.kb_zone = root.page_first_zone();
                root.kb_nudge(-150px);
            } else {
                root.kb_zone = 8;
                root.kb_land = root.land_first();
                root.kb_nudge(-150px);
            }
        } else if (root.kb_zone == 8) {
            root.kb_land = root.land_next(root.kb_land);
            root.kb_nudge(-50px);
        } else if (root.kb_zone == 1) {
            if (root.kb_has_addons()) {
                root.kb_zone = 2;
                root.kb_ar = 0;
            }
            root.kb_nudge(-150px);
        } else if (root.kb_zone == 2) {
            if (root.kb_ar + 1 < root.addon_rows.length) {
                root.kb_ar += 1;
                root.kb_nudge(-50px);
            }
        } else if (root.kb_zone == 3) {
            if (root.kb_has_cats()) {
                root.kb_zone = 4;
                root.kb_cr = 0;
                root.kb_nudge(-150px);
            }
        } else if (root.kb_zone == 4) {
            if (root.kb_cr + 1 < root.category_rows.length) {
                root.kb_cr += 1;
                root.kb_nudge(-50px);
            }
        } else if (root.kb_zone == 5) {
            if (root.kb_hr < root.kb_cache_n() && root.kb_hr != 10) {
                root.kb_hr = root.kb_cache_next(root.kb_hr);
                root.kb_nudge(-50px);
            }
        } else if (root.kb_zone == 6) {
            // Rows 0-5: three toggles, Discover columns, Library columns,
            // Language.
            if (root.kb_dr != 4) {
                root.kb_dr = root.display_next(root.kb_dr);
                root.kb_nudge(-50px);
            }
        } else if (root.kb_zone == 7) {
            if (root.kb_tr + 1 < root.kb_torrent_n()) {
                root.kb_tr += 1;
                root.kb_nudge(-50px);
            }
        } else if (root.kb_zone == 12) {
            if (root.kb_dl < 1) {
                root.kb_dl += 1;
            }
            root.kb_nudge(-50px);
        } else if (root.kb_zone == 13) {
            if (root.kb_dlr + 1 < root.downloads_rows.length) {
                root.kb_dlr += 1;
                root.kb_nudge(-50px);
            }
        } else if (root.kb_zone == 9) {
            if (root.kb_pr + 1 < root.kb_player_n()) {
                root.kb_pr += 1;
                root.kb_nudge(-50px);
            }
        } else if (root.kb_zone == 10) {
            if (root.animations && root.kb_anr < 4) {
                root.kb_anr += 1;
                root.kb_nudge(-50px);
            }
        }
    }

    // Addon-row columns, skipping Configure when the addon has none.
    // 4 = move up, 5 = move down, 6 = copy link.
    function kb_ac_right() {
        if (root.kb_ac == 0) {
            root.kb_ac = root.kb_ac_has_config() ? 1 : 2;
        } else if (root.kb_ac == 1) {
            root.kb_ac = 2;
        } else if (root.kb_ac == 2) {
            root.kb_ac = 3;
        } else if (root.kb_ac == 3) {
            root.kb_ac = 4;
        } else if (root.kb_ac == 4) {
            root.kb_ac = 5;
        } else if (root.kb_ac == 5) {
            root.kb_ac = 6;
        }
    }

    function kb_ac_left() {
        if (root.kb_ac == 6) {
            root.kb_ac = 5;
        } else if (root.kb_ac == 5) {
            root.kb_ac = 4;
        } else if (root.kb_ac == 4) {
            root.kb_ac = 3;
        } else if (root.kb_ac == 3) {
            root.kb_ac = 2;
        } else if (root.kb_ac == 2) {
            root.kb_ac = root.kb_ac_has_config() ? 1 : 0;
        } else if (root.kb_ac == 1) {
            root.kb_ac = 0;
        }
    }

    function kb_toggle_addon(i: int) {
        if (i >= 0 && i < root.addon_rows.length) {
            root.addon_rows[i].enabled = !root.addon_rows[i].enabled;
            root.addon_toggled(i);
        }
    }

    function kb_fire_addon_col() {
        if (root.kb_ac == 0) {
            root.kb_toggle_addon(root.kb_ar);
        } else if (root.kb_ac == 1) {
            if (root.kb_ar >= 0 && root.kb_ar < root.addon_rows.length) {
                root.addon_configure(root.addon_rows[root.kb_ar].config_url);
            }
        } else if (root.kb_ac == 2) {
            if (root.kb_ar >= 0 && root.kb_ar < root.addon_rows.length) {
                root.addon_copy_link(root.addon_rows[root.kb_ar].url);
            }
        } else if (root.kb_ac == 3) {
            root.addon_refresh(root.kb_ar);
        } else if (root.kb_ac == 4) {
            root.addon_remove(root.kb_ar);
        } else if (root.kb_ac == 5) {
            root.addon_move_up(root.kb_ar);
            root.kb_ar = Math.max(0, root.kb_ar - 1);
        } else {
            root.addon_move_down(root.kb_ar);
            root.kb_ar = Math.min(root.addon_rows.length - 1, root.kb_ar + 1);
        }
    }

    // Cache-row adjusters (Left/Right and Enter-for-toggles). Row 9 is
    // the Re-encode button and row 10 is Clear: both are Enter-only.
    function kb_cache_flip(r: int) {
        if (!root.kb_cache_available(r)) { return; }
        if (r == 0) {
            root.cache_images = !root.cache_images;
            root.schedule_save();
        } else if (r == 1) {
            root.cache_enabled = !root.cache_enabled;
            root.schedule_save();
        }
    }

    function kb_cache_step(r: int, d: int) {
        if (!root.kb_cache_available(r)) { return; }
        if (r == 0 || r == 1) {
            root.kb_cache_flip(r);
        } else if (r == 2) {
            let n = root.cache_format_names.length;
            if (n > 0) {
                root.cache_format_index = Math.max(0, Math.min(n - 1, root.cache_format_index + d));
                root.schedule_save();
            }
        } else if (r == 3) {
            root.cache_quality = Math.max(1, Math.min(100, root.cache_quality + d));
            root.schedule_save();
        } else if (r >= 4 && r <= 7) {
            let index = r == 4 ? root.detail_poster_resolution_index : r == 5 ? root.detail_backdrop_resolution_index : r == 6 ? root.episode_thumbnail_resolution_index : root.player_episode_backdrop_resolution_index;
            let next = Math.max(0, Math.min(root.image_resolution_names.length - 1, index + d));
            if (r == 4) { root.detail_poster_resolution_index = next; root.schedule_setting("detail_poster_max_side"); }
            else if (r == 5) { root.detail_backdrop_resolution_index = next; root.schedule_setting("detail_backdrop_max_side"); }
            else if (r == 6) { root.episode_thumbnail_resolution_index = next; root.schedule_setting("episode_thumbnail_max_side"); }
            else { root.player_episode_backdrop_resolution_index = next; root.schedule_setting("player_episode_backdrop_max_side"); }
        } else if (r == 11) {
            root.cache_disk_limit_index = Math.max(0, Math.min(root.cache_disk_limit_names.length - 1, root.cache_disk_limit_index + d));
            root.schedule_setting("image_disk_cache_limit_mb");
        } else if (r == 8) {
            root.cache_lru_mb = Math.max(32, Math.min(512, root.cache_lru_mb + d * 16));
            root.schedule_save();
        }
    }

    // Torrent-row adjusters (Left/Right and Enter-for-toggles).
    function kb_torrent_flip(r: int) {
        if (r == 0) {
            root.torrent_enabled = !root.torrent_enabled;
            root.schedule_save();
        } else if (r == 4) {
            root.torrent_no_cache = !root.torrent_no_cache;
            root.schedule_save();
        }
    }

    function kb_torrent_step(r: int, d: int) {
        if (r == 0 || r == 4) {
            root.kb_torrent_flip(r);
        } else if (r == 2) {
            root.torrent_max_mb = Math.max(512, Math.min(32768, root.torrent_max_mb + d * 512));
            root.schedule_save();
        } else if (r == 3) {
            root.torrent_down_limit = Math.max(0, Math.min(102400, root.torrent_down_limit + d * 64));
            root.schedule_save();
        }
    }

    // Player rows: row 0 is always the backend picker (built-in vs
    // external), followed by episode start behavior. Decoder / external-app
    // controls come next, then the built-in player's language defaults and
    // global speed. The player's OSD title override remains separate.
    public function kb_player_speed_row() -> int {
        if (root.is_android) {
            return root.player_backend_index == 0 ? 6 : -1;
        }
        return root.player_backend_index == 0 ? 4 : -1;
    }

    public function kb_player_audio_language_row() -> int {
        if (root.player_backend_index != 0) { return -1; }
        return root.is_android ? 4 : 2;
    }

    public function kb_player_subtitle_language_row() -> int {
        let audio_row = root.kb_player_audio_language_row();
        return audio_row < 0 ? -1 : audio_row + 1;
    }

    function kb_player_n() -> int {
        if root.player_backend_index == 0 {
            return root.kb_player_speed_row() + (root.screenshot_format_index == 1 || root.screenshot_format_index == 3 ? 5 : 4);
        }
        return root.is_android ? 2 : 3;
    }

    changed screenshot_format_index => { root.kb_player_clamp(); }

    function kb_player_clamp() {
        if (root.kb_pr >= root.kb_player_n()) {
            root.kb_pr = root.kb_player_n() - 1;
        }
    }

    function kb_player_step(d: int) {
        if (root.kb_pr == 0) {
            root.player_backend_index = Math.max(0, Math.min(1, root.player_backend_index + d));
            root.kb_player_clamp();
            root.schedule_save();
        } else if (root.kb_pr == 1) {
            root.episode_start_index = Math.max(0, Math.min(2, root.episode_start_index + d));
            root.schedule_save();
        } else if (root.is_android && root.player_backend_index == 0 && root.kb_pr == 3) {
            root.android_auto_continue = d > 0;
            root.schedule_save();
        } else if (root.kb_pr == root.kb_player_audio_language_row()) {
            root.kb_player_language_step(root.audio_language_choice_index, d, false);
        } else if (root.kb_pr == root.kb_player_subtitle_language_row()) {
            root.kb_player_language_step(root.subtitle_language_choice_index, d, true);
        } else if (root.player_backend_index == 0 && root.kb_pr == root.kb_player_speed_row() + 1) {
            root.prefetch_next_episode_streams = d > 0;
            root.schedule_setting("prefetch_next_episode_streams");
        } else if (root.kb_pr == root.kb_player_speed_row()) {
            // The backend applies ± a step and re-quantizes; the property
            // comes back with the snapped value.
            root.playback_speed_stepped(d);
            root.schedule_save();
        } else if root.player_backend_index == 0 && root.kb_pr == root.kb_player_speed_row() + 2 {
            root.screenshot_format_index = Math.clamp(root.screenshot_format_index + d, 0, 3);
            root.schedule_setting("screenshot_format");
        } else if root.player_backend_index == 0 && root.kb_pr == root.kb_player_speed_row() + 3 {
            root.screenshot_show_folder = d > 0;
            root.schedule_setting("screenshot_show_folder");
        } else if root.player_backend_index == 0 && root.kb_pr == root.kb_player_speed_row() + 4 {
            if root.screenshot_format_index == 1 {
                root.screenshot_jpeg_quality = Math.clamp(root.screenshot_jpeg_quality + d, 1, 100);
                root.schedule_setting("screenshot_jpeg_quality");
            } else if root.screenshot_format_index == 3 {
                root.screenshot_webp_quality = Math.clamp(root.screenshot_webp_quality + d, 1, 100);
                root.schedule_setting("screenshot_webp_quality");
            }
        } else if (root.is_android) {
            root.android_hwdec_index = Math.max(0, Math.min(2, root.android_hwdec_index + d));
            root.schedule_save();
        } else {
            root.desktop_external_app_index = Math.max(0, Math.min(2, root.desktop_external_app_index + d));
            root.schedule_save();
        }
    }

    // Left/Right can choose directly from the current backend search results.
    // A query clears the dropdown index; the first step then selects the
    // first/last result, while a selected result steps normally.
    function kb_player_language_step(current_index: int, d: int, subtitle: bool) {
        let count = subtitle ? root.subtitle_language_codes.length : root.audio_language_codes.length;
        if (count == 0) { return; }
        let next_index = current_index < 0
            ? (d > 0 ? 0 : count - 1)
            : Math.max(0, Math.min(count - 1, current_index + d));
        if (subtitle) {
            root.subtitle_language_choice_index = next_index;
            let code = root.subtitle_language_codes[next_index];
            if code == "" || code == "off" {
                root.playback_language_picked(code, true);
                root.default_subtitle_language = code;
            } else {
                root.playback_language_edited(code, 0, true);
            }
            root.schedule_setting("default_subtitle_language");
        } else {
            root.audio_language_choice_index = next_index;
            let code = root.audio_language_codes[next_index];
            if code == "" || code == "off" {
                root.playback_language_picked(code, false);
                root.default_audio_language = code;
            } else {
                root.playback_language_edited(code, 0, false);
            }
            root.schedule_setting("default_audio_language");
        }
    }

    // Look-and-feel-row toggles (all rows are switches).
    function kb_anim_flip(r: int) {
        if (r > 0 && !root.animations) { return; }
        if (r == 0) {
            root.animations = !root.animations;
        } else if (r == 1) {
            root.anim_transitions = !root.anim_transitions;
        } else if (r == 2) {
            root.anim_hover = !root.anim_hover;
        } else if (r == 3) {
            root.anim_player = !root.anim_player;
        } else {
            root.anim_nav_slide = !root.anim_nav_slide;
        }
        root.schedule_save();
    }

    function kb_left() {
        if (root.kb_zone == 0) {
            if (!root.phone_layout) { root.kb_nav = NavState.step(root.kb_nav, -1, false); }
        } else if (root.kb_zone == 1) {
            if (root.kb_actl > 0) {
                root.kb_actl -= 1;
            }
        } else if (root.kb_zone == 2) {
            root.kb_ac_left();
        } else if (root.kb_zone == 3) {
            if (root.kb_cctl > 0) {
                root.kb_cctl -= 1;
            }
        } else if (root.kb_zone == 4) {
            if (root.kb_ccol > 0) {
                root.kb_ccol -= 1;
            }
        } else if (root.kb_zone == 5) {
            root.kb_cache_step(root.kb_hr, -1);
        } else if (root.kb_zone == 6) {
            if (root.kb_dr == 0) {
                root.cache_date_relative = !root.cache_date_relative;
                root.schedule_save();
            } else if (root.kb_dr == 1) {
                root.cache_prefetch_metadata = !root.cache_prefetch_metadata;
                root.schedule_save();
            } else if (root.kb_dr == 2) {
                root.cache_show_unwatched_thumbs = !root.cache_show_unwatched_thumbs;
                root.schedule_save();
            } else if (root.kb_dr == 3) {
                root.discover_min_cols = Math.max(2, root.discover_min_cols - 1);
                root.schedule_save();
            } else if (root.kb_dr == 4) {
                root.library_min_cols = Math.max(2, root.library_min_cols - 1);
                root.schedule_save();
            } else if (root.kb_dr == 6) {
                root.discover_catalog_addon_names = !root.discover_catalog_addon_names;
                root.schedule_save();
            } else if (root.language_index > 0) {
                root.language_index -= 1;
                root.schedule_save();
            }
        } else if (root.kb_zone == 7) {
            root.kb_torrent_step(root.kb_tr, -1);
        } else if (root.kb_zone == 9) {
            root.kb_player_step(-1);
        } else if (root.kb_zone == 12) {
            if (root.kb_dl == 0) {
                root.download_auto_delete_watched = !root.download_auto_delete_watched;
                root.download_auto_delete_watched_changed(root.download_auto_delete_watched);
            }
        } else if (root.kb_zone == 10) {
            root.kb_anim_flip(root.kb_anr);
        } else if (root.kb_zone == 17) {
            root.kb_theme_step(-1);
        } else if (root.kb_zone == 16) {
            root.kb_home = Math.max(0, root.kb_home - 1);
        }
    }

    function kb_right() {
        if (root.kb_zone == 0) {
            if (!root.phone_layout) { root.kb_nav = NavState.step(root.kb_nav, 1, false); }
        } else if (root.kb_zone == 1) {
            if (root.kb_actl < 2) {
                root.kb_actl += 1;
            }
        } else if (root.kb_zone == 2) {
            root.kb_ac_right();
        } else if (root.kb_zone == 3) {
            if (root.kb_cctl < 1) {
                root.kb_cctl += 1;
            }
        } else if (root.kb_zone == 4) {
            if (root.kb_ccol < 0) {
                root.kb_ccol += 1;
            }
        } else if (root.kb_zone == 5) {
            root.kb_cache_step(root.kb_hr, 1);
        } else if (root.kb_zone == 6) {
            if (root.kb_dr == 0) {
                root.cache_date_relative = !root.cache_date_relative;
                root.schedule_save();
            } else if (root.kb_dr == 1) {
                root.cache_prefetch_metadata = !root.cache_prefetch_metadata;
                root.schedule_save();
            } else if (root.kb_dr == 2) {
                root.cache_show_unwatched_thumbs = !root.cache_show_unwatched_thumbs;
                root.schedule_save();
            } else if (root.kb_dr == 3) {
                root.discover_min_cols = Math.min(6, root.discover_min_cols + 1);
                root.schedule_save();
            } else if (root.kb_dr == 4) {
                root.library_min_cols = Math.min(6, root.library_min_cols + 1);
                root.schedule_save();
            } else if (root.kb_dr == 6) {
                root.discover_catalog_addon_names = !root.discover_catalog_addon_names;
                root.schedule_save();
            } else if (root.language_index < root.language_names.length - 1) {
                root.language_index += 1;
                root.schedule_save();
            }
        } else if (root.kb_zone == 7) {
            root.kb_torrent_step(root.kb_tr, 1);
        } else if (root.kb_zone == 9) {
            root.kb_player_step(1);
        } else if (root.kb_zone == 12) {
            if (root.kb_dl == 0) {
                root.download_auto_delete_watched = !root.download_auto_delete_watched;
                root.download_auto_delete_watched_changed(root.download_auto_delete_watched);
            }
        } else if (root.kb_zone == 10) {
            root.kb_anim_flip(root.kb_anr);
        } else if (root.kb_zone == 17) {
            root.kb_theme_step(1);
        } else if (root.kb_zone == 16) {
            root.kb_home = Math.min(root.kb_home_n() - 1, root.kb_home + 1);
        }
    }

    function kb_enter() {
        if (root.kb_zone == 8) {
            root.open_page(root.kb_land);
        } else if (root.kb_zone == 0) {
            if (root.phone_layout) {
                root.system_back();
            } else if (root.kb_nav == 0) {
                root.home_picked();
            } else if (root.kb_nav == 1) {
                root.discover_picked();
            } else if (root.kb_nav == 2) {
                root.library_picked();
            } else if (root.kb_nav == 3) {
                root.more_picked();
            } else if root.kb_nav == 4 { NavState.calendar_picked(); }
            else { NavState.downloads_picked(); }
        } else if (root.kb_zone == 1) {
            if (root.kb_actl == 0) {
                root.kb_edit = 1;
            } else if (root.kb_actl == 1) {
                root.addon_added(root.addon_url);
            } else if (!root.addon_zip_import_busy) {
                root.addon_zip_import_requested();
            }
        } else if (root.kb_zone == 2) {
            root.kb_fire_addon_col();
        } else if (root.kb_zone == 3) {
            if (root.kb_cctl == 0) {
                root.kb_edit = 2;
            } else {
                root.category_added(root.category_input);
                root.category_input = "";
            }
        } else if (root.kb_zone == 4) {
            root.category_removed(root.kb_cr);
        } else if (root.kb_zone == 5) {
            if (!root.kb_cache_available(root.kb_hr)) { return; }
            if (root.kb_hr == 9) {
                if (root.cache_rewriting) { root.cancel_reencode(); } else { root.reencode_cache(); }
            } else if (root.kb_hr == 10) {
                root.clear_cache();
            } else {
                root.kb_cache_flip(root.kb_hr);
            }
        } else if (root.kb_zone == 6) {
            if (root.kb_dr == 0) {
                root.cache_date_relative = !root.cache_date_relative;
                root.schedule_save();
            } else if (root.kb_dr == 1) {
                root.cache_prefetch_metadata = !root.cache_prefetch_metadata;
                root.schedule_save();
            } else if (root.kb_dr == 2) {
                root.cache_show_unwatched_thumbs = !root.cache_show_unwatched_thumbs;
                root.schedule_save();
            }
            // Segmented grid-column rows need no Enter action (same as the
            // format picker in the cache section).
            if (root.kb_dr == 6) {
                root.discover_catalog_addon_names = !root.discover_catalog_addon_names;
                root.schedule_save();
            }
        } else if (root.kb_zone == 7) {
            if (root.kb_tr == 1) {
                root.kb_edit = 3;
            } else if (root.kb_tr == 5) {
                root.clear_torrent_cache();
            } else {
                root.kb_torrent_flip(root.kb_tr);
            }
        } else if (root.kb_zone == 9) {
            if (root.kb_pr == root.kb_player_audio_language_row()) {
                root.kb_edit = 4;
            } else if (root.kb_pr == root.kb_player_subtitle_language_row()) {
                root.kb_edit = 5;
            } else if root.player_backend_index == 0 && root.kb_pr == root.kb_player_speed_row() + 3 {
                root.screenshot_show_folder = !root.screenshot_show_folder;
                root.schedule_setting("screenshot_show_folder");
            }
        } else if (root.kb_zone == 12) {
            if (root.kb_dl == 0) {
                root.download_auto_delete_watched = !root.download_auto_delete_watched;
                root.download_auto_delete_watched_changed(root.download_auto_delete_watched);
            } else {
                root.open_page(9);
            }
        } else if (root.kb_zone == 13) {
            if (root.kb_dlr >= 0 && root.kb_dlr < root.downloads_rows.length) {
                root.download_list_remove(root.downloads_rows[root.kb_dlr].id);
            }
        } else if (root.kb_zone == 10) {
            root.kb_anim_flip(root.kb_anr);
        } else if (root.kb_zone == 17) {
            if (root.kb_theme == 9) { root.restore_theme_defaults(); }
            else if (root.kb_theme == 1) { root.kb_theme_step(1); }
        } else if (root.kb_zone == 16) {
            root.kb_home_activate();
        }
    }

    changed addon_rows => { root.kb_clamp_all(); }
    changed downloads_rows => { root.kb_clamp_all(); }
    changed category_rows => { root.kb_clamp_all(); }
    changed home_catalog_rows => { root.kb_clamp_all(); }
    changed home_row_catalog_rows => { root.kb_clamp_all(); }
    changed cache_enabled => {
        if (root.kb_hr >= root.kb_cache_n()) {
            root.kb_hr = root.kb_cache_n() - 1;
        }
    }
    changed cache_images => {
        if (root.kb_hr >= root.kb_cache_n()) {
            root.kb_hr = root.kb_cache_n() - 1;
        }
    }
    changed torrent_enabled => {
        if (root.kb_tr >= root.kb_torrent_n()) {
            root.kb_tr = root.kb_torrent_n() - 1;
        }
    }
    changed player_backend_index => { root.kb_player_clamp(); }
    changed show_torrents => {
        if (!root.show_torrents && root.sel == 4) {
            root.close_page();
        }
        if (!root.land_avail(root.kb_land)) {
            root.kb_land = root.land_first();
        }
    }
    changed show_image_cache => {
        if (!root.show_image_cache && root.sel == 2) {
            root.close_page();
        }
        if (!root.land_avail(root.kb_land)) {
            root.kb_land = root.land_first();
        }
    }
    changed is_android => {
        root.kb_player_clamp();
        if (!root.land_avail(root.kb_land)) {
            root.kb_land = root.land_first();
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.current.artwork_canvas;

        // AppWindow restores this scope after factory publication only while
        // its persistent baseline still owns focus; a delayed local reset
        // would interrupt an editor clicked during the first attached frame.
        // 6-button scope: overlays the page without intercepting the mouse.
        nav_scope := FocusScope {
            enabled: root.active;
            width: 100%;
            height: 100%;
            init => {
                SliderGesture.active = false; SliderGesture.hovered = false;
                self.focus();
                if (root.two_pane) { root.sub_open = true; }
                root.last_system_back_request = root.system_back_request;
            }
            key-pressed(e) => {
                // Edit mode belongs to the text fields (native there);
                // swallow one stray keypress to recover a lost focus.
                if (root.home_catalog_add_open
                && (e.text == Key.Backspace || e.text == Key.Back || e.text == Key.Escape)) {
                    root.home_catalog_add_open = false;
                    accept
                } else if (root.home_catalog_add_open && e.text == Key.Return) {
                    if (root.home_catalog_candidate_names.length > 0) {
                        root.home_catalog_added(
                        root.home_catalog_candidate_index,
                        root.home_catalog_genre_index
                        );
                    }
                    accept
                } else if (root.home_catalog_add_open) {
                    reject
                } else if (e.text == Key.Tab) {
                    root.kb_active = true; reject
                } else if (root.sel == 12 && e.text != Key.Back && e.text != Key.Escape) {
                    reject
                } else if (root.kb_edit != 0) {
                    root.kb_edit = 0;
                    self.focus();
                    accept

                } else if (e.text == Key.UpArrow) {
                    root.kb_active = true;
                    root.kb_up();
                    accept
                } else if (e.text == Key.DownArrow) {
                    root.kb_active = true;
                    root.kb_down();
                    accept
                } else if (e.text == Key.LeftArrow) {
                    root.kb_active = true;
                    root.kb_left();
                    accept
                } else if (e.text == Key.RightArrow) {
                    root.kb_active = true;
                    root.kb_right();
                    accept
                } else if (e.text == Key.Return) {
                    root.kb_active = true;
                    root.kb_enter();
                    accept
                } else if (e.text == Key.Backspace || e.text == Key.Back || e.text == Key.Escape) {
                    root.kb_active = true;
                    root.system_back();
                    accept
                } else {
                    reject
                }
            }
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding-left: 18px + safe-left + root.rail_w;
            padding-right: 18px + safe-right;
            padding-bottom: 18px + root.safe-bottom;
            padding-top: 18px + safe-top;
            spacing: 12px;

            // Pinned: an unpinned 1px row still absorbs free vertical space
            // (see DiscoverPage), stretching the page instead of leaving the
            // slack blank at the bottom.
            Rectangle { vertical-stretch: 0; height: 1px; }
            if root.persistence_failed: Text {
                text: @tr("Changes could not be saved. Check storage and retry.");
                color: Theme.current.text_error;
                font-size: 14px;
                min-width: 0;
                wrap: word-wrap;
                vertical-stretch: 0;
            }

            // Settings content host: the landing menu and the open subpage
            // are stacked here and slide/fade between each other. Edits
            // autosave — no Save button.
            content_host := Rectangle {
                vertical-stretch: 1;
                width: root.combined_width;
                horizontal-stretch: 0;
                clip: true;

                // ---- Landing menu (section list) ---------------------
                landing_layer := Rectangle {
                    width: root.two_pane ? 340px : content_host.width;
                    height: 100%;
                    // Push transition: slides left and dims while a subpage
                    // slides in over it; reverses on back.
                    x: root.sub_open && !root.two_pane ? -0.28 * content_host.width : 0px;
                    opacity: root.sub_open && !root.two_pane ? 0.0 : 1.0;
                    animate x { duration: Anim.transition_slide; easing: ease-out; }
                    animate opacity { duration: Anim.transition_fade; }
                    // One stable viewport scrolls the whole landing column.
                    // Placeholder slots retain the initial title/search/chip
                    // spacing; the live controls float over them and stick
                    // below the hero once its 108px slot has scrolled away.
                    land_scroll := ScrollView {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;
                        mouse-drag-pan-enabled: true;
                        init => { self.content-y = root.land_scroll_y; }
                        changed content-y => { root.land_scroll_y = self.content-y; }

                        VerticalLayout {
                            width: 100%;
                            spacing: 12px;

                            Rectangle { width: 100%; height: 108px; }
                            Rectangle { width: 100%; height: 44px; }
                            Rectangle { width: 100%; height: 44px; }

                            VerticalLayout {
                                width: 100%;
                                vertical-stretch: 1;
                                spacing: 8px;

                                for group[g] in [@tr("Experience"), @tr("Library and services"), @tr("Storage and network")]: group_section := VerticalLayout {
                                    vertical-stretch: 0; spacing: 8px;
                                    if root.group_available(g): Text { text: group; color: Theme.current.text_settings; font-size: 14px; font-weight: 600; wrap: word-wrap; min-width: 0px; }
                                    if root.group_available(g): SettingsCard {
                                        for entry in SettingsDestinations.entries: VerticalLayout {
                                            vertical-stretch: 0;
                                            if entry.group == g && root.land_avail(entry.id): destination_link := SettingsLink {
                                                destination-id: entry.stable-id;
                                                icon-kind: entry.id;
                                                title: entry.parent < 0 ? entry.title : root.land_title(entry.parent) + " › " + entry.title;
                                                subtitle: entry.description;
                                                selected: root.two_pane && root.sel == entry.id;
                                                focused: root.kb_active && root.kb_zone == 8 && root.kb_land == entry.id;
                                                interactive: !root.sub_open || root.two_pane;
                                                picked => { root.kb_active = SettingsStyle.keyboard-mode; root.kb_land = entry.id; root.open_page(entry.id); }
                                                in property <int> request: root.reveal_request;
                                                changed request => { if (root.kb_zone == 8 && root.kb_land == entry.id) { root.reveal_navigation(self.absolute-position.y - land_scroll.absolute-position.y - land_scroll.content-y, self.height); } }
                                                changed focused => { if (self.focused) { root.reveal_navigation(self.absolute-position.y - land_scroll.absolute-position.y - land_scroll.content-y, self.height); } }
                                            }
                                        }
                                    }
                                }
                                if !root.group_available(0) && !root.group_available(1) && !root.group_available(2): VerticalLayout {
                                    vertical-stretch: 0; spacing: 12px;
                                    Text { text: @tr("No settings found."); color: Theme.current.text_settings; font-size: 14px; wrap: word-wrap; min-width: 0px; }
                                    PillButton { label: @tr("Clear search"); clicked => { root.search_query = ""; } }
                                }
                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                    }

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;
                        clip: false;

                        // Cover the scrolling rows between and around the
                        // sticky controls, including the top gutter once the
                        // hero collapses. Keep the scroll viewport unchanged.
                        landing_controls_canvas := Rectangle {
                            x: 0px;
                            y: 108px + root.landing_header_shift + root.landing_pinned_offset;
                            width: 100%;
                            // Fade within the 12px gap below the shortcuts,
                            // leaving the first group heading fully clear.
                            height: 112px;
                            clip: true;
                            background: Theme.current.artwork_canvas;
                            TouchArea { width: 100%; height: 100%; clicked => {} }
                        }
                        landing_controls_fade := Rectangle {
                            y: landing_controls_canvas.y + landing_controls_canvas.height;
                            width: 100%; height: 8px;
                            background: @linear-gradient(180deg, Theme.current.artwork_canvas, transparent);
                            TouchArea { width: 100%; height: 100%; clicked => {} }
                        }

                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: 100%;
                            height: 108px;
                            clip: true;
                            SettingsBackButton {
                                x: 16px; y: 24px + root.landing_header_shift;
                                focused: root.phone_layout && root.kb_zone == 0 && root.kb_active;
                                clicked => { root.system_back(); }
                            }
                            Rectangle {
                                width: 100%; height: 0px; clip: true;
                                landing_heading_measure := Text {
                                    width: Math.max(0px, parent.width - 88px);
                                    text: @tr("Settings"); font-size: root.two_pane ? 28px : 32px; font-weight: 700; wrap: word-wrap;
                                }
                                landing_intro_measure := Text {
                                    width: Math.max(0px, parent.width - 32px);
                                    text: @tr("Make Nova yours"); font-size: 14px; wrap: word-wrap;
                                }
                            }
                            Text {
                                x: 72px; y: 24px + root.landing_header_shift;
                                width: parent.width - 88px;
                                text: @tr("Settings"); font-size: root.two_pane ? 28px : 32px; font-weight: 700; color: Theme.current.text_bright; wrap: word-wrap;
                            }
                            Text {
                                x: 16px; y: 24px + landing_heading_measure.preferred-height + 8px + root.landing_header_shift;
                                width: parent.width - 32px; height: landing_intro_measure.preferred-height;
                                text: @tr("Make Nova yours"); font-size: 14px; color: Theme.current.text_settings; wrap: word-wrap;
                            }
                        }

                        settings_search := SearchField {
                            x: 0px;
                            y: Math.max(12px, 120px + root.landing_header_shift + root.landing_pinned_offset);
                            width: 100%;
                            show-pointer-focus: false; keyboard-mode: root.kb_active;
                            roomy: true; search-icon: true; text <=> root.search_query;
                            enabled: !root.sub_open || root.two_pane;
                            placeholder-text: @tr("Search settings");
                            focus_changed(f) => { root.input_focused = f; }
                            edited(q) => { root.kb_land = root.land_first(); }
                            accepted(q) => { root.kb_land = root.land_first(); root.kb_zone = 8; root.kb_active = true; nav_scope.focus(); }
                        }

                        HorizontalLayout {
                            x: 0px;
                            y: Math.max(68px, 176px + root.landing_header_shift + root.landing_pinned_offset);
                            width: 100%;
                            height: 44px;
                            spacing: 4px;
                            for group[i] in [@tr("Experience"), @tr("Services"), @tr("Storage")]: PillButton {
                                label: group; compact: true; enabled: (!root.sub_open || root.two_pane) && root.group_available(i);
                                clicked => { root.jump_section(i); }
                            }
                        }
                    }
                }

                // ---- Subpage (one section) ---------------------------
                sub_layer := Rectangle {
                    width: root.detail_width;
                    height: 100%;
                    x: root.sub_open ? (root.two_pane ? 364px : 0px) : content_host.width;
                    opacity: root.sub_open ? 1.0 : 0.0;
                    animate x { duration: Anim.transition_slide; easing: ease-out; }
                    animate opacity { duration: Anim.transition_fade; }

                    VerticalLayout {
                        width: 100%;
                        height: 100%;
                        spacing: 10px;

                        // Back bar: returns to the landing menu (keyboard
                        // users press Backspace).
                        // Subpage content scrolls when the window is short.
                        // Explicit fill: a plain Rectangle does not size its
                        // children, so without width/height the view would
                        // take its content's full preferred height, overflow
                        // (clipped) and never scroll — fatal on short phones.
                        set_scroll := Flickable {
                            width: 100%;
                            vertical-stretch: 1;
                            // Include the full measured Addons body, including
                            // copy which wraps at the narrow viewport width.
                            content-height: Math.max(self.height, root.sel == 0 ? sub_content.preferred-height : sub_content.min-height);
                            // ScrollView hides interactive; a raw Flickable lets
                            // sliders keep vertical wobble from stealing a drag.
                            interactive: !SliderGesture.active;
                            mouse-drag-pan-enabled: !SliderGesture.hovered;
                            // One-way mirror, see DiscoverPage: Flickable
                            // drops viewport bindings on press, so mirror
                            // explicitly.
                            init => { self.content-y = root.scroll_y; }
                            changed content-y => { root.scroll_y = self.content-y; }
                            sub_content := VerticalLayout {
                                // The Flickable sizes its content to at least
                                // the viewport (`content-height = max(height,
                                // min)`), so short pages would otherwise spread
                                // the slack across their cards/headers. The
                                // trailing spacer below absorbs it instead,
                                // keeping content top-aligned; long content
                                // still scrolls.
                                spacing: 18px;
                                // Bound to the viewport width: without this
                                // the content sizes to its preferred width
                                // (wide control rows) and the view pans
                                // horizontally on narrow phone screens.
                                width: 100%;
                                sub_header := SettingsHeader {
                                    title: root.land_title(root.sel);
                                    back_focused: root.phone_layout && root.kb_zone == 0 && root.kb_active && !sticky_sub_header.pinned;
                                    introduction: root.land_desc(root.sel);
                                    back => { root.submenu_back(); }
                                }

                                if root.sel == 12: SettingsSectionHost {
                                    factory: SettingsContent.tracking_factory;
                                    slot_width: self.width; slot_height: self.height;
                                }
                                if root.sel == 0: SettingsSectionHost {
                                    factory: SettingsContent.addons_factory;
                                    slot_width: self.width; slot_height: self.height;
                                }
                                if root.sel == 1: SettingsSectionHost {
                                    factory: SettingsContent.categories_factory;
                                    slot_width: self.width; slot_height: self.height;
                                }

                                if root.show_image_cache && root.sel == 2: SettingsSectionHost {
                                    factory: SettingsContent.image_cache_factory;
                                    slot_width: self.width; slot_height: self.height;
                                }

                                if root.sel == 3: SettingsSectionHost {
                                    factory: SettingsContent.display_factory;
                                    slot_width: self.width; slot_height: self.height;
                                }

                                if root.show_torrents && root.sel == 4: SettingsSectionHost {
                                    factory: SettingsContent.p2p_factory;
                                    slot_width: self.width; slot_height: self.height;
                                }

                                if root.sel == 5: SettingsSectionHost {
                                    factory: SettingsContent.player_factory;
                                    slot_width: self.width; slot_height: self.height;
                                }

                                if root.sel == 14: SettingsSectionHost {
                                    factory: SettingsContent.theme_factory;
                                    slot_width: self.width; slot_height: self.height;
                                }

                                if root.sel == 6: SettingsSectionHost {
                                    factory: SettingsContent.look_feel_factory;
                                    slot_width: self.width; slot_height: self.height;
                                }

                                if root.sel == 7: SettingsSectionHost {
                                    factory: SettingsContent.sync_factory;
                                    slot_width: self.width; slot_height: self.height;
                                }
                                if root.sel == 13: SettingsSectionHost {
                                    factory: SettingsContent.home_factory;
                                    slot_width: self.width; slot_height: self.height;
                                }

                                if root.sel == 8: SettingsSectionHost {
                                    factory: SettingsContent.downloads_factory;
                                    slot_width: self.width; slot_height: self.height;
                                }

                                if root.sel == 9: SettingsSectionHost {
                                    factory: SettingsContent.downloaded_episodes_factory;
                                    slot_width: self.width; slot_height: self.height;
                                }

                                // Absorbs the Flickable's slack so a short subpage stays
                                // top-aligned instead of stretching its content.
                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                    }

                }
            }
        }

                    // Overview shares the compact safe-top navigation lane.
                    // Fade in as the large heading leaves; its retained search
                    // and shortcuts move below the lane without losing focus.
                    sticky_landing_header := Rectangle {
                        property <length> cover_left: root.two_pane ? 0px : 18px + root.safe-left;
                        visible: (!root.sub_open || root.two_pane) && root.landing_compact_progress > 0;
                        opacity: landing_layer.opacity * root.landing_compact_progress;
                        x: landing_layer.absolute-position.x - root.absolute-position.x - self.cover_left;
                        y: root.safe-top;
                        width: landing_layer.width + self.cover_left + (root.two_pane ? 12px : 18px + root.safe-right);
                        height: 60px;
                        Rectangle {
                            y: -root.safe-top; width: 100%; height: parent.height + root.safe-top + 8px;
                            background: Theme.current.artwork_canvas;
                            TouchArea { width: 100%; height: 100%; clicked => {} }
                        }
                        HorizontalLayout {
                            padding-left: root.two_pane ? 16px : 18px + root.safe-left;
                            padding-right: 18px + root.safe-right;
                            padding-top: 8px; padding-bottom: 8px; spacing: 12px;
                            SettingsBackButton {
                                reveal-on-focus: false;
                                focused: root.phone_layout && root.kb_zone == 0 && root.kb_active;
                                clicked => { if root.two_pane { root.kb_zone = 8; } root.system_back(); }
                            }
                            Text { text: @tr("Settings"); font-size: 20px; font-weight: 700; color: Theme.current.text_bright; vertical-alignment: center; overflow: elide; }
                        }
                    }

                    // Keep the original large heading in the document; only
                    // its compact navigation takes over after it leaves view.
                    sticky_sub_header := Rectangle {
                        property <length> shell_top: root.absolute-position.y + root.safe-top;
                        property <bool> pinned: root.sub_open && root.scroll_y <= -sub_header.height;
                        property <length> cover_height: self.pinned ? 68px : 0px;
                        changed shell_top => { SettingsContent.detail_sticky_top = self.shell_top; }
                        changed cover_height => { SettingsContent.detail_header_height = self.cover_height; }
                        property <length> cover_left: root.two_pane ? 0px : 18px + root.safe-left;
                        property <length> cover_right: 18px + root.safe-right;
                        changed cover_left => { SettingsContent.detail_cover_left = self.cover_left; }
                        changed cover_right => { SettingsContent.detail_cover_right = self.cover_right; }
                        init => { SettingsContent.detail_sticky_top = self.shell_top; SettingsContent.detail_header_height = self.cover_height; SettingsContent.detail_cover_left = root.two_pane ? 0px : 18px + root.safe-left; SettingsContent.detail_cover_right = 18px + root.safe-right; }
                        visible: self.pinned;
                        x: sub_layer.absolute-position.x - root.absolute-position.x - self.cover_left;
                        y: root.safe-top;
                        width: root.detail_width + self.cover_left + self.cover_right;
                        opacity: sub_layer.opacity;
                        height: 60px;
                        Rectangle {
                            y: -root.safe-top; width: 100%; height: parent.height + root.safe-top;
                            background: Theme.current.artwork_canvas;
                            TouchArea { width: 100%; height: 100%; clicked => {} }
                        }
                        HorizontalLayout {
                            padding-left: root.two_pane ? 16px : 18px + root.safe-left;
                            padding-right: 18px + root.safe-right;
                            padding-top: 8px; padding-bottom: 8px; spacing: 12px;
                            SettingsBackButton { reveal-on-focus: false; focused: root.phone_layout && root.kb_zone == 0 && root.kb_active; clicked => { root.submenu_back(); } }
                            Text { text: root.land_title(root.sel); font-size: 20px; font-weight: 700; color: Theme.current.text_bright; vertical-alignment: center; overflow: elide; }
                        }
                        // Stacked sticky controls form one opaque header. The
                        // transition belongs below the last row, so cards must
                        // not show through the seam above Installed sources.
                        Rectangle {
                            y: parent.height; width: 100%; height: 8px;
                            background: SettingsContent.detail_pinned_controls_height > 0px
                                ? Theme.current.artwork_canvas
                                : @linear-gradient(180deg, Theme.current.artwork_canvas, transparent);
                            TouchArea { width: 100%; height: 100%; clicked => {} }
                        }
                    }

        // Settings uses header Back throughout narrow layouts. The wide
        // rail stays visible on every subpage. Declared after the page column
        // so it paints over the strip its own footprint reserves — the
        // column widens its left padding by `rail_w`, so no page content
        // lands under it.
        if !root.phone_layout && !root.external_navigation: rail := SideNav {
            panel-background: transparent;
            viewport-width: root.nav-viewport-width;
            active: 3;
            safe-top: root.safe-top;
            safe-left: root.safe-left;
            safe-bottom: root.safe-bottom;
            kb_zone: root.kb_zone;
            kb_nav: root.kb_nav;
            kb_active <=> root.kb_active;

            home_picked => { root.home_picked(); }
            discover_picked => { root.discover_picked(); }
            library_picked => { root.library_picked(); }
            more_picked => { root.more_picked(); }
        }

        if root.home_catalog_add_open: Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.current.scrim_settings;

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.home_catalog_add_open = false; }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: Math.min(parent.width - 32px, 520px);
                height: Math.min(parent.height - 32px, 420px);
                background: Theme.current.card;
                border-width: 1px;
                border-color: Theme.current.dialog_border;
                border-radius: 12px;
                clip: true;

                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    padding: 18px;
                    spacing: 10px;

                    Text {
                        text: root.home_catalog_add_target == 0 ? @tr("Add featured catalog") : @tr("Add Home catalog");
                        font-size: 17px;
                        font-weight: 700;
                        color: Theme.current.text_bright;
                    }

                    Text {
                        width: 100%;
                        text: root.home_catalog_add_target == 0
                            ? @tr("Choose a catalog and optional genre for the rotating Home banner.")
                            : @tr("Choose a built-in catalog or an addon catalog and optional genre for Home.");
                        font-size: 14px;
                        color: Theme.current.text_settings;
                        wrap: word-wrap;
                    }

                    Text {
                        text: @tr("Catalog");
                        font-size: 14px;
                        color: Theme.current.text_settings;
                    }

                    Dropdown {
                        width: 100%;
                        model: root.home_catalog_candidate_names;
                        current-index <=> root.home_catalog_candidate_index;
                        placeholder-text: @tr("Select catalog");
                        enabled: root.home_catalog_candidate_names.length > 0;
                        roomy: true;
                        selected(_) => {
                            root.home_catalog_add_error = "";
                            root.home_catalog_candidate_picked(root.home_catalog_candidate_index);
                        }
                    }

                    Text {
                        text: @tr("Genre");
                        font-size: 14px;
                        color: Theme.current.text_settings;
                    }

                    Dropdown {
                        width: 100%;
                        model: root.home_catalog_genre_names;
                        current-index <=> root.home_catalog_genre_index;
                        placeholder-text: @tr("All genres");
                        enabled: root.home_catalog_genre_names.length > 1;
                        roomy: true;
                        selected(_) => { root.home_catalog_add_error = ""; }
                    }

                    if root.home_catalog_candidate_names.length == 0: Text {
                        width: 100%;
                        text: root.home_catalog_add_target == 0
                            ? @tr("No enabled addon catalogs are available. Enable an addon with catalogs first.")
                            : @tr("All built-in catalogs are already added. Enable an addon for more catalogs.");
                        font-size: 14px;
                        color: Theme.current.text_removal_warning;
                        wrap: word-wrap;
                    }

                    if root.home_catalog_add_error != "": Text {
                        width: 100%;
                        text: root.home_catalog_add_error;
                        font-size: 14px;
                        color: Theme.current.text_removal_warning;
                        wrap: word-wrap;
                    }

                    Rectangle { vertical-stretch: 1; }

                    HorizontalLayout {
                        width: 100%;
                        spacing: 10px;
                        alignment: end;

                        PillButton {
                            label: @tr("Cancel");
                            roomy: true;
                            clicked => { root.home_catalog_add_open = false; }
                        }

                        if root.home_catalog_candidate_names.length > 0: home_catalog_modal_add := PillButton {
                            label: @tr("Add");
                            primary: true;
                            roomy: true;
                            clicked => {
                                root.home_catalog_added(
                                root.home_catalog_candidate_index,
                                root.home_catalog_genre_index
                                );
                            }
                        }
                    }
                }
            }
        }
    }
    if root.addon_config_open: Rectangle {
        background: Theme.current.scrim_settings;
        TouchArea { clicked => { root.close_addon_config(); } }
        addon_config_panel := Rectangle {
            x: root.safe-left + (parent.width - root.safe-left - root.safe-right - self.width) / 2;
            y: root.safe-top + (parent.height - root.safe-top - root.safe-bottom - self.height) / 2;
            width: Math.min(1080px, parent.width - root.safe-left - root.safe-right - (root.phone_layout ? 0px : 48px));
            height: root.phone_layout ? parent.height - root.safe-top - root.safe-bottom : Math.min(root.plugin_setting_rows.length > 0 ? 840px : 370px, parent.height - root.safe-top - root.safe-bottom - 32px);
            background: Theme.current.canvas;
            border-width: 1px;
            border-color: Theme.current.dialog_border;
            border-radius: 16px;
            TouchArea { }
            config_focus := FocusScope {
                property <int> selected: 0;
                property <int> action: 0;
                property <int> picker_choice: 0;
                property <int> scan_direction: 1;
                property <int> editing <=> root.addon_text_editor;
                property <int> save_version: 0;
                // Store the declared controller key, so identically named items
                // in different collections cannot open one another's editors.
                property <string> collection_editing <=> root.addon_collection_editor;
                property <string> preference_editing <=> root.addon_preference_editor;
                function preference_link(index: int) -> bool {
                    let row = root.plugin_setting_rows[index];
                    return row.collection == "" && row.kind != "preferences-header" && row.kind != "sort-criterion" && row.kind != "priority-criterion" && row.kind != "priority-picker";
                }
                function open_preference(index: int) {
                    let key = root.plugin_setting_rows[index].key;
                    self.preference_editing = self.preference_editing == key ? "" : key;
                    self.selected = index;
                    self.action = 0;
                    self.focus();
                }
                property <bool> confirm_visible: root.plugin_clear_confirm;
                changed confirm_visible => { if self.confirm_visible { config_scroll.content-y = Math.min(0px, config_scroll.visible-height - config_scroll.content-height); } }
                public function reveal(y: length,h: length) {
                    if y < 0px { config_scroll.content-y -= y; }
                    else if y + h > config_scroll.visible-height { config_scroll.content-y -= y + h - config_scroll.visible-height; }
                }
                function available(index: int) -> bool {
                    if index >= root.plugin_setting_rows.length { return index == root.plugin_setting_rows.length + 2 || root.plugin_setting_rows.length > 0; }
                    let row = root.plugin_setting_rows[index];
                    if row.kind == "collection-header" || row.kind == "preferences-header" { return false; }
                    if row.kind == "collection-picker" { return true; }
                    if row.collection == "" { return self.preference_link(index) || self.preference_editing == row.key; }
                    if row.item_role == "member" || row.item_role == "enabled" { return row.configured; }
                    return row.item_controller == self.collection_editing && self.collection_editing != "";
                }
                function next(index: int, direction: int) -> int {
                    self.scan_direction = direction;
                    return Math.mod(index + direction + root.plugin_setting_rows.length + 3, root.plugin_setting_rows.length + 3);
                }
                function actions(index: int) -> int {
                    if index >= root.plugin_setting_rows.length { return 1; }
                    let row = root.plugin_setting_rows[index];
                    if self.preference_link(index) && self.preference_editing != row.key { return 1; }
                    if row.kind == "boolean" && row.collection != "" && (row.item_role == "member" || row.item_role == "enabled") { return row.has_editor ? (self.collection_editing == row.key ? 3 : 2) : 1; }
                    if row.kind == "sort-criterion" || row.kind == "priority-criterion" { return 3; }
                    if row.kind == "string" || row.kind == "secret" || row.kind == "integer" { return 2; }
                    return 1;
                }
                function remove(index: int) {
                    let row = root.plugin_setting_rows[index];
                    if row.kind != "boolean" || row.collection == "" || (row.item_role != "member" && row.item_role != "enabled") { return; }
                    // The backend attaches a secret key only to account rows.
                    // Removing a source therefore preserves its custom URL.
                    if row.item_role == "enabled" && row.options.length > 0 { root.plugin_setting_changed(root.addon_config_url, row.options[0], ""); }
                    root.plugin_setting_changed(root.addon_config_url, row.key, "false");
                    self.collection_editing = "";
                    self.editing = -1;
                }
                // Slint functions are analyzed as bindings, so scan hidden rows
                // in deferred ticks rather than recursively calling a function.
                Timer {
                    interval: 1ms;
                    running: !root.addon_config_capabilities && !config_focus.available(config_focus.selected);
                    triggered => { config_focus.selected = config_focus.next(config_focus.selected, config_focus.scan_direction); config_focus.action = config_focus.scan_direction < 0 ? config_focus.actions(config_focus.selected) - 1 : 0; }
                }
                init => { self.selected = root.addon_config_capabilities ? 0 : self.next(-1, 1); self.focus(); }
                key-pressed(e) => {
                    if e.repeat && e.text != Key.UpArrow && e.text != Key.DownArrow { accept }
                    else if e.text == Key.Back || e.text == Key.Escape {
                        if root.plugin_clear_confirm { root.plugin_clear_confirm = false; }
                        else if self.editing >= 0 { self.editing = -1; self.focus(); }
                        else if self.collection_editing != "" { self.collection_editing = ""; self.selected = self.next(-1, 1); self.action = 0; }
                        else if self.preference_editing != "" { self.preference_editing = ""; self.selected = self.next(-1, 1); self.action = 0; }
                        else { root.close_addon_config(); } accept
                    } else if !root.addon_config_capabilities {
                        if self.editing >= 0 && e.text != Key.Tab && e.text != Key.UpArrow && e.text != Key.DownArrow { reject }
                        else if e.text == Key.Tab || e.text == Key.DownArrow || e.text == Key.UpArrow {
                            SettingsStyle.keyboard-mode = true;
                            self.editing = -1;
                            self.focus();
                            if e.text == Key.Tab && !e.modifiers.shift && self.action + 1 < self.actions(self.selected) { self.action += 1; }
                            else if e.text == Key.Tab && e.modifiers.shift && self.action > 0 { self.action -= 1; }
                            else {
                                self.selected = self.next(self.selected, e.text == Key.UpArrow || (e.text == Key.Tab && e.modifiers.shift) ? -1 : 1);
                                self.action = e.text == Key.Tab && e.modifiers.shift ? self.actions(self.selected) - 1 : 0;
                                self.picker_choice = 0;
                            }
                            accept
                        } else if e.text == Key.Return || e.text == " " || e.text == Key.LeftArrow || e.text == Key.RightArrow {
                            SettingsStyle.keyboard-mode = true;
                            if !self.available(self.selected) { self.selected = self.next(self.selected, 1); self.action = 0; }
                            if self.selected < root.plugin_setting_rows.length {
                                let row = root.plugin_setting_rows[self.selected];
                                if self.preference_link(self.selected) && self.preference_editing != row.key { self.open_preference(self.selected); }
                                else if row.kind == "sort-header" || row.kind == "priority-header" { self.open_preference(self.selected); }
                                else if (row.kind == "collection-picker" || row.kind == "priority-picker") && row.options.length > 0 {
                                    if e.text == Key.LeftArrow || e.text == Key.RightArrow { self.picker_choice = Math.mod(self.picker_choice + (e.text == Key.LeftArrow ? row.options.length - 1 : 1), row.options.length); }
                                    else {
                                        let choice = row.options[Math.mod(self.picker_choice, row.options.length)];
                                        if row.kind == "priority-picker" {
                                            root.plugin_setting_changed(root.addon_config_url, row.key, choice);
                                        } else {
                                            root.plugin_setting_changed(root.addon_config_url, choice, "true");
                                            self.collection_editing = choice;
                                        }
                                        self.selected = self.next(-1, 1);
                                        self.action = 0;
                                    }
                                } else if row.kind == "sort-criterion" || row.kind == "priority-criterion" {
                                    if self.action == 2 || (self.action == 0 && row.selected > 0) || (self.action == 1 && row.selected + 1 < row.labels.length) {
                                        root.plugin_setting_changed(root.addon_config_url, row.key, row.options[self.action]);
                                    }
                                } else if row.kind == "boolean" && row.collection != "" && (row.item_role == "member" || row.item_role == "enabled") {
                                    if self.action == 2 { self.remove(self.selected); }
                                    else if self.action == 0 { root.plugin_setting_changed(root.addon_config_url, row.key, row.checked ? "false" : "true"); }
                                    else if row.has_editor { self.collection_editing = self.collection_editing == row.key ? "" : row.key; }
                                } else if row.kind == "boolean" { root.plugin_setting_changed(root.addon_config_url, row.key, row.checked ? "false" : "true"); }
                                else if row.kind == "choice" && row.options.length > 0 {
                                    root.plugin_setting_changed(root.addon_config_url, row.key, row.options[Math.mod(row.selected + (e.text == Key.LeftArrow ? row.options.length - 1 : 1), row.options.length)]);
                                } else if self.action == 1 { self.save_version += 1; }
                                else { self.editing = self.selected; }
                            } else if self.selected == root.plugin_setting_rows.length { root.plugin_cache_clear(root.addon_config_url); }
                            else if self.selected == root.plugin_setting_rows.length + 1 {
                                if root.plugin_clear_confirm { root.plugin_clear_confirm = false; root.plugin_settings_clear(root.addon_config_url); }
                                else { root.plugin_clear_confirm = true; }
                            } else { root.close_addon_config(); }
                            accept
                        } else { reject }
                    } else if e.text == Key.UpArrow { self.selected = Math.max(0, self.selected - 1); accept }
                    else if e.text == Key.DownArrow || e.text == Key.Tab { self.selected = Math.mod(self.selected + 1, 3); accept }
                    else if e.text == Key.Return || e.text == " " || e.text == Key.LeftArrow || e.text == Key.RightArrow {
                        if self.selected == 0 { root.addon_config_streams = !root.addon_config_streams; root.save_addon_config(); }
                        else if self.selected == 1 { root.addon_config_metadata = !root.addon_config_metadata; root.save_addon_config(); }
                        else { root.close_addon_config(); } accept
                    } else { reject }
                }
                config_scroll := ScrollView {
                    width: 100%; height: 100%;
                    content-width: self.visible-width;
                    mouse-drag-pan-enabled: true;
                    VerticalLayout {
                        padding: root.phone_layout ? 16px : 24px; spacing: 18px;
                        HorizontalLayout {
                            spacing: 12px;
                            PillButton {
                                label: ""; width: 44px; roomy: true; accessible-label: @tr("Back");
                                IcChevronLeft { x: 10px; y: 10px; width: 24px; height: 24px; fill: Theme.current.text_settings; }
                                clicked => { root.system_back(); }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 4px;
                                Text { text: root.addon_config_label; color: Theme.current.text_bright; font-size: 22px; font-weight: 700; wrap: word-wrap; }
                                Text { text: @tr("Addon configuration"); color: Theme.current.text_settings; font-size: 14px; }
                            }
                            PillButton {
                                label: ""; width: 44px; roomy: true; accessible-label: @tr("Close");
                                IcClose { x: 12px; y: 12px; width: 20px; height: 20px; fill: Theme.current.text_settings; }
                                clicked => { root.close_addon_config(); }
                            }
                        }
                        if root.addon_config_capabilities: SettingsCard {
                            VerticalLayout {
                                spacing: 0px;
                                SettingsRow {
                                    row-title: @tr("Streams");
                                    row-desc: @tr("Provide playable streams, including for other metadata sources.");
                                    ToggleSwitch {
                                        active-thumb-color: Theme.current.on_accent;
                                        name: @tr("Streams"); checked <=> root.addon_config_streams;
                                        focused: SettingsStyle.keyboard-mode && config_focus.selected == 0;
                                        toggled => { config_focus.focus(); config_focus.selected = 0; root.save_addon_config(); }
                                    }
                                }
                                SettingsRow {
                                    row-title: @tr("Metadata");
                                    row-desc: @tr("Provide metadata, catalogs and search results.");
                                    ToggleSwitch {
                                        active-thumb-color: Theme.current.on_accent;
                                        name: @tr("Metadata"); checked <=> root.addon_config_metadata;
                                        focused: SettingsStyle.keyboard-mode && config_focus.selected == 1;
                                        toggled => { config_focus.focus(); config_focus.selected = 1; root.save_addon_config(); }
                                    }
                                }
                            }
                        }
                        if root.addon_config_capabilities && !root.addon_config_streams && !root.addon_config_metadata: Text {
                            text: @tr("This addon provides no content while both options are off.");
                            color: Theme.current.text_settings; font-size: 13px; wrap: word-wrap;
                        }
                        // Switch columns from the actual panel width, not the device class.
                        // Item identity and persisted fields stay on the leaf rows.
                        GridLayout {
                        spacing: 18px;
                        for column in [0, 1]: VerticalLayout {
                            col: config_scroll.visible-width >= 760px && root.plugin_setting_rows.length > 0 && root.plugin_setting_rows[0].kind == "collection-header" ? column : 0;
                            row: config_scroll.visible-width >= 760px && root.plugin_setting_rows.length > 0 && root.plugin_setting_rows[0].kind == "collection-header" ? 0 : column;
                            alignment: start;
                            spacing: 0px;
                        for group[group_index] in root.plugin_setting_rows: config_group := Rectangle {
                            visible: column == 0 ? group.kind == "collection-header" : group.kind == "preferences-header";
                            height: self.visible ? group_content.preferred-height + 18px : 0px;
                            vertical-stretch: 0;
                            SettingsCard {
                            width: 100%;
                            height: group_content.preferred-height;
                            group_content := VerticalLayout {
                                padding: 16px; spacing: 0px;
                                if group.kind == "preferences-header": HorizontalLayout {
                                    spacing: 12px;
                                    IcSettingsGear { width: 24px; height: 24px; fill: Theme.current.text_settings; }
                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: @tr("Stream preferences"); color: Theme.current.text_bright; font-size: 17px; font-weight: 700; }
                                        Text { text: @tr("Customize how streams are found and played."); color: Theme.current.text_settings; font-size: 12px; wrap: word-wrap; }
                                    }
                                }
                                for field[index] in root.plugin_setting_rows: config_row := VerticalLayout {
                                    property <bool> kb_current: self.visible && SettingsStyle.keyboard-mode && config_focus.selected == index;
                                    changed kb_current => { if self.kb_current { config_focus.reveal(self.absolute-position.y - config_scroll.absolute-position.y, self.height); } }
                                    visible: config_group.visible && (group.kind == "collection-header" ? field.collection == group.collection : group.kind == "preferences-header" ? field.collection == "" && field.kind != "preferences-header" : index == group_index)
                                        && (field.kind == "collection-header" || config_focus.available(index));
                                    // Invisible model rows still contribute layout constraints.
                                    // Collapse them so one group's unrelated fields cannot hide
                                    // the following sections beyond an inflated scroll extent.
                                    height: self.visible ? self.preferred-height : 0px;
                                    vertical-stretch: 0;
                                    padding-top: self.visible ? 8px : 0px;
                                    padding-bottom: self.visible ? 8px : 0px;
                                    spacing: self.visible ? 6px : 0px;
                                    if config_focus.preference_link(index): Rectangle { height: 1px; background: Theme.current.control_border; }
                                    if config_focus.preference_link(index): Rectangle {
                                        height: preference_caption.preferred-height;
                                        border-width: config_row.kb_current ? 1px : 0px;
                                        border-color: Theme.current.focus_ring;
                                        preference_caption := HorizontalLayout {
                                            padding-top: 12px; padding-bottom: 12px; spacing: 12px;
                                            Rectangle {
                                                width: 24px; min-height: 24px;
                                                if field.kind == "sort-header": IcSync { y: (parent.height - self.height) / 2; width: 24px; height: 24px; fill: Theme.current.text_settings; }
                                                if field.kind == "priority-header": IcTag { y: (parent.height - self.height) / 2; width: 24px; height: 24px; fill: Theme.current.text_settings; }
                                                if field.kind != "sort-header" && field.kind != "priority-header": IcSettingsGear { y: (parent.height - self.height) / 2; width: 24px; height: 24px; fill: Theme.current.text_settings; }
                                            }
                                            VerticalLayout {
                                                horizontal-stretch: 1; spacing: 4px;
                                                Text { text: field.label; color: Theme.current.text_bright; font-size: 14px; wrap: word-wrap; }
                                                if field.summary != "": Text { text: field.summary; color: Theme.current.text_settings; font-size: 12px; wrap: word-wrap; }
                                            }
                                            if config_focus.preference_editing != field.key: IcChevronRight { width: 20px; height: 20px; fill: Theme.current.text_settings; }
                                            if config_focus.preference_editing == field.key: IcChevronDown { width: 20px; height: 20px; fill: Theme.current.text_settings; }
                                        }
                                        TouchArea { accessible-role: button; accessible-label: field.label; clicked => { config_focus.open_preference(index); } }
                                    }
                                    if field.kind == "sort-header" && config_focus.preference_editing == field.key: VerticalLayout {
                                        spacing: 4px;
                                        Text { text: field.label; color: Theme.current.text_bright; font-size: 16px; font-weight: 700; }
                                        Text { text: @tr("Higher priority first. Unknown values last."); color: Theme.current.text_settings; font-size: 12px; wrap: word-wrap; }
                                    }
                                    if field.kind == "priority-header" && config_focus.preference_editing == field.key: VerticalLayout {
                                        spacing: 4px;
                                        Text { text: field.label; color: Theme.current.text_bright; font-size: 16px; font-weight: 700; }
                                        Text { text: @tr("First choice ranks highest. Unlabelled releases stay last."); color: Theme.current.text_settings; font-size: 12px; wrap: word-wrap; }
                                    }
                                    if field.kind == "sort-criterion" || field.kind == "priority-criterion": Text {
                                        text: (field.selected + 1) + ". " + field.label;
                                        color: SettingsStyle.keyboard-mode && config_focus.selected == index ? Theme.current.focus_ring : Theme.current.text_settings;
                                        font-size: 14px; wrap: word-wrap;
                                    }
                                    if field.kind == "sort-criterion" || field.kind == "priority-criterion": HorizontalLayout {
                                        spacing: 6px;
                                        PillButton {
                                            label: @tr("Up"); roomy: true;
                                            enabled: field.selected > 0;
                                            focused: SettingsStyle.keyboard-mode && config_focus.selected == index && config_focus.action == 0;
                                            clicked => { root.plugin_setting_changed(root.addon_config_url, field.key, field.options[0]); }
                                        }
                                        PillButton {
                                            label: @tr("Down"); roomy: true;
                                            enabled: field.selected + 1 < field.labels.length;
                                            focused: SettingsStyle.keyboard-mode && config_focus.selected == index && config_focus.action == 1;
                                            clicked => { root.plugin_setting_changed(root.addon_config_url, field.key, field.options[1]); }
                                        }
                                        PillButton {
                                            label: field.kind == "priority-criterion" ? @tr("Remove") : field.checked ? @tr("High first") : @tr("Low first"); roomy: true;
                                            focused: SettingsStyle.keyboard-mode && config_focus.selected == index && config_focus.action == 2;
                                            clicked => { root.plugin_setting_changed(root.addon_config_url, field.key, field.options[2]); }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    if field.kind == "collection-header": HorizontalLayout {
                                        spacing: 12px;
                                        IcExtension { width: 24px; height: 24px; fill: Theme.current.text_settings; }
                                        Text { text: field.collection_label; color: Theme.current.text_bright; font-size: 17px; font-weight: 700; wrap: word-wrap; }
                                    }
                                    if field.kind == "collection-picker" || field.kind == "priority-picker": Dropdown {
                                        border-color: self.kb_current ? Theme.current.focus_ring : Theme.current.control_border;
                                        property <bool> kb_current: SettingsStyle.keyboard-mode && config_focus.selected == index;
                                        model: field.options; labels: field.labels;
                                        current-index: self.kb_current ? config_focus.picker_choice : -1;
                                        placeholder-text: field.label; roomy: true;
                                        accessible-role: combobox;
                                        accessible-label: field.label;
                                        selected(value) => {
                                            if field.kind == "priority-picker" {
                                                root.plugin_setting_changed(root.addon_config_url, field.key, value);
                                            } else {
                                                config_focus.collection_editing = value;
                                                root.plugin_setting_changed(root.addon_config_url, value, "true");
                                            }
                                        }
                                    }
                                    if field.kind == "boolean" && field.collection != "" && (field.item_role == "member" || field.item_role == "enabled") && field.configured: VerticalLayout {
                                        spacing: 8px;
                                        HorizontalLayout {
                                            spacing: 12px;
                                            Rectangle {
                                                width: 24px; min-height: 24px;
                                                if field.item_role == "member": IcDownload { y: (parent.height - self.height) / 2; width: 24px; height: 24px; fill: Theme.current.text_settings; }
                                                if field.item_role == "enabled": IcExtension { y: (parent.height - self.height) / 2; width: 24px; height: 24px; fill: Theme.current.text_settings; }
                                            }
                                            VerticalLayout {
                                                horizontal-stretch: 1; spacing: 3px; alignment: center;
                                                Text { text: field.label; color: Theme.current.text_bright; font-size: 14px; wrap: word-wrap; }
                                                if field.item_role == "enabled": Text { text: @tr("Configured"); color: Theme.current.text_settings; font-size: 12px; }
                                            }
                                            if field.has_editor: PillButton {
                                                label: ""; width: 44px; roomy: true;
                                                accessible-label: @tr("Edit") + " " + field.label;
                                                focused: SettingsStyle.keyboard-mode && config_focus.selected == index && config_focus.action == 1;
                                                IcSettingsGear { x: 12px; y: 12px; width: 20px; height: 20px; fill: Theme.current.text_settings; }
                                                clicked => { config_focus.collection_editing = config_focus.collection_editing == field.key ? "" : field.key; }
                                            }
                                            ToggleSwitch {
                                        active-thumb-color: Theme.current.on_accent;
                                                name: field.label; checked: field.checked;
                                                focused: SettingsStyle.keyboard-mode && config_focus.selected == index && config_focus.action == 0;
                                                toggled => { root.plugin_setting_changed(root.addon_config_url, field.key, self.checked ? "true" : "false"); }
                                            }
                                        }
                                        if config_focus.collection_editing == field.key: HorizontalLayout {
                                            PillButton {
                                                label: @tr("Remove"); roomy: true; destructive: true;
                                                focused: SettingsStyle.keyboard-mode && config_focus.selected == index && config_focus.action == 2;
                                                clicked => { config_focus.remove(index); }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                        Rectangle { height: 1px; background: Theme.current.control_border; }
                                    }
                                    if config_row.visible && field.collection != "" && (field.item_role == "secret" || field.item_role == "url") && config_focus.collection_editing == field.item_controller: collection_editor := VerticalLayout {
                                        property <bool> reveal_pending: true;
                                        // Opening an editor can put it below the current
                                        // viewport. Reveal after its wrapped height settles.
                                        Timer {
                                            interval: 16ms;
                                            running: collection_editor.reveal_pending;
                                            triggered => {
                                                collection_editor.reveal_pending = false;
                                                config_focus.reveal(collection_editor.absolute-position.y - config_scroll.absolute-position.y, collection_editor.height);
                                            }
                                        }
                                        spacing: 6px;
                                        Text { text: field.label; color: Theme.current.text_settings; font-size: 14px; wrap: word-wrap; }
                                        collection_input := SearchField {
                                            property <int> save_version: config_focus.save_version;
                                            changed save_version => { if config_focus.selected == index && config_focus.action == 1 { root.plugin_setting_changed(root.addon_config_url, field.key, self.full-text); } }
                                            property <bool> edit_active: config_focus.editing == index;
                                            changed edit_active => { if self.edit_active { self.focus(); } }
                                            accessible-role: text-input; accessible-label: field.label;
                                            text: field.value;
                                            input-type: field.kind == "secret" ? InputType.password : InputType.text; roomy: true;
                                            focus_changed(focused) => {
                                                if focused { config_focus.selected = index; config_focus.editing = index; config_focus.action = 0; }
                                                else if config_focus.editing == index { config_focus.editing = -1; }
                                            }
                                            accepted(value) => { root.plugin_setting_changed(root.addon_config_url, field.key, value); }
                                        }
                                        PillButton {
                                            label: @tr("Save"); roomy: true;
                                            focused: SettingsStyle.keyboard-mode && config_focus.selected == index && config_focus.action == 1;
                                            clicked => { root.plugin_setting_changed(root.addon_config_url, field.key, collection_input.full-text); }
                                        }
                                    }
                                    if field.collection == "" && config_focus.preference_editing == field.key && field.kind != "collection-header" && field.kind != "collection-picker" && field.kind != "sort-header" && field.kind != "sort-criterion" && field.kind != "priority-header" && field.kind != "priority-criterion" && field.kind != "priority-picker": Text { text: field.label; color: SettingsStyle.keyboard-mode && config_focus.selected == index ? Theme.current.focus_ring : Theme.current.text_settings; font-size: 14px; wrap: word-wrap; }
                                    if field.collection == "" && config_focus.preference_editing == field.key && field.kind == "boolean": ToggleSwitch {
                                        active-thumb-color: Theme.current.on_accent;
                                        name: field.label; checked: field.checked;
                                        focused: SettingsStyle.keyboard-mode && config_focus.selected == index;
                                        toggled => { root.plugin_setting_changed(root.addon_config_url, field.key, self.checked ? "true" : "false"); }
                                    }
                                    if field.collection == "" && config_focus.preference_editing == field.key && field.kind == "choice": Dropdown {
                                        border-color: SettingsStyle.keyboard-mode && config_focus.selected == index ? Theme.current.focus_ring : Theme.current.control_border;
                                        model: field.options; labels: field.labels; current-index: field.selected; roomy: true;
                                        selected(value) => { root.plugin_setting_changed(root.addon_config_url, field.key, value); }
                                    }
                                    if field.collection == "" && config_focus.preference_editing == field.key && (field.kind == "string" || field.kind == "secret" || field.kind == "integer"): HorizontalLayout {
                                        spacing: 8px;
                                        plugin_input := SearchField {
                                            property <int> save_version: config_focus.save_version;
                                            changed save_version => { if config_focus.selected == index && config_focus.action == 1 { root.plugin_setting_changed(root.addon_config_url, field.key, self.full-text); } }
                                            property <bool> edit_active: config_focus.editing == index;
                                            changed edit_active => { if self.edit_active { self.focus(); } }
                                            accessible-role: text-input; accessible-label: field.label;
                                            horizontal-stretch: 1;
                                            text: field.value; input-type: field.kind == "secret" ? InputType.password : InputType.text; roomy: true;
                                            focus_changed(focused) => {
                                                if focused { config_focus.selected = index; config_focus.editing = index; }
                                                else if config_focus.editing == index { config_focus.editing = -1; }
                                            }
                                            accepted(value) => { root.plugin_setting_changed(root.addon_config_url, field.key, value); }
                                        }
                                        PillButton { label: @tr("Save"); roomy: true; focused: SettingsStyle.keyboard-mode && config_focus.selected == index && config_focus.action == 1; clicked => { root.plugin_setting_changed(root.addon_config_url, field.key, plugin_input.full-text); } }
                                    }
                                }
                            }
                        }
                        }
                        if column == 1 && root.plugin_setting_rows.length > 0: SettingsCard {
                            HorizontalLayout {
                                padding: 14px; spacing: 10px;
                                IcCheck { width: 20px; height: 20px; fill: Theme.current.focus_ring; }
                                Text { text: @tr("Selections saved automatically. Save text fields after editing."); color: Theme.current.text_settings; font-size: 12px; wrap: word-wrap; }
                            }
                        }
                        }
                        }
                        if root.plugin_settings_notice != "": Text { text: root.plugin_settings_notice; color: Theme.current.text_settings; wrap: word-wrap; }
                        if root.plugin_setting_rows.length > 0: VerticalLayout {
                            property <bool> kb_current: SettingsStyle.keyboard-mode && config_focus.selected >= root.plugin_setting_rows.length;
                            changed kb_current => { if self.kb_current { config_focus.reveal(self.absolute-position.y - config_scroll.absolute-position.y,self.height); } }
                            spacing: 8px;
                            PillButton { width: 100%; wrap_label: true; label: @tr("Clear plugin cache"); roomy: true; focused: SettingsStyle.keyboard-mode && config_focus.selected == root.plugin_setting_rows.length; clicked => { config_focus.editing = -1; config_focus.selected = root.plugin_setting_rows.length; config_focus.focus(); root.plugin_cache_clear(root.addon_config_url); } }
                            PillButton { width: 100%; wrap_label: true; label: @tr("Remove configuration everywhere"); roomy: true; destructive: true; focused: SettingsStyle.keyboard-mode && config_focus.selected == root.plugin_setting_rows.length + 1; clicked => { config_focus.editing = -1; config_focus.selected = root.plugin_setting_rows.length + 1; config_focus.focus(); root.plugin_clear_confirm = true; } }
                        }
                        if root.plugin_clear_confirm: VerticalLayout {
                            spacing: 8px;
                            Text { text: @tr("Remove this configuration on all synced devices?"); color: Theme.current.text_settings; wrap: word-wrap; }
                            VerticalLayout {
                                spacing: 8px;
                                PillButton { width: 100%; wrap_label: true; label: @tr("Cancel"); roomy: true; clicked => { config_focus.editing = -1; config_focus.focus(); root.plugin_clear_confirm = false; } }
                                PillButton { width: 100%; wrap_label: true; label: @tr("Remove configuration"); roomy: true; destructive: true; clicked => { config_focus.editing = -1; config_focus.focus(); root.plugin_clear_confirm = false; root.plugin_settings_clear(root.addon_config_url); } }
                            }
                        }
                        PillButton {
                            property <bool> kb_current: SettingsStyle.keyboard-mode && config_focus.selected == (root.addon_config_capabilities ? 2 : root.plugin_setting_rows.length + 2);
                            changed kb_current => { if self.kb_current && !root.addon_config_capabilities { config_focus.reveal(self.absolute-position.y - config_scroll.absolute-position.y,self.height); } }
                            label: @tr("Close"); roomy: true; focused: self.kb_current; clicked => { root.close_addon_config(); }
                        }
                    }
                }
            }
        }
    }
    SettingSyncModal {
        narrow: root.phone_layout;
        safe-top: root.safe-top; safe-bottom: root.safe-bottom;
        safe-left: root.safe-left; safe-right: root.safe-right;
        closed => { nav_scope.focus(); }
    }

    if !root.active: TouchArea {
        width: 100%; height: 100%;
        clicked => { }
        scroll-event(event) => { accept }
    }
}
