import { ScrollView, Spinner } from "std-widgets.slint";
import { MediaCard } from "types.slint";
import { KbMark } from "kbnav.slint";
import { SideNav, NavMetrics } from "sidenav.slint";
import { BottomNav } from "bottomnav.slint";
import { Dropdown } from "dropdown.slint";
import { SearchField } from "searchfield.slint";
import { Anim } from "anim.slint";
import { IcChevronLeft, IcChevronRight, IcDelete, IcSearch } from "icons.slint";

// Browse and temporary search filters share the same dropdown rail. It keeps
// readable widths on phones and leaves vertical drags to the enclosing page.
component DiscoverFilters inherits Flickable {
    in property <[string]> addon_names;
    in property <[string]> type_names;
    in property <[string]> catalog_names;
    in property <[string]> catalog_labels;
    in property <[string]> genre_names;
    in-out property <int> addon_combo_idx: 0;
    in-out property <int> type_combo_idx: 0;
    in-out property <int> catalog_combo_idx: 0;
    in-out property <int> genre_combo_idx: 0;
    in property <bool> narrow;
    in property <bool> search_controls: false;
    in property <bool> kb_enabled: true;
    in property <int> kb_zone;
    in property <int> kb_ctl;
    in property <bool> kb_active;
    callback picked(int, int);
    callback filters_panned();
    callback filters_pan_released();

    width: 100%;
    vertical-stretch: 0;
    height: root.narrow ? 44px : 32px;
    interactive: true;
    content-width: filter_row.width;
    content-height: self.height;
    changed content-x => { root.filters_panned(); }
    function reveal_control(left: length, control_width: length) {
        if (left + self.content-x < 0px) {
            self.content-x = -left;
        } else if (left + control_width + self.content-x > self.width) {
            self.content-x = self.width - left - control_width;
        }
    }

    filter_row := HorizontalLayout {
        width: self.preferred-width;
        height: parent.height;
        spacing: 8px;
        alignment: start;

        if root.addon_names.length > 0: KbMark { on: root.kb_enabled && root.kb_zone == 1; active: root.kb_active; }
        if root.addon_names.length > 0: Dropdown {
            width: 180px;
            roomy: root.narrow;
            pill: true;
            rail-gesture: true;
            accessible-role: button;
            accessible-label: root.search_controls ? @tr("Search addon") : @tr("Addon");
            property <bool> kb_focused: root.kb_enabled && root.kb_active && root.kb_zone == 1;
            changed kb_focused => {
                if (self.kb_focused) { root.reveal_control(self.x, self.width); }
            }
            model: root.addon_names;
            current-index <=> root.addon_combo_idx;
            selected(v) => { root.picked(0, root.addon_combo_idx); }
            pan_hint => { root.filters_panned(); }
            pan_release => { root.filters_pan_released(); }
        }
        KbMark { on: root.kb_enabled && root.kb_zone == 2 && root.kb_ctl == 0; active: root.kb_active; }
        Dropdown {
            width: 110px;
            roomy: root.narrow;
            pill: true;
            rail-gesture: true;
            accessible-role: button;
            accessible-label: root.search_controls ? @tr("Search type") : @tr("Type");
            property <bool> kb_focused: root.kb_enabled && root.kb_active && root.kb_zone == 2 && root.kb_ctl == 0;
            changed kb_focused => {
                if (self.kb_focused) { root.reveal_control(self.x, self.width); }
            }
            model: root.type_names;
            current-index <=> root.type_combo_idx;
            selected(v) => { root.picked(1, root.type_combo_idx); }
            pan_hint => { root.filters_panned(); }
            pan_release => { root.filters_pan_released(); }
        }
        KbMark { on: root.kb_enabled && root.kb_zone == 2 && root.kb_ctl == 1; active: root.kb_active; }
        Dropdown {
            width: 220px;
            roomy: root.narrow;
            pill: true;
            rail-gesture: true;
            accessible-role: button;
            accessible-label: root.search_controls ? @tr("Search catalog") : @tr("Catalog");
            property <bool> kb_focused: root.kb_enabled && root.kb_active && root.kb_zone == 2 && root.kb_ctl == 1;
            changed kb_focused => {
                if (self.kb_focused) { root.reveal_control(self.x, self.width); }
            }
            model: root.catalog_names;
            labels: root.catalog_labels;
            current-index <=> root.catalog_combo_idx;
            selected(v) => { root.picked(2, root.catalog_combo_idx); }
            pan_hint => { root.filters_panned(); }
            pan_release => { root.filters_pan_released(); }
        }
        if root.genre_names.length > 1: KbMark { on: root.kb_enabled && root.kb_zone == 2 && root.kb_ctl == 2; active: root.kb_active; }
        if root.genre_names.length > 1: Dropdown {
            width: 140px;
            roomy: root.narrow;
            pill: true;
            rail-gesture: true;
            accessible-role: button;
            accessible-label: root.search_controls ? @tr("Search genre") : @tr("Genre");
            property <bool> kb_focused: root.kb_enabled && root.kb_active && root.kb_zone == 2 && root.kb_ctl == 2;
            changed kb_focused => {
                if (self.kb_focused) { root.reveal_control(self.x, self.width); }
            }
            model: root.genre_names;
            current-index <=> root.genre_combo_idx;
            selected(v) => { root.picked(3, root.genre_combo_idx); }
            pan_hint => { root.filters_panned(); }
            pan_release => { root.filters_pan_released(); }
        }
    }
}

// Filter header (nav buttons, title, addon/type/catalog/search pickers).
// Instantiated twice by DiscoverPage — once pinned above the grid
// (desktop) and once scrolling with the page (Android, `scroll_page`)
// — so it owns no page state: everything is forwarded properties, and
// the search-field refocus escapes through `search_done` (the page's
// FocusScope id is not visible from inside this component).
component DiscoverHeader {
    in property <[string]> addon_names;
    in property <[string]> type_names;
    in property <[string]> catalog_names;
    in property <[string]> catalog_labels;
    in property <[string]> genre_names;
    in property <[string]> search_history;
    in-out property <bool> search_focused: false;
    in property <bool> search_filters_open: false;
    in property <[string]> search_addon_names: [];
    in property <[string]> search_type_names: [];
    in property <[string]> search_catalog_names: [];
    in property <[string]> search_catalog_labels: [];
    in property <[string]> search_genre_names: [];
    in-out property <int> search_addon_combo_idx: 0;
    in-out property <int> search_type_combo_idx: 0;
    in-out property <int> search_catalog_combo_idx: 0;
    in-out property <int> search_genre_combo_idx: 0;
    // Dropdowns take focus from the input; recent searches belong to the whole
    // search session and must stay available while its filters are being used.
    property <bool> show_history: (root.search_focused || root.search_filters_open)
        && root.search_text == "" && root.search_history.length > 0;
    in-out property <int> addon_combo_idx: -1;
    in-out property <int> type_combo_idx: -1;
    in-out property <int> catalog_combo_idx: -1;
    in-out property <int> genre_combo_idx: 0;
    in-out property <string> search_text;
    in property <string> searchable_hint;
    // Disabled only when no enabled source accepts a search query.
    in property <bool> searchable: true;
    in property <bool> results_open: false;
    in property <bool> narrow;
    in property <int> kb_zone;
    in property <int> kb_nav;
    in property <int> kb_ctl;
    in-out property <bool> kb_active;
    // Transient search edit mode (physical-keyboard flow), bound
    // through from the page so Enter-to-edit works in both layouts.
    in-out property <bool> kb_edit: false;
    // Keep the search field flush with the history panel unless its keyboard
    // focus marker is actually visible (the HorizontalLayout gap otherwise
    // remains even when the marker has zero width).
    property <bool> search_mark_on: root.kb_active && root.kb_zone == 2 && root.kb_ctl == 3;
    property <length> search_mark_gap: root.search_mark_on ? 8px : 0px;

    callback addon_picked(string);
    callback type_picked(string);
    callback catalog_picked(string);
    callback genre_picked(string);
    callback search_activated();
    callback search_filter_picked(int, int);
    callback search_edited(string);
    callback search_submitted(string);
    callback back_picked();
    callback search_done();
    callback search_history_cleared();
    callback search_history_item_removed(string);
    callback filters_panned();
    callback filters_pan_released();

    VerticalLayout {
        width: 100%;
        spacing: 12px;

        // Search has its own temporary selectors; browse keeps its selection.
        if root.results_open || root.search_filters_open: results_heading := HorizontalLayout {
            vertical-stretch: 0;
            height: Math.max(root.narrow ? 44px : 36px, results_title.preferred-height);
            spacing: 12px;

            Rectangle {
                width: root.narrow ? 44px : 36px;
                height: root.narrow ? 44px : 36px;
                border-radius: 8px;
                background: back_touch.has-hover ? #2b2b35 : #1f1f27;
                accessible-role: button;
                accessible-label: @tr("Back");

                IcChevronLeft {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 22px;
                    height: 22px;
                    fill: #eeeeee;
                }
                back_touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.back_picked(); }
                }
            }
            results_title := Text {
                text: root.results_open ? @tr("Search results") : @tr("Search");
                font-size: root.results_open ? (root.narrow ? 27px : 24px) : (root.narrow ? 32px : 26px);
                font-weight: 700;
                color: #ffffff;
                vertical-alignment: center;
                min-width: 0px;
                height: self.preferred-height;
                wrap: word-wrap;
            }
        }

        if !root.results_open && !root.search_filters_open: HorizontalLayout {
            vertical-stretch: 0;
            min-height: 38px;
            alignment: start;

            Text {
                text: @tr("Search");
                font-size: root.narrow ? 32px : 26px;
                font-weight: 700;
                color: #ffffff;
                min-width: 0px;
                height: self.preferred-height;
                wrap: word-wrap;
            }
        }

        if !root.narrow: HorizontalLayout {
            width: 100%;
            vertical-stretch: 0;
            spacing: root.search_mark_gap;
            height: 58px;

            KbMark { on: root.search_mark_on; active: root.kb_active; }
            search_line := SearchField {
                roomy: true;
                prominent: true;
                enabled: root.searchable;
                text <=> root.search_text;
                focus_changed(focused) => {
                    root.search_focused = focused;
                    if (focused) { root.search_activated(); }
                }
                placeholder-text: root.searchable ? @tr("Search movies, shows…") : root.searchable_hint;
                accepted(t) => {
                    root.kb_edit = false;
                    root.search_done();
                    root.search_submitted(t);
                }
                edited(t) => {
                    root.search_edited(t);
                }
                horizontal-stretch: 1;
            }

            edit_t := Timer {
                interval: 80ms;
                running: root.kb_edit && !root.narrow;
                triggered => { search_line.focus(); }
            }

        }

        if root.narrow: HorizontalLayout {
            width: 100%;
            vertical-stretch: 0;
            spacing: root.search_mark_gap;
            height: 58px;

            KbMark { on: root.search_mark_on; active: root.kb_active; }
            search_line_narrow := SearchField {
                roomy: true;
                prominent: true;
                enabled: root.searchable;
                text <=> root.search_text;
                focus_changed(focused) => {
                    root.search_focused = focused;
                    if (focused) { root.search_activated(); }
                }
                placeholder-text: root.searchable ? @tr("Search movies, shows…") : root.searchable_hint;
                accepted(t) => {
                    root.kb_edit = false;
                    root.search_done();
                    root.search_submitted(t);
                }
                edited(t) => {
                    root.search_edited(t);
                }
                horizontal-stretch: 1;
            }

            edit_tn := Timer {
                interval: 80ms;
                running: root.kb_edit && root.narrow;
                triggered => { search_line_narrow.focus(); }
            }

        }

        if root.search_filters_open: VerticalLayout {
            vertical-stretch: 0;
            spacing: 6px;
            Text {
                text: @tr("Search filters");
                color: #a9a9b7;
                font-size: 13px;
                height: self.preferred-height;
            }
            search_filters := DiscoverFilters {
                addon_names: root.search_addon_names;
                type_names: root.search_type_names;
                catalog_names: root.search_catalog_names;
                catalog_labels: root.search_catalog_labels;
                genre_names: root.search_genre_names;
                addon_combo_idx <=> root.search_addon_combo_idx;
                type_combo_idx <=> root.search_type_combo_idx;
                catalog_combo_idx <=> root.search_catalog_combo_idx;
                genre_combo_idx <=> root.search_genre_combo_idx;
                search_controls: true;
                narrow: root.narrow;
                kb_zone: root.kb_zone;
                kb_ctl: root.kb_ctl;
                kb_active: root.kb_active;
                picked(kind, index) => { root.search_filter_picked(kind, index); }
                filters_panned => { root.filters_panned(); }
                filters_pan_released => { root.filters_pan_released(); }
            }
        }

        history_panel := Rectangle {
            width: 100%;
            height: root.show_history ? 54px + Math.min(5, root.search_history.length) * 40px : 0px;
            opacity: root.show_history ? 1.0 : 0.0;
            clip: true;
            animate height { duration: Anim.transition_slide; easing: ease-in-out; }
            animate opacity { duration: Anim.transition_fade; }
            vertical-stretch: 0;
            background: #18181f;
            border-radius: 14px;
            border-width: 1px;
            border-color: #33333c;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                HorizontalLayout {
                    height: 28px;
                    Text {
                        text: @tr("Recent searches");
                        color: #d8d8e2;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: clear_label.preferred-width + 16px;
                        height: 28px;
                        border-radius: 8px;
                        background: clear_history_touch.has-hover ? #ffffff14 : transparent;
                        accessible-role: button;
                        accessible-label: @tr("Clear history");
                        clear_label := Text {
                            text: @tr("Clear history");
                            color: #a99ac9;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        clear_history_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.search_history_cleared(); }
                        }
                    }
                }
                ScrollView {
                    mouse-drag-pan-enabled: true;
                    VerticalLayout {
                        width: 100%;
                        spacing: 0px;
                        for query in root.search_history: Rectangle {
                            height: 40px;
                            border-radius: 8px;
                            background: history_touch.has-hover ? #8b5cf61c : transparent;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 10px;
                                Rectangle {
                                    width: 18px;
                                    height: 100%;
                                    IcSearch {
                                        width: 18px;
                                        height: 18px;
                                        y: (parent.height - self.height) / 2;
                                        fill: #8b7eaa;
                                    }
                                }
                                Text {
                                    text: query;
                                    height: 100%;
                                    color: #e6e6ea;
                                    font-size: 14px;
                                    min-width: 0px;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    width: 30px;
                                    height: 100%;
                                    border-radius: 8px;
                                    background: remove_touch.has-hover ? #ffffff14 : transparent;
                                    accessible-role: button;
                                    accessible-label: @tr("Remove search: {}", query);
                                    IcDelete {
                                        width: 16px;
                                        height: 16px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        fill: #a99ac9;
                                    }
                                    remove_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.search_history_item_removed(query); }
                                    }
                                }
                                Rectangle {
                                    width: 16px;
                                    height: 100%;
                                    IcChevronRight {
                                        width: 16px;
                                        height: 16px;
                                        y: (parent.height - self.height) / 2;
                                        fill: #8b7eaa;
                                    }
                                }
                            }
                            history_touch := TouchArea {
                                x: 0;
                                y: 0;
                                width: parent.width - 74px;
                                height: 100%;
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: query;
                                clicked => {
                                    root.search_text = query;
                                    root.search_submitted(query);
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---- Title: own line(s) so the header never
        // overflows on narrow windows --------------------------------
        // Pinned like every other header row: an unpinned row absorbs
        // free vertical space (it measured 421px tall on desktop),
        // leaving big blanks above/below the count.
        if !root.results_open: HorizontalLayout {
            vertical-stretch: 0;
            min-height: 36px;
            spacing: 8px;
            alignment: start;

            Text {
                text: @tr("Discover");
                font-size: 26px;
                font-weight: 700;
                color: #ffffff;
                min-width: 0px;
                height: self.preferred-height;
                wrap: word-wrap;
            }

        }

        if !root.results_open: filter_flick := DiscoverFilters {
            addon_names: root.addon_names;
            type_names: root.type_names;
            catalog_names: root.catalog_names;
            catalog_labels: root.catalog_labels;
            genre_names: root.genre_names;
            addon_combo_idx <=> root.addon_combo_idx;
            type_combo_idx <=> root.type_combo_idx;
            catalog_combo_idx <=> root.catalog_combo_idx;
            genre_combo_idx <=> root.genre_combo_idx;
            narrow: root.narrow;
            kb_zone: root.kb_zone;
            kb_ctl: root.kb_ctl;
            kb_active: root.kb_active;
            kb_enabled: !root.search_filters_open;
            picked(kind, index) => {
                if (kind == 0) { root.addon_picked(root.addon_names[index]); }
                else if (kind == 1) { root.type_picked(root.type_names[index]); }
                else if (kind == 2) { root.catalog_picked(root.catalog_names[index]); }
                else { root.genre_picked(root.genre_names[index]); }
            }
            filters_panned => { root.filters_panned(); }
            filters_pan_released => { root.filters_pan_released(); }
        }

        if !root.results_open: Rectangle { height: 1px; background: #23232b; }
    }

}

// Card grid (posters + loading spinner + empty state). Shared by both
// page structures — the grid always fills its own height, only its
// parent scroll differs (grid-local on desktop, whole-page on Android).
component DiscoverGrid {
    in property <[MediaCard]> catalog;
    in property <int> cols: 1;
    in property <length> item-width;
    in property <length> item-gap;
    in-out property <bool> kb_active;
    in-out property <int> kb_zone;
    in-out property <int> kb_idx;
    in property <bool> loading_more;
    in property <bool> loading: false;
    in property <string> empty_hint;
    in property <bool> stagger: false;
    in property <bool> touch_menus: false;

    callback item_selected(string, int);

    VerticalLayout {
        width: 100%;
        padding-top: 8px;

        // Centered: when cards hit max-card the grid is narrower than the
        // viewport and centers; when fluid it spans the full width and
        // the centering is a no-op.
        HorizontalLayout {
            alignment: center;

        grid_box := GridLayout {
            // Exact content width so centering above has an effect.
            width: root.cols * (root.item-width + root.item-gap) - root.item-gap;
            spacing: root.item-gap;

            for card[i] in root.catalog: card_slot := Rectangle {
                row: Math.floor(i / root.cols);
                col: Math.mod(i, root.cols);

                width: root.item-width;
                // Poster keeps a true 2:3 ratio at any column count, so
                // narrow (e.g. 3-across phone) cards shrink in height too
                // instead of stretching tall. +50px title/year footer.
                height: root.item-width * 3 / 2 + 50px;
                // Each delegate owns its one-shot reveal. Model row updates
                // (especially posters) must never reset/cancel a page-wide
                // reveal timer and strand this card at zero opacity.
                property <bool> item_revealed: false;
                property <duration> item_reveal_delay: Math.min(i, 12) * 30ms;
                item_reveal_t := Timer {
                    interval: 40ms;
                    running: root.stagger && !card_slot.item_revealed;
                    triggered => {
                        card_slot.item_revealed = true;
                    }
                }

                reveal_layer := Rectangle {
                    width: 100%;
                    height: 100%;
                    opacity: !root.stagger || parent.item_revealed ? 1.0 : 0.0;
                    y: !root.stagger || parent.item_revealed ? 0px : 12px;
                    animate opacity { duration: Anim.transition_fade; delay: root.stagger ? parent.item_reveal_delay : 0ms; }
                    animate y { duration: Anim.transition_slide; delay: root.stagger ? parent.item_reveal_delay : 0ms; }

                    lift := Rectangle {
                        width: 100%;
                        height: 100%;
                        background: #18181c;
                        border-radius: 10px;
                        border-width: root.kb_active && root.kb_zone == 3 && root.kb_idx == i ? 2px : 0px;
                        border-color: #8b5cf6;

                        // Touch hover can remain latched after a scroll;
                        // keep the lift exclusive to a released pointer.
                        y: touch.has-hover && !touch.pressed && !root.touch_menus ? -6px : 0px;
                        animate y { duration: Anim.hover_lift; easing: ease-in-out; }

                        VerticalLayout {
                            spacing: 0px;

                            Rectangle {
                                height: root.item-width * 3 / 2;
                                border-radius: 10px;
                                clip: true;
                                background: #222228;

                                if card.is_loaded: Image {
                                    source: card.poster;
                                    image-fit: cover;
                                    width: 100%;
                                    height: 100%;
                                }

                                if !card.is_loaded: Text {
                                    text: "🎬";
                                    font-size: 34px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            VerticalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 6px;
                                spacing: 2px;

                                Text {
                                    text: card.title;
                                    color: #eeeeee;
                                    font-size: 13px;
                                    font-weight: 600;
                                    overflow: elide;
                                }

                                Text {
                                    text: card.year;
                                    color: #7a7a8c;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.kb_active = false;
                            root.kb_zone = 3;
                            root.kb_idx = i;
                            root.item_selected(card.id, i);
                        }
                    }
                }
            }

            if root.loading_more: Rectangle {
                row: Math.floor(root.catalog.length / root.cols) + 1;
                col: 0;
                colspan: root.cols;
                height: 48px;

                Spinner {
                    width: self.preferred-width;
                    height: self.preferred-height;
                    y: (parent.height - self.height) / 2;
                    x: (parent.width - self.width) / 2;
                }
            }
        }
        }

        if root.catalog.length == 0 && root.loading: Rectangle {
            width: 100%;
            min-height: 180px;

            Spinner {
                width: self.preferred-width;
                height: self.preferred-height;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        if root.catalog.length == 0 && !root.loading: VerticalLayout {
            width: 100%;
            // Inside scrolling content stretches are meaningless — a
            // fixed body keeps the hint visible below the filters.
            min-height: 320px;
            alignment: center;

            Text {
                text: "🔌";
                font-size: 42px;
                horizontal-alignment: center;
            }

            Text {
                text: root.empty_hint;
                font-size: 14px;
                color: #8a8a9a;
                horizontal-alignment: center;
                wrap: word-wrap;
                min-width: 0px;
            }
        }
    }
}

export component DiscoverPage {
    // Custom components placed in a Window are sized by their preferred size;
    // make this page fill the window (its parent).
    preferred-width: 100%;
    preferred-height: 100%;

    in-out property <[MediaCard]> catalog: [];
    in-out property <[MediaCard]> search_results: [];
    in property <[string]> search_history: [];
    in-out property <[string]> addon_names: [];
    in-out property <[string]> type_names: [];
    in-out property <[string]> catalog_names: [];
    in property <[string]> catalog_labels: [];
    in-out property <[string]> genre_names: [];
    in-out property <int> addon_combo_idx: -1;
    in-out property <int> type_combo_idx: -1;
    in-out property <int> catalog_combo_idx: -1;
    in-out property <int> genre_combo_idx: 0;
    in-out property <string> search_text: "";
    in-out property <bool> search_focused: false;
    in property <bool> search_filters_open: false;
    in property <[string]> search_addon_names: [];
    in property <[string]> search_type_names: [];
    in property <[string]> search_catalog_names: [];
    in property <[string]> search_catalog_labels: [];
    in property <[string]> search_genre_names: [];
    in-out property <int> search_addon_combo_idx: 0;
    in-out property <int> search_type_combo_idx: 0;
    in-out property <int> search_catalog_combo_idx: 0;
    in-out property <int> search_genre_combo_idx: 0;
    in property <int> system_back_request: 0;
    property <int> last_system_back_request: -1;
    in-out property <bool> search_results_open: false;
    in property <bool> animate_search_results: true;
    in-out property <bool> search_loading: false;
    in-out property <bool> search_loading_more: false;
    in-out property <bool> search_can_load_more: false;
    in-out property <string> search_empty_hint: @tr("No results for this search.");
    in-out property <bool> searchable: true;
    in-out property <string> empty_hint: @tr("No addons installed yet — add one in Settings → Addons.");
    in-out property <string> searchable_hint: "";

    property <length> item-gap: 18px;
    // Column count derives from a 160px minimum card (phones always get
    // at least 2 columns); the live card width below then stretches to
    // fill the row exactly (capped), so leftover space never pools on
    // the right — and when capped, the grid centers instead.
    property <length> min-card: 160px;
    property <length> max-card: 200px;
    // Floor from Settings → Display (phones fit N across at 160px cards).
    in property <int> min_cols: 2;
    // Left inset reserved by the wide-layout navigation rail (0 on narrow).
    property <length> rail_w: root.narrow ? 0px : NavMetrics.rail-width;
    // The active ScrollView reports its measured width; it already clears
    // page padding, the rail, cutouts and scroll chrome.
    property <length> grid-width: Math.max(1px, root.sv_vw);
    property <int> cols: Math.max(root.min_cols, Math.floor((root.grid-width + root.item-gap) / (root.min-card + root.item-gap)));
    property <length> item-width: Math.max(1px, Math.min(root.max-card, (root.grid-width - (root.cols - 1) * root.item-gap) / root.cols));

    callback addon_picked(string);
    callback type_picked(string);
    callback catalog_picked(string);
    callback genre_picked(string);
    callback search_activated();
    callback search_filter_picked(int, int);
    callback search_edited(string);
    callback search_submitted(string);
    callback search_back_picked();
    callback search_history_cleared();
    callback search_history_item_removed(string);
    callback item_selected(string, int);
    callback home_picked();
    callback discover_picked();
    callback library_picked();
    callback settings_picked();
    callback load_more();
    // Preload fetch window (visible ±2 rows) for poster loading/unloading
    // (Rust fetches it nearest-first and unloads outside a wider window).
    callback visible_range(int, int);

    in-out property <bool> can_load_more: false;
    in-out property <bool> loading_more: false;
    property <[MediaCard]> display_catalog: root.search_results_open ? root.search_results : root.catalog;
    property <bool> display_can_load_more: root.search_results_open ? root.search_can_load_more : root.can_load_more;
    property <bool> display_loading_more: root.search_results_open ? root.search_loading_more : root.loading_more;
    property <bool> display_loading: root.search_results_open && root.search_loading;
    property <string> display_empty_hint: root.search_results_open ? root.search_empty_hint : root.empty_hint;

    // Compact layout for narrow (portrait) windows.
    in property <bool> narrow;
    // Top system-bar inset (Android status bar): Window.safe-area-insets,
    // bound by AppWindow. 0 on desktop/web, so layout there is unchanged.
    in property <length> safe-top: 0px;
    // Side insets: in landscape the display cutout / gesture area moves to
    // the left or right edge, so page content must clear it.
    in property <length> safe-left: 0px;
    in property <length> safe-right: 0px;
    // Bottom system-bar inset (Android gesture/nav bar), for the bottom
    // tab bar. 0 on desktop/web.
    in property <length> safe-bottom: 0px;
    in property <bool> touch_menus: false;

    // ---- 6-button keyboard nav (arrows + Enter + Backspace) ----
    // Zones: 0 page-nav (0 Home, 1 Discover, 2 Library, 3 Settings),
    // 1 addon combo, 2 type/catalog/search row, 3 grid.
    // Left/Right moves within a row (combos cycle options in place);
    // Up/Down moves between zones; Enter activates; Backspace returns to
    // Home. Text entry uses edit mode: Enter on the search
    // field focuses it (physical keyboard types), Enter again submits and
    // exits, focus returns to this scope.
    // Bound to AppWindow (survives page recreation): backing out of an
    // entry returns to the same focused card. kb_edit stays local
    // (transient edit mode).
    in-out property <int> kb_zone: 0;
    in-out property <int> kb_nav: 1;
    in-out property <int> kb_ctl: 0; // 0 type, 1 catalog, 2 genre, 3 search
    in-out property <int> kb_idx: 0;
    // Transient search edit mode, bound through to the mounted header
    // (Enter on the search field focuses it; submit exits).
    in-out property <bool> kb_edit: false;
    // Keyboard modality (bound to AppWindow): rings/markers show only
    // while true — set by any arrow/Enter keypress, cleared by mouse
    // clicks — so mouse-only UI carries no keyboard affordance cost.
    in-out property <bool> kb_active;
    // Browse and search keep distinct offsets so opening Results and backing
    // out does not jump the catalog the user was viewing.
    in-out property <length> scroll_y: 0px;
    in-out property <length> search_scroll_y: 0px;
    property <length> display_scroll_y: root.search_results_open ? root.search_scroll_y : root.scroll_y;
    // Whole-page scroll on Android (filters scroll away with the grid);
    // desktop keeps the filter header pinned and scrolls only the grid.
    // Set once from Rust (target_os-gated).
    in property <bool> scroll_page: false;
    // Live metrics of whichever scroll is mounted (written by its
    // viewport handler; the keyboard follow-up reads only these because
    // page functions cannot touch ids inside the `if`-gated branches).
    property <length> sv_vw: 0px;
    property <length> sv_vh: 0px;
    property <length> sv_vph: 0px;
    property <length> sv_grid_top: 0px;
    property <bool> transition_cover: false;
    property <bool> page_pan_enabled: true;
    function filters_panned() {
        root.page_pan_enabled = false;
        filter_pan_release_t.running = true;
        filter_pan_release_t.restart();
    }
    function filters_pan_released() {
        root.page_pan_enabled = true;
        filter_pan_release_t.stop();
    }
    // Flickable may consume the up/cancel event; let an abandoned axis hint
    // expire instead of leaving the page unable to scroll.
    filter_pan_release_t := Timer {
        interval: 200ms;
        running: false;
        triggered => {
            self.stop();
            root.page_pan_enabled = true;
        }
    }

    function kb_addon_on() -> bool { return root.search_filters_open ? root.search_addon_names.length > 0 : root.addon_names.length > 0; }
    function leave_search() {
        root.kb_edit = false;
        nav_scope.focus();
        root.search_text = "";
        root.search_back_picked();
    }

    function system_back() {
        root.kb_active = true;
        if (root.search_results_open || root.search_filters_open) {
            root.leave_search();
        } else if (root.search_focused) {
            root.kb_edit = false;
            root.search_focused = false;
            nav_scope.focus();
        } else {
            root.home_picked();
        }
    }

    changed system_back_request => {
        if (root.last_system_back_request >= 0
            && root.system_back_request != root.last_system_back_request) {
            root.last_system_back_request = root.system_back_request;
            root.system_back();
        }
    }

    function kb_clamp_idx() {
        if (root.display_catalog.length == 0) {
            root.kb_idx = 0;
        } else if (root.kb_idx >= root.display_catalog.length) {
            root.kb_idx = root.display_catalog.length - 1;
        } else if (root.kb_idx < 0) {
            root.kb_idx = 0;
        }
    }

    function kb_cycle(cur: int, d: int, n: int) -> int {
        if (n <= 0) {
            return cur;
        }
        if (cur < 0) {
            return d > 0 ? 0 : n - 1;
        }
        return Math.max(0, Math.min(n - 1, cur + d));
    }

    // The same keyboard zones operate on the search rail while it is open.
    function kb_cycle_filter(kind: int, d: int) {
        let names = kind == 0 ? (root.search_filters_open ? root.search_addon_names : root.addon_names)
            : kind == 1 ? (root.search_filters_open ? root.search_type_names : root.type_names)
            : kind == 2 ? (root.search_filters_open ? root.search_catalog_names : root.catalog_names)
            : (root.search_filters_open ? root.search_genre_names : root.genre_names);
        let current = kind == 0 ? (root.search_filters_open ? root.search_addon_combo_idx : root.addon_combo_idx)
            : kind == 1 ? (root.search_filters_open ? root.search_type_combo_idx : root.type_combo_idx)
            : kind == 2 ? (root.search_filters_open ? root.search_catalog_combo_idx : root.catalog_combo_idx)
            : (root.search_filters_open ? root.search_genre_combo_idx : root.genre_combo_idx);
        if (names.length == 0 || (kind == 3 && names.length <= 1)) { return; }
        let v = root.kb_cycle(current, d, names.length);
        if (v == current) { return; }
        if (root.search_filters_open) {
            if (kind == 0) { root.search_addon_combo_idx = v; }
            else if (kind == 1) { root.search_type_combo_idx = v; }
            else if (kind == 2) { root.search_catalog_combo_idx = v; }
            else { root.search_genre_combo_idx = v; }
            root.search_filter_picked(kind, v);
        } else {
            if (kind == 0) {
                root.addon_combo_idx = v;
                root.addon_picked(names[v]);
            } else if (kind == 1) {
                root.type_combo_idx = v;
                root.type_picked(names[v]);
            } else if (kind == 2) {
                root.catalog_combo_idx = v;
                root.catalog_picked(names[v]);
            } else {
                root.genre_combo_idx = v;
                root.genre_picked(names[v]);
            }
        }
    }
    function kb_cycle_addon(d: int) { root.kb_cycle_filter(0, d); }
    function kb_cycle_type(d: int) { root.kb_cycle_filter(1, d); }
    function kb_cycle_catalog(d: int) { root.kb_cycle_filter(2, d); }
    function kb_cycle_genre(d: int) { root.kb_cycle_filter(3, d); }

    function kb_up() {
        if (root.kb_zone == 3) {
            if (root.kb_idx >= root.cols) {
                root.kb_idx -= root.cols;
            } else {
                root.kb_zone = 2;
            }
        } else if (root.kb_zone == 2) {
            root.kb_zone = root.kb_addon_on() ? 1 : 0;
        } else if (root.kb_zone == 1) {
            root.kb_zone = 0;
        }
    }

    function kb_down() {
        if (root.kb_zone == 0) {
            root.kb_zone = root.kb_addon_on() ? 1 : 2;
        } else if (root.kb_zone == 1) {
            root.kb_zone = 2;
        } else if (root.kb_zone == 2) {
            if (root.display_catalog.length > 0) {
                root.kb_zone = 3;
                root.kb_clamp_idx();
            }
        } else {
            if (root.kb_idx + root.cols < root.display_catalog.length) {
                root.kb_idx += root.cols;
            } else if (root.display_can_load_more && !root.display_loading_more) {
                root.load_more();
            }
        }
    }

    function kb_left() {
        if (root.kb_zone == 0) {
            root.kb_nav = Math.mod(root.kb_nav + 3, 4);
        } else if (root.kb_zone == 1) {
            root.kb_cycle_addon(-1);
        } else if (root.kb_zone == 2) {
            if (root.kb_ctl == 0) {
                root.kb_cycle_type(-1);
            } else if (root.kb_ctl == 1) {
                root.kb_cycle_catalog(-1);
            } else if (root.kb_ctl == 2) {
                root.kb_cycle_genre(-1);
            } else {
                root.kb_ctl -= 1;
            }
        } else {
            if (root.kb_idx > 0) {
                root.kb_idx -= 1;
            }
        }
    }

    function kb_right() {
        if (root.kb_zone == 0) {
            root.kb_nav = Math.mod(root.kb_nav + 1, 4);
        } else if (root.kb_zone == 1) {
            root.kb_cycle_addon(1);
        } else if (root.kb_zone == 2) {
            if (root.kb_ctl == 0) {
                root.kb_cycle_type(1);
            } else if (root.kb_ctl == 1) {
                root.kb_cycle_catalog(1);
            } else if (root.kb_ctl == 2) {
                root.kb_cycle_genre(1);
            }
        } else {
            if (root.kb_idx + 1 < root.display_catalog.length) {
                root.kb_idx += 1;
            }
        }
    }

    function kb_enter() {
        if (root.kb_zone == 0) {
            if (root.kb_nav == 0) {
                root.home_picked();
            } else if (root.kb_nav == 1) {
                root.discover_picked();
            } else if (root.kb_nav == 2) {
                root.library_picked();
            } else {
                root.settings_picked();
            }
        } else if (root.kb_zone == 1) {
            root.kb_cycle_addon(1);
        } else if (root.kb_zone == 2) {
            if (root.kb_ctl == 0) {
                root.kb_cycle_type(1);
            } else if (root.kb_ctl == 1) {
                root.kb_cycle_catalog(1);
            } else if (root.kb_ctl == 2) {
                root.kb_cycle_genre(1);
            } else if (root.kb_ctl == 3) {
                if (root.searchable) {
                    root.kb_edit = true;
                }
            }
        } else {
            if (root.kb_idx >= 0 && root.kb_idx < root.display_catalog.length) {
                root.item_selected(root.display_catalog[root.kb_idx].id, root.kb_idx);
            }
        }
    }

    // Row stride follows the card height (2:3 poster + 50px footer, see
    // the grid below) plus the item gap, matching the preload math below.
    // It changes with the column count, so it stays a live property.
    property <length> row_stride: root.item-width * 3 / 2 + 50px + root.item-gap;
    // Keep the focused card on screen. Reads the live scroll
    // metrics (sv_*) and steers through scroll_y: each mounted scroll
    // mirrors its viewport into scroll_y and applies scroll_y back via
    // its want_y alias, so this stays branch-agnostic. Skipped before
    // layout (content-height 0) — the one-shot restore timer below
    // retries.
    function kb_follow() {
        if (root.kb_zone != 3 || root.display_catalog.length == 0) {
            return;
        }
        if (root.sv_vph == 0px) {
            return;
        }
        let top = root.sv_grid_top + Math.floor(root.kb_idx / root.cols) * root.row_stride;
        let bot = top + root.row_stride;
        let vy = root.display_scroll_y;
        let vh = root.sv_vh;
        let min_y = Math.min(0px, vh - root.sv_vph);
        if (top < -vy) {
            root.set_display_scroll_y(-top);
        } else if (bot > vh - vy) {
            root.set_display_scroll_y(Math.max(min_y, vh - bot));
        }
    }

    changed kb_idx => { root.kb_follow(); }
    changed kb_zone => { root.kb_follow(); }
    changed catalog => {
        root.kb_clamp_idx();
        root.kb_follow();
    }
    changed search_results => {
        root.kb_clamp_idx();
        root.kb_follow();
    }
    changed search_results_open => {
        root.transition_cover = true;
        if (root.search_results_open) {
            root.search_scroll_y = 0px;
            root.kb_idx = 0;
            root.kb_zone = 2;
            root.kb_ctl = 3;
        }
        root.kb_clamp_idx();
        root.kb_follow();
    }
    transition_t := Timer {
        interval: 100ms;
        running: root.transition_cover;
        triggered => { root.transition_cover = false; }
    }

    function set_display_scroll_y(value: length) {
        if (root.search_results_open) {
            root.search_scroll_y = value;
        } else {
            root.scroll_y = value;
        }
    }

    // Clamp the (restored) scroll offset into the valid range once laid
    // out: content may have shrunk while inside the entry.
    function kb_clamp_view() {
        if (root.sv_vph == 0px) {
            return;
        }
        let min_y = Math.min(0px, root.sv_vh - root.sv_vph);
        root.set_display_scroll_y(Math.max(min_y, Math.min(0px, root.display_scroll_y)));
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: #0f0f12;

    // 6-button scope: covers the page without intercepting the mouse.
    nav_scope := FocusScope {
        width: 100%;
        height: 100%;
        init => {
            self.focus();
            root.last_system_back_request = root.system_back_request;
        }
        key-pressed(e) => {
            if (e.text == Key.UpArrow) {
                root.kb_active = true;
                root.kb_up();
                accept
            } else if (e.text == Key.DownArrow) {
                root.kb_active = true;
                root.kb_down();
                accept
            } else if (e.text == Key.LeftArrow) {
                root.kb_active = true;
                root.kb_left();
                accept
            } else if (e.text == Key.RightArrow) {
                root.kb_active = true;
                root.kb_right();
                accept
            } else if (e.text == Key.Return) {
                root.kb_active = true;
                root.kb_enter();
                accept
            } else if (e.text == Key.Backspace || e.text == Key.Back || e.text == Key.Escape) {
                root.kb_active = true;
                if (root.search_results_open || root.search_filters_open) {
                    root.leave_search();
                } else {
                    root.home_picked();
                }
                accept
            } else {
                reject
            }
        }
    }

    // Desktop: filter header pinned, only the grid scrolls (same tree
    // as before — header + grid region in a padded column).
    if !root.scroll_page: fix_col := VerticalLayout {
        width: 100%;
        height: 100%;
        padding-left: 18px + safe-left + root.rail_w;
        padding-right: 18px + safe-right;
        padding-bottom: 18px;
        padding-top: 18px + safe-top;
        spacing: 12px;

        fix_header := DiscoverHeader {
            width: 100%;
            catalog_names: root.catalog_names;
            catalog_labels: root.catalog_labels;
            genre_names: root.genre_names;
            search_history: root.search_history;
            type_names: root.type_names;
            addon_names: root.addon_names;
            searchable: root.searchable;
            results_open: root.search_results_open;
            addon_combo_idx <=> root.addon_combo_idx;
            type_combo_idx <=> root.type_combo_idx;
            catalog_combo_idx <=> root.catalog_combo_idx;
            genre_combo_idx <=> root.genre_combo_idx;
            search_text <=> root.search_text;
            search_focused <=> root.search_focused;
            search_filters_open: root.search_filters_open;
            search_addon_names: root.search_addon_names;
            search_addon_combo_idx <=> root.search_addon_combo_idx;
            search_type_names: root.search_type_names;
            search_type_combo_idx <=> root.search_type_combo_idx;
            search_catalog_names: root.search_catalog_names;
            search_catalog_combo_idx <=> root.search_catalog_combo_idx;
            search_genre_names: root.search_genre_names;
            search_genre_combo_idx <=> root.search_genre_combo_idx;
            search_catalog_labels: root.search_catalog_labels;
            searchable_hint: root.searchable_hint;
            narrow: root.narrow;
            kb_zone: root.kb_zone;
            kb_nav: root.kb_nav;
            kb_ctl: root.kb_ctl;
            kb_active <=> root.kb_active;
            kb_edit <=> root.kb_edit;

            addon_picked(v) => { root.addon_picked(v); }
            type_picked(v) => { root.type_picked(v); }
            catalog_picked(v) => { root.catalog_picked(v); }
            genre_picked(v) => { root.genre_picked(v); }
            search_activated => { root.search_activated(); }
            search_filter_picked(kind, index) => { root.search_filter_picked(kind, index); }
            search_edited(v) => {
                root.search_scroll_y = 0px;
                root.search_edited(v);
            }
            search_submitted(v) => {
                root.search_scroll_y = 0px;
                root.search_submitted(v);
            }
            back_picked => { root.leave_search(); }
            search_history_cleared => { root.search_history_cleared(); }
            search_history_item_removed(query) => { root.search_history_item_removed(query); }
            search_done => { nav_scope.focus(); }
            filters_panned => { root.filters_panned(); }
            filters_pan_released => { root.filters_pan_released(); }
        }

        Rectangle {
            vertical-stretch: 1;
            clip: true;

            grid_scroll := ScrollView {
                width: 100%;
                height: 100%;
                changed visible-width => { root.sv_vw = self.visible-width; }
                changed visible-height => { root.sv_vh = self.visible-height; }
                changed content-height => { root.sv_vph = self.content-height; }
                // Touch devices scroll by dragging (there is no wheel):
                // the fluent-style ScrollView disables drag-pan by
                // default, so opt in explicitly.
                mouse-drag-pan-enabled: true;
                // This viewport survives the browse/results header switch.
                // Move it to the newly active model's stored offset so the
                // two views keep independent scroll positions.
                property <bool> results_mode: root.search_results_open;
                changed results_mode => {
                    self.content-y = root.display_scroll_y;
                }
                // One-way mirror (NOT a two-way binding): Flickable
                // removes viewport bindings on the first press/drag, which
                // silently froze scroll_y at 0 on touch devices. The init
                // restores the persisted offset on page (re)creation; the
                // changed handler keeps it truthful afterwards.
                property <length> want_y: root.display_scroll_y;
                property <length> mirrored_y: 0px;
                changed want_y => {
                    // Keyboard/backend writes need to reach this gated
                    // viewport. Ignore echoes of native scrolling so reading
                    // the next inertia frame cannot cancel the animation.
                    if (self.want_y != self.mirrored_y) {
                        self.mirrored_y = self.want_y;
                        self.content-y = self.want_y;
                    }
                }
                init => {
                    root.sv_vw = self.visible-width;
                    root.sv_vh = self.visible-height;
                    root.sv_vph = self.content-height;
                    self.content-y = root.display_scroll_y;
                    self.mirrored_y = self.content-y;
                }
                // Initial child/model bindings can settle after init without
                // a geometry change notification. Sample the mounted viewport
                // before restoring keyboard focus, including on scroll-mode
                // swaps where the page itself is retained.
                grid_restore_t := Timer {
                    interval: 120ms;
                    running: true;
                    triggered => {
                        root.sv_vw = grid_scroll.visible-width;
                        root.sv_vh = grid_scroll.visible-height;
                        root.sv_vph = grid_scroll.content-height;
                        root.sv_grid_top = 8px;
                        root.kb_clamp_idx();
                        root.kb_clamp_view();
                        root.kb_follow();
                        self.running = false;
                    }
                }
                // Preload + unload reporting (Bridge::visible_range): row
                // stride follows the card height (see row_stride); the
                // reported window already preloads ±2 rows above/below
                // the viewport. Rust
                // fetches that window nearest-first on a high-priority lane
                // and only unloads outside a wider keep window, so preloaded
                // rows survive jitter. Report only when the window moved by
                // >48 cards to avoid fetch churn.
                property <int> reported_first: -1000000;
                changed content-y => {
                    self.mirrored_y = self.content-y;
                    root.set_display_scroll_y(self.content-y);
                    // Live metrics for the keyboard follow-up (page-level
                    // functions cannot read this gated scroll directly).
                    root.sv_vh = self.visible-height;
                    root.sv_vph = self.content-height;
                    root.sv_grid_top = 8px;
                    // Near-bottom guard: content-y runs 0 (top) down to
                    // visible-height - content-height (bottom, negative), so
                    // remaining content below the viewport is
                    // content-height + content-y - visible-height. Fetch
                    // the next page only once that drops to 600px.
                    if (root.display_catalog.length > 0 && root.display_can_load_more && !root.display_loading_more
                        && self.content-y <= self.visible-height - self.content-height + 600px) {
                        root.load_more();
                    }
                    if (root.display_catalog.length > 0) {
                        // Only the hover inset precedes this grid; the
                        // whole-page branch also has its header above it.
                        let first_row = Math.max(0, Math.floor((-self.content-y - 8px) / root.row_stride));
                        let vis_rows = Math.ceil(self.visible-height / root.row_stride);
                        let first_idx = Math.max(0, (first_row - 2) * root.cols);
                        let last_idx = Math.min(root.display_catalog.length - 1, (first_row + vis_rows + 2) * root.cols - 1);
                        if (self.reported_first < -100000) {
                            // First report: just sync, initial fetches are
                            // already in flight.
                            self.reported_first = first_idx;
                        } else if (Math.abs(first_idx - self.reported_first) > 48) {
                            self.reported_first = first_idx;
                            root.visible_range(first_idx, last_idx);
                        }
                    }
                }

                fix_grid_wrap := VerticalLayout {
                    // Direct layout child (not the component): Flickable
                    // derives content-height only from direct *layout*
                    // children — a bare component child is ignored, the
                    // viewport collapses to the visible height and wheel /
                    // drag scrolling silently stops. (Library/Settings keep
                    // a layout directly inside their ScrollViews.)
                    width: 100%;

                fix_grid := DiscoverGrid {
                    width: 100%;
                    catalog: root.display_catalog;
                    cols: root.cols;
                    item-width: root.item-width;
                    item-gap: root.item-gap;
                    kb_active <=> root.kb_active;
                    kb_zone <=> root.kb_zone;
                    kb_idx <=> root.kb_idx;
                    loading_more: root.display_loading_more;
                    loading: root.display_loading;
                    empty_hint: root.display_empty_hint;
                    stagger: root.search_results_open && root.animate_search_results && Anim.enabled && Anim.transitions;
                    touch_menus: root.touch_menus;
                    init => { root.sv_grid_top = 8px; }
                    item_selected(id, i) => { root.item_selected(id, i); }
                }
                }
            }
        }

        // Bottom tab bar (narrow only): desktop/wide navigate up top.
        // In-flow sibling of the grid region (same as Home/Library/
        // Settings) so the grid shrinks above it instead of sliding
        // underneath.
        if root.narrow: bottom_fix := BottomNav {
            active: 1;
            safe-bottom: root.safe-bottom;
            safe-left: root.safe-left;
            safe-right: root.safe-right;
            page-inset-left: 18px + root.safe-left;
            page-inset-right: 18px + root.safe-right;
            kb_zone: root.kb_zone;
            kb_nav: root.kb_nav;
            kb_active <=> root.kb_active;

            home_picked => { root.home_picked(); }
            discover_picked => { root.discover_picked(); }
            library_picked => { root.library_picked(); }
            settings_picked => { root.settings_picked(); }
        }
    }

    // Android (`scroll_page`): filters and grid scroll as one column, so
    // drags starting on the filter rows scroll the page too. Same
    // components, same mirrors — only the scroll parent differs. The
    // column mirrors the desktop branch (and Home/Library/Settings):
    // padded page, stretching scroll region, in-flow bottom tab bar.
    // The bar is a layout sibling of the scroll region — never an
    // absolutely-positioned overlay (`y: parent.height - self.height`,
    // which re-resolves against the window on every resize/scroll
    // metric change) — so it stays pinned while the page scrolls.
    if root.scroll_page: and_col := VerticalLayout {
        width: 100%;
        height: 100%;
        padding-left: 18px + safe-left + root.rail_w;
        padding-right: 18px + safe-right;
        padding-bottom: 18px;
        padding-top: 18px + safe-top;
        spacing: 12px;

        Rectangle {
            vertical-stretch: 1;
            clip: true;

        page_scroll := ScrollView {
            width: 100%;
            height: 100%;
            changed visible-width => { root.sv_vw = self.visible-width; }
            changed visible-height => { root.sv_vh = self.visible-height; }
            changed content-height => { root.sv_vph = self.content-height; }
        // Touch devices scroll by dragging (there is no wheel):
        // the fluent-style ScrollView disables drag-pan by default,
        // so opt in explicitly.
        mouse-drag-pan-enabled: root.page_pan_enabled;
        property <bool> results_mode: root.search_results_open;
        changed results_mode => {
            self.content-y = root.display_scroll_y;
        }
        // One-way mirror, same pattern as the desktop grid scroll above.
        property <length> want_y: root.display_scroll_y;
        property <length> mirrored_y: 0px;
        changed want_y => {
            if (self.want_y != self.mirrored_y) {
                self.mirrored_y = self.want_y;
                self.content-y = self.want_y;
            }
        }
        init => {
            root.sv_vw = self.visible-width;
            root.sv_vh = self.visible-height;
            root.sv_vph = self.content-height;
            self.content-y = root.display_scroll_y;
            self.mirrored_y = self.content-y;
        }
        // Same post-layout sampling as the pinned-grid branch above.
        page_restore_t := Timer {
            interval: 120ms;
            running: true;
            triggered => {
                root.sv_vw = page_scroll.visible-width;
                root.sv_vh = page_scroll.visible-height;
                root.sv_vph = page_scroll.content-height;
                root.sv_grid_top = and_grid.y + 8px;
                root.kb_clamp_idx();
                root.kb_clamp_view();
                root.kb_follow();
                self.running = false;
            }
        }
        // Preload + unload reporting (Bridge::visible_range): same
        // row_stride as above, but the grid starts below the filter
        // header, so its top edge offsets the row math.
        property <int> reported_first: -1000000;
        changed content-y => {
            self.mirrored_y = self.content-y;
            root.set_display_scroll_y(self.content-y);
            // Live metrics for the keyboard follow-up (page-level
            // functions cannot read this gated scroll directly).
            root.sv_vh = self.visible-height;
            root.sv_vph = self.content-height;
            // The grid mirrors its actual origin, including the header gap.
            // Near-bottom guard (same as the desktop grid scroll above):
            // content-y is 0 at the top and
            // visible-height - content-height at the bottom.
            if (root.display_catalog.length > 0 && root.display_can_load_more && !root.display_loading_more
                && self.content-y <= self.visible-height - self.content-height + 600px) {
                root.load_more();
            }
            if (root.display_catalog.length > 0) {
                let grid_off = Math.max(0px, -self.content-y - root.sv_grid_top);
                let first_row = Math.floor(grid_off / root.row_stride);
                let vis_rows = Math.ceil(self.visible-height / root.row_stride);
                let first_idx = Math.max(0, (first_row - 2) * root.cols);
                let last_idx = Math.min(root.display_catalog.length - 1, (first_row + vis_rows + 2) * root.cols - 1);
                if (self.reported_first < -100000) {
                    // First report: just sync, initial fetches are
                    // already in flight.
                    self.reported_first = first_idx;
                } else if (Math.abs(first_idx - self.reported_first) > 48) {
                    self.reported_first = first_idx;
                    root.visible_range(first_idx, last_idx);
                }
            }
        }

        VerticalLayout {
            width: 100%;
            spacing: 12px;

            and_header := DiscoverHeader {
                width: 100%;
                catalog_names: root.catalog_names;
                catalog_labels: root.catalog_labels;
                genre_names: root.genre_names;
                search_history: root.search_history;
                type_names: root.type_names;
                addon_names: root.addon_names;
                searchable: root.searchable;
                results_open: root.search_results_open;
                addon_combo_idx <=> root.addon_combo_idx;
                type_combo_idx <=> root.type_combo_idx;
                catalog_combo_idx <=> root.catalog_combo_idx;
                genre_combo_idx <=> root.genre_combo_idx;
                search_text <=> root.search_text;
                search_focused <=> root.search_focused;
                search_filters_open: root.search_filters_open;
                search_addon_names: root.search_addon_names;
                search_addon_combo_idx <=> root.search_addon_combo_idx;
                search_type_names: root.search_type_names;
                search_type_combo_idx <=> root.search_type_combo_idx;
                search_catalog_names: root.search_catalog_names;
                search_catalog_combo_idx <=> root.search_catalog_combo_idx;
                search_genre_names: root.search_genre_names;
                search_genre_combo_idx <=> root.search_genre_combo_idx;
                search_catalog_labels: root.search_catalog_labels;
                searchable_hint: root.searchable_hint;
                narrow: root.narrow;
                kb_zone: root.kb_zone;
                kb_nav: root.kb_nav;
                kb_ctl: root.kb_ctl;
                kb_active <=> root.kb_active;
                kb_edit <=> root.kb_edit;

                addon_picked(v) => { root.addon_picked(v); }
                type_picked(v) => { root.type_picked(v); }
                catalog_picked(v) => { root.catalog_picked(v); }
                genre_picked(v) => { root.genre_picked(v); }
                search_activated => { root.search_activated(); }
                search_filter_picked(kind, index) => { root.search_filter_picked(kind, index); }
                search_edited(v) => {
                    root.search_scroll_y = 0px;
                    root.search_edited(v);
                }
                search_submitted(v) => {
                    root.search_scroll_y = 0px;
                    root.search_submitted(v);
                }
                back_picked => { root.leave_search(); }
                search_history_cleared => { root.search_history_cleared(); }
                search_history_item_removed(query) => { root.search_history_item_removed(query); }
                search_done => { nav_scope.focus(); }
                filters_panned => { root.filters_panned(); }
                filters_pan_released => { root.filters_pan_released(); }
            }

            and_grid := DiscoverGrid {
                width: 100%;
                catalog: root.display_catalog;
                cols: root.cols;
                item-width: root.item-width;
                item-gap: root.item-gap;
                kb_active <=> root.kb_active;
                kb_zone <=> root.kb_zone;
                kb_idx <=> root.kb_idx;
                loading_more: root.display_loading_more;
                loading: root.display_loading;
                empty_hint: root.display_empty_hint;
                stagger: root.search_results_open && root.animate_search_results && Anim.enabled && Anim.transitions;
                touch_menus: root.touch_menus;
                changed y => { root.sv_grid_top = self.y + 8px; }
                item_selected(id, i) => { root.item_selected(id, i); }
            }
        }
        }
        }

    // Bottom tab bar (narrow only): desktop/wide navigate up top.
    // In-flow sibling of the scroll region (same as Home/Library/
    // Settings and the desktop branch above) so it never moves with
    // the scroll content or window-metric changes.
    if root.narrow: bottom_scroll := BottomNav {
        active: 1;
        safe-bottom: root.safe-bottom;
        safe-left: root.safe-left;
        safe-right: root.safe-right;
        page-inset-left: 18px + root.safe-left;
        page-inset-right: 18px + root.safe-right;
        kb_zone: root.kb_zone;
        kb_nav: root.kb_nav;
        kb_active <=> root.kb_active;

        home_picked => { root.home_picked(); }
        discover_picked => { root.discover_picked(); }
        library_picked => { root.library_picked(); }
        settings_picked => { root.settings_picked(); }
    }
    }

    // Left navigation rail (wide layouts only; narrow uses the bottom bar).
    // Declared after the page columns so it paints over the strip its own
    // footprint reserves — both columns widen their left padding by `rail_w`,
    // so no page content lands under it.
    if !root.narrow: rail := SideNav {
        active: 1;
        safe-top: root.safe-top;
        safe-left: root.safe-left;
        safe-bottom: root.safe-bottom;
        kb_zone: root.kb_zone;
        kb_nav: root.kb_nav;
        kb_active <=> root.kb_active;

        home_picked => { root.home_picked(); }
        discover_picked => { root.discover_picked(); }
        library_picked => { root.library_picked(); }
        settings_picked => { root.settings_picked(); }
    }

    // Fade-through gives the switch between browse and results a brief,
    // low-key transition without moving the scrollable card grid.
    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000;
        opacity: root.transition_cover ? 0.16 : 0.0;
        animate opacity { duration: Anim.transition_fade; easing: ease-in-out; }
    }
    }
}
