import { ScrollView, Button, Spinner } from "std-widgets.slint";
import { MediaCard } from "types.slint";
import { KbMark } from "kbnav.slint";
import { SideNav, NavMetrics } from "sidenav.slint";
import { BottomNav } from "bottomnav.slint";
import { Dropdown } from "dropdown.slint";
import { SearchField } from "searchfield.slint";
import { Anim } from "anim.slint";

// Filter header (nav buttons, title, addon/type/catalog/search pickers).
// Instantiated twice by DiscoverPage — once pinned above the grid
// (desktop) and once scrolling with the page (Android, `scroll_page`)
// — so it owns no page state: everything is forwarded properties, and
// the search-field refocus escapes through `search_done` (the page's
// FocusScope id is not visible from inside this component).
component DiscoverHeader {
    in property <[string]> addon_names;
    in property <[string]> type_names;
    in property <[string]> catalog_names;
    in-out property <int> addon_combo_idx: -1;
    in-out property <int> type_combo_idx: -1;
    in-out property <int> catalog_combo_idx: -1;
    in-out property <string> search_text;
    in property <string> searchable_hint;
    // False when the chosen catalog declares no search extra: the search
    // field + button go non-inputable instead of silently re-fetching.
    in property <bool> searchable: true;
    in property <int> count;
    in property <bool> narrow;
    in property <int> kb_zone;
    in property <int> kb_nav;
    in property <int> kb_ctl;
    in-out property <bool> kb_active;
    // Transient search edit mode (physical-keyboard flow), bound
    // through from the page so Enter-to-edit works in both layouts.
    in-out property <bool> kb_edit: false;

    callback addon_picked(string);
    callback type_picked(string);
    callback catalog_picked(string);
    callback search_submitted(string);
    callback search_done();

    VerticalLayout {
        width: 100%;
        spacing: 12px;

        // ---- Title + count: own line(s) so the header never
        // overflows on narrow windows --------------------------------
        // Pinned like every other header row: an unpinned row absorbs
        // free vertical space (it measured 421px tall on desktop),
        // leaving big blanks above/below the count.
        HorizontalLayout {
            vertical-stretch: 0;
            height: 36px;
            spacing: 8px;
            alignment: start;

            Text {
                text: @tr("Discover");
                font-size: 26px;
                font-weight: 700;
                color: #ffffff;
            }

            Text {
                text: @tr("({n} item)" | "({n} items)" % root.count);
                font-size: 15px;
                color: #6c6c7d;
                vertical-alignment: center;
            }
        }

        // ---- Addon filter -------------------------------------------
        // Installing / enabling / removing addons lives in Settings →
        // Addons; this row only picks which installed addon to browse.
        HorizontalLayout {
            vertical-stretch: 0;
            visible: root.addon_names.length > 0;
            spacing: 8px;
            // Explicit height: the row must stay at control height and
            // never absorb free vertical space (see Settings rows).
            height: root.narrow ? 44px : 32px;

            Text {
                text: @tr("Addon");
                font-size: 12px;
                color: #6c6c7d;
                vertical-alignment: center;
            }

            KbMark { on: root.kb_zone == 1; active: root.kb_active; }
            addon_combo := Dropdown {
                roomy: root.narrow;
                model: root.addon_names;
                current-index <=> root.addon_combo_idx;
                selected(v) => { root.addon_picked(v); }
                min-width: root.narrow ? 0px : 200px;
                horizontal-stretch: 1;
                max-width: 420px;
            }

            // Absorbs leftover width past the combo's max-width so the
            // label/combo stay left-packed instead of the label's box
            // growing and pushing the combo to the far right.
            Rectangle { horizontal-stretch: 1; }
        }

        // ---- Catalog pickers ----------------------------------------
        // Wide: single row. Narrow: search full-width on top, combos below
        // (duplicated ids — `if` hides ids from page functions, so the
        // keyboard focus branches on `narrow`, same as Settings).
        if !root.narrow: HorizontalLayout {
            vertical-stretch: 0;
            spacing: 8px;
            // Wide controls are naturally 32px tall — pin the row so it
            // can never stretch into the grid's space.
            height: 32px;

            Text {
                text: @tr("Type");
                font-size: 12px;
                color: #6c6c7d;
                vertical-alignment: center;
            }

            KbMark { on: root.kb_zone == 2 && root.kb_ctl == 0; active: root.kb_active; }
            type_combo := Dropdown {
                roomy: root.narrow;
                model: root.type_names;
                current-index <=> root.type_combo_idx;
                selected(v) => { root.type_picked(v); }
                min-width: 110px;
            }

            Text {
                text: @tr("Catalog");
                font-size: 12px;
                color: #6c6c7d;
                vertical-alignment: center;
            }

            KbMark { on: root.kb_zone == 2 && root.kb_ctl == 1; active: root.kb_active; }
            catalog_combo := Dropdown {
                roomy: root.narrow;
                model: root.catalog_names;
                current-index <=> root.catalog_combo_idx;
                selected(v) => { root.catalog_picked(v); }
                min-width: 200px;
                horizontal-stretch: 1;
            }

            KbMark { on: root.kb_zone == 2 && root.kb_ctl == 2; active: root.kb_active; }
            search_line := SearchField {
                roomy: root.narrow;
                enabled: root.searchable;
                text <=> root.search_text;
                placeholder-text: root.searchable_hint;
                accepted(t) => {
                    root.kb_edit = false;
                    root.search_done();
                    root.search_submitted(t);
                }
                horizontal-stretch: 2;
            }

            // Focuses the field on demand: page scope cannot see ids
            // inside `if`, but this timer (inside the branch) can.
            edit_t := Timer {
                interval: 80ms;
                running: root.kb_edit && !root.narrow;
                triggered => { search_line.focus(); }
            }

            KbMark { on: root.kb_zone == 2 && root.kb_ctl == 3; active: root.kb_active; }
            search_button := Button {
                text: @tr("Search");
                enabled: root.searchable;
                min-height: root.narrow ? 44px : 0px;
                clicked => { root.kb_active = false; root.search_submitted(search_line.full-text); }
            }
        }

        if root.narrow: VerticalLayout {
            vertical-stretch: 0;
            spacing: 8px;

            // Constrained to the page width: without width: 100% the
            // LineEdit sizes to its preferred width and pushes the Search
            // button off-screen on portrait phones.
            HorizontalLayout {
                width: 100%;
                vertical-stretch: 0;
                spacing: 8px;
                // Narrow controls use 44px touch targets — pin the row.
                height: 44px;

                KbMark { on: root.kb_zone == 2 && root.kb_ctl == 2; active: root.kb_active; }
                search_line_narrow := SearchField {
                    roomy: true;
                    enabled: root.searchable;
                    text <=> root.search_text;
                    placeholder-text: root.searchable_hint;
                    accepted(t) => {
                        root.kb_edit = false;
                        root.search_done();
                        root.search_submitted(t);
                    }
                    horizontal-stretch: 1;
                }

                edit_tn := Timer {
                    interval: 80ms;
                    running: root.kb_edit && root.narrow;
                    triggered => { search_line_narrow.focus(); }
                }

                KbMark { on: root.kb_zone == 2 && root.kb_ctl == 3; active: root.kb_active; }
                search_button_narrow := Button {
                    text: @tr("Search");
                    enabled: root.searchable;
                    min-height: 44px;
                    clicked => { root.kb_active = false; root.search_submitted(search_line_narrow.full-text); }
                }
            }

            // Narrow: one picker per row, full-width. Side-by-side
            // combos size to their preferred widths and push each other
            // off-screen on portrait phones (same overflow class as the
            // search row had); stacked rows give each picker room.
            HorizontalLayout {
                width: 100%;
                vertical-stretch: 0;
                spacing: 8px;
                height: 44px;

                Text {
                    text: @tr("Type");
                    width: 60px;
                    font-size: 12px;
                    color: #6c6c7d;
                    vertical-alignment: center;
                }

                KbMark { on: root.kb_zone == 2 && root.kb_ctl == 0; active: root.kb_active; }
                type_combo_narrow := Dropdown {
                    roomy: true;
                    model: root.type_names;
                    current-index <=> root.type_combo_idx;
                    selected(v) => { root.type_picked(v); }
                    min-width: 0px;
                    horizontal-stretch: 1;
                }
            }

            HorizontalLayout {
                width: 100%;
                vertical-stretch: 0;
                spacing: 8px;
                height: 44px;

                Text {
                    text: @tr("Catalog");
                    width: 60px;
                    font-size: 12px;
                    color: #6c6c7d;
                    vertical-alignment: center;
                }

                KbMark { on: root.kb_zone == 2 && root.kb_ctl == 1; active: root.kb_active; }
                catalog_combo_narrow := Dropdown {
                    roomy: true;
                    model: root.catalog_names;
                    current-index <=> root.catalog_combo_idx;
                    selected(v) => { root.catalog_picked(v); }
                    min-width: 0px;
                    horizontal-stretch: 1;
                }
            }
        }

        Rectangle { height: 1px; background: #23232b; }
    }
}

// Card grid (posters + loading spinner + empty state). Shared by both
// page structures — the grid always fills its own height, only its
// parent scroll differs (grid-local on desktop, whole-page on Android).
component DiscoverGrid {
    in property <[MediaCard]> catalog;
    in property <int> cols: 1;
    in property <length> item-width;
    in property <length> item-gap;
    in-out property <bool> kb_active;
    in-out property <int> kb_zone;
    in-out property <int> kb_idx;
    in property <bool> loading_more;
    in property <string> empty_hint;

    callback item_selected(string, int);

    VerticalLayout {
        width: 100%;

        // Centered: when cards hit max-card the grid is narrower than the
        // viewport and centers; when fluid it spans the full width and
        // the centering is a no-op.
        HorizontalLayout {
            alignment: center;

        grid_box := GridLayout {
            // Exact content width so centering above has an effect.
            width: root.cols * (root.item-width + root.item-gap) - root.item-gap;
            spacing: root.item-gap;

            for card[i] in root.catalog: Rectangle {
                row: Math.floor(i / root.cols);
                col: Math.mod(i, root.cols);

                width: root.item-width;
                // Poster keeps a true 2:3 ratio at any column count, so
                // narrow (e.g. 3-across phone) cards shrink in height too
                // instead of stretching tall. +50px title/year footer.
                height: root.item-width * 3 / 2 + 50px;

                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: #18181c;
                    border-radius: 10px;
                    border-width: root.kb_active && root.kb_zone == 3 && root.kb_idx == i ? 2px : 0px;
                    border-color: #8b5cf6;

                    y: touch.has-hover ? -6px : 0px;
                    animate y { duration: Anim.hover_lift; easing: ease-in-out; }

                    VerticalLayout {
                        spacing: 0px;

                        Rectangle {
                            height: root.item-width * 3 / 2;
                            border-radius: 10px;
                            clip: true;
                            background: #222228;

                            if card.is_loaded: Image {
                                source: card.poster;
                                image-fit: cover;
                                width: 100%;
                                height: 100%;
                            }

                            if !card.is_loaded: Text {
                                text: "🎬";
                                font-size: 34px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 6px;
                            spacing: 2px;

                            Text {
                                text: card.title;
                                color: #eeeeee;
                                font-size: 13px;
                                font-weight: 600;
                                overflow: elide;
                            }

                            Text {
                                text: card.year;
                                color: #7a7a8c;
                                font-size: 11px;
                            }
                        }
                    }
                }

                touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.kb_active = false;
                        root.kb_zone = 3;
                        root.kb_idx = i;
                        root.item_selected(card.id, i);
                    }
                }
            }

            if root.loading_more: Rectangle {
                row: Math.floor(root.catalog.length / root.cols) + 1;
                col: 0;
                colspan: root.cols;
                height: 48px;

                Spinner {
                    width: self.preferred-width;
                    height: self.preferred-height;
                    y: (parent.height - self.height) / 2;
                    x: (parent.width - self.width) / 2;
                }
            }
        }
        }

        if root.catalog.length == 0: VerticalLayout {
            width: 100%;
            // Inside scrolling content stretches are meaningless — a
            // fixed body keeps the hint visible below the filters.
            min-height: 320px;
            alignment: center;

            Text {
                text: "🔌";
                font-size: 42px;
                horizontal-alignment: center;
            }

            Text {
                text: root.empty_hint;
                font-size: 14px;
                color: #8a8a9a;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

export component DiscoverPage {
    // Custom components placed in a Window are sized by their preferred size;
    // make this page fill the window (its parent).
    preferred-width: 100%;
    preferred-height: 100%;

    in-out property <[MediaCard]> catalog: [];
    in-out property <[string]> addon_names: [];
    in-out property <[string]> type_names: [];
    in-out property <[string]> catalog_names: [];
    in-out property <int> addon_combo_idx: -1;
    in-out property <int> type_combo_idx: -1;
    in-out property <int> catalog_combo_idx: -1;
    in-out property <string> search_text: "";
    in-out property <bool> searchable: true;
    in-out property <string> empty_hint: @tr("No addons installed yet — add one in Settings → Addons.");
    in-out property <string> searchable_hint: "";

    property <length> item-gap: 18px;
    // Column count derives from a 160px minimum card (phones always get
    // at least 2 columns); the live card width below then stretches to
    // fill the row exactly (capped), so leftover space never pools on
    // the right — and when capped, the grid centers instead.
    property <length> min-card: 160px;
    property <length> max-card: 200px;
    // Floor from Settings → Display (phones fit N across at 160px cards).
    in property <int> min_cols: 2;
    // Left inset reserved by the wide-layout navigation rail (0 on narrow).
    property <length> rail_w: root.narrow ? 0px : NavMetrics.rail-width;
    // The 36px below is the page's own 2 × 18px padding; `rail_w` is the
    // column the rail takes out of that width.
    property <int> cols: Math.max(root.min_cols, Math.floor((self.width - 36px - root.rail_w + root.item-gap) / (root.min-card + root.item-gap)));
    property <length> item-width: Math.min(root.max-card, (self.width - 36px - root.rail_w - (root.cols - 1) * root.item-gap) / root.cols);

    callback addon_picked(string);
    callback type_picked(string);
    callback catalog_picked(string);
    callback search_submitted(string);
    callback item_selected(string, int);
    callback home_picked();
    callback discover_picked();
    callback library_picked();
    callback settings_picked();
    callback load_more();
    // Preload fetch window (visible ±2 rows) for poster loading/unloading
    // (Rust fetches it nearest-first and unloads outside a wider window).
    callback visible_range(int, int);

    in-out property <bool> can_load_more: false;
    in-out property <bool> loading_more: false;

    // Compact layout for narrow (portrait) windows.
    in property <bool> narrow;
    // Top system-bar inset (Android status bar): Window.safe-area-insets,
    // bound by AppWindow. 0 on desktop/web, so layout there is unchanged.
    in property <length> safe-top: 0px;
    // Side insets: in landscape the display cutout / gesture area moves to
    // the left or right edge, so page content must clear it.
    in property <length> safe-left: 0px;
    in property <length> safe-right: 0px;
    // Bottom system-bar inset (Android gesture/nav bar), for the bottom
    // tab bar. 0 on desktop/web.
    in property <length> safe-bottom: 0px;

    // ---- 6-button keyboard nav (arrows + Enter + Backspace) ----
    // Zones: 0 page-nav (0 Home, 1 Discover, 2 Library, 3 Settings),
    // 1 addon combo, 2 type/catalog/search row, 3 grid.
    // Left/Right moves within a row (combos cycle options in place);
    // Up/Down moves between zones; Enter activates; Backspace returns to
    // Home. Text entry uses edit mode: Enter on the search
    // field focuses it (physical keyboard types), Enter again submits and
    // exits, focus returns to this scope.
    // Bound to AppWindow (survives page recreation): backing out of an
    // entry returns to the same focused card. kb_edit stays local
    // (transient edit mode).
    in-out property <int> kb_zone: 0;
    in-out property <int> kb_nav: 1;
    in-out property <int> kb_ctl: 0; // 0 type, 1 catalog, 2 search, 3 button
    in-out property <int> kb_idx: 0;
    // Transient search edit mode, bound through to the mounted header
    // (Enter on the search field focuses it; submit exits).
    in-out property <bool> kb_edit: false;
    // Keyboard modality (bound to AppWindow): rings/markers show only
    // while true — set by any arrow/Enter keypress, cleared by mouse
    // clicks — so mouse-only UI carries no keyboard affordance cost.
    in-out property <bool> kb_active;
    // Exact scroll offset (bound to AppWindow): the grid viewport syncs
    // here continuously and restores absolutely on return.
    in-out property <length> scroll_y: 0px;
    // Whole-page scroll on Android (filters scroll away with the grid);
    // desktop keeps the filter header pinned and scrolls only the grid.
    // Set once from Rust (target_os-gated).
    in property <bool> scroll_page: false;
    // Live metrics of whichever scroll is mounted (written by its
    // viewport handler; the keyboard follow-up reads only these because
    // page functions cannot touch ids inside the `if`-gated branches).
    property <length> sv_vh: 0px;
    property <length> sv_vph: 0px;
    property <length> sv_grid_top: 0px;

    function kb_addon_on() -> bool { return root.addon_names.length > 0; }

    function kb_clamp_idx() {
        if (root.catalog.length == 0) {
            root.kb_idx = 0;
        } else if (root.kb_idx >= root.catalog.length) {
            root.kb_idx = root.catalog.length - 1;
        } else if (root.kb_idx < 0) {
            root.kb_idx = 0;
        }
    }

    function kb_cycle(cur: int, d: int, n: int) -> int {
        if (n <= 0) {
            return cur;
        }
        if (cur < 0) {
            return d > 0 ? 0 : n - 1;
        }
        return Math.max(0, Math.min(n - 1, cur + d));
    }

    function kb_cycle_addon(d: int) {
        let n = root.addon_names.length;
        if (n == 0) {
            return;
        }
        let v = root.kb_cycle(root.addon_combo_idx, d, n);
        if (v != root.addon_combo_idx) {
            root.addon_combo_idx = v;
            root.addon_picked(root.addon_names[v]);
        }
    }

    function kb_cycle_type(d: int) {
        let n = root.type_names.length;
        if (n == 0) {
            return;
        }
        let v = root.kb_cycle(root.type_combo_idx, d, n);
        if (v != root.type_combo_idx) {
            root.type_combo_idx = v;
            root.type_picked(root.type_names[v]);
        }
    }

    function kb_cycle_catalog(d: int) {
        let n = root.catalog_names.length;
        if (n == 0) {
            return;
        }
        let v = root.kb_cycle(root.catalog_combo_idx, d, n);
        if (v != root.catalog_combo_idx) {
            root.catalog_combo_idx = v;
            root.catalog_picked(root.catalog_names[v]);
        }
    }

    function kb_up() {
        if (root.kb_zone == 3) {
            if (root.kb_idx >= root.cols) {
                root.kb_idx -= root.cols;
            } else {
                root.kb_zone = 2;
            }
        } else if (root.kb_zone == 2) {
            root.kb_zone = root.kb_addon_on() ? 1 : 0;
        } else if (root.kb_zone == 1) {
            root.kb_zone = 0;
        }
    }

    function kb_down() {
        if (root.kb_zone == 0) {
            root.kb_zone = root.kb_addon_on() ? 1 : 2;
        } else if (root.kb_zone == 1) {
            root.kb_zone = 2;
        } else if (root.kb_zone == 2) {
            if (root.catalog.length > 0) {
                root.kb_zone = 3;
                root.kb_clamp_idx();
            }
        } else {
            if (root.kb_idx + root.cols < root.catalog.length) {
                root.kb_idx += root.cols;
            } else if (root.can_load_more && !root.loading_more) {
                root.load_more();
            }
        }
    }

    function kb_left() {
        if (root.kb_zone == 0) {
            root.kb_nav = Math.mod(root.kb_nav + 3, 4);
        } else if (root.kb_zone == 1) {
            root.kb_cycle_addon(-1);
        } else if (root.kb_zone == 2) {
            if (root.kb_ctl == 0) {
                root.kb_cycle_type(-1);
            } else if (root.kb_ctl == 1) {
                root.kb_cycle_catalog(-1);
            } else {
                root.kb_ctl -= 1;
            }
        } else {
            if (root.kb_idx > 0) {
                root.kb_idx -= 1;
            }
        }
    }

    function kb_right() {
        if (root.kb_zone == 0) {
            root.kb_nav = Math.mod(root.kb_nav + 1, 4);
        } else if (root.kb_zone == 1) {
            root.kb_cycle_addon(1);
        } else if (root.kb_zone == 2) {
            if (root.kb_ctl == 0) {
                root.kb_cycle_type(1);
            } else if (root.kb_ctl == 1) {
                root.kb_cycle_catalog(1);
            } else if (root.kb_ctl == 2) {
                root.kb_ctl = 3;
            }
        } else {
            if (root.kb_idx + 1 < root.catalog.length) {
                root.kb_idx += 1;
            }
        }
    }

    function kb_enter() {
        if (root.kb_zone == 0) {
            if (root.kb_nav == 0) {
                root.home_picked();
            } else if (root.kb_nav == 1) {
                root.discover_picked();
            } else if (root.kb_nav == 2) {
                root.library_picked();
            } else {
                root.settings_picked();
            }
        } else if (root.kb_zone == 1) {
            root.kb_cycle_addon(1);
        } else if (root.kb_zone == 2) {
            if (root.kb_ctl == 0) {
                root.kb_cycle_type(1);
            } else if (root.kb_ctl == 1) {
                root.kb_cycle_catalog(1);
            } else if (root.kb_ctl == 2) {
                // No edit mode on catalogs without search support (the
                // field is disabled there too).
                if (root.searchable) {
                    root.kb_edit = true;
                }
            } else {
                if (root.searchable) {
                    root.search_submitted(root.search_text);
                }
            }
        } else {
            if (root.kb_idx >= 0 && root.kb_idx < root.catalog.length) {
                root.item_selected(root.catalog[root.kb_idx].id, root.kb_idx);
            }
        }
    }

    // Row stride follows the card height (2:3 poster + 50px footer, see
    // the grid below) plus the item gap, matching the preload math below.
    // It changes with the column count, so it stays a live property.
    property <length> row_stride: root.item-width * 3 / 2 + 50px + root.item-gap;
    // Keep the focused card on screen. Reads the live scroll
    // metrics (sv_*) and steers through scroll_y: each mounted scroll
    // mirrors its viewport into scroll_y and applies scroll_y back via
    // its want_y alias, so this stays branch-agnostic. Skipped before
    // layout (content-height 0) — the one-shot restore timer below
    // retries.
    function kb_follow() {
        if (root.kb_zone != 3 || root.catalog.length == 0) {
            return;
        }
        if (root.sv_vph == 0px) {
            return;
        }
        let top = root.sv_grid_top + Math.floor(root.kb_idx / root.cols) * root.row_stride;
        let bot = top + root.row_stride;
        let vy = root.scroll_y;
        let vh = root.sv_vh;
        let min_y = Math.min(0px, vh - root.sv_vph);
        if (top < -vy) {
            root.scroll_y = -top;
        } else if (bot > vh - vy) {
            root.scroll_y = Math.max(min_y, vh - bot);
        }
    }

    changed kb_idx => { root.kb_follow(); }
    changed kb_zone => { root.kb_follow(); }
    changed catalog => {
        root.kb_clamp_idx();
        root.kb_follow();
    }

    // Clamp the (restored) scroll offset into the valid range once laid
    // out: content may have shrunk while inside the entry.
    function kb_clamp_view() {
        if (root.sv_vph == 0px) {
            return;
        }
        let min_y = Math.min(0px, root.sv_vh - root.sv_vph);
        root.scroll_y = Math.max(min_y, Math.min(0px, root.scroll_y));
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: #0f0f12;

    // 6-button scope: covers the page without intercepting the mouse.
    nav_scope := FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.UpArrow) {
                root.kb_active = true;
                root.kb_up();
                accept
            } else if (e.text == Key.DownArrow) {
                root.kb_active = true;
                root.kb_down();
                accept
            } else if (e.text == Key.LeftArrow) {
                root.kb_active = true;
                root.kb_left();
                accept
            } else if (e.text == Key.RightArrow) {
                root.kb_active = true;
                root.kb_right();
                accept
            } else if (e.text == Key.Return) {
                root.kb_active = true;
                root.kb_enter();
                accept
            } else if (e.text == Key.Backspace || e.text == Key.Back) {
                root.kb_active = true;
                root.home_picked();
                accept
            } else {
                reject
            }
        }
    }

    // One-shot restore: the page is recreated on return (bound kb
    // props arrive pre-set, so no `changed` fires) — clamp + scroll
    // to the focused card once layout is ready. The bound scroll
    // offset restores the absolute position; the clamp guards
    // shrunk content and follow is a no-op when already visible.
    restore_t := Timer {
        interval: 120ms;
        running: true;
        triggered => {
            root.kb_clamp_idx();
            root.kb_clamp_view();
            root.kb_follow();
            self.running = false;
        }
    }

    // Desktop: filter header pinned, only the grid scrolls (same tree
    // as before — header + grid region in a padded column).
    if !root.scroll_page: fix_col := VerticalLayout {
        width: 100%;
        height: 100%;
        padding-left: 18px + safe-left + root.rail_w;
        padding-right: 18px + safe-right;
        padding-bottom: 18px;
        padding-top: 18px + safe-top;
        spacing: 12px;

        fix_header := DiscoverHeader {
            width: 100%;
            catalog_names: root.catalog_names;
            type_names: root.type_names;
            addon_names: root.addon_names;
            searchable: root.searchable;
            count: root.catalog.length;
            addon_combo_idx <=> root.addon_combo_idx;
            type_combo_idx <=> root.type_combo_idx;
            catalog_combo_idx <=> root.catalog_combo_idx;
            search_text <=> root.search_text;
            searchable_hint: root.searchable_hint;
            narrow: root.narrow;
            kb_zone: root.kb_zone;
            kb_nav: root.kb_nav;
            kb_ctl: root.kb_ctl;
            kb_active <=> root.kb_active;
            kb_edit <=> root.kb_edit;

            addon_picked(v) => { root.addon_picked(v); }
            type_picked(v) => { root.type_picked(v); }
            catalog_picked(v) => { root.catalog_picked(v); }
            search_submitted(v) => { root.search_submitted(v); }
            search_done => { nav_scope.focus(); }
        }

        Rectangle {
            vertical-stretch: 1;
            clip: true;

            grid_scroll := ScrollView {
                width: 100%;
                height: 100%;
                // Touch devices scroll by dragging (there is no wheel):
                // the fluent-style ScrollView disables drag-pan by
                // default, so opt in explicitly.
                mouse-drag-pan-enabled: true;
                // One-way mirror (NOT a two-way binding): Flickable
                // removes viewport bindings on the first press/drag, which
                // silently froze scroll_y at 0 on touch devices. The init
                // restores the persisted offset on page (re)creation; the
                // changed handler keeps it truthful afterwards.
                init => { self.content-y = root.scroll_y; }
                // Preload + unload reporting (Bridge::visible_range): row
                // stride follows the card height (see row_stride); the
                // reported window already preloads ±2 rows above/below
                // the viewport. Rust
                // fetches that window nearest-first on a high-priority lane
                // and only unloads outside a wider keep window, so preloaded
                // rows survive jitter. Report only when the window moved by
                // >48 cards to avoid fetch churn.
                property <int> reported_first: -1000000;
                changed content-y => {
                    root.scroll_y = self.content-y;
                    // Live metrics for the keyboard follow-up (page-level
                    // functions cannot read this gated scroll directly).
                    root.sv_vh = self.visible-height;
                    root.sv_vph = self.content-height;
                    root.sv_grid_top = 0px;
                    // Near-bottom guard: content-y runs 0 (top) down to
                    // visible-height - content-height (bottom, negative), so
                    // remaining content below the viewport is
                    // content-height + content-y - visible-height. Fetch
                    // the next page only once that drops to 600px.
                    if (root.catalog.length > 0 && root.can_load_more && !root.loading_more
                        && self.content-y <= self.visible-height - self.content-height + 600px) {
                        root.load_more();
                    }
                    if (root.catalog.length > 0) {
                        // The grid fills this scroll content from y=0 (no
                        // header above it — the whole-page branch below
                        // offsets by the header height instead).
                        let first_row = Math.max(0, Math.floor(-self.content-y / root.row_stride));
                        let vis_rows = Math.ceil(self.visible-height / root.row_stride);
                        let first_idx = Math.max(0, (first_row - 2) * root.cols);
                        let last_idx = Math.min(root.catalog.length - 1, (first_row + vis_rows + 2) * root.cols - 1);
                        if (self.reported_first < -100000) {
                            // First report: just sync, initial fetches are
                            // already in flight.
                            self.reported_first = first_idx;
                        } else if (Math.abs(first_idx - self.reported_first) > 48) {
                            self.reported_first = first_idx;
                            root.visible_range(first_idx, last_idx);
                        }
                    }
                }

                fix_grid_wrap := VerticalLayout {
                    // Direct layout child (not the component): Flickable
                    // derives content-height only from direct *layout*
                    // children — a bare component child is ignored, the
                    // viewport collapses to the visible height and wheel /
                    // drag scrolling silently stops. (Library/Settings keep
                    // a layout directly inside their ScrollViews.)
                    width: 100%;

                fix_grid := DiscoverGrid {
                    width: 100%;
                    catalog: root.catalog;
                    cols: root.cols;
                    item-width: root.item-width;
                    item-gap: root.item-gap;
                    kb_active <=> root.kb_active;
                    kb_zone <=> root.kb_zone;
                    kb_idx <=> root.kb_idx;
                    loading_more: root.loading_more;
                    empty_hint: root.empty_hint;
                    item_selected(id, i) => { root.item_selected(id, i); }
                }
                }
            }
        }

        // Bottom tab bar (narrow only): desktop/wide navigate up top.
        // In-flow sibling of the grid region (same as Home/Library/
        // Settings) so the grid shrinks above it instead of sliding
        // underneath.
        if root.narrow: bottom_fix := BottomNav {
            active: 1;
            safe-bottom: root.safe-bottom;
            kb_zone: root.kb_zone;
            kb_nav: root.kb_nav;
            kb_active <=> root.kb_active;

            home_picked => { root.home_picked(); }
            discover_picked => { root.discover_picked(); }
            library_picked => { root.library_picked(); }
            settings_picked => { root.settings_picked(); }
        }
    }

    // Android (`scroll_page`): filters and grid scroll as one column, so
    // drags starting on the filter rows scroll the page too. Same
    // components, same mirrors — only the scroll parent differs. The
    // column mirrors the desktop branch (and Home/Library/Settings):
    // padded page, stretching scroll region, in-flow bottom tab bar.
    // The bar is a layout sibling of the scroll region — never an
    // absolutely-positioned overlay (`y: parent.height - self.height`,
    // which re-resolves against the window on every resize/scroll
    // metric change) — so it stays pinned while the page scrolls.
    if root.scroll_page: and_col := VerticalLayout {
        width: 100%;
        height: 100%;
        padding-left: 18px + safe-left + root.rail_w;
        padding-right: 18px + safe-right;
        padding-bottom: 18px;
        padding-top: 18px + safe-top;
        spacing: 12px;

        Rectangle {
            vertical-stretch: 1;
            clip: true;

        page_scroll := ScrollView {
            width: 100%;
            height: 100%;
        // Touch devices scroll by dragging (there is no wheel):
        // the fluent-style ScrollView disables drag-pan by default,
        // so opt in explicitly.
        mouse-drag-pan-enabled: true;
        // One-way mirror, same pattern as the desktop grid scroll above.
        init => { self.content-y = root.scroll_y; }
        // Preload + unload reporting (Bridge::visible_range): same
        // row_stride as above, but the grid starts below the filter
        // header, so its top edge offsets the row math.
        property <int> reported_first: -1000000;
        changed content-y => {
            root.scroll_y = self.content-y;
            // Live metrics for the keyboard follow-up (page-level
            // functions cannot read this gated scroll directly).
            root.sv_vh = self.visible-height;
            root.sv_vph = self.content-height;
            root.sv_grid_top = and_header.height;
            // Near-bottom guard (same as the desktop grid scroll above):
            // content-y is 0 at the top and
            // visible-height - content-height at the bottom.
            if (root.catalog.length > 0 && root.can_load_more && !root.loading_more
                && self.content-y <= self.visible-height - self.content-height + 600px) {
                root.load_more();
            }
            if (root.catalog.length > 0) {
                let grid_off = Math.max(0px, -self.content-y - and_header.height);
                let first_row = Math.floor(grid_off / root.row_stride);
                let vis_rows = Math.ceil(self.visible-height / root.row_stride);
                let first_idx = Math.max(0, (first_row - 2) * root.cols);
                let last_idx = Math.min(root.catalog.length - 1, (first_row + vis_rows + 2) * root.cols - 1);
                if (self.reported_first < -100000) {
                    // First report: just sync, initial fetches are
                    // already in flight.
                    self.reported_first = first_idx;
                } else if (Math.abs(first_idx - self.reported_first) > 48) {
                    self.reported_first = first_idx;
                    root.visible_range(first_idx, last_idx);
                }
            }
        }

        VerticalLayout {
            width: 100%;
            spacing: 12px;

            and_header := DiscoverHeader {
                width: 100%;
                catalog_names: root.catalog_names;
                type_names: root.type_names;
                addon_names: root.addon_names;
                searchable: root.searchable;
                count: root.catalog.length;
                addon_combo_idx <=> root.addon_combo_idx;
                type_combo_idx <=> root.type_combo_idx;
                catalog_combo_idx <=> root.catalog_combo_idx;
                search_text <=> root.search_text;
                searchable_hint: root.searchable_hint;
                narrow: root.narrow;
                kb_zone: root.kb_zone;
                kb_nav: root.kb_nav;
                kb_ctl: root.kb_ctl;
                kb_active <=> root.kb_active;
            kb_edit <=> root.kb_edit;

                addon_picked(v) => { root.addon_picked(v); }
                type_picked(v) => { root.type_picked(v); }
                catalog_picked(v) => { root.catalog_picked(v); }
                search_submitted(v) => { root.search_submitted(v); }
                search_done => { nav_scope.focus(); }
            }

            and_grid := DiscoverGrid {
                width: 100%;
                catalog: root.catalog;
                cols: root.cols;
                item-width: root.item-width;
                item-gap: root.item-gap;
                kb_active <=> root.kb_active;
                kb_zone <=> root.kb_zone;
                kb_idx <=> root.kb_idx;
                loading_more: root.loading_more;
                empty_hint: root.empty_hint;
                item_selected(id, i) => { root.item_selected(id, i); }
            }
        }
        }
        }

    // Bottom tab bar (narrow only): desktop/wide navigate up top.
    // In-flow sibling of the scroll region (same as Home/Library/
    // Settings and the desktop branch above) so it never moves with
    // the scroll content or window-metric changes.
    if root.narrow: bottom_scroll := BottomNav {
        active: 1;
        safe-bottom: root.safe-bottom;
        kb_zone: root.kb_zone;
        kb_nav: root.kb_nav;
        kb_active <=> root.kb_active;

        home_picked => { root.home_picked(); }
        discover_picked => { root.discover_picked(); }
        library_picked => { root.library_picked(); }
        settings_picked => { root.settings_picked(); }
    }
    }

    // Left navigation rail (wide layouts only; narrow uses the bottom bar).
    // Declared after the page columns so it paints over the strip its own
    // footprint reserves — both columns widen their left padding by `rail_w`,
    // so no page content lands under it.
    if !root.narrow: rail := SideNav {
        active: 1;
        safe-top: root.safe-top;
        safe-left: root.safe-left;
        safe-bottom: root.safe-bottom;
        kb_zone: root.kb_zone;
        kb_nav: root.kb_nav;
        kb_active <=> root.kb_active;

        home_picked => { root.home_picked(); }
        discover_picked => { root.discover_picked(); }
        library_picked => { root.library_picked(); }
        settings_picked => { root.settings_picked(); }
    }
    }
}