import { Theme, Anim, TrackingAccountRow, TrackingLinkRow, TrackingCandidateRow, TrackingMappingRow, TrackingSetupRow } from "@NovaUiShared";
import { ControlTouchArea } from "control-input.slint";
import { TrackingAccountCard } from "tracking-account-card.slint";

import { CheckBox, Spinner } from "std-widgets.slint";
import { ScrollView } from "scrollview.slint";
import { PillButton, ToggleSwitch, SettingsRow, SettingsInput } from "settings-controls.slint";
import { Dropdown } from "dropdown.slint";
import { IcClose, IcChevronRight, IcSync, IcMyAnimeList, IcAniList, IcEdit, IcOpenInNew, IcHistory, IcDelete, IcInfo, IcTag } from "icons.slint";




component AccountEditor inherits TrackingAccountCard {
    in property <TrackingAccountRow> entry;
    callback connect(int, string, string);
    callback complete(int, string);
    callback disconnect(int);
    callback cancel(int);
    callback input_focus(bool);
    callback release_focus();
    callback automatic(int,bool);
    callback tracking_library_action(int,int,string,bool);
    title: root.entry.service == 0 ? "MyAnimeList" : "AniList";
    status: root.entry.name == "" ? root.entry.state : root.entry.name + " · " + root.entry.state;
    logo: root.entry.service == 0 ? @image-url("../../assets/icons/services/myanimelist.svg") : @image-url("../../assets/icons/services/anilist.svg");
    brand_color: root.entry.service == 0 ? #2e51a2 : #027fc0;
    brand_dark: root.entry.service == 0 ? #15264e : #113c61;
    expanded: root.entry.signing_in || root.entry.library_review;
    toggled => { if root.returned_focused { root.release_focus(); } }
    property <bool> pin_sign_in: root.entry.service == 1 && root.entry.redirect_uri == "https://anilist.co/api/v2/oauth/pin";
    property <bool> returned_focused: false;
    out property <bool> input_focused: root.returned_focused;
    changed input_focused => { root.input_focus(root.input_focused); }
    property <bool> library_history: false;
    property <string> library_revision: root.entry.library_revision;
    changed library_revision => { root.library_history=false; if root.library_revision != "" {root.expanded=true;} }
    property <bool> signing_in: root.entry.signing_in;
    changed signing_in => {
        // Expiry and automatic browser returns remove the temporary input
        // without going through either sign-in button.
        if root.signing_in { root.expanded = true; }
        else { root.release_focus(); root.returned_focused = false; }
    }
    property <bool> connected: root.entry.connected;
    changed connected => { if !root.connected { root.release_focus(); } }
    VerticalLayout {
        alignment: start;
        spacing: 12px;
        SettingsRow { setting-key: "tracking_automatic_" + root.entry.service; row-title: @tr("Automatic tracking for linked releases"); ToggleSwitch { name: @tr("Automatic tracking for linked releases"); checked: root.entry.automatic; toggled => { root.automatic(root.entry.service, self.checked); } } }
        if root.entry.connected: VerticalLayout {
            spacing:8px; alignment:start;
            Text {text:root.entry.library_enabled ? @tr("Whole-library anime tracking") : @tr("Per-title tracking");color:Theme.current.text_settings;wrap:word-wrap;min-width:0px;}
            Text {text:root.entry.library_summary;color:Theme.current.text_settings;wrap:word-wrap;min-width:0px;}
            PillButton {label:@tr("Review whole library");enabled:!root.entry.library_busy;wrap_label:true;clicked=>{root.tracking_library_action(root.entry.service,0,"",false);}}
            if root.entry.library_enabled: PillButton {label:@tr("Use per-title tracking");enabled:!root.entry.library_busy;wrap_label:true;clicked=>{root.tracking_library_action(root.entry.service,2,"",false);}}
            PillButton {label:@tr("Rescan library");enabled:!root.entry.library_busy;wrap_label:true;clicked=>{root.tracking_library_action(root.entry.service,3,"",false);}}
            if root.entry.library_busy: Spinner {width:24px;height:24px;}
            if root.entry.library_review: VerticalLayout {
                spacing:10px;alignment:start;
                Text {text:@tr("Review each anime identity and episode range before linking. Title-search matches need your verification. Other titles keep their current links or stay pending.");color:Theme.current.text_settings;wrap:word-wrap;min-width:0px;}
                Text {text:root.entry.library_details == "" ? @tr("No additional releases to link. Whole-library discovery can still watch for new eligible titles.") : root.entry.library_details;color:Theme.current.text_settings;wrap:word-wrap;min-width:0px;}
                SettingsRow {row-title:@tr("Include existing watched history");ToggleSwitch {name:@tr("Include existing watched history");checked <=> root.library_history;}}
                PillButton {label:root.entry.library_scoped_review ? @tr("Link reviewed releases") : @tr("Start whole-library tracking");primary:true;enabled:!root.entry.library_busy && root.entry.library_revision != "";wrap_label:true;clicked=>{root.tracking_library_action(root.entry.service,1,root.entry.library_revision,root.library_history);}}
                PillButton {label:@tr("Cancel review");enabled:!root.entry.library_busy;clicked=>{root.tracking_library_action(root.entry.service,4,"",false);}}
            }
        }
        if !root.entry.signing_in: PillButton {
            label: root.entry.connected ? @tr("Reconnect") : @tr("Connect");
            clicked => {root.release_focus();root.connect(root.entry.service,root.entry.client_id,root.entry.redirect_uri);}
        }
        if root.entry.signing_in: VerticalLayout {
            alignment: start;
            spacing: 8px;
            Text { text: root.pin_sign_in ? @tr("Approve Nova in AniList, then copy the displayed token and paste it below.") : @tr("Finish sign-in in your browser. Paste the full return URL here if automatic return fails."); color: Theme.current.text_settings; wrap: word-wrap; min-width: 0; }
            returned := SettingsInput { changed has-focus => {root.returned_focused=self.has-focus;} placeholder-text: root.pin_sign_in ? @tr("AniList token") : @tr("Full return URL"); accessible-label: root.pin_sign_in ? @tr("AniList token") : @tr("Full return URL"); input-type: password; }
            PillButton { label: @tr("Finish sign-in"); primary: true; clicked => {let value=returned.full-text;root.release_focus();returned.text="";root.complete(root.entry.service,value);} }
            PillButton { label: @tr("Cancel sign-in"); clicked => {root.release_focus();returned.text="";root.cancel(root.entry.service);} }
        }
        if root.entry.connected: PillButton { label: @tr("Disconnect"); destructive: true; clicked => {root.release_focus();root.disconnect(root.entry.service);} }
    }
}
export component TrackingSettings inherits Rectangle {
    callback tracking_library_action(int,int,string,bool);
    in property <[TrackingAccountRow]> accounts;
    in-out property <bool> completion_rating_prompts_enabled: true;
    callback completion_prompts_changed();
    in property <string> notice;
    callback connect(int,string,string);
    callback complete(int,string);
    callback disconnect(int);
    callback cancel(int);
    callback reset();
    callback automatic(int,bool);
    in-out property <bool> reset_confirm:false;
    // Per-service state cannot retain a stale increment when a focused
    // conditional input or the whole account model disappears.
    property <bool> mal_input_focused: false;
    property <bool> anilist_input_focused: false;
    out property <bool> input_focused: root.mal_input_focused || root.anilist_input_focused;
    in property <bool> blur;
    function recover_focus() {
        blur_scope.focus();
        root.mal_input_focused = false;
        root.anilist_input_focused = false;
    }
    changed blur => { root.recover_focus(); }
    changed accounts => {
        // Replacement destroys account scopes. In-place row updates keep
        // the same model and do not move focus away from their inputs.
        root.recover_focus();
    }
    changed reset_confirm => { if !root.reset_confirm { root.recover_focus(); } }
    blur_scope := FocusScope {width:1px;height:1px;}
    vertical-stretch: 0;
    min-width: 0px;
    VerticalLayout {
        alignment: start;
        spacing: 14px;
        Text { text: @tr("Accounts"); color: Theme.current.text_settings; font-weight: 700; vertical-stretch: 0; }
        for row in root.accounts: AccountEditor {
            entry: row;
            connect(service,client,redirect) => {root.connect(service,client,redirect);}
            complete(service,value) => {root.complete(service,value);}
            disconnect(service) => {root.disconnect(service);}
            cancel(service) => {root.cancel(service);}
            automatic(service,enabled) => {root.automatic(service,enabled);}
            tracking_library_action(service,action,revision,history) => {root.tracking_library_action(service,action,revision,history);}
            input_focus(focused) => {
                if row.service == 0 { root.mal_input_focused = focused; }
                else { root.anilist_input_focused = focused; }
            }
            release_focus() => { root.recover_focus(); }
        }
        @children
        SettingsRow {
            setting-key: "completion_rating_prompts_enabled";
            row-title: @tr("Ask for ratings after completion");
            ToggleSwitch {
                name: @tr("Ask for ratings after completion");
                checked <=> root.completion_rating_prompts_enabled;
                toggled => { root.completion_prompts_changed(); }
            }
        }
        Text { text: @tr("Sign-in is saved and shared with paired devices. Disconnect removes shared sign-in."); color: Theme.current.text_settings; wrap: word-wrap; min-width: 0; }
        Text { text: root.notice; color: Theme.current.text_tracking_notice; wrap: word-wrap; min-width: 0; }
        PillButton {label:@tr("Reset local tracking");destructive:true;clicked => {root.recover_focus();root.reset_confirm=true;}}
        if root.reset_confirm: VerticalLayout {
            alignment: start;
            Text {text:@tr("Reset all local links and queued updates? A recovery backup is retained. Nova history and remote tracker lists stay unchanged.");color:Theme.current.text_settings;wrap:word-wrap;min-width:0;}
            PillButton {label:@tr("Confirm tracking reset");destructive:true;clicked => {root.recover_focus();root.reset_confirm=false;root.reset();}}
            PillButton {label:@tr("Cancel");clicked => {root.recover_focus();root.reset_confirm=false;}}
        }

    }
}
