import { Theme } from "theme.slint";
import { CheckBox, Spinner } from "std-widgets.slint";
import { ScrollView } from "scrollview.slint";
import { PillButton, ToggleSwitch, SettingsRow, SettingsInput } from "settings-controls.slint";
import { SettingSyncBadge } from "settings-sync.slint";
import { Dropdown } from "dropdown.slint";
import { IcClose, IcChevronRight, IcSync, IcMyAnimeList, IcAniList, IcEdit, IcOpenInNew, IcHistory, IcDelete, IcInfo, IcTag } from "icons.slint";
import { Anim } from "anim.slint";
import { TrackingAccountRow, TrackingLinkRow, TrackingCandidateRow, TrackingMappingRow, TrackingSetupRow } from "types.slint";

// Tracking controls share the detail screen palette and full touch/keyboard targets.
component TrackingButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> quiet: false;
    in property <bool> destructive: false;
    in property <bool> selected: false;
    in property <bool> compact: false;
    in property <int> icon: 0; // 1 close, 2 reload, 3 forward, 4 MAL, 5 AniList.
    callback clicked();
    min-height: root.icon >= 6 ? 68px : root.primary && !root.compact ? 52px : 44px;
    max-height: self.min-height;
    min-width: 0px;
    vertical-stretch: 0;
    border-radius: root.icon == 1 ? 22px : 12px;
    background: root.destructive ? Theme.current.destructive_control : root.primary ? Theme.current.primary_button : (root.selected ? Theme.current.selection_wash : root.quiet ? transparent : (touch.has-hover ? Theme.current.tracking_control_hover : Theme.current.tracking_control));
    opacity: root.enabled ? 1 : 0.45;
    border-width: focus.has-focus ? 2px : (root.quiet ? 0px : 1px);
    border-color: focus.has-focus || root.selected ? Theme.current.accent_vivid : Theme.current.border_overlay;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    forward-focus: focus;
    HorizontalLayout {
        padding-left: root.icon == 1 ? 10px : 12px;
        padding-right: root.icon == 1 ? 10px : 12px;
        spacing: 8px;
        alignment: root.icon >= 6 ? start : center;
        if root.icon == 6: Rectangle { width:20px; horizontal-stretch:0; IcEdit { y:(parent.height - self.height)/2; width:20px; height:20px; fill:Theme.current.text_bright; } }
        if root.icon == 7: Rectangle { width:20px; horizontal-stretch:0; IcOpenInNew { y:(parent.height - self.height)/2; width:20px; height:20px; fill:Theme.current.text_bright; } }
        if root.icon == 8: Rectangle { width:20px; horizontal-stretch:0; IcTag { y:(parent.height - self.height)/2; width:20px; height:20px; fill:Theme.current.text_bright; } }
        if root.icon == 9: Rectangle { width:20px; horizontal-stretch:0; IcHistory { y:(parent.height - self.height)/2; width:20px; height:20px; fill:Theme.current.text_bright; } }
        if root.icon == 10: Rectangle { width:20px; horizontal-stretch:0; IcDelete { y:(parent.height - self.height)/2; width:20px; height:20px; fill:Theme.current.text_destructive; } }
        if root.icon == 11: Rectangle { width:20px; horizontal-stretch:0; IcInfo { y:(parent.height - self.height)/2; width:20px; height:20px; fill:Theme.current.text_bright; } }
        if root.icon == 1: Rectangle { width:24px; background:transparent; IcClose { y:(parent.height - self.height)/2; width:24px; height:24px; fill:Theme.current.text_hero_icon; } }
        if root.icon == 2: Rectangle { width:20px; background:transparent; IcSync { y:(parent.height - self.height)/2; width:20px; height:20px; fill:Theme.current.accent_vivid; } }
        if root.icon == 4: Rectangle { width:24px; background:transparent; IcMyAnimeList { y:(parent.height - self.height)/2; width:24px; height:24px; fill:#2e51a2; } }
        if root.icon == 5: Rectangle { width:20px; background:transparent; IcAniList { y:(parent.height - self.height)/2; width:20px; height:20px; fill:#02a9ff; } }
        if root.icon != 1: Text {
            text: root.text; color: root.destructive ? Theme.current.text_destructive : root.primary ? Theme.current.on_accent : Theme.current.text_bright;
            font-size: root.icon >= 6 ? 13px : root.primary ? 16px : 14px; font-weight: root.primary ? 600 : 500;
            vertical-alignment: center; wrap: word-wrap; overflow: elide; min-width: 0px;
        }
        if root.icon == 3: Rectangle { width:18px; background:transparent; IcChevronRight { y:(parent.height - self.height)/2; width:18px; height:18px; fill:Theme.current.accent_vivid; } }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " { root.clicked(); accept } else { reject }
        }
    }
    touch := TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
}
component MappingChip inherits Rectangle {
    in property <string> numbers;
    in property <string> caption;
    min-width: 0px;
    height: Math.max(56px, chip.preferred-height + 22px);
    vertical-stretch: 0;
    VerticalLayout {
        spacing: 5px;
        chip := Rectangle {
            background: Theme.current.episode_search; border-radius: 10px; border-width: 1px; border-color: Theme.current.border_medium;
            VerticalLayout {
                padding: 8px;
                Text { text: root.numbers; color: Theme.current.text_tracking_primary; font-weight: 600; font-size: 14px; wrap: word-wrap; min-width: 0px; horizontal-alignment: center; }
            }
        }
        Text { text: root.caption; color: Theme.current.text_detail_metadata; font-size: 12px; horizontal-alignment: center; }
    }
}
component HistoryToggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> compact: false;
    callback toggled();
    height: Math.max(root.compact ? 44px : 56px, labels.preferred-height + (root.compact ? 4px : 12px));
    min-width: 0px; vertical-stretch: 0;
    accessible-role: checkbox;
    accessible-label: @tr("Include watched episodes");
    accessible-checkable: true;
    accessible-checked <=> root.checked;
    accessible-enabled: root.enabled;
    forward-focus: focus;
    border-width: focus.has-focus ? 1px : 0px; border-color: Theme.current.accent_vivid; border-radius: 10px;
    opacity: root.enabled ? 1 : 0.45;
    HorizontalLayout {
        spacing: 12px;
        labels := VerticalLayout {
            alignment: center; spacing: 4px;
            Text { text: @tr("Include watched episodes"); font-size: 14px; color: Theme.current.text_tracking_primary; wrap: word-wrap; min-width: 0px; }
            Text { text: @tr("Apply saved watch history"); font-size: 12px; color: Theme.current.text_detail_metadata; wrap: word-wrap; min-width: 0px; }
        }
        Rectangle {
            width: 48px; background: transparent;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 48px; height: 28px; border-radius: 14px; background: root.checked ? Theme.current.accent : Theme.current.tracking_toggle;
                Rectangle {
                    x: root.checked ? 24px : 4px; y: 4px; width: 20px; height: 20px;
                    border-radius: 10px; background: Theme.current.text_tracking_primary;
                    animate x { duration: Anim.enabled ? 140ms : 0ms; easing: ease-out; }
                }
            }
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => { if e.text == Key.Return || e.text == " " { root.checked = !root.checked; root.toggled(); accept } else { reject } }
    }
    TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.checked = !root.checked; root.toggled(); } }
}

component AccountEditor inherits Rectangle {
    in property <TrackingAccountRow> entry;
    callback connect(int, string, string);
    callback complete(int, string);
    callback disconnect(int);
    callback cancel(int);
    callback input_focus(bool);
    callback automatic(int,bool);
    min-width: 0px;
    background: Theme.current.card;
    border-width: 1px; border-color: Theme.current.border_soft;
    border-radius: 16px;
    vertical-stretch: 0;
    property <string> client: root.entry.client_id;
    property <string> redirect: root.entry.redirect_uri;
    property <bool> pin_sign_in: root.entry.service == 1 && root.entry.redirect_uri == "https://anilist.co/api/v2/oauth/pin";
    VerticalLayout {
        padding: 16px; spacing: 8px;
        Text { text: root.entry.service == 0 ? "MyAnimeList" : "AniList"; color: Theme.current.text_bright; font-weight: 700; }
        Text { text: root.entry.name; color: Theme.current.text_settings; wrap: word-wrap; min-width: 0; }
        Text { text: root.entry.state; color: Theme.current.text_settings; wrap: word-wrap; min-width: 0; }
        SettingsRow { setting-key: "tracking_automatic_" + root.entry.service; row-title: @tr("Automatic tracking for linked releases"); ToggleSwitch { name: @tr("Automatic tracking for linked releases"); checked: root.entry.automatic; toggled => { root.automatic(root.entry.service, self.checked); } } }
        Text { text: @tr("Public client ID"); color: Theme.current.text_settings; }
        SettingSyncBadge { max-width: parent.width; setting_key: "tracking_client_" + root.entry.service; setting_title: @tr("Public client ID"); }
        SettingsInput { changed has-focus => {root.input_focus(self.has-focus);} text <=> root.client; placeholder-text: @tr("Public client ID"); accessible-label: @tr("Public client ID"); }
        Text { text: @tr("Registered redirect URL"); color: Theme.current.text_settings; }
        SettingSyncBadge { max-width: parent.width; setting_key: "tracking_redirect_" + root.entry.service; setting_title: @tr("Registered redirect URL"); }
        SettingsInput { changed has-focus => {root.input_focus(self.has-focus);} text <=> root.redirect; placeholder-text: @tr("Registered redirect URL"); accessible-label: @tr("Registered redirect URL"); }
        if !root.entry.signing_in: PillButton {
            label: root.entry.connected ? @tr("Reconnect") : @tr("Connect");
            clicked => {root.connect(root.entry.service,root.client,root.redirect);}
        }
        if root.entry.signing_in: VerticalLayout {
            spacing: 8px;
            Text { text: root.pin_sign_in ? @tr("Approve Nova in AniList, then copy the displayed token and paste it below.") : @tr("Finish sign-in in your browser. Paste the full return URL here if automatic return fails."); color: Theme.current.text_settings; wrap: word-wrap; min-width: 0; }
            returned := SettingsInput { changed has-focus => {root.input_focus(self.has-focus);} placeholder-text: root.pin_sign_in ? @tr("AniList token") : @tr("Full return URL"); accessible-label: root.pin_sign_in ? @tr("AniList token") : @tr("Full return URL"); input-type: password; }
            PillButton { label: @tr("Finish sign-in"); primary: true; clicked => {root.complete(root.entry.service,returned.full-text);returned.text="";} }
            PillButton { label: @tr("Cancel sign-in"); clicked => {returned.text="";root.cancel(root.entry.service);} }
        }
        if root.entry.connected: PillButton { label: @tr("Disconnect"); destructive: true; clicked => {root.disconnect(root.entry.service);} }
    }
}
export component TrackingSettings inherits Rectangle {
    in property <[TrackingAccountRow]> accounts;
    in property <string> notice;
    callback connect(int,string,string);
    callback complete(int,string);
    callback disconnect(int);
    callback cancel(int);
    callback reset();
    callback automatic(int,bool);
    in-out property <bool> reset_confirm:false;
    property <int> focus_count:0;
    out property <bool> input_focused:root.focus_count>0;
    in property <bool> blur;
    changed blur => {blur_scope.focus();}
    blur_scope := FocusScope {width:1px;height:1px;}
    vertical-stretch: 0;
    min-width: 0px;
    VerticalLayout {
        spacing: 14px;
        Text { text: @tr("Sign-in is saved and shared with paired devices. Disconnect removes shared sign-in."); color: Theme.current.text_settings; wrap: word-wrap; min-width: 0; }
        Text { text: root.notice; color: Theme.current.text_tracking_notice; wrap: word-wrap; min-width: 0; }
        for row in root.accounts: AccountEditor {
            entry: row;
            connect(service,client,redirect) => {root.connect(service,client,redirect);}
            complete(service,value) => {root.complete(service,value);}
            disconnect(service) => {root.disconnect(service);}
            cancel(service) => {root.cancel(service);}
            automatic(service,enabled) => {root.automatic(service,enabled);}
            input_focus(focused) => {root.focus_count=Math.max(0,root.focus_count+(focused ? 1 : -1));}
        }
        PillButton {label:@tr("Reset local tracking");destructive:true;clicked => {root.reset_confirm=true;}}
        if root.reset_confirm: VerticalLayout {
            Text {text:@tr("Reset all local links and queued updates? A recovery backup is retained. Nova history and remote tracker lists stay unchanged.");color:Theme.current.text_settings;wrap:word-wrap;min-width:0;}
            PillButton {label:@tr("Confirm tracking reset");destructive:true;clicked => {root.reset_confirm=false;root.reset();}}
            PillButton {label:@tr("Cancel");clicked => {root.reset_confirm=false;}}
        }

    }
}
component EntryEditor inherits Rectangle {
    in property <TrackingLinkRow> entry;
    callback edit(string,string,int,string,bool,string,bool,string);
    callback action(string,int);
    background: Theme.current.episode_toolbar; border-radius: 16px; border-width: 1px; border-color: Theme.current.border_medium; vertical-stretch: 0; min-width: 0;
    property <bool> editing: false;
    property <bool> more: false;
    property <bool> history_confirm: false;
    property <bool> unlink_confirm: false;
    // Entry edits and confirmations remove their focused controls. Keep a
    // stable focus target inside the card for the next Android Back press.
    changed editing => { if !root.editing { more_button.focus(); } }
    changed history_confirm => { if !root.history_confirm { more_button.focus(); } }
    changed unlink_confirm => { if !root.unlink_confirm { more_button.focus(); } }
    VerticalLayout {
        padding: 12px; spacing: 8px;
        Text { text: root.entry.title; color: Theme.current.text_tracking_primary; wrap: word-wrap; min-width: 0; font-weight: 700; }
        Text { text: root.entry.coverage; color: Theme.current.text_secondary; wrap: word-wrap; min-width: 0; }
        Text { text: root.entry.state; color: Theme.current.text_tracking_notice; wrap: word-wrap; min-width: 0; }
        Text { text: @tr("Progress") + ": " + root.entry.progress; color: Theme.current.text_secondary; }
        more_button := TrackingButton {
            text: root.editing ? @tr("Back to review") : @tr("More");
            quiet: true;
            clicked => { if root.editing { root.editing = false; } else { root.more = !root.more; } }
        }
        if !root.editing && root.more: VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                TrackingButton { text: @tr("Edit tracker entry"); icon:6; horizontal-stretch:1; clicked => {root.editing=true;} }
                TrackingButton { text:@tr("Open on service"); icon:7; horizontal-stretch:1; clicked => {root.action(root.entry.id,4);} }
            }
            HorizontalLayout {
                spacing: 8px;
                TrackingButton { text:@tr("Restore automatic status and dates"); icon:2; horizontal-stretch:1; min-height:68px; clicked => {root.action(root.entry.id,5);} }
                TrackingButton { text: @tr("Refresh / retry"); icon:2; horizontal-stretch:1; min-height:68px; clicked => {root.action(root.entry.id,0);} }
            }
            HorizontalLayout {
                spacing: 8px;
                TrackingButton { text: @tr("Edit alignment"); icon:8; horizontal-stretch:1; clicked => {root.action(root.entry.id,1);} }
                TrackingButton { text: @tr("Apply Nova history"); icon:9; horizontal-stretch:1; clicked => {root.history_confirm=true;root.unlink_confirm=false;} }
            }
            if root.history_confirm: VerticalLayout {
                Text {text:root.entry.history_preview; color:Theme.current.text_secondary; wrap:word-wrap; min-width:0;}
                TrackingButton {text:@tr("Confirm history update"); clicked => {root.action(root.entry.id,2);root.history_confirm=false;}}
                TrackingButton {text:@tr("Cancel"); clicked => {root.history_confirm=false;}}
            }
            TrackingButton { text: @tr("Unlink"); icon:10; destructive:true; clicked => {root.unlink_confirm=true;root.history_confirm=false;} }
            if root.unlink_confirm: VerticalLayout {
                Text {text:@tr("Unlink this release? Unsent updates will be discarded when no other source uses it. An update already sent may finish.");color:Theme.current.text_secondary;wrap:word-wrap;min-width:0;}
                TrackingButton {text:@tr("Confirm unlink");clicked => {root.action(root.entry.id,3);root.unlink_confirm=false;}}
                TrackingButton {text:@tr("Cancel");clicked => {root.unlink_confirm=false;}}
            }
        }
        if root.editing: VerticalLayout {
            spacing: 6px;
            Text { text: @tr("Progress (explicit decreases are allowed)"); color: Theme.current.text_secondary; wrap: word-wrap; min-width: 0; }
            progress := SettingsInput { text:root.entry.progress; accessible-label:@tr("Tracker progress"); }
            status := Dropdown { accessible-role: combobox; model:root.entry.dates_writable ? [@tr("Planning"),@tr("Watching"),@tr("Completed"),@tr("On hold"),@tr("Dropped"),@tr("Repeating")] : [@tr("Planning"),@tr("Watching"),@tr("Completed"),@tr("On hold"),@tr("Dropped")]; current-index:root.entry.status; accessible-label:@tr("Tracker status"); }
            Text { text:root.entry.score_hint; color:Theme.current.text_secondary; wrap:word-wrap; min-width:0; }
            score := SettingsInput { text:root.entry.score; accessible-label:@tr("Tracker score"); }
            started_check := CheckBox { text:@tr("Change start date"); enabled:root.entry.dates_writable; }
            started := SettingsInput { text:root.entry.started; placeholder-text:@tr("YYYY-MM-DD, partial date, or empty to clear"); enabled:root.entry.dates_writable; accessible-label:@tr("Start date"); }
            completed_check := CheckBox { text:@tr("Change finish date"); enabled:root.entry.dates_writable; }
            completed := SettingsInput { text:root.entry.completed; placeholder-text:@tr("YYYY-MM-DD, partial date, or empty to clear"); enabled:root.entry.dates_writable; accessible-label:@tr("Finish date"); }
            if !root.entry.dates_writable: Text { text:@tr("MyAnimeList dates are read-only through its API."); color:Theme.current.text_secondary; wrap:word-wrap; min-width:0; }
            TrackingButton { text:@tr("Save tracker edits"); clicked => {root.edit(root.entry.id,progress.text,status.current-index,score.text,started_check.checked,started.text,completed_check.checked,completed.text);root.editing=false;} }
            TrackingButton { text:@tr("Cancel"); clicked => {root.editing=false;} }
        }
    }
}
// Matches, linked entries and their action cards share one scroll viewport.
// Keep the last card clear of the bottom edge, without taking space from entries.
export component TrackingPanel inherits Rectangle {
    in property <bool> open;
    in property <[TrackingLinkRow]> links;
    in property <[TrackingCandidateRow]> candidates;
    in-out property <int> selected_service;
    in property <[TrackingSetupRow]> setup;
    in property <string> setup_revision;
    in property <string> setup_summary;
    in property <string> setup_unmapped;
    in property <bool> setup_active;
    in property <string> range_first;
    in property <string> range_last;
    in property <string> range_start;
    in property <[string]> preview_rows;
    in property <[TrackingMappingRow]> mapping_rows;
    in property <string> notice;
    in property <string> candidate_title;
    in property <bool> busy;
    in property <bool> can_confirm;
    in property <length> safe-bottom;
    property <string> edit_first;
    property <string> edit_last;
    property <string> edit_start;
    property <bool> individual_mode: false;
    property <bool> manual_search: false;
    property <string> query_text: "";
    property <bool> include_history: false;
    property <bool> wide: root.width >= 840px;
    // Derive density from the window, rather than this layout's own height.
    in property <bool> compact: false;
    property <bool> setup_review: root.setup_active && root.candidate_title == "" && !root.manual_search && root.setup.length > 0;
    changed candidate_title => {
        root.edit_first = root.range_first;
        root.edit_last = root.range_last;
        root.edit_start = root.range_start;
        root.individual_mode = false;
        if root.candidate_title != "" { root.manual_search = false; }
        // Adjust/search can remove the focused input. Keep a persistent
        // control focused so Android Back stays in the window capture chain.
        if root.open { panel_focus.focus(); }
    }
    changed setup_revision => {
        root.include_history = false;
        root.manual_search = false;
        if root.open { panel_focus.focus(); }
    }
    changed manual_search => {
        if root.open { panel_focus.focus(); }
    }
    init => { panel_focus.focus(); }
    in property <int> focus_request;
    changed focus_request => { panel_focus.focus(); }
    callback back_to_details();
    callback accept_setup(string, bool);
    callback adjust_setup(int);
    callback cancel_adjust();
    callback search(int, string);
    callback pick(int);
    callback preview(string, string, string);
    callback confirm();
    callback assign(int, string);
    callback edit(string, string, int, string, bool, string, bool, string);
    callback action(string, int);
    horizontal-stretch: 0;
    preferred-width: 0px;
    preferred-height: panel_layout.preferred-height;
    max-width: 100000px;
    min-width: 0px;
    min-height: 0px;
    vertical-stretch: 0;
    background: transparent;

    panel_focus := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(e) => {
            if e.text == Key.Escape || e.text == Key.Back || e.text == Key.Backspace {
                if root.candidate_title != "" { root.cancel_adjust(); } else { root.back_to_details(); }
                accept
            } else { reject }
        }
        panel_layout := VerticalLayout {
            spacing: root.compact ? 8px : root.wide ? 20px : 12px;
            padding-bottom: root.safe-bottom + (root.compact ? 8px : 12px);
            if !root.compact: HorizontalLayout {
                spacing: 12px;
                vertical-stretch: 0;
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: root.candidate_title != "" ? @tr("Episode alignment") : root.links.length > 0 && !root.setup_active ? @tr("Your tracking") : @tr("Track your progress");
                        color: Theme.current.text_tracking_primary;
                        font-size: root.wide ? 26px : 22px;
                        font-weight: 700;
                        wrap: word-wrap;
                        min-width: 0px;
                    }
                    Text {
                        text: root.candidate_title != "" ? @tr("Review which episodes update this release.") : @tr("Link this title to your anime list.");
                        color: Theme.current.text_detail_metadata;
                        font-size: 14px;
                        wrap: word-wrap;
                        min-width: 0px;
                    }
                }
                if root.candidate_title != "": TrackingButton {
                    width: 120px;
                    text: @tr("Back to review");
                    quiet: true;
                    clicked => { root.cancel_adjust(); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                service_mal := TrackingButton {
                    width: 144px;
                    text: "MyAnimeList";
                    icon: 4;
                    selected: root.selected_service == 0;
                    enabled: !root.busy;
                    clicked => {
                        if root.selected_service != 0 {
                            root.selected_service = 0;
                            root.query_text = "";
                            root.search(0, "");
                        }
                    }
                }
                TrackingButton {
                    width: 104px;
                    text: "AniList";
                    icon: 5;
                    selected: root.selected_service == 1;
                    enabled: !root.busy;
                    clicked => {
                        if root.selected_service != 1 {
                            root.selected_service = 1;
                            root.query_text = "";
                            root.search(1, "");
                        }
                    }
                }
            }
            scroll := Rectangle {
                min-width: 0px;
                max-width: 100000px;
                preferred-width: 0px;
                horizontal-stretch: 1;
                vertical-stretch: 0;
                // Grow with the body; Detail owns all wheel and drag scrolling.
                height: Math.max(tracking_body.preferred-height, content_end.y + content_end.height) + 24px;
                tracking_body := VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    max-width: 100000px;
                    preferred-width: 0px;
                    height: self.preferred-height;
                    spacing: 12px;
                    alignment: start;
                    // The final action card can scroll clear of the edge.
                    padding-bottom: 12px;
                    if root.busy: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        vertical-stretch: 0;
                        Spinner { width: 20px; height: 20px; }
                        Text { text: @tr("Loading tracker…"); color: Theme.current.text_secondary; vertical-alignment: center; }
                    }
                    if root.notice != "": Text {
                        text: root.notice;
                        color: Theme.current.text_episode_metadata;
                        font-size: 14px;
                        wrap: word-wrap;
                        min-width: 0px;
                        vertical-stretch: 0;
                    }
                    if !root.setup_active && root.candidate_title == "": VerticalLayout {
                        spacing: 12px;
                        vertical-stretch: 0;
                        for row in root.links: EntryEditor {
                            entry: row;
                            edit(id, progress, status, score, set_started, started, set_completed, completed) => { root.edit(id, progress, status, score, set_started, started, set_completed, completed); }
                            action(id, action) => { root.action(id, action); }
                        }
                    }
                    if root.setup_unmapped != "" && root.setup_review: Text { text: root.setup_unmapped; color: Theme.current.text_tracking_warning; font-size: 13px; wrap: word-wrap; min-width: 0px; vertical-stretch: 0; }
                    if root.setup_review: VerticalLayout {
                        spacing: 12px;
                        vertical-stretch: 0;
                        Text { text: @tr("Suggested matches"); color: Theme.current.text_tracking_primary; font-size: 18px; font-weight: 600; }
                        // Each release is independently adjustable; ranges are
                        // actual backend coverage, including split seasons.
                        for release[index] in root.setup: Rectangle {
                            background: Theme.current.episode_toolbar;
                            border-radius: 16px;
                            border-width: 1px;
                            border-color: Theme.current.border_medium;
                            vertical-stretch: 0;
                            min-width: 0px;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 8px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: release.season; color: Theme.current.accent_vivid; font-size: 13px; font-weight: 600; wrap: word-wrap; min-width: 0px; }
                                        Text { text: release.title; color: Theme.current.text_tracking_primary; font-size: 16px; font-weight: 600; wrap: word-wrap; min-width: 0px; }
                                    }
                                    TrackingButton { width: 76px; text: @tr("Adjust"); quiet: true; enabled: !root.busy; clicked => { root.adjust_setup(index); } }
                                }
                                if release.source_range != "" && release.target_range != "": HorizontalLayout {
                                    spacing: 8px;
                                    MappingChip { numbers: release.source_range; caption: @tr("Nova episodes"); }
                                    Text { text: "→"; color: Theme.current.text_detail_tab; font-size: 22px; vertical-alignment: center; horizontal-stretch: 0; }
                                    MappingChip { numbers: release.target_range; caption: @tr("Tracker episodes"); }
                                }
                                // Unnumbered sources still retain truthful coverage.
                                if release.source_range == "" || release.target_range == "": Text { text: release.coverage; color: Theme.current.text_episode_metadata; font-size: 13px; wrap: word-wrap; min-width: 0px; }
                                if release.reason != "": Text { text: release.reason; color: Theme.current.text_detail_metadata; font-size: 12px; wrap: word-wrap; min-width: 0px; }
                                if root.include_history: Text { text: release.history; color: Theme.current.text_episode_metadata; font-size: 12px; wrap: word-wrap; min-width: 0px; }
                            }
                        }
                    }
                    if root.candidate_title == "": TrackingButton {
                        text: @tr("Choose another release");
                        icon: 3;
                        enabled: !root.busy;
                        clicked => { root.manual_search = !root.manual_search; }
                    }
                    if root.manual_search: SettingsInput {
                        text <=> root.query_text;
                        placeholder-text: @tr("Title, ID, or official anime URL");
                        accessible-label: @tr("Tracker search");
                        vertical-stretch: 0;
                    }
                    if !root.setup_review && root.candidate_title == "": TrackingButton {
                        text: root.links.length > 0 ? @tr("Add missing releases") : @tr("Reload suggestions");
                        quiet: true;
                        icon: 2;
                        enabled: !root.busy;
                        clicked => { root.query_text = ""; root.search(root.selected_service, ""); }
                    }
                    if root.manual_search: TrackingButton {
                        text: @tr("Search tracker");
                        enabled: !root.busy;
                        clicked => { root.search(root.selected_service, root.query_text); }
                    }
                    if root.manual_search || (!root.setup_active && root.links.length == 0 && root.candidate_title == ""): VerticalLayout {
                        spacing: 12px;
                        vertical-stretch: 0;
                        for candidate[index] in root.candidates: Rectangle {
                            background: Theme.current.episode_toolbar;
                            border-radius: 16px;
                            border-width: 1px;
                            border-color: Theme.current.border_medium;
                            vertical-stretch: 0;
                            min-width: 0px;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 8px;
                                Text { text: candidate.title; color: Theme.current.text_tracking_primary; font-weight: 600; wrap: word-wrap; min-width: 0px; }
                                Text { text: candidate.detail; color: Theme.current.text_secondary; wrap: word-wrap; min-width: 0px; }
                                Text { text: candidate.reason; color: Theme.current.text_tracking_notice; wrap: word-wrap; min-width: 0px; }
                                TrackingButton { text: @tr("Select release"); accessible-label: candidate.title; enabled: !root.busy; clicked => { root.pick(index); } }
                            }
                        }
                    }
                    if root.candidate_title != "": Rectangle {
                        background: Theme.current.episode_toolbar;
                        border-radius: 16px;
                        border-width: 1px;
                        border-color: Theme.current.border_medium;
                        vertical-stretch: 0;
                        min-width: 0px;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;
                            Text { text: root.candidate_title; color: Theme.current.text_tracking_primary; wrap: word-wrap; min-width: 0px; font-weight: 700; }
                            Text { text: @tr("Check the episode range. Use individual assignments only when the numbering differs."); color: Theme.current.text_secondary; wrap: word-wrap; min-width: 0px; }
                            Text { text: @tr("First source row"); color: Theme.current.text_secondary; }
                            first := SettingsInput { text <=> root.edit_first; accessible-label: @tr("First source row"); }
                            Text { text: @tr("Last source row"); color: Theme.current.text_secondary; }
                            last := SettingsInput { text <=> root.edit_last; accessible-label: @tr("Last source row"); }
                            Text { text: @tr("First tracker episode"); color: Theme.current.text_secondary; }
                            offset := SettingsInput { text <=> root.edit_start; accessible-label: @tr("First tracker episode"); }
                            TrackingButton { text: @tr("Preview alignment"); enabled: !root.busy; clicked => { root.preview(first.text, last.text, offset.text); } }
                            CheckBox { text: @tr("Edit individual episodes"); checked <=> root.individual_mode; }
                            if root.individual_mode: VerticalLayout {
                                spacing: 8px;
                                Text { text: @tr("Adjust individual assignments below. Leave empty to exclude a source episode."); color: Theme.current.text_secondary; wrap: word-wrap; min-width: 0px; }
                                for mapping in root.mapping_rows: VerticalLayout {
                                    spacing: 4px;
                                    vertical-stretch: 0;
                                    Text { text: mapping.label; color: Theme.current.text_secondary; wrap: word-wrap; min-width: 0px; }
                                    SettingsInput { text: mapping.target_episode; placeholder-text: @tr("Tracker episode or empty"); accessible-label: mapping.label; edited(value) => { root.assign(mapping.source_row, value); } }
                                }
                                for label in root.preview_rows: Text { text: label; color: Theme.current.text_tracking_notice; wrap: word-wrap; min-width: 0px; vertical-stretch: 0; }
                            }
                            TrackingButton { text: root.setup_active ? @tr("Save adjustment") : @tr("Confirm alignment"); primary: true; enabled: root.can_confirm && !root.busy; clicked => { root.confirm(); } }
                        }
                    }
                    if root.setup_review: Rectangle {
                        width: 100%;
                        vertical-stretch: 0;
                        background: Theme.current.episode_toolbar;
                        border-radius: 16px;
                        border-width: 1px;
                        border-color: Theme.current.border_medium;
                        VerticalLayout {
                            padding: root.compact ? 12px : 16px;
                            spacing: root.compact ? 8px : 10px;
                            alignment: start;
                            if root.wide && !root.compact: Text { text: @tr("Ready to track"); color: Theme.current.text_tracking_primary; font-size: 20px; font-weight: 600; }
                            Text { text: root.setup_summary; color: Theme.current.text_episode_metadata; font-size: 13px; wrap: word-wrap; min-width: 0px; }
                            if root.wide && !root.compact: Text { text: @tr("Only linked episodes will update your tracker."); color: Theme.current.text_detail_metadata; font-size: 14px; wrap: word-wrap; min-width: 0px; }
                            HistoryToggle { checked <=> root.include_history; enabled: !root.busy; compact: root.compact; }
                            TrackingButton { text: @tr("Start tracking"); primary: true; compact: root.compact; enabled: !root.busy; clicked => { root.accept_setup(root.setup_revision, root.include_history); } }
                        }
                    }
                    content_end := Rectangle { height: 12px; vertical-stretch: 0; }
                }
            }
        }
    }
}
