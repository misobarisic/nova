import { QueueBridge, Theme, Anim, InterfaceStyle, SettingsStyle } from "@NovaUiShared";
import { PageHeader } from "page-header.slint";
import { ScrollView } from "scrollview.slint";
import { TrackingButton } from "tracking-controls.slint";
import { ControlTouchArea } from "control-input.slint";
import { IcPlay, IcChevronUp, IcChevronDown, IcDelete, IcBookmark, IcCheck } from "icons.slint";

component QueueAction inherits Rectangle {
    in property <int> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> focused;
    in property <bool> primary;
    callback picked();
    width: InterfaceStyle.tv ? 52px : 44px;
    height: self.width;
    border-radius: 14px;
    background: root.primary ? Theme.current.primary_button : touch.feedback-active ? Theme.current.control_hover : Theme.current.control;
    border-width: root.focused ? 2px : 1px;
    border-color: root.focused ? Theme.current.accent_vivid : Theme.current.border_overlay;
    opacity: root.enabled ? 1 : 0.35;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    Rectangle {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: 20px; height: 20px;
        if root.icon == 0: IcPlay { width: 100%; height: 100%; fill: Theme.current.on_accent; }
        if root.icon == 1: IcChevronUp { width: 100%; height: 100%; fill: Theme.current.text_bright; }
        if root.icon == 2: IcChevronDown { width: 100%; height: 100%; fill: Theme.current.text_bright; }
        if root.icon == 3: IcDelete { width: 100%; height: 100%; fill: Theme.current.text_secondary; }
    }
    touch := ControlTouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.picked(); } }
}

export component WatchQueuePage inherits Rectangle {
    in property <bool> active;
    in property <bool> narrow;
    in property <length> safe-top;
    in property <length> safe-bottom;
    in property <length> safe-left;
    in property <length> safe-right;
    callback back();
    public function focus_shell() { if root.active { page_focus.focus(); } }
    background: Theme.current.artwork_canvas;
    clip: true;
    private property <int> selected: 0;
    private property <int> action: 0;
    private property <int> row-count: QueueBridge.rows.length;
    changed row-count => { root.selected = Math.max(-1, Math.min(root.selected, root.row-count - 1)); if root.selected < 0 { root.action = Math.min(1, root.action); } }
    changed active => { if root.active { page_focus.focus(); } }
    function activate() {
        if !root.active || QueueBridge.rows.length == 0 || root.selected >= QueueBridge.rows.length { return; }
        if root.selected < 0 {
            if root.action == 0 { QueueBridge.play(QueueBridge.rows[0].id); }
            else { QueueBridge.clear_watched(); }
            return;
        }
        let id = QueueBridge.rows[root.selected].id;
        if root.action == 0 { QueueBridge.play(id); }
        else if root.action == 1 { QueueBridge.move(id, -1); root.selected = Math.max(0, root.selected - 1); }
        else if root.action == 2 { QueueBridge.move(id, 1); root.selected = Math.min(QueueBridge.rows.length - 1, root.selected + 1); }
        else if root.action == 3 { QueueBridge.remove(id); }
    }
    function reveal(top: length, h: length) {
        if top < -queue_scroll.content-y { queue_scroll.content-y = -top; }
        else if top + h > queue_scroll.visible-height - queue_scroll.content-y {
            queue_scroll.content-y = Math.max(queue_scroll.visible-height - queue_scroll.content-height, queue_scroll.visible-height - top - h - 8px);
        }
    }
    page_focus := FocusScope {
        width: 100%; height: 100%; enabled: root.active;
        key-pressed(e) => {
            if e.text == Key.Back || e.text == Key.Backspace || e.text == Key.Escape { if !e.repeat { root.back(); } accept }
            else if e.text == Key.UpArrow || e.text == Key.DownArrow {
                SettingsStyle.keyboard-mode = true;
                root.selected = Math.max(-1, Math.min(QueueBridge.rows.length - 1, root.selected + (e.text == Key.UpArrow ? -1 : 1)));
                if root.selected < 0 { root.action = Math.min(1, root.action); queue_scroll.content-y = 0px; }
                accept
            } else if e.text == Key.Tab {
                SettingsStyle.keyboard-mode = true;
                let count = 2 + QueueBridge.rows.length * 4;
                let current = root.selected < 0 ? root.action : 2 + root.selected * 4 + root.action;
                let next = Math.mod(current + (e.modifiers.shift ? count - 1 : 1), count);
                root.selected = next < 2 ? -1 : Math.floor((next - 2) / 4);
                root.action = next < 2 ? next : Math.mod(next - 2, 4);
                if root.selected < 0 { queue_scroll.content-y = 0px; }
                accept
            } else if e.text == Key.LeftArrow || e.text == Key.RightArrow {
                SettingsStyle.keyboard-mode = true;
                let count = root.selected < 0 ? 2 : 4;
                root.action = Math.mod(root.action + (e.text == Key.LeftArrow ? count - 1 : 1), count); accept
            } else if e.text == Key.Return || e.text == " " { SettingsStyle.keyboard-mode = true; if !e.repeat { root.activate(); } accept }
            else if e.text == Key.Delete { if !e.repeat && root.selected >= 0 && root.selected < QueueBridge.rows.length { QueueBridge.remove(QueueBridge.rows[root.selected].id); } accept }
            else { reject }
        }
        queue_column := VerticalLayout {
            x: root.safe-left;
            width: Math.max(0px, root.width - root.safe-left - root.safe-right);
            height: 100%;
            padding-left: 18px; padding-right: 18px;
            padding-top: 18px + root.safe-top; padding-bottom: 18px + root.safe-bottom;
            spacing: 18px;
            PageHeader { title: @tr("Watch queue"); subtitle: @tr("Your evening, in order."); narrow: root.narrow; show-back: true; back => { root.back(); } }
            queue_scroll := ScrollView {
                vertical-stretch: 1; content-width: self.visible-width; mouse-drag-pan-enabled: true;
                VerticalLayout {
                    width: 100%; spacing: 12px; alignment: start; padding-bottom: 12px;
                    queue_hero_card := Rectangle {
                        height: queue_hero.preferred-height; border-radius: Theme.card_corner_radius;
                        background: Theme.current.selection_wash; border-width: 1px; border-color: Theme.current.border_medium;
                        queue_hero := VerticalLayout {
                            padding: root.narrow ? 18px : 24px; spacing: 10px;
                            Text { text: @tr("TONIGHT"); font-size: 12px; font-weight: 700; letter-spacing: 2px; color: Theme.current.accent_vivid; }
                            Text { text: QueueBridge.rows.length > 0 ? QueueBridge.summary : @tr("Make room for a good story"); font-size: root.narrow ? 23px : 30px; font-weight: 700; color: Theme.current.text_bright; wrap: word-wrap; }
                            Text { text: @tr("Mix movies and episodes from different shows. Choose a stream whenever you're ready."); font-size: 14px; color: Theme.current.text_secondary; wrap: word-wrap; }
                            if QueueBridge.rows.length > 0: HorizontalLayout {
                                spacing: 10px;
                                TrackingButton { text: @tr("Play first"); primary: true; border-width: root.selected < 0 && root.action == 0 && SettingsStyle.keyboard-mode ? 2px : 1px; border-color: root.selected < 0 && root.action == 0 && SettingsStyle.keyboard-mode ? Theme.current.accent_vivid : Theme.current.border_overlay; clicked => { QueueBridge.play(QueueBridge.rows[0].id); } }
                                TrackingButton { text: @tr("Clear watched"); quiet: true; border-width: root.selected < 0 && root.action == 1 && SettingsStyle.keyboard-mode ? 2px : 0px; border-color: Theme.current.accent_vivid; clicked => { QueueBridge.clear_watched(); } }
                                if !root.narrow: Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
                    if QueueBridge.notice != "": Text { text: QueueBridge.notice; color: Theme.current.text_secondary; wrap: word-wrap; font-size: 14px; }
                    if QueueBridge.rows.length == 0: Rectangle {
                        height: empty.preferred-height + 64px; border-radius: Theme.card_corner_radius;
                        border-width: 1px; border-color: Theme.current.border_overlay; background: Theme.current.card;
                        empty := VerticalLayout {
                            padding: 24px; spacing: 16px; alignment: center;
                            Rectangle { height: 40px; IcBookmark { x: (parent.width - self.width) / 2; width: 36px; height: 36px; fill: Theme.current.accent_vivid; } }
                            Text { text: @tr("A little planning. A great night."); font-size: 20px; font-weight: 600; color: Theme.current.text_bright; horizontal-alignment: center; wrap: word-wrap; }
                            Text { text: @tr("Add a movie from its detail page, or open an episode's options and choose Add to watch queue."); font-size: 14px; color: Theme.current.text_secondary; wrap: word-wrap; horizontal-alignment: center; }
                        }
                    }
                    for row[index] in QueueBridge.rows: Rectangle {
                        height: row_body.preferred-height;
                        border-radius: Theme.card_corner_radius;
                        background: index == 0 ? Theme.current.selection_wash : Theme.current.card;
                        border-width: 1px; border-color: Theme.current.border_overlay;
                        private property <bool> selected: root.selected == index && SettingsStyle.keyboard-mode;
                        changed selected => { if self.selected && root.active { root.reveal(self.y, self.height); } }
                        row_body := VerticalLayout {
                            padding: root.narrow ? 12px : 16px; spacing: 12px;
                            HorizontalLayout {
                                spacing: 14px;
                                Rectangle {
                                    width: root.narrow ? 52px : 64px; height: root.narrow ? 78px : 96px;
                                    horizontal-stretch: 0; border-radius: 10px; clip: true;
                                    background: Theme.current.episode_placeholder;
                                    if row.has_poster: Image { width: 100%; height: 100%; source: row.poster; image-fit: cover; }
                                    if !row.has_poster: IcBookmark { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 24px; height: 24px; fill: Theme.current.text_secondary; }
                                }
                                VerticalLayout {
                                    spacing: 5px; alignment: center; min-width: 0px;
                                    Text { text: index == 0 ? @tr("UP NEXT") : @tr("#{}", index + 1); font-size: 11px; font-weight: 700; letter-spacing: 1px; color: index == 0 ? Theme.current.accent_vivid : Theme.current.text_secondary; }
                                    Text { text: row.title; font-size: InterfaceStyle.tv ? 24px : 18px; font-weight: 600; color: Theme.current.text_bright; wrap: word-wrap; max-lines: 2; overflow: elide; min-width: 0px; }
                                    Text { text: row.context; font-size: 13px; color: Theme.current.text_secondary; wrap: word-wrap; max-lines: 2; overflow: elide; min-width: 0px; }
                                    if row.watched: Text { text: @tr("Watched"); font-size: 12px; color: Theme.current.accent_vivid; }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                QueueAction { icon: 0; label: @tr("Play") + " · " + row.title + " · " + row.context; primary: true; focused: root.selected == index && root.action == 0 && SettingsStyle.keyboard-mode; picked => { root.selected = index; root.action = 0; root.activate(); } }
                                Text { text: @tr("Choose stream"); color: Theme.current.text_secondary; font-size: 12px; vertical-alignment: center; min-width: 0px; overflow: elide; }
                                Rectangle { horizontal-stretch: 1; min-width: 0px; }
                                QueueAction { icon: 1; label: @tr("Move up") + " · " + row.title; enabled: index > 0; focused: root.selected == index && root.action == 1 && SettingsStyle.keyboard-mode; picked => { root.selected = index; QueueBridge.move(row.id, -1); root.selected = Math.max(0, index - 1); page_focus.focus(); } }
                                QueueAction { icon: 2; label: @tr("Move down") + " · " + row.title; enabled: index + 1 < QueueBridge.rows.length; focused: root.selected == index && root.action == 2 && SettingsStyle.keyboard-mode; picked => { root.selected = index; QueueBridge.move(row.id, 1); root.selected = Math.min(QueueBridge.rows.length - 1, index + 1); page_focus.focus(); } }
                                QueueAction { icon: 3; label: @tr("Remove from queue") + " · " + row.title; focused: root.selected == index && root.action == 3 && SettingsStyle.keyboard-mode; picked => { QueueBridge.remove(row.id); page_focus.focus(); } }
                            }
                        }
                    }
                }
            }
        }
    }
    // More retains the outgoing pixels during pop motion, while input already
    // belongs to the logical destination. Never activate an exiting action.
    if !root.active: TouchArea {
        width: 100%; height: 100%;
        clicked => { }
        scroll-event(e) => { accept }
    }
}
