import { Theme, Anim, InterfaceStyle, DetailContent, SettingsStyle } from "@NovaUiShared";
import { SettingsInput, PillButton } from "settings-controls.slint";
import { Dropdown } from "dropdown.slint";
import { CheckBox } from "std-widgets.slint";
import { ControlTouchArea } from "control-input.slint";
import { IcClose, IcChevronRight, IcSync, IcMyAnimeList, IcAniList, IcEdit, IcOpenInNew, IcHistory, IcDelete, IcInfo, IcTag } from "icons.slint";

export component TrackingButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> quiet: false;
    in property <bool> destructive: false;
    in property <bool> selected: false;
    in property <bool> compact: false;
    in property <int> icon: 0; // 1 close, 2 reload, 3 forward, 4 MAL, 5 AniList.
    callback clicked();
    callback nav-focused();
    // A negative index leaves standalone/settings controls outside page traversal.
    in property <int> nav-index: -1;
    property <bool> tv-current: InterfaceStyle.tv && root.nav-index >= 0 && root.enabled && DetailContent.tracking_tv_index == root.nav-index;
    property <int> nav-epoch: DetailContent.tracking_tv_epoch;
    changed tv-current => { if root.tv-current { nav_timer.start(); } }
    changed nav-epoch => { if root.tv-current { nav_timer.start(); } }
    init => { if root.tv-current { nav_timer.start(); } }
    nav_timer := Timer { interval: 1ms; running: false; triggered => { self.stop(); root.claim_tv_focus(); } }
    function claim_tv_focus() {
        if root.tv-current {
            SettingsStyle.keyboard-mode = true;
            root.focus();
            root.nav-focused();
            DetailContent.tracking_focus_y = root.absolute-position.y;
            DetailContent.tracking_focus_height = root.height;
            DetailContent.tracking_reveal_request += 1;
        }
    }

    out property <bool> has-focus: focus.has-focus;
    changed has-focus => { if root.has-focus && InterfaceStyle.tv && root.nav-index >= 0 { DetailContent.tracking_tv_index = root.nav-index; } }
    // Wrapped and translated action labels must grow the control rather than
    // disappear behind a fixed-height ellipsis on narrow screens.
    min-height: Math.max(InterfaceStyle.tv ? 56px : 0px, Math.max(root.icon >= 6 ? 68px : root.primary && !root.compact ? 52px : 44px, label.preferred-height + 24px));
    max-height: self.min-height;
    min-width: 0px;
    vertical-stretch: 0;
    border-radius: root.icon == 1 ? 22px : 12px;
    background: root.destructive ? Theme.current.destructive_control : root.primary ? Theme.current.primary_button : (root.selected ? Theme.current.selection_wash : root.quiet ? transparent : (touch.feedback-active ? Theme.current.tracking_control_hover : Theme.current.tracking_control));
    opacity: root.enabled ? 1 : 0.45;
    border-width: focus.has-focus ? 2px : (root.quiet ? 0px : 1px);
    border-color: focus.has-focus || root.selected ? Theme.current.accent_vivid : Theme.current.border_overlay;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    forward-focus: focus;
    HorizontalLayout {
        padding-left: root.icon == 1 ? 10px : 12px;
        padding-right: root.icon == 1 ? 10px : 12px;
        spacing: root.icon == 1 ? 0px : 8px;
        alignment: root.icon >= 6 ? start : center;
        if root.icon == 6: Rectangle { width:20px; horizontal-stretch:0; IcEdit { y:(parent.height - self.height)/2; width:20px; height:20px; fill:Theme.current.text_bright; } }
        if root.icon == 7: Rectangle { width:20px; horizontal-stretch:0; IcOpenInNew { y:(parent.height - self.height)/2; width:20px; height:20px; fill:Theme.current.text_bright; } }
        if root.icon == 8: Rectangle { width:20px; horizontal-stretch:0; IcTag { y:(parent.height - self.height)/2; width:20px; height:20px; fill:Theme.current.text_bright; } }
        if root.icon == 9: Rectangle { width:20px; horizontal-stretch:0; IcHistory { y:(parent.height - self.height)/2; width:20px; height:20px; fill:Theme.current.text_bright; } }
        if root.icon == 10: Rectangle { width:20px; horizontal-stretch:0; IcDelete { y:(parent.height - self.height)/2; width:20px; height:20px; fill:Theme.current.text_destructive; } }
        if root.icon == 11: Rectangle { width:20px; horizontal-stretch:0; IcInfo { y:(parent.height - self.height)/2; width:20px; height:20px; fill:Theme.current.text_bright; } }
        if root.icon == 1: Rectangle { width:24px; horizontal-stretch:0; background:transparent; IcClose { y:(parent.height - self.height)/2; width:24px; height:24px; fill:Theme.current.text_hero_icon; } }
        if root.icon == 2: Rectangle { width:20px; horizontal-stretch:0; background:transparent; IcSync { y:(parent.height - self.height)/2; width:20px; height:20px; fill:Theme.current.accent_vivid; } }
        if root.icon == 4: Rectangle { width:24px; horizontal-stretch:0; background:transparent; IcMyAnimeList { y:(parent.height - self.height)/2; width:24px; height:24px; fill:#2e51a2; } }
        if root.icon == 5: Rectangle { width:20px; horizontal-stretch:0; background:transparent; IcAniList { y:(parent.height - self.height)/2; width:20px; height:20px; fill:#02a9ff; } }
        label := Text {
            visible: root.icon != 1;
            max-width: root.icon == 1 ? 0px : 100000px;
            text: root.icon == 1 ? "" : root.text; color: root.destructive ? Theme.current.text_destructive : root.primary ? Theme.current.on_accent : Theme.current.text_bright;
            font-size: InterfaceStyle.tv ? 20px : root.icon >= 6 ? 13px : root.primary ? 16px : 14px; font-weight: root.primary ? 600 : 500;
            vertical-alignment: center; wrap: word-wrap; overflow: elide; min-width: 0px;
        }
        if root.icon == 3: Rectangle { width:18px; horizontal-stretch:0; background:transparent; IcChevronRight { y:(parent.height - self.height)/2; width:18px; height:18px; fill:Theme.current.accent_vivid; } }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            // A focused scope can still receive its activation key while an
            // asynchronous update disables it; validate before dispatching.
            if !root.enabled { reject }
            else if e.text == Key.Return || e.text == " " { if !InterfaceStyle.tv || !e.repeat { root.clicked(); } accept } else { reject }
        }
    }
    touch := ControlTouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
}
export component MappingChip inherits Rectangle {
    in property <string> numbers;
    in property <string> caption;
    min-width: 0px;
    height: Math.max(56px, chip.preferred-height + 22px);
    vertical-stretch: 0;
    VerticalLayout {
        spacing: 5px;
        chip := Rectangle {
            background: Theme.current.episode_search; border-radius: 10px; border-width: 1px; border-color: Theme.current.border_medium;
            VerticalLayout {
                padding: 8px;
                Text { text: root.numbers; color: Theme.current.text_tracking_primary; font-weight: 600; font-size: 14px; wrap: word-wrap; min-width: 0px; horizontal-alignment: center; }
            }
        }
        Text { text: root.caption; color: Theme.current.text_detail_metadata; font-size: 12px; horizontal-alignment: center; }
    }
}
export component HistoryToggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    // A negative index leaves standalone/settings controls outside page traversal.
    in property <int> nav-index: -1;
    property <bool> tv-current: InterfaceStyle.tv && root.nav-index >= 0 && root.enabled && DetailContent.tracking_tv_index == root.nav-index;
    property <int> nav-epoch: DetailContent.tracking_tv_epoch;
    changed tv-current => { if root.tv-current { nav_timer.start(); } }
    changed nav-epoch => { if root.tv-current { nav_timer.start(); } }
    init => { if root.tv-current { nav_timer.start(); } }
    nav_timer := Timer { interval: 1ms; running: false; triggered => { self.stop(); root.claim_tv_focus(); } }
    function claim_tv_focus() {
        if root.tv-current {
            SettingsStyle.keyboard-mode = true;
            root.focus();
            DetailContent.tracking_focus_y = root.absolute-position.y;
            DetailContent.tracking_focus_height = root.height;
            DetailContent.tracking_reveal_request += 1;
        }
    }

    in property <bool> compact: false;
    callback toggled();
    height: Math.max(root.compact ? 44px : 56px, labels.preferred-height + (root.compact ? 4px : 12px));
    min-width: 0px; vertical-stretch: 0;
    accessible-role: checkbox;
    accessible-label: @tr("Include watched episodes");
    accessible-checkable: true;
    accessible-checked <=> root.checked;
    accessible-enabled: root.enabled;
    forward-focus: focus;
    border-width: focus.has-focus ? 1px : 0px; border-color: Theme.current.accent_vivid; border-radius: 10px;
    opacity: root.enabled ? 1 : 0.45;
    HorizontalLayout {
        spacing: 12px;
        labels := VerticalLayout {
            alignment: center; spacing: 4px;
            Text { text: @tr("Include watched episodes"); font-size: 14px; color: Theme.current.text_tracking_primary; wrap: word-wrap; min-width: 0px; }
            Text { text: @tr("Apply saved watch history"); font-size: 12px; color: Theme.current.text_detail_metadata; wrap: word-wrap; min-width: 0px; }
        }
        Rectangle {
            width: 48px; background: transparent;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 48px; height: 28px; border-radius: 14px;
                private property <color> target-background: root.checked ? Theme.current.accent : Theme.current.tracking_toggle;
                private property <color> state-background: self.target-background;
                private property <bool> state-motion: Anim.enabled;
                animate state-background { duration: Anim.control_state; easing: ease-out; }
                changed target-background => { self.state-background = self.target-background; }
                // Reassign with the current duration so master-off cancels an old
                // animation instead of reviving it when motion is enabled again.
                changed state-motion => { self.state-background = self.target-background; }
                background: Anim.enabled ? self.state-background : self.target-background;
                history_knob := Rectangle {
                    private property <length> target-x: root.checked ? 24px : 4px;
                    private property <length> state-x: self.target-x;
                    private property <bool> state-motion: Anim.enabled;
                    animate state-x { duration: Anim.control_state; easing: ease-out; }
                    changed target-x => { self.state-x = self.target-x; }
                    // Reassign with the current duration so master-off cancels an old
                    // animation instead of reviving it when motion is enabled again.
                    changed state-motion => { self.state-x = self.target-x; }
                    x: Anim.enabled ? self.state-x : self.target-x;
                    y: 4px; width: 20px; height: 20px;
                    border-radius: 10px; background: Theme.current.text_tracking_primary;
                }
            }
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => { if !root.enabled { reject } else if e.text == Key.Return || e.text == " " { if !InterfaceStyle.tv || !e.repeat { root.checked = !root.checked; root.toggled(); } accept } else { reject } }
    }
    TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.checked = !root.checked; root.toggled(); } }
}

// Native editors/popups keep their own activation and text-editing behavior.
export component TrackingInput inherits SettingsInput {
    // A negative index leaves standalone/settings controls outside page traversal.
    in property <int> nav-index: -1;
    property <bool> tv-current: InterfaceStyle.tv && root.nav-index >= 0 && root.enabled && DetailContent.tracking_tv_index == root.nav-index;
    property <int> nav-epoch: DetailContent.tracking_tv_epoch;
    changed tv-current => { if root.tv-current { nav_timer.start(); } }
    changed nav-epoch => { if root.tv-current { nav_timer.start(); } }
    init => { if root.tv-current { nav_timer.start(); } }
    nav_timer := Timer { interval: 1ms; running: false; triggered => { self.stop(); root.claim_tv_focus(); } }
    function claim_tv_focus() {
        if root.tv-current {
            SettingsStyle.keyboard-mode = true;
            root.focus();
            DetailContent.tracking_focus_y = root.absolute-position.y;
            DetailContent.tracking_focus_height = root.height;
            DetailContent.tracking_reveal_request += 1;
        }
    }
}

