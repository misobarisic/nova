// Native editors/popups keep their own activation and text-editing behavior.
export component TrackingCheckBox inherits Rectangle {
    // Standard CheckBox has no child slot. Own the focus timer in this wrapper
    // and forward the public state and native focus to the unchanged widget.
    in property <string> text;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled();
    forward-focus: checkbox;
    min-height: InterfaceStyle.tv ? 56px : 0px;
    min-width: 0px;
    vertical-stretch: 0;
    HorizontalLayout {
        checkbox := CheckBox {
            text: root.text;
            enabled: root.enabled;
            checked <=> root.checked;
            toggled => { root.toggled(); }
        }
    }
    // A negative index leaves standalone/settings controls outside page traversal.
    in property <int> nav-index: -1;
    property <bool> tv-current: InterfaceStyle.tv && root.nav-index >= 0 && root.enabled && DetailContent.tracking_tv_index == root.nav-index;
    property <int> nav-epoch: DetailContent.tracking_tv_epoch;
    changed tv-current => { if root.tv-current { nav_timer.start(); } }
    changed nav-epoch => { if root.tv-current { nav_timer.start(); } }
    init => { if root.tv-current { nav_timer.start(); } }
    nav_timer := Timer { interval: 1ms; running: false; triggered => { self.stop(); root.claim_tv_focus(); } }
    function claim_tv_focus() {
        if root.tv-current {
            SettingsStyle.keyboard-mode = true;
            root.focus();
            DetailContent.tracking_focus_y = root.absolute-position.y;
            DetailContent.tracking_focus_height = root.height;
            DetailContent.tracking_reveal_request += 1;
        }
    }
}

// Service title actions retain their existing Settings pill appearance.
export component TrackingPillButton inherits PillButton {
    // A negative index leaves standalone/settings controls outside page traversal.
    in property <int> nav-index: -1;
    property <bool> tv-current: InterfaceStyle.tv && root.nav-index >= 0 && root.enabled && DetailContent.tracking_tv_index == root.nav-index;
    property <int> nav-epoch: DetailContent.tracking_tv_epoch;
    changed tv-current => { if root.tv-current { nav_timer.start(); } }
    changed nav-epoch => { if root.tv-current { nav_timer.start(); } }
    init => { if root.tv-current { nav_timer.start(); } }
    nav_timer := Timer { interval: 1ms; running: false; triggered => { self.stop(); root.claim_tv_focus(); } }
    function claim_tv_focus() {
        if root.tv-current {
            SettingsStyle.keyboard-mode = true;
            root.focus();
            DetailContent.tracking_focus_y = root.absolute-position.y;
            DetailContent.tracking_focus_height = root.height;
            DetailContent.tracking_reveal_request += 1;
        }
    }

}
