import { Theme, InterfaceStyle, LicenseSource, NavMetrics, NavState, SettingsStyle, Anim } from "@NovaUiShared";

import { ListView } from "std-widgets.slint";
import { ScrollView } from "scrollview.slint";

import { SideNav } from "sidenav.slint";
import { PillButton, ToggleSwitch, SectionHeader, SettingsCard, SettingsHeader } from "settings-controls.slint";

// About has independent navigation and scroll state; opening it does not
// mount Settings or trigger its storage and service refreshes.
export component AboutPage inherits Rectangle {
    // Called after publication only while AppWindow retains baseline focus.
    public function focus_shell() { if root.active { nav_scope.focus(); } }

    in property <bool> external_navigation: false;
    in property <bool> active: true;
    preferred-width: 100%;
    preferred-height: 100%;
    background: Theme.current.artwork_canvas;
    in property <bool> narrow: false;
    in property <length> nav-viewport-width;
    in property <length> safe-top: 0px;
    in property <length> safe-left: 0px;
    in property <length> safe-right: 0px;
    in property <length> safe-bottom: 0px;
    in property <[string]> license_text_chunks;
    in property <[LicenseSource]> license_sources;
    in property <string> app_version: "";
    in property <bool> update_checks_enabled: false;
    in property <bool> update_is_development: true;
    in property <bool> update_automatic: true;
    in property <int> update_status: 0;
    in property <bool> update_available: false;
    in property <string> update_latest_version: "";
    callback update_check_requested();
    callback update_automatic_changed(bool);
    callback update_release_requested();
    private property <int> about_action: 0;
    in property <int> system_back_request;
    in-out property <bool> licenses_open: false;
    // Keep both scroll models alive through the reverse transition as well.
    private property <float> licenses_progress: root.licenses_open ? 1.0 : 0.0;
    animate licenses_progress { duration: Anim.transition_slide; easing: ease-out; }
    in-out property <length> scroll_y: 0px;
    in-out property <length> licenses_scroll_y: 0px;
    in-out property <bool> kb_active: false;
    private property <int> last_system_back_request: 0;
    in-out property <int> kb_zone: 1;
    in-out property <int> kb_nav: 3;
    private property <int> source_index: 0;
    private property <length> legal-entry-y;
    private property <length> selected_source_top;
    private property <length> selected_source_bottom;
    function step_about(direction: int) {
        let next = Math.clamp(root.about_action + direction, 0, root.update_available ? 3 : 2);
        if !root.update_checks_enabled { root.about_action = 0; }
        else if next == 1 && root.update_is_development { root.about_action = direction > 0 ? 2 : 0; }
        else { root.about_action = next; }
    }
    function step_source(direction: int) {
        let next = Math.clamp(root.source_index + direction, 0, Math.max(0, root.license_sources.length - 1));
        if next != root.source_index {
            // Reveal the adjoining row before changing selection, so its
            // virtualized button can publish the usual precise focus reveal.
            about_scroll.content-y += direction > 0
                ? about_scroll.absolute-position.y - root.selected_source_bottom
                : about_scroll.absolute-position.y + about_scroll.visible-height - root.selected_source_top;
            root.source_index = next;
        }
    }
    private property <bool> restore_pending: true;
    private property <length> rail_w: root.narrow || root.external_navigation ? 0px : NavMetrics.width-for(root.nav-viewport-width);
    private property <int> focus_request: SettingsStyle.focus-request;
    private property <bool> native_keyboard_mode: SettingsStyle.keyboard-mode;
    callback home_picked();
    callback back_picked();
    callback discover_picked();
    callback library_picked();
    callback settings_picked();
    callback about_picked();
    callback more_picked();
    callback license_source_requested(string);

    changed license_sources => { root.source_index = Math.min(root.source_index, Math.max(0, root.license_sources.length - 1)); }
    changed kb_active => { SettingsStyle.keyboard-mode = root.kb_active; }
    changed native_keyboard_mode => { root.kb_active = root.native_keyboard_mode; }
    changed focus_request => {
        if (root.licenses_open && !root.restore_pending && SettingsStyle.keyboard-mode) {
            let top = SettingsStyle.focus-y - about_scroll.absolute-position.y;
            if (top < 0px) { about_scroll.content-y -= top; }
            else if (top + SettingsStyle.focus-height > about_scroll.visible-height) {
                about_scroll.content-y -= top + SettingsStyle.focus-height - about_scroll.visible-height;
            }
        } else if (!root.licenses_open && !root.restore_pending && SettingsStyle.keyboard-mode) {
            let top = SettingsStyle.focus-y - about_info_scroll.absolute-position.y;
            if top < 0px { about_info_scroll.content-y -= top; }
            else if top + SettingsStyle.focus-height > about_info_scroll.visible-height {
                about_info_scroll.content-y -= top + SettingsStyle.focus-height - about_info_scroll.visible-height;
            }
        }
    }
    function open_licenses() {
        nav_scope.focus();
        root.source_index = 0;
        root.kb_zone = 1;
        root.restore_pending = true;
        root.licenses_open = true;
        restore_scroll_t.start();
    }
    function back() {
        // Source buttons disappear on dismissal. Keep Android Back attached
        // to the page's persistent scope before removing their focus targets.
        nav_scope.focus();
        if (root.licenses_open) {
            root.restore_pending = true;
            root.licenses_open = false;
            root.kb_zone = 1;
            restore_scroll_t.start();
        } else { root.back_picked(); }
    }
    changed system_back_request => {
        if (root.active && root.last_system_back_request != root.system_back_request) {
            root.last_system_back_request = root.system_back_request;
            root.back();
        }
    }

    // Header geometry can change between the two panes. Ignore transient
    // offset writes until the active pane has been measured, keeping About
    // and Licenses positions independent.
    restore_scroll_t := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.stop();
            if root.licenses_open { about_scroll.content-y = root.licenses_scroll_y; }
            else { about_info_scroll.content-y = root.scroll_y; }
            root.restore_pending = false;
        }
    }

    // AppWindow restores native focus after publication without interrupting
    // a license search input that already owns focus on the first frame.

    nav_scope := FocusScope {
        enabled: root.active;
        width: 100%; height: 100%;
        init => { root.last_system_back_request = root.system_back_request; self.focus(); restore_scroll_t.start(); }
        key-pressed(e) => {
            if (e.text == Key.Back || e.text == Key.Backspace || e.text == Key.Escape) {
                if (!e.repeat) { root.back(); }
                accept
            } else if (e.text == Key.LeftArrow || e.text == Key.RightArrow) {
                root.kb_active = true;
                if (root.kb_zone == 0 && !root.narrow) {
                    root.kb_nav = NavState.step(root.kb_nav, e.text == Key.LeftArrow ? -1 : 1, false);
                }
                accept
            } else if (e.text == Key.UpArrow) {
                root.kb_active = true;
                if InterfaceStyle.tv && root.licenses_open && root.kb_zone == 2 {
                    about_scroll.content-y = Math.min(root.legal-entry-y, about_scroll.content-y + about_scroll.visible-height * 0.72);
                    if about_scroll.content-y >= root.legal-entry-y { root.kb_zone = 1; }
                } else if (root.licenses_open && root.kb_zone == 1 && root.source_index > 0) {
                    root.step_source(-1);
                } else if !root.licenses_open && root.kb_zone == 1 && root.about_action > 0 {
                    root.step_about(-1);
                } else { root.kb_zone = 0; }
                accept
            } else if (e.text == Key.DownArrow || e.text == Key.Tab) {
                root.kb_active = true;
                if (root.kb_zone == 0) { root.kb_zone = 1; }
                else if InterfaceStyle.tv && root.licenses_open && (root.kb_zone == 2 || root.source_index >= root.license_sources.length - 1) {
                    // After the source actions, remote arrows page through the
                    // legal document. Keep the source position for the return.
                    if root.kb_zone != 2 { root.legal-entry-y = about_scroll.content-y; root.kb_zone = 2; }
                    about_scroll.content-y = Math.max(Math.min(0px, about_scroll.visible-height - about_scroll.content-height), about_scroll.content-y - about_scroll.visible-height * 0.72);
                } else if (root.licenses_open) {
                    root.step_source(1);
                } else { root.step_about(1); }
                accept
            } else if ((e.text == Key.Return || e.text == " ") && e.repeat) {
                accept
            } else if (e.text == Key.Return || e.text == " ") {
                root.kb_active = true;
                if (root.kb_zone == 0) {
                    if (root.narrow) { root.back(); }
                    else if (root.kb_nav == 0) { root.home_picked(); }
                    else if (root.kb_nav == 1) { root.discover_picked(); }
                    else if (root.kb_nav == 2) { root.library_picked(); }
                    else if (root.kb_nav == 3) { root.more_picked(); }
                    else if root.kb_nav == 4 { NavState.calendar_picked(); }
                    else { NavState.downloads_picked(); }
                } else if (!root.licenses_open) {
                    if root.about_action == 0 { root.open_licenses(); }
                    else if root.about_action == 1 && root.update_checks_enabled && !root.update_is_development { root.update_automatic_changed(!root.update_automatic); }
                    else if root.about_action == 2 && root.update_checks_enabled && root.update_status != 1 { root.update_check_requested(); }
                    else if root.about_action == 3 && root.update_available { root.update_release_requested(); }
                }
                else if (root.kb_zone != 2 && root.source_index < root.license_sources.length) {
                    root.license_source_requested(root.license_sources[root.source_index].url);
                }
                accept
            } else { reject }
        }
    }

    VerticalLayout {
        padding-left: 18px + root.safe-left + root.rail_w;
        padding-right: 18px + root.safe-right;
        padding-top: 18px + root.safe-top;
        padding-bottom: 18px + root.safe-bottom;
        spacing: 12px;
        SettingsHeader {
            title: root.licenses_open ? @tr("Licenses") : @tr("About");
            introduction: root.licenses_open ? @tr("Open-source components and license texts") : @tr("Information about Nova");
            back_focused: root.narrow && root.kb_zone == 0 && root.kb_active;
            back => { root.back(); }
        }
        // Keep the legal model and its variable-height layout cache alive
        // while About is shown. Replacing it with one About row loses the
        // native ListView height estimate and changes the restored pixel offset.
        body := Rectangle {
          vertical-stretch: 1; min-height: 0px;
          clip: true;
          about_scroll := ListView {
            visible: root.licenses_open || root.licenses_progress > 0;
            enabled: root.active && root.licenses_open;
            x: body.width * (1.0 - root.licenses_progress);
            opacity: root.licenses_progress;
            width: 100%; height: 100%;
            mouse-drag-pan-enabled: root.active && root.licenses_open;
            horizontal-scrollbar-policy: always-off;
            vertical-scrollbar-policy: always-off;
            content-width: self.visible-width;
            changed content-y => {
                if root.licenses_open && !root.restore_pending {
                    root.licenses_scroll_y = self.content-y;
                }
            }
            for index in (root.license_sources.length + root.license_text_chunks.length + 3): row := Rectangle {
                width: about_scroll.visible-width;
                private property <int> source_index: index - 2;
                private property <bool> is_source: index >= 2 && index < root.license_sources.length + 2;
                // Adjacent text chunks continue the same document; only
                // section and source rows reserve an inter-item gap.
                height: content.preferred-height + (index >= root.license_sources.length + 3 ? 0px : 16px);
                content := VerticalLayout {
                    width: 100%; spacing: 16px;
                    if index == 0: Text {
                        min-width: 0px;
                        text: @tr("Nova is licensed under GPL-3.0-or-later. This page lists the Rust crates used by this build, Nova's workspace crates, bundled native media components, and their license texts.");
                        font-size: InterfaceStyle.tv ? 20px : 14px; color: Theme.current.text_settings; wrap: word-wrap;
                    }
                    if index == 1: SectionHeader {
                        icon-kind: 6; label: @tr("SOURCE CODE");
                    }
                    if row.is_source: source_card := Rectangle {
                        width: 100%;
                        background: Theme.current.card;
                        private property <bool> stacked: self.width < 440px;
                        private property <bool> selected: root.source_index == row.source_index;
                        private property <length> selected_top: self.absolute-position.y;
                        private property <length> selected_bottom: self.absolute-position.y + self.height;
                        function publish_position() {
                            if self.selected {
                                root.selected_source_top = self.selected_top;
                                root.selected_source_bottom = self.selected_bottom;
                            }
                        }
                        init => { self.publish_position(); }
                        changed selected => { self.publish_position(); }
                        changed selected_top => { self.publish_position(); }
                        changed selected_bottom => { self.publish_position(); }
                        // Measure the visible text at its actual width. Source
                        // actions move below on phones so crate names and SPDX
                        // expressions retain a readable lane.
                        height: Math.max(72px, source_text.preferred-height + 24px + (self.stacked ? source_view_button.height + 10px : 0px));
                        border-radius: 8px;
                        source_text := VerticalLayout {
                            x: 12px;
                            y: source_card.stacked ? 12px : (source_card.height - self.preferred-height) / 2;
                            width: Math.max(0px, source_card.width - 24px - (source_card.stacked ? 0px : source_view_button.width + 10px));
                            height: self.preferred-height;
                            min-width: 0px; spacing: 2px;
                            Text {
                                text: root.license_sources[row.source_index].label; font-size: InterfaceStyle.tv ? 20px : 14px;
                                color: Theme.current.text_bright; wrap: char-wrap; min-width: 0px;
                            }
                            Text {
                                text: root.license_sources[row.source_index].license; font-size: InterfaceStyle.tv ? 20px : 14px;
                                color: Theme.current.text_settings; wrap: char-wrap; min-width: 0px;
                            }
                        }
                        source_view_button := PillButton {
                            enabled: root.active && root.licenses_open;
                            x: source_card.width - self.width - 12px;
                            y: source_card.stacked ? source_text.y + source_text.height + 10px : (source_card.height - self.height) / 2;
                            label: @tr("Open source");
                            roomy: true; compact: root.narrow;
                            focused: root.licenses_open && root.kb_zone == 1 && root.source_index == row.source_index && root.kb_active;
                            clicked => {
                                root.kb_active = SettingsStyle.keyboard-mode;
                                root.kb_zone = 1;
                                root.source_index = row.source_index;
                                root.license_source_requested(root.license_sources[row.source_index].url);
                            }
                        }
                    }

                    if index == root.license_sources.length + 2: SectionHeader {
                        icon-kind: 6; label: @tr("LICENSE TEXTS");
                    }
                    if index >= root.license_sources.length + 3: license_chunk := Text {
                        accessible-id: "license-chunk-" + (index - root.license_sources.length - 3);
                        min-width: 0px;
                        text: root.license_text_chunks[index - root.license_sources.length - 3];
                        font-size: InterfaceStyle.tv ? 20px : 14px; color: Theme.current.text_settings;
                        wrap: char-wrap;
                    }
                }
            }
          }
          about_info_scroll := ScrollView {
            visible: !root.licenses_open || root.licenses_progress < 1;
            enabled: root.active && !root.licenses_open;
            x: -0.28 * body.width * root.licenses_progress;
            opacity: 1.0 - root.licenses_progress;
            width: 100%; height: 100%;
            mouse-drag-pan-enabled: root.active && !root.licenses_open;
            content-width: self.visible-width;
            content-height: about_info_content.preferred-height;
            changed content-y => {
                if !root.licenses_open && !root.restore_pending { root.scroll_y = self.content-y; }
            }
                    about_info_content := VerticalLayout {
                        // Keep spare viewport space below the cards instead of
                        // distributing it between their text and controls.
                        width: 100%; height: self.preferred-height;
                        alignment: start; spacing: 16px;
                    SectionHeader { label: @tr("App information"); }
                    SettingsCard { VerticalLayout { padding: 16px; spacing: 16px;
                            Text {
                                width: 100%;
                                text: @tr("Nova is a media catalog and player application.");
                                font-size: InterfaceStyle.tv ? 20px : 14px;
                                color: Theme.current.text_settings;
                                wrap: word-wrap;
                            }

                            app_version_label := Text {
                                text: @tr("Version") + " " + root.app_version;
                                accessible-id: "about-version";
                                font-size: InterfaceStyle.tv ? 20px : 14px;
                                color: Theme.current.text_secondary;
                                wrap: word-wrap;
                            }
                            about_licenses_button := PillButton {
                                enabled: root.active && !root.licenses_open;
                                label: @tr("Licenses");
                                roomy: true;
                                focused: !root.licenses_open && root.kb_zone == 1 && root.about_action == 0 && root.kb_active;
                                clicked => {
                                    root.kb_active = SettingsStyle.keyboard-mode;
                                    root.kb_zone = 1;
                                    root.open_licenses();
                                }
                            }
                        } }
                    SectionHeader { label: @tr("Updates"); }
                    SettingsCard { VerticalLayout { padding: 16px; spacing: 16px;
                        Text {
                            text: !root.update_checks_enabled ? @tr("Update checks are disabled in this build.")
                                : root.update_status == 1 ? @tr("Checking for updates…")
                                : root.update_status == 2 ? @tr("You’re up to date.")
                                : root.update_status == 3 ? @tr("A new Nova is available") + " · " + root.update_latest_version
                                : root.update_status == 4 ? @tr("Could not check for updates. Try again later.")
                                : root.update_status == 5 ? @tr("GitHub is limiting requests. Try again later.")
                                : root.update_is_development ? @tr("Development builds do not check automatically.")
                                : @tr("Nova checks GitHub for new releases once a day.");
                            font-size: InterfaceStyle.tv ? 20px : 14px;
                            color: Theme.current.text_settings;
                            wrap: word-wrap;
                        }
                        if root.update_checks_enabled: HorizontalLayout {
                            spacing: 16px;
                            Text {
                                text: @tr("Automatically check for updates");
                                font-size: InterfaceStyle.tv ? 20px : 14px;
                                color: Theme.current.text_settings;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            ToggleSwitch {
                                name: @tr("Automatically check for updates");
                                checked: root.update_automatic;
                                enabled: root.active && !root.licenses_open && !root.update_is_development;
                                focused: root.kb_zone == 1 && root.about_action == 1 && root.kb_active;
                                toggled => { root.update_automatic_changed(self.checked); }
                            }
                        }
                        if root.update_checks_enabled: VerticalLayout {
                            spacing: 8px;
                            PillButton {
                                label: @tr("Check for updates");
                                enabled: root.active && !root.licenses_open && root.update_status != 1;
                                focused: root.kb_zone == 1 && root.about_action == 2 && root.kb_active;
                                wrap_label: true;
                                clicked => { root.about_action = 2; root.update_check_requested(); }
                            }
                            if root.update_available: PillButton {
                                enabled: root.active && !root.licenses_open;
                                label: @tr("View release"); primary: true;
                                focused: root.kb_zone == 1 && root.about_action == 3 && root.kb_active;
                                wrap_label: true;
                                clicked => { root.about_action = 3; root.update_release_requested(); }
                            }
                        }
                    } }
                    }
          }
          // Both models stay visible during motion; don't let a faded pane
          // capture input intended for the incoming page.
          if root.licenses_progress > 0 && root.licenses_progress < 1: TouchArea {
            width: 100%; height: 100%;
            clicked => { }
            scroll-event(event) => { accept }
          }
        }
    }

    if !root.narrow && !root.external_navigation: rail := SideNav {
        viewport-width: root.nav-viewport-width;
        panel-background: transparent;
        active: 3;
        safe-top: root.safe-top;
        safe-left: root.safe-left;
        safe-bottom: root.safe-bottom;
        kb_zone: root.kb_zone;
        kb_nav: root.kb_nav;
        kb_active <=> root.kb_active;
        home_picked => { root.home_picked(); }
        discover_picked => { root.discover_picked(); }
        library_picked => { root.library_picked(); }
        more_picked => { root.more_picked(); }
    }
    if !root.active: TouchArea {
        width: 100%; height: 100%;
        clicked => { }
        scroll-event(event) => { accept }
    }
}
