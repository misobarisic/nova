import { InterfaceStyle, Theme, Anim, NavMetrics, NavState } from "@NovaUiShared";

import { ScrollView } from "scrollview.slint";
import { IcHome, IcExplore, IcVideoLibrary, IcMoreHoriz, IcCalendar, IcDownload } from "icons.slint";


// Wide navigation keeps compact icons in Standard mode and visible labels on TV.
// It shares selection state and icon feedback with the phone bar. Most root
// pages host their own rail; AppWindow hosts one stationary rail for More and
// its children. NavMetrics.width-for() reserves the matching wide footprint.
//
// Wide subpages keep the rail (unlike the narrow bottom bar, which hides on
// the Home subpages and throughout Settings/About): on a desktop the rail is window chrome, not
// page chrome. The detail modal and the player cover it, as they always did.
//
// Shared geometry keeps the rail and page content using the same footprint.


// Navigation state shared by the two bars (SideNav here, BottomNav on
// narrow). Rebuilt bars consume the section being left to avoid replaying
// selection feedback on Detail return or resize. The stationary More-family
// rail observes active selection changes directly.


// Shared icon-only feedback for both responsive bars. The highlight snaps
// immediately; the incoming icon grows by at most 2px and settles in place.
export component NavFeedback inherits Rectangle {
    in property <int> active: 0;
    width: 0px;
    height: 0px;
    out property <float> pulse: feedback && motion_enabled ? 4 * progress * (1 - progress) : 0.0;
    private property <bool> entered: false;
    private property <int> last_active: 0;
    private property <bool> initialized: false;
    private property <float> progress: root.entered ? 1.0 : 0.0;
    private property <bool> feedback: false;
    private property <bool> motion_enabled: Anim.enabled && Anim.nav_slide;
    animate progress { duration: root.entered ? Anim.nav_feedback : 0ms; easing: ease-out; }

    init => {
        root.feedback = root.motion_enabled && NavState.from != root.active;
        root.last_active = root.active;
        root.initialized = true;
        NavState.from = root.active;
        if (root.feedback) { go.start(); } else { root.entered = true; }
    }
    changed active => {
        // Persistent chrome observes selection changes without reconstruction.
        if (!root.initialized || root.last_active == root.active) { return; }
        go.stop();
        root.feedback = root.motion_enabled && root.last_active != root.active;
        root.last_active = root.active;
        NavState.from = root.active;
        root.entered = false;
        if (root.feedback) { go.start(); } else { root.entered = true; }
    }
    changed motion_enabled => {
        if (!root.motion_enabled) { go.stop(); root.feedback = false; root.entered = true; }
    }
    go := Timer {
        interval: 16ms; running: false;
        triggered => { self.stop(); root.entered = true; }
    }
}

component SideItem inherits Rectangle {
    // 0 Home, 1 Discover, 2 Library, 3 More, 4 Calendar, 5 Downloads.
    in property <int> kind: 0;
    in property <bool> active: false;
    // Keyboard cursor (arrow-key nav, zone 0). Drawn as a ring on the icon
    // circle instead of the bottom bar's "▶" KbMark: that marker is a
    // horizontal-layout row and would consume a row of the rail's height.
    in property <bool> kb_focused: false;
    in property <float> pop: 0.0;

    callback picked();

    accessible-role: button;
    accessible-label: root.kind == 0 ? @tr("Home") : root.kind == 1 ? @tr("Discover") : root.kind == 2 ? @tr("Library") : root.kind == 3 ? @tr("More") : root.kind == 4 ? @tr("Calendar") : @tr("Downloads");

    height: InterfaceStyle.tv ? 72px : 56px;

    // Only the hover fill and keyboard ring live here; SideNav owns the
    // shared highlight. The entire item slot remains clickable.
    Rectangle {
        width: InterfaceStyle.tv ? parent.width - 16px : 48px;
        height: InterfaceStyle.tv ? 64px : 48px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: (root.active || root.kb_focused || item_focus.has-focus) ? transparent : (item_touch.has-hover ? Theme.current.control_hover : transparent);
        border-radius: 24px;
        border-width: root.kb_focused || item_focus.has-focus ? 2px : 0px;
        border-color: Theme.current.text_bright;

        if root.kind == 0: icon_home := IcHome {
            x: InterfaceStyle.tv ? 12px : (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: (InterfaceStyle.tv ? 28px : 24px) + root.pop * 2px;
            height: self.width;
            fill: root.active ? Theme.current.on_accent : Theme.current.text_muted;
        }
        if root.kind == 1: icon_discover := IcExplore {
            x: InterfaceStyle.tv ? 12px : (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: (InterfaceStyle.tv ? 28px : 24px) + root.pop * 2px;
            height: self.width;
            fill: root.active ? Theme.current.on_accent : Theme.current.text_muted;
        }
        if root.kind == 2: icon_library := IcVideoLibrary {
            x: InterfaceStyle.tv ? 12px : (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: (InterfaceStyle.tv ? 28px : 24px) + root.pop * 2px;
            height: self.width;
            fill: root.active ? Theme.current.on_accent : Theme.current.text_muted;
        }
        if root.kind == 3: icon_more := IcMoreHoriz {
            x: InterfaceStyle.tv ? 12px : (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: (InterfaceStyle.tv ? 28px : 24px) + root.pop * 2px;
            height: self.width;
            fill: root.active ? Theme.current.on_accent : Theme.current.text_muted;
        }
        if root.kind == 4: icon_calendar := IcCalendar {
            x: InterfaceStyle.tv ? 12px : (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: (InterfaceStyle.tv ? 28px : 24px) + root.pop * 2px;
            height: self.width;
            fill: root.active ? Theme.current.on_accent : Theme.current.text_muted;
        }
        if root.kind == 5: icon_download := IcDownload {
            x: InterfaceStyle.tv ? 12px : (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: (InterfaceStyle.tv ? 28px : 24px) + root.pop * 2px;
            height: self.width;
            fill: root.active ? Theme.current.on_accent : Theme.current.text_muted;
        }
        if InterfaceStyle.tv: Text {
            x: 48px; y: 0px; width: parent.width - 54px; height: 100%;
            text: root.accessible-label;
            font-size: 18px; font-weight: root.active || root.kb_focused ? 600 : 400;
            color: root.active ? Theme.current.on_accent : Theme.current.text_primary;
            vertical-alignment: center; overflow: elide;
        }
    }

    item_focus := FocusScope { width: 100%; height: 100%; key-pressed(e) => { if e.text == Key.Return || e.text == " " { if !e.repeat { root.picked(); } accept } else { reject } } }

    item_touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

export component SideNav inherits Rectangle {
    // Active section: 0 Home, 1 Discover, 2 Library, 3 More, 4 Calendar, 5 Downloads.
    in property <int> active: 0;
    in property <brush> panel-background: Theme.current.nav_rail;
    // Use the hosting page's width, not this component's own footprint.
    in property <length> viewport-width;
    // Window insets: the rail is anchored to the window's left edge, so it
    // clears the status bar / a landscape cutout itself. 0 on desktop.
    in property <length> safe-top: 0px;
    in property <length> safe-left: 0px;
    in property <length> safe-bottom: 0px;
    in property <int> kb_zone;
    in property <int> kb_nav;
    in-out property <bool> kb_active;

    callback home_picked();
    callback discover_picked();
    callback library_picked();
    callback more_picked();

    motion := NavFeedback { active: root.active; }

    // Fixed footprint: the hosting page reserves this same width on its
    // left through NavMetrics.width-for(). Safe area is
    // added here only — the page's own `safe-left` padding then reads as the
    // gap between rail and content.
    //
    // x/y are set here because the pages place the rail as a plain child of
    // their (non-layout) root: Slint centres such children by default, which
    // would float the rail into the middle of the window.
    x: 0px;
    y: 0px;
    width: NavMetrics.width-for(root.viewport-width) + root.safe-left;
    height: 100%;

    // Eats stray taps in the rail strip (the hosting page's left padding):
    // plain Rectangles don't consume taps in Slint, so without it those taps
    // would reach the content underneath. Same rationale as BottomNav's eater.
    eater := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { }
    }

    // Panel: a plain full-bleed column — no outer margin, no rounded corners
    // — spanning from the window's left edge to its bottom edge, with the
    // six items listed top to bottom just under the top. Flush against the
    // window edges a rounded corner would only read as a bug.
    rail_scroll := ScrollView {
        x: 0px; y: 0px; width: 100%; height: 100%;
        content-width: self.visible-width;
        content-height: Math.max(self.visible-height, (InterfaceStyle.tv ? 448px : 352px) + root.safe-top + root.safe-bottom);
        mouse-drag-pan-enabled: true;
    panel := Rectangle {
        x: root.safe-left;
        y: root.safe-top;
        width: root.width - root.safe-left - 8px;
        height: Math.max(root.height - root.safe-top - root.safe-bottom, InterfaceStyle.tv ? 448px : 352px);
        background: root.panel-background;
        border-width: 0px;

        // The selected circle is positioned by
        // the item index (56px item pitch, 8px panel padding), with no glide.
        // Declared before the item column, which draws the icons over it.
        marker_dot := Rectangle {
            x: InterfaceStyle.tv ? 8px : (parent.width - self.width) / 2;
            // Centred inside the item slot, like the item's own 48px ring:
            // the 4px is half of the 8px the 48px circle leaves in a 56px item.
            y: 8px + ((InterfaceStyle.tv ? 72px : 56px) - self.height) / 2 + (root.active == 3 ? 5 : root.active >= 4 ? root.active - 1 : root.active) * (InterfaceStyle.tv ? 72px : 56px);
            width: InterfaceStyle.tv ? parent.width - 16px : 48px;
            height: InterfaceStyle.tv ? 64px : 48px;
            border-radius: 24px;
            background: Theme.current.accent;
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            // Inside the panel, along the main axis: the first/last item keeps
            // a little air from the panel's edges.
            padding-top: 8px;
            padding-bottom: 8px;

            SideItem {
                kind: 0;
                active: root.active == 0;
                pop: root.active == 0 ? motion.pulse : 0.0;
                kb_focused: root.kb_zone == 0 && root.kb_nav == 0 && root.kb_active;
                picked => { root.kb_active = false; root.home_picked(); }
            }

            SideItem {
                kind: 1;
                active: root.active == 1;
                pop: root.active == 1 ? motion.pulse : 0.0;
                kb_focused: root.kb_zone == 0 && root.kb_nav == 1 && root.kb_active;
                picked => { root.kb_active = false; root.discover_picked(); }
            }

            SideItem {
                kind: 2;
                active: root.active == 2;
                pop: root.active == 2 ? motion.pulse : 0.0;
                kb_focused: root.kb_zone == 0 && root.kb_nav == 2 && root.kb_active;
                picked => { root.kb_active = false; root.library_picked(); }
            }

            SideItem { kind: 4; active: root.active == 4; pop: root.active == 4 ? motion.pulse : 0.0; kb_focused: root.kb_zone == 0 && root.kb_nav == 4 && root.kb_active; picked => { root.kb_active = false; NavState.calendar_picked(); } }
            SideItem { kind: 5; active: root.active == 5; pop: root.active == 5 ? motion.pulse : 0.0; kb_focused: root.kb_zone == 0 && root.kb_nav == 5 && root.kb_active; picked => { root.kb_active = false; NavState.downloads_picked(); } }
            SideItem { kind: 3; active: root.active == 3; pop: root.active == 3 ? motion.pulse : 0.0; kb_focused: root.kb_zone == 0 && root.kb_nav == 3 && root.kb_active; picked => { root.kb_active = false; root.more_picked(); } }
        }
    }
    }
}
