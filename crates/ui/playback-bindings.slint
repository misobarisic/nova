import { PlayerOsdBridge, OnboardingBridge, PlayerStatsRow, TrackRow, ChapterRow, SceneBookmarkRow } from "@NovaUiShared";
// Connect backend aliases once for the AppWindow lifetime. Conditional hosts
// must never reconnect an already-joined backend/global property pool.

export component PlayerOsdBindings {
    in-out property <bool> next_episode_button_available <=> PlayerOsdBridge.next_episode_button_available;
    in-out property <string> next_episode_button_token <=> PlayerOsdBridge.next_episode_button_token;
    in-out property <bool> stats_visible <=> PlayerOsdBridge.stats_visible;
    in-out property <[PlayerStatsRow]> stats_rows <=> PlayerOsdBridge.stats_rows;
    in-out property <string> stats_notice <=> PlayerOsdBridge.stats_notice;
    // This lifetime outlasts the visual OSD: closing playback must still stop
    // the diagnostics sampler after the page has been unmounted.
    changed stats_visible => { PlayerOsdBridge.stats_visibility_changed(root.stats_visible); }
    in-out property <[TrackRow]> secondary_sub_tracks <=> PlayerOsdBridge.secondary_sub_tracks;
    in-out property <string> secondary_sub_track_label <=> PlayerOsdBridge.secondary_sub_track_label;
    in-out property <int> secondary_subtitle_position_index <=> PlayerOsdBridge.secondary_subtitle_position_index;
    in-out property <[SceneBookmarkRow]> scene_bookmarks <=> PlayerOsdBridge.scene_bookmarks;
    in-out property <bool> scene_bookmarks_available <=> PlayerOsdBridge.scene_bookmarks_available;
    in-out property <string> scene_bookmark_notice <=> PlayerOsdBridge.scene_bookmark_notice;
    in-out property <bool> try_another_stream_available <=> PlayerOsdBridge.try_another_stream_available;
    in-out property <bool> automatic_stream_recovery_visible <=> PlayerOsdBridge.automatic_stream_recovery_visible;
    in-out property <int> intro_skip_override_index <=> PlayerOsdBridge.intro_skip_override_index;
    in-out property <int> skip_segment_kind <=> PlayerOsdBridge.skip_segment_kind;
    in-out property <bool> playback_started <=> PlayerOsdBridge.playback_started;
    in-out property <bool> is_paused <=> PlayerOsdBridge.is_paused;
    in-out property <float> position <=> PlayerOsdBridge.position;
    in-out property <float> duration <=> PlayerOsdBridge.duration;
    in-out property <float> buffered_until <=> PlayerOsdBridge.buffered_until;
    in-out property <[ChapterRow]> player_chapters <=> PlayerOsdBridge.player_chapters;
    in-out property <string> time_text <=> PlayerOsdBridge.time_text;
    in-out property <string> player_status <=> PlayerOsdBridge.player_status;
    in-out property <string> player_title <=> PlayerOsdBridge.player_title;
    in-out property <string> player_episode_title <=> PlayerOsdBridge.player_episode_title;
    in-out property <string> player_show_title <=> PlayerOsdBridge.player_show_title;
    in-out property <[string]> player_badges <=> PlayerOsdBridge.player_badges;
    in-out property <string> player_media_summary <=> PlayerOsdBridge.player_media_summary;
    in-out property <bool> screenshot_busy <=> PlayerOsdBridge.screenshot_busy;
    in-out property <string> screenshot_notice <=> PlayerOsdBridge.screenshot_notice;
    in-out property <string> decode_label <=> PlayerOsdBridge.decode_label;
    in-out property <int> decoder_selected <=> PlayerOsdBridge.decoder_selected;
    in-out property <string> sub_label <=> PlayerOsdBridge.sub_label;
    in-out property <string> audio_label <=> PlayerOsdBridge.audio_label;
    in-out property <float> volume <=> PlayerOsdBridge.volume;
    in-out property <bool> muted <=> PlayerOsdBridge.muted;
    in-out property <float> playback_speed <=> PlayerOsdBridge.playback_speed;
    in-out property <[float]> subtitle_style <=> PlayerOsdBridge.subtitle_style;
    in-out property <float> player_brightness <=> PlayerOsdBridge.player_brightness;
    in-out property <bool> is_fullscreen <=> PlayerOsdBridge.is_fullscreen;
    in-out property <[TrackRow]> audio_tracks <=> PlayerOsdBridge.audio_tracks;
    in-out property <[TrackRow]> sub_tracks <=> PlayerOsdBridge.sub_tracks;
    in-out property <int> subtitle_addon_status <=> PlayerOsdBridge.subtitle_addon_status;
    in-out property <bool> osd_visible <=> PlayerOsdBridge.osd_visible;
    in-out property <image> player_poster <=> PlayerOsdBridge.player_poster;
    in-out property <image> player_logo <=> PlayerOsdBridge.player_logo;
    in-out property <bool> player_status_is_error <=> PlayerOsdBridge.player_status_is_error;
    in-out property <bool> show_stream_loading_text <=> PlayerOsdBridge.show_stream_loading_text;
    in-out property <bool> kb_active <=> PlayerOsdBridge.kb_active;
}

export component OnboardingBindings {
    in-out property <int> step <=> OnboardingBridge.step;
    in-out property <int> language_index <=> OnboardingBridge.language_index;
    in-out property <bool> true_black <=> OnboardingBridge.true_black;
    in-out property <string> addon_url <=> OnboardingBridge.addon_url;
    in-out property <int> audio_index <=> OnboardingBridge.audio_index;
    in-out property <int> subtitle_index <=> OnboardingBridge.subtitle_index;
}
