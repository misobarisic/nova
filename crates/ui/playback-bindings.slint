import { PlayerOsdBridge, OnboardingBridge, TrackRow } from "@NovaUiShared";
// Connect backend aliases once for the AppWindow lifetime. Conditional hosts
// must never reconnect an already-joined backend/global property pool.

export component PlayerOsdBindings {
    in-out property <bool> playback_started <=> PlayerOsdBridge.playback_started;
    in-out property <bool> is_paused <=> PlayerOsdBridge.is_paused;
    in-out property <float> position <=> PlayerOsdBridge.position;
    in-out property <float> duration <=> PlayerOsdBridge.duration;
    in-out property <string> time_text <=> PlayerOsdBridge.time_text;
    in-out property <string> player_status <=> PlayerOsdBridge.player_status;
    in-out property <string> player_title <=> PlayerOsdBridge.player_title;
    in-out property <string> player_episode_title <=> PlayerOsdBridge.player_episode_title;
    in-out property <string> player_show_title <=> PlayerOsdBridge.player_show_title;
    in-out property <image> player_show_logo <=> PlayerOsdBridge.player_show_logo;
    in-out property <bool> screenshot_busy <=> PlayerOsdBridge.screenshot_busy;
    in-out property <string> screenshot_notice <=> PlayerOsdBridge.screenshot_notice;
    in-out property <string> decode_label <=> PlayerOsdBridge.decode_label;
    in-out property <int> decoder_selected <=> PlayerOsdBridge.decoder_selected;
    in-out property <string> sub_label <=> PlayerOsdBridge.sub_label;
    in-out property <string> audio_label <=> PlayerOsdBridge.audio_label;
    in-out property <float> volume <=> PlayerOsdBridge.volume;
    in-out property <bool> muted <=> PlayerOsdBridge.muted;
    in-out property <float> playback_speed <=> PlayerOsdBridge.playback_speed;
    in-out property <float> player_brightness <=> PlayerOsdBridge.player_brightness;
    in-out property <bool> is_fullscreen <=> PlayerOsdBridge.is_fullscreen;
    in-out property <[TrackRow]> audio_tracks <=> PlayerOsdBridge.audio_tracks;
    in-out property <[TrackRow]> sub_tracks <=> PlayerOsdBridge.sub_tracks;
    in-out property <bool> osd_visible <=> PlayerOsdBridge.osd_visible;
    in-out property <image> scrim_image <=> PlayerOsdBridge.scrim_image;
    in-out property <image> player_poster <=> PlayerOsdBridge.player_poster;
    in-out property <bool> kb_active <=> PlayerOsdBridge.kb_active;
}

export component OnboardingBindings {
    in-out property <int> step <=> OnboardingBridge.step;
    in-out property <int> language_index <=> OnboardingBridge.language_index;
    in-out property <bool> true_black <=> OnboardingBridge.true_black;
    in-out property <string> addon_url <=> OnboardingBridge.addon_url;
    in-out property <int> audio_index <=> OnboardingBridge.audio_index;
    in-out property <int> subtitle_index <=> OnboardingBridge.subtitle_index;
}
