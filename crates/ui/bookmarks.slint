import { BookmarksBridge, Theme, InterfaceStyle, SettingsStyle, ControlInput, Anim } from "@NovaUiShared";
import { PageHeader } from "page-header.slint";
import { ScrollView } from "scrollview.slint";
import { SearchField } from "searchfield.slint";
import { PillButton } from "settings-controls.slint";
import { ControlTouchArea } from "control-input.slint";
import { IcBookmarkBorder } from "icons.slint";

component SceneAction inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> primary;
    in property <bool> destructive;
    in property <bool> enabled: true;
    in property <length> viewport-width;
    callback clicked();
    callback focus-entered();
    private property <length> target: InterfaceStyle.tv ? 56px : 44px;
    preferred-width: Math.max(root.target, natural_label.preferred-width + 56px);
    width: self.preferred-width;
    height: Math.max(root.target, action_label.preferred-height + 16px);
    horizontal-stretch: 0; vertical-stretch: 0;
    border-radius: Theme.button_corner_radius;
    border-width: action_focus.has-focus && SettingsStyle.keyboard-mode ? 2px : 1px;
    border-color: action_focus.has-focus && SettingsStyle.keyboard-mode ? Theme.current.focus_ring : Theme.current.control_border;
    background: root.primary ? (touch.feedback-active ? Theme.current.accent_hover : Theme.current.accent)
        : root.destructive ? (touch.feedback-active ? Theme.current.destructive_control_hover : Theme.current.destructive_control)
        : touch.feedback-active ? Theme.current.settings_control_hover : Theme.current.settings_control;
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    natural_label := Text { width: 0px; height: 0px; text: root.label; font-size: InterfaceStyle.tv ? 20px : 13px; }
    Image {
        x: 14px;
        y: (parent.height - self.height) / 2;
        width: 20px; height: 20px; source: root.icon; image-fit: contain;
        colorize: root.primary ? Theme.current.on_accent : root.destructive ? Theme.current.text_destructive : Theme.current.text_settings;
    }
    action_label := Text {
        x: 42px; y: 8px; width: Math.max(1px, parent.width - 56px); height: parent.height - 16px;
        text: root.label; font-size: InterfaceStyle.tv ? 20px : 13px;
        color: root.primary ? Theme.current.on_accent : root.destructive ? Theme.current.text_destructive : Theme.current.text_settings;
        wrap: word-wrap; vertical-alignment: center;
    }
    action_focus := FocusScope {
        enabled: root.enabled;
        changed has-focus => { if self.has-focus { root.focus-entered(); } }
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " || (root.destructive && e.text == Key.Delete) {
                if !e.repeat { root.clicked(); } accept
            } else { reject }
        }
    }
    touch := ControlTouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        clicked => { SettingsStyle.keyboard-mode = false; root.clicked(); }
    }
    private property <bool> wants_tip: root.enabled
        && ((!ControlInput.touch-feedback && touch.has-hover) || (action_focus.has-focus && SettingsStyle.keyboard-mode));
    private property <bool> tip_open;
    changed wants_tip => {
        tooltip_delay.stop(); root.tip_open = false;
        if root.wants_tip { tooltip_delay.start(); }
    }
    tooltip_delay := Timer { interval: 400ms; running: false; triggered => { self.stop(); root.tip_open = root.wants_tip; } }
    if root.tip_open: Rectangle {
        width: Math.min(Math.max(1px, root.viewport-width - 16px), natural_label.preferred-width + 20px);
        height: tooltip_text.preferred-height + 14px;
        x: Math.max(8px - root.absolute-position.x, Math.min((root.width - self.width) / 2, root.viewport-width - root.absolute-position.x - self.width - 8px));
        y: -self.height - 8px;
        background: Theme.current.popup; border-width: 1px; border-color: Theme.current.border_medium; border-radius: 6px;
        tooltip_text := Text { x: 10px; y: 7px; width: parent.width - 20px; text: root.label; font-size: 12px; color: Theme.current.text_primary; wrap: word-wrap; }
    }
    forward-focus: action_focus;
}

export component BookmarksPage inherits Rectangle {
    in property <bool> active;
    in property <bool> narrow;
    in property <length> safe-top;
    in property <length> safe-bottom;
    in property <length> safe-left;
    in property <length> safe-right;
    callback back();
    private property <int> selected: 0;
    private property <string> editing_id;
    private property <string> draft;
    private property <bool> detail: BookmarksBridge.title_id != "";
    private property <int> list_selected;
    private property <bool> restoring_list;
    private property <string> current_title: BookmarksBridge.title_id;
    private property <bool> returning;
    private property <bool> scene_motion: Anim.enabled && Anim.transitions;
    private property <float> scene_slide: 0.0;
    animate scene_slide { duration: root.scene_motion ? Anim.transition_slide : 0ms; easing: ease-out; }
    private property <float> scene_alpha: 0.0;
    animate scene_alpha { duration: root.scene_motion ? Anim.transition_fade : 0ms; }
    init => { root.scene_slide = root.detail ? 1.0 : 0.0; root.scene_alpha = root.detail ? 1.0 : 0.0; }
    // The title list stays mounted underneath so its scroll, search and sort
    // survive a scene visit. Keep the outgoing scenes alive until pop ends.
    changed current_title => {
        scene_return.stop(); root.returning = false; root.editing_id = "";
        root.restoring_list = !root.detail;
        if root.detail { list_restore.stop(); } else { list_restore.start(); }
        root.selected = root.detail ? 0 : root.list_selected;
        if root.detail { archive_scroll.content-y = 0px; }
        root.scene_slide = root.detail ? 1.0 : 0.0;
        root.scene_alpha = root.detail ? 1.0 : 0.0;
    }
    changed scene_motion => {
        if !root.scene_motion {
            if root.returning { root.finish_return(); }
            root.scene_slide = root.detail ? 1.0 : 0.0;
            root.scene_alpha = root.detail ? 1.0 : 0.0;
        }
    }
    changed active => {
        if root.active { page_focus.focus(); }
        else {
            scene_return.stop(); list_restore.stop(); root.returning = false; root.restoring_list = false; root.editing_id = "";
            root.scene_slide = root.detail ? 1.0 : 0.0;
            root.scene_alpha = root.detail ? 1.0 : 0.0;
        }
    }
    function enter_title(id: string, index: int) {
        if !root.active || root.returning { return; }
        root.list_selected = index;
        BookmarksBridge.select_title(id); page_focus.focus();
    }
    function finish_return() {
        scene_return.stop(); root.returning = false; root.restoring_list = true;
        BookmarksBridge.select_title("");
        root.selected = root.list_selected;
        if root.active { page_focus.focus(); }
    }
    scene_return := Timer {
        interval: Math.max(Anim.transition_slide, Anim.transition_fade); running: false;
        triggered => { self.stop(); if root.returning && root.active { root.finish_return(); } }
    }
    // Restoring the title selection must not auto-scroll the retained list.
    list_restore := Timer { interval: 1ms; running: false; triggered => { self.stop(); root.restoring_list = false; } }
    public function focus_shell() { if root.active { page_focus.focus(); } }
    public function go_back() {
        if !root.active || root.returning { return; }
        if root.editing_id != "" { root.editing_id = ""; page_focus.focus(); }
        else if root.detail {
            root.returning = true; root.scene_slide = 0.0; root.scene_alpha = 0.0;
            page_focus.focus();
            if root.scene_motion { scene_return.start(); } else { root.finish_return(); }
        }
        else { root.back(); }
    }
    function remove_scene(id: string) {
        BookmarksBridge.remove(id);
        root.selected = Math.max(0, Math.min(root.selected, BookmarksBridge.scenes.length - 1));
        page_focus.focus();
    }
    function reveal(top: length, h: length) {
        if root.detail {
            if top < -archive_scroll.content-y { archive_scroll.content-y = -top; }
            else if top + h > archive_scroll.visible-height - archive_scroll.content-y {
                archive_scroll.content-y = Math.max(Math.min(0px, archive_scroll.visible-height - archive_scroll.content-height), archive_scroll.visible-height - top - h - 8px);
            }
        } else {
            if top < -title_scroll.content-y { title_scroll.content-y = -top; }
            else if top + h > title_scroll.visible-height - title_scroll.content-y {
                title_scroll.content-y = Math.max(Math.min(0px, title_scroll.visible-height - title_scroll.content-height), title_scroll.visible-height - top - h - 8px);
            }
        }
    }
    background: Theme.current.artwork_canvas;
    clip: true;
    page_focus := FocusScope {
        enabled: root.active; width: 100%; height: 100%;
        key-pressed(e) => {
            if root.returning { accept }
            else if e.text == Key.Back || e.text == Key.Escape || (e.text == Key.Backspace && root.editing_id == "") { if !e.repeat { root.go_back(); } accept }
            else if (e.text == Key.UpArrow || e.text == Key.DownArrow) && root.editing_id == "" {
                SettingsStyle.keyboard-mode = true;
                root.selected = Math.max(0, Math.min((root.detail ? BookmarksBridge.scenes.length : BookmarksBridge.titles.length) - 1, root.selected + (e.text == Key.UpArrow ? -1 : 1))); accept
            } else if (e.text == Key.Return || e.text == " ") && root.editing_id == "" {
                if !e.repeat && root.selected >= 0 {
                    if root.detail && root.selected < BookmarksBridge.scenes.length { BookmarksBridge.play(BookmarksBridge.scenes[root.selected].id); }
                    else if !root.detail && root.selected < BookmarksBridge.titles.length { root.enter_title(BookmarksBridge.titles[root.selected].id, root.selected); }
                } accept
            } else if e.text == Key.Delete && root.detail && root.editing_id == "" {
                if !e.repeat && root.selected >= 0 && root.selected < BookmarksBridge.scenes.length { root.remove_scene(BookmarksBridge.scenes[root.selected].id); } accept
            } else { reject }
        }
        title_scroll := ScrollView {
            x: root.safe-left + 18px; y: root.safe-top + 18px;
            width: Math.max(0px, root.width - root.safe-left - root.safe-right - 36px);
            height: Math.max(0px, root.height - root.safe-top - root.safe-bottom - 36px);
            content-width: self.visible-width;
            visible: !root.detail || root.scene_slide < 1.0 || root.scene_alpha < 1.0;
            opacity: root.detail ? 1.0 - root.scene_alpha * 0.35 : 1.0;
            // Retained content is paint-only while scenes own navigation.
            enabled: root.active && !root.detail && !root.returning;
            VerticalLayout {
                width: 100%; spacing: 16px; alignment: start;
                PageHeader {
                    title: @tr("Bookmarks");
                    subtitle: @tr("The scenes you wanted to come back to.");
                    narrow: root.narrow; show-back: true;
                    back => { root.go_back(); }
                }
                SearchField {
                    enabled: root.active && !root.detail && !root.returning;
                    text <=> BookmarksBridge.query;
                    placeholder-text: @tr("Search titles, episodes and notes");
                    roomy: true; prominent: true; min-width: 0px;
                    keyboard-mode: SettingsStyle.keyboard-mode;
                    edited(query) => { BookmarksBridge.query_changed(query); root.selected = 0; }
                    accepted(query) => { BookmarksBridge.query_changed(query); root.selected = 0; }
                }
                HorizontalLayout {
                    spacing: 8px; alignment: start;
                    PillButton { label: @tr("Latest added"); primary: BookmarksBridge.sort == 0; enabled: root.active && !root.detail && !root.returning; clicked => { BookmarksBridge.sort_changed(0); } }
                    PillButton { label: @tr("Title"); primary: BookmarksBridge.sort == 1; enabled: root.active && !root.detail && !root.returning; clicked => { BookmarksBridge.sort_changed(1); } }
                }
                if BookmarksBridge.notice != "": Text { text: BookmarksBridge.notice; color: Theme.current.text_destructive; font-size: 14px; wrap: word-wrap; min-width: 0px; }
                if BookmarksBridge.titles.length == 0: Rectangle {
                    background: Theme.current.card; border-radius: Theme.card_corner_radius;
                    height: empty.preferred-height + 48px;
                    empty := VerticalLayout {
                        padding: 24px; spacing: 12px;
                        Rectangle { height: 44px; IcBookmarkBorder { width: 36px; height: 36px; x: (parent.width - self.width) / 2; fill: Theme.current.accent_vivid; } }
                        Text { text: BookmarksBridge.query == "" ? @tr("Keep a moment worth revisiting") : @tr("No matching bookmarks"); color: Theme.current.text_bright; font-size: 22px; font-weight: 600; wrap: word-wrap; horizontal-alignment: center; min-width: 0px; }
                        Text { text: @tr("Save a scene from the player's bookmark menu. Movies and shows with saved scenes will appear here."); color: Theme.current.text_secondary; font-size: 14px; wrap: word-wrap; horizontal-alignment: center; min-width: 0px; }
                    }
                }
                VerticalLayout {
                    spacing: 12px;
                    for row[index] in BookmarksBridge.titles: title_card := Rectangle {
                        height: root.narrow ? 134px : 156px;
                        background: touch.feedback-active ? Theme.current.control_hover : Theme.current.card;
                        border-radius: Theme.card_corner_radius;
                        border-width: self.selected ? 2px : 1px;
                        border-color: self.selected ? Theme.current.accent_vivid : Theme.current.border_card;
                        accessible-role: button; accessible-label: row.title + " · " + row.count;
                        private property <bool> selected: (root.detail ? root.list_selected : root.selected) == index && SettingsStyle.keyboard-mode;
                        changed selected => { if self.selected && root.active && !root.detail && !root.restoring_list { root.reveal(self.absolute-position.y - title_scroll.absolute-position.y - title_scroll.content-y, self.height); } }
                        HorizontalLayout {
                            padding: 12px; spacing: 14px;
                            Rectangle {
                                width: root.narrow ? 70px : 86px; horizontal-stretch: 0;
                                border-radius: 8px; clip: true; background: Theme.current.episode_placeholder;
                                if row.has_poster: Image { width: 100%; height: 100%; source: row.poster; image-fit: cover; }
                                if !row.has_poster: IcBookmarkBorder { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 26px; height: 26px; fill: Theme.current.text_secondary; }
                            }
                            VerticalLayout {
                                min-width: 0px; spacing: 5px; alignment: center;
                                Text { text: row.title; color: Theme.current.text_bright; font-size: InterfaceStyle.tv ? 25px : 18px; font-weight: 600; wrap: word-wrap; max-lines: 2; overflow: elide; min-width: 0px; }
                                Text { text: row.context + " · " + row.count; color: Theme.current.accent_vivid; font-size: 12px; wrap: word-wrap; min-width: 0px; }
                                Text { text: row.added; color: Theme.current.text_secondary; font-size: 12px; wrap: word-wrap; min-width: 0px; }
                            }
                        }
                        touch := ControlTouchArea { enabled: root.active && !root.detail && !root.returning; mouse-cursor: pointer; clicked => { root.enter_title(row.id, index); } }
                    }
                }
                Text { text: @tr("Bookmarks and notes sync between devices using this profile. Dates show when bookmarks were added, in UTC. Older bookmarks may have no recorded added date."); color: Theme.current.text_muted; font-size: 12px; wrap: word-wrap; min-width: 0px; }
            }
        }
        if root.detail: TouchArea {
            width: 100%; height: 100%; clicked => { }
            scroll-event(e) => { accept }
        }
        scene_layer := Rectangle {
            x: (1.0 - root.scene_slide) * root.width * 0.1; y: 0px;
            width: 100%; height: 100%; background: Theme.current.artwork_canvas;
            visible: root.detail; opacity: root.scene_alpha;
            archive_scroll := ScrollView {
                x: root.safe-left + 18px; y: root.safe-top + 18px;
                width: Math.max(0px, root.width - root.safe-left - root.safe-right - 36px);
                height: Math.max(0px, root.height - root.safe-top - root.safe-bottom - 36px);
                content-width: self.visible-width;
                enabled: root.active && !root.returning;
                VerticalLayout {
                    width: 100%; spacing: 16px; alignment: start;
                    PageHeader {
                        title: BookmarksBridge.title_caption;
                        subtitle: @tr("Choose a saved scene, update a note or remove a bookmark.");
                        narrow: root.narrow; show-back: true;
                        back => { root.go_back(); }
                    }
                    if BookmarksBridge.notice != "": Text { text: BookmarksBridge.notice; color: Theme.current.text_destructive; font-size: 14px; wrap: word-wrap; min-width: 0px; }
                    if root.detail: VerticalLayout {
                        spacing: 12px;
                        for row[index] in BookmarksBridge.scenes: scene_card := Rectangle {
                            height: scene_body.preferred-height;
                            background: Theme.current.card; border-radius: Theme.card_corner_radius;
                            border-width: root.selected == index && SettingsStyle.keyboard-mode ? 2px : 1px;
                            border-color: root.selected == index && SettingsStyle.keyboard-mode ? Theme.current.accent_vivid : Theme.current.border_card;
                            private property <bool> selected: root.selected == index && SettingsStyle.keyboard-mode;
                            changed selected => { if self.selected && root.active { root.reveal(self.absolute-position.y - archive_scroll.absolute-position.y - archive_scroll.content-y, self.height); } }
                            scene_body := VerticalLayout {
                                padding: 16px; spacing: 10px;
                                Text { text: row.title + " · " + row.position; color: Theme.current.text_bright; font-size: 18px; font-weight: 600; wrap: word-wrap; min-width: 0px; }
                                Text { text: row.added; color: Theme.current.text_secondary; font-size: 12px; wrap: word-wrap; min-width: 0px; }
                                if root.editing_id != row.id: Text { text: row.note == "" ? @tr("No note") : row.note; color: row.note == "" ? Theme.current.text_muted : Theme.current.text_primary; font-size: 14px; wrap: word-wrap; min-width: 0px; }
                                if root.editing_id != row.id: scene_actions := Rectangle {
                                    // Pack natural icon+label widths from the left.
                                    // Each following action starts a new row only
                                    // when it cannot fit beside the previous one.
                                    private property <bool> edit_inline: scene_play.width + scene_edit.width + 8px <= self.width;
                                    private property <bool> delete_inline: scene_edit.x + scene_edit.width + scene_delete.width + 8px <= self.width;
                                    height: Math.max(scene_play.height, scene_edit.y + scene_edit.height, scene_delete.y + scene_delete.height);
                                    vertical-stretch: 0;
                                    scene_play := SceneAction {
                                        label: @tr("Play scene"); icon: @image-url("../../assets/icons/player/play.svg"); primary: true;
                                        viewport-width: root.width; enabled: root.active && !root.returning;
                                        // A fixed-width child without coordinates is
                                        // centered by Slint's implicit layout. Anchor
                                        // the first action so the entire group starts
                                        // at the card padding, including on wide TVs.
                                        x: 0px; y: 0px;
                                        width: Math.min(self.preferred-width, parent.width);
                                        clicked => { root.selected = index; BookmarksBridge.play(row.id); }
                                        focus-entered => { root.selected = index; }
                                    }
                                    scene_edit := SceneAction {
                                        label: @tr("Edit note"); icon: @image-url("../../assets/icons/player/pencil.svg");
                                        viewport-width: root.width; enabled: root.active && !root.returning;
                                        width: Math.min(self.preferred-width, parent.width);
                                        x: scene_actions.edit_inline ? scene_play.width + 8px : 0px;
                                        y: scene_actions.edit_inline ? 0px : scene_play.height + 8px;
                                        clicked => { root.editing_id = row.id; root.draft = row.note; root.selected = index; }
                                        focus-entered => { root.selected = index; }
                                    }
                                    scene_delete := SceneAction {
                                        label: @tr("Delete"); icon: @image-url("../../assets/icons/player/trash.svg"); destructive: true;
                                        viewport-width: root.width; enabled: root.active && !root.returning;
                                        width: Math.min(self.preferred-width, parent.width);
                                        x: scene_actions.delete_inline ? scene_edit.x + scene_edit.width + 8px : 0px;
                                        y: scene_actions.delete_inline ? scene_edit.y : scene_edit.y + (scene_actions.edit_inline ? Math.max(scene_play.height, scene_edit.height) : scene_edit.height) + 8px;
                                        clicked => { root.selected = index; root.remove_scene(row.id); }
                                        focus-entered => { root.selected = index; }
                                    }
                                }
                                if root.editing_id == row.id: VerticalLayout {
                                    spacing: 10px;
                                    if BookmarksBridge.notice != "": Text {
                                        text: BookmarksBridge.notice; color: Theme.current.text_destructive;
                                        font-size: 13px; wrap: word-wrap; min-width: 0px;
                                    }
                                    note := SearchField {
                                        text <=> root.draft; placeholder-text: @tr("Bookmark note"); roomy: true; min-width: 0px;
                                        accessible-role: text-input; accessible-label: @tr("Bookmark note");
                                        accessible-value <=> self.text;
                                        accessible-action-set-value(value) => { self.text = value; }
                                        keyboard-mode: SettingsStyle.keyboard-mode;
                                        init => { self.focus_at_end(); }
                                        accepted(value) => { if BookmarksBridge.edit(row.id, value) { root.editing_id = ""; page_focus.focus(); } }
                                    }
                                    note_actions := Rectangle {
                                        private property <bool> clear_inline: note_save.width + note_clear.width + 8px <= self.width;
                                        private property <bool> cancel_inline: note_clear.x + note_clear.width + note_cancel.width + 8px <= self.width;
                                        height: Math.max(note_save.height, note_clear.y + note_clear.height, note_cancel.y + note_cancel.height);
                                        vertical-stretch: 0;
                                        note_save := SceneAction {
                                            x: 0px; y: 0px;
                                            width: Math.min(self.preferred-width, parent.width);
                                            label: @tr("Save note"); icon: @image-url("../../assets/icons/player/check.svg"); primary: true;
                                            viewport-width: root.width; enabled: root.active && !root.returning;
                                            clicked => { if BookmarksBridge.edit(row.id, note.full-text) { root.editing_id = ""; page_focus.focus(); } }
                                            focus-entered => { root.selected = index; }
                                        }
                                        note_clear := SceneAction {
                                            width: Math.min(self.preferred-width, parent.width);
                                            x: note_actions.clear_inline ? note_save.width + 8px : 0px;
                                            y: note_actions.clear_inline ? 0px : note_save.height + 8px;
                                            label: @tr("Clear note"); icon: @image-url("../../assets/icons/player/eraser.svg");
                                            viewport-width: root.width; enabled: root.active && !root.returning;
                                            clicked => { if BookmarksBridge.edit(row.id, "") { root.editing_id = ""; page_focus.focus(); } }
                                            focus-entered => { root.selected = index; }
                                        }
                                        note_cancel := SceneAction {
                                            width: Math.min(self.preferred-width, parent.width);
                                            x: note_actions.cancel_inline ? note_clear.x + note_clear.width + 8px : 0px;
                                            y: note_actions.cancel_inline ? note_clear.y : note_clear.y + (note_actions.clear_inline ? Math.max(note_save.height, note_clear.height) : note_clear.height) + 8px;
                                            label: @tr("Cancel"); icon: @image-url("../../assets/icons/player/x.svg");
                                            viewport-width: root.width; enabled: root.active && !root.returning;
                                            clicked => { root.editing_id = ""; page_focus.focus(); }
                                            focus-entered => { root.selected = index; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Text { text: @tr("Bookmarks and notes sync between devices using this profile. Dates show when bookmarks were added, in UTC. Older bookmarks may have no recorded added date."); color: Theme.current.text_muted; font-size: 12px; wrap: word-wrap; min-width: 0px; }
                }
            }
        }
    }
    forward-focus: page_focus;
    // More retains the outgoing pixels during pop motion, while input already
    // belongs to the logical destination. Never activate an exiting action.
    if !root.active || root.returning: TouchArea {
        width: 100%; height: 100%;
        clicked => { }
        scroll-event(e) => { accept }
    }
}
