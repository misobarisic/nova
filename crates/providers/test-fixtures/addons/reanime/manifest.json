{
  "formatVersion": 1,
  "id": "reanime",
  "name": "Re:ANIME",
  "version": "0.1.2",
  "entry": "index.js",
  "permissions": {
    "domains": ["reanime.to", "flixcloud.cc", "enc-dec.app", "rundowncdn.top"],
    "addonMetadata": true,
    "httpPost": true,
