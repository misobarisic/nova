{
  "formatVersion": 1,
  "id": "supernova",
  "name": "Supernova",
  "version": "0.1.0",
  "entry": "index.js",
  "permissions": {
    "domains": [
      "*"
    ],
    "httpPost": true,
    "ephemeralPlaybackCredentials": [
      {
        "setting": "torbox.apiKey",
        "domains": [
          "*"
        ],
        "queryParameters": [
          "token"
        ],
        "pathPrefix": "/dld/"
      }
    ]
  },
  "limits": {
    "scriptTimeMs": 10000,
    "requestTimeoutMs": 20000,
    "responseBytes": 2097152,
    "redirects": 3,
    "requestsPerOperation": 48
  },
  "capabilities": {
    "contextualStreams": true,
    "deferredStreams": true
  },
  "configuration": [
    {
      "key": "sources.nyaa",
      "label": "Nyaa",
      "type": "boolean",
      "default": false,
      "collection": "torrent_sources",
      "collectionLabel": "Torrent sources",
      "collectionAddLabel": "Add source",
      "item": "nyaa",
      "itemRole": "member"
    },
    {
      "key": "sources.animetosho",
      "label": "AnimeTosho",
      "type": "boolean",
      "default": false,
      "collection": "torrent_sources",
      "collectionLabel": "Torrent sources",
      "collectionAddLabel": "Add source",
      "item": "animetosho",
      "itemRole": "member"
    },
    {
      "key": "sources.apibay",
      "label": "The Pirate Bay / APIBay (movies and TV)",
      "type": "boolean",
      "default": false,
      "collection": "torrent_sources",
      "collectionLabel": "Torrent sources",
      "collectionAddLabel": "Add source",
      "item": "apibay",
      "itemRole": "member"
    },
    {
      "key": "sources.knaben",
      "label": "Knaben",
      "type": "boolean",
      "default": false,
      "collection": "torrent_sources",
      "collectionLabel": "Torrent sources",
      "collectionAddLabel": "Add source",
      "item": "knaben",
      "itemRole": "member"
    },
    {
      "key": "sources.stremthru",
      "label": "StremThru",
      "type": "boolean",
      "default": false,
      "collection": "torrent_sources",
      "collectionLabel": "Torrent sources",
      "collectionAddLabel": "Add source",
      "item": "stremthru",
      "itemRole": "member"
    },
    {
      "key": "stremthru.url",
      "label": "StremThru URL",
      "type": "string",
      "default": "https://stremthru.13377001.xyz",
      "collection": "torrent_sources",
      "collectionLabel": "Torrent sources",
      "collectionAddLabel": "Add source",
      "item": "stremthru",
      "itemRole": "url",
      "itemController": "sources.stremthru"
    },
    {
      "key": "quality.preferred",
      "label": "Preferred quality",
      "type": "choice",
      "default": "1080p",
      "options": [
        {
          "value": "any",
          "label": "Any"
        },
        {
          "value": "720p",
          "label": "720p"
        },
        {
          "value": "1080p",
          "label": "1080p"
        },
        {
          "value": "2160p",
          "label": "2160p / 4K"
        }
      ]
    },
    {
      "key": "sort.order",
      "label": "Sort order",
      "type": "sort-order",
      "default": [
        {
          "key": "cached",
          "direction": "desc"
        },
        {
          "key": "resolution",
          "direction": "desc"
        },
        {
          "key": "size",
          "direction": "desc"
        },
        {
          "key": "pack",
