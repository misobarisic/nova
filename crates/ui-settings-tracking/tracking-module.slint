import { SettingsBridge, SettingsContent } from "@NovaUiShared";

import { TrackingSettings } from "../ui/tracking.slint";
import { StremioSettings } from "../ui/stremio.slint";
import { ListServiceSettings } from "../ui/list-services.slint";

// The shell owns scrolling and transitions. Report intrinsic layout sizes
// only while this section is selected, so outgoing instances cannot resize it.
export component SettingsTrackingModule inherits Window {
    default-font-family: "Roboto";
    private property <bool> tracker_focused;
    private property <bool> simkl_focused;
    private property <bool> mdblist_focused;
    private property <bool> trakt_focused;
    private property <bool> any_input_focused: root.tracker_focused || root.simkl_focused || root.mdblist_focused || root.trakt_focused;
    changed any_input_focused => { SettingsContent.tracking_input_focused = root.any_input_focused; }
    background: transparent;
    width: SettingsContent.slot_width; height: SettingsContent.slot_height;
    private property <length> measured_min: body_layout.min-height;
    private property <length> measured_preferred: body_layout.preferred-height;
    changed measured_min => { root.publish_size(); }
    changed measured_preferred => { root.publish_size(); }
    init => { root.publish_size(); }
    function publish_size() {
        if SettingsBridge.sel == 12 {
            SettingsContent.content_min_height = root.measured_min;
            SettingsContent.content_preferred_height = root.measured_preferred;
        }
    }
    body_layout := VerticalLayout {
        width: 100%; height: 100%; spacing: 24px;
        alignment: start;
        tracking_settings := TrackingSettings {

            init => { root.tracker_focused = self.input_focused; }
            accounts: SettingsBridge.tracking_accounts;
            reset_confirm <=> SettingsContent.tracking_reset_confirm;
            changed input_focused => {root.tracker_focused=self.input_focused;}
            blur: SettingsContent.tracking_blur;
            notice: SettingsBridge.tracking_notice;
            completion_rating_prompts_enabled <=> SettingsBridge.completion_rating_prompts_enabled;
            completion_prompts_changed => { SettingsBridge.settings_edited("completion_rating_prompts_enabled"); }
            connect(service,client,redirect) => {SettingsBridge.tracking_connect(service,client,redirect);}
            complete(service,value) => {SettingsBridge.tracking_complete(service,value);}
            disconnect(service) => {SettingsBridge.tracking_disconnect(service);}
            cancel(service) => {SettingsBridge.tracking_cancel(service);}
            reset => {SettingsBridge.tracking_reset();}
            automatic(service,enabled) => {SettingsBridge.tracking_automatic(service,enabled);}
            StremioSettings {}
            ListServiceSettings { service: 0; blur: SettingsContent.tracking_blur; changed input_focused => { root.simkl_focused = self.input_focused; } }
            ListServiceSettings { service: 1; blur: SettingsContent.tracking_blur; changed input_focused => { root.mdblist_focused = self.input_focused; } }
            ListServiceSettings { service: 2; blur: SettingsContent.tracking_blur; changed input_focused => { root.trakt_focused = self.input_focused; } }
        }
    }
}
