import { CastBridge, StreamFiltersBridge, SettingsBridge, SettingsContent, SettingsSync, Theme, SettingsStyle, InterfaceStyle } from "@NovaUiShared";
import { SettingSyncBadge } from "../ui/settings-sync.slint";

import { KbMark } from "../ui/kbnav.slint";

import { SubtitleControls } from "../ui/subtitle-controls.slint";

import { SpeedControl } from "../ui/speedcontrol.slint";

import { ToggleSwitch, Segmented, SectionHeader, SettingsRow, SettingsSearchHighlight, SettingsCard, NumericSetting, AddonIconButton, PillButton } from "../ui/settings-controls.slint";
import { Dropdown } from "../ui/dropdown.slint";

import { PlaybackLanguagePicker } from "../ui/playback-language-picker.slint";

// Codec sets share one logical scope; independent limits and policies have
// their own ordinary Settings comparison and device-override badges.
component StreamRuleToggle inherits SettingsRow {
    in property <int> rule-field;
    in property <int> rule-row;
    in-out property <bool> checked;
    ToggleSwitch {
        name: root.row-title;
        checked <=> root.checked;
        focused: SettingsBridge.kb_active && SettingsBridge.kb_zone == 9 && SettingsContent.kb_pr == SettingsContent.kb_player_stream_filters_row() + root.rule-row;
        toggled => {
            SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
            SettingsBridge.kb_zone = 9;
            SettingsContent.kb_pr = SettingsContent.kb_player_stream_filters_row() + root.rule-row;
            StreamFiltersBridge.edited(root.rule-field, self.checked ? "true" : "false");
        }
    }
}

component StreamRuleHeading inherits SettingsRow {
    in property <string> title;
    in property <string> description;
    row-title: root.title;
    row-desc: root.description;
    // Headings have no trailing control: use the full text width and the
    // ordinary row's intrinsic height, padding and responsive scope badge.
    full-width-text: true;
}

// Resolution exclusions and preferences use the same padded rows and actions
// as codec preferences. Exact heights remain native values, not tier guesses.
component ResolutionRules inherits SettingsCard {
    in property <bool> preferred;
    private property <[int]> heights: root.preferred ? StreamFiltersBridge.resolution_priority_order : StreamFiltersBridge.excluded_resolutions;
    private property <int> field: root.preferred ? 20 : 19;
    private property <int> picker-row: root.preferred ? SettingsContent.kb_stream_filter_resolution_picker() : SettingsContent.kb_stream_filter_resolution_exclude_picker();
    private property <int> rows-start: root.preferred ? SettingsContent.kb_stream_filter_resolution_priority_start() : SettingsContent.kb_stream_filter_resolution_excluded_start();
    pure function focused(row: int) -> bool {
        return SettingsBridge.kb_active && SettingsBridge.kb_zone == 9 && SettingsContent.kb_pr == SettingsContent.kb_player_stream_filters_row() + row;
    }
    function select(row: int) {
        SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
        SettingsBridge.kb_zone = 9;
        SettingsContent.kb_pr = SettingsContent.kb_player_stream_filters_row() + row;
    }
    function action(height: int, index: int, column: int) {
        root.select(root.rows-start + index);
        SettingsContent.stream_filter_resolution_column = column;
        StreamFiltersBridge.edited(root.field, (column == 0 ? "up:" : column == 1 ? "down:" : "remove:") + height);
        root.select(column == 2 ? root.picker-row : root.rows-start + index + (column == 0 ? -1 : 1));
        SettingsContent.focus_shell();
    }
    StreamRuleHeading {
        title: root.preferred ? @tr("Preferred resolutions") : @tr("Excluded resolutions");
        setting-key: root.preferred ? "stream_filters_resolution_priority" : "stream_filters_excluded_resolutions";
        description: root.preferred ? @tr("Use this order when sorting by Resolution. Unlisted resolutions follow the numerical sort direction.") : @tr("Excluded resolutions stay hidden even when they are preferred.");
    }
    SettingsRow {
        row-title: root.preferred ? @tr("Add resolution preference") : @tr("Exclude resolution");
        row-desc: root.heights.length > 0 ? "" : root.preferred ? @tr("No resolution preference") : @tr("No excluded resolutions");
        Dropdown {
            width: Math.min(252px, Math.max(1px, SettingsContent.slot_width - 32px)); roomy: true;
            model: StreamFiltersBridge.resolution_option_names;
            current-index: root.preferred ? SettingsContent.stream_filter_resolution_choice : SettingsContent.stream_filter_resolution_exclude_choice;
            accessible-role: combobox; accessible-label: root.preferred ? @tr("Add resolution preference") : @tr("Exclude resolution"); accessible-value: self.model[self.current-index];
            private property <bool> row-focused: root.focused(root.picker-row);
            changed row-focused => { if self.row-focused { SettingsContent.reveal_detail_control(self.absolute-position.y, self.height); } }
            border-color: self.row-focused ? Theme.current.focus_ring : Theme.current.control_border;
            selected(_) => {
                root.select(root.picker-row);
                if root.preferred { SettingsContent.stream_filter_resolution_choice = self.current-index; }
                else { SettingsContent.stream_filter_resolution_exclude_choice = self.current-index; }
                StreamFiltersBridge.edited(root.field, "add:" + StreamFiltersBridge.resolution_options[self.current-index]);
            }
        }
    }
    for height[index] in root.heights: SettingsRow {
        row-title: (root.preferred ? (index + 1) + ". " : "") + height + "p";
        private property <bool> row-focused: root.focused(root.rows-start + index);
        changed row-focused => { if self.row-focused {
            SettingsContent.reveal_detail_control(self.absolute-position.y, self.height);
            if !root.preferred || root.heights.length == 1 { SettingsContent.stream_filter_resolution_column = 2; }
            else if index == 0 && SettingsContent.stream_filter_resolution_column == 0 { SettingsContent.stream_filter_resolution_column = 1; }
            else if index + 1 == root.heights.length && SettingsContent.stream_filter_resolution_column == 1 { SettingsContent.stream_filter_resolution_column = 0; }
        } }
        HorizontalLayout {
            spacing: 8px; height: self.preferred-height;
            if root.preferred: AddonIconButton {
                name: @tr("Move up") + ": " + height + "p"; enabled: index > 0;
                focused: root.focused(root.rows-start + index) && SettingsContent.stream_filter_resolution_column == 0;
                Image { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 20px; height: 20px; source: @image-url("../../assets/icons/addons/arrow-up.svg"); colorize: Theme.current.text_settings; }
                clicked => { root.action(height, index, 0); }
            }
            if root.preferred: AddonIconButton {
                name: @tr("Move down") + ": " + height + "p"; enabled: index + 1 < root.heights.length;
                focused: root.focused(root.rows-start + index) && SettingsContent.stream_filter_resolution_column == 1;
                Image { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 20px; height: 20px; source: @image-url("../../assets/icons/addons/arrow-down.svg"); colorize: Theme.current.text_settings; }
                clicked => { root.action(height, index, 1); }
            }
            AddonIconButton {
                name: (root.preferred ? @tr("Remove") : @tr("Remove excluded resolution")) + ": " + height + "p";
                focused: root.focused(root.rows-start + index) && SettingsContent.stream_filter_resolution_column == 2;
                Image { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 20px; height: 20px; source: @image-url("../../assets/icons/player/x.svg"); colorize: Theme.current.text_settings; }
                clicked => { root.action(height, index, 2); }
            }
        }
    }
    if root.preferred: StreamRuleToggle {
        setting-key: "stream_filters_require_resolution";
        row-title: @tr("Only preferred resolutions");
        row-desc: @tr("Hide other advertised resolutions. An empty list allows every resolution; unknown details follow the setting below.");
        rule-field: 21; rule-row: SettingsContent.kb_stream_filter_require_resolution(); checked <=> StreamFiltersBridge.require_preferred_resolution;
    }
}

// The shell owns scrolling and transitions. Report intrinsic layout sizes
// only while this section is selected, so outgoing instances cannot resize it.
export component SettingsPlayerModule inherits Window {
    default-font-family: "Roboto";
    background: transparent;
    width: SettingsContent.slot_width; height: SettingsContent.slot_height;
    private property <length> measured_min: body_layout.min-height;
    private property <length> measured_preferred: body_layout.preferred-height;
    changed measured_min => { root.publish_size(); }
    changed measured_preferred => { root.publish_size(); }
    init => { root.publish_size(); StreamFiltersBridge.language_search(""); }
    function publish_size() {
        if SettingsBridge.sel == 5 {
            SettingsContent.content_min_height = root.measured_min;
            SettingsContent.content_preferred_height = root.measured_preferred;
        }
    }
    function select_filter(row: int) {
        SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
        SettingsBridge.kb_zone = 9;
        SettingsContent.kb_pr = SettingsContent.kb_player_stream_filters_row() + row;
    }
    pure function filter_focused(row: int) -> bool {
        return SettingsBridge.kb_active && SettingsBridge.kb_zone == 9 && SettingsContent.kb_pr == SettingsContent.kb_player_stream_filters_row() + row;
    }
    function priority_action(codec: int, index: int, action: int) {
        root.select_filter(SettingsContent.kb_stream_filter_codec_priority_start() + index);
        SettingsContent.stream_filter_priority_column = action;
        StreamFiltersBridge.edited(16, (action == 0 ? "up:" : action == 1 ? "down:" : "remove:") + SettingsContent.stream_filter_codec_key(codec));
        root.select_filter(action == 2 ? SettingsContent.kb_stream_filter_codec_picker() : SettingsContent.kb_stream_filter_codec_priority_start() + index + (action == 0 ? -1 : 1));
        SettingsContent.focus_shell();
    }
    function sort_action(criterion: string, index: int, action: int) {
        SettingsContent.stream_filter_sort_column = action;
        StreamFiltersBridge.sort_edited(criterion, action);
        root.select_filter(SettingsContent.kb_stream_filter_sort_start() + index + (action == 0 ? -1 : action == 1 ? 1 : 0));
        SettingsContent.focus_shell();
    }
    body_layout := VerticalLayout {
        width: 100%; height: 100%; spacing: 0px; alignment: start;
        VerticalLayout {

            vertical-stretch: 0; spacing: 16px; alignment: start;
            SectionHeader { label: @tr("Player choice"); }
            SettingsCard {

                SettingsRow {
                    setting-key: "player_external";
                    row-title: @tr("Player");
                    row-desc: SettingsBridge.is_android ? @tr("Built-in plays streams inside the app. External hands them to another video app.") : @tr("External playback is currently unavailable on desktop.");

                    Segmented {
                        labels: [@tr("Built-in"), @tr("External")];
                        disabled_index: SettingsBridge.is_android ? -1 : 1;
                        current_index: SettingsBridge.player_backend_index;
                        focused: SettingsBridge.kb_zone == 9 && SettingsContent.kb_pr == 0 && SettingsBridge.kb_active;
                        picked(i) => { SettingsBridge.kb_active = SettingsStyle.keyboard-mode; SettingsBridge.kb_zone = 9; SettingsContent.kb_pr = 0; SettingsBridge.player_backend_index = SettingsBridge.is_android ? i : 0; SettingsContent.schedule_save(); }
                    }
                }
            }
            SectionHeader { label: @tr("Episode playback"); }
            SettingsCard {

                SettingsRow {
                    tinted: true;
                    setting-key: "episode_start_behavior";
                    row-title: @tr("Episode playback");
                    row-desc: @tr("Choose how episodes with saved playback history start.");

                    Segmented {
                        labels: [@tr("Start over"), @tr("Resume"), @tr("Ask")];
                        current_index: SettingsBridge.episode_start_index;
                        focused: SettingsBridge.kb_zone == 9 && SettingsContent.kb_pr == 1 && SettingsBridge.kb_active;
                        picked(i) => { SettingsBridge.kb_active = SettingsStyle.keyboard-mode; SettingsBridge.kb_zone = 9; SettingsContent.kb_pr = 1; SettingsBridge.episode_start_index = i; SettingsContent.schedule_save(); }
                    }
                }
            }
            SectionHeader { label: @tr("Playback controls"); }
            SettingsCard {

                if !SettingsBridge.is_android && SettingsBridge.player_backend_index == 1: SettingsRow {
                    tinted: true;
                    setting-key: "desktop_external_app";
                    row-title: @tr("External app");
                    row-desc: @tr("Which app opens the stream. System default uses whatever handles video URLs.");

                    Segmented {
                        labels: [@tr("System default"), "VLC", "mpv"];
                        current_index: SettingsBridge.desktop_external_app_index;
                        focused: SettingsBridge.kb_zone == 9 && SettingsContent.kb_pr == 2 && SettingsBridge.kb_active;
                        picked(i) => { SettingsBridge.kb_active = SettingsStyle.keyboard-mode; SettingsBridge.kb_zone = 9; SettingsContent.kb_pr = 2; SettingsBridge.desktop_external_app_index = i; SettingsContent.schedule_save(); }
                    }
                }

                if SettingsBridge.is_android && SettingsBridge.player_backend_index == 0: SettingsRow {
                    tinted: true;
                    setting-key: "android_hwdec";
                    row-title: @tr("Video decoder");
                    row-desc: @tr("HW+ keeps decoded frames on the GPU and is fastest; it falls back to HW, then SW. HW falls back to SW.");

                    Segmented {
                        labels: ["HW+", "HW", "SW"];
                        current_index: SettingsBridge.android_hwdec_index;
                        focused: SettingsBridge.kb_zone == 9 && SettingsContent.kb_pr == 2 && SettingsBridge.kb_active;
                        picked(i) => { SettingsBridge.kb_active = SettingsStyle.keyboard-mode; SettingsBridge.kb_zone = 9; SettingsContent.kb_pr = 2; SettingsBridge.android_hwdec_index = i; SettingsContent.schedule_save(); }
                    }
                }

                if SettingsBridge.is_android && SettingsBridge.player_backend_index == 0: SettingsRow {
                    row-title: @tr("When returning to playback");
                    row-desc: @tr("Outside picture in picture, pause in the background. Automatically continue only if the video was playing before you left.");
                    Segmented {
                        labels: [@tr("Stay paused"), @tr("Auto continue")];
                        current_index: SettingsBridge.android_auto_continue ? 1 : 0;
                        focused: SettingsBridge.kb_zone == 9 && SettingsContent.kb_pr == 3 && SettingsBridge.kb_active;
                        picked(i) => { SettingsBridge.kb_active = SettingsStyle.keyboard-mode; SettingsBridge.kb_zone = 9; SettingsContent.kb_pr = 3; SettingsBridge.android_auto_continue = i == 1; SettingsContent.schedule_save(); }
                    }
                }

                if SettingsBridge.is_android && SettingsBridge.player_backend_index == 0: SettingsRow {
                    row-title: @tr("Picture in picture");
                    row-desc: @tr("Play video in a floating window when leaving Nova. Disabled keeps playback paused in the background.");
                    ToggleSwitch {
                        name: @tr("Picture in picture");
                        checked <=> SettingsBridge.android_pip_enabled;
                        focused: SettingsBridge.kb_zone == 9 && SettingsContent.kb_pr == 4 && SettingsBridge.kb_active;
                        toggled => {
                            SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                            SettingsBridge.kb_zone = 9;
                            SettingsContent.kb_pr = 4;
                            SettingsContent.schedule_setting("android_pip_enabled");
                        }
                    }
                }

                if SettingsBridge.is_android && SettingsBridge.player_backend_index == 0: SettingsRow {
                    row-title: @tr("Auto-rotate for playback");
                    row-desc: @tr("Open videos in landscape. When leaving the player, follow how you hold your phone. Applies only to this device.");
                    ToggleSwitch {
                        name: @tr("Auto-rotate for playback");
                        checked <=> SettingsBridge.android_auto_rotate;
                        focused: SettingsBridge.kb_zone == 9 && SettingsContent.kb_pr == 5 && SettingsBridge.kb_active;
                        toggled => {
                            SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                            SettingsBridge.kb_zone = 9;
                            SettingsContent.kb_pr = 5;
                            SettingsContent.schedule_setting("android_auto_rotate");
                        }
                    }
                }

                if SettingsBridge.desktop_decoder_available && SettingsBridge.player_backend_index == 0: SettingsRow {
                    tinted: true;
                    setting-key: "desktop_hwdec";
                    row-title: @tr("Video decoder");
                    row-desc: SettingsBridge.hw_plus_available
                        ? @tr("HW+ tries direct GPU decoding, with copy-back and software fallbacks. HW uses copy-back decoding. SW uses software decoding.")
                        : @tr("HW uses copy-back decoding with a software fallback. SW uses software decoding.");
                    Segmented {
                        labels: ["HW+", "HW", "SW"];
                        current_index: SettingsBridge.desktop_hwdec_index;
                        disabled_index: SettingsBridge.hw_plus_available ? -1 : 0;
                        focused: SettingsBridge.kb_zone == 9 && SettingsContent.kb_pr == 2 && SettingsBridge.kb_active;
                        picked(i) => {
                            SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                            SettingsBridge.kb_zone = 9;
                            SettingsContent.kb_pr = 2;
                            SettingsBridge.desktop_hwdec_index = i;
                            SettingsContent.schedule_save();
                        }
                    }
                }

                if SettingsBridge.player_backend_index == 0: SettingsRow {
                    setting-key: "default_audio_language";
                    row-title: @tr("Preferred audio languages");
                    row-desc: @tr("Add languages in preference order. The player uses the first available language.");

                    HorizontalLayout {
                        width: 100%;
                        height: self.preferred-height;
                        spacing: 8px;
                        KbMark { on: SettingsBridge.kb_zone == 9 && SettingsContent.kb_pr == SettingsContent.kb_player_audio_language_row(); active: SettingsBridge.kb_active; }
                        PlaybackLanguagePicker {
                            multiple: true;
                            selected-codes: SettingsBridge.audio_language_selected_codes;
                            selected-names: SettingsBridge.audio_language_selected_names;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            subtitle: false;
                            edit-requested: SettingsContent.kb_edit == 4;
                            keyboard-mode: SettingsBridge.kb_active;
                            current-label: SettingsBridge.audio_language_label;
                            codes: SettingsBridge.audio_language_codes;
                            names: SettingsBridge.audio_language_names;
                            current-index <=> SettingsBridge.audio_language_choice_index;
                            search(query, is_subtitle) => { SettingsBridge.playback_language_search(query, is_subtitle); }
                            picked(code, is_subtitle) => {
                                SettingsBridge.playback_language_picked(code, is_subtitle);
                                SettingsBridge.default_audio_language = code;
                                SettingsContent.schedule_setting("default_audio_language");
                            }
                            edited(code, action, is_subtitle) => {
                                SettingsBridge.playback_language_edited(code, action, is_subtitle);
                                SettingsContent.schedule_setting("default_audio_language");
                            }
                            focus_changed(focused) => {
                                SettingsContent.player_language_input_focused = focused;
                                if (focused && SettingsBridge.kb_active) { SettingsContent.reveal_detail_control(self.absolute-position.y, self.height); }
                            }
                            accepted => { SettingsContent.kb_edit = 0; SettingsContent.player_language_input_focused = false; SettingsContent.focus_shell(); }
                        }
                    }
                }

                if SettingsBridge.player_backend_index == 0: SettingsRow {
                    tinted: true;
                    setting-key: "default_subtitle_language";
                    row-title: @tr("Preferred subtitle languages");
                    row-desc: @tr("Add languages in preference order. Subtitles stay off if none are available.");

                    HorizontalLayout {
                        width: 100%;
                        height: self.preferred-height;
                        spacing: 8px;
                        KbMark { on: SettingsBridge.kb_zone == 9 && SettingsContent.kb_pr == SettingsContent.kb_player_subtitle_language_row(); active: SettingsBridge.kb_active; }
                        PlaybackLanguagePicker {
                            multiple: true;
                            selected-codes: SettingsBridge.subtitle_language_selected_codes;
                            selected-names: SettingsBridge.subtitle_language_selected_names;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            subtitle: true;
                            edit-requested: SettingsContent.kb_edit == 5;
                            keyboard-mode: SettingsBridge.kb_active;
                            current-label: SettingsBridge.subtitle_language_label;
                            codes: SettingsBridge.subtitle_language_codes;
                            names: SettingsBridge.subtitle_language_names;
                            current-index <=> SettingsBridge.subtitle_language_choice_index;
                            search(query, is_subtitle) => { SettingsBridge.playback_language_search(query, is_subtitle); }
                            picked(code, is_subtitle) => {
                                SettingsBridge.playback_language_picked(code, is_subtitle);
                                SettingsBridge.default_subtitle_language = code;
                                SettingsContent.schedule_setting("default_subtitle_language");
                            }
                            edited(code, action, is_subtitle) => {
                                SettingsBridge.playback_language_edited(code, action, is_subtitle);
                                SettingsContent.schedule_setting("default_subtitle_language");
                            }
                            focus_changed(focused) => {
                                SettingsContent.player_language_input_focused = focused;
                                if (focused && SettingsBridge.kb_active) { SettingsContent.reveal_detail_control(self.absolute-position.y, self.height); }
                            }
                            accepted => { SettingsContent.kb_edit = 0; SettingsContent.player_language_input_focused = false; SettingsContent.focus_shell(); }
                        }
                    }
                }

                // Global default rate for the built-in player;
                // its OSD title override is a separate setting.
                // ± steps by 0.05, quantized by the backend.
                if !SettingsContent.narrow && SettingsBridge.player_backend_index == 0: SettingsRow {
                    // Alternate with the row above: the
                    // Android decoder row (built-in) is
                    // already tinted.
                    tinted: !SettingsBridge.is_android;
                    setting-key: "playback_speed";
                    row-title: @tr("Default playback speed");
                    row-desc: @tr("Rate the built-in player starts at. The slider covers 0.5×–2.0×; ± moves in 0.05× steps.");

                    VerticalLayout {
                        width: 240px;
                        // Slider row + preset row.
                        height: 96px;
                        alignment: center;

                        speed_control := SpeedControl {
                            roomy: true; keyboard-mode <=> SettingsBridge.kb_active;
                            speed <=> SettingsBridge.playback_speed;
                            focused: SettingsBridge.kb_zone == 9 && SettingsContent.kb_pr == SettingsContent.kb_player_speed_row() && SettingsBridge.kb_active;
                            changed(v) => {
                                SettingsBridge.playback_speed = v;
                                SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                                SettingsBridge.kb_zone = 9;
                                SettingsContent.kb_pr = SettingsContent.kb_player_speed_row();
                                SettingsContent.schedule_save();
                            }
                            stepped(d) => {
                                SettingsBridge.playback_speed_stepped(d);
                                SettingsContent.schedule_save();
                            }
                        }
                    }
                }

                // Narrow: the slider column would push the page
                // sideways, so the control stacks under the
                // text (same split as the cache sliders).
                if SettingsContent.narrow && SettingsBridge.player_backend_index == 0: Rectangle {
                    background: Theme.current.card;
                    accessible-role: groupbox;
                    accessible-id: "setting:playback_speed";
                    SettingsSearchHighlight { setting-key: "playback_speed"; }

                    VerticalLayout {
                        width: 100%;
                        padding-top: 14px;
                        padding-bottom: 14px;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 10px;

                        VerticalLayout {
                            spacing: 3px;

                            speed_title_line := Rectangle {
                                // Match ordinary settings rows without forcing
                                // translated titles and badges onto one line.
                                property <bool> inline-badge: SettingsSync.enabled && speed_title_natural.preferred-width + speed_scope_badge.preferred-width + 8px <= self.width;
                                height: self.inline-badge ? Math.max(speed_title.preferred-height, 26px) : speed_title.preferred-height + (SettingsSync.enabled ? 29px : 0px);

                                Rectangle {
                                    width: 0px; height: 0px; clip: true;
                                    speed_title_natural := Text { width: 0px; height: 0px; text: @tr("Default playback speed"); font-size: 14px; font-weight: 600; }
                                }
                                speed_title := Text {
                                    // Plain Rectangle children center by default.
                                    // Anchor the title before the inline scope badge.
                                    x: 0px;
                                    text: @tr("Default playback speed");
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: Theme.current.text_bright;
                                    wrap: word-wrap;
                                    min-width: 0px;
                                    width: speed_title_line.inline-badge ? speed_title_natural.preferred-width : parent.width;
                                    height: self.preferred-height;
                                    y: speed_title_line.inline-badge ? (parent.height - self.height) / 2 : 0px;
                                }
                                speed_scope_badge := SettingSyncBadge {
                                    setting_key: "playback_speed";
                                    setting_title: @tr("Default playback speed");
                                    width: Math.min(self.preferred-width, parent.width);
                                    x: speed_title_line.inline-badge ? speed_title_natural.preferred-width + 8px : 0px;
                                    y: speed_title_line.inline-badge ? (parent.height - self.height) / 2 : speed_title.preferred-height + 3px;
                                }
                            }

                            Text {
                                text: @tr("Rate the built-in player starts at. The slider covers 0.5×–2.0×; ± moves in 0.05× steps.");
                                font-size: 14px;
                                color: Theme.current.text_settings;
                                wrap: word-wrap;
                            }
                        }

                        speed_control_n := SpeedControl {
                            roomy: true; keyboard-mode <=> SettingsBridge.kb_active;
                            speed <=> SettingsBridge.playback_speed;
                            focused: SettingsBridge.kb_zone == 9 && SettingsContent.kb_pr == SettingsContent.kb_player_speed_row() && SettingsBridge.kb_active;
                            changed(v) => {
                                SettingsBridge.playback_speed = v;
                                SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                                SettingsBridge.kb_zone = 9;
                                SettingsContent.kb_pr = SettingsContent.kb_player_speed_row();
                                SettingsContent.schedule_save();
                            }
                            stepped(d) => {
                                SettingsBridge.playback_speed_stepped(d);
                                SettingsContent.schedule_save();
                            }
                        }
                    }
                }
                if SettingsBridge.player_backend_index == 0: SettingsRow {
                    setting-key: "prefetch_next_episode_streams";
                    row-title: @tr("Prefetch next episode streams");
                    row-desc: @tr("Look up available sources shortly before the next episode buttons appear. Sources stay in memory; playback starts only after you choose.");
                    Segmented {
                        labels: [@tr("Off"), @tr("On")];
                        current_index: SettingsBridge.prefetch_next_episode_streams ? 1 : 0;
                        focused: SettingsBridge.kb_zone == 9 && SettingsContent.kb_pr == SettingsContent.kb_player_speed_row() + 1 && SettingsBridge.kb_active;
                        picked(i) => {
                            SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                            SettingsBridge.kb_zone = 9;
                            SettingsContent.kb_pr = SettingsContent.kb_player_speed_row() + 1;
                            SettingsBridge.prefetch_next_episode_streams = i == 1;
                            SettingsContent.schedule_setting("prefetch_next_episode_streams");
                        }
                    }
                }
            }
            if SettingsBridge.player_backend_index == 0: VerticalLayout {
                spacing: 16px;
                SectionHeader { label: @tr("Screenshots"); }
                SettingsCard {
                    SettingsRow {
                        setting-key: "screenshot_format";
                        row-title: @tr("Screenshot format");
                        row-desc: @tr("PNG and lossless WebP preserve every pixel. JPEG and lossy WebP use the quality setting.");
                        screenshot_format := Dropdown {
                            width: Math.min(252px, Math.max(0px, SettingsContent.slot_width - 32px));
                            model: [@tr("PNG (lossless)"), @tr("JPEG"), @tr("WebP (lossless)"), @tr("WebP (lossy)")];
                            current-index <=> SettingsBridge.screenshot_format_index;
                            roomy: true;
                            border-color: SettingsBridge.kb_active && SettingsBridge.kb_zone == 9 && SettingsContent.kb_pr == SettingsContent.kb_player_speed_row() + 2 ? Theme.current.focus_ring : Theme.current.control_border;
                            selected(_) => {
                                SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                                SettingsBridge.kb_zone = 9;
                                SettingsContent.kb_pr = SettingsContent.kb_player_speed_row() + 2;
                                SettingsContent.schedule_setting("screenshot_format");
                            }
                        }
                    }
                    SettingsRow {
                        setting-key: "screenshot_show_folder";
                        row-title: @tr("Screenshot folder");
                        row-desc: @tr("Save in Pictures/Nova or group captures by show.");
                        Segmented {
                            labels: [@tr("Nova"), @tr("Show folders")];
                            current_index: SettingsBridge.screenshot_show_folder ? 1 : 0;
                            focused: SettingsBridge.kb_active && SettingsBridge.kb_zone == 9 && SettingsContent.kb_pr == SettingsContent.kb_player_speed_row() + 3;
                            picked(i) => {
                                SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                                SettingsBridge.kb_zone = 9;
                                SettingsContent.kb_pr = SettingsContent.kb_player_speed_row() + 3;
                                SettingsBridge.screenshot_show_folder = i == 1;
                                SettingsContent.schedule_setting("screenshot_show_folder");
                            }
                        }
                    }
                    if SettingsBridge.screenshot_format_index == 1: SettingsRow {
                        setting-key: "screenshot_jpeg_quality";
                        row-title: @tr("JPEG quality");
                        row-desc: @tr("Higher values retain more detail and create larger files.");
                        jpeg_quality := NumericSetting {
                            value <=> SettingsBridge.screenshot_jpeg_quality;
                            minimum: 1; maximum: 100; step: 1; suffix: "%";
                            focused: SettingsBridge.kb_active && SettingsBridge.kb_zone == 9 && SettingsContent.kb_pr == SettingsContent.kb_player_speed_row() + 4;
                            changed(_) => {
                                SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                                SettingsBridge.kb_zone = 9;
                                SettingsContent.kb_pr = SettingsContent.kb_player_speed_row() + 4;
                                SettingsContent.schedule_setting("screenshot_jpeg_quality");
                            }
                        }
                    }
                    if SettingsBridge.screenshot_format_index == 3: SettingsRow {
                        setting-key: "screenshot_webp_quality";
                        row-title: @tr("WebP quality");
                        row-desc: @tr("Higher values retain more detail and create larger files.");
                        webp_quality := NumericSetting {
                            value <=> SettingsBridge.screenshot_webp_quality;
                            minimum: 1; maximum: 100; step: 1; suffix: "%";
                            focused: SettingsBridge.kb_active && SettingsBridge.kb_zone == 9 && SettingsContent.kb_pr == SettingsContent.kb_player_speed_row() + 4;
                            changed(_) => {
                                SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                                SettingsBridge.kb_zone = 9;
                                SettingsContent.kb_pr = SettingsContent.kb_player_speed_row() + 4;
                                SettingsContent.schedule_setting("screenshot_webp_quality");
                            }
                        }
                    }
                }
            }
            if SettingsBridge.player_backend_index == 0: VerticalLayout {
                spacing: 16px;
                SectionHeader { label: @tr("Subtitle appearance and timing"); }
                SettingsCard {
                    VerticalLayout {
                        padding: 16px; spacing: 12px;
                        SettingSyncBadge { setting_key: "subtitle_style"; setting_title: @tr("Subtitle appearance and timing"); visible: SettingsSync.enabled; }
                        Text { text: @tr("Global defaults. Player changes are saved per title; unedited controls keep using these defaults."); font-size: 14px; color: Theme.current.text_settings; wrap: word-wrap; min-width: 0px; }
                        SubtitleControls {
                            vertical-stretch: 0;
                            values: SettingsBridge.subtitle_style;
                            focused_idx: SettingsBridge.kb_active && SettingsBridge.kb_zone == 9 ? SettingsContent.kb_pr - SettingsContent.kb_player_speed_row() - (SettingsBridge.screenshot_format_index == 1 || SettingsBridge.screenshot_format_index == 3 ? 5 : 4) : -1;
                            edited(i, v) => {
                                SettingsBridge.subtitle_style_changed(i, v);
                                SettingsContent.schedule_setting("subtitle_style");
                            }
                            reveal(y, h) => { SettingsContent.reveal_detail_control(y, h); }
                        }
                    }
                }
            }
            if SettingsBridge.player_backend_index == 0: SettingsCard {
                SettingsRow {
                    setting-key: "show_chapters";
                    row-title: @tr("Show chapters on timeline");
                    row-desc: @tr("Show chapter cutouts and the current chapter name below the seek bar. Tap the name to choose a chapter.");
                    Segmented {
                        labels: [@tr("Off"), @tr("On")];
                        current_index: SettingsBridge.show_chapters ? 1 : 0;
                        focused: SettingsBridge.kb_active && SettingsBridge.kb_zone == 9 && SettingsContent.kb_pr == SettingsContent.kb_player_speed_row() + (SettingsBridge.screenshot_format_index == 1 || SettingsBridge.screenshot_format_index == 3 ? 5 : 4) + 8;
                        picked(i) => {
                            SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                            SettingsBridge.kb_zone = 9;
                            SettingsContent.kb_pr = SettingsContent.kb_player_speed_row() + (SettingsBridge.screenshot_format_index == 1 || SettingsBridge.screenshot_format_index == 3 ? 5 : 4) + 8;
                            SettingsBridge.show_chapters = i == 1;
                            SettingsContent.schedule_setting("show_chapters");
                        }
                    }
                }
            }
            if SettingsBridge.player_backend_index == 0: SettingsCard {
                SettingsRow {
                    setting-key: "auto_next_episode";
                    row-title: @tr("Automatically play next episode");
                    row-desc: @tr("At the end, preview the recommended source with eight seconds to cancel.");
                    Segmented {
                        labels: [@tr("Off"), @tr("On")];
                        current_index: SettingsBridge.auto_next_episode ? 1 : 0;
                        focused: SettingsBridge.kb_active && SettingsBridge.kb_zone == 9 && SettingsContent.kb_pr == SettingsContent.kb_player_speed_row() + (SettingsBridge.screenshot_format_index == 1 || SettingsBridge.screenshot_format_index == 3 ? 5 : 4) + 9;
                        picked(i) => {
                            SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                            SettingsBridge.kb_zone = 9;
                            SettingsContent.kb_pr = SettingsContent.kb_player_speed_row() + (SettingsBridge.screenshot_format_index == 1 || SettingsBridge.screenshot_format_index == 3 ? 5 : 4) + 9;
                            SettingsBridge.auto_next_episode = i == 1;
                            SettingsContent.schedule_setting("auto_next_episode");
                        }
                    }
                }
            }
            if SettingsBridge.player_backend_index == 0: SettingsCard {
                SettingsRow {
                    setting-key: "intro_skip_mode";
                    row-title: @tr("Intro skipping");
                    row-desc: @tr("Choose whether matching intro and recap timings show a prompt or skip automatically. Each show can override this default.");
                    Dropdown {
                        width: Math.min(252px, Math.max(0px, SettingsContent.slot_width - 32px));
                        model: [@tr("Off"), @tr("Show skip prompt"), @tr("Auto skip")];
                        current-index <=> SettingsBridge.intro_skip_mode_index;
                        roomy: true;
                        border-color: SettingsBridge.kb_zone == 9 && SettingsBridge.kb_active && SettingsContent.kb_pr == SettingsContent.kb_player_speed_row() + (SettingsBridge.screenshot_format_index == 1 || SettingsBridge.screenshot_format_index == 3 ? 5 : 4) + 10 ? Theme.current.focus_ring : Theme.current.control_border;
                        selected(_) => {
                            SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                            SettingsBridge.kb_zone = 9;
                            SettingsContent.kb_pr = SettingsContent.kb_player_speed_row() + (SettingsBridge.screenshot_format_index == 1 || SettingsBridge.screenshot_format_index == 3 ? 5 : 4) + 10;
                            SettingsContent.schedule_setting("intro_skip_mode");
                        }
                    }
                }
            }
            if SettingsBridge.player_backend_index == 0: SettingsCard {
                SettingsRow {
                    setting-key: "intro_skip_confidence";
                    row-title: @tr("Automatic skip confidence");
                    row-desc: @tr("Minimum confidence for automatic intro and recap skips. Lower-confidence timings still offer a manual prompt. Applies to providers that report confidence.");
                    confidence_preset := Dropdown {
                        width: Math.min(252px, Math.max(0px, SettingsContent.slot_width - 32px));
                        model: [@tr("Any (0%)"), @tr("Low (25%)"), @tr("Balanced (50%)"), @tr("High (80%)"), @tr("Very high (95%)")];
                        current-index <=> SettingsBridge.intro_skip_confidence_index;
                        roomy: true;
                        border-color: SettingsBridge.kb_zone == 9 && SettingsBridge.kb_active && SettingsContent.kb_pr == SettingsContent.kb_player_speed_row() + (SettingsBridge.screenshot_format_index == 1 || SettingsBridge.screenshot_format_index == 3 ? 5 : 4) + 11 ? Theme.current.focus_ring : Theme.current.control_border;
                        selected(_) => {
                            SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                            SettingsBridge.kb_zone = 9;
                            SettingsContent.kb_pr = SettingsContent.kb_player_speed_row() + (SettingsBridge.screenshot_format_index == 1 || SettingsBridge.screenshot_format_index == 3 ? 5 : 4) + 11;
                            SettingsContent.schedule_setting("intro_skip_confidence");
                        }
                    }
                }
            }

            if SettingsBridge.player_backend_index == 0: SettingsCard {
                SettingsRow {
                    setting-key: "keep_controls_visible_while_paused";
                    row-title: @tr("Keep controls visible while paused");
                    row-desc: @tr("When off, controls fade after five seconds of inactivity. Input shows them again.");
                    ToggleSwitch {
                        name: @tr("Keep controls visible while paused");
                        checked <=> SettingsBridge.keep_controls_visible_while_paused;
                        focused: SettingsBridge.kb_active && SettingsBridge.kb_zone == 9 && SettingsContent.kb_pr == SettingsContent.kb_player_paused_controls_row();
                        toggled => {
                            SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                            SettingsBridge.kb_zone = 9;
                            SettingsContent.kb_pr = SettingsContent.kb_player_paused_controls_row();
                            SettingsContent.schedule_setting("keep_controls_visible_while_paused");
                        }
                    }
                }
            }

            if CastBridge.available: SettingsCard {
                SettingsRow {
                    setting-key: "casting_remux_buffer";
                    row-title: @tr("Casting remux buffer");
                    row-desc: @tr("Maximum memory for retained media segments when casting needs remuxing. Processing uses additional memory. Applies to the next casting session.");
                    remux_buffer := Dropdown {
                        width: Math.min(252px, Math.max(1px, SettingsContent.slot_width - 32px));
                        model: ["32 MiB", "64 MiB", "128 MiB", "256 MiB"];
                        accessible-role: combobox;
                        accessible-label: @tr("Casting remux buffer");
                        accessible-value: self.model[self.current-index];
                        current-index <=> SettingsBridge.casting_remux_buffer_index;
                        roomy: true;
                        private property <bool> row-focused: SettingsBridge.kb_active && SettingsBridge.kb_zone == 9 && SettingsContent.kb_pr == SettingsContent.kb_player_stream_filters_row() - 1;
                        changed row-focused => { if self.row-focused { SettingsContent.reveal_detail_control(self.absolute-position.y, self.height); } }
                        border-color: self.row-focused ? Theme.current.focus_ring : Theme.current.control_border;
                        selected(_) => {
                            SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                            SettingsBridge.kb_zone = 9;
                            SettingsContent.kb_pr = SettingsContent.kb_player_stream_filters_row() - 1;
                            SettingsContent.schedule_setting("casting_remux_buffer");
                        }
                    }
                }
            }

            SectionHeader { label: @tr("Universal stream filters"); }
            SettingsCard {
                StreamRuleToggle {
                    setting-key: "stream_filters_enabled";
                    row-title: @tr("Use stream rules");
                    row-desc: @tr("These rules apply to every addon. Each preference can sync or stay on this device.");
                    rule-field: 0; rule-row: 0; checked <=> StreamFiltersBridge.enabled;
                }
            }
            SectionHeader { label: @tr("Limits"); }
            SettingsCard {
                SettingsRow {
                    setting-key: "stream_filters_resolution";
                    row-title: @tr("Maximum resolution");
                    Dropdown {
                        accessible-role: combobox; accessible-label: @tr("Maximum resolution");
                        accessible-value: self.model[self.current-index];
                        width: Math.min(252px, Math.max(1px, SettingsContent.slot_width - 32px));
                        model: [@tr("Any resolution"), "480p", "720p", "1080p", "1440p", "2160p", "4320p"];
                        current-index <=> StreamFiltersBridge.max_resolution_index; roomy: true;
                        property <bool> row-focused: root.filter_focused(1);
                        changed row-focused => { if self.row-focused { SettingsContent.reveal_detail_control(self.absolute-position.y, self.height); } }
                        border-color: self.row-focused ? Theme.current.focus_ring : Theme.current.control_border;
                        selected(_) => { root.select_filter(1); StreamFiltersBridge.edited(1, "" + self.current-index); }
                    }
                }
                SettingsRow {
                    setting-key: "stream_filters_size";
                    row-title: @tr("Maximum size");
                    Dropdown {
                        accessible-role: combobox; accessible-label: @tr("Maximum size");
                        accessible-value: self.model[self.current-index];
                        width: Math.min(252px, Math.max(1px, SettingsContent.slot_width - 32px));
                        model: [@tr("Any size"), "1 GiB", "2 GiB", "4 GiB", "8 GiB", "16 GiB", "32 GiB", "64 GiB", "128 GiB"];
                        current-index <=> StreamFiltersBridge.max_size_index; roomy: true;
                        property <bool> row-focused: root.filter_focused(2);
                        changed row-focused => { if self.row-focused { SettingsContent.reveal_detail_control(self.absolute-position.y, self.height); } }
                        border-color: self.row-focused ? Theme.current.focus_ring : Theme.current.control_border;
                        selected(_) => { root.select_filter(2); StreamFiltersBridge.edited(2, "" + self.current-index); }
                    }
                }
            }
            SectionHeader { label: @tr("Resolutions"); }
            ResolutionRules { preferred: false; }
            ResolutionRules { preferred: true; }
            SectionHeader { label: @tr("Video codecs"); }
            SettingsCard {
                StreamRuleHeading {
                    title: @tr("Allowed video codecs"); setting-key: "stream_filters_allowed_codecs";
                    description: @tr("All codecs when none selected");
                }
                StreamRuleToggle { row-title: "H.264 / AVC"; rule-field: 3; rule-row: SettingsContent.kb_stream_filter_codec_start() + 0; checked <=> StreamFiltersBridge.allow_avc; }
                StreamRuleToggle { row-title: "H.265 / HEVC"; rule-field: 4; rule-row: SettingsContent.kb_stream_filter_codec_start() + 1; checked <=> StreamFiltersBridge.allow_hevc; }
                StreamRuleToggle { row-title: "AV1"; rule-field: 5; rule-row: SettingsContent.kb_stream_filter_codec_start() + 2; checked <=> StreamFiltersBridge.allow_av1; }
                StreamRuleToggle { row-title: "VP9"; rule-field: 6; rule-row: SettingsContent.kb_stream_filter_codec_start() + 3; checked <=> StreamFiltersBridge.allow_vp9; }
                StreamRuleToggle { row-title: @tr("Other video codecs"); rule-field: 10; rule-row: SettingsContent.kb_stream_filter_codec_start() + 4; checked <=> StreamFiltersBridge.allow_other; }
            }
            SettingsCard {
                StreamRuleHeading {
                    title: @tr("Excluded video codecs"); setting-key: "stream_filters_excluded_codecs";
                    description: @tr("Excluded codecs stay hidden even when they are also allowed.");
                }
                StreamRuleToggle { row-title: @tr("Exclude H.264 / AVC"); rule-field: 11; rule-row: SettingsContent.kb_stream_filter_codec_start() + 5; checked <=> StreamFiltersBridge.block_avc; }
                StreamRuleToggle { row-title: @tr("Exclude H.265 / HEVC"); rule-field: 12; rule-row: SettingsContent.kb_stream_filter_codec_start() + 6; checked <=> StreamFiltersBridge.block_hevc; }
                StreamRuleToggle { row-title: @tr("Exclude AV1"); rule-field: 13; rule-row: SettingsContent.kb_stream_filter_codec_start() + 7; checked <=> StreamFiltersBridge.block_av1; }
                StreamRuleToggle { row-title: @tr("Exclude VP9"); rule-field: 14; rule-row: SettingsContent.kb_stream_filter_codec_start() + 8; checked <=> StreamFiltersBridge.block_vp9; }
                StreamRuleToggle { row-title: @tr("Exclude other video codecs"); rule-field: 15; rule-row: SettingsContent.kb_stream_filter_codec_start() + 9; checked <=> StreamFiltersBridge.block_other; }
            }
            SettingsCard {
                StreamRuleHeading {
                    title: @tr("Preferred video codecs"); setting-key: "stream_filters_codec_priority";
                    description: @tr("Use this preference order when sorting by Video codec. Unlisted codecs keep their existing order.");
                }
                SettingsRow {
                    row-title: @tr("Add codec preference");
                    row-desc: StreamFiltersBridge.codec_priority_order.length == 0 ? @tr("No codec preference") : "";
                    Dropdown {
                        width: Math.min(252px, Math.max(1px, SettingsContent.slot_width - 32px)); roomy: true;
                        model: ["H.264 / AVC", "H.265 / HEVC", "AV1", "VP9", @tr("Other video codecs")];
                        current-index <=> SettingsContent.stream_filter_codec_choice;
                        accessible-role: combobox; accessible-label: @tr("Add codec preference"); accessible-value: self.model[self.current-index];
                        property <bool> row-focused: root.filter_focused(SettingsContent.kb_stream_filter_codec_picker());
                        changed row-focused => { if self.row-focused { SettingsContent.reveal_detail_control(self.absolute-position.y, self.height); } }
                        border-color: self.row-focused ? Theme.current.focus_ring : Theme.current.control_border;
                        selected(_) => { root.select_filter(SettingsContent.kb_stream_filter_codec_picker()); StreamFiltersBridge.edited(16, "add:" + SettingsContent.stream_filter_codec_key(self.current-index)); }
                    }
                }
                for codec[index] in StreamFiltersBridge.codec_priority_order: SettingsRow {
                    property <bool> row-focused: root.filter_focused(SettingsContent.kb_stream_filter_codec_priority_start() + index);
                    changed row-focused => { if self.row-focused {
                        SettingsContent.reveal_detail_control(self.absolute-position.y, self.height);
                        if StreamFiltersBridge.codec_priority_order.length == 1 { SettingsContent.stream_filter_priority_column = 2; }
                        else if index == 0 && SettingsContent.stream_filter_priority_column == 0 { SettingsContent.stream_filter_priority_column = 1; }
                        else if index + 1 == StreamFiltersBridge.codec_priority_order.length && SettingsContent.stream_filter_priority_column == 1 { SettingsContent.stream_filter_priority_column = 0; }
                    } }
                    row-title: (index + 1) + ". " + SettingsContent.stream_filter_codec_label(codec);
                    HorizontalLayout {
                        spacing: 8px; height: self.preferred-height;
                        AddonIconButton {
                            name: @tr("Move up") + ": " + SettingsContent.stream_filter_codec_label(codec);
                            enabled: index > 0; focused: root.filter_focused(SettingsContent.kb_stream_filter_codec_priority_start() + index) && SettingsContent.stream_filter_priority_column == 0;
                            Image { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 20px; height: 20px; source: @image-url("../../assets/icons/addons/arrow-up.svg"); colorize: Theme.current.text_settings; }
                            clicked => { root.priority_action(codec, index, 0); }
                        }
                        AddonIconButton {
                            name: @tr("Move down") + ": " + SettingsContent.stream_filter_codec_label(codec);
                            enabled: index + 1 < StreamFiltersBridge.codec_priority_order.length; focused: root.filter_focused(SettingsContent.kb_stream_filter_codec_priority_start() + index) && SettingsContent.stream_filter_priority_column == 1;
                            Image { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 20px; height: 20px; source: @image-url("../../assets/icons/addons/arrow-down.svg"); colorize: Theme.current.text_settings; }
                            clicked => { root.priority_action(codec, index, 1); }
                        }
                        AddonIconButton {
                            name: @tr("Remove") + ": " + SettingsContent.stream_filter_codec_label(codec);
                            focused: root.filter_focused(SettingsContent.kb_stream_filter_codec_priority_start() + index) && SettingsContent.stream_filter_priority_column == 2;
                            Image { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 20px; height: 20px; source: @image-url("../../assets/icons/player/x.svg"); colorize: Theme.current.text_settings; }
                            clicked => { root.priority_action(codec, index, 2); }
                        }
                    }
                }
                StreamRuleToggle {
                    setting-key: "stream_filters_require_codec";
                    row-title: @tr("Only preferred video codecs");
                    row-desc: @tr("Hide streams with other advertised video codecs. An empty preference list allows every codec.");
                    rule-field: 18; rule-row: SettingsContent.kb_stream_filter_require_codec(); checked <=> StreamFiltersBridge.require_preferred_codec;
                }
            }
            SectionHeader { label: @tr("Audio languages"); }
            SettingsCard {
                StreamRuleToggle {
                    setting-key: "stream_filters_audio";
                    row-title: @tr("Use preferred audio languages");
                    row-desc: @tr("Follow Preferred audio languages.") + " " + StreamFiltersBridge.preferred_audio_languages;
                    rule-field: 17; rule-row: SettingsContent.kb_stream_filter_audio_source(); checked <=> StreamFiltersBridge.use_preferred_audio_languages;
                }
                if !StreamFiltersBridge.use_preferred_audio_languages: SettingsRow {
                    setting-key: "stream_filters_audio";
                    row-title: @tr("Custom audio languages");
                    row-desc: @tr("Search and add languages in preference order. Changes apply immediately.");
                    HorizontalLayout {
                        width: 100%; height: self.preferred-height; spacing: 8px;
                        KbMark { on: root.filter_focused(SettingsContent.kb_stream_filter_audio_picker()); active: SettingsBridge.kb_active; }
                        filter_languages := PlaybackLanguagePicker {
                            multiple: true; min-width: 0px; horizontal-stretch: 1;
                            dropdown-width: Math.min(180px, Math.max(100px, SettingsContent.slot_width * 0.4));
                            codes: StreamFiltersBridge.language_codes; names: StreamFiltersBridge.language_names;
                            selected-codes: StreamFiltersBridge.selected_language_codes; selected-names: StreamFiltersBridge.selected_language_names;
                            current-label: @tr("Add language");
                            keyboard-mode: SettingsBridge.kb_active; edit-requested: SettingsContent.kb_edit == 8;
                            search(query, _) => { StreamFiltersBridge.language_search(query); }
                            edited(code, action, _) => { root.select_filter(SettingsContent.kb_stream_filter_audio_picker()); StreamFiltersBridge.language_edited(code, action); }
                            focus_changed(focused) => { SettingsContent.player_language_input_focused = focused; if focused { root.select_filter(SettingsContent.kb_stream_filter_audio_picker()); } }
                            reveal(y, h) => { SettingsContent.reveal_detail_control(y, h); }
                            accepted => { SettingsContent.kb_edit = 0; SettingsContent.player_language_input_focused = false; SettingsContent.focus_shell(); }
                        }
                    }
                }
                StreamRuleToggle {
                    setting-key: "stream_filters_require_audio";
                    row-title: @tr("Require one of these audio languages");
                    row-desc: @tr("Hide streams with other advertised audio languages. An empty preference list allows every language.");
                    rule-field: 8; rule-row: SettingsContent.kb_stream_filter_require(); checked <=> StreamFiltersBridge.require_audio;
                }
                if StreamFiltersBridge.notice != "": Rectangle {
                    height: filter_notice.preferred-height + 28px; vertical-stretch: 0;
                    filter_notice := Text { x: 16px; y: 14px; width: Math.max(1px, parent.width - 32px); text: StreamFiltersBridge.notice; font-size: 13px; color: Theme.current.text_destructive; wrap: word-wrap; }
                }
            }
            SectionHeader { label: @tr("Unknown details"); }
            SettingsCard {
                StreamRuleToggle {
                    setting-key: "stream_filters_retain_unknown";
                    row-title: @tr("Keep streams with unknown details");
                    row-desc: @tr("Keep offers whose resolution, size, codec or audio languages are not advertised.");
                    rule-field: 9; rule-row: SettingsContent.kb_stream_filter_unknown(); checked <=> StreamFiltersBridge.retain_unknown;
                }
            }
            SettingsCard {
                StreamRuleHeading {
                    title: @tr("Sort order"); setting-key: "stream_filters_sort_order";
                    description: @tr("Move any criterion, including audio and codec, to set its priority. Unknown values always stay last.");
                }
                for criterion[index] in StreamFiltersBridge.sort_order: SettingsRow {
                    property <bool> row-focused: root.filter_focused(SettingsContent.kb_stream_filter_sort_start() + index);
                    changed row-focused => { if self.row-focused {
                        SettingsContent.reveal_detail_control(self.absolute-position.y, self.height);
                        if index == 0 && SettingsContent.stream_filter_sort_column == 0 { SettingsContent.stream_filter_sort_column = 1; }
                        else if index + 1 == StreamFiltersBridge.sort_order.length && SettingsContent.stream_filter_sort_column == 1 { SettingsContent.stream_filter_sort_column = 0; }
                    } }
                    row-title: (index + 1) + ". " + SettingsContent.stream_filter_sort_label(criterion);
                    row-desc: criterion == "subtitle" ? @tr("Uses Preferred subtitle languages.") : criterion == "resolution" && StreamFiltersBridge.resolution_priority_order.length > 0 ? @tr("Uses preferred resolutions first; direction orders the remaining resolutions.") : "";
                    sort_actions := Rectangle {
                        width: Math.min(420px, Math.max(1px, SettingsContent.slot_width - 32px));
                        private property <string> direction: SettingsContent.stream_filter_sort_direction(criterion, StreamFiltersBridge.sort_ascending[index]);
                        private property <length> direction_width: Math.min(direction_measure.preferred-width + 28px, self.width);
                        private property <bool> inline: self.width >= sort_up.width + sort_down.width + self.direction_width + 16px;
                        height: self.inline ? Math.max(sort_up.height, sort_direction.height) : sort_up.height + 8px + sort_direction.height;
                        direction_measure := Text { width: 0px; height: 0px; text: parent.direction; font-size: InterfaceStyle.tv ? 20px : 13px; }
                        sort_up := AddonIconButton {
                            x: 0px; y: 0px;
                            name: @tr("Move up") + ": " + SettingsContent.stream_filter_sort_label(criterion); enabled: index > 0;
                            focused: root.filter_focused(SettingsContent.kb_stream_filter_sort_start() + index) && SettingsContent.stream_filter_sort_column == 0;
                            Image { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 20px; height: 20px; source: @image-url("../../assets/icons/addons/arrow-up.svg"); colorize: Theme.current.text_settings; }
                            clicked => { root.sort_action(criterion, index, 0); }
                        }
                        sort_down := AddonIconButton {
                            x: sort_up.width + 8px; y: 0px;
                            name: @tr("Move down") + ": " + SettingsContent.stream_filter_sort_label(criterion); enabled: index + 1 < StreamFiltersBridge.sort_order.length;
                            focused: root.filter_focused(SettingsContent.kb_stream_filter_sort_start() + index) && SettingsContent.stream_filter_sort_column == 1;
                            Image { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 20px; height: 20px; source: @image-url("../../assets/icons/addons/arrow-down.svg"); colorize: Theme.current.text_settings; }
                            clicked => { root.sort_action(criterion, index, 1); }
                        }
                        sort_direction := PillButton {
                            x: sort_actions.inline ? sort_down.x + sort_down.width + 8px : 0px;
                            y: sort_actions.inline ? 0px : sort_up.height + 8px;
                            width: sort_actions.direction_width; wrap_label: true;
                            label: sort_actions.direction;
                            accessible-label: @tr("Sort direction") + ": " + SettingsContent.stream_filter_sort_label(criterion);
                            focused: root.filter_focused(SettingsContent.kb_stream_filter_sort_start() + index) && SettingsContent.stream_filter_sort_column == 2;
                            clicked => { root.sort_action(criterion, index, 2); }
                        }
                    }
                }
            }
            SettingsCard {
                SettingsRow {
                    row-title: @tr("Reset rules");
                    PillButton {
                        label: @tr("Reset"); focused: root.filter_focused(SettingsContent.kb_stream_filter_reset());
                        clicked => {
                            root.select_filter(0); StreamFiltersBridge.reset();
                            SettingsContent.kb_edit = 0; SettingsContent.player_language_input_focused = false; SettingsContent.focus_shell();
                        }
                    }
                }
            }
        }
    }
}
