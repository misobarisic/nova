import { SettingsContent } from "@NovaUiShared";
import { SyncSettingsPage } from "@NovaUiBase/sync-settings.slint";

// The existing compiled globals retain their identity across the page boundary.
export component SettingsSyncModule inherits Window {
    default-font-family: "Roboto";
    background: transparent;
    width: SettingsContent.slot_width; height: SettingsContent.slot_height;
    SyncSettingsPage { width: 100%; height: 100%; }
}
