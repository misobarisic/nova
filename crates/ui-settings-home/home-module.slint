import { SettingsBridge, SettingsContent, Theme, SettingsStyle, InterfaceStyle, ControlInput } from "@NovaUiShared";

import { ControlTouchArea } from "../ui/control-input.slint";

import { PillButton, ToggleSwitch, SectionHeader, SettingsRow, SettingsCard } from "../ui/settings-controls.slint";

// Same pill treatment and native keyboard focus as other Settings actions.
// Only reorder controls hide their caption; their delayed tooltip is painted by
// the section window so the surrounding clipped card cannot cut it off.
component HomeCatalogAction inherits PillButton {
    in property <string> caption;
    in property <image> icon;
    in property <bool> icon-only;
    callback tip(string, length, length);
    label: "";
    accessible-label: root.caption;
    width: root.icon-only ? (InterfaceStyle.tv ? 56px : 44px) : natural_caption.preferred-width + 56px;
    horizontal-stretch: 0; vertical-stretch: 0;
    natural_caption := Text { width: 0px; height: 0px; text: root.caption; font-size: InterfaceStyle.tv ? 20px : 13px; }
    Image {
        x: root.icon-only ? (parent.width - self.width) / 2 : 14px;
        y: (parent.height - self.height) / 2;
        width: 20px; height: 20px; source: root.icon; image-fit: contain;
        colorize: root.destructive ? Theme.current.text_destructive : Theme.current.text_settings;
    }
    if !root.icon-only: Text {
        x: 42px; width: Math.max(0px,parent.width - 56px); height: 100%;
        text: root.caption; font-size: InterfaceStyle.tv ? 20px : 13px;
        color: root.destructive ? Theme.current.text_destructive : Theme.current.text_settings;
        vertical-alignment: center;
    }
    background: root.destructive ? (hit.feedback-active ? Theme.current.destructive_control_hover : Theme.current.destructive_control)
        : hit.feedback-active ? Theme.current.settings_control_hover : Theme.current.settings_control;
    hit := ControlTouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        clicked => { root.tip("",0px,0px); SettingsStyle.keyboard-mode = false; root.clicked(); }
    }
    private property <bool> wants_tip: root.icon-only && root.enabled
        && ((!ControlInput.touch-feedback && hit.has-hover) || root.keyboard_focused);
    changed wants_tip => {
        tip_delay.stop();
        if root.wants_tip { tip_delay.start(); } else { root.tip("",0px,0px); }
    }
    tip_delay := Timer { interval: 400ms; running: false; triggered => {
        self.stop(); if root.wants_tip { root.tip(root.caption,root.absolute-position.x,root.absolute-position.y); }
    } }
}

// The shell owns scrolling and transitions. Report intrinsic layout sizes
// only while this section is selected, so outgoing instances cannot resize it.
export component SettingsHomeModule inherits Window {
    default-font-family: "Roboto";
    background: transparent;
    width: SettingsContent.slot_width; height: SettingsContent.slot_height;
    private property <string> tip_label;
    private property <length> tip_x;
    private property <length> tip_y;
    function show_tip(label: string, x: length, y: length) { root.tip_label = label; root.tip_x = x; root.tip_y = y; }
    private property <length> measured_min: body_layout.min-height;
    private property <length> measured_preferred: body_layout.preferred-height;
    changed measured_min => { root.publish_size(); }
    changed measured_preferred => { root.publish_size(); }
    init => { root.publish_size(); }
    function publish_size() {
        if SettingsBridge.sel == 13 {
            SettingsContent.content_min_height = root.measured_min;
            SettingsContent.content_preferred_height = root.measured_preferred;
        }
    }
    body_layout := VerticalLayout {
        width: 100%; height: 100%; spacing: 0px;
        VerticalLayout {

            vertical-stretch: 0;
            spacing: 18px;

            SectionHeader { icon-kind: 4; label: @tr("HOME CATALOGS"); }
            Text {
                width: 100%; wrap: word-wrap;
                text: @tr("Built-in and addon catalogs appear in this order on Home. Hide, move or remove any catalog.");
                font-size: 14px; color: Theme.current.text_settings;
            }
            if SettingsBridge.home_row_catalog_rows.length == 0: Text {
                width: 100%; wrap: word-wrap;
                text: @tr("No Home catalogs selected. Add a built-in or addon catalog.");
                font-size: 14px; color: Theme.current.text_settings;
            }
            for home_row[i] in SettingsBridge.home_row_catalog_rows: Rectangle {
                background: Theme.current.card;
                border-radius: 16px; border-width: 1px;
                border-color: Theme.current.border_soft;
                clip: true;
                VerticalLayout {
                    spacing: 0px;
                    SettingsRow {
                        setting-key: "home_rows";
                        row-title: home_row.title;
                        row-desc: home_row.builtin ? @tr("Built-in")
                            : home_row.addon + " · " + home_row.media_type
                                + " · " + (home_row.genre == "" ? @tr("All genres") : home_row.genre)
                                + (home_row.available ? (home_row.enabled ? "" : " · " + @tr("Addon disabled")) : " · " + @tr("Unavailable addon"));
                    }
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        padding-bottom: 12px; spacing: 8px;
                        ToggleSwitch {
                            name: home_row.title;
                            checked: home_row.visible;
                            focused: SettingsBridge.kb_zone == 16 && SettingsContent.kb_home == i * 4 && SettingsBridge.kb_active;
                            toggled => {
                                SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                                SettingsBridge.kb_zone = 16; SettingsContent.kb_home = i * 4;
                                root.tip_label = "";
                                SettingsBridge.home_row_catalog_action(i, 0);
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        HomeCatalogAction {
                            caption: @tr("Move up"); icon-only: true; icon: @image-url("../../assets/icons/addons/arrow-up.svg");
                            tip(label,x,y) => { root.show_tip(label,x,y); }
                            btn_min_width: 44px; compact: true;
                            enabled: i > 0;
                            focused: SettingsBridge.kb_zone == 16 && SettingsContent.kb_home == i * 4 + 1 && SettingsBridge.kb_active;
                            clicked => {
                                SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                                SettingsBridge.kb_zone = 16; SettingsContent.kb_home = (i - 1) * 4 + 1;
                                root.tip_label = "";
                                SettingsBridge.home_row_catalog_action(i, 1);
                            }
                        }
                        HomeCatalogAction {
                            caption: @tr("Move down"); icon-only: true; icon: @image-url("../../assets/icons/addons/arrow-down.svg");
                            tip(label,x,y) => { root.show_tip(label,x,y); }
                            btn_min_width: 44px; compact: true;
                            enabled: i + 1 < SettingsBridge.home_row_catalog_rows.length;
                            focused: SettingsBridge.kb_zone == 16 && SettingsContent.kb_home == i * 4 + 2 && SettingsBridge.kb_active;
                            clicked => {
                                SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                                SettingsBridge.kb_zone = 16; SettingsContent.kb_home = (i + 1) * 4 + 2;
                                root.tip_label = "";
                                SettingsBridge.home_row_catalog_action(i, 2);
                            }
                        }
                        HomeCatalogAction {
                            caption: @tr("Remove"); icon: @image-url("../../assets/icons/player/trash.svg"); destructive: true; compact: true;
                            focused: SettingsBridge.kb_zone == 16 && SettingsContent.kb_home == i * 4 + 3 && SettingsBridge.kb_active;
                            clicked => {
                                SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                                SettingsBridge.kb_zone = 16; SettingsContent.kb_home = i * 4 + 3;
                                root.tip_label = "";
                                SettingsBridge.home_row_catalog_action(i, 3);
                            }
                        }
                    }
                }
            }
            PillButton {
                label: @tr("Add catalog"); primary: true; roomy: true;
                focused: SettingsBridge.kb_zone == 16 && SettingsContent.kb_home == SettingsBridge.home_row_catalog_rows.length * 4 && SettingsBridge.kb_active;
                clicked => {
                    SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                    SettingsBridge.kb_zone = 16; SettingsContent.kb_home = SettingsBridge.home_row_catalog_rows.length * 4;
                    SettingsBridge.home_row_catalog_add_requested();
                }
            }
            SettingsCard { SettingsRow {
                setting-key: "home_episode_artwork";
                row-title: @tr("Episode artwork on Home");
                row-desc: @tr("Use episode thumbnails in Continue Watching and Upcoming. Turn off to use show posters.");
                ToggleSwitch {
                    name: @tr("Episode artwork on Home");
                    checked <=> SettingsBridge.home_episode_artwork;
                    focused: SettingsBridge.kb_zone == 16 && SettingsContent.kb_home == SettingsBridge.home_row_catalog_rows.length * 4 + 1 && SettingsBridge.kb_active;
                    toggled => {
                        SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                        SettingsBridge.kb_zone = 16; SettingsContent.kb_home = SettingsBridge.home_row_catalog_rows.length * 4 + 1;
                        SettingsContent.schedule_setting("home_episode_artwork");
                    }
                }
            } }
            SettingsCard { SettingsRow {
                setting-key: "home_devices_enabled";
                row-title: @tr("Playing on your devices");
                row-desc: @tr("Show paired-device playback controls on Home.");
                ToggleSwitch {
                    name: @tr("Playing on your devices");
                    checked <=> SettingsBridge.home_devices_enabled;
                    focused: SettingsBridge.kb_zone == 16 && SettingsContent.kb_home == SettingsBridge.home_row_catalog_rows.length * 4 + 2 && SettingsBridge.kb_active;
                    toggled => {
                        SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                        SettingsBridge.kb_zone = 16; SettingsContent.kb_home = SettingsBridge.home_row_catalog_rows.length * 4 + 2;
                        SettingsContent.schedule_setting("home_devices_enabled");
                    }
                }
            } }

            SectionHeader {
                icon-kind: 4;
                label: @tr("FEATURED SHOWCASE");
            }

            Text {
                width: 100%;
                text: @tr("Choose addon catalogs and optional genres for the rotating banner. Each selection contributes up to five titles.");
                font-size: 14px;
                color: Theme.current.text_settings;
                wrap: word-wrap;
            }

            Rectangle {
                background: Theme.current.card;
                border-radius: 16px;
                border-width: 1px;
                border-color: Theme.current.border_soft;
                clip: true;

                VerticalLayout {
                    spacing: 0px;

                    if SettingsBridge.home_catalog_rows.length == 0: Rectangle {
                        background: Theme.current.card;
                        min-height: 64px;

                        Text {
                            x: 16px;
                            y: (parent.height - self.height) / 2;
                            width: parent.width - 32px;
                            text: @tr("No featured catalogs selected. Add one to choose its genre.");
                            font-size: 14px;
                            color: Theme.current.text_settings;
                            wrap: word-wrap;
                        }
                    }

                    for home[i] in SettingsBridge.home_catalog_rows: SettingsRow {
                        tinted: Math.mod(i, 2) == 0;
                        setting-key: "home_catalog_sources";
                        row-title: home.title;
                        row-desc: home.addon + " · " + home.media_type
                        + " · " + (home.genre == "" ? @tr("All genres") : home.genre)
                        + (home.available ? (home.enabled ? "" : " · " + @tr("Addon disabled")) : " · " + @tr("Unavailable addon"));

                        home_catalog_remove := HomeCatalogAction {
                            caption: @tr("Remove"); icon: @image-url("../../assets/icons/player/trash.svg");
                            destructive: true;
                            roomy: true;
                            focused: SettingsBridge.kb_zone == 16 && SettingsContent.kb_home == SettingsBridge.home_row_catalog_rows.length * 4 + i + 3 && SettingsBridge.kb_active;
                            clicked => {
                                SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                                SettingsBridge.kb_zone = 16;
                                SettingsContent.kb_home = SettingsBridge.home_row_catalog_rows.length * 4 + i + 3;
                                root.tip_label = "";
                                SettingsBridge.home_catalog_removed(i);
                            }
                        }
                    }
                }
            }

            home_catalog_add := PillButton {
                label: @tr("Add catalog");
                primary: true;
                roomy: true;
                focused: SettingsBridge.kb_zone == 16 && SettingsContent.kb_home == SettingsBridge.home_row_catalog_rows.length * 4 + SettingsBridge.home_catalog_rows.length + 3 && SettingsBridge.kb_active;
                clicked => {
                    SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                    SettingsBridge.kb_zone = 16;
                    SettingsContent.kb_home = SettingsBridge.home_row_catalog_rows.length * 4 + SettingsBridge.home_catalog_rows.length + 3;
                    SettingsBridge.home_catalog_add_requested();
                }
            }

        }
    }
    if root.tip_label != "": Rectangle {
        width: tip_text.preferred-width + 20px; height: tip_text.preferred-height + 14px;
        x: Math.max(4px,Math.min(root.tip_x,parent.width - self.width - 4px));
        y: Math.max(4px,root.tip_y - self.height - 8px);
        background: Theme.current.popup; border-width: 1px; border-color: Theme.current.border_medium; border-radius: 6px;
        tip_text := Text { x: 10px; y: 7px; text: root.tip_label; font-size: 12px; color: Theme.current.text_primary; }
    }

}
