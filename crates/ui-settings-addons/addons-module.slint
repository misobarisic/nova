import { SettingsBridge, SettingsContent, Theme, SettingsStyle } from "@NovaUiShared";

import { LibraryFilterChip } from "../ui/filter-chip.slint";

import { SearchField } from "../ui/searchfield.slint";

import { KbMark } from "../ui/kbnav.slint";

import { PillButton, AddonRowCard, SectionHeader, SettingsCard } from "../ui/settings-controls.slint";

// The shell owns scrolling and transitions. Report intrinsic layout sizes
// only while this section is selected, so outgoing instances cannot resize it.
export component SettingsAddonsModule inherits Window {
    default-font-family: "Roboto";
    background: transparent;
    width: SettingsContent.slot_width; height: SettingsContent.slot_height;
    private property <length> measured_min: body_layout.min-height;
    private property <length> measured_preferred: body_layout.preferred-height;
    private property <bool> browse_keyboard: SettingsBridge.kb_zone == 19 && SettingsBridge.kb_active;
    private property <int> browser_row_count: SettingsBridge.addon_browser_rows.length;
    changed browser_row_count => {
        SettingsBridge.addon_browser_control = Math.min(SettingsBridge.addon_browser_control, 6 + root.browser_row_count);
    }
    changed measured_min => { root.publish_size(); }
    changed measured_preferred => { root.publish_size(); }
    init => { root.publish_size(); }
    function publish_size() {
        if SettingsBridge.sel == 0 {
            SettingsContent.content_min_height = root.measured_min;
            SettingsContent.content_preferred_height = root.measured_preferred;
        }
    }
    body_layout := VerticalLayout {
        width: 100%; height: 100%; spacing: 0px;
        HorizontalLayout {
            height: 44px; vertical-stretch: 0;
            spacing: 8px; alignment: start;
            PillButton {
                label: @tr("Installed");
                primary: SettingsBridge.addon_browser_tab == 0;
                focused: SettingsBridge.kb_zone == 18 && SettingsBridge.kb_active && SettingsBridge.addon_browser_tab == 0;
                clicked => { SettingsContent.focus_shell(); SettingsBridge.kb_zone = 18; SettingsBridge.addon_browser_tab = 0; }
            }
            PillButton {
                label: @tr("Browse");
                primary: SettingsBridge.addon_browser_tab == 1;
                focused: SettingsBridge.kb_zone == 18 && SettingsBridge.kb_active && SettingsBridge.addon_browser_tab == 1;
                clicked => { SettingsContent.focus_shell(); SettingsBridge.kb_zone = 18; SettingsBridge.addon_browser_tab = 1; SettingsBridge.addon_browser_load(false); }
            }
        }
        Rectangle { height: 18px; vertical-stretch: 0; }
        installed_section := Rectangle {

                // Conditional layouts report vertical size at their
                // preferred width. Use the actual viewport so narrow
                // wrapped copy contributes its full height to scrolling.
                width: SettingsContent.slot_width;
                vertical-stretch: 0;
                height: SettingsBridge.addon_browser_tab == 0 ? addons_body.preferred-height : 0px;
                visible: SettingsBridge.addon_browser_tab == 0;
                clip: SettingsBridge.addon_browser_tab != 0;
                addons_body := VerticalLayout {
                width: 100%;
                spacing: 18px;

                SectionHeader { label: @tr("Installation"); }

                // ---- Addons ------------------------------------

                SettingsCard { install_box := Rectangle {
                        background: Theme.current.card;
                        // Dynamic narrow height (same wrapped-text
                        // measuring quirk as SettingsRow above):
                        // the stacked description wraps to 2+
                        // lines but Slint sizes wrapped text at
                        // one line, so without the hidden copy
                        // below the box clips the input row.
                        min-height: SettingsContent.narrow ? Math.max(88px, 105px + install_desc_measure.height) : 88px;

                        if !SettingsContent.narrow: HorizontalLayout {
                            width: 100%;
                            padding-top: 14px;
                            padding-bottom: 14px;
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 16px;

                            VerticalLayout {
                                width: 360px;
                                alignment: center;
                                spacing: 3px;

                                Text {
                                    text: @tr("Install addon");
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: Theme.current.text_bright;
                                }

                                Text {
                                    text: @tr("Paste an addon install URL and add it to the catalog sources.");
                                    font-size: 14px;
                                    color: Theme.current.text_settings;
                                    wrap: word-wrap;
                                    width: 360px;
                                    height: 44px;
                                }
                            }

                            // Centered so the input keeps its
                            // natural height in the tall row.
                            // Stretched so the input fills the
                            // space left by the fixed text
                            // column (same as Discover filters).
                            VerticalLayout {
                                height: 100%;
                                horizontal-stretch: 1;
                                alignment: center;

                                HorizontalLayout {
                                    width: 100%;
                                    // Pinned like Discover wide
                                    // filter rows: 32px tall so
                                    // the input stretches to the
                                    // full button height instead
                                    // of collapsing to its
                                    // preferred height.
                                    height: 44px;
                                    spacing: 16px;

                                    KbMark { on: SettingsBridge.kb_zone == 1 && SettingsContent.kb_actl == 0; active: SettingsBridge.kb_active; }
                                    addon_url_wide := SearchField {
                                        show-pointer-focus: false; keyboard-mode: SettingsBridge.kb_active;
                                        roomy: true;
                                        text <=> SettingsBridge.addon_url;
                                        placeholder-text: @tr("Addon install URL — e.g. https://v3-cinemeta.strem.io");
                                        focus_changed(focused) => { SettingsContent.input_focused = focused; if (focused && SettingsBridge.kb_active) { SettingsContent.reveal_detail_control(self.absolute-position.y, self.height); } }
                                        // Redundant with the two-way binding on
                                        // desktop, but keeps the model in sync on
                                        // Android IME commit paths.
                                        edited(t) => { SettingsBridge.addon_url = t; }
                                        accepted(t) => {
                                            SettingsBridge.addon_url = t;
                                            SettingsContent.kb_edit = 0;
                                            SettingsContent.focus_shell();
                                            SettingsBridge.addon_added(t);
                                        }
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        max-width: 560px;
                                    }

                                    // Focuses the field on demand: page scope
                                    // cannot see ids inside `if`, but this
                                    // timer (inside the branch) can.
                                    edit_t1 := Timer {
                                        interval: 80ms;
                                        running: SettingsContent.kb_edit == 1 && !SettingsContent.narrow;
                                        triggered => { addon_url_wide.focus(); }
                                    }

                                    PillButton {
                                        label: @tr("Add");
                                        primary: true;
                                        roomy: true;
                                        btn_min_width: 92px;
                                        focused: SettingsBridge.kb_zone == 1 && SettingsContent.kb_actl == 1 && SettingsBridge.kb_active;
                                        clicked => { SettingsContent.focus_shell(); SettingsBridge.kb_active = SettingsStyle.keyboard-mode; SettingsBridge.kb_zone = 1; SettingsContent.kb_actl = 1; SettingsBridge.addon_added(addon_url_wide.full-text); }
                                    }
                                }
                            }
                        }

                        if SettingsContent.narrow: VerticalLayout {
                            width: 100%;
                            padding-top: 14px;
                            padding-bottom: 14px;
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 10px;

                            VerticalLayout {
                                spacing: 3px;

                                Text {
                                    text: @tr("Install addon");
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: Theme.current.text_bright;
                                }

                                Text {
                                    text: @tr("Paste an addon install URL and add it to the catalog sources.");
                                    font-size: 14px;
                                    color: Theme.current.text_settings;
                                    wrap: word-wrap;
                                }
                            }

                            // Constrained to the card width: without
                            // width: 100% the LineEdit sizes to
                            // its preferred width and pushes the
                            // Add button off-screen on portrait
                            // phones (the card clips it).
                            HorizontalLayout {
                                width: 100%;
                                // Pinned like Discover narrow
                                // search row: 44px touch targets.
                                height: 44px;
                                spacing: 12px;

                                KbMark { on: SettingsBridge.kb_zone == 1 && SettingsContent.kb_actl == 0; active: SettingsBridge.kb_active; }
                                addon_url_narrow := SearchField {
                                    show-pointer-focus: false; keyboard-mode: SettingsBridge.kb_active;
                                    roomy: true;
                                    text <=> SettingsBridge.addon_url;
                                    placeholder-text: @tr("Addon install URL — e.g. https://v3-cinemeta.strem.io");
                                    focus_changed(focused) => { SettingsContent.input_focused = focused; if (focused && SettingsBridge.kb_active) { SettingsContent.reveal_detail_control(self.absolute-position.y, self.height); } }
                                    edited(t) => { SettingsBridge.addon_url = t; }
                                    accepted(t) => {
                                        SettingsBridge.addon_url = t;
                                        SettingsContent.kb_edit = 0;
                                        SettingsContent.focus_shell();
                                        SettingsBridge.addon_added(t);
                                    }
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                }

                                edit_t1n := Timer {
                                    interval: 80ms;
                                    running: SettingsContent.kb_edit == 1 && SettingsContent.narrow;
                                    triggered => { addon_url_narrow.focus(); }
                                }

                                PillButton {
                                    label: @tr("Add");
                                    primary: true;
                                    roomy: true;
                                    btn_min_width: 92px;
                                    focused: SettingsBridge.kb_zone == 1 && SettingsContent.kb_actl == 1 && SettingsBridge.kb_active;
                                    clicked => { SettingsContent.focus_shell(); SettingsBridge.kb_active = SettingsStyle.keyboard-mode; SettingsBridge.kb_zone = 1; SettingsContent.kb_actl = 1; SettingsBridge.addon_added(addon_url_narrow.full-text); }
                                }
                            }
                        }

                        // Hidden measurement copy of the narrow
                        // description (see SettingsRow): its real
                        // wrapped height drives the box minimum
                        // above so the input row is never clipped.
                        Rectangle {
                            height: 0;
                            clip: true;

                            install_desc_measure := Text {
                                width: install_box.width - 32px;
                                text: @tr("Paste an addon install URL and add it to the catalog sources.");
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                        }
                    } }
                PillButton {
                    label: @tr("Install addon ZIP…");
                    roomy: true;
                    enabled: !SettingsBridge.addon_zip_import_busy;
                    focused: SettingsBridge.kb_zone == 1 && SettingsContent.kb_actl == 2 && SettingsBridge.kb_active;
                    clicked => {
                        SettingsContent.focus_shell();
                        SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                        SettingsBridge.kb_zone = 1;
                        SettingsContent.kb_actl = 2;
                        SettingsBridge.addon_zip_import_requested();
                    }
                }
                if SettingsBridge.addon_zip_import_status != "": zip_status := Rectangle {
                    width: 100%; min-width: 0px;
                    min-height: zip_status_measure.height;
                    vertical-stretch: 0;
                    Text {
                        width: 100%; height: parent.height;
                        text: SettingsBridge.addon_zip_import_status;
                        font-size: 14px;
                        color: Theme.current.text_settings;
                        wrap: word-wrap;
                    }
                    // At phone widths, publish the actual wrapped status height
                    // so the shell's scroll extent includes errors in full.
                    Rectangle {
                        height: 0px; clip: true;
                        zip_status_measure := Text {
                            width: zip_status.width;
                            text: SettingsBridge.addon_zip_import_status;
                            font-size: 14px; wrap: word-wrap;
                        }
                    }
                }
                if !SettingsBridge.cinemeta_installed: cinemeta_suggestion := Rectangle {
                    min-width: 0px;
                    vertical-stretch: 0;
                    // As with install_box, wrapped text needs a measured
                    // height so Flickable includes every line in its extent.
                    min-height: cinemeta_description_measure.height + 8px + cinemeta_add.height;
                    // Plain children otherwise centre in the extra button space.
                    cinemeta_description := Text {
                        x: 0px; y: 0px;
                        width: 100%; height: cinemeta_description_measure.height;
                        text: @tr("Cinemeta supplies movie and series catalogs and metadata. It does not provide streams.");
                        font-size: 14px; wrap: word-wrap; color: Theme.current.text_secondary;
                    }
                    cinemeta_add := PillButton {
                        x: 0px;
                        y: cinemeta_description_measure.height + 8px;
                        label: @tr("Add Cinemeta");
                        clicked => { SettingsContent.focus_shell(); SettingsBridge.addon_added("https://v3-cinemeta.strem.io"); }
                    }
                    Rectangle {
                        height: 0px; clip: true;
                        cinemeta_description_measure := Text {
                            width: cinemeta_suggestion.width;
                            text: @tr("Cinemeta supplies movie and series catalogs and metadata. It does not provide streams.");
                            font-size: 14px; wrap: word-wrap;
                        }
                    }
                }
                installed_controls_origin := Rectangle {
                    height: installed_controls_layout.preferred-height;
                    vertical-stretch: 0;
                }
                Rectangle {
                    background: Theme.current.card;
                    border-radius: 16px;
                    border-width: 1px;
                    border-color: Theme.current.border_soft;
                    clip: true;

                    VerticalLayout {
                        spacing: 0px;

                        // Install row. The 360px text column wraps
                        // the description to 2 lines; the input is
                        // capped so it doesn't span the whole card.
                        // Narrow windows stack the input below the text.

                        if SettingsBridge.addon_rows.length == 0: Rectangle {
                            background: Theme.current.card;
                            min-height: 96px;

                            Text {
                                x: 16px;
                                width: parent.width - 32px;
                                y: (parent.height - self.height) / 2;
                                text: SettingsBridge.addon_search_text != "" || SettingsBridge.addon_capability_filter != 0 ? @tr("No installed addons match these filters.") : @tr("No addons installed yet. Paste an addon install URL above and click Add.");
                                color: Theme.current.text_settings;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                        }

                        VerticalLayout {
                            spacing: 12px;
                            for row[i] in SettingsBridge.addon_rows: AddonRowCard {
                                tinted: Math.mod(i, 2) == 1;
                                title: row.label;
                                caption: row.capabilities;
                                logo: row.logo;
                                initial: row.initial;
                                on: row.enabled;
                                refreshing: row.busy;
                                has_config: row.config_url != "";
                                kb_focused_row: SettingsBridge.kb_zone == 2 && SettingsContent.kb_ar == i;
                                kb_active: SettingsBridge.kb_active;
                                kb_col: SettingsContent.kb_ac;
                                toggled(on) => {
                                    // Row rebuilds must not destroy the only Back route.
                                    SettingsContent.focus_shell();
                                    SettingsBridge.addon_rows[i].enabled = on;
                                    SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                                    SettingsBridge.kb_zone = 2;
                                    SettingsContent.kb_ar = i;
                                    SettingsContent.kb_ac = 0;
                                    SettingsBridge.addon_toggled(i);
                                }
                                configure => { SettingsContent.focus_shell(); SettingsBridge.kb_active = SettingsStyle.keyboard-mode; SettingsBridge.kb_zone = 2; SettingsContent.kb_ar = i; SettingsContent.kb_ac = 1; SettingsBridge.addon_configure(row.config_url); }
                                copy_link => { SettingsContent.focus_shell(); SettingsBridge.kb_active = SettingsStyle.keyboard-mode; SettingsBridge.kb_zone = 2; SettingsContent.kb_ar = i; SettingsContent.kb_ac = 2; SettingsBridge.addon_copy_link(row.url); }
                                refresh => { SettingsContent.focus_shell(); SettingsBridge.kb_active = SettingsStyle.keyboard-mode; SettingsBridge.kb_zone = 2; SettingsContent.kb_ar = i; SettingsContent.kb_ac = 3; SettingsBridge.addon_refresh(i); }
                                remove => { SettingsContent.focus_shell(); SettingsBridge.kb_active = SettingsStyle.keyboard-mode; SettingsBridge.kb_zone = 2; SettingsContent.kb_ar = i; SettingsContent.kb_ac = 4; SettingsBridge.addon_remove(i); }
                                move_up => { SettingsContent.focus_shell(); SettingsBridge.kb_active = SettingsStyle.keyboard-mode; SettingsBridge.kb_zone = 2; SettingsContent.kb_ac = 5; SettingsBridge.addon_move_up(i); SettingsContent.kb_ar = Math.max(0, i - 1); }
                                move_down => { SettingsContent.focus_shell(); SettingsBridge.kb_active = SettingsStyle.keyboard-mode; SettingsBridge.kb_zone = 2; SettingsContent.kb_ac = 6; SettingsBridge.addon_move_down(i); SettingsContent.kb_ar = Math.min(SettingsBridge.addon_rows.length - 1, i + 1); }
                            }
                        }
                    }
                }
            }

        }
        if SettingsBridge.addon_browser_tab == 1: Rectangle {
            height: browse_body.preferred-height;
            vertical-stretch: 0;
            browse_body := VerticalLayout {
                width: 100%; spacing: 16px;
                SectionHeader { label: @tr("Browse addons"); }
                Text {
                    text: @tr("Browse public Stremio addons and choose which to install. Nova addon ZIPs can be installed from the Installed tab.");
                    wrap: word-wrap; font-size: 14px; color: Theme.current.text_settings;
                }
                HorizontalLayout {
                    alignment: start; spacing: 8px;
                    PillButton {
                        label: @tr("Official"); primary: SettingsBridge.addon_browser_source == 0;
                        focused: root.browse_keyboard && SettingsBridge.addon_browser_control == 0 && SettingsBridge.addon_browser_source == 0;
                        clicked => { SettingsContent.focus_shell(); SettingsBridge.addon_browser_source = 0; SettingsBridge.addon_browser_load(false); }
                    }
                    PillButton {
                        label: @tr("Custom directory"); primary: SettingsBridge.addon_browser_source == 1;
                        focused: root.browse_keyboard && SettingsBridge.addon_browser_control == 0 && SettingsBridge.addon_browser_source == 1;
                        clicked => { SettingsContent.focus_shell(); SettingsBridge.addon_browser_source = 1; SettingsBridge.addon_browser_filter_changed(); }
                    }
                }
                if SettingsBridge.addon_browser_source == 1: VerticalLayout {
                    spacing: 10px;
                    browser_directory_input := SearchField {
                        roomy: true;
                        text <=> SettingsBridge.addon_browser_directory_url;
                        placeholder-text: @tr("HTTPS addon-directory manifest URL");
                        focus_changed(focused) => { SettingsContent.input_focused = focused; }
                        edited(value) => { SettingsBridge.addon_browser_directory_url = value; }
                        accepted(value) => { SettingsBridge.addon_browser_directory_url = value; SettingsContent.kb_edit = 0; SettingsContent.focus_shell(); SettingsBridge.addon_browser_load(false); }
                        KbMark { on: root.browse_keyboard && SettingsBridge.addon_browser_control == 1; active: SettingsBridge.kb_active; }
                    }
                    Timer { interval: 80ms; running: SettingsContent.kb_edit == 6; triggered => { browser_directory_input.focus(); } }
                    PillButton {
                        label: @tr("Load directory"); roomy: true;
                        focused: root.browse_keyboard && SettingsBridge.addon_browser_control == 2;
                        clicked => { SettingsContent.focus_shell(); SettingsBridge.addon_browser_load(false); }
                    }
                    Text {
                        text: @tr("Use a directory that publishes the Stremio addon_catalog resource. The directory's own terms apply.");
                        wrap: word-wrap; font-size: 13px; color: Theme.current.text_secondary;
                    }
                }
                browser_search_input := SearchField {
                    roomy: true; search-icon: true;
                    text <=> SettingsBridge.addon_browser_search;
                    placeholder-text: @tr("Search public addons…");
                    focus_changed(focused) => { SettingsContent.input_focused = focused; }
                    edited(value) => { SettingsBridge.addon_browser_search = value; SettingsBridge.addon_browser_filter_changed(); }
                    accepted(value) => { SettingsBridge.addon_browser_search = value; SettingsContent.kb_edit = 0; SettingsContent.focus_shell(); SettingsBridge.addon_browser_filter_changed(); }
                    KbMark { on: root.browse_keyboard && SettingsBridge.addon_browser_control == 3; active: SettingsBridge.kb_active; }
                }
                Timer { interval: 80ms; running: SettingsContent.kb_edit == 7; triggered => { browser_search_input.focus(); } }
                Flickable {
                    height: 40px; vertical-stretch: 0;
                    content-width: browser_filters.preferred-width; content-height: self.height;
                    mouse-drag-pan-enabled: true;
                    browser_filters := HorizontalLayout {
                        width: self.preferred-width; height: 40px; spacing: 8px; alignment: start;
                        for caption[i] in [@tr("All"), @tr("Catalogs"), @tr("Streams"), @tr("Subtitles")]: LibraryFilterChip {
                            label: caption;
                            selected: SettingsBridge.addon_browser_filter == i;
                            focused: root.browse_keyboard && SettingsBridge.addon_browser_control == 4 && SettingsBridge.addon_browser_filter == i;
                            keyboard-focusable: true; arrow-navigation: true;
                            touch_feedback: SettingsBridge.is_android;
                            picked => { SettingsBridge.addon_browser_filter = i; SettingsBridge.addon_browser_filter_changed(); }
                            navigate(direction) => { SettingsBridge.addon_browser_filter = Math.mod(i + direction + 4, 4); SettingsBridge.addon_browser_filter_changed(); }
                        }
                    }
                }
                if SettingsBridge.addon_browser_source_url != "": PillButton {
                    label: @tr("Source: ") + SettingsBridge.addon_browser_source_name;
                    width: 100%; min-width: 0px;
                    wrap_label: true;
                    focused: root.browse_keyboard && SettingsBridge.addon_browser_control == 5;
                    clicked => { SettingsContent.focus_shell(); SettingsBridge.addon_browser_source_open(); }
                }
                if SettingsBridge.addon_browser_status != "": Text {
                    text: SettingsBridge.addon_browser_status;
                    wrap: word-wrap; font-size: 14px; color: Theme.current.text_settings;
                }
                PillButton {
                    label: @tr("Refresh / retry");
                    focused: root.browse_keyboard && SettingsBridge.addon_browser_control == 6;
                    enabled: !SettingsBridge.addon_browser_busy;
                    clicked => { SettingsContent.focus_shell(); SettingsBridge.addon_browser_load(true); }
                }
                if SettingsBridge.addon_browser_rows.length == 0 && !SettingsBridge.addon_browser_busy: Text {
                    text: @tr("No addons to show. Load a directory or change your search and filters.");
                    wrap: word-wrap; font-size: 14px; color: Theme.current.text_secondary;
                }
                for row[index] in SettingsBridge.addon_browser_rows: SettingsCard {
                    border-color: root.browse_keyboard && SettingsBridge.addon_browser_control == 7 + index ? Theme.current.focus_ring : Theme.current.border_soft;
                    border-width: root.browse_keyboard && SettingsBridge.addon_browser_control == 7 + index ? 2px : 1px;
                    VerticalLayout {
                        padding: 16px; spacing: 10px;
                        HorizontalLayout {
                            spacing: 14px;
                            Rectangle {
                                width: 48px; height: 48px;
                                background: Theme.current.settings_control; border-radius: 10px;
                                if row.logo.width > 0: Image { source: row.logo; width: 100%; height: 100%; image-fit: contain; }
                                if row.logo.width == 0: Text {
                                    text: row.initial; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center;
                                    color: Theme.current.text_bright; font-size: 22px;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px; alignment: center; min-width: 0px; horizontal-stretch: 1;
                                Text { text: row.label; wrap: word-wrap; color: Theme.current.text_bright; font-size: 16px; font-weight: 600; }
                                Text { text: row.capabilities; wrap: word-wrap; color: Theme.current.text_secondary; font-size: 13px; }
                            }
                        }
                        // A bounded preview keeps large public descriptions
                        // from stretching every card on phone screens.
                        Text {
                            text: row.description; wrap: word-wrap;
                            overflow: elide; height: 60px;
                            color: Theme.current.text_settings; font-size: 14px;
                        }
                        HorizontalLayout {
                            alignment: start; spacing: 10px;
                            PillButton {
                                label: row.busy ? @tr("Installing…") : row.installed ? @tr("Installed") : row.configurable ? @tr("Configure") : @tr("Install");
                                enabled: !row.busy && !row.installed;
                                primary: !row.installed; roomy: true;
                                focused: root.browse_keyboard && SettingsBridge.addon_browser_control == 7 + index && !SettingsBridge.addon_browser_copy_column;
                                clicked => { SettingsContent.focus_shell(); SettingsBridge.addon_browser_action(row.url); }
                            }
                            PillButton {
                                label: @tr("Copy link"); roomy: true;
                                focused: root.browse_keyboard && SettingsBridge.addon_browser_control == 7 + index && SettingsBridge.addon_browser_copy_column;
                                clicked => { SettingsContent.focus_shell(); SettingsBridge.addon_copy_link(row.url); }
                            }
                        }
                    }
                }
            }
        }
    }
    // One control subtree retains its IME/focus state while its placeholder
    // continues to reserve the original section height in the document.
    installed_controls := Rectangle {
        visible: SettingsBridge.addon_browser_tab == 0;
        property <length> target_top: SettingsContent.detail_sticky_top + SettingsContent.detail_header_height;
        property <bool> pinned: installed_controls_origin.absolute-position.y <= self.target_top;
        property <length> pinned_height: self.pinned && SettingsBridge.addon_browser_tab == 0 ? self.height + 8px : 0px;
        changed pinned_height => { if SettingsBridge.sel == 0 { SettingsContent.detail_pinned_controls_height = self.pinned_height; } }
        init => { if SettingsBridge.sel == 0 { SettingsContent.detail_pinned_controls_height = self.pinned_height; } }
        x: 0px;
        y: installed_section.y + installed_controls_origin.y + Math.max(0px, self.target_top - installed_controls_origin.absolute-position.y);
        width: 100%;
        height: installed_controls_layout.preferred-height;
        if self.pinned: Rectangle {
            x: -SettingsContent.detail_cover_left;
            width: parent.width + SettingsContent.detail_cover_left + SettingsContent.detail_cover_right;
            height: parent.height;
            background: Theme.current.artwork_canvas;
            TouchArea { width: 100%; height: 100%; clicked => {} }
        }
        installed_controls_layout := VerticalLayout {
            spacing: 18px;
                SectionHeader { label: @tr("Installed sources"); }
                installed_addon_search := SearchField {
                    placeholder-text: @tr("Search installed addons…");
                    text <=> SettingsBridge.addon_search_text;
                    search-icon: true;
                    focus_changed(focused) => { SettingsContent.input_focused = focused; }
                    edited(t) => { SettingsBridge.addon_search_text = t; SettingsBridge.addon_filter_changed(); }
                }
                capability_rail := Flickable {
                    height: 40px;
                    vertical-stretch: 0;
                    content-width: capability_chips.preferred-width;
                    content-height: self.height;
                    interactive: true;
                    mouse-drag-pan-enabled: true;
                    property <int> focused_index: -1;
                    property <length> selected_left: 0px;
                    property <length> selected_width: 0px;
                    function reveal(left: length, w: length) {
                        self.selected_left = left; self.selected_width = w;
                        let min_x = Math.min(0px, self.width - self.content-width);
                        self.content-x = Math.max(min_x, Math.min(0px, self.content-x));
                        if left < -self.content-x { self.content-x = -left; }
                        else if left + w > -self.content-x + self.width { self.content-x = Math.max(min_x, self.width - left - w); }
                    }
                    function pick(index: int) {
                        SettingsBridge.addon_capability_filter = index;
                        SettingsBridge.addon_filter_changed();
                    }
                    changed width => { self.reveal(self.selected_left, self.selected_width); }
                    changed content-width => { self.reveal(self.selected_left, self.selected_width); }
                    capability_chips := HorizontalLayout {
                        x: 0px; y: 0px;
                        width: self.preferred-width;
                        height: 40px;
                        spacing: 8px;
                        alignment: start;
                        for caption[i] in [@tr("All"), @tr("Searchable catalogs"), @tr("Metadata"), @tr("Streams"), @tr("Subtitles")]: LibraryFilterChip {
                            label: caption;
                            selected: SettingsBridge.addon_capability_filter == i;
                            touch_feedback: SettingsBridge.is_android;
                            keyboard-focusable: true;
                            arrow-navigation: true;
                            focus-when-selected: capability_rail.focused_index >= 0 && SettingsStyle.keyboard-mode;
                            picked => { capability_rail.pick(i); }
                            navigate(direction) => {
                                SettingsStyle.keyboard-mode = true;
                                capability_rail.pick(Math.mod(i + direction + 5, 5));
                            }
                            focus_changed(focused) => {
                                if focused {
                                    capability_rail.focused_index = i;
                                    if SettingsStyle.keyboard-mode && !installed_controls.pinned { SettingsContent.reveal_detail_control(capability_rail.absolute-position.y, capability_rail.height); }
                                } else if capability_rail.focused_index == i { capability_rail.focused_index = -1; }
                            }
                            reveal(left, w) => { capability_rail.reveal(left, w); }
                        }
                    }
                }

        }
        if self.pinned: Rectangle {
            x: -SettingsContent.detail_cover_left; y: parent.height;
            width: parent.width + SettingsContent.detail_cover_left + SettingsContent.detail_cover_right;
            height: 8px;
            background: @linear-gradient(180deg, Theme.current.artwork_canvas, transparent);
            TouchArea { width: 100%; height: 100%; clicked => {} }
        }
    }

}
