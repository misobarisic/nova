export global SettingsSync {
    in-out property <[SettingSyncInfo]> rows;
    // Mirrors the device's actual cross-device sync setting. Scope badges are
    // presentation only and disappear when syncing is disabled.
    in-out property <bool> enabled: false;
    in-out property <bool> open: false;
    in-out property <string> selected_key;
    in-out property <string> selected_title;
    pure callback lookup(string) -> int;
    callback requested();
    callback override_changed(string, bool);
    changed enabled => { if !self.enabled { self.open = false; } }
    public function show(key: string, title: string) {
        self.selected_key = key;
        self.selected_title = title;
        self.requested();
        self.open = true;
    }
}

export global ControlInput {
    in-out property <bool> touch-feedback: false;
}

export global SliderGesture {
    in-out property <bool> active: false;
    in-out property <bool> hovered: false;
}

export global PlaybackSpeed {
    out property <float> minimum: 0.5;
    out property <float> maximum: 2.0;
    out property <float> span: maximum - minimum;

    /// "1.25×" — Slint has no printf-style formatting, so the hundredths are
    /// padded by hand (the value is already clamped by the backend).
    public pure function label(speed: float) -> string {
        let hundredths = Math.round(speed * 100);
        let fraction = Math.mod(hundredths, 100);
        return Math.floor(hundredths / 100) + "." + (fraction < 10 ? "0" : "") + fraction + "×";
    }
}
