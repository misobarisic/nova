// Shared state and pure helpers, without page visual trees.
import { SettingSyncInfo, SettingsDestination } from "../ui/types.slint";

export global NavMetrics {
    out property <length> rail-width: 64px;

    public pure function width-for(viewport-width: length) -> length {
        return root.rail-width;
    }
}

export global NavState {
    // Section IDs are shared with backend routing and the narrow bottom bar.
    // Only the wide rail places Calendar and Downloads before More.
    public pure function step(section: int, direction: int, narrow: bool) -> int {
        if (narrow) { return Math.mod(Math.min(3, Math.max(0, section)) + direction + 4, 4); }
        let slot = section == 3 ? 5 : section >= 4 ? section - 1 : section;
        let next = Math.mod(slot + direction + 6, 6);
        return next == 5 ? 3 : next >= 3 ? next + 1 : next;
    }

    callback calendar_picked();
    callback downloads_picked();
    // Section the current switch is coming from (0 Home, 1 Discover,
    // 2 Library, 3 More, 4 Calendar, 5 Downloads). Consumed by the new bar so a rebuild
    // (returning from detail or resizing) does not replay the selected icon's pop.
    in-out property <int> from: 0;
}

export global SettingsStyle {
    in-out property <bool> keyboard-mode: false;
    in-out property <length> focus-y;
    in-out property <length> focus-height;
    in-out property <bool> navigation-focus: false;
    in-out property <int> focus-request: 0;
}

