import { RemoteOfferRow, RemoteDeviceRow, TrackRow } from "../ui/types.slint";

export struct RemoteChapterRow { id: string, title: string, time: string }
export struct RemoteBookmarkRow { id: string, note: string, time: string }

// Receiver snapshots only; this bridge never holds a video surface or source URL.
export global RemoteBridge {
    // UI-owned picker captures the session so a stale row cannot change a replacement.
    in-out property <int> track_picker;
    in-out property <string> track_picker_session;
    // UI-owned lease identity survives page teardown so release uses the original session.
    in-out property <string> speed_preview_token;
    in-out property <[RemoteDeviceRow]> devices;
    // Published with discovery snapshots; an idle peer does not create a Home section.
    in-out property <bool> has_playing_devices;
    // Available receivers gate the compact stream-output picker.
    in-out property <bool> has_ready_devices;
    in-out property <[RemoteOfferRow]> offers;
    in-out property <bool> controls_open;
    // Rendering lifetime only; this never grants controller/session authority.
    in-out property <bool> controls_visual_retained;
    in-out property <string> menu_page;
    in-out property <int> back_request;
    in-out property <bool> devices_open;
    in-out property <string> target_id;
    in-out property <string> target_name;
    in-out property <bool> connected;
    in-out property <bool> loading;
    in-out property <string> error;
    in-out property <string> title;
    in-out property <string> episode;
    in-out property <string> phase;
    in-out property <string> time_text;
    in-out property <string> session;
    in-out property <string> prompt;
    in-out property <bool> resume_prompt;
    in-out property <string> prompt_token;
    in-out property <string> replacement_title;
    in-out property <string> replacement_token;
    in-out property <float> position;
    in-out property <float> duration;
    in-out property <float> volume;
    in-out property <float> speed;
    in-out property <bool> paused;
    in-out property <bool> muted;
    in-out property <bool> fullscreen;
    in-out property <bool> can_pause;
    in-out property <bool> can_mute;
    in-out property <bool> can_stop;
    in-out property <bool> can_seek;
    in-out property <bool> can_volume;
    in-out property <bool> can_speed;
    in-out property <bool> can_tracks;
    in-out property <bool> can_screenshot;
    in-out property <bool> can_fullscreen;
    in-out property <[TrackRow]> audio_tracks;
    in-out property <[TrackRow]> sub_tracks;
    in-out property <[RemoteChapterRow]> chapters;
    in-out property <bool> chapters_truncated;
    in-out property <bool> bookmarks_truncated;
    in-out property <[RemoteBookmarkRow]> bookmarks;
    in-out property <[TrackRow]> secondary_sub_tracks;
    in-out property <int> secondary_subtitle_position;
    in-out property <[float]> subtitle_style: [0, 56, 19, 100, 3, 0, 0];
    in-out property <int> intro_skip_mode: -1;
    in-out property <int> skip_segment_kind;
    in-out property <string> skip_token;
    in-out property <string> bookmark_notice;
    in-out property <int> subtitle_addon_status;
    in-out property <int> decoder;
    in-out property <float> brightness;
    in-out property <bool> automatic_recovery;
    in-out property <bool> can_chapters;
    in-out property <bool> can_subtitle_style;
    in-out property <bool> can_secondary_subtitles;
    in-out property <bool> can_intro_skip;
    in-out property <bool> can_bookmarks;
    in-out property <bool> can_source_recovery;
    in-out property <bool> can_source_offers;
    in-out property <bool> can_subtitle_discovery;
    in-out property <bool> can_decoder;
    in-out property <bool> can_brightness;
    in-out property <int> semantic_revision;
    in-out property <string> semantic_name;
    in-out property <string> semantic_id;
    in-out property <string> semantic_session;
    in-out property <bool> semantic_success;
    in-out property <string> semantic_notice;
    callback action(string, float, string);
    callback semantic_action(string, float, string, string, string);
    callback controls_visual_closed();
    callback device_refresh();
    callback device_open(string);
    callback device_selected(string);
    callback device_close();
    callback stream_picked(int);
    callback replacement_confirmed(string, bool);
}
