// Effective account defaults plus this device's ordinary Settings override.
export global StreamFiltersBridge {
    in-out property <bool> enabled;
    in-out property <int> max_resolution_index;
    in-out property <int> max_size_index;
    in-out property <string> max_resolution_label;
    in-out property <string> max_size_label;
    in-out property <bool> allow_avc;
    in-out property <bool> allow_hevc;
    in-out property <bool> allow_av1;
    in-out property <bool> allow_vp9;
    in-out property <bool> allow_other;
    in-out property <bool> block_avc;
    in-out property <bool> block_hevc;
    in-out property <bool> block_av1;
    in-out property <bool> block_vp9;
    in-out property <bool> block_other;
    in-out property <string> codec_priority;
    in-out property <[int]> codec_priority_order;
    in-out property <bool> require_preferred_codec;
    in-out property <[string]> sort_order;
    in-out property <[bool]> sort_ascending;
    in-out property <string> audio_languages;
    in-out property <bool> use_preferred_audio_languages: true;
    in-out property <string> preferred_audio_languages;
    in-out property <[string]> language_codes;
    in-out property <[string]> language_names;
    in-out property <[string]> selected_language_codes;
    in-out property <[string]> selected_language_names;
    in-out property <bool> require_audio;
    in-out property <bool> retain_unknown: true;
    in-out property <int> hidden_count;
    in-out property <string> notice;
    callback edited(int, string);
    callback reset();
    callback language_search(string);
    callback language_edited(string, int);
    callback sort_edited(string, int);
}
