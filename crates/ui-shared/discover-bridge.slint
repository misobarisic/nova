import { MediaCard, StreamRow, DownloadRow, EpisodeRow, AddonRow, CategoryRow, HomeCatalogRow, HomeCatalogSection, HomeCatalogCard, LicenseSource, SyncPeer, SyncInvite, SeasonCard, TrackRow, SheetItem, ContinueRow, UpcomingRow, CalCell, TrackingAccountRow, TrackingLinkRow, TrackingCandidateRow, TrackingMappingRow, TrackingSetupRow, SettingSyncInfo, CalendarDay, CalendarRelease, DownloadEpisode, DownloadGroup, SettingsDestination } from "../ui/types.slint";

// The host keeps backend-owned state; the page shares this exact object.
export global DiscoverBridge {
    callback focus_shell();
    in-out property <component-factory> factory;
    in-out property <length> viewport_width;
    in-out property <length> viewport_height;
    in-out property <length> nav-viewport-width;
    in-out property <[MediaCard]> catalog;
    in-out property <[string]> addon_names;
    in-out property <[string]> type_names;
    in-out property <[string]> catalog_names;
    in-out property <[string]> catalog_labels;
    in-out property <[string]> genre_names;
    in-out property <string> empty_hint;
    in-out property <string> searchable_hint;
    in-out property <int> addon_combo_idx;
    in-out property <int> type_combo_idx;
    in-out property <int> catalog_combo_idx;
    in-out property <int> genre_combo_idx;
    in-out property <string> search_text;
    in-out property <[MediaCard]> search_results;
    in-out property <[string]> search_history;
    in-out property <[string]> search_history_contexts;
    in-out property <bool> search_results_open;
    in-out property <bool> search_focused;
    in-out property <bool> search_filters_open;
    in-out property <[string]> search_addon_names;
    in-out property <[string]> search_type_names;
    in-out property <[string]> search_catalog_names;
    in-out property <[string]> search_catalog_labels;
    in-out property <[string]> search_genre_names;
    in-out property <int> search_addon_combo_idx;
    in-out property <int> search_type_combo_idx;
    in-out property <int> search_catalog_combo_idx;
    in-out property <int> search_genre_combo_idx;
    in-out property <int> system_back_request;
    in-out property <bool> animate_search_results;
    in-out property <bool> search_loading;
    in-out property <bool> search_loading_more;
    in-out property <bool> search_can_load_more;
    in-out property <string> search_empty_hint;
    in-out property <bool> searchable;
    in-out property <int> min_cols;
    in-out property <bool> can_load_more;
    in-out property <bool> loading_more;
    in-out property <int> kb_zone;
    in-out property <int> kb_nav;
    in-out property <int> kb_ctl;
    in-out property <int> kb_idx;
    in-out property <bool> kb_active;
    in-out property <length> scroll_y;
    in-out property <length> search_scroll_y;
    in-out property <bool> scroll_page;
    in-out property <bool> narrow;
    in-out property <bool> touch_menus;
    in-out property <length> safe-top;
    in-out property <length> safe-left;
    in-out property <length> safe-right;
    in-out property <length> safe-bottom;
    in-out property <bool> more_open;
    callback addon_picked(string);
    callback type_picked(string);
    callback catalog_picked(string);
    callback genre_picked(string);
    callback search_activated();
    callback search_filter_picked(int, int);
    callback search_edited(string);
    callback search_submitted(string);
    callback search_back_picked();
    callback search_history_cleared();
    callback search_history_selected(int);
    callback search_history_item_removed_at(int);
    callback search_history_item_removed(string);
    callback item_selected(string, int);
    callback discover_picked();
    callback home_picked();
    callback library_picked();
    callback settings_picked();
    callback more_picked();
    callback about_picked();
    callback load_more();
    callback visible_range(int, int);
