    in-out property <[HomeCatalogCard]> history_archive_cards;
    in-out property <[CalCell]> cal_cells;
    in-out property <string> cal_title;
    in-out property <[UpcomingRow]> cal_day_rows;
    in-out property <int> cal_epoch;
    in-out property <bool> cal_open;
    in-out property <string> home_empty_hint;
    in-out property <string> featured_title;
    in-out property <string> featured_watch_label;
    in-out property <image> featured_logo;
    in-out property <string> featured_type;
    in-out property <string> featured_rating;
    in-out property <string> featured_runtime;
    in-out property <string> featured_release_info;
    in-out property <string> featured_tagline;
    in-out property <string> featured_description;
    in-out property <image> featured_backdrop;
    in-out property <int> featured_index;
    in-out property <int> featured_count;
    in-out property <int> featured_revision;
    in-out property <bool> featured_refresh_pending;
    in-out property <int> min_cols;
    in-out property <int> kb_zone;
    in-out property <int> kb_nav;
    in-out property <int> kb_idx;
    in-out property <int> kb_up_idx;
    in-out property <bool> kb_active;
    in-out property <length> scroll_y;
    in-out property <int> view;
    in-out property <int> system_back_request;
    in-out property <length> all_scroll_y;
    in-out property <length> continue_x;
    in-out property <length> new_episodes_x;
    in-out property <length> upcoming_x;
