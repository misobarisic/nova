import { RemoteBridge } from "remote-bridge.slint";
import { TrackRow, ChapterRow, SceneBookmarkRow } from "../ui/types.slint";

// Shared canonical data handles; this global owns no visual tree.
export global PlayerOsdBridge {
    in-out property <string> sleep_timer_label;
    in-out property <string> sleep_timer_notice;
    in-out property <bool> sleep_timer_available;
    in-out property <bool> sleep_timer_episodes_available;
    in-out property <bool> sleep_timer_end_available;
    in-out property <bool> sleep_timer_active;
    in-out property <bool> sleep_timer_duration;
    in-out property <int> sleep_custom_minutes: 30;
    in-out property <int> sleep_custom_episodes: 1;
    callback sleep_timer_changed(int, int);
    public function sleep_timer_pick(i: int, remote: bool) {
        if i < 0 || i > 14 { return; }
        if remote && !RemoteBridge.sleep_timer_available { return; }
        if !remote && !self.sleep_timer_available { return; }
        if i == 9 && !remote && !self.sleep_timer_end_available { return; }
        if i >= 10 && i <= 12 && !(remote ? RemoteBridge.sleep_timer_episodes_available : self.sleep_timer_episodes_available) { return; }
        if i == 13 && !(remote ? RemoteBridge.sleep_timer_duration : self.sleep_timer_duration) { return; }
        if i == 6 { self.sleep_custom_minutes = Math.max(1, self.sleep_custom_minutes - 1); }
        else if i == 7 { self.sleep_custom_minutes = Math.min(240, self.sleep_custom_minutes + 1); }
        else if i == 10 { self.sleep_custom_episodes = Math.max(1, self.sleep_custom_episodes - 1); }
        else if i == 11 { self.sleep_custom_episodes = Math.min(10, self.sleep_custom_episodes + 1); }
        else {
            let mode = i == 0 || i == 14 ? 0 : i == 9 ? 2 : i == 12 ? 3 : i == 13 ? 4 : 1;
            let value = i == 1 ? 15 : i == 2 ? 30 : i == 3 ? 45 : i == 4 ? 60 : i == 5 ? 90 : i == 12 ? self.sleep_custom_episodes : self.sleep_custom_minutes;
            if remote { RemoteBridge.semantic_action(mode == 0 ? "sleep_cancel" : mode == 1 ? "sleep_minutes" : mode == 2 ? "sleep_end" : mode == 3 ? "sleep_episodes" : "sleep_extend", value, "", "", RemoteBridge.session); }
            else { self.sleep_timer_changed(mode, value); }
        }
    }

    in-out property <[TrackRow]> secondary_sub_tracks;
    in-out property <string> secondary_sub_track_label;
    in-out property <int> secondary_subtitle_position_index;
    callback secondary_subtitle_position_changed(int);
    in-out property <[SceneBookmarkRow]> scene_bookmarks;
    in-out property <bool> scene_bookmarks_available;
    in-out property <string> scene_bookmark_notice;
    in-out property <bool> try_another_stream_available;
    in-out property <bool> automatic_stream_recovery_visible;
    callback pick_secondary_sub_track(int);
    callback add_scene_bookmark(string) -> bool;
    callback delete_scene_bookmark(string) -> bool;
    callback edit_scene_bookmark(string, string) -> bool;
    callback try_another_stream();
    callback focus_shell();
    in-out property <component-factory> factory;
    in-out property <length> viewport_width;
    in-out property <length> viewport_height;
    // Reserved top control clearance for the watch-party badge.
    in-out property <length> header_bottom;
    in-out property <int> intro_skip_override_index: -1;
    callback intro_skip_mode_changed(int);
    in-out property <int> skip_segment_kind;
    callback skip_segment();
    callback dismiss_skip_segment();
    in-out property <bool> next_episode_visible;
    in-out property <string> next_episode_token;
    in-out property <string> next_episode_title;
    in-out property <string> next_episode_context;
    in-out property <bool> playback_started;
    in-out property <bool> is_paused;
    in-out property <float> position;
    in-out property <float> duration;
    in-out property <float> buffered_until;
    in-out property <[ChapterRow]> player_chapters;
    in-out property <string> time_text;
    in-out property <string> player_status;
    in-out property <string> player_title;
    in-out property <string> player_episode_title;
    in-out property <string> player_show_title;
    in-out property <[string]> player_badges;
    in-out property <string> player_media_summary;
    in-out property <bool> screenshot_busy;
    in-out property <string> screenshot_notice;
    in-out property <string> decode_label;
    in-out property <int> decoder_selected;
    in-out property <string> sub_label;
    in-out property <string> audio_label;
    in-out property <float> volume;
    in-out property <bool> muted;
    in-out property <float> playback_speed;
    in-out property <[float]> subtitle_style;
    in-out property <bool> subtitle_style_preference_saved;
    callback subtitle_style_changed(int, float);
    in-out property <bool> audio_preference_saved;
    in-out property <bool> subtitle_preference_saved;
    in-out property <bool> speed_preference_saved;
    in-out property <float> player_brightness;
    in-out property <bool> is_fullscreen;
    in-out property <[TrackRow]> audio_tracks;
    in-out property <[TrackRow]> sub_tracks;
    in-out property <int> subtitle_addon_status;
    in-out property <bool> osd_visible;
    in-out property <image> player_poster;
    in-out property <bool> kb_active;
    in-out property <int> system_back_request;
    in-out property <bool> is_android;
    in-out property <bool> desktop_decoder_available;
    in-out property <bool> hw_plus_available: true;
    in-out property <bool> narrow;
    in-out property <length> safe-top;
    in-out property <length> safe-left;
    in-out property <length> safe-right;
    in-out property <length> safe-bottom;
    callback next_episode_streams(string);
    callback next_episode_dismiss(string);
    callback restore_playback_default(int);
    callback osd_opacity_changed(float);
    callback subtitle_clearance_changed(float, float);
    callback toggle_pause();
    callback seek(float);
    callback seek_chapter(float);
    callback seek_scene_bookmark(string);
    callback seek_relative(float);
    callback close_player();
    callback take_screenshot();
    callback set_volume(float);
    callback volume_step(float);
    callback toggle_mute();
    callback pick_audio_track(int);
    callback pick_sub_track(int);
    callback pick_decoder(int);
    callback playback_speed_changed(float);
    callback playback_speed_stepped(int);
    callback playback_speed_preview(float);
    callback playback_speed_preview_end();
    callback android_brightness_step(int);
    callback android_volume_step(int);
    callback settings_opened();
    callback toggle_fullscreen();
    callback osd_mouse_moved();
    callback tracks_popup_opened(int);
    pure callback format_time(float) -> string;
    pure callback format_volume(float) -> string;
}
