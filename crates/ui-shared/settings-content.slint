import { CastBridge } from "cast-bridge.slint";
import { SettingsBridge } from "settings-bridge.slint";
import { StreamFiltersBridge } from "stream-filters-bridge.slint";

// Submenu factories and shell-local state share the window globals bundle.
// Backend values remain in SettingsBridge; this state resets on shell creation.
export global SettingsContent {
    in-out property <component-factory> tracking_factory;
    in-out property <component-factory> addons_factory;
    in-out property <component-factory> categories_factory;
    in-out property <component-factory> image_cache_factory;
    in-out property <component-factory> display_factory;
    in-out property <component-factory> p2p_factory;
    in-out property <component-factory> player_factory;
    in-out property <component-factory> theme_factory;
    in-out property <component-factory> look_feel_factory;
    in-out property <component-factory> sync_factory;
    in-out property <component-factory> home_factory;
    in-out property <component-factory> downloads_factory;
    in-out property <component-factory> downloaded_episodes_factory;
    in-out property <length> slot_width;
    in-out property <length> slot_height;
    in-out property <length> shell_width;
    in-out property <length> detail_width;
    // Transient shell geometry lets a compiled submenu pin its own controls.
    in-out property <length> detail_sticky_top;
    in-out property <length> detail_header_height;
    in-out property <length> detail_pinned_controls_height;
    in-out property <length> detail_cover_left;
    in-out property <length> detail_cover_right;
    in-out property <length> content_min_height;
    in-out property <length> content_preferred_height;
    // Search navigation crosses the shell/compiled-leaf mount boundary. A
    // matching row consumes the one-shot reveal; the key keeps its visible
    // highlight until the next navigation or search. Never persist this state.
    in-out property <string> search_target_key;
    in-out property <int> search_target_section: -1;
    in-out property <bool> search_target_pending: false;
    in-out property <bool> dl_revealed: true;
    in-out property <bool> input_focused: false;
    in-out property <int> kb_ac: 0;
    in-out property <int> kb_actl: 0;
    in-out property <int> kb_anr: 0;
    in-out property <int> kb_ar: 0;
    in-out property <int> kb_ccol: 0;
    in-out property <int> kb_cctl: 0;
    in-out property <int> kb_cr: 0;
    in-out property <int> kb_dl: 0;
    in-out property <int> kb_dlr: 0;
    in-out property <int> kb_dr: 5;
    in-out property <int> kb_edit: 0;
    in-out property <int> kb_home: 0;
    in-out property <int> kb_hr: 0;
    in-out property <int> kb_pr: 0;
    in-out property <string> stream_filter_language_draft;
    in-out property <int> stream_filter_codec_choice;
    in-out property <int> stream_filter_resolution_exclude_choice: 0;
    in-out property <int> stream_filter_resolution_choice: 5;
    in-out property <int> stream_filter_resolution_column;
    in-out property <int> stream_filter_priority_column;
    in-out property <int> stream_filter_sort_column;
    in-out property <int> kb_theme: 0;
    in-out property <int> kb_tr: 0;
    in-out property <bool> player_language_input_focused: false;
    in-out property <string> sync_remove_prompt_id: "";
    in-out property <string> sync_remove_prompt_name: "";
    in-out property <bool> sync_remove_prompt_visible: false;
    in-out property <bool> tracking_blur: false;
    in-out property <bool> tracking_input_focused: false;
    in-out property <bool> tracking_reset_confirm: false;
    out property <int> button_radius_preset_index: SettingsBridge.button_corner_radius == 0 ? 0 : SettingsBridge.button_corner_radius == 4 ? 1 : SettingsBridge.button_corner_radius == 8 ? 2 : SettingsBridge.button_corner_radius == 12 ? 3 : SettingsBridge.button_corner_radius == 24 ? 4 : -1;
    out property <bool> narrow: SettingsContent.detail_width < 680px;
    out property <int> radius_preset_index: SettingsBridge.card_corner_radius == 0 ? 0 : SettingsBridge.card_corner_radius == 4 ? 1 : SettingsBridge.card_corner_radius == 10 ? 2 : SettingsBridge.card_corner_radius == 16 ? 3 : SettingsBridge.card_corner_radius == 24 ? 4 : -1;
    out property <int> spacing_preset_index: SettingsBridge.card_spacing == 0 ? 0 : SettingsBridge.card_spacing == 4 ? 1 : SettingsBridge.card_spacing == 8 ? 2 : SettingsBridge.card_spacing == 16 ? 3 : SettingsBridge.card_spacing == 32 ? 4 : -1;
    out property <string> torrent_rate_label: SettingsBridge.torrent_down_limit <= 0 ? @tr("Unlimited") : Math.round(SettingsBridge.torrent_down_limit) + " KB/s";
    out property <string> torrent_size_label: Math.round(SettingsBridge.torrent_max_mb) + " MB";
    pure callback kb_player_audio_language_row() -> int;
    pure callback kb_player_speed_row() -> int;
    pure callback kb_player_subtitle_language_row() -> int;
    callback open_page(int);
    callback pick_button_radius(int);
    callback pick_card_radius(int);
    callback pick_card_spacing(int);
    callback restore_theme_defaults();
    callback reveal_detail_control(length,length);
    callback schedule_save();
    callback schedule_setting(string);
    callback focus_shell();

    public function clear_search_target() {
        SettingsContent.search_target_pending = false;
        SettingsContent.search_target_key = "";
        SettingsContent.search_target_section = -1;
    }

    // Filter rows follow all existing Player controls on both backends. Keep
    // this calculation shared so leaf focus marks and shell arrows agree.
    public pure function kb_player_stream_filters_row() -> int {
        if SettingsBridge.player_backend_index == 0 {
            return SettingsContent.kb_player_speed_row() + (SettingsBridge.screenshot_format_index == 1 || SettingsBridge.screenshot_format_index == 3 ? 5 : 4) + 17 + (CastBridge.available ? 1 : 0);
        }
        return (SettingsBridge.is_android ? 2 : 3) + (CastBridge.available ? 1 : 0);
    }
    public pure function kb_player_listening_row() -> int { return SettingsContent.kb_player_stream_filters_row() - 3 - (CastBridge.available ? 1 : 0); }
    public pure function kb_player_paused_controls_row() -> int { return SettingsContent.kb_player_listening_row() - 2; }
    public pure function kb_player_loading_text_row() -> int { return SettingsContent.kb_player_paused_controls_row() + 1; }
    public pure function stream_filter_codec_key(codec: int) -> string {
        return codec == 0 ? "avc" : codec == 1 ? "hevc" : codec == 2 ? "av1" : codec == 3 ? "vp9" : "other";
    }
    public pure function stream_filter_codec_label(codec: int) -> string {
        return codec == 0 ? "H.264 / AVC" : codec == 1 ? "H.265 / HEVC" : codec == 2 ? "AV1" : codec == 3 ? "VP9" : @tr("Other video codecs");
    }
    public pure function kb_stream_filter_resolution_exclude_picker() -> int { return 3; }
    public pure function kb_stream_filter_resolution_excluded_start() -> int { return 4; }
    public pure function kb_stream_filter_resolution_picker() -> int { return 4 + StreamFiltersBridge.excluded_resolutions.length; }
    public pure function kb_stream_filter_resolution_priority_start() -> int { return SettingsContent.kb_stream_filter_resolution_picker() + 1; }
    public pure function kb_stream_filter_require_resolution() -> int { return SettingsContent.kb_stream_filter_resolution_priority_start() + StreamFiltersBridge.resolution_priority_order.length; }
    public pure function kb_stream_filter_codec_start() -> int { return SettingsContent.kb_stream_filter_require_resolution() + 1; }
    public pure function kb_stream_filter_codec_picker() -> int { return SettingsContent.kb_stream_filter_codec_start() + 10; }
    public pure function kb_stream_filter_codec_priority_start() -> int { return SettingsContent.kb_stream_filter_codec_picker() + 1; }
    public pure function kb_stream_filter_require_codec() -> int { return SettingsContent.kb_stream_filter_codec_priority_start() + StreamFiltersBridge.codec_priority_order.length; }
    public pure function kb_stream_filter_audio_source() -> int { return SettingsContent.kb_stream_filter_require_codec() + 1; }
    public pure function kb_stream_filter_audio_picker() -> int { return SettingsContent.kb_stream_filter_audio_source() + 1; }
    public pure function kb_stream_filter_require() -> int { return SettingsContent.kb_stream_filter_audio_source() + (StreamFiltersBridge.use_preferred_audio_languages ? 1 : 2); }
    public pure function kb_stream_filter_unknown() -> int { return SettingsContent.kb_stream_filter_require() + 1; }
    public pure function kb_stream_filter_sort_start() -> int { return SettingsContent.kb_stream_filter_unknown() + 1; }
    public pure function kb_stream_filter_reset() -> int { return SettingsContent.kb_stream_filter_sort_start() + StreamFiltersBridge.sort_order.length; }
    public pure function kb_stream_filter_count() -> int { return SettingsContent.kb_stream_filter_reset() + 1; }
    public pure function stream_filter_sort_label(criterion: string) -> string {
        return criterion == "cached" ? @tr("Cached availability") : criterion == "resolution" ? @tr("Resolution") : criterion == "size" ? @tr("Size") : criterion == "season_pack" ? @tr("Season pack") : criterion == "seeders" ? @tr("Reported seeders") : criterion == "audio" ? @tr("Audio language") : criterion == "codec" ? @tr("Video codec") : @tr("Subtitle language");
    }
    public pure function stream_filter_sort_direction(criterion: string, ascending: bool) -> string {
        if criterion == "audio" || criterion == "codec" || criterion == "subtitle" { return ascending ? @tr("Preferred first") : @tr("Reverse preference order"); }
        if criterion == "cached" { return ascending ? @tr("Uncached first") : @tr("Cached first"); }
        if criterion == "season_pack" { return ascending ? @tr("Single episodes first") : @tr("Season packs first"); }
        if criterion == "size" { return ascending ? @tr("Smallest first") : @tr("Largest first"); }
        if criterion == "resolution" { return ascending ? @tr("Lowest first") : @tr("Highest first"); }
        return ascending ? @tr("Fewest first") : @tr("Most first");
    }

    public function reset_state() {
        SettingsContent.clear_search_target();
        SettingsContent.detail_sticky_top = 0px;
        SettingsContent.detail_header_height = 0px;
        SettingsContent.detail_pinned_controls_height = 0px;
        SettingsContent.detail_cover_left = 0px;
        SettingsContent.detail_cover_right = 0px;
        SettingsContent.dl_revealed = true;
        SettingsContent.input_focused = false;
        SettingsContent.kb_ac = 0;
        SettingsContent.kb_actl = 0;
        SettingsContent.kb_anr = 0;
        SettingsContent.kb_ar = 0;
        SettingsContent.kb_ccol = 0;
        SettingsContent.kb_cctl = 0;
        SettingsContent.kb_cr = 0;
        SettingsContent.kb_dl = 0;
        SettingsContent.kb_dlr = 0;
        SettingsContent.kb_dr = 5;
        SettingsContent.kb_edit = 0;
        SettingsContent.kb_home = 0;
        SettingsContent.kb_hr = 0;
        SettingsContent.kb_pr = 0;
        SettingsContent.stream_filter_language_draft = "";
        SettingsContent.stream_filter_codec_choice = 0;
        SettingsContent.stream_filter_resolution_exclude_choice = 0;
        SettingsContent.stream_filter_resolution_choice = 5;
        SettingsContent.stream_filter_resolution_column = 0;
        SettingsContent.stream_filter_priority_column = 0;
        SettingsContent.stream_filter_sort_column = 0;
        SettingsContent.kb_theme = 0;
        SettingsContent.kb_tr = 0;
        SettingsContent.player_language_input_focused = false;
        SettingsContent.sync_remove_prompt_id = "";
        SettingsContent.sync_remove_prompt_name = "";
        SettingsContent.sync_remove_prompt_visible = false;
        SettingsContent.tracking_blur = false;
        SettingsContent.tracking_input_focused = false;
        SettingsContent.tracking_reset_confirm = false;
    }
}
