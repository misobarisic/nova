import { CalendarPage } from "../ui/calendar.slint";
import { CalendarBridge } from "@NovaUiShared";

export component CalendarModule inherits Window {
    public function focus_shell() { page.focus_shell(); }
    default-font-family: "Roboto";
    background: transparent;
    width: CalendarBridge.viewport_width; height: CalendarBridge.viewport_height;
    page := CalendarPage {
        width: 100%; height: 100%;
        artwork-active <=> CalendarBridge.artwork-active;
        nav-viewport-width <=> CalendarBridge.nav-viewport-width;
        external_navigation <=> CalendarBridge.external_navigation;
        active <=> CalendarBridge.active;
        cells <=> CalendarBridge.cells;
        week_cells <=> CalendarBridge.week_cells;
        rows <=> CalendarBridge.rows;
        later <=> CalendarBridge.later;
        title <=> CalendarBridge.title;
        day_title <=> CalendarBridge.day_title;
        count <=> CalendarBridge.count;
        search <=> CalendarBridge.search;
        view <=> CalendarBridge.view;
        all <=> CalendarBridge.all;
        safe-top <=> CalendarBridge.safe-top;
        safe-left <=> CalendarBridge.safe-left;
        safe-right <=> CalendarBridge.safe-right;
        safe-bottom <=> CalendarBridge.safe-bottom;
        system_back_request <=> CalendarBridge.system_back_request;
        kb_active <=> CalendarBridge.kb_active;
        artwork-visible(arg0, arg1) => { CalendarBridge.artwork-visible(arg0, arg1); }
        artwork-active-changed(arg0) => { CalendarBridge.artwork-active-changed(arg0); }
        refreshed() => { CalendarBridge.refreshed(); }
        step(arg0) => { CalendarBridge.step(arg0); }
        today() => { CalendarBridge.today(); }
        day_picked(arg0) => { CalendarBridge.day_picked(arg0); }
        release_picked(arg0) => { CalendarBridge.release_picked(arg0); }
        back() => { CalendarBridge.back(); }
        home_picked() => { CalendarBridge.home_picked(); }
        discover_picked() => { CalendarBridge.discover_picked(); }
        library_picked() => { CalendarBridge.library_picked(); }
        settings_picked() => { CalendarBridge.settings_picked(); }
        about_picked() => { CalendarBridge.about_picked(); }
        more_picked() => { CalendarBridge.more_picked(); }
    }
}
