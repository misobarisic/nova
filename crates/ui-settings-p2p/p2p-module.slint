import { SettingsBridge, SettingsContent, Theme, SettingsStyle } from "@NovaUiShared";
import { SettingSyncBadge } from "../ui/settings-sync.slint";

import { SearchField } from "../ui/searchfield.slint";

import { KbMark } from "../ui/kbnav.slint";

import { PillButton, ToggleSwitch, MiniSlider, SectionHeader, SettingsRow, ValueBox, SettingsCard } from "../ui/settings-controls.slint";

// The shell owns scrolling and transitions. Report intrinsic layout sizes
// only while this section is selected, so outgoing instances cannot resize it.
export component SettingsP2pModule inherits Window {
    default-font-family: "Roboto";
    background: transparent;
    width: SettingsContent.slot_width; height: SettingsContent.slot_height;
    private property <length> measured_min: body_layout.min-height;
    private property <length> measured_preferred: body_layout.preferred-height;
    changed measured_min => { root.publish_size(); }
    changed measured_preferred => { root.publish_size(); }
    init => { root.publish_size(); }
    function publish_size() {
        if SettingsBridge.sel == 4 {
            SettingsContent.content_min_height = root.measured_min;
            SettingsContent.content_preferred_height = root.measured_preferred;
        }
    }
    body_layout := VerticalLayout {
        width: 100%; height: 100%; spacing: 0px;
        VerticalLayout {

            vertical-stretch: 0;
            spacing: 18px;

            SectionHeader { label: @tr("Streaming"); }

            // ---- Torrents (native only) ---------------------
            // The embedded BitTorrent client is not compiled into
            // the web build, so the whole section is hidden there.

            SettingsCard { SettingsRow {
                    setting-key: "torrent_enabled";
                    row-title: @tr("Stream P2P");
                    row-desc: @tr("Play P2P stream rows (Torrentio and friends) in the in-app player using a built-in P2P client. Files are kept for instant replay unless \"No caching\" is on.");

                    ToggleSwitch {
                        name: @tr("Stream P2P");
                        checked <=> SettingsBridge.torrent_enabled;
                        focused: SettingsBridge.kb_zone == 7 && SettingsContent.kb_tr == 0 && SettingsBridge.kb_active;
                        toggled => { SettingsBridge.kb_active = SettingsStyle.keyboard-mode; SettingsBridge.kb_zone = 7; SettingsContent.kb_tr = 0; SettingsContent.schedule_save(); }
                    }
                } }
            if SettingsBridge.torrent_enabled: VerticalLayout { spacing: 18px;
                SectionHeader { label: @tr("Cache location and limits"); }
                SettingsCard { VerticalLayout { spacing: 0px;

                        // Download folder: custom row (like the
                        // addon install box) so the field can
                        // stretch; stacked when narrow. The hidden
                        // measurement copy drives the narrow height
                        // (wrapped text measures at one line).
                        torrent_dir_box := Rectangle {
                            background: Theme.current.card;
                            min-height: SettingsContent.narrow ? Math.max(96px, 105px + torrent_dir_measure.height) : 88px;

                            if !SettingsContent.narrow: HorizontalLayout {
                                width: 100%;
                                padding-top: 14px;
                                padding-bottom: 14px;
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 16px;

                                VerticalLayout {
                                    width: 360px;
                                    alignment: center;
                                    spacing: 3px;

                                    Text {
                                        text: @tr("Download folder");
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: Theme.current.text_bright;
                                    }
                                    SettingSyncBadge { max-width: Math.min(self.preferred-width, parent.width); setting_key: "torrent_dir"; setting_title: @tr("Download folder"); }

                                    Text {
                                        text: @tr("Where P2P data is stored. Leave empty to use the default app cache folder.");
                                        font-size: 14px;
                                        color: Theme.current.text_settings;
                                        wrap: word-wrap;
                                        width: 360px;
                                        height: 44px;
                                    }
                                }

                                VerticalLayout {
                                    height: 100%;
                                    horizontal-stretch: 1;
                                    alignment: center;

                                    HorizontalLayout {
                                        width: 100%;
                                        height: 44px;
                                        spacing: 12px;

                                        KbMark { on: SettingsBridge.kb_zone == 7 && SettingsContent.kb_tr == 1; active: SettingsBridge.kb_active; }
                                        torrent_dir_wide := SearchField {
                                            show-pointer-focus: false; keyboard-mode: SettingsBridge.kb_active;
                                            text <=> SettingsBridge.torrent_dir;
                                            placeholder-text: @tr("Default (app cache folder)");
                                            focus_changed(focused) => { SettingsContent.input_focused = focused; if (focused && SettingsBridge.kb_active) { SettingsContent.reveal_detail_control(self.absolute-position.y, self.height); } }
                                            edited(t) => { SettingsBridge.torrent_dir = t; SettingsContent.schedule_save(); }
                                            accepted(t) => {
                                                SettingsBridge.torrent_dir = t;
                                                SettingsContent.kb_edit = 0;
                                                SettingsContent.focus_shell();
                                                SettingsBridge.torrent_dir_edited(t);
                                            }
                                            horizontal-stretch: 1;
                                            min-width: 0px;
                                            max-width: 560px;
                                        }

                                        edit_t7 := Timer {
                                            interval: 80ms;
                                            running: SettingsContent.kb_edit == 3 && !SettingsContent.narrow;
                                            triggered => { torrent_dir_wide.focus(); }
                                        }
                                    }
                                }
                            }

                            if SettingsContent.narrow: VerticalLayout {
                                width: 100%;
                                padding-top: 14px;
                                padding-bottom: 14px;
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 10px;

                                VerticalLayout {
                                    spacing: 3px;

                                    Text {
                                        text: @tr("Download folder");
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: Theme.current.text_bright;
                                        wrap: word-wrap;
                                    }
                                    SettingSyncBadge { max-width: Math.min(self.preferred-width, parent.width); setting_key: "torrent_dir"; setting_title: @tr("Download folder"); }

                                    Text {
                                        text: @tr("Where P2P data is stored. Leave empty to use the default app cache folder.");
                                        font-size: 14px;
                                        color: Theme.current.text_settings;
                                        wrap: word-wrap;
                                    }
                                }

                                HorizontalLayout {
                                    width: 100%;
                                    height: 44px;
                                    spacing: 12px;

                                    KbMark { on: SettingsBridge.kb_zone == 7 && SettingsContent.kb_tr == 1; active: SettingsBridge.kb_active; }
                                    torrent_dir_narrow := SearchField {
                                        show-pointer-focus: false; keyboard-mode: SettingsBridge.kb_active;
                                        roomy: true;
                                        text <=> SettingsBridge.torrent_dir;
                                        placeholder-text: @tr("Default (app cache folder)");
                                        focus_changed(focused) => { SettingsContent.input_focused = focused; if (focused && SettingsBridge.kb_active) { SettingsContent.reveal_detail_control(self.absolute-position.y, self.height); } }
                                        edited(t) => { SettingsBridge.torrent_dir = t; SettingsContent.schedule_save(); }
                                        accepted(t) => {
                                            SettingsBridge.torrent_dir = t;
                                            SettingsContent.kb_edit = 0;
                                            SettingsContent.focus_shell();
                                            SettingsBridge.torrent_dir_edited(t);
                                        }
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                    }

                                    edit_t7n := Timer {
                                        interval: 80ms;
                                        running: SettingsContent.kb_edit == 3 && SettingsContent.narrow;
                                        triggered => { torrent_dir_narrow.focus(); }
                                    }
                                }
                            }

                            // Hidden measurement copy (see above).
                            Rectangle {
                                height: 0;
                                clip: true;

                                torrent_dir_measure := Text {
                                    width: torrent_dir_box.width - 32px;
                                    text: @tr("Where P2P data is stored. Leave empty to use the default app cache folder.");
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // Size cap (wide).
                        if !SettingsContent.narrow: SettingsRow {
                            tinted: true;
                            row-min-height: 88px;
                            setting-key: "torrent_max_mb";
                            row-title: @tr("Cache size limit");
                            row-desc: @tr("Maximum disk space for downloaded P2P data. Least-recently-used items are removed first once exceeded.");

                            VerticalLayout {
                                width: 240px;
                                height: 60px;
                                spacing: 8px;
                                alignment: center;

                                MiniSlider {
                                    width: 100%;
                                    minimum: 512;
                                    maximum: 32768;
                                    value: SettingsBridge.torrent_max_mb;
                                    focused: SettingsBridge.kb_zone == 7 && SettingsContent.kb_tr == 2 && SettingsBridge.kb_active;
                                    changed(v) => {
                                        SettingsBridge.torrent_max_mb = v;
                                        SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                                        SettingsBridge.kb_zone = 7;
                                        SettingsContent.kb_tr = 2;
                                        SettingsContent.schedule_save();
                                    }
                                }

                                HorizontalLayout {
                                    alignment: center;

                                    ValueBox {
                                        width: 150px;
                                        text: SettingsContent.torrent_size_label;
                                    }
                                }
                            }
                        }

                        // Size cap (narrow): stacked full-width.
                        if SettingsContent.narrow: Rectangle {
                            background: Theme.current.card;

                            VerticalLayout {
                                width: 100%;
                                padding-top: 14px;
                                padding-bottom: 14px;
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 10px;

                                VerticalLayout {
                                    spacing: 3px;

                                    Text {
                                        text: @tr("Cache size limit");
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: Theme.current.text_bright;
                                        wrap: word-wrap;
                                    }
                                    SettingSyncBadge { max-width: Math.min(self.preferred-width, parent.width); setting_key: "torrent_max_mb"; setting_title: @tr("Cache size limit"); }

                                    Text {
                                        text: @tr("Maximum disk space for downloaded P2P data. Least-recently-used items are removed first once exceeded.");
                                        font-size: 14px;
                                        color: Theme.current.text_settings;
                                        wrap: word-wrap;
                                    }
                                }

                                MiniSlider {
                                    width: 100%;
                                    minimum: 512;
                                    maximum: 32768;
                                    value: SettingsBridge.torrent_max_mb;
                                    focused: SettingsBridge.kb_zone == 7 && SettingsContent.kb_tr == 2 && SettingsBridge.kb_active;
                                    changed(v) => {
                                        SettingsBridge.torrent_max_mb = v;
                                        SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                                        SettingsBridge.kb_zone = 7;
                                        SettingsContent.kb_tr = 2;
                                        SettingsContent.schedule_save();
                                    }
                                }

                                HorizontalLayout {
                                    alignment: center;

                                    ValueBox {
                                        width: 150px;
                                        text: SettingsContent.torrent_size_label;
                                    }
                                }
                            }
                        }

                        // Download rate limit (wide).
                        if !SettingsContent.narrow: SettingsRow {
                            row-min-height: 88px;
                            setting-key: "torrent_down_limit";
                            row-title: @tr("Download rate limit");
                            row-desc: @tr("Cap the download speed. 0 means unlimited.");

                            VerticalLayout {
                                width: 240px;
                                height: 60px;
                                spacing: 8px;
                                alignment: center;

                                MiniSlider {
                                    width: 100%;
                                    minimum: 0;
                                    maximum: 102400;
                                    value: SettingsBridge.torrent_down_limit;
                                    focused: SettingsBridge.kb_zone == 7 && SettingsContent.kb_tr == 3 && SettingsBridge.kb_active;
                                    changed(v) => {
                                        SettingsBridge.torrent_down_limit = v;
                                        SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                                        SettingsBridge.kb_zone = 7;
                                        SettingsContent.kb_tr = 3;
                                        SettingsContent.schedule_save();
                                    }
                                }

                                HorizontalLayout {
                                    alignment: center;

                                    ValueBox {
                                        width: 150px;
                                        text: SettingsContent.torrent_rate_label;
                                    }
                                }
                            }
                        }

                        // Download rate limit (narrow): stacked.
                        if SettingsContent.narrow: Rectangle {
                            background: Theme.current.card;

                            VerticalLayout {
                                width: 100%;
                                padding-top: 14px;
                                padding-bottom: 14px;
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 10px;

                                VerticalLayout {
                                    spacing: 3px;

                                    Text {
                                        text: @tr("Download rate limit");
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: Theme.current.text_bright;
                                        wrap: word-wrap;
                                    }
                                    SettingSyncBadge { max-width: Math.min(self.preferred-width, parent.width); setting_key: "torrent_down_limit"; setting_title: @tr("Download rate limit"); }

                                    Text {
                                        text: @tr("Cap the download speed. 0 means unlimited.");
                                        font-size: 14px;
                                        color: Theme.current.text_settings;
                                        wrap: word-wrap;
                                    }
                                }

                                MiniSlider {
                                    width: 100%;
                                    minimum: 0;
                                    maximum: 102400;
                                    value: SettingsBridge.torrent_down_limit;
                                    focused: SettingsBridge.kb_zone == 7 && SettingsContent.kb_tr == 3 && SettingsBridge.kb_active;
                                    changed(v) => {
                                        SettingsBridge.torrent_down_limit = v;
                                        SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                                        SettingsBridge.kb_zone = 7;
                                        SettingsContent.kb_tr = 3;
                                        SettingsContent.schedule_save();
                                    }
                                }

                                HorizontalLayout {
                                    alignment: center;

                                    ValueBox {
                                        width: 150px;
                                        text: SettingsContent.torrent_rate_label;
                                    }
                                }
                            }
                        }

                        SettingsRow {
                            tinted: true;
                            setting-key: "torrent_no_cache";
                            row-title: @tr("No caching");
                            row-desc: @tr("Buffer torrent playback in RAM only. No torrent data is written to disk and there is no disk spill. Explicit downloads still use disk. Applies to new streams.");

                            ToggleSwitch {
                                name: @tr("No caching");
                                checked <=> SettingsBridge.torrent_no_cache;
                                focused: SettingsBridge.kb_zone == 7 && SettingsContent.kb_tr == 4 && SettingsBridge.kb_active;
                                toggled => { SettingsBridge.kb_active = SettingsStyle.keyboard-mode; SettingsBridge.kb_zone = 7; SettingsContent.kb_tr = 4; SettingsContent.schedule_save(); }
                            }
                        }

                        SettingsRow {
                            setting-key: "torrent_ram_buffer_mb";
                            row-title: @tr("Torrent RAM buffer");
                            row-desc: @tr("Maximum RAM for torrent buffering with No caching, not total app memory. Slow or unstable torrents buffer more; healthy torrents start sooner. Targets stay within this budget.");
                            row-min-height: 112px;

                            VerticalLayout {
                                width: Math.min(240px, SettingsContent.slot_width - 64px);
                                spacing: 8px;
                                MiniSlider {
                                    name: @tr("Torrent RAM buffer");
                                    width: 100%;
                                    minimum: 32;
                                    maximum: SettingsBridge.is_android ? 512 : 2048;
                                    step: 32;
                                    enabled: SettingsBridge.torrent_no_cache;
                                    value: SettingsBridge.torrent_ram_buffer_mb;
                                    focused: SettingsBridge.kb_zone == 7 && SettingsContent.kb_tr == 5 && SettingsBridge.kb_active;
                                    changed(v) => {
                                        SettingsBridge.torrent_ram_buffer_mb = Math.round(v);
                                        SettingsBridge.kb_active = SettingsStyle.keyboard-mode;
                                        SettingsBridge.kb_zone = 7;
                                        SettingsContent.kb_tr = 5;
                                        SettingsContent.schedule_save();
                                    }
                                }
                                HorizontalLayout {
                                    alignment: center;
                                    ValueBox { width: 150px; text: SettingsContent.torrent_ram_label; }
                                }
                            }
                        }

                    } }
                SectionHeader { label: @tr("Disk usage and cleanup"); }
                SettingsCard { VerticalLayout { spacing: 0px; // Disk usage + clear (wide).
                        if !SettingsContent.narrow: SettingsRow {
                            row-title: @tr("Disk usage");
                            row-desc: @tr("Total size of downloaded P2P data on disk.");

                            HorizontalLayout {
                                spacing: 12px;

                                ValueBox {
                                    width: 180px;
                                    text: SettingsBridge.torrent_disk_usage;
                                }

                                PillButton {
                                    label: @tr("Clear");
                                    destructive: true;
                                    btn_min_width: 92px;
                                    focused: SettingsBridge.kb_zone == 7 && SettingsContent.kb_tr == 6 && SettingsBridge.kb_active;
                                    clicked => { SettingsBridge.kb_active = SettingsStyle.keyboard-mode; SettingsBridge.kb_zone = 7; SettingsContent.kb_tr = 6; SettingsBridge.clear_torrent_cache(); }
                                }
                            }
                        }

                        // Disk usage + clear (narrow): stacked.
                        if SettingsContent.narrow: Rectangle {
                            background: Theme.current.card;

                            VerticalLayout {
                                width: 100%;
                                padding-top: 14px;
                                padding-bottom: 14px;
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 10px;

                                VerticalLayout {
                                    spacing: 3px;

                                    Text {
                                        text: @tr("Disk usage");
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: Theme.current.text_bright;
                                        wrap: word-wrap;
                                    }

                                    Text {
                                        text: @tr("Total size of downloaded P2P data on disk.");
                                        font-size: 14px;
                                        color: Theme.current.text_settings;
                                        wrap: word-wrap;
                                    }
                                }

                                HorizontalLayout {
                                    width: 100%;
                                    spacing: 12px;

                                    ValueBox {
                                        horizontal-stretch: 1;
                                        text: SettingsBridge.torrent_disk_usage;
                                    }

                                    PillButton {
                                        label: @tr("Clear");
                                        destructive: true;
                                        btn_min_width: 92px;
                                        focused: SettingsBridge.kb_zone == 7 && SettingsContent.kb_tr == 6 && SettingsBridge.kb_active;
                                        clicked => { SettingsBridge.kb_active = SettingsStyle.keyboard-mode; SettingsBridge.kb_zone = 7; SettingsContent.kb_tr = 6; SettingsBridge.clear_torrent_cache(); }
                                    }
                                }
                            }
                        }
                    } }
            }
        }
    }
}
