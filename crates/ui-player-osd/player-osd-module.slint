import { PlayerOverlay } from "../ui/player.slint";
import { PlayerOsdBridge } from "@NovaUiShared";

export component PlayerOsdModule inherits Window {
    public function focus_shell() { page.focus_shell(); }
    default-font-family: "Roboto";
    background: transparent;
    width: PlayerOsdBridge.viewport_width; height: PlayerOsdBridge.viewport_height;
    page := PlayerOverlay {
        width: 100%; height: 100%;
        next_episode_visible <=> PlayerOsdBridge.next_episode_visible;
        next_episode_token <=> PlayerOsdBridge.next_episode_token;
        next_episode_title <=> PlayerOsdBridge.next_episode_title;
        next_episode_context <=> PlayerOsdBridge.next_episode_context;
        playback_started <=> PlayerOsdBridge.playback_started;
        is_paused <=> PlayerOsdBridge.is_paused;
        position <=> PlayerOsdBridge.position;
        duration <=> PlayerOsdBridge.duration;
        buffered_until: PlayerOsdBridge.buffered_until;
        time_text <=> PlayerOsdBridge.time_text;
        player_status <=> PlayerOsdBridge.player_status;
        player_title <=> PlayerOsdBridge.player_title;
        player_episode_title <=> PlayerOsdBridge.player_episode_title;
        player_show_title <=> PlayerOsdBridge.player_show_title;
        screenshot_busy <=> PlayerOsdBridge.screenshot_busy;
        screenshot_notice <=> PlayerOsdBridge.screenshot_notice;
        decode_label <=> PlayerOsdBridge.decode_label;
        decoder_selected <=> PlayerOsdBridge.decoder_selected;
        sub_label <=> PlayerOsdBridge.sub_label;
        audio_label <=> PlayerOsdBridge.audio_label;
        volume <=> PlayerOsdBridge.volume;
        muted <=> PlayerOsdBridge.muted;
        playback_speed <=> PlayerOsdBridge.playback_speed;
        subtitle_style <=> PlayerOsdBridge.subtitle_style;
        subtitle_style_preference_saved <=> PlayerOsdBridge.subtitle_style_preference_saved;
        subtitle_style_changed(i, v) => { PlayerOsdBridge.subtitle_style_changed(i, v); }
        audio_preference_saved <=> PlayerOsdBridge.audio_preference_saved;
        subtitle_preference_saved <=> PlayerOsdBridge.subtitle_preference_saved;
        speed_preference_saved <=> PlayerOsdBridge.speed_preference_saved;
        player_brightness <=> PlayerOsdBridge.player_brightness;
        is_fullscreen <=> PlayerOsdBridge.is_fullscreen;
        audio_tracks <=> PlayerOsdBridge.audio_tracks;
        sub_tracks <=> PlayerOsdBridge.sub_tracks;
        subtitle_addon_status <=> PlayerOsdBridge.subtitle_addon_status;
        osd_visible <=> PlayerOsdBridge.osd_visible;
        player_poster <=> PlayerOsdBridge.player_poster;
        kb_active <=> PlayerOsdBridge.kb_active;
        system_back_request <=> PlayerOsdBridge.system_back_request;
        is_android <=> PlayerOsdBridge.is_android;
        desktop_decoder_available <=> PlayerOsdBridge.desktop_decoder_available;
        hw_plus_available <=> PlayerOsdBridge.hw_plus_available;
        narrow <=> PlayerOsdBridge.narrow;
        safe-top <=> PlayerOsdBridge.safe-top;
        safe-left <=> PlayerOsdBridge.safe-left;
        safe-right <=> PlayerOsdBridge.safe-right;
        next_episode_streams(t) => { PlayerOsdBridge.next_episode_streams(t); }
        next_episode_dismiss(t) => { PlayerOsdBridge.next_episode_dismiss(t); }
        restore_playback_default(control) => { PlayerOsdBridge.restore_playback_default(control); }
        osd_opacity_changed(v) => { PlayerOsdBridge.osd_opacity_changed(v); }
        subtitle_clearance_changed(fraction, opacity) => { PlayerOsdBridge.subtitle_clearance_changed(fraction, opacity); }
        header_geometry_changed(bottom) => { PlayerOsdBridge.header_bottom = bottom; }
        toggle_pause() => { PlayerOsdBridge.toggle_pause(); }
        seek(v) => { PlayerOsdBridge.seek(v); }
        seek_relative(v) => { PlayerOsdBridge.seek_relative(v); }
        close_player() => { PlayerOsdBridge.close_player(); }
        take_screenshot() => { PlayerOsdBridge.take_screenshot(); }
        set_volume(v) => { PlayerOsdBridge.set_volume(v); }
        volume_step(v) => { PlayerOsdBridge.volume_step(v); }
        toggle_mute() => { PlayerOsdBridge.toggle_mute(); }
        pick_audio_track(i) => { PlayerOsdBridge.pick_audio_track(i); }
        pick_sub_track(i) => { PlayerOsdBridge.pick_sub_track(i); }
        pick_decoder(i) => { PlayerOsdBridge.pick_decoder(i); }
        playback_speed_changed(v) => { PlayerOsdBridge.playback_speed_changed(v); }
        playback_speed_stepped(d) => { PlayerOsdBridge.playback_speed_stepped(d); }
        playback_speed_preview(v) => { PlayerOsdBridge.playback_speed_preview(v); }
        playback_speed_preview_end() => { PlayerOsdBridge.playback_speed_preview_end(); }
        android_brightness_step(d) => { PlayerOsdBridge.android_brightness_step(d); }
        android_volume_step(d) => { PlayerOsdBridge.android_volume_step(d); }
        settings_opened() => { PlayerOsdBridge.settings_opened(); }
        toggle_fullscreen() => { PlayerOsdBridge.toggle_fullscreen(); }
        osd_mouse_moved() => { PlayerOsdBridge.osd_mouse_moved(); }
        tracks_popup_opened(i) => { PlayerOsdBridge.tracks_popup_opened(i); }
        format_time(t) => { PlayerOsdBridge.format_time(t); }
        format_volume(v) => { PlayerOsdBridge.format_volume(v); }
    }
}
