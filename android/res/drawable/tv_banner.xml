<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV's 16:9 launcher banner reuses Nova's existing launcher artwork. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <solid android:color="#12101F" />
        </shape>
    </item>
    <item android:width="104dp" android:height="104dp" android:left="24dp" android:gravity="left|center_vertical">
        <bitmap android:src="@mipmap/ic_launcher" android:gravity="fill" />
    </item>
    <item android:width="148dp" android:height="42dp" android:right="22dp" android:gravity="right|center_vertical" android:drawable="@drawable/tv_wordmark" />
</layer-list>
